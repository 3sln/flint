#!/bin/sh
# Build the JavaScript distributable.
#
# One ESM file with everything inside it: the compiler, both runtime modules,
# their slot maps and flint's standard library. No filesystem, no `node:`
# import and no fetch, so the same file works in a browser, in node, in a
# Worker and in Deno -- and a consumer's bundler has nothing to resolve.
#
# The artifacts are GENERATED (`bin/build-dist`), so this builds them first: a
# distributable can only ever carry artifacts built from the source beside it.
set -e
cd "$(dirname "$0")"
root=../..

echo "==> the wasm artifacts"
(cd "$root" && ./bin/build-dist) | sed 's/^/    /'

echo "==> bundling"
# TWO FILES, and the split is the point. `dist/flint.js` is the SDK's core and
# carries stdcore -- the namespaces every image needs -- inline; `dist/stdextra.js`
# carries the optional half of the standard library and nothing else, importing
# the core for its code. A program that never imports `@3sln/flint/stdextra`
# never loads that blob, with no tree-shaking proof asked of anyone's bundler
# (`DECISIONS.md#namespaces-over-the-system-port` §4).
npx --yes esbuild src/flint.js \
  --bundle --format=esm --platform=neutral --target=es2020 \
  --outfile=dist/flint.js
npx --yes esbuild src/stdextra.js \
  --bundle --format=esm --platform=neutral --target=es2020 \
  --external:./flint.js --outfile=dist/stdextra.js
# `@3sln/flint/deps`, the same shape: `flint.deps` is its own unit, optional, and
# not the standard library (`DECISIONS.md#four-units`). `flint.cli` is in NEITHER
# bundle -- it ships with the two CLIs only.
npx --yes esbuild src/deps.js \
  --bundle --format=esm --platform=neutral --target=es2020 \
  --external:./flint.js --outfile=dist/deps.js
for f in flint.js stdextra.js deps.js; do
  ls -l "dist/$f" | awk -v f="$f" '{printf "    dist/%s %.2f MB\n", f, $5/1048576}'
done

echo "==> checking it works, and that it depends on nothing"
# NOT `node selftest.mjs | sed ...`, which is what this was: a pipeline's status
# is its LAST command's, so `sed` succeeding hid every failing assertion in here
# from the gate, and the gate went on reporting green over a broken SDK. The
# indenting is worth keeping and the exit code is worth more, so the output goes
# through a file and the status is checked by itself.
selftest_out=$(mktemp)
selftest_status=0
node selftest.mjs > "$selftest_out" 2>&1 || selftest_status=$?
sed 's/^/    /' "$selftest_out"
rm -f "$selftest_out"
[ "$selftest_status" -eq 0 ] || exit "$selftest_status"

node -e '
const fs = require("fs");
for (const file of ["dist/flint.js", "dist/stdextra.js", "dist/deps.js"]) {
const src = fs.readFileSync(file, "utf8");
const bad = [/require\(/, /from\s*"node:/, /from\s*.node:/, /process\./, /__dirname/];
for (const re of bad) {
  if (re.test(src)) { console.error("    FAIL: " + file + " references " + re); process.exit(1); }
}
}
console.log("    no node imports, no process, no filesystem");
'
