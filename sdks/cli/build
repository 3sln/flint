#!/bin/sh
# Build the npm CLI distributable.
#
# Nothing is compiled here. What this does is COPY, and the reason it exists as
# a step rather than as a set of relative imports is that a published package
# has no `../../dist` to import from: `sdks/cli/dist/` is what npm puts in the
# tarball, and it has to be filled from artifacts built out of the source beside
# it.
#
# The artifacts are GENERATED (`bin/build-dist`), so this builds them first. A
# distributable can only ever carry artifacts built from the source beside it,
# and `bin/build-dist` does NOT rebuild `target/release/flint` -- neither step
# implies the other (AGENTS.md §3).
set -e
cd "$(dirname "$0")"
root=../..

# `FLINT_DIST_FRESH=1` says the caller JUST built them, which `bin/test` has --
# it runs `bin/build-dist` three lines before calling this. Rebuilding cost the
# gate a further 97 s for artifacts that could not have gone stale in between.
# Unset, the build still rebuilds: a distributable that carries artifacts it did
# not build is the failure this step exists to prevent.
if [ -n "${FLINT_DIST_FRESH:-}" ]; then
  echo "==> the wasm artifacts (already fresh; FLINT_DIST_FRESH)"
else
  echo "==> the wasm artifacts"
  (cd "$root" && ./bin/build-dist) | sed 's/^/    /'
fi

mkdir -p dist

echo "==> the compiler, the runtimes and their slot maps"
for f in flintc.wasm flint-runtime.wasm flint-runtime-aot.wasm slots.json slots-aot.json \
         flint-reader.wasm; do
  cp "$root/dist/$f" "dist/$f"
  printf '    %-24s %s\n' "$f" "$(wc -c < "dist/$f" | tr -d ' ') bytes"
done

echo "==> the standard library, read, in its two layers"
# `bin/build-stdlib-forms`' blobs, COPIED: stdcore, which this CLI answers before
# its resolver is asked anything, and stdextra, which its resolver consults
# first (`DECISIONS.md#namespaces-over-the-system-port` §4). Each answer already
# carries the workspace and grants of the `deps.edn` that owns its file, so there
# is no `deps.edn` to copy and no prefix table to rebuild here.
for f in stdcore.forms stdextra.forms; do
  cp "$root/dist/$f" "dist/$f"
  printf '    %-24s %s\n' "$f" "$(wc -c < "dist/$f" | tr -d ' ')"
done
rm -f dist/stdlib.json dist/lib-deps.edn dist/flint-deps-deps.edn

echo "==> the guest driver"
# COPIED, not reimplemented. `sdks/esm/src/guest.js` is the reference driver --
# arguments, the pump, capabilities -- `sdks/esm/src/codec.js` is the wire
# codec, and `sdks/esm/src/resolve.js` the compile call. All three are portable (no `node:` import, no `process`, no filesystem), so
# the CLI is a third caller of them rather than a second implementation. A
# published package cannot reach across to a sibling package's source, which is
# the only reason these are copies and not imports.
cp "$root/sdks/esm/src/guest.js" dist/guest.js
cp "$root/sdks/esm/src/codec.js" dist/codec.js
# The compile call and the resolver building blocks: the same file the ESM SDK
# drives the compiler with, so the two JavaScript doors speak the protocol once.
cp "$root/sdks/esm/src/resolve.js" dist/resolve.js

echo "==> checking the served catalogue still matches cli/src/sys.rs"
(cd "$root" && ./bin/check-sys-catalogue) | sed 's/^/    /'

echo "==> checking it works"
selftest_out=$(mktemp)
selftest_status=0
node selftest.mjs > "$selftest_out" 2>&1 || selftest_status=$?
sed 's/^/    /' "$selftest_out"
rm -f "$selftest_out"
[ "$selftest_status" -eq 0 ] || exit "$selftest_status"
