  "author": "Ray Stubbs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3sln/flint.git"
  },
  "homepage": "https://flint.3sln.com",
  "keywords": [
    "clojure",
    "cljc",
    "wasm",
    "webassembly",
    "compiler",
    "interpreter",
