#!/usr/bin/env python3
"""Hand-written runtime functions nothing mentions, in all three runtimes.

REPORTS, DOES NOT GATE. There are 25 as of 2026-09-22 and none of them has
been individually investigated, so failing on them would be asserting
something this has not established. What it does assert is a NUMBER that can
be re-derived, which a paragraph in a commit message cannot.

WHY THE COMPILER IS NO HELP. Rust's `dead_code` lint does not fire on a `pub`
item in a library crate -- a library's public surface is meant to have callers
it cannot see. Every item in `runtime/src` is `pub` so sibling modules can
reach it, which switches the lint off across the whole runtime.
`bin/check-generated-reached` covers the generated tree; this is the same
question asked of the hand-written half. `obj::set_len` was found this way:
one mention in the repository, its own definition, and neither port ever had
a `setLen` to match.

FOUR THINGS ARE EXCLUDED, each because it is called by something other than a
mention of its name:

  * `#[test]` functions -- the harness calls them by attribute;
  * `#[no_mangle]` and `extern "C"` -- called from wasm, the CLI, or a host;
  * trait impl methods -- reached through the trait, so `deref_mut` looks dead
    in every codebase that has one;
  * the generated tree under `kgen/`, which has its own check.

COUNTING IS OVER EVERY GIT-TRACKED FILE, and that is not fussiness. Three
successive runs of this survey said 187, then 49, then 19, and both drops were
roots the earlier version had not looked in: `runtime/tests/` holds the
integration tests, which is where the `k_int` image builder is called from,
and `units-src/` holds the wasm unit crates, which is where `thread_join` and
`port_close` are called from. A dead-code report that misses a caller root
reads exactly like a real finding.

THE PORTS TOOK FOUR TRIES TO PARSE. Rust is easy -- `fn` is a keyword, so
the definition regex is `fn` followed by a name, and cannot match anything else. Java and
C# have no such marker: a definition is `<modifiers> <type> <name>(`, and a
CALL at the start of a line is `<indent><name>(`. The first version's type
pattern included a space, so the indentation satisfied it and every call
parsed as a definition -- 244 of them for the clr's `Def` alone. That inflates
the definition count until `mentions <= definitions` is trivially true, and
the tool reports its most-called members as dead.

So each language carries a PROBE: a member known to be called many times,
which must come back with exactly one definition site. If the regex starts
matching calls again the probe's site count rises and this refuses to report
anything. A dead-code tool that cannot be trusted is worse than none, and
this one has now been wrong in both directions.

This is a NAME match, not a call-graph. A name mentioned in a comment counts
as a mention, which is the direction that under-reports -- the safe one.

ONLY `.rs` FILES ARE COUNTED, because a Rust function can only be called from
Rust. That sounds obvious and it was arrived at the hard way, twice.

The first version indexed every tracked file. The count then fell from 19 to
16 with no code change at all: a DECISIONS.md record had NAMED `wire_u64`,
`wire_text` and `wire_scan_ports` while explaining that they were dead, and
naming them was enough to make them look alive. Documenting a dead function
removed it from the dead-function report, silently, in the direction that
reads like progress.

Excluding markdown was not enough. The three came back as alive AGAIN, this
time because THIS FILE names them in the paragraph above, and a python script
is not markdown. Any rule phrased as "skip the kinds of file that hold prose"
loses to prose appearing somewhere new -- including in the tool itself.

Counting only `.rs` is the rule that does not have that shape. It admits every
caller root that can hold one, `runtime/tests/` and `units-src/` included, and
admits nothing that cannot call Rust at all. A mention in a `.rs` COMMENT
still counts, which is the conservative direction and deliberate.
"""
import collections, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

FN = re.compile(r"\s*(?:pub(?:\([\w:]+\))?\s+)?(?:const\s+|unsafe\s+|extern\s+\"C\"\s+)*fn\s+(\w+)")
WORD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")

# `<modifiers> <type> <name>(`. The TYPE must begin with a letter, which is
# what stops indentation from standing in for it -- see the docstring.
MOD = (r"(?:public|private|protected|internal|static|final|sealed|override"
       r"|virtual|abstract|synchronized|unsafe|readonly|extern|new)")
MEMBER = re.compile(rf"^\s*(?:{MOD}\s+)*([A-Za-z_][\w.<>,]*(?:\[\])?)\s+(\w+)\s*\(")
KEYWORD = {"if", "for", "while", "switch", "return", "catch", "else", "do",
           "using", "lock", "foreach", "fixed"}

# (language, extension, source root, generated-dir marker, probe member)
PORTS = (("jvm", ".java", "runtimes/jvm/src/", "/kgen/", "def"),
         ("clr", ".cs", "runtimes/clr/src/", "/Kgen/", "Def"))

def rust_definitions():
    out = {}
    for dirpath, _, names in os.walk("runtime/src"):
        if "kgen" in dirpath.split(os.sep):
            continue
        for nm in names:
            if not nm.endswith(".rs"):
                continue
            p = os.path.join(dirpath, nm)
            lines = open(p, encoding="utf-8", errors="replace").read().split("\n")
            for i, l in enumerate(lines):
                m = FN.match(l)
                if not m:
                    continue
                back = "\n".join(lines[max(0, i - 4):i])
                if ("#[test]" in back or "#[no_mangle]" in back
                        or 'extern "C"' in l or "#[used]" in back):
                    continue
                ctx = None
                for k in range(i, max(-1, i - 400), -1):
                    mm = re.match(r"\s*(?:unsafe\s+)?impl\b(.*)", lines[k])
                    if mm:
                        ctx = mm.group(1)
                        break
                if ctx and " for " in ctx:
                    continue
                out.setdefault(m.group(1), []).append(f"{p}:{i + 1}")
    return out

def port_definitions(tracked, ext, root, genmark):
    out = {}
    for p in tracked:
        if not (p.endswith(ext) and p.startswith(root)) or genmark in p:
            continue
        for i, l in enumerate(open(p, encoding="utf-8", errors="replace").read().split("\n")):
            m = MEMBER.match(l)
            if not m or m.group(1) in KEYWORD or m.group(2) in KEYWORD:
                continue
            out.setdefault(m.group(2), []).append(f"{p}:{i + 1}")
    return out

def mentions(tracked, exts):
    c = collections.Counter()
    for p in tracked:
        if not p.endswith(exts):
            continue
        try:
            c.update(WORD.findall(open(p, encoding="utf-8", errors="replace").read()))
        except OSError:
            pass
    return c

def report(label, defs, counts, probe=None):
    if probe is not None:
        sites = len(defs.get(probe, []))
        if sites != 1:
            print(f"  REFUSING to report {label}: the probe `{probe}` parsed as "
                  f"{sites} definitions, not 1 -- the member regex is matching "
                  f"calls again. See the docstring.")
            return None
    dead = sorted((n, s) for n, s in defs.items() if counts[n] <= len(s))
    for n, sites in dead:
        print(f"  {label:4s} {n:26s} {', '.join(sites)}")
    return len(defs), len(dead)

def main():
    tracked = [p for p in subprocess.run(["git", "ls-files"], capture_output=True,
                                         text=True).stdout.split("\n")
               if p and os.path.isfile(p)]
    totals = []
    r = report("rs", rust_definitions(), mentions(tracked, (".rs",)))
    if r:
        totals.append(("native", *r))
    for lang, ext, root, genmark, probe in PORTS:
        r = report(lang, port_definitions(tracked, ext, root, genmark),
                   mentions(tracked, (ext,)), probe)
        if r:
            totals.append((lang, *r))
    print()
    for lang, ndef, ndead in totals:
        print(f"dead-runtime-fns: {lang:6s} {ndef:4d} hand-written, "
              f"{ndead:3d} mentioned nowhere but their own definition")
    return 0

if __name__ == "__main__":
    sys.exit(main())
