#!/usr/bin/env python3
"""Which builtins each port is missing, against the native runtime's catalogue.

Counting this WRONG cost a session. Two traps, both live here:

* Matching only names beginning `flint/` hides every unprefixed one -- the bit
  operations, `count`, `assoc`, all fourteen type predicates. It reported the
  CLR as three short when it was twenty-seven short.
* Matching `"([^"]+)"` against Java or C# source pairs quotes wrongly from the
  first ESCAPED quote onward, so everything after it is garbage. It reported
  the JVM missing 153 of 155 builtins, `count` among them. An absurd number is
  a lucky failure; a plausible one gets believed.

And a third, found later and worse than either: both paths went stale when the
ports moved into `rt/`, so this script crashed before checking anything and the
suite kept going. A check that cannot find what it checks must FAIL, not raise
-- silence from a broken gate is indistinguishable from a pass.

Run from the repo root. Exit 1 if anything is missing.
"""
import re
import sys

RUNTIME = re.compile(r'^\s*"([^"]+)",\s*flint_b_\w+', re.M)
# A string literal WITH escapes, so an embedded quote does not shift the rest.
STR = re.compile(r'"((?:[^"\\]|\\.)*)"')

# COMPILER-EMITTED builtins, read out of the compiler rather than listed here.
#
# The two categories are not the same obligation. A compiler-emitted builtin is
# one NO GUEST NAMES: `flint/check-tag` is emitted for every unproven `^int`,
# so no feature flag could gate it and no port may omit it. A guest-named one
# is reached because source asked for it, and a port that lacks it fails at the
# call rather than everywhere.
#
# Derived, so a third one added to the compiler is picked up here without
# anybody remembering to. Two shapes carry a literal name: an emitted node, and
# the dependency recorded for it.
EMITTED_NODE = re.compile(r':op\s+:native\s+:name\s+"([^"]+)"')
EMITTED_DEP = re.compile(r'symbol\s+"flint\.native"\s+"([^"]+)"')
COMPILER_SRC = ["src/flint/analyzer.cljc", "src/flint/emitter.cljc",
                "src/flint/types.cljc"]


def compiler_emitted():
    out = set()
    for path in COMPILER_SRC:
        try:
            src = open(path).read()
        except FileNotFoundError:
            continue
        out |= set(EMITTED_NODE.findall(src))
        out |= set(EMITTED_DEP.findall(src))
    return out

def main():
    names = set(RUNTIME.findall(open("runtime/src/builtins.rs").read()))
    if not names:
        print("no builtins found in runtime/src/builtins.rs -- has the shape changed?")
        return 1
    emitted = compiler_emitted()
    if not emitted:
        # THE LESSON THIS FILE IS ABOUT. An extraction that finds nothing must
        # fail: reporting "0 compiler-emitted" would read as good news.
        print("  FAIL found no compiler-emitted builtins -- has the analyzer's shape changed?")
        return 1
    unknown = sorted(emitted - names)
    if unknown:
        print(f"  FAIL the compiler emits {' '.join(unknown)}, which the runtime does not define")
        return 1
    print(f"builtins: the native runtime carries {len(names)}, "
          f"{len(emitted)} of them emitted by the compiler ({' '.join(sorted(emitted))})")
    bad = 0
    for host, path in [("jvm", "runtimes/jvm/src/com/flint/rt/Builtins.java"),
                       ("clr", "runtimes/clr/src/rt/Builtins.cs")]:
        try:
            src = open(path).read()
        except FileNotFoundError:
            # A MISSING FILE IS A FAILURE, not a crash. Both paths here went
            # stale when the ports moved into `rt/`, and the traceback that
            # produced was swallowed by the suite -- so this file, whose whole
            # subject is that counting wrong is expensive, spent that time
            # counting nothing at all.
            print(f"  FAIL {host} catalogue not found at {path}")
            bad = 1
            continue
        have = set(STR.findall(src))
        missing = sorted(names - have)
        if missing:
            bad = 1
            gone = sorted(set(missing) & emitted)
            if gone:
                print(f"  FAIL {host} is missing {len(gone)} COMPILER-EMITTED builtin(s): "
                      f"{' '.join(gone)}")
                print(f"       No guest names these, so no feature flag can gate them and no "
                      f"program can avoid them.")
            rest = sorted(set(missing) - emitted)
            if rest:
                print(f"  FAIL {host} is missing {len(rest)} guest-named: {' '.join(rest)}")
        else:
            print(f"  ok   {host} carries all {len(names)}, the {len(emitted)} mandatory included")
    return bad

sys.exit(main())
