#!/bin/sh
# Everything. Fails loudly; skips nothing.
set -e
# A pipeline reports the exit status of its LAST command, so `bb x | tail -1`
# would hide a failing test behind a successful `tail`. Every `bb` step below
# therefore checks its own result.
cd "$(dirname "$0")/.."
# HOW MANY SECTIONS THIS FILE HAS, counted from itself. A truncated run and a
# complete one look identical in a log otherwise, and one WAS happening: while
# `test/aot.clj` was red, `fail` exited and every section after it never ran.
# Twenty-two of sixty-two, reported as "22 sections, 1 known failure", which
# reads like a baseline and is not one.
#
# That row is green now (2026-09-19) and this count is why anybody can say so
# -- the run reports 62 of 62. Kept in the PAST tense deliberately: the check
# earns its place by what it would catch next time, not by a failure it is
# currently catching, and a comment naming a live known-red is read as
# permission for one.
_sec_total=$(grep -c '^sec "' "$0")
_sec_n=0

_failures=0
_failed_names=""

fail() {
  echo
  echo "FAILED: $1"
  _failures=$((_failures + 1))
  _failed_names="$_failed_names
  $1"
  # KEEP GOING, WHEN ASKED. Opt-in and off by default, because whether a suite
  # stops at the first failure is a policy and not an agent's to change.
  #
  # What it is FOR: with `test/aot.clj` red, forty of sixty-two sections have
  # never run, and the only probe that got past it found a second failure
  # nobody knew about. A red suite that cannot be finished cannot be surveyed.
  #
  # `return 0` and not `return 1`, and the difference matters: `set -e` is on
  # and every caller is `cmd || { ...; fail "x"; }`, so a non-zero return makes
  # the `||` list fail and the shell exits anyway -- which is the thing this is
  # trying not to do.
  #
  # THE CALLER'S CLEANUP STILL RUNS. Every `fail` that matters is preceded in
  # its own `{ }` by the tidy-up it needs -- `./bin/build-units` after the AOT
  # sections, putting the production units back. A first attempt at this
  # removed that cleanup instead of the exit, and the next section then ran
  # against the wrong units and reported a failure that was not real.
  if [ -n "${FLINT_TEST_KEEP_GOING:-}" ]; then
    echo "  (FLINT_TEST_KEEP_GOING: this section is RED and the run continues)"
    return 0
  fi
  # WHAT THE FAILURE COST, not just that it happened. Everything below the
  # failing section is unrun, and saying so is the difference between "one red
  # row" and "two thirds of the gate did not execute".
  if [ "$_sec_n" -lt "$_sec_total" ]; then
    echo "  and the run STOPPED THERE: $_sec_n of $_sec_total sections ran,"
    echo "  so $((_sec_total - _sec_n)) never executed. A green-looking tail is absent, not passing."
    echo "  FLINT_TEST_KEEP_GOING=1 runs the rest and reports every red at the end."
  fi
  exit 1
}

# SECTION TIMING, because the 26 minutes this takes has never had an
# itemisation and the remedy depends entirely on the shape of it: a handful of
# slow sections and a uniform cost want completely different answers.
#
# Recorded by the script itself rather than by a wrapper piping its output. A
# pipeline reports the status of its LAST command -- the hazard the note above
# already describes -- and a timing harness that swallowed a failure would be
# the worst possible trade.
#
# The summary prints at the end, slowest first, and costs one `date` per
# section.
FLINT_TIMES=${FLINT_TIMES:-/tmp/flint-test-times}
: > "$FLINT_TIMES"
_sec_at=$(date +%s)
_sec_name=""
sec() {
  _now=$(date +%s)
  [ -n "$_sec_name" ] && echo "$((_now - _sec_at)) $_sec_name" >> "$FLINT_TIMES"
  _sec_at=$_now
  _sec_name="$1"
  _sec_n=$((_sec_n + 1))
  echo "== $1"
}
times_summary() {
  _now=$(date +%s)
  [ -n "$_sec_name" ] && echo "$((_now - _sec_at)) $_sec_name" >> "$FLINT_TIMES"
  echo
  echo "== where the time went (seconds, slowest first)"
  sort -rn "$FLINT_TIMES" | head -12 | while read -r secs name; do
    printf '  %5ss  %s\n' "$secs" "$name"
  done
  printf '  %5ss  TOTAL\n' "$(awk '{t+=$1} END {print t}' "$FLINT_TIMES")"
  echo
  echo "  $_sec_n of $_sec_total sections ran"
  if [ "$_failures" -gt 0 ]; then
    echo
    echo "  $_failures section(s) RED:$_failed_names"
    exit 1
  fi
}

# CARGO'S EXIT STATUS, not a grep for the word FAILED.
#
# It used to be the grep, and the hole that leaves is a test target that does
# not COMPILE: `cargo test` exits non-zero, prints `error[E0425]` and never
# prints a `test result` line at all -- so the grep matched the error lines,
# succeeded, and the gate went green past a suite that had not run. That is
# exactly what happened to `flint-conc`'s `hostports` test after the capability
# cutover removed the API it was calling, and it went unnoticed for the whole
# of the work that followed.
#
# The status is captured first and the output shown after, so a failure is
# still readable rather than swallowed by a pipe.
rust_tests() {
  if ! cargo test -p "$1" > /tmp/flint-cargo.out 2>&1; then
    grep -E "^(error|test result|thread .* panicked|failures:)" /tmp/flint-cargo.out | head -20
    fail "cargo test -p $1"
  fi
  grep -E "^test result" /tmp/flint-cargo.out
}

sec "rust: runtime unit tests and VM integration tests"
rust_tests flint-rt

echo
sec "rust: green threads, ports, and a parked thread under collection"
rust_tests flint-conc

echo
# THE NATIVE CLI IS BUILT BEFORE ANYTHING RUNS IT. Eight steps below use
# `./target/release/flint`, and nothing here built it -- so a change to the
# runtime that was never compiled was tested as if it had been. That reads as
# a PASS, and against `bin/conform-hosts` it reads as the PORT disagreeing.
sec "rust: the native CLI, which everything below runs"
cargo build --release -p flint-cli > /tmp/flint-cli-build.log 2>&1 \
  || { tail -20 /tmp/flint-cli-build.log; fail "cargo build --release -p flint-cli"; }
echo "  ok"

echo
sec "units: the PRODUCTION build (no diagnostic machinery -- 0016)"
./bin/build-units >/dev/null 2>&1 || fail "build-units"
echo "  ok"

echo
sec "reader"
bb --classpath src test/reader_test.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/reader_test.clj"; }
tail -1 /tmp/flint-test.out

echo
sec "conformance: Clojure expressions, on flint"
./bin/flint :src test :fn conform.runner/main :out out/conform.wasm >/dev/null
node host/flint.mjs out/conform.wasm conform.runner/main | tee /tmp/conform.out
# A FLOOR, not the count. The runner prints `PASS <n>`, and this grepped for
# `^PASS` alone -- so an EMPTY corpus reported success, while the header said
# 130 and nothing checked that either. The header now says nothing it cannot
# back up, and the number is read from the run.
conform_n=$(sed -n 's/^PASS //p' /tmp/conform.out)
case "$conform_n" in
  ''|*[!0-9]*) fail "conformance did not report a count" ;;
esac
[ "$conform_n" -ge 130 ] || fail "conformance ran only $conform_n expressions"
echo "    $conform_n expressions, and at least 130 are expected"

echo
sec "conformance: the same expressions, under real Clojure"
bb test/conform_vs_clojure.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/conform_vs_clojure.clj"; }
tail -2 /tmp/flint-test.out

echo
sec "end to end: hand-assembled images, linked and run"
bb --classpath src test/e2e_link.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/e2e_link.clj"; }
tail -1 /tmp/flint-test.out

echo
sec "modularity: only reachable code ships"
bb test/modularity.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/modularity.clj"; }
tail -1 /tmp/flint-test.out

echo
sec "options: :exclude is an assertion, :wasm-path is a search path"
./bin/build-test-unit >/dev/null 2>&1 || fail "build-test-unit"
bb test/options.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/options.clj"; }
tail -1 /tmp/flint-test.out

echo
sec "threads: green threads, ports, protocols, dynamic vars"
# THE RUNTIME FIRST, because `threads.clj` carries the module size budget and
# the floor module links `dist/flint-runtime.wasm`. That artifact used to be
# rebuilt at the "distributable" section a hundred lines below this one, so the
# budget measured the runtime built by the PREVIOUS invocation of this script.
#
# Not theoretical: measured at 763 323 bytes on disk against 763 606 rebuilt
# from the same tree, and the 283 bytes of drift were exactly the regression
# the gate existed to report. A change that grows the module passed on the run
# that introduced it and failed on the next, unrelated one -- which sent one
# round of attribution at the wrong commit.
#
# It is rebuilt again below. That section tests the distributable itself and
# has its own reason to be sure the artifacts are fresh; this one is about the
# number `threads.clj` is going to print.
./bin/build-dist > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bin/build-dist (before the size budget)"; }
bb test/threads.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/threads.clj"; }

sec "catch: Exception means what it means in Clojure"
bb test/catch.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/catch.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "loader: an image runs in a module that never linked it (0023)"
bb test/loader.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/loader.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "pause: the collector collects little and often, so the tail stays tight (0018)"
bb test/pause.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/pause.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "opaque: identity without structure, across a moving collector (0022)"
bb test/opaque.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/opaque.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "capability: possession is not the check, the grant table is (0021, 0022)"
# `test/capability.clj` COMPILES AGAINST `sdks/esm/dist/flint.js`, which is
# generated and gitignored -- so it is absent from a fresh clone, and this line
# is 179 lines above the `./sdks/esm/build` that makes it. Every tree that has
# ever built the SDK hides that, which is every developer's and none of CI's:
# `.github/workflows/test.yml` runs `./bin/test` on a fresh checkout with no
# SDK step, and runs on pull requests only, so nothing has opened one since the
# dependency landed. Built here if it is missing rather than by reordering the
# suite, because the SDK section below tests the DISTRIBUTABLE and has to keep
# running where it does.
[ -f sdks/esm/dist/flint.js ] || ./sdks/esm/build > /tmp/flint-test.out 2>&1 \
  || { tail -25 /tmp/flint-test.out; fail "sdks/esm/build (bootstrap for test/capability.clj)"; }
bb test/capability.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/capability.clj"; }

# Privacy is enforced, not documented. Paired refusals and positive controls:
# a check that refuses everything passes its own test and breaks the build.
bb test/visibility.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/visibility.clj"; }
sed 's/^/  /' /tmp/flint-test.out
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

# The namespace GRAPH, which is two rules rather than one. A cycle is refused
# and named; a qualified reference resolves without a require, because reading
# every source before analysing any makes existence not a require's business.
#
# EACH TO ITS OWN FILE. The block above prints `/tmp/flint-test.out`, so a
# later test writing to it replaces what that block reports -- which is how
# `visibility`'s summary silently stopped being shown when these two were
# first added here.
bb test/cycles.clj > /tmp/flint-cycles.out 2>&1 || { cat /tmp/flint-cycles.out; fail "test/cycles.clj"; }
tail -1 /tmp/flint-cycles.out
bb test/requires.clj > /tmp/flint-requires.out 2>&1 || { cat /tmp/flint-requires.out; fail "test/requires.clj"; }
tail -1 /tmp/flint-requires.out

sec "cli: the command surface, tasks, and running an image directly (0021)"
bb test/cli.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/cli.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "scaling: doubling the input must not square the work"
bb test/scaling.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/scaling.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "ropes: three tiers, one string, and the flattens counted (0011)"
bb test/ropes.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/ropes.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "pike: one shared NFA, two simulators, a rope cursor (0012)"
bb test/regex_pike.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/regex_pike.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "aot: the emitter, validated one arity at a time (0013)"
bb test/aot_emit.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/aot_emit.clj"; }
tail -3 /tmp/flint-test.out

sec "aot: the same answer AND the same instruction count as the interpreter"
# Its own build, like diagnostics: a production runtime cannot run compiled
# arities and does not carry the machinery that would (DECISIONS.md#emit-wasm-instead-of-dispatch, 0016).
# `--diagnostics` TOO, because the row below is no longer a bare equality: it
# accounts for the preemptions compiled code did not take, and `stat_region`
# is how the preemption count is read (`DECISIONS.md#emit-wasm-instead-of-dispatch`).
./bin/build-units --aot --diagnostics > /dev/null || fail "build-units --aot --diagnostics"
bb test/aot.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/aot.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true

# THE LANGUAGE SUITE UNDER COMPILED ARITIES, diffed against the same suite
# interpreted. `test/aot.clj` holds the emitter to "the same answer and the
# same instruction count", but on its own small corpus -- `test/common` is a
# hundred-odd checks including every tier boundary, and none of them had ever
# run through the compiled path. Two runs on the SAME units, so the only
# variable is the one being tested.
echo
sec "aot: the language suite answers the same with compiled arities"
# ITS OWN UNITS, like every other section that needs a particular build.
#
# This used to inherit the `--aot` units from the section above, and that is a
# dependency on a previous section's SIDE EFFECT. It broke under
# `FLINT_TEST_KEEP_GOING`: when `test/aot.clj` fails, its failure path restores
# PRODUCTION units on the way out, the run continues, and this section then asks
# a production runtime to run compiled arities. It answers
#
#     this runtime cannot run compiled arities: build the units with
#     `bin/build-units --aot`
#
# in one line, and the diff below reports 131 lines of suite output replaced by
# that one, which reads exactly like the language suite disagreeing with itself.
#
# THE `colls` GAP THAT PROMPTED THIS IS CLOSED (2026-09-19, and the gate has run
# 62/62 green since) -- a preemption billed the handler buffer and so made gas
# depend on where a thread was preempted; `test/aot.clj` carries the account.
# The dependency this section removes is not about that row, though: any failure
# above restores production units, so owning its own build is right whether or
# not anything is currently red. Stated in the past tense on purpose, because a
# comment naming a CURRENT known failure is read as permission for one.
# It does not: built against its own units the two runs are byte for byte
# identical, 129/129. Two RED sections in the survey, neither of them real.
./bin/build-units --aot > /dev/null || fail "build-units --aot (for the suite diff)"
./bin/flint test :src test/common > /tmp/flint-common-i.out 2>&1 \
  || { cat /tmp/flint-common-i.out; ./bin/build-units > /dev/null; fail "test/common (interpreted, under aot units)"; }
./bin/flint test :src test/common --aot > /tmp/flint-common-a.out 2>&1 \
  || { cat /tmp/flint-common-a.out; ./bin/build-units > /dev/null; fail "test/common --aot"; }
if diff -q /tmp/flint-common-i.out /tmp/flint-common-a.out > /dev/null; then
  echo "  ok   $(tail -1 /tmp/flint-common-a.out), byte for byte against the interpreter"
else
  diff /tmp/flint-common-i.out /tmp/flint-common-a.out | head -20
  ./bin/build-units > /dev/null
  fail "the language suite disagrees with itself under --aot"
fi

./bin/build-units > /dev/null || fail "build-units (back to production)"
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "host abi: tokens, one event queue, two lifetimes"
bb test/host_abi.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/host_abi.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "inline: :inline metadata, and the instruction count it removes"
bb test/inline.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/inline.clj"; }
grep -E "^  (ok|FAIL)" /tmp/flint-test.out | tail -3
node test/inline.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/inline.mjs"; }
grep -E "^    " /tmp/flint-test.out

echo
sec "types: annotations are checked claims, and a proven one costs nothing"
bb test/types.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/types.clj"; }
grep -cE "^  ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'
node test/types.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/types.mjs"; }
grep -E "^    " /tmp/flint-test.out

echo
sec "narrowing: which guard shapes it composes with (0013)"
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src test :fn narrow/main :out out/narrow.wasm > /dev/null 2>&1 || fail "build narrow.wasm"
node test/narrow.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/narrow.mjs"; }
grep -E "^    [a-z]" /tmp/flint-test.out | awk '{printf "%s=%s ", $1, $2} END {print ""}' | fold -sw 76 | sed 's/^/    /'
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
sec "specialisation: the same instructions, and what one costs"
./bin/flint :src bench/progs :fn spec/main :out out/spec.wasm > /dev/null 2>&1 || fail "build spec.wasm"
node bench/specialised.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bench/specialised.mjs"; }
grep -E "^  (generic|specialised|[0-9])" /tmp/flint-test.out | sed 's/^/  /'

echo
sec "collections: transients, and what a seq walk costs in memory"
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src bench/progs :fn colls/main :out out/colls-diag.wasm > /dev/null 2>&1 || fail "build colls"
node bench/colls.mjs 20000 conj conj! assoc assoc! reduce sort group-by zipmap select-keys \
  > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bench/colls.mjs"; }
grep -E "^  [a-z]" /tmp/flint-test.out | sed 's/^/  /'
# The claim this section exists to defend: a transient allocates less than the
# persistent it replaces. If that stops being true, something regressed in the
# collections and no wall-clock check would notice.
# SORT, on allocations, for the same reason. `merge-sort` used to split with
# `subvec` -- which COPIES -- and merge through `first`/`next`, so it allocated
# 74.7 times per element and collected 57 times to sort 20,000 numbers. Going
# bottom-up over a transient took that to 1.5 per element and one collection,
# and roughly halved the clock as a side effect.
#
# The bound is on ALLOCATIONS because that is what regressed invisibly: the
# first wall-clock reading of this change said it was slightly SLOWER, because
# process startup and building the input swamped the sort.
awk '/^  sort /{a=$4; n=20000} END{gsub(",","",a);
  if (a+0 > 10*n) { print "  FAIL sort allocates " a ", over 10 per element"; exit 1 }
  else print "  ok   sort allocates " a ", under 10 per element" }' /tmp/flint-test.out \
  || fail "sort started allocating per element again"
awk '/^  conj  /{p=$4} /^  conj! /{t=$4} END{gsub(",","",p); gsub(",","",t);
  if (t+0 >= p+0) { print "  FAIL conj! allocates " t " against conj " p; exit 1 }
  else print "  ok   conj! allocates " t " where conj allocates " p }' /tmp/flint-test.out || fail "transients stopped helping"

# EQUALITY AND HASH ALLOCATE NOTHING, which is a gate and not a benchmark.
#
# The timings in `bench/equiv.mjs` are machine-dependent and not assertable.
# The ALLOCATION counts are exact, and they are what caught the defect this
# gate exists to keep out: `=` on two vectors walked two seqs and allocated a
# cell per element per side -- forty thousand objects to compare two
# 20 000-element vectors -- while `=` on two MAPS of the same size allocated
# none. `hash` of a vector did the same, one cell per element, hidden behind
# the hash cache for keys that get reused and fully exposed for a vector
# hashed once, which is every element going into a set.
#
# NOTHING ELSE HERE WOULD HAVE CAUGHT EITHER. Both were correct, identical
# across all four runtimes, and inside every size and gas budget. They were
# only slow and allocating, and `check-builtin-coverage` reported `=` as
# reached the whole time. That is the same shape as `sort` at 74.7
# allocations per element above: the number a wall-clock reading cannot see.
#
# `EQUIV_TARGET_MS` is lowered because an allocation count needs no signal to
# separate -- it is exact -- so the gate does not spend a second per row
# building one. Four modes, well under two seconds.
./bin/flint :src bench/progs :fn equiv/main :out out/equiv-diag.wasm > /dev/null 2>&1 || fail "build equiv"
EQUIV_TARGET_MS=25 node bench/equiv.mjs 2000 vec noshare hash-bigvec set-member \
  > /tmp/flint-equiv.out 2>&1 || { cat /tmp/flint-equiv.out; fail "bench/equiv.mjs"; }
grep -E "^  (vec|noshare|hash-bigvec|set-member) " /tmp/flint-equiv.out | sed 's/^/  /'
# TOTAL, NOT PER OPERATION, and the difference is the whole point.
#
# What this row is about is whether `=` or `hash` allocates PER ELEMENT. It used
# to read the per-op column against 0.5, which was the same question while a
# call cost nothing to start. Since a call runs as a green thread
# (`DECISIONS.md#calls-are-ports`) its value stack lives on the heap and GROWS
# with the depth the operation reaches, so the per-op column now carries a
# growth cost that has nothing to do with elements -- 2.31/op at 1 226
# operations and 6.97/op at 256, where a per-element cost would hold steady and
# the TOTAL would scale.
#
# Measured either side of that change, same units, same build: total
# allocations were 2 832 at 1 226 ops and 1 784 at 256 -- bounded, and sublinear
# in the work. A genuine per-element regression would be tens of thousands.
#
# RE-BASELINED once calls started going through the control plane
# (`DECISIONS.md#bridges-are-the-only-door`). A call is now several frames
# deeper -- `serve-calls` then `answer` then `apply` then the function -- and
# the saved value stack grows with depth, so the per-call figure roughly
# doubled. It is the same COST, not a new one, and it is still not per element:
# measured at three sizes on the current build, totals are
#
#     n=500   vec 6 891   hash-bigvec 7 465
#     n=2000  vec 4 436   hash-bigvec 6 649
#     n=8000  vec 3 277   hash-bigvec 3 256
#
# -- FALLING as the elements per operation rise, which is the shape that says
# the cost belongs to the call and not to the elements. The bound below is set
# to catch an order of magnitude, which is what a per-element regression is,
# and not to pin the call's own cost; `DECISIONS.md#calls-are-ports` is where
# that cost is argued, and `test/threads.clj` is what holds it.
awk '/^  (vec|noshare|hash-bigvec|set-member) /{
       a = $9 + 0; if (a < 0) a = -a;
       # OPS IS $4, and it carries thousands separators -- `1,208` reads as 1
       # to awk unless they come out. $10 is the RESULT column, which for
       # `hash-bigvec` is a hash value and made the first version of this
       # multiply by -38766122344.
       ops = $4; gsub(/,/, "", ops); ops += 0;
       total = a * ops;
       if (ops <= 0) { print "  FAIL " $1 " reported no operation count"; bad = 1 }
       else if (total >= 15000) {
         print "  FAIL " $1 " allocated " total " in total (" $9 "/op over " ops " ops)"; bad = 1 }
       else seen++ }
     END{ if (bad) exit 1;
          if (seen != 4) { print "  FAIL only " seen " of 4 equality rows were read"; exit 1 }
          else print "  ok   = and hash allocate no more than the call itself, on " seen " shapes" }' \
  /tmp/flint-equiv.out || fail "= or hash started allocating per element"
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
sec "distributable: the compiler and loader, driven by the SDK alone"
# Rebuilt every run, because the artifacts are generated and a stale one that
# still passes is the failure this section exists to catch.
./bin/build-dist > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bin/build-dist"; }
# AND THE CLI AGAIN, because `build-dist` just regenerated the compiler the CLI
# CARRIES: `dist/flintc.bytecode` is `include_bytes!`d into the binary, so the
# copy built at the top of this file is one step behind the moment anything
# under `src/` changes.
#
# It is the byte-identical row below that this is for. That row compares the
# native CLI's output against the npm CLI's, and both run the self-hosted
# compiler -- so a stale embedding makes them disagree by a few hundred bytes
# and reports a DIVERGENCE BETWEEN FRONT ENDS that does not exist. Measured: a
# constant 893 bytes on every arm, which is exactly the shape of a real one.
cargo build --release -p flint-cli > /tmp/flint-test.out 2>&1 \
  || { tail -20 /tmp/flint-test.out; fail "cargo build --release -p flint-cli (after build-dist)"; }
# The SDK is a separate package with its own build (`sdks/`), and what is
# tested is the DISTRIBUTABLE: one portable ESM with the artifacts inside it.
./sdks/esm/build > /tmp/flint-test.out 2>&1 || { tail -25 /tmp/flint-test.out; fail "sdks/esm/build"; }
# SIX spaces, not four. The selftest prints "  ok   label" and the build script
# indents its output by four, so every one of its rows has always failed this
# filter -- the gate ran forty assertions and displayed none of them, showing
# only the two lines the build script prints itself. Nothing was broken by it,
# because the exit code is what fails the gate, but "ran and passed" and "was
# never shown" look identical in a log, and that is the difference this file
# exists to make visible.
grep -E "^ *(ok|FAIL|dist/|no node)" /tmp/flint-test.out | sed 's/^      /  /'

# THE ONLY THING THAT COMPARES THE TWO FRONT ENDS' OUTPUT, and nothing ran it
# until now. The npm CLI had no `:checks` axis at all, so every module it
# produced under `:optimize [perf]` shipped the check code the native CLI
# strips -- a semantics difference, invisible without this comparison, and it
# went unnoticed because this file and `bin/check` both skipped the selftest
# (`DECISIONS.md#aot-diverges-between-hosts`). It is here rather than in
# `bin/check` because it needs both CLIs built and takes 30 s.
FLINT_DIST_FRESH=1 ./sdks/cli/build > /tmp/flint-test.out 2>&1 || { tail -25 /tmp/flint-test.out; fail "sdks/cli/build"; }
grep -E "^ *(ok|FAIL)" /tmp/flint-test.out | sed 's/^      /  /;s/^    /  /'

echo
sec "system: bind, call, unbind, close -- the only door into a sandbox"
# The control plane (`DECISIONS.md#bridges-are-the-only-door`) as flint code,
# driven over a LOCAL channel: what is under test is the protocol, and a bridge
# would add a host and an executor to a failure that should be unambiguous.
bb test/system.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/system.clj"; }
grep -cE "^ *ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'

echo
sec "io: sources and sinks, as protocols rather than capabilities"
# NOT in `bin/check`, though it is 2 s: it runs the program through
# `target/release/flint`, which embeds the standard library at cargo time, so
# in the fast gate it would check whatever `lib/flint/io.cljc` looked like at
# the last build. `bin/test` builds the binary, so the signal is about the
# source in front of you.
bb test/io.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/io.clj"; }
grep -cE "^  ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'

echo
sec "bytes: a string of bytes, in two tiers (0024)"
bb test/bytes.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/bytes.clj"; }
grep -cE "^  ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'
# The number the type exists for: the same bytes, two representations.
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src bench/progs :fn colls/main :out out/colls-diag.wasm > /dev/null 2>&1 || fail "build colls"
node bench/colls.mjs 200000 bytes-as-vec bytes-as-bytes byte-cat byte-trans > /tmp/flint-test.out 2>&1 \
  || { cat /tmp/flint-test.out; fail "bench/colls.mjs bytes"; }
grep -E "^  (bytes-as|byte-)" /tmp/flint-test.out | sed 's/^/  /'
# The claim the transient exists for: building a byte at a time allocates
# essentially nothing. If that stops being true nothing else here notices.
awk '/^  byte-cat /{c=$4} /^  byte-trans /{t=$4} END{gsub(",","",c); gsub(",","",t);
  if (t+0 >= c/100) { print "  FAIL byte-trans allocated " t " against byte-cat " c; exit 1 }
  else print "  ok   byte-trans allocates " t " where byte-cat allocates " c }' \
  /tmp/flint-test.out || fail "the transient stopped helping"
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
sec "shake: cutting a prebuilt module down, with no linker (0024)"
bb test/shake.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/shake.clj"; }
grep -E "^    " /tmp/flint-test.out

echo
sec "dist: built from this source tree, not a previous one"
# Runs BEFORE the binary section, because the CLI embeds `dist/` and a stale
# slot table does not fail where it is stale -- it segfaults somewhere else.
./bin/check-dist || fail "check-dist"

echo
sec "binary: the single-file CLI, compiling and running with nothing installed"
# Built against dist/, which the section above just rebuilt. This is the
# release artifact, so what is asserted is what a user does with it: compile a
# program and run the result.
cargo build -p flint-cli --release > /tmp/flint-test.out 2>&1 \
  || { tail -20 /tmp/flint-test.out; fail "cargo build -p flint-cli"; }
rm -rf /tmp/flint-smoke && mkdir -p /tmp/flint-smoke
printf '(ns smoke (:require [clojure.string :as s]))\n(defn main [args] (s/upper-case (str "ok " (reduce + 0 (range 10)))))\n' \
  > /tmp/flint-smoke/smoke.cljc
# `compile` emits a wasm module, which is the artifact. `run` takes SOURCE and
# produces nothing -- flint's bytecode is an implementation detail and never
# leaves the process.
./target/release/flint compile :src /tmp/flint-smoke :fn smoke/main :out /tmp/flint-smoke/out.wasm 2>&1 \
  | sed 's/^/    /' || fail "flint compile"
node host/flint.mjs /tmp/flint-smoke/out.wasm smoke/main > /tmp/flint-test.out 2>&1 || fail "the module does not run"
[ "$(cat /tmp/flint-test.out)" = "OK 45" ] || { cat /tmp/flint-test.out; fail "the module answered wrongly"; }
got="$(./target/release/flint run :src /tmp/flint-smoke :fn smoke/main)"
[ "$got" = "OK 45" ] || { echo "    got '$got'"; fail "the binary did not run source"; }
echo "    compiled a module, and ran the same source NATIVELY: $got"
# `run` writes nothing. A bytecode file left behind would be an artifact, and
# the format is deliberately not one.
[ -z "$(ls /tmp/flint-smoke | grep -v 'smoke.cljc\|out.wasm')" ] \
  || { ls /tmp/flint-smoke; fail "run left an artifact behind"; }

# `flint.sys.*`: the virtual namespaces this binary SERVES (`system-namespaces-and-deps`). Placed here
# because it needs the release binary the section above just built, and because
# what is being tested is the shipped artifact rather than the source it came
# from -- the same reason the SDK selftest imports `dist/`.
bb test/sysns.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/sysns.clj"; }
grep -E "^ +(ok|FAIL|\()" /tmp/flint-test.out | sed 's/^/  /'

# The surface `DECISIONS.md#cli` describes: `:path`, `:with`, `:args`, `:to`
# and `:optimize`. A list may be bracketed or the key repeated -- and the
# bracketed form is QUOTED here on purpose, because in zsh an unquoted `[a b]`
# is a glob and never reaches flint at all.
got="$(./target/release/flint run :path '[/tmp/flint-smoke]' :fn smoke/main)"
[ "$got" = "OK 45" ] || { echo "    got '$got'"; fail ":path as a quoted list"; }
got="$(./target/release/flint run :path /tmp/flint-smoke :fn smoke/main)"
[ "$got" = "OK 45" ] || { echo "    got '$got'"; fail ":path as a repeated key"; }

# `:optimize` is an ORDERED PREFERENCE, and this measures it rather than
# trusting it: `[perf]` compiles every arity into the module, so it is bigger.
# An unrecognised token is IGNORED, which is what lets a script written for a
# newer flint still run here.
./target/release/flint compile :path /tmp/flint-smoke :fn smoke/main \
  :to :wasm :out /tmp/flint-smoke/size.wasm :optimize '[size]' \
  :meta 'capabilities=fs' >/dev/null 2>&1 || fail "compile :optimize [size]"
./target/release/flint compile :path /tmp/flint-smoke :fn smoke/main \
  :to :wasm :out /tmp/flint-smoke/perf.wasm :optimize '[no-such-token perf]' \
  >/dev/null 2>&1 || fail "compile :optimize [perf]"
small=$(wc -c < /tmp/flint-smoke/size.wasm)
fast=$(wc -c < /tmp/flint-smoke/perf.wasm)
[ "$fast" -gt "$small" ] \
  || fail ":optimize [perf] did not compile arities ($fast against $small)"
echo "    :optimize [perf] $fast bytes against [size] $small, unknown token skipped"

# Metadata reaches the ARTIFACT, not just the process that made it. flint never
# reads it; the declared capabilities of a program live there by convention.
./bin/flint inspect /tmp/flint-smoke/size.wasm 2>/dev/null | grep -q 'capabilities "fs"' \
  || { ./bin/flint inspect /tmp/flint-smoke/size.wasm; fail ":meta did not reach the artifact"; }

# `:to :native` is not built. It must say so rather than quietly emitting
# something else -- a target that silently means a different target is worse
# than an absent one. This assertion used to cover `:to :llvm` as well, and
# that was the bug: they are two targets, and only one of them needs a linker
# (`DECISIONS.md#llvm-ir-target`).
if ./target/release/flint compile :path /tmp/flint-smoke :fn smoke/main \
     :to :native :out /tmp/flint-smoke/no.out >/dev/null 2>&1; then
  fail ":to :native claimed to work"
fi
[ ! -f /tmp/flint-smoke/no.out ] || fail ":to :native wrote a file anyway"

# `:to :llvm` IS built, and the guarantee the old assertion was really making --
# that it does not quietly emit wasm -- is now made by checking the artifact
# rather than by refusing to produce one. `bin/check-llvm` emits IR for seven
# programs, links each with clang, and holds the result to the same bar
# `test/aot.clj` holds the wasm emitter to: the same answer AND the same
# instruction count as the interpreter.
echo
sec "llvm: IR out, linked by clang, answering what the interpreter answers"
# THE SCRIPT'S OWN STATUS, not a grep of its output, and for the reason at the
# top of this file: a pipeline reports its LAST command, so `check-llvm | tee`
# would report `tee`.
if ! ./bin/check-llvm > /tmp/flint-llvm.out 2>&1; then
  cat /tmp/flint-llvm.out
  fail "bin/check-llvm"
fi
# `sed -n ...p`, not `grep`: under `set -e` a grep that matches nothing exits 1
# and ends the suite with no message at all, which would turn a change to
# check-llvm's output format into a silent abort here.
sed -n 's/^    \([a-z]*:\)/  \1/p' /tmp/flint-llvm.out

ls -l target/release/flint | awk '{printf "    binary %.1f MB\n", $5/1048576}'

echo
sec "parallel: two executors on one heap (0028)"
# The `parallel` feature is the native SDK's, so it is tested where it is used.
# What this asserts is that a collection staged by one executor walks the
# other's roots: a run in which nothing collected would prove nothing, so the
# test counts them.
cargo test -p flint-rt --features parallel --test parallel --release -- --nocapture \
  > /tmp/flint-test.out 2>&1 || { tail -25 /tmp/flint-test.out; fail "two executors on one heap"; }
grep -E "collections with two executors" /tmp/flint-test.out | sed 's/^ */    /'
grep -E "^test result" /tmp/flint-test.out | sed 's/^/    /'

echo
sec "hosts: every builtin is carried by every port"
# Counted, not assumed. The count was wrong twice -- once by matching only
# `flint/`-prefixed names, once by mispairing quotes around an escaped one --
# and both times it reported a number that looked fine.
# NOT `check-builtins | sed`: a pipeline's status is the LAST command's, so
# `|| fail` would read sed's success and a real miss would pass silently. The
# same swallow hid a broken SDK selftest earlier in this project.
if ./bin/check-builtins > "$TMPDIR/flint-builtins.out" 2>&1; then
  sed 's/^/  /' "$TMPDIR/flint-builtins.out"
else
  sed 's/^/  /' "$TMPDIR/flint-builtins.out"; fail "check-builtins"
fi

# AND THE OTHER HALF OF THE QUESTION: `check-builtins` asks whether every port
# implements each builtin; this asks whether anything CALLS it. An implemented
# builtin no conformance program reaches can be wrong in every way nobody is
# looking at, which is how `unchecked-add` came to do arithmetic on a heap
# address on both ports without a single test noticing.
#
# Same pipeline trap as above, so same shape: redirect, then branch on status.
if ./bin/check-builtin-coverage > "$TMPDIR/flint-bcov.out" 2>&1; then
  sed 's/^/  /' "$TMPDIR/flint-bcov.out"
else
  sed 's/^/  /' "$TMPDIR/flint-bcov.out"; fail "check-builtin-coverage"
fi

echo
sec "global ports: the host owns them, and passes one IN (0027)"
bb test/globalport.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/globalport.clj"; }
grep -E "^  (ok|FAIL)" /tmp/flint-test.out | sed 's/^/  /'
tail -1 /tmp/flint-test.out

echo
sec "hosts: one program, three runtimes, diffed (0010, 0029, 0030)"
# The JVM port's gate. Skips itself when there is no JDK, because the rest of
# the suite must not depend on one being installed.
./bin/conform-hosts > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "conform-hosts"; }
grep -E "^  (ok|FAIL|[0-9]+/|\()" /tmp/flint-test.out | sed 's/^/  /'

echo
sec "sdks: the same four nouns in three languages (0025)"
# Release, because each of these embeds the compiler and runs flint compiling
# itself; a debug build of that is minutes rather than seconds.
cargo test -p flint --release --test sdk -- --nocapture > /tmp/flint-test.out 2>&1 \
  || { tail -25 /tmp/flint-test.out; fail "the Rust SDK"; }
grep -E "^test result" /tmp/flint-test.out | sed 's/^/    rust:  /'
grep -E "dispatches ran on a secondary executor" /tmp/flint-test.out | sed 's/^ */    /'
./sdks/c/build > /tmp/flint-test.out 2>&1 || { tail -30 /tmp/flint-test.out; fail "the C SDK"; }
grep -c "  ok  " /tmp/flint-test.out | awk '{printf "    c/c++: %d checks passed\n", $1}'

echo
sec "check: what was written for flint and does nothing"
# The fixture carries one of each kind, so it must FAIL -- a checker that
# cannot fail is not checking. The two host hints must NOT be what fails it.
if ./bin/flint check :src test/fixtures > /tmp/flint-test.out 2>&1; then
  cat /tmp/flint-test.out; fail "flint check passed a file with a bare flint key"
fi
grep -q "bare-key" /tmp/flint-test.out || fail "check missed the bare key"
grep -q "unknown-flint-key" /tmp/flint-test.out || fail "check missed a typo'd flint key"
grep -q "^2 finding" /tmp/flint-test.out || fail "check counted the host hints as findings"
grep -E "^    \^" /tmp/flint-test.out | sed 's/^/  /'
# And it must PASS flint's own source, which carries host hints and no mistakes.
./bin/flint check :src src :src lib > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "flint check flags flint own source"; }
grep -E "annotation" /tmp/flint-test.out | sed 's/^ */    /' 

echo
sec "casetable: the Unicode tables are what the derivation says"
# DERIVED, not written. Re-derive from the host's own Unicode data and diff --
# a table nobody reads is still known to be right, and a host whose Unicode
# version moved says so here rather than in someone's string.
./bin/casetable --check || fail "bin/casetable --check"

sec "kin: the sources agree, and the committed output matches them"
# The generated output is COMMITTED on purpose -- a runtime build must not
# need babashka -- and the cost is that source and output can drift. It used
# to be REGIONS, spliced between `kin:begin`/`kin:end` markers in otherwise
# hand-written files; it is whole files now, and no marker survives anywhere
# in the tree (checked 2026-09-22). Nothing
# checked that until now: a `fixnum` fix left two files stale, and the only
# thing that would have re-emitted them was somebody remembering to.
./bin/check-kin > "$TMPDIR/flint-kin.out" 2>&1 || {
  sed 's/^/  /' "$TMPDIR/flint-kin.out"; fail "bin/check-kin"; }
# THE WHOLE SUMMARY, not `tail -1`. The banner is more than one line -- it
# was two and is now three -- so a fixed tail showed a trailing fragment with
# the counts cut off. Print from the `check-kin:` line to the end and the
# display stops depending on how long the summary happens to be.
sed -n '/^check-kin:/,$p' "$TMPDIR/flint-kin.out" | sed 's/^/  /'

echo
sec "decisions: the index agrees with what is in the tree"
./bin/check-decisions || fail "bin/check-decisions"

echo
sec "the served catalogue: the Rust CLI and the npm CLI list the same namespaces"
./bin/check-sys-catalogue || fail "bin/check-sys-catalogue"

echo
sec "manifest: the deficiency lists are true"
bb test/manifest.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/manifest.clj"; }
tail -1 /tmp/flint-test.out

echo
sec "modmeta: what a module says about itself, without instantiating (0020)"
bb test/modmeta.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/modmeta.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

sec "two builds: a production module carries no diagnostics (0016)"
bb test/twobuilds.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/twobuilds.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

