sec "limits: deterministic gas, charged natives, a catchable memory cap"
bb test/limits.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/limits.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "snapshots: capture, import, and an inspector that can read them"
bb test/snapshot.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/snapshot.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "tags: a reader tag is bound per project (0035)"
bb test/tags.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/tags.clj"; }
grep -E "^ +(ok|FAIL)" /tmp/flint-test.out | sed 's/^/  /'

sec "flattens: every rope materialisation justifies itself (0011)"
./bin/check-flattens || fail "bin/check-flattens"

sec "gas: no operation does unbounded work for bounded gas (0009)"
# Scaling, not absolutes: each case runs at n and 8n with the setup subtracted.
# The stats are diagnostics-only (`two-builds`), so the instrumented units are built.
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
bb test/gas.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/gas.clj"; }
grep -E "^ +(ok|FAIL|[a-z])" /tmp/flint-test.out | sed 's/^/  /'

sec "tables: columnar storage that is a value (0026)"
# The stats it reads are diagnostics-only (`two-builds`), so the instrumented units
# have to be in place -- same reason `documents` below builds them.
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
bb test/tables.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/tables.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "documents: structure once, content on demand, memory measured"
bb test/document.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/document.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
sec "the language itself: checks that hold on every runtime"
# `test/common` is written in flint and asserts ANSWERS, which is the half
# `runtimes/conform` cannot cover: that harness diffs transcripts across
# runtimes, so two ports wrong the same way agree and pass. Run here on wasm,
# and on native, JVM and CLR by `bin/conform-hosts`.
./bin/flint test :src test/common > /tmp/flint-test.out 2>&1 \
  || { cat /tmp/flint-test.out; fail "flint test :src test/common"; }
grep -E "FAIL" /tmp/flint-test.out || true
tail -2 /tmp/flint-test.out | head -1
# A FLOOR UNDER THE PASS. A suite with NO tests fails to compile, so the empty
# case is loud -- but a suite that SHRINKS is silent. One namespace failing to
# load takes its checks with it and everything still reports "all passed",
# which is how a corpus quietly stops covering what it was written for.
common_n=$(sed -n 's/^\([0-9][0-9]*\)\/[0-9][0-9]* checks passed$/\1/p' /tmp/flint-test.out)
case "$common_n" in
  ''|*[!0-9]*) fail "test/common did not report a check count" ;;
esac
[ "$common_n" -ge 110 ] || fail "test/common ran only $common_n checks, and at least 110 are expected"

# Leave the tree in the production configuration, so anything built afterwards
# is what would ship.
echo
sec "units: back to the production build"
./bin/build-units > /dev/null || fail "build-units"
echo "  ok"

times_summary
