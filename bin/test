#!/bin/sh
# Everything. Fails loudly; skips nothing.
set -e
# A pipeline reports the exit status of its LAST command, so `bb x | tail -1`
# would hide a failing test behind a successful `tail`. Every `bb` step below
# therefore checks its own result.
cd "$(dirname "$0")/.."
fail() { echo; echo "FAILED: $1"; exit 1; }

echo "== rust: runtime unit tests and VM integration tests"
cargo test -p flint-rt 2>&1 | grep -E "^(test result|error)" || fail "cargo test"
cargo test -p flint-rt 2>&1 | grep -q "FAILED" && fail "cargo test" || true

echo
echo "== rust: green threads, ports, and a parked thread under collection"
cargo test -p flint-conc 2>&1 | grep -E "^(test result|error)" || fail "cargo test -p flint-conc"
cargo test -p flint-conc 2>&1 | grep -q "FAILED" && fail "cargo test -p flint-conc" || true

echo
echo "== units: the PRODUCTION build (no diagnostic machinery -- 0016)"
./bin/build-units >/dev/null 2>&1 || fail "build-units"
echo "  ok"

echo
echo "== reader"
bb --classpath src test/reader_test.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/reader_test.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== conformance: 130 Clojure expressions, on flint"
./bin/flint :src test :fn conform.runner/main :out out/conform.wasm >/dev/null
node host/flint.mjs out/conform.wasm | tee /tmp/conform.out
grep -q '^PASS' /tmp/conform.out || fail "conformance"

echo
echo "== conformance: the same expressions, under real Clojure"
bb test/conform_vs_clojure.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/conform_vs_clojure.clj"; }
tail -2 /tmp/flint-test.out

echo
echo "== end to end: hand-assembled images, linked and run"
bb --classpath src test/e2e_link.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/e2e_link.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== modularity: only reachable code ships"
bb test/modularity.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/modularity.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== options: :exclude is an assertion, :wasm-path is a search path"
./bin/build-test-unit >/dev/null 2>&1 || fail "build-test-unit"
bb test/options.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/options.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== threads: green threads, ports, protocols, dynamic vars"
bb test/threads.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/threads.clj"; }

echo "== catch: Exception means what it means in Clojure"
bb test/catch.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/catch.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== loader: an image runs in a module that never linked it (0023)"
bb test/loader.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/loader.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== pause: the collector collects little and often, so the tail stays tight (0018)"
bb test/pause.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/pause.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== opaque: identity without structure, across a moving collector (0022)"
bb test/opaque.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/opaque.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== capability: possession is not the check, the grant table is (0021, 0022)"
bb test/capability.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/capability.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== cli: the command surface, tasks, and running an image directly (0021)"
bb test/cli.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/cli.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== scaling: doubling the input must not square the work"
bb test/scaling.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/scaling.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== ropes: three tiers, one string, and the flattens counted (0011)"
bb test/ropes.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/ropes.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== pike: one shared NFA, two simulators, a rope cursor (0012)"
bb test/regex_pike.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/regex_pike.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== aot: the emitter, validated one arity at a time (0013)"
bb test/aot_emit.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/aot_emit.clj"; }
tail -3 /tmp/flint-test.out

echo "== aot: the same answer AND the same instruction count as the interpreter"
# Its own build, like diagnostics: a production runtime cannot run compiled
# arities and does not carry the machinery that would (doc/decisions/0013, 0016).
./bin/build-units --aot > /dev/null || fail "build-units --aot"
bb test/aot.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; ./bin/build-units > /dev/null; fail "test/aot.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
./bin/build-units > /dev/null || fail "build-units (back to production)"
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
echo "== host abi: tokens, one event queue, two lifetimes"
bb test/host_abi.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/host_abi.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
echo "== inline: :inline metadata, and the instruction count it removes"
bb test/inline.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/inline.clj"; }
grep -E "^  (ok|FAIL)" /tmp/flint-test.out | tail -3
node test/inline.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/inline.mjs"; }
grep -E "^    " /tmp/flint-test.out

echo
echo "== types: annotations are checked claims, and a proven one costs nothing"
bb test/types.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/types.clj"; }
grep -cE "^  ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'
node test/types.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/types.mjs"; }
grep -E "^    " /tmp/flint-test.out

echo
echo "== narrowing: which guard shapes it composes with (0013)"
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src test :fn narrow/main :out out/narrow.wasm > /dev/null 2>&1 || fail "build narrow.wasm"
node test/narrow.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/narrow.mjs"; }
grep -E "^    [a-z]" /tmp/flint-test.out | awk '{printf "%s=%s ", $1, $2} END {print ""}' | fold -sw 76 | sed 's/^/    /'
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
echo "== specialisation: the same instructions, and what one costs"
./bin/flint :src bench/progs :fn spec/main :out out/spec.wasm > /dev/null 2>&1 || fail "build spec.wasm"
node bench/specialised.mjs > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bench/specialised.mjs"; }
grep -E "^  (generic|specialised|[0-9])" /tmp/flint-test.out | sed 's/^/  /'

echo
echo "== collections: transients, and what a seq walk costs in memory"
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src bench/progs :fn colls/main :out out/colls-diag.wasm > /dev/null 2>&1 || fail "build colls"
node bench/colls.mjs 20000 conj conj! assoc assoc! reduce group-by zipmap select-keys \
  > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bench/colls.mjs"; }
grep -E "^  [a-z]" /tmp/flint-test.out | sed 's/^/  /'
# The claim this section exists to defend: a transient allocates less than the
# persistent it replaces. If that stops being true, something regressed in the
# collections and no wall-clock check would notice.
awk '/^  conj  /{p=$4} /^  conj! /{t=$4} END{gsub(",","",p); gsub(",","",t);
  if (t+0 >= p+0) { print "  FAIL conj! allocates " t " against conj " p; exit 1 }
  else print "  ok   conj! allocates " t " where conj allocates " p }' /tmp/flint-test.out || fail "transients stopped helping"
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
echo "== distributable: the compiler and loader, driven by the SDK alone"
# Rebuilt every run, because the artifacts are generated and a stale one that
# still passes is the failure this section exists to catch.
./bin/build-dist > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "bin/build-dist"; }
grep -E "^  (ok|FAIL)" /tmp/flint-test.out | sed 's/^/  /'

echo
echo "== bytes: a string of bytes, in two tiers (0024)"
bb test/bytes.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/bytes.clj"; }
grep -cE "^  ok" /tmp/flint-test.out | sed 's/^/    /;s/$/ checks/'
# The number the type exists for: the same bytes, two representations.
./bin/build-units --diagnostics > /dev/null 2>&1 || fail "build-units --diagnostics"
./bin/flint :src bench/progs :fn colls/main :out out/colls-diag.wasm > /dev/null 2>&1 || fail "build colls"
node bench/colls.mjs 200000 bytes-as-vec bytes-as-bytes byte-cat byte-trans > /tmp/flint-test.out 2>&1 \
  || { cat /tmp/flint-test.out; fail "bench/colls.mjs bytes"; }
grep -E "^  (bytes-as|byte-)" /tmp/flint-test.out | sed 's/^/  /'
# The claim the transient exists for: building a byte at a time allocates
# essentially nothing. If that stops being true nothing else here notices.
awk '/^  byte-cat /{c=$4} /^  byte-trans /{t=$4} END{gsub(",","",c); gsub(",","",t);
  if (t+0 >= c/100) { print "  FAIL byte-trans allocated " t " against byte-cat " c; exit 1 }
  else print "  ok   byte-trans allocates " t " where byte-cat allocates " c }' \
  /tmp/flint-test.out || fail "the transient stopped helping"
./bin/build-units > /dev/null 2>&1 || fail "build-units"

echo
echo "== shake: cutting a prebuilt module down, with no linker (0024)"
bb test/shake.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/shake.clj"; }
grep -E "^    " /tmp/flint-test.out

echo
echo "== binary: the single-file CLI, compiling and running with nothing installed"
# Built against dist/, which the section above just rebuilt. This is the
# release artifact, so what is asserted is what a user does with it: compile a
# program and run the result.
cargo build -p flint-cli --release > /tmp/flint-test.out 2>&1 \
  || { tail -20 /tmp/flint-test.out; fail "cargo build -p flint-cli"; }
rm -rf /tmp/flint-smoke && mkdir -p /tmp/flint-smoke
printf '(ns smoke (:require [clojure.string :as s]))\n(defn main [args] (s/upper-case (str "ok " (reduce + 0 (range 10)))))\n' \
  > /tmp/flint-smoke/smoke.cljc
./target/release/flint compile /tmp/flint-smoke --entry smoke/main -o /tmp/flint-smoke/out.wasm 2>&1 \
  | sed 's/^/    /' || fail "flint compile"
got="$(./target/release/flint run /tmp/flint-smoke/out.wasm)"
[ "$got" = "OK 45" ] || { echo "    got '$got'"; fail "the binary did not run its own output"; }
echo "    the binary compiled a program and ran it: $got"
ls -l target/release/flint | awk '{printf "    binary %.1f MB\n", $5/1048576}'

echo
echo "== check: what was written for flint and does nothing"
# The fixture carries one of each kind, so it must FAIL -- a checker that
# cannot fail is not checking. The two host hints must NOT be what fails it.
if ./bin/flint check :src test/fixtures > /tmp/flint-test.out 2>&1; then
  cat /tmp/flint-test.out; fail "flint check passed a file with a bare flint key"
fi
grep -q "bare-key" /tmp/flint-test.out || fail "check missed the bare key"
grep -q "unknown-flint-key" /tmp/flint-test.out || fail "check missed a typo'd flint key"
grep -q "^2 finding" /tmp/flint-test.out || fail "check counted the host hints as findings"
grep -E "^    \^" /tmp/flint-test.out | sed 's/^/  /'
# And it must PASS flint's own source, which carries host hints and no mistakes.
./bin/flint check :src src :src lib > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "flint check flags flint own source"; }
grep -E "annotation" /tmp/flint-test.out | sed 's/^ */    /' 

echo
echo "== decisions: the index agrees with what is in the tree"
./bin/check-decisions || fail "bin/check-decisions"

echo
echo "== manifest: the deficiency lists are true"
bb test/manifest.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/manifest.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== modmeta: what a module says about itself, without instantiating (0020)"
bb test/modmeta.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/modmeta.clj"; }
grep -E "^    |FAIL" /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo "== two builds: a production module carries no diagnostics (0016)"
bb test/twobuilds.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/twobuilds.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
echo "== self-hosting fixpoint"
bb test/selfhost.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/selfhost.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "all green"

# --- the instrumented build ------------------------------------------------
#
# 0016: both configurations are built and exercised, because a feature nothing
# compiles is a feature that rots. The suite above ran against the stripped
# module; these are the tests that need the machinery it does not carry.
echo
echo "== units: the DIAGNOSTICS build"
cargo test -q -p flint-rt --features diagnostics 2>&1 | grep -E "^test result|panicked" || fail "cargo test --features diagnostics"
cargo test -q -p flint-conc --features diagnostics 2>&1 | grep -E "^test result: ok\. [1-9]|panicked" || true
./bin/build-units --diagnostics > /dev/null || fail "build-units --diagnostics"
echo "  ok"

echo
echo "== gc: compound keys survive collection"
bb test/gc_stress.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/gc_stress.clj"; }
tail -1 /tmp/flint-test.out

echo
echo "== limits: deterministic gas, charged natives, a catchable memory cap"
bb test/limits.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/limits.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
echo "== snapshots: capture, import, and an inspector that can read them"
bb test/snapshot.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/snapshot.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

echo
echo "== documents: structure once, content on demand, memory measured"
bb test/document.clj > /tmp/flint-test.out 2>&1 || { cat /tmp/flint-test.out; fail "test/document.clj"; }
grep -E "^    " /tmp/flint-test.out || true
tail -1 /tmp/flint-test.out

# Leave the tree in the production configuration, so anything built afterwards
# is what would ship.
echo
echo "== units: back to the production build"
./bin/build-units > /dev/null || fail "build-units"
echo "  ok"
