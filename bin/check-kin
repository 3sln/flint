#!/bin/sh
# Three questions about the kin sources, none of which anything asked before.
#
#   1. Does every source still produce IDENTICAL output for all three targets?
#      That is what `kin/scripts/verify` answers, and it was being run by
#      hand, once, when a source was written.
#
#   2. Does the CHECKED-IN generated code still match what its source
#      produces? The generated tree is committed on purpose -- a runtime build
#      must not need babashka -- and the cost of that choice is that the two
#      can drift. A hand edit survives until someone happens to re-emit; a
#      vocabulary change silently makes every committed file stale. Nothing
#      noticed either.
#
#      `fixnum` widened the wrong way on both ports for thirteen sources, and
#      when it was fixed the only thing that re-emitted the affected files was
#      me remembering to.
#
#   3. IS EVERY GENERATED MODULE ACTUALLY REACHED? This one is new with the
#      module layout. A missing `import static` in Java or `using static` in
#      C# is a compile error at the call site; a missing `pub mod champ;` is
#      a file that is simply never BUILT, and nothing has to complain.
#
#      MEASURED, because the obvious claim is too strong: deleting `pub mod
#      champ;` and running `cargo check` gave 103 errors, not silence -- the
#      eight functions in `champ.rs` are called from six other modules, so
#      their absence is loud. The silence is waiting for the first generated
#      module whose callers are all inside the generated tree, or that is
#      added before its first caller. That is a normal thing to do and it
#      would leave the build green with the code gone.
#
#      Decision I says kin REPORTS the consuming lines and a person applies
#      them -- so the report has to be a check, not a courtesy.
#
#      It also catches the other direction: a generated file that no
#      source produces, which is what a renamed or deleted source leaves
#      behind.
#
# WHAT THIS USED TO COMPARE, and it is worth saying because the answer
# changed: regions. It snapshotted the eighteen hand-written files that had
# `kin:begin`/`kin:end` markers in them and diffed the lines between the
# markers. It now snapshots the forty-two files kin owns outright and diffs
# them whole. Same question, larger unit, and nothing left that a hand edit
# can hide in.
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
# A PRIVATE WORK DIRECTORY PER RUN. A fixed one is deleted out from under a
# concurrent run, and a gate that fails at random gets re-run until it passes
# and then gets ignored.
work=$(mktemp -d "${TMPDIR:-/tmp}/check-kin.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/snap"
fails=0

# NO TEMPLATE PLACEHOLDER SURVIVES INTO GENERATED CODE.
#
# A vocabulary word is a POSITIONAL template with no arity check. Call one with
# too few arguments and the unfilled `{N}` is copied through verbatim: on
# 2026-09-20 `(crosses-a-heap kind)` -- correct-looking, and missing the
# receiver every other word in the table takes -- emitted
# `crosses_a_heap({1})` into a Rust file.
#
# That IS caught, eventually, by all three compilers. What it is not caught
# WITH is a message naming the cause: the error blames generated code that
# nobody wrote, three steps from the call that is wrong. This says it here,
# with the file and the line.
#
# COMMENTS ARE STRIPPED FIRST, and that is not cosmetic. Three generated files
# legitimately carry `#{1}`, `{:a 1}` and `#{0}` inside doc comments -- Clojure
# set and map literals quoted in prose -- and a check that flagged those would
# be turned off within a week.
stray=$(for f in runtime/src/kgen/rt/*.rs \
                 runtimes/jvm/src/com/_3sln/flint/kgen/rt/*.java \
                 runtimes/clr/src/_3sln/Flint/Kgen/Rt/*.cs; do
          [ -f "$f" ] || continue
          sed 's|//.*||' "$f" | grep -nE '\{[0-9]\}' | sed "s|^|$f:|"
        done)
if [ -n "$stray" ]; then
  echo "check-kin: a vocabulary template left an unfilled placeholder in generated code."
  echo "$stray" | sed 's/^/  /'
  echo "  A word in kin/src/flint/impl/rt.cljc was called with too FEW arguments."
  echo "  Every word takes the runtime first, including the ones that ignore it."
  exit 1
fi
set -e

# --- 0. The NAME TABLE, before any source is asked to use one. --------------
#
# `type-tags` claimed `TY_SYMBOL` and `TY_KEYWORD` for the life of this port
# and no target has ever defined either -- they are `TY_SYM` and `TY_KW`
# everywhere. Nothing broke because no source had named one yet, which is
# exactly why nothing found it: an entry nothing uses is an entry nothing
# checks. This runs FIRST because it is the cheapest of the checks here and
# the only one that can fail on a name no source mentions.
if out=$(./kin/scripts/check-names 2>&1); then
  echo "  ok   every name in the vocabulary is defined by the runtime that needs it"
else
  echo "$out" | sed -n 's/^  FAIL/  FAIL/p'
  fails=$((fails + 1))
fi

verified=0
# IN PARALLEL, because this loop was 371 of the gate's 1671 seconds -- 22% of
# it, and the largest single item by a factor of two. Ninety sources at about
# four seconds each, every one of them independent: each `verify` compiles one
# source for three targets in its own `mktemp -d`, which the script was already
# careful about ("this used to be a fixed $TMPDIR/kin-verify, which two
# concurrent runs..."). Concurrency was anticipated here; nothing used it.
#
# Output is collected and SORTED rather than streamed, because interleaved
# lines from ninety jobs are unreadable and, worse, unstable -- a gate whose
# output reorders between runs cannot be diffed.
_kin_jobs=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
_kin_out=$(mktemp "${TMPDIR:-/tmp}/check-kin.XXXXXX")
# `-n1`, NOT `-I@`. `-I` substitutes its placeholder in EVERY argument that
# follows, and this repository's own path contains `@3sln` -- so the moment an
# `@` appears in the script below, or in a path handed to it, xargs rewrites it
# into a filename. It is correct today only because nothing here happens to
# contain one. `-n1` appends the argument instead, with no substitution at all.
printf '%s\n' kin/*.kin | xargs -P "$_kin_jobs" -n1 sh -c '
  src="$1"
  name=$(basename "$src" .kin)
  if [ ! -f "kin/$name.drivers" ]; then
    echo "  FAIL $name has no drivers file"
    exit 0
  fi
  # AN `--expect` SECTION IS THE OTHER HALF, and it is counted rather than
  # merely available. `verify` compares the three targets WITH EACH OTHER,
  # which cannot see a logic error in the one source they all come from --
  # three identically-wrong implementations agree. A source with an `--expect`
  # says what the answer SHOULD BE; one without is checked only against
  # itself, one level up from the thing this script already refuses.
  if out=$(./kin/scripts/verify "$src" 2>&1); then
    echo "  ok   $name agrees across three targets"
  else
    echo "  FAIL $name does not agree across targets"
    echo "$out" | tail -5 | sed "s/^/       /"
  fi
' _ >> "$_kin_out" 2>&1
sort "$_kin_out"
verified=$(ls kin/*.kin | wc -l | tr -d ' ')
# AN `--expect` SECTION IS THE OTHER HALF, counted rather than merely
# available. `verify` compares the three targets WITH EACH OTHER, which cannot
# see a logic error in the one source they all come from -- three identically
# wrong implementations agree. A source with an `--expect` says what the answer
# SHOULD BE; one without is checked only against itself, one level up from the
# thing this script already refuses.
#
# Counted here rather than inside the loop: the loop runs under `xargs`, and a
# counter incremented in a subshell does not survive it.
expected=$(grep -l '^--expect$' kin/*.drivers 2>/dev/null | wc -l | tr -d ' ')
fails=$((fails + $(grep -c '^  FAIL' "$_kin_out" || true)))
rm -f "$_kin_out"

# ASK KIN WHERE IT WRITES. Destination is computed from the namespace by a
# function each target carries, so the only thing that knows the answer is
# kin -- which is the point of the change, and the reason a gate has to ask
# rather than read.
targets=$(./kin/scripts/destinations)
# Newline-separated from the script; the membership test below needs spaces.
targets_sp=" $(echo $targets) "

# --- 3. Reachability, before anything is re-emitted. ------------------------
#
# Rust is the one that needs it. Every generated module must have a line in
# `kgen/rt.rs`, and every file under a generated tree must be one kin
# says it writes.
modfile=runtime/src/kgen/rt.rs
for f in $targets; do
  case $f in
    runtime/src/kgen/*)
      m=$(basename "$f" .rs)
      if grep -q "^pub mod $m;\$" "$modfile"; then
        echo "  ok   $m is declared in $modfile"
      else
        echo "  FAIL $f is generated and NOT declared in $modfile"
        echo "       -- Rust will not compile it, and nothing else will say so."
        echo "       Add:  pub mod $m;"
        fails=$((fails + 1))
      fi ;;
  esac
done

# The three generated trees, each in its own language's convention:
#   rust    runtime/src/kgen/                       crate::kgen::rt::*
#   java    runtimes/jvm/src/com/_3sln/flint/kgen/  com._3sln.flint.kgen.rt
#   csharp  runtimes/clr/src/_3sln/Flint/Kgen/      _3sln.Flint.Kgen.Rt
for f in $(find runtime/src/kgen runtimes/jvm/src/com/_3sln/flint/kgen \
             runtimes/clr/src/_3sln/Flint/Kgen \
             -type f \( -name '*.rs' -o -name '*.java' -o -name '*.cs' \) 2>/dev/null); do
  # The module declarations themselves are hand-written and belong here.
  case $f in
    runtime/src/kgen/rt.rs) continue ;;
  esac
  case "$targets_sp" in
    *" $f "*) ;;
    *) echo "  FAIL $f is in a generated tree and no kin source generates it"
       echo "       -- left behind by a renamed or deleted source."
       fails=$((fails + 1)) ;;
  esac
done

# --- 2. Drift. Snapshot everything, re-emit, compare, put it all back. ------
i=0
for f in $targets; do
  i=$((i + 1))
  cp "$f" "$work/snap/$i"
  echo "$f" >> "$work/snap/list"
done
restore() {
  n=0
  while read -r f; do
    n=$((n + 1))
    cp "$work/snap/$n" "$f"
  done < "$work/snap/list"
}
trap 'restore; rm -rf "$work"' EXIT

# Every source, including the ones written nowhere -- kin reports those and
# writes nothing, which is a legitimate answer rather than a case to skip.
./kin/scripts/emit > /dev/null

n=0
while read -r f; do
  n=$((n + 1))
  if cmp -s "$work/snap/$n" "$f"; then
    echo "  ok   $f matches its sources"
  else
    echo "  FAIL $f has drifted from the kin sources that generate it"
    diff "$work/snap/$n" "$f" | head -20
    fails=$((fails + 1))
  fi
done < "$work/snap/list"

restore
trap 'rm -rf "$work"' EXIT
[ "$fails" -eq 0 ] || { echo "check-kin: $fails failure(s)"; exit 1; }
# A FLOOR UNDER THE ZERO. `fails -eq 0` is also what an EMPTY `kin/*.kin`
# reports, and the summary below would say every source agrees while having
# checked none. The same hole `test/gc_stress.clj` had: a clean answer over a
# walk that visited nothing.
#
# A floor rather than the exact count, so adding a source does not fail the
# gate that exists to protect the sources.
[ "$verified" -ge 70 ] || {
  echo "check-kin: only $verified kin sources were checked, and at least 70 are expected"
  echo "  A pass over almost nothing looks exactly like a pass over everything."
  exit 1
}
# EVERY SOURCE CARRIES AN EXPECTATION, and this is the same argument as the
# floor above, one level up.
#
# `verified` counts sources whose three targets AGREE. Agreement cannot see a
# logic error in the source they all come from: one wrong `.kin` emits three
# identically-wrong implementations, which agree perfectly and pass. Only an
# `--expect` section says what the answer should BE.
#
# NOT A FLOOR WITH A MARGIN, unlike `verified`. A margin there is right,
# because it protects a gate from the act of adding a source. A margin here
# would do the opposite: it would let the next source arrive with no
# expectation and no complaint, which is exactly how the previous state --
# ninety drivers and not one expected value -- was reached without anyone
# deciding on it. All ninety have one, so the check is `all of them`, and a
# new source writes its expectation as part of being written.
if [ "$expected" -lt "$verified" ]; then
  echo "check-kin: $expected of $verified kin sources carry an --expect section."
  echo "  Every one is meant to. Without it a source is checked only against"
  echo "  ITSELF: three targets from one source agree however wrong the source is."
  for src in kin/*.kin; do
    n=$(basename "$src" .kin)
    grep -q '^--expect$' "kin/$n.drivers" || echo "  missing: kin/$n.drivers"
  done
  exit 1
fi
echo "check-kin: $verified kin sources agree, all $expected against a written-down expected answer,"
echo "           every generated module matches, and every one is DECLARED where"
echo "           Rust would otherwise not build it"
# "DECLARED", NOT "REACHED", AND THE DIFFERENCE IS THE WHOLE POINT OF CHECK 3.
# This line read "and every one is reached" until 2026-09-22, which is a
# stronger claim than anything here tests: the loop above asserts a `pub mod`
# line exists, not that a call site does. The two come apart exactly where the
# header says the silence is waiting -- a module whose callers are all inside
# the generated tree, or one added before its first caller. An audit that day
# found 11 modules reached only from within the generated tree and one,
# `wire-peek`, generated into three runtimes and called from none of them,
# not even its own drivers. All twelve pass this check, as they should: being
# declared is what it verifies. A banner that says more is the failure mode
# this file's own preamble warns about one section earlier.
