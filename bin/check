#!/bin/sh
# THE FAST TIER: about five seconds. Run it on every change.
#
# `bin/test` is roughly twenty minutes and was being run on every commit. That
# is the wrong default -- most changes cannot break most of it, and a gate that
# expensive gets run less carefully rather than more.
#
#   bin/check            ~5 s      every change
#   bin/test             ~20 min   before pushing, and on a PR
#   bin/test-diagnostics ~10 min   the five suites inside `bin/test` that need
#                                  a DIAGNOSTICS units build, with the
#                                  production build put back afterwards
#   bin/release-gate     ~25 min   before a versioned release
#
# WHAT IS IN HERE WAS CHOSEN BY MEASURING, not by guessing. The four static
# checks are sub-second each; `reader_test` is 1 s and `cycles` is 3 s. Two
# suites that looked like candidates are not: `requires` is 15 s and `options`
# is 16 s AND fails standalone, because it needs build state the full gate
# happens to produce -- which is its own warning about selective testing.
set -e
cd "$(dirname "$0")/.."
fail() { echo; echo "FAILED: $1"; exit 1; }

# A DIAGNOSTICS UNITS TREE IS NOT WHAT THIS MEASURES. `bin/build-units
# --diagnostics` leaves an instrumented runtime in `units/`, and every size,
# gas figure and allocation count taken against it is a different number.
# `bin/test` builds it deliberately and puts the production build back as its
# last section -- but anything that stops in between leaves it there, and
# nothing said so. Cheap to ask, and wrong answers here are expensive.
if [ "$(cat units/.build-mode 2>/dev/null)" = diagnostics ]; then
  echo "FAILED: units/ holds a DIAGNOSTICS build, so every figure here would"
  echo "        be measuring the wrong artefact. Put it back with:"
  echo
  echo "            ./bin/build-units"
  exit 1
fi
t0=$(date +%s)

for c in check-version check-contracts check-decisions check-flattens check-builtins check-sys-catalogue check-lib-grants \
         check-snapshot-layout check-aotstat-layout check-port-consts check-artifact-ops \
         check-generated-reached check-vocab-used dead-runtime-fns; do
  ./bin/$c || fail "bin/$c"
done

# THE FOUR OPERATIONS, on every target that has them
# (`DECISIONS.md#four-operations`). It compiles a program and runs it, so it is
# slower than the checks above -- about twenty seconds, against their one -- and
# it belongs in the fast tier anyway: the failure it catches is two targets
# answering different questions and both passing, which nothing else looks for.
#
# It SKIPS a target with no toolchain and says so, and FAILS if nothing at all
# was exercised. A run that asserts nothing must not read as a pass.
./bin/check-four-ops || fail "bin/check-four-ops"

# THE FOUR FILES BABASHKA LOADS OUT OF `lib/` MUST STAY `.cljc`.
#
# `bin/flint` runs under babashka and requires these from `lib/`; babashka
# cannot read a `.fln`. Renaming one would break the bootstrap host with an
# error naming the namespace rather than the extension, and the dialect rule
# actively invites the rename -- every one of them calls `flint.rt` somewhere
# or is flint-specific, so "is this portable?" says `.fln` while "does anything
# outside flint read it?" says `.cljc`. The second question is the one that
# governs, and this is the only place that says so.
for f in flint/cli flint/deps flint/deps/manifest flint/deps/registry; do
  [ -f "lib/$f.cljc" ] || fail "lib/$f.cljc is gone -- babashka loads it, so it cannot be .fln"
done
echo "  ok   the four lib namespaces babashka loads are still .cljc"

# The API review list cannot fall behind the code: a namespace added with no
# section would be silently unreviewed while the list looked complete.
./bin/check-api-review || fail "bin/check-api-review"

for s in reader_test cycles; do
  bb --classpath src "test/$s.clj" > /tmp/flint-check.out 2>&1 \
    || { cat /tmp/flint-check.out; fail "test/$s.clj"; }
  echo "  ok   test/$s.clj"
done

# `check-kin` is 74 s -- too slow for every change, and it has a PRECISE input
# set, so it runs only when that input moved. This is the changed-files idea
# applied where it actually works: a check whose inputs are a known list of
# directories, rather than a guess about which suite covers which file.
kin_touched=$(git diff --name-only HEAD -- \
  kin runtime/src/kgen runtimes/jvm/src/com/_3sln runtimes/clr/src/_3sln 2>/dev/null | head -1)
if [ -n "$kin_touched" ]; then
  echo "  .. kin sources or generated trees changed; running check-kin (74 s)"
  ./bin/check-kin || fail "bin/check-kin"
else
  echo "  -- kin untouched; skipping check-kin (run ./bin/check-kin to force)"
fi

echo
echo "bin/check: green in $(( $(date +%s) - t0 ))s"
