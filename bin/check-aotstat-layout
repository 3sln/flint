#!/usr/bin/env python3
"""Every JS reader of `stat_region`, against the runtime's own array sizes.

`stat_region` is ONE export over several arrays laid end to end: four
histograms of `NBUCKET`, then `COUNTS`, then 256 opcode counters, then
`NATIVE_CALLS`, then `NATIVE_FIX`. A host that wants the native counts has to
know where they start, so six JS files carry a copy of two numbers that
`runtime/src/aotstat.rs` defines -- and a copy that drifts is not a copy.

WHY THIS EXISTS. `COUNTS` grew from 28 entries to 43 and the copies stayed at
28, so every reader's base was 15 slots early: it paired each native's NAME
with a DIFFERENT native's count. `test/narrow.mjs` then reported the same
number -- 97, some unrelated native's total -- for all seventeen guard shapes,
including one that runs no guard at all, and read as "occurrence narrowing
composes with nothing". Narrowing was working in every row. The file had a
coverage check guarding exactly this ("every shape executed real code, so the
zeros mean something") and it passed, because the traffic it saw was real; it
just belonged to something else.

THE FAILURE IS SILENT AND PLAUSIBLE, which is what makes it worth a check. A
shifted base does not throw and does not read as zero -- it reads as a number,
and a number invites you to explain it.

Run from the repo root. Exit 1 on any drift.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC = ROOT / 'runtime' / 'src' / 'aotstat.rs'

READERS = ['test/narrow.mjs', 'bench/aot-construe.mjs', 'bench/annotated.mjs',
           'bench/specialise.mjs', 'bench/where.mjs', 'bench/regions.mjs']


def truth():
    """The four numbers a reader needs to find any array in `stat_region`."""
    s = SRC.read_text()
    m = re.search(r'pub const NBUCKET:\s*usize\s*=\s*(\d+)', s)
    if not m:
        sys.exit('check-aotstat-layout: no NBUCKET in aotstat.rs')
    out = {'NB': int(m.group(1))}
    # NCOUNT is the one that drifted; NOPS and NNAT are the same trap one array
    # further along, and were bare literals until they were named for this.
    for js, rs in (('NCOUNT', 'COUNTS'), ('NOPS', 'OPS'), ('NNAT', 'NATIVE_CALLS')):
        m = re.search(rf'pub static mut {rs}:\s*\[u64;\s*(\d+)\]', s)
        if not m:
            sys.exit(f'check-aotstat-layout: no {rs} array in aotstat.rs')
        out[js] = int(m.group(1))
    return out


def main():
    want = truth()
    errs = []
    seen = 0
    for rel in READERS:
        p = ROOT / rel
        if not p.exists():
            errs.append(f'{rel}: listed here but missing -- update this check')
            continue
        s = p.read_text()
        # A reader declares only the ones it uses, so absence is fine; a
        # declaration that disagrees is not.
        for name, n in want.items():
            for got in re.findall(rf'\b{name}\s*=\s*(\d+)', s):
                seen += 1
                if int(got) != n:
                    errs.append(f'{rel}: {name} = {got}, but aotstat.rs says {n}')
    if errs:
        print('check-aotstat-layout: the stat_region readers have drifted')
        for e in errs:
            print('  ' + e)
        return 1
    shape = ', '.join(f'{k} {v}' for k, v in want.items())
    print(f'check-aotstat-layout: {len(READERS)} readers agree with aotstat.rs '
          f'({shape}), {seen} constants checked')
    return 0


if __name__ == '__main__':
    sys.exit(main())
