#!/usr/bin/env python3
"""The snapshot inspector's type tables, against the runtime's own.

`host/snapshot.mjs` reads a heap it did not write, so it carries its own copy
of two things `runtime/src/obj.rs` defines: what each type NUMBER is called,
and which types store RAW BYTES rather than value slots. A copy that drifts is
not a copy.

WHY THIS EXISTS. `TY_BYTES` was added to `obj.rs` and not to the inspector, so
a byte string was sized `HDR + len * 8` instead of `HDR + len`. The linear walk
advanced by the wrong stride, landed in the middle of an object, read a header
that was not one, and stopped -- reporting the 42 216 bytes after it as simply
ABSENT. `test/snapshot.clj` then failed saying a snapshot taken while threads
were parked carried 1 thread instead of 4, which reads exactly like a runtime
that lost them. The snapshot was perfect; the reader could not walk it.

The runtime has already paid for this lesson once, in its own words at
`obj.rs`'s `size_of`: a type added to `layout_of` and not to the second copy of
that match sized "a 513-byte `TY_BYTES` as 4 112", and the collector walked
from-space with the wrong stride. Deriving the size from one table removed the
second copy inside Rust. This removes the third and fourth, which live in JS.

A MISSING TYPE IS NOT SYMMETRIC. Absent from the RAW set, a raw type is walked
as values: wrong stride, derailed walk, invented absences. Absent from the NAME
table it merely reads as `ty44`, which is ugly and harmless. Both are reported;
only the first can fabricate a bug.

Run from the repo root. Exit 1 on any drift.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OBJ = ROOT / "runtime" / "src" / "obj.rs"
MJS = ROOT / "host" / "snapshot.mjs"
# `layout_of` LEFT obj.rs. It is generated from `kin/objsize.kin` now, and what
# stands at its old address is a one-line delegate to here. The check went on
# parsing obj.rs, found no match arm, and died saying its own parse was stale
# -- which was true, and said nothing about the reason. Read it where it lives.
LAY = ROOT / "runtime" / "src" / "kgen" / "rt" / "objsize.rs"

# A check that cannot find what it checks must FAIL, not pass quietly: silence
# from a broken gate is indistinguishable from a clean one.
def die(msg):
    print(f"check-snapshot-layout: {msg}")
    sys.exit(1)


for p in (OBJ, MJS, LAY):
    if not p.exists():
        die(f"{p.relative_to(ROOT)} is not there; this check cannot run")

obj_src = OBJ.read_text()
lay_src = LAY.read_text()
mjs_src = MJS.read_text()

# --- the runtime's side ----------------------------------------------------

# `pub const TY_THREAD: u8 = 39;` -- every type number and its name.
rust_types = {}
for m in re.finditer(r"^pub const TY_(\w+): u8 = (\d+);", obj_src, re.M):
    name, num = m.group(1), int(m.group(2))
    if name == "MAX":
        continue
    rust_types[num] = name

if not rust_types:
    die("found no `pub const TY_* : u8` in obj.rs; the parse is stale")

# The generated shape is an `if` chain, not a match arm -- kin emits a guarded
# `return` per branch:
#
#     if (ty == TY_BIGINT) || ((ty == TY_RAW) || (... || (ty == TY_FWD))) {
#         return crate::obj::Layout::Raw;
#     }
#
# So take the condition of whichever `if` returns `Layout::Raw` and read every
# `TY_*` out of it, which is insensitive to how the `||`s are parenthesised.
raw_arm = re.search(r"if (.+?) \{\s*\n\s*return crate::obj::Layout::Raw;",
                    lay_src)
if not raw_arm:
    die(f"found no branch returning `Layout::Raw` in {LAY.relative_to(ROOT)}; "
        f"the parse is stale")

rust_raw_names = set(re.findall(r"TY_(\w+)", raw_arm.group(1)))
if not rust_raw_names:
    die("the `Layout::Raw` branch names no `TY_*` at all; the parse is stale")
by_name = {v: k for k, v in rust_types.items()}
missing_const = rust_raw_names - set(by_name)
if missing_const:
    die(f"`layout_of` names {sorted(missing_const)}, which have no `pub const`")
rust_raw = {by_name[n] for n in rust_raw_names}

# --- the inspector's side --------------------------------------------------

raw_set = re.search(r"const LAYOUT_RAW = new Set\(\[(.*?)\]\)", mjs_src, re.S)
if not raw_set:
    die("found no `const LAYOUT_RAW = new Set([...])` in host/snapshot.mjs")
js_raw = {int(n) for n in re.findall(r"(\d+)\s*/\*", raw_set.group(1))}
if not js_raw:
    die("LAYOUT_RAW parsed as empty; every entry needs a `N /* NAME */` comment")

ty_table = re.search(r"export const TY = \{(.*?)\n\};", mjs_src, re.S)
if not ty_table:
    die("found no `export const TY = {...}` in host/snapshot.mjs")
js_names = {int(n): nm for n, nm in
            re.findall(r"(\d+):\s*'(\w+)'", ty_table.group(1))}
if not js_names:
    die("the TY table parsed as empty; the parse is stale")

# --- the comparison --------------------------------------------------------

problems = []

# THE ONE THAT FABRICATES BUGS: a raw type walked as values derails the walk.
for n in sorted(rust_raw - js_raw):
    problems.append(
        f"TY_{rust_types[n]} ({n}) is Layout::Raw in kgen/rt/objsize.rs but not in "
        f"LAYOUT_RAW -- snapshot.mjs will size it HDR+len*8 and derail the walk")
for n in sorted(js_raw - rust_raw):
    nm = rust_types.get(n, "?")
    problems.append(
        f"TY_{nm} ({n}) is in LAYOUT_RAW but is not Layout::Raw in kgen/rt/objsize.rs -- "
        f"snapshot.mjs will size it HDR+len and derail the walk")

# Cosmetic by comparison, but a type nobody named is a type nobody looked at.
for n in sorted(set(rust_types) - set(js_names)):
    problems.append(f"TY_{rust_types[n]} ({n}) has no name in snapshot.mjs's "
                    f"TY table; it will read as `ty{n}`")
for n in sorted(set(js_names) - set(rust_types)):
    problems.append(f"snapshot.mjs names {n} as {js_names[n]}, which obj.rs "
                    f"does not define")
for n in sorted(set(rust_types) & set(js_names)):
    if rust_types[n] != js_names[n]:
        problems.append(f"{n} is TY_{rust_types[n]} in obj.rs but "
                        f"'{js_names[n]}' in snapshot.mjs")

if problems:
    print("check-snapshot-layout: the inspector has drifted from the runtime")
    for p in problems:
        print(f"  {p}")
    sys.exit(1)

print(f"check-snapshot-layout: ok ({len(rust_types)} types, "
      f"{len(rust_raw)} raw)")
