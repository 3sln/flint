#!/usr/bin/env bb
;; flint :src <dir> :fn <ns/fn> [:out <file.wasm>]
(require '[clojure.string :as str] '[clojure.java.io :as io] '[babashka.fs :as fs])
(def root (str (fs/parent (fs/parent (fs/real-path *file*)))))
(babashka.classpath/add-classpath (str root "/src"))
(require '[flint.compiler :as compiler] '[flint.image :as img] '[flint.link :as link]
         '[flint.reader :as reader])

(defn parse-args [args]
  (loop [a args m {}]
    (if-let [k (first a)]
      (cond
        (= k ":src") (recur (drop 2 a) (update m :src (fnil conj []) (second a)))
        (= k ":fn") (recur (drop 2 a) (assoc m :fn (symbol (second a))))
        (= k ":out") (recur (drop 2 a) (assoc m :out (second a)))
        (= k ":o") (recur (drop 2 a) (assoc m :out (second a)))
        (= k "--stats") (recur (rest a) (assoc m :stats true))
        (= k "--keep-names") (recur (rest a) (assoc m :keep-names true))
        (= k "--explain") (recur (drop 2 a) (assoc m :explain (symbol (second a))))
        (= k "--disasm") (recur (drop 2 a) (assoc m :disasm (second a)))
        (= k "--const") (recur (drop 2 a) (assoc m :const (parse-long (second a))))
        :else (do (println "unknown argument:" k) (System/exit 2)))
      m)))

(defn ns->path [n]
  (str (-> (str n) (str/replace "-" "_") (str/replace "." "/"))))

(defn find-source [dirs n]
  (some (fn [d]
          (some (fn [ext]
                  (let [f (io/file d (str (ns->path n) ext))]
                    (when (.exists f) {:src (slurp f) :file (str f)})))
                [".cljc" ".clj"]))
        dirs))

(def virtual-namespaces
  ;; flint.rt is not a namespace you can load: the analyzer turns flint.rt/x into
  ;; a direct call into the wasm table. src/flint/rt.cljc exists only so the same
  ;; source runs on a host.
  '#{flint.rt})

(defn collect
  "Read namespaces from `entry-ns` outwards, returning [{ns {:src :file}} order]."
  [dirs roots]
  (loop [todo (vec roots) sources {} order []]
    (if-let [n (first todo)]
      (if (or (contains? sources n) (contains? virtual-namespaces n))
        (recur (rest todo) sources order)
        (if-let [s (find-source dirs n)]
          (let [forms (try (reader/read-all (:src s) {:file (:file s) :features #{:flint}})
                           (catch Exception e
                             (println "read error in" (:file s) ":" (ex-message e))
                             (System/exit 1)))
                nsform (first (filter #(and (seq? %) (= 'ns (first %))) forms))
                reqs (if nsform (compiler/ns-requires nsform) [])]
            (recur (into (vec (rest todo)) reqs)
                   (assoc sources n s)
                   (conj order n)))
          (do (println "cannot find source for namespace" n
                       "\n  searched:" (str/join ", " dirs))
              (System/exit 1))))
      [sources order])))

(defn topo-order [sources]
  ;; Dependencies before dependents; clojure.core always first.
  (let [deps (into {} (for [[n {:keys [src file]}] sources]
                        [n (let [forms (reader/read-all src {:file file :features #{:flint}})
                                 nsform (first (filter #(and (seq? %) (= 'ns (first %))) forms))]
                             (set (when nsform (compiler/ns-requires nsform))))]))]
    (loop [done [] seen #{} pending (vec (keys deps))]
      (if (empty? pending)
        done
        (let [ready (filter #(every? (fn [d] (or (seen d) (not (contains? deps d)))) (deps %)) pending)
              ready (if (seq ready) ready [(first pending)])]
          (recur (into done ready) (into seen ready) (vec (remove (set ready) pending))))))))

(defn core-first [order]
  ;; clojure.core is referred by every namespace, so it is always analysed first
  ;; whatever the require graph says.
  (cons 'clojure.core (remove #{'clojure.core} order)))

(defn builtin-names
  "Every builtin any unit provides. The compiler needs the union so it can tell
  a typo from a builtin in a namespace this program has not reached yet."
  [units-dir]
  (into #{} (for [d (.listFiles (io/file units-dir))
                  :when (.isDirectory d)
                  :let [f (io/file d "unit.edn")]
                  :when (.exists f)
                  k (keys (:provides (read-string (slurp f))))]
              k)))

(let [{:keys [src fn out stats keep-names explain disasm const]} (parse-args *command-line-args*)]
  (when-not fn
    (println "usage: flint :src <dir> :fn <ns/fn> [:out <file.wasm>]")
    (System/exit 2))
  (let [dirs (concat (or src []) [(str root "/lib")])
        entry-ns (symbol (namespace fn))
        [sources order] (collect dirs (cons entry-ns ['clojure.core]))
        order (core-first (topo-order sources))
        out (or out "out.wasm")
        t0 (System/nanoTime)
        compiled (compiler/compile-image
                  {:sources sources :order order :entry fn
                   :builtins (builtin-names (str root "/units"))})
        _ (when explain
            (println "explain" explain)
            (println "  in roots:" (contains? (:roots compiled) explain))
            (println "  kept:" (boolean (some #{explain} (:kept-syms compiled))))
            (println "  items with that sym:"
                     (count (filter #(= explain (:sym %)) (:items compiled))))
            (doseq [it (filter #(= explain (:sym %)) (:items compiled))]
              (println "    ns" (:ns it) "kind" (:kind it) "macro?" (:macro? it))))
        _ (when disasm
            (require '[flint.disasm :as dis])
            (let [b (:builder compiled)
                  st @b]
              (doseq [[i f] (map-indexed vector (:fns st))
                      :let [nm (get-in st [:consts (:name f) 1])]
                      :when (or (= nm disasm) (= (str i) disasm))]
                (println "fn" i nm)
                (doseq [a (:arities f)]
                  (println " arity argc" (:argc a) "variadic" (:variadic? a) "nlocals" (:nlocals a))
                  (println ((resolve 'flint.disasm/disasm) (:code st) (:off a) (:len a)))))))
        _ (when const
            (let [b @(:builder compiled)]
              (doseq [i (range (max 0 (- const 3)) (min (count (:consts b)) (+ const 4)))]
                (println "const" i (pr-str (nth (:consts b) i))))))
        {:keys [builder stats*]} (let [r (compiler/compile-image
                                          {:sources sources :order order :entry fn
                                           :builtins (builtin-names (str root "/units"))})]
                                   {:builder (:builder r) :stats* (:stats r)})
        t1 (System/nanoTime)
        result (link/compose {:units-dir (str root "/units")
                              :sysroot (str root "/units/.sysroot")
                              :needed-builtins (img/natives builder)
                              :emit-image (clojure.core/fn [slots] (img/emit builder slots))
                              :out out
                              :keep-names keep-names})
        t2 (System/nanoTime)]
    (when stats
      (println (format "compile %.0fms  link %.0fms  module %d bytes  image %d bytes  vars %d/%d  builtins %d"
                       (/ (- t1 t0) 1e6) (/ (- t2 t1) 1e6)
                       (:bytes result) (:image-bytes result)
                       (:items-kept stats*) (:items-total stats*)
                       (:builtins result))))
    (println "wrote" out (str "(" (:bytes result) " bytes)"))))
