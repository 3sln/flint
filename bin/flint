#!/bin/sh
# The flint compiler front end -- a THIN wrapper over a JVM Clojure driver
# (`DECISIONS.md#namespaces-over-the-system-port`, migration step 1.2).
#
# This used to BE the babashka script. The babashka script duplicated a good
# deal of `flint.project` by hand (AGENTS.md sec. 1) and read every source
# with `flint.reader`, the guest's own reader compiled to run under a host.
# The maintainer's decision (2026-10-06) was ONE reader, generated by kin, with
# only the decoder in the compiler -- so the bootstrap moves from babashka,
# which cannot call a generated Java class, to JVM Clojure, which can.
#
# What is here is only: find JAVA_HOME (babashka needed it too, for the same
# reason -- `bin/build-dist` resolves `bb.edn`'s deps through a JVM), then run
# the driver. Everything the old script did by hand now lives in
# `driver/flint/driver/main.clj` and the namespaces it requires from `src/`.
#
# JVM start-up cost is accepted (the maintainer's decision): measured
# 2026-10-07, `clojure -M -e '(require (quote flint.compiler))'` from a warm
# `.cpcache` is ~16 s wall here (`time -p`, this machine, one run after the
# first); see the commit introducing this file for the before/after a real
# build does with it.
set -e
# ROOT, NOT A `cd`. `flint task`/`flint build` read a "deps.edn" in the
# CURRENT DIRECTORY as the caller's own project -- `test/cli.clj` starts this
# script with its working directory set to a temp project precisely so that
# lookup finds THAT project's tasks, and babashka's own `*file*`-derived
# `root` never touched the process's cwd to get there. A `cd "$(dirname
# "$0")/.."` here would silently run every task against THIS repo's own
# deps.edn instead of the caller's -- found as "no such task: greet" once the
# deps.edn/`-Sdeps` fix below stopped that scenario from failing one step
# earlier, which is what let this one show up at all. `ROOT` is computed in a
# SUBSHELL so it cannot change this shell's own directory as a side effect.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
export FLINT_ROOT="$ROOT"

JDK="${FLINT_JDK:-${JAVA_HOME:-/opt/homebrew/opt/openjdk}}"
if [ ! -x "$JDK/bin/java" ]; then
  # `/usr/bin/java` on macOS is a stub that reports no runtime rather than
  # naming a path -- the same trap AGENTS.md sec. 7 records for `bin/build-dist`.
  echo "no usable JDK at $JDK (set JAVA_HOME or FLINT_JDK)" >&2
  exit 1
fi
PATH="$JDK/bin:$PATH"
export PATH JAVA_HOME="$JDK"

if ! command -v clojure > /dev/null 2>&1; then
  echo "no 'clojure' CLI on PATH -- install the Clojure CLI tools (clojure.org/guides/install_clojure)" >&2
  exit 1
fi

# NO deps.edn FILE AT THE REPO ROOT, DELIBERATELY, AND NOT EVEN `-Sdeps` AT
# INVOCATION TIME -- a classpath STRING (`-Scp`), computed once and cached.
# Two separate collisions, found in that order:
#
# (1) `flint.cli`/`flint.deps` (lib/flint/cli.cljc, lib/flint/deps.cljc) read
#     a "deps.edn" in the CURRENT DIRECTORY as a flint PROJECT's own manifest
#     -- `:paths`/`:deps` are the same keys Clojure's own tool uses, on
#     purpose, for a familiar shape. A tracked root `deps.edn` giving the JVM
#     its classpath is therefore ALSO a flint project manifest declaring
#     Maven dependencies this repo does not otherwise have, and `bin/flint
#     task`/`build`/`deps`, run from the repo root (as several `test/cli.clj`
#     scenarios do), read it as exactly that: `cheshire`/`org.clojure/data.xml`
#     below -- needed only so THIS JVM can load
#     `lib/flint/deps/manifest.cljc`'s `:clj` branch -- turned up as flint
#     dependencies to fetch, one of them pulling in a transitive
#     `com.fasterxml.jackson.core/jackson-databind` with no pinned version,
#     and "flint cannot fetch everything this project reaches" where a clean
#     build was expected.
# (2) `-Sdeps` on the command line (tried first, after (1)) does not avoid
#     this -- it ADDS to the normal deps.edn chain (root, user, PROJECT),
#     rather than replacing it, and `flint task`/`flint build` run with their
#     cwd set to a CALLER's project directory (deliberately -- see `ROOT`
#     above). `clojure` still reads THAT project's own "deps.edn" as ITS
#     project file and tries to build a classpath from it: a `test/cli.clj`
#     fixture deliberately declaring `{:weird/coord "x"}` (to check flint's
#     OWN resolver names it) made `clojure` itself die first, with "Error
#     building classpath. Coord of unknown type", before this driver ever
#     started. `-Scp` takes a classpath already computed, and resolves no
#     deps.edn at all, anywhere, so there is no file left for either `clojure`
#     or `flint.cli` to misread as a project of its own.
#
# The classpath is computed ONCE (`clojure -Spath`, cwd forced to `$ROOT` in
# a subshell so THAT computation cannot hit a caller's bad deps.edn either)
# and cached at `target/flint-driver.cp`, invalidated by comparing the first
# line against `DEPS_EDN` below -- so editing the Maven coordinates here
# recomputes it, and nothing else does.
DEPS_EDN="{:paths [\"$ROOT/src\" \"$ROOT/driver\" \"$ROOT/lib\"]
           :deps {cheshire/cheshire {:mvn/version \"5.13.0\"}
                  org.clojure/data.xml {:mvn/version \"0.2.0-alpha9\"}}}"
CPFILE="$ROOT/target/flint-driver.cp"
mkdir -p "$ROOT/target"
if [ ! -f "$CPFILE" ] || [ "$(head -1 "$CPFILE")" != "$DEPS_EDN" ]; then
  CP=$(cd "$ROOT" && clojure -Sdeps "$DEPS_EDN" -Spath)
  { printf '%s\n' "$DEPS_EDN"; printf '%s\n' "$CP"; } > "$CPFILE"
fi
CP=$(tail -1 "$CPFILE")
#
# STDERR IS FILTERED, not piped straight through (and not `exec`ed, for the
# same reason): loading `flint.rt`, `flint.reader`, `flint.macros` and
# `flint.clr` under PLAIN Clojure prints fifteen `WARNING: x already refers
# to ...` lines -- each one a local `def` shadowing something `clojure.core`
# already refers in, which babashka never warned about and the JVM compiler
# always does. The shadowing is deliberate and unconditional (AGENTS.md sec. 1
# duplication it is not -- these are two-sided ports of ONE name, host and
# guest), so the fix is not in `src/`: EVERY `flint.rt` function that the
# warned-about names shadow is called by the lines right after its own
# `(defn ...)`, so this is cosmetic on every path that matters. A test that
# captures stdout AND stderr together (several `test/cli.clj` scenarios do,
# to check a task's own output is clean) saw fifteen `WARNING:` lines ahead of
# its answer and failed on that noise, not on anything the task did.
#
# `DEPRECATED: Libs must be qualified, change x => x/x (<deps.edn path>)` is
# a SECOND, unrelated noise source on the same stream, from `clojure` itself
# -- a courtesy lint over whatever "deps.edn" sits in the CALLER's working
# directory (`ROOT`'s note says why that is not this repo's), unconditional
# and NOT silenced by `-Scp`: measured directly, invoking `clojure -Scp
# ... -M -e '(println :ok)'` from a directory whose deps.edn declares an
# unqualified npm-fetched lib (`flint task`/`flint build`'s own `:deps
# {portable-cljc {:npm/version ..}}`, a SHAPE `-Scp` otherwise has nothing to
# do with) still printed it. `flint deps`'s own coordinate vocabulary
# (`:npm/version`, `:git/sha`, ...) is not Clojure's, so this fires on
# ordinary flint projects, not on a malformed one.
#
# Buffered rather than streamed: `grep` has to see the whole thing to tell a
# `WARNING:`/`DEPRECATED:` line from a wrapped stack trace line that happens
# to start the same way, and a filter that could emit a real error out of
# order is worse than one that is merely synchronous. `$?` is the DRIVER's
# exit code, not `grep`'s -- captured before the filter runs, and returned
# after it.
set +e
tmperr=$(mktemp "${TMPDIR:-/tmp}/flint-stderr.XXXXXX")
clojure -Scp "$CP" -M -m flint.driver.main "$@" 2>"$tmperr"
status=$?
grep -vE '^(WARNING|DEPRECATED): ' "$tmperr" >&2
rm -f "$tmperr"
exit $status
