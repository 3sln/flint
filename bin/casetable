#!/usr/bin/env bb
;; THE UNICODE CASE TABLE: one shared artifact, three emissions.
;;
;; `upper-case` and `lower-case` used to be THREE DIFFERENT FUNCTIONS. Rust
;; answered `nil` for anything non-ASCII, the JVM used `toUpperCase` under the
;; DEFAULT LOCALE -- so `(upper-case "i")` was "İ" on a machine set to Turkish
;; -- and the CLR used the invariant culture. Three answers, one of them
;; depending on where the program ran.
;;
;; THREE STEPS, AND THE MIDDLE ONE IS THE POINT:
;;
;;   --derive   read the host JDK's Unicode data and write data/casetable.edn
;;   (default)  EMIT the three runtimes' tables FROM that file
;;   --check    compare the three emissions against that file
;;
;; Deriving is separate and deliberate because its answer depends on which
;; Unicode version the JDK carries, and that is a decision to record rather
;; than to inherit from whoever happened to run the gate. `--check` never
;; derives, so it asks the same question on every machine and can live in
;; `bin/test`; `--derive` is run by a person, when the Unicode version is meant
;; to move, and the diff on `data/casetable.edn` is the review.
;;
;; A range is [start end delta stride]. STRIDE is what makes this small: Latin
;; Extended alternates case in pairs, so a naive encoding is one range per code
;; point -- 1352 ranges and 16 KB against 382 and about 4.6 KB. A better
;; encoding beat a compressor and cost no decompressor.
;;
;; A full mapping is [cp n c1 c2 c3]: one code point out to as many as three,
;; which no delta can say. Sharp s to SS is the one everybody meets. Clojure
;; gives these because Java's `String.toUpperCase` does.
(require '[clojure.string :as str] '[clojure.java.io :as io] '[clojure.edn :as edn])

(def shared "data/casetable.edn")

;; ------------------------------------------------------------------ derive

(defn- deltas [f]
  (into (sorted-map)
        (for [cp (range 0x110000)
              :when (Character/isDefined cp)
              :let [m (f cp)] :when (not= m cp)]
          [cp (- m cp)])))

(defn- pack [dm]
  (let [ks (vec (keys dm))]
    (loop [i 0, out []]
      (if (>= i (count ks))
        out
        (let [s (ks i), d (dm s)
              run (fn [stride]
                    (loop [j i]
                      (let [nxt (+ s (* stride (- (inc j) i)))]
                        (if (and (< (inc j) (count ks)) (= (ks (inc j)) nxt) (= (dm nxt) d))
                          (recur (inc j))
                          j))))
              j1 (run 1), j2 (run 2)
              [j st] (if (> (- j2 i) (- j1 i)) [j2 2] [j1 1])]
          (recur (inc j) (conj out [s (ks j) d st])))))))

;; `Locale/ROOT`, EXPLICITLY. `.toUpperCase()` with no locale uses the DEFAULT
;; one, which is the exact defect this table exists to remove: derive on a
;; machine set to Turkish and `i` would map to `İ` for everybody.
(defn- fulls [simple full]
  (vec (for [cp (range 0x110000)
             :when (Character/isDefined cp)
             :let [s (String/valueOf (Character/toChars cp))
                   f (full s)
                   one (String/valueOf (Character/toChars (simple cp)))]
             :when (not= f one)]
         (let [cps (vec (.toArray (.codePoints f)))]
           (into [cp (count cps)] (take 3 (concat cps [0 0 0])))))))

(def ^:private out "kin/casetable.kin")

(defn- records [rs per]
  (str/join "\n              "
            (map #(str/join " " (map (fn [r] (str "[" (str/join " " r) "]")) %))
                 (partition-all per rs))))

(defn- table-form [nm doc key-doc data stride accessors]
  (str "(defdata ^:pub " nm "\n  \"" doc "\"\n"
       "  :data [" (records data 4) "]\n"
       "  :emitter kin.lang/flat-array\n"
       "  :stride " stride "\n"
       "  :accessors {" accessors "})\n"))

;; Pure: computes the file text this host's Unicode data derives, without
;; touching disk. `derive!` and `check!` both call this and differ only in
;; what they do with the answer -- WRITE it, or COMPARE it -- which is the
;; split that was missing: one function did both, unconditionally, under
;; either flag (see `check!`'s comment below for what that cost).
(defn- content []
  (let [t {:upper (pack (deltas #(Character/toUpperCase (int %))))
           :lower (pack (deltas #(Character/toLowerCase (int %))))
           :full-upper (fulls #(Character/toUpperCase (int %))
                              #(.toUpperCase ^String % java.util.Locale/ROOT))
           :full-lower (fulls #(Character/toLowerCase (int %))
                              #(.toLowerCase ^String % java.util.Locale/ROOT))}
        ranges (into (:upper t) (:lower t))
        full (into (:full-upper t) (:full-lower t))]
    {:ranges ranges
     :full full
     :text
     (str ";; GENERATED by `bin/casetable --derive` -- the ARTIFACT OF RECORD.\n"
          ";;\n"
          ";; Unicode simple and full case mapping, and the accessors that read it.\n"
          ";; `upper-case` and `lower-case` were three different functions: Rust\n"
          ";; answered nil for anything non-ASCII, the JVM used the DEFAULT LOCALE --\n"
          ";; `(upper-case \"i\")` was a dotted capital on a Turkish machine -- and the\n"
          ";; CLR the invariant culture.\n"
          ";;\n"
          ";; DERIVED, NOT WRITTEN. Re-derive with `bin/casetable --derive`, which\n"
          ";; reads the host JDK's Unicode data; the DIFF ON THIS FILE is the review.\n"
          ";; That is a separate and deliberate step because its answer depends on\n"
          ";; which Unicode version that JDK carries -- a decision to record, not to\n"
          ";; inherit from whoever ran a gate. Derived with: "
          (System/getProperty "java.version") ".\n"
          ";;\n"
          ";; `Locale/ROOT` explicitly: `.toUpperCase()` with no locale uses the\n"
          ";; default one, which is the exact defect this table exists to remove.\n"
          ";;\n"
          ";; STRIDE keeps it small. Latin Extended alternates case in pairs, so a\n"
          ";; naive encoding is one run per code point -- 1352 runs, 16 KB -- against\n"
          ";; " (count ranges) " and about 4.6 KB. A better encoding beat a compressor and\n"
          ";; cost no decompressor.\n"
          ";;\n"
          ";; ONE TABLE FOR BOTH DIRECTIONS: the uppercase section then the lowercase\n"
          ";; one, with a count of the first. An accessor pair is per-table with no\n"
          ";; selector argument, so two tables would have meant two copies of one\n"
          ";; binary search; a base offset costs an addition and keeps it singular.\n"
          "(ns flint.rt.casetable\n"
          "  (:require [flint.impl.rt :refer [defdata defconst Rt I32 Cmp]]))\n\n"
          (table-form "case-ranges"
                      "Simple case mapping, as [start end delta stride] runs: the uppercase section, then the lowercase one."
                      nil ranges 4
                      "^I32 case-ranges-n  [^Rt rt]\n              ^Cmp case-ranges-at [^Rt rt ^I32 i ^I32 f]")
          "\n"
          ";; WHERE THE LOWERCASE SECTION STARTS, as a constant rather than a\n"
          ";; table: a `defdata` with only a count accessor still emits its whole\n"
          ";; array, which was 800 integers to express one number.\n"
          "(defconst ^:pub ^I32 CASE_UPPER_LEN " (count (:upper t)) ")\n\n"
          (table-form "case-full"
                      "Full mappings, as [cp n c1 c2 c3]: one code point out to as many as three, which no delta can say."
                      nil full 5
                      "^I32 case-full-n  [^Rt rt]\n              ^Cmp case-full-at [^Rt rt ^I32 i ^I32 f]")
          "\n"
          "(defconst ^:pub ^I32 CASE_FULL_UPPER_LEN " (count (:full-upper t)) ")\n")}))

;; The "Derived with: <java.version>." line is INFORMATION ABOUT THE HOST, not
;; part of the table, and must not be compared verbatim: that would fail
;; `--check` on a JDK patch bump even when the Unicode data itself agrees,
;; which is a false alarm this check exists to avoid raising.
(defn- strip-version [s]
  (str/replace s #"(?m)^;; inherit from whoever ran a gate\. Derived with: .*\.$"
               ";; inherit from whoever ran a gate. Derived with: X."))

(defn- derive! []
  (let [{:keys [ranges full text]} (content)]
    (io/make-parents out)
    (spit out text)
    (println (format "  wrote %s -- %d runs, %d full mappings" out (count ranges) (count full)))))

;; NEVER WRITES. That is the whole point of the split above: a host whose
;; embedded Unicode database differs from whoever last ran `--derive` must
;; FAIL here, loudly, rather than silently re-deriving and overwriting the
;; committed, reviewed `kin/casetable.kin` with its own answer -- which is
;; what this script did before this fix, under BOTH `--check` and no flag at
;; all: `(case (first *command-line-args*) "--derive" (derive!) (derive!))`
;; called the SAME writing function regardless, so `--check` differed from
;; `--derive` in name only.
;;
;; Measured 2026-10-06: CI's babashka (v1.13.225, embedded java.version
;; 25.0.4, reproduced in a linux/amd64 container) derives 392 case-range runs
;; where this tree's committed file (local babashka v1.3.190, java.version 22)
;; has 382 -- a real Unicode-version difference, not noise -- and the old
;; `--check` was overwriting `kin/casetable.kin` with the larger table in
;; place, moments before `bin/check-kin` compiled `kin/casemap.kin` against
;; it. `casemap.kin` inlines `case-ranges-n` as a literal at kin-generation
;; time, so its generated code started indexing up to the NEW run count while
;; `kin/casemap.drivers`'s own fixture still stubs a FIXED `[i32; 1528]` array
;; sized for the old one -- `index out of bounds: the len is 1528 but the
;; index is 1540`, reproduced exactly, on Linux only, because only Linux CI
;; installs a fresh `bb`.
(defn- check! []
  (let [want (strip-version (:text (content)))
        have (if (.exists (io/file out)) (strip-version (slurp out)) "")]
    (if (= want have)
      (println (format "  ok   %s matches what this host's Unicode data derives" out))
      (do
        (println (format "check-casetable: %s does not match what this host derives." out))
        (println "  This host's embedded Unicode database disagrees with whoever last ran")
        (println "  `bin/casetable --derive` and committed the result -- re-run `--derive`")
        (println "  by hand, review the diff, and commit it; or pin babashka so every host")
        (println "  agrees. `--check` never writes, so the committed file is untouched.")
        (System/exit 1)))))

(case (first *command-line-args*)
  "--derive" (derive!)
  "--check" (check!)
  (derive!))
