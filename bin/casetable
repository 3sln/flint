#!/usr/bin/env bb
;; THE UNICODE CASE TABLE: one shared artifact, three emissions.
;;
;; `upper-case` and `lower-case` used to be THREE DIFFERENT FUNCTIONS. Rust
;; answered `nil` for anything non-ASCII, the JVM used `toUpperCase` under the
;; DEFAULT LOCALE -- so `(upper-case "i")` was "İ" on a machine set to Turkish
;; -- and the CLR used the invariant culture. Three answers, one of them
;; depending on where the program ran.
;;
;; PINNED TO ONE UNICODE VERSION, COMMITTED, NOT THE HOST'S. This used to read
;; the HOST JVM's bundled Unicode tables (`Character/toUpperCase` et al.),
;; which is the same defect one level up: the answer depended on where the
;; DERIVATION ran rather than on where the program ran. CI's babashka (fresh
;; `bb: latest`, embedded java.version 25.0.4) derived a case-ranges table 10
;; runs larger than this tree's committed one (local babashka, java.version
;; 22) -- a real Unicode-version difference, not noise -- and `kin/casemap.kin`
;; inlines the table's length as a literal at kin-generation time, so the
;; mismatch showed up as `index out of bounds: the len is 1528 but the index
;; is 1540` in a compiled probe, nowhere near the actual cause. See the kin
;; AGENTS.md's §3 for the measurement.
;;
;; So the source of truth is now three files UNDER THIS REPO'S OWN VERSION
;; CONTROL -- `data/unicode/<version>/{UnicodeData,CaseFolding,SpecialCasing}.txt`,
;; fetched from unicode.org and never regenerated by a host -- and `--derive`
;; parses THOSE, not `java.lang.Character`. `CaseFolding.txt` is fetched and
;; committed alongside the other two for when something here needs case-FOLD
;; (not case-MAP) semantics; nothing reads it yet.
;;
;; See `DECISIONS.md#unicode-pin` for the full record of why and how.
;;
;; PINNED VERSION: 18.0.0, the latest published Unicode Standard as of this
;; writing (released 2026-09-16) -- chosen because nothing ELSE in this
;; codebase constrains the choice. The regex engine's `\w`/`\d`/`\s`
;; (`lib/stdextra/flint/regex.fln`) are hand-coded ASCII ranges, not Unicode property
;; classes, and `(?i)` / locale-aware matching is not supported at all
;; (`lib/stdextra/flint/regex.fln`'s own doc: "no lookaround, flags or named groups"),
;; so there is no existing Unicode-version assumption elsewhere to match --
;; latest was the only candidate. Fetched from:
;;   https://www.unicode.org/Public/18.0.0/ucd/UnicodeData.txt
;;   https://www.unicode.org/Public/18.0.0/ucd/CaseFolding.txt
;;   https://www.unicode.org/Public/18.0.0/ucd/SpecialCasing.txt
;;
;; Bumping the version is still a PERSON'S decision, same as before: fetch the
;; new files to a new `data/unicode/<version>/`, point `ucd-version` below at
;; it, run `--derive`, and the diff on `kin/casetable.kin` is the review.
;; `--check` never fetches and never derives from a live host, so (unlike the
;; thing it replaces) it now asks the SAME question and gets the SAME answer
;; on every machine, forever -- not just until someone's JDK changes.
;;
;; THREE STEPS, AND THE MIDDLE ONE IS THE POINT:
;;
;;   --derive   parse the pinned UCD files and write kin/casetable.kin
;;   (default)  same as --derive
;;   --check    parse the pinned UCD files and compare, writing nothing
;;
;; A range is [start end delta stride]. STRIDE is what makes this small: Latin
;; Extended alternates case in pairs, so a naive encoding is one range per code
;; point -- 1352 ranges and 16 KB against 382 and about 4.6 KB. A better
;; encoding beat a compressor and cost no decompressor.
;;
;; A full mapping is [cp n c1 c2 c3]: one code point out to as many as three,
;; which no delta can say. Sharp s to SS is the one everybody meets.
(require '[clojure.string :as str] '[clojure.java.io :as io])

;; ------------------------------------------------------------------- pinned

(def ^:private ucd-version "18.0.0")
(def ^:private ucd-dir (str "data/unicode/" ucd-version))

(defn- parse-hex [s] (Long/parseLong (str/trim s) 16))

;; `UnicodeData.txt`: one line per code point (or, for large unassigned-block
;; ranges like the CJK ideographs, a `<..., First>`/`<..., Last>` pair) --
;; semicolon-separated, field 12 the simple uppercase mapping, field 13 the
;; simple lowercase mapping, both hex and EMPTY when the character maps to
;; itself. A `<..., First/Last>` range never carries a case mapping (ideograph
;; and private-use blocks have none), so it is safe to read every line as one
;; code point and never expand a range -- there is nothing case-related to
;; expand.
;;
;; Returns {cp {:upper N :lower N}} for code points that HAVE a simple
;; mapping. A code point absent from this map maps to itself -- exactly what
;; `Character/isDefined` plus `Character/toUpperCase` answered for everything
;; this used to scan, so no separate "is this code point assigned" concept is
;; needed: this reads directly off what the file says changes.
(defn- load-unicode-data []
  (with-open [r (io/reader (str ucd-dir "/UnicodeData.txt"))]
    (reduce
      (fn [m line]
        (if (str/blank? line)
          m
          (let [f (str/split line #";")
                cp (parse-hex (nth f 0))
                up (nth f 12 "")
                lo (nth f 13 "")]
            (cond-> m
              (seq (str/trim up)) (assoc-in [cp :upper] (parse-hex up))
              (seq (str/trim lo)) (assoc-in [cp :lower] (parse-hex lo))))))
      {} (line-seq r))))

;; `SpecialCasing.txt`: `cp; lower; title; upper; [condition;] # comment`.
;; UNCONDITIONAL lines only -- a 5th field is a locale or context condition
;; (`tr`, `lt`, `Final_Sigma`, ...), which this table must not apply: it is
;; what `.toUpperCase(Locale/ROOT)` meant before, and pinning the data does
;; not change that choice. Splitting off the `#` comment first and keeping
;; only lines with exactly four remaining fields is what tells a four-field
;; unconditional line from a five-field conditional one.
;;
;; Returns a SORTED map (ascending by code point, matching derivation order)
;; {cp {:upper [cps] :lower [cps]}}, each a list of one to three code points.
(defn- load-special-casing []
  (with-open [r (io/reader (str ucd-dir "/SpecialCasing.txt"))]
    (reduce
      (fn [m line]
        (if (str/blank? line)
          m
          ;; Trimmed, NOT blank-filtered: a `lower`/`title`/`upper` field is
          ;; legitimately empty when that mapping does not change the
          ;; character, and `remove str/blank?` on the whole split once
          ;; collapsed such a line's position count down to 4 -- indistin-
          ;; guishable from an unconditional line -- and fed the condition
          ;; text (`"tr After_I"`) to `parse-hex` as if it were the upper
          ;; mapping. Only the ONE trailing blank part that `; ` before the
          ;; comment always leaves is dropped, by position, not by content.
          (let [body (or (first (str/split line #"#")) "")
                raw (mapv str/trim (str/split body #";"))
                fields (if (and (seq raw) (str/blank? (peek raw))) (pop raw) raw)]
            (if (not= 4 (count fields))
              m
              (let [[cp lo _title up] fields]
                (assoc m (parse-hex cp)
                       {:lower (if (str/blank? lo) [(parse-hex cp)] (mapv parse-hex (str/split lo #"\s+")))
                        :upper (if (str/blank? up) [(parse-hex cp)] (mapv parse-hex (str/split up #"\s+")))}))))))
      (sorted-map) (line-seq r))))

;; ------------------------------------------------------------------ derive

;; `ucd` is `load-unicode-data`'s map, `k` is `:upper` or `:lower`. A SORTED
;; map, ascending by code point -- `pack` below assumes runs are offered in
;; that order.
(defn- deltas [ucd k]
  (into (sorted-map)
        (for [[cp v] ucd
              :let [m (get v k)]
              :when (and m (not= m cp))]
          [cp (- m cp)])))

(defn- pack [dm]
  (let [ks (vec (keys dm))]
    (loop [i 0, out []]
      (if (>= i (count ks))
        out
        (let [s (ks i), d (dm s)
              run (fn [stride]
                    (loop [j i]
                      (let [nxt (+ s (* stride (- (inc j) i)))]
                        (if (and (< (inc j) (count ks)) (= (ks (inc j)) nxt) (= (dm nxt) d))
                          (recur (inc j))
                          j))))
              j1 (run 1), j2 (run 2)
              [j st] (if (> (- j2 i) (- j1 i)) [j2 2] [j1 1])]
          (recur (inc j) (conj out [s (ks j) d st])))))))

;; `ucd` and `special` are `load-unicode-data` and `load-special-casing`'s
;; maps, `k` is `:upper` or `:lower`. For each code point `special` carries a
;; full mapping for, compares it against the SIMPLE mapping (from `ucd`, or
;; the code point itself if `ucd` has none) and keeps the ones that differ --
;; which is every entry `SpecialCasing.txt` has, in practice (its whole
;; purpose is to record where the full and simple mappings diverge), but the
;; comparison stays explicit rather than assumed.
(defn- fulls [ucd special k]
  (vec (for [[cp v] special
             :let [full (get v k)
                   simple [(get-in ucd [cp k] cp)]]
             :when (not= full simple)]
         (into [cp (count full)] (take 3 (concat full [0 0 0]))))))

(def ^:private out "kin/casetable.kin")

(defn- records [rs per]
  (str/join "\n              "
            (map #(str/join " " (map (fn [r] (str "[" (str/join " " r) "]")) %))
                 (partition-all per rs))))

(defn- table-form [nm doc key-doc data stride accessors]
  (str "(defdata ^:pub " nm "\n  \"" doc "\"\n"
       "  :data [" (records data 4) "]\n"
       "  :emitter kin.lang/flat-array\n"
       "  :stride " stride "\n"
       "  :accessors {" accessors "})\n"))

;; Pure: computes the file text the PINNED Unicode data derives, without
;; touching disk. `derive!` and `check!` both call this and differ only in
;; what they do with the answer -- WRITE it, or COMPARE it. Depends on
;; nothing but `data/unicode/<ucd-version>/*.txt`, so (unlike before) this
;; answers the same way on every host, every time, until that pinned version
;; is deliberately moved.
(defn- content []
  (let [ucd (load-unicode-data)
        special (load-special-casing)
        t {:upper (pack (deltas ucd :upper))
           :lower (pack (deltas ucd :lower))
           :full-upper (fulls ucd special :upper)
           :full-lower (fulls ucd special :lower)}
        ranges (into (:upper t) (:lower t))
        full (into (:full-upper t) (:full-lower t))]
    {:ranges ranges
     :full full
     :text
     (str ";; GENERATED by `bin/casetable --derive` -- the ARTIFACT OF RECORD.\n"
          ";;\n"
          ";; Unicode simple and full case mapping, and the accessors that read it.\n"
          ";; `upper-case` and `lower-case` were three different functions: Rust\n"
          ";; answered nil for anything non-ASCII, the JVM used the DEFAULT LOCALE --\n"
          ";; `(upper-case \"i\")` was a dotted capital on a Turkish machine -- and the\n"
          ";; CLR the invariant culture.\n"
          ";;\n"
          ";; DERIVED, NOT WRITTEN. Re-derive with `bin/casetable --derive`, which\n"
          ";; parses data/unicode/" ucd-version "/*.txt -- committed files, not a live\n"
          ";; host's Unicode database -- so the DIFF ON THIS FILE is the review, and it\n"
          ";; is the same diff on every machine. Derived from Unicode " ucd-version ".\n"
          ";;\n"
          ";; UNCONDITIONAL mappings only, from SpecialCasing.txt: a locale- or\n"
          ";; context-dependent entry (`tr`, `lt`, `Final_Sigma`, ...) is excluded, which\n"
          ";; is what `.toUpperCase(Locale/ROOT)` meant under the old, host-derived\n"
          ";; version of this table and still means under the pinned one.\n"
          ";;\n"
          ";; STRIDE keeps it small. Latin Extended alternates case in pairs, so a\n"
          ";; naive encoding is one run per code point -- 1352 runs, 16 KB -- against\n"
          ";; " (count ranges) " and about 4.6 KB. A better encoding beat a compressor and\n"
          ";; cost no decompressor.\n"
          ";;\n"
          ";; ONE TABLE FOR BOTH DIRECTIONS: the uppercase section then the lowercase\n"
          ";; one, with a count of the first. An accessor pair is per-table with no\n"
          ";; selector argument, so two tables would have meant two copies of one\n"
          ";; binary search; a base offset costs an addition and keeps it singular.\n"
          "(ns flint.rt.casetable\n"
          "  (:require [flint.impl.rt :refer [defdata defconst Rt I32 Cmp]]))\n\n"
          (table-form "case-ranges"
                      "Simple case mapping, as [start end delta stride] runs: the uppercase section, then the lowercase one."
                      nil ranges 4
                      "^I32 case-ranges-n  [^Rt rt]\n              ^Cmp case-ranges-at [^Rt rt ^I32 i ^I32 f]")
          "\n"
          ";; WHERE THE LOWERCASE SECTION STARTS, as a constant rather than a\n"
          ";; table: a `defdata` with only a count accessor still emits its whole\n"
          ";; array, which was 800 integers to express one number.\n"
          "(defconst ^:pub ^I32 CASE_UPPER_LEN " (count (:upper t)) ")\n\n"
          (table-form "case-full"
                      "Full mappings, as [cp n c1 c2 c3]: one code point out to as many as three, which no delta can say."
                      nil full 5
                      "^I32 case-full-n  [^Rt rt]\n              ^Cmp case-full-at [^Rt rt ^I32 i ^I32 f]")
          "\n"
          "(defconst ^:pub ^I32 CASE_FULL_UPPER_LEN " (count (:full-upper t)) ")\n")}))

(defn- derive! []
  (let [{:keys [ranges full text]} (content)]
    (io/make-parents out)
    (spit out text)
    (println (format "  wrote %s -- %d runs, %d full mappings (Unicode %s)"
                      out (count ranges) (count full) ucd-version))))

;; NEVER WRITES. A mismatch here now means the committed `kin/casetable.kin`
;; was hand-edited, or someone bumped `ucd-version` or the files under
;; `data/unicode/` without re-running `--derive` -- never a live host's
;; Unicode database disagreeing, because nothing here reads one any more.
;;
;; Compared BYTE FOR BYTE, with no stripping: there is no host-dependent line
;; left in the generated text (the old "Derived with: <java.version>." is now
;; "Derived from Unicode 18.0.0.", which is a property of the PINNED files,
;; not of whatever ran this), so an exact comparison is the right one and a
;; fuzzy one would hide a real drift.
(defn- check! []
  (let [want (:text (content))
        have (if (.exists (io/file out)) (slurp out) "")]
    (if (= want have)
      (println (format "  ok   %s matches Unicode %s (data/unicode/%s)" out ucd-version ucd-version))
      (do
        (println (format "check-casetable: %s does not match data/unicode/%s." out ucd-version))
        (println "  Either it was hand-edited, or `ucd-version` / the files under")
        (println "  data/unicode/ moved without re-running `bin/casetable --derive`.")
        (println "  Re-run `--derive`, review the diff, and commit it. `--check` never")
        (println "  writes, so the committed file is untouched.")
        (System/exit 1)))))

(case (first *command-line-args*)
  "--derive" (derive!)
  "--check" (check!)
  (derive!))
