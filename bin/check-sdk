#!/bin/sh
# THE JVM AND CLR SDKs, END TO END: source -> spec -> artifact -> loaded type, on
# each runtime, with no file written for the artifact.
#
# `com.flint.Compiler` and `com.flint.Image` are the JVM's mirrors of the ESM
# SDK's `Compiler` and `Image` (`doc/ports.md`). This is what asserts they work,
# and it exists because `bin/dead-runtime-fns` found `compileJvm` with no caller
# at all -- a published method nothing exercised, which is an untested claim
# rather than dead code.
#
# WHAT IT PINS, and each row earns its place:
#
#   * the compiler RUNS on the JVM runtime over a resolved spec. Until 2026-09-26
#     `build-image` re-resolved every spec, so an `--emit-spec` spec answered
#     `!missing` on every artifact target while working in mode `spec`;
#   * the artifact is BYTE FOR BYTE what the native CLI writes for the same spec.
#     Two compilers -- one running as wasm, one on this runtime -- have to agree
#     about what a program compiles to, and "it compiled" does not check that;
#   * the class is defined IN MEMORY. No `:out`, no classpath, no filename.
#
# About 20 s -- it now rebuilds its own `runtimes/jvm/classes` prerequisite,
# ~8 s of the total -- and it needs a JDK. It skips itself without one rather
# than failing, the way the rest of the jvm checks do.
set -e
cd "$(dirname "$0")/.."
fail() { echo "FAILED: $1"; exit 1; }

JDK="${FLINT_JDK:-${JAVA_HOME:-/opt/homebrew/opt/openjdk}}"
if [ ! -x "$JDK/bin/java" ]; then
  echo "  --   check-jvm-sdk: no JDK at $JDK; skipping (set FLINT_JDK or JAVA_HOME)"
  exit 0
fi
[ -f dist/flintc.bytecode ] || fail "no dist/flintc.bytecode -- run bin/build-dist"
[ -x target/release/flint ] || {
  echo "  --   check-jvm-sdk: no target/release/flint; skipping"
  exit 0
}

# `runtimes/jvm/classes` IS THIS CHECK'S OWN PREREQUISITE, not something it
# assumes another step already left behind. It used to -- and on a fresh CI
# checkout, where `bin/test` runs `bin/check` long before `bin/check-ports` or
# `bin/conform-hosts` ever compile the port, that assumption failed with a bare
# "javac RtCompiler" naming neither the missing directory nor the fix. Locally
# it read as "run bin/check-ports first", which only an agent who had already
# hit this once knew to do.
#
# So it is rebuilt here, every time, the same way `bin/check-ports` and
# `bin/conform-hosts` do it (stale classes removed first: a compile that fails
# must not leave a runnable tree behind). The three scripts each inline this
# javac invocation rather than sharing it -- pre-existing duplication this fix
# does not clean up, since the three callers want different things alongside
# it (check-ports also compiles `test/*.java`, conform-hosts also detects a
# too-old JDK). ~8 s on this machine.
rm -rf runtimes/jvm/classes
"$JDK/bin/javac" -d runtimes/jvm/classes \
  runtimes/jvm/src/com/flint/*.java runtimes/jvm/src/com/flint/rt/*.java runtimes/jvm/src/com/_3sln/flint/kgen/rt/*.java \
  > /tmp/flint-sdk-jvm-build.out 2>&1 \
  || { cat /tmp/flint-sdk-jvm-build.out; fail "javac runtimes/jvm/src (building check-sdk's own runtimes/jvm/classes prerequisite)"; }

W=$(mktemp -d)
trap 'rm -rf "$W"' EXIT
mkdir -p "$W/src" "$W/out" "$W/classes"
cat > "$W/src/p.cljc" <<'EOF'
(ns p)
(defn main [_] "sdk")
EOF

# THROUGH THE COMMITTED TOOLS, not inline: a hand-configured one-off encodes
# decisions the real path lacks.
./bin/flint :src "$W/src" :fn p/main --emit-spec :out "$W/p.spec" > /dev/null 2>&1 \
  || fail "bin/flint --emit-spec"
# THE REFERENCE IS THE WASM COMPILER ON THE SAME SPEC, not the native CLI on the
# same SOURCES. The CLI builds its own spec, so comparing against its artifact
# compares two inputs: it reported 38 777 bytes against 38 777, same length and
# different bytes, which reads exactly like a port divergence and was not one.
node host/flint-argv.mjs dist/flintc.wasm "$W/p.spec" jvm "" "" > "$W/ref.b64" 2>&1 \
  || fail "the wasm compiler could not compile the reference artifact"
case "$(head -c 6 "$W/ref.b64")" in
  yv66vg) ;;
  *) fail "the wasm compiler did not answer with a class file: $(head -c 120 "$W/ref.b64")" ;;
esac
# base64 -d is `-D` on macOS and `-d` elsewhere; try both rather than assume.
base64 -d < "$W/ref.b64" > "$W/ref.class" 2>/dev/null \
  || base64 -D < "$W/ref.b64" > "$W/ref.class"

"$JDK/bin/javac" -cp runtimes/jvm/classes -d "$W/classes" \
  runtimes/jvm/test/RtCompiler.java > /dev/null 2>&1 || fail "javac RtCompiler"

"$JDK/bin/java" -Xss1g -cp "runtimes/jvm/classes:$W/classes" RtCompiler \
  dist/flintc.bytecode "$W/p.spec" "$W/ref.class" \
  || fail "RtCompiler"

# --- THE NATIVE CLI'S CLASS, LOADED. The `:to :clr` bug fixed on 2026-09-28 was a
# length confusion no magic-byte check could see: the COR20 header's metadata RVA
# was computed without the bytecode's size, and the only reason it shipped is that
# nothing LOADED the native door's artifact. `:to :jvm` had the same hole --
# `test/selfhost-targets.clj` checks CAFEBABE and the bytecode's presence, and
# `bin/check-four-ops` builds with `bin/flint` -- and the jvm path has had exactly
# this class of bug once already, an 894-byte class that loaded and threw at boot.
#
# SO THIS BOOTS IT, and `javap` is NOT enough -- that was tried and it passed with
# the bug injected. The recorded shape is exact: "a class that loads, reports its
# metadata correctly and throws at boot". `javap` reads the method table, which
# survives; the bytecode is what goes missing. Only running the program looks at
# the part that was empty.
./target/release/flint compile :path "$W/src" :fn p/main :to :jvm :out "$W/cp" \
  > /dev/null 2>&1 || fail "the native CLI's \`:to :jvm\` did not emit"
if ! "$JDK/bin/java" -cp "runtimes/jvm/classes:$W/cp" com.flint.Main p/main x \
     > "$W/jvm-run.out" 2>&1; then
  head -8 "$W/jvm-run.out"
  fail "the native CLI's class did not run through com.flint.Main"
fi
grep -q 'sdk' "$W/jvm-run.out" || {
  head -8 "$W/jvm-run.out"
  fail "the native CLI's class ran and did not answer the program's value"
}
echo "  ok   the native CLI's class boots and answers the program's value"

# --- THE CLR ARM. `Flint.Rt.Compiler` and `Flint.Rt.Image` are the same pair, and
# it asserts the same thing: a resolved spec compiles to an assembly that LOADS,
# in memory.
#
# It asserted a REFUSAL until 2026-09-28, because a resolved spec produced an
# assembly .NET would not load and the restriction was recorded as this target's.
# It was not: `compile-to-clr` handed `clr/assemble` the VECTOR `img/emit` answers
# where it measures a byte string with `b-count`, so the COR20 header's metadata
# RVA was computed without the bytecode's size and pointed 26 719 bytes early, into
# the embedded image. EVERY spec hit it, the CLI's own included -- which is why
# refusing resolved specs fixed nothing and `vec->b` did.
CLR=runtimes/clr/conform/bin/Release/net10.0/Conform
if [ -x "$CLR" ] && command -v dotnet > /dev/null 2>&1; then
  # TWO DIFFERENT PROGRAMS, for the load-identity row inside `--rt-sdk`. It pins a
  # fact that contradicts `clr-name`'s docstring: `Assembly.Load(byte[])` gives each
  # byte array its own identity, so two artifacts BOTH named `Program` -- which is
  # what the native CLI emits -- still load as themselves.
  mkdir -p "$W/a" "$W/b"
  printf '(ns pa)\n(defn main [_] "AAA")\n' > "$W/a/pa.cljc"
  printf '(ns pb)\n(defn main [_] "BBB")\n' > "$W/b/pb.cljc"
  ./target/release/flint compile :path "$W/a" :fn pa/main :to :clr \
    :out "$W/ref.class.alpha" > /dev/null 2>&1 || fail "the clr alpha artifact"
  ./target/release/flint compile :path "$W/b" :fn pb/main :to :clr \
    :out "$W/ref.class.beta" > /dev/null 2>&1 || fail "the clr beta artifact"
  DOTNET_ROOT="${DOTNET_ROOT:-/opt/homebrew/opt/dotnet/libexec}" \
    "$CLR" --rt-sdk "$W/p.spec" "$W/ref.class" || fail "Conform --rt-sdk"
else
  echo "  --   check-sdk: no CLR conform binary or no dotnet; the clr arm is skipped"
fi
