#!/usr/bin/env bb
;; Does `dist/` describe the builtins this source tree actually has?
;;
;; This exists because three separate debugging sessions were lost to it. Adding
;; a builtin and rebuilding only SOME of `units/`, `dist/` and the CLI produces
;; artifacts that disagree about which slot a builtin lives in -- and the
;; symptom is not a message, it is a SEGFAULT in an unrelated program, sensitive
;; to a five-byte change in that program's source.
;;
;; Every wrong explanation I reached for -- a shifted slot, a shadowed special
;; form, a value held across an allocation -- was a reading of the source. This
;; is the check that would have answered it in one line instead.
(require '[clojure.string :as str] '[babashka.fs :as fs] '[cheshire.core :as json])

(def catalogue
  "Builtin names, from the one place they are declared."
  (->> (slurp "runtime/src/builtins.rs")
       (re-seq #"(?m)^    \"([^\"]+)\", flint_b_")
       (map second)
       set))

(defn check [path]
  (if-not (fs/exists? path)
    (do (println (str "  " path " is missing; run bin/build-dist")) false)
    (let [slots (set (keys (json/parse-string (slurp path))))
          missing (sort (remove slots catalogue))]
      (if (seq missing)
        (do (println (str "  " path " does not know: " (str/join ", " (take 8 missing))
                          (when (> (count missing) 8) (str " (+" (- (count missing) 8) " more)"))))
            false)
        (do (println (str "  ok   " path " covers all " (count catalogue) " builtins")) true)))))

;; WHICH SOURCES THE EMBEDDED COMPILER WAS BUILT FROM. The slot check above
;; cannot see a stale COMPILER: `dist/flintc.bytecode` built from an older
;; `src/` carries the same slot table and passes it. Measured 2026-10-01 at
;; `246ac6c1`: a gate run whose first CLI build embedded a `dist/` that predated
;; the `split` entry went red in four suites -- `:to :clr`/`:to :jvm` writing
;; nothing, `run` answering "", "unable to resolve symbol: nth" -- every one of
;; them reading as a defect in the change, and all of them went green when the
;; same gate rebuilt `dist/` halfway through. Swapping a pre-`split`
;; `flintc.bytecode` into a fresh tree reproduces all four exactly.
;;
;; So `bin/build-dist` stamps the digest of `src/` and `lib/` it compiled, and
;; this compares it with the tree. ONE DIGEST FUNCTION, here; `build-dist`
;; calls `--digest` rather than restating it. Every file under both roots counts,
;; tracked or not, because the build reads the directory and not git.
(def stamp
  "Overridable so `test/check-dist.clj` can hand it a wrong stamp without
  touching `dist/`."
  (or (System/getenv "FLINT_DIST_STAMP") "dist/flintc.sources"))

(defn digest []
  (let [md (java.security.MessageDigest/getInstance "SHA-256")
        files (->> ["src" "lib"]
                   (mapcat #(fs/glob % "**"))
                   (filter fs/regular-file?)
                   (map str)
                   sort)]
    (doseq [f files]
      (.update md (.getBytes (str f "\u0000") "UTF-8"))
      (.update md (fs/read-all-bytes f))
      (.update md (byte-array [0])))
    (apply str (map #(format "%02x" (bit-and % 0xff)) (.digest md)))))

(when (= "--digest" (first *command-line-args*))
  (println (digest))
  (System/exit 0))

(defn check-sources []
  (let [want (digest)
        have (when (fs/exists? stamp) (str/trim (slurp stamp)))]
    (cond
      (nil? have)
      (do (println (str "  " stamp " is missing; run bin/build-dist")) false)
      (not= have want)
      (do (println (str "  dist/flintc.bytecode was built from a different src/ and lib/"))
          (println (str "    stamped " (subs have 0 (min 16 (count have)))
                        ", tree " (subs want 0 16)))
          false)
      :else
      (do (println "  ok   dist/flintc.bytecode was built from this src/ and lib/") true))))

(println "dist: built from this source tree?")
(let [ok (doall (map check ["dist/slots.json" "dist/slots-aot.json"]))
      src-ok (check-sources)]
  (when-not (every? true? ok)
    (println "\n  dist/ is STALE against runtime/src/builtins.rs.")
    (println "  Rebuild it with `bin/build-dist`. A stale slot table does not")
    (println "  fail here -- it segfaults somewhere else, later."))
  (when-not src-ok
    (println "\n  dist/ is STALE against src/ or lib/. Rebuild in the order AGENTS.md")
    (println "  gives: `bin/build-dist`, then `cargo build --release -p flint-cli`."))
  (when-not (and (every? true? ok) src-ok)
    (System/exit 1)))
