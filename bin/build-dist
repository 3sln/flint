#!/bin/sh
# Build the wasm distributable: the compiler, the loader, and the manifest that
# ties them together.
#
# What ships is TWO artifacts and a list.
#
#   flintc.wasm        the compiler, compiled by itself. Source in, a bytecode
#                      IMAGE out. Needs no babashka, no JVM, no Rust, no linker.
#   flint-loader.wasm  the runtime. Any image loads into it and runs.
#   builtins.json      every builtin that loader carries, which the compiler
#                      needs in order to tell `flint.rt/add` from a typo.
#
# What does NOT ship is a way to produce a standalone single-file `.wasm`
# module. That is LINKING, and linking relocatable wasm objects is `wasm-ld`, a
# native tool. `bin/flint` does it; this cannot, and `--aot` is downstream of
# it, so AOT is not available from the distributable either. See the README.
set -e

# `cmd | sed` reports SED's status, and sed always succeeds. Every indented
# step below was therefore invisible to `set -e`: a compile error printed its
# stack trace, this script exited 0, and `dist/` kept the artifacts from the
# PREVIOUS build looking current. That is the same class of lie `bin/check-dist`
# exists to catch, one step earlier.
#
# `indent` runs the command and indents its output without a pipeline, so the
# command's own status is what survives.
indent() {
  out=$("$@" 2>&1) && st=0 || st=$?
  printf '%s\n' "$out" | sed 's/^/    /'
  return $st
}
cd "$(dirname "$0")/.."
mkdir -p dist/src

# THE SOURCES THE COMPILER IS BUILT FROM, digested BEFORE it is built so an edit
# landing mid-build is not stamped as included. `bin/check-dist` compares it
# with the tree: a `flintc.bytecode` from an older `src/` passes every slot
# check and presents as the change under test being broken (`bin/check-dist`
# says what that cost).
#
# The stamp is written to a TEMP file and moved over the real one only at the
# very end, after both compiler artefacts have themselves been frozen (see
# `freshen` below) -- never removed up front. A build that dies before that
# final move leaves the OLD stamp in place, which is still the right answer: if
# `src/`/`lib/` changed, the old digest now disagrees with the tree and
# `bin/check-dist` correctly reports stale; if they did not change, nothing
# needed to change and the old stamp was already correct.
sources_digest=$(./bin/check-dist --digest)

# Move TMP over FINAL only when the bytes differ, so an artefact that comes out
# byte-identical to what is already there keeps its OLD mtime rather than a
# fresh one. `bin/check` fails when `target/release/flint` is older than
# `dist/flintc.bytecode` -- and the documented rebuild order
# (`bin/build-dist`, `cargo build`, `sdks/cli/build`) runs `bin/build-dist`
# *again* inside `sdks/cli/build` (it reruns it unconditionally unless
# `FLINT_DIST_FRESH=1`, and so does `bin/test`), which recompiles an UNCHANGED
# compiler and used to restamp it with a newer mtime than the cargo build that
# just ran before it. The check then reads a real freshness check as a false
# positive on a pipeline that is actually fresh. `cmp -s` is the only thing
# that tells "rebuilt" apart from "rewritten".
freshen() {
  tmp="$1"; final="$2"
  if [ -f "$final" ] && cmp -s "$tmp" "$final"; then
    rm -f "$tmp"
  else
    mv -f "$tmp" "$final"
  fi
}

echo "==> production units"
./bin/build-units > /dev/null

echo "==> builtins.json"
bb -e '
(require (quote [babashka.classpath :as cp])) (cp/add-classpath "src")
(require (quote [flint.link :as link]) (quote [clojure.string :as str]))
(let [units (link/discover-units ["units"])
      names (sort (into #{} (mapcat (fn [e] (keys (:provides (val e)))) units)))]
  (spit "dist/builtins.json"
        (str "[\n" (str/join ",\n" (map (fn [n] (str "  \"" n "\"")) names)) "\n]\n"))
  (println "   " (count names) "builtins"))'

echo "==> the runtime module, and the slot map that points an image at it"
# A loader built from one program carries only the builtins that program
# reached -- `--gc-sections` deletes the rest, which is the whole modularity
# story and exactly wrong for a distributable. So generate a source that names
# every one of them, as VALUES rather than calls, which pins them without
# needing to know any arities.
#
# AND IT NAMES GUARDED ONES. `flint.rt/request` carries `workspace-capabilities`'s `[:host]`
# guard, because `flint.host/request` -- the var it stands behind -- does, and
# a guard on a wrapper that a caller can step around by naming the builtin is
# no guard. `bin/flint` makes `dist/src` a WORKSPACE (a root's name defaults to
# its path), so the loader is a workspace like any other and is asked what it
# holds.
#
# It holds everything, and saying so is the honest answer rather than a way
# round the check. This module IS the runtime: every builtin the distributable
# carries is in it by construction. A `deps.edn` beside the generated source
# declares that, which is the same sentence any other workspace writes and is
# auditable in the same place.
node -e '
const fs = require("fs");
const names = JSON.parse(fs.readFileSync("dist/builtins.json", "utf8"));
fs.writeFileSync("dist/src/deps.edn",
  "{;; The loader names every builtin in the distributable, so it holds every\n" +
  " ;; capability any of them is guarded with (DECISIONS.md#workspace-capabilities). Generated\n" +
  " ;; by bin/build-dist; do not edit.\n" +
  " :flint/capabilities-grant [:host]}\n");
// EVERY BUILTIN BUT `var-named`, which no source may name
// (DECISIONS.md#the-control-plane-is-the-runtimes): the compiler refuses it
// outside the call loop it injects, and that loop is in this image as in every
// other, so the linker keeps it without being asked.
const refs = names.filter((n) => n !== "flint/var-named")
  .map((n) => "flint.rt/" + (n.startsWith("flint/") ? n.slice(6) : n));
fs.writeFileSync("dist/src/loader.cljc", `(ns loader
  "Every builtin, named as a value so the linker keeps it. Generated by
  bin/build-dist from dist/builtins.json; do not edit. ${names.length} builtins."
  (:require [flint.rt]))

(def ^:private all
  [${refs.join("\n   ")}])

(defn main [args]
  ;; Never called: a loader is entered through flint_load_image, which replaces
  ;; this image entirely. It exists so the module has an entry point.
  (str (count all)))
`);'
# `VAR=x fn` in front of a shell FUNCTION does not reliably reach the commands
# the function runs, so the export is explicit and scoped to a subshell.
( export FLINT_SLOTS_OUT=dist/slots.json
  indent ./bin/flint :src dist/src :fn loader/main :out dist/flint-loader.wasm --loader )
cp dist/flint-loader.wasm dist/flint-runtime.wasm

echo "==> the AOT runtime module, for `flint compile wasm-aot`"
# A second runtime, built from units that carry the compiled-arity helpers. A
# module that does not export them cannot run a compiled arity, and says so.
./bin/build-units --aot > /dev/null
( export FLINT_SLOTS_OUT=dist/slots-aot.json
  indent ./bin/flint :src dist/src :fn loader/main :out dist/flint-runtime-aot.wasm --loader )
./bin/build-units > /dev/null

echo "==> the compiler, as a module and as bytecode"
# Two forms of the same compiler. The MODULE is the artifact: it is what a wasm
# host runs, and what the SDK carries. The BYTECODE is an implementation
# detail -- it never leaves the process that produced it, and it is here only
# so the CLI can embed it and run the compiler as native code, which is 2.7 s
# against 15.6 s through a wasm engine. It is not published and not attached to
# a release.
#
# `:exports flint.selfhost/compile`: the compile as an ordinary CALL
# (`DECISIONS.md#namespaces-over-the-system-port`), which nothing inside the
# compiler references, so the shake would drop it and a host asking for it by
# name would be told this image has no such function.
indent ./bin/flint :src src :fn flint.selfhost/main :exports flint.selfhost/compile :out dist/flintc.bytecode.tmp --emit-image
freshen dist/flintc.bytecode.tmp dist/flintc.bytecode

indent ./bin/flint :src src :fn flint.selfhost/main :exports flint.selfhost/compile :out dist/flintc.wasm.tmp
freshen dist/flintc.wasm.tmp dist/flintc.wasm

# Both forms of the compiler are built, so the stamp is true of both -- and it
# is written and frozen last, after both, so a stamp that made it to `dist/`
# never outruns the artefacts it describes.
printf '%s\n' "$sources_digest" > dist/flintc.sources.tmp
freshen dist/flintc.sources.tmp dist/flintc.sources

# The SDK is a separate package with its own build (`sdks/`), and it is what
# exercises these artifacts end to end. This produces them; `sdks/esm/build`
# calls it and then tests the result.
