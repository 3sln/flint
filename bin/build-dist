#!/bin/sh
# Build the wasm distributable: the compiler, the loader, and the manifest that
# ties them together.
#
# What ships is TWO artifacts and a list.
#
#   flintc.wasm        the compiler, compiled by itself. Source in, a bytecode
#                      IMAGE out. Needs no babashka, no JVM, no Rust, no linker.
#   flint-loader.wasm  the runtime. Any image loads into it and runs.
#   builtins.json      every builtin that loader carries, which the compiler
#                      needs in order to tell `flint.rt/add` from a typo.
#
# What does NOT ship is a way to produce a standalone single-file `.wasm`
# module. That is LINKING, and linking relocatable wasm objects is `wasm-ld`, a
# native tool. `bin/flint` does it; this cannot, and `--aot` is downstream of
# it, so AOT is not available from the distributable either. See the README.
set -e

# `cmd | sed` reports SED's status, and sed always succeeds. Every indented
# step below was therefore invisible to `set -e`: a compile error printed its
# stack trace, this script exited 0, and `dist/` kept the artifacts from the
# PREVIOUS build looking current. That is the same class of lie `bin/check-dist`
# exists to catch, one step earlier.
#
# `indent` runs the command and indents its output without a pipeline, so the
# command's own status is what survives.
indent() {
  out=$("$@" 2>&1) && st=0 || st=$?
  printf '%s\n' "$out" | sed 's/^/    /'
  return $st
}
cd "$(dirname "$0")/.."
mkdir -p dist/src

echo "==> production units"
./bin/build-units > /dev/null

echo "==> builtins.json"
bb -e '
(require (quote [babashka.classpath :as cp])) (cp/add-classpath "src")
(require (quote [flint.link :as link]) (quote [clojure.string :as str]))
(let [units (link/discover-units ["units"])
      names (sort (into #{} (mapcat (fn [e] (keys (:provides (val e)))) units)))]
  (spit "dist/builtins.json"
        (str "[\n" (str/join ",\n" (map (fn [n] (str "  \"" n "\"")) names)) "\n]\n"))
  (println "   " (count names) "builtins"))'

echo "==> the runtime module, and the slot map that points an image at it"
# A loader built from one program carries only the builtins that program
# reached -- `--gc-sections` deletes the rest, which is the whole modularity
# story and exactly wrong for a distributable. So generate a source that names
# every one of them, as VALUES rather than calls, which pins them without
# needing to know any arities.
node -e '
const fs = require("fs");
const names = JSON.parse(fs.readFileSync("dist/builtins.json", "utf8"));
const refs = names.map((n) => "flint.rt/" + (n.startsWith("flint/") ? n.slice(6) : n));
fs.writeFileSync("dist/src/loader.cljc", `(ns loader
  "Every builtin, named as a value so the linker keeps it. Generated by
  bin/build-dist from dist/builtins.json; do not edit. ${names.length} builtins."
  (:require [flint.rt]))

(def ^:private all
  [${refs.join("\n   ")}])

(defn main [args]
  ;; Never called: a loader is entered through flint_load_image, which replaces
  ;; this image entirely. It exists so the module has an entry point.
  (str (count all)))
`);'
# `VAR=x fn` in front of a shell FUNCTION does not reliably reach the commands
# the function runs, so the export is explicit and scoped to a subshell.
( export FLINT_SLOTS_OUT=dist/slots.json
  indent ./bin/flint :src dist/src :fn loader/main :out dist/flint-loader.wasm --loader )
cp dist/flint-loader.wasm dist/flint-runtime.wasm

echo "==> the AOT runtime module, for `flint compile wasm-aot`"
# A second runtime, built from units that carry the compiled-arity helpers. A
# module that does not export them cannot run a compiled arity, and says so.
./bin/build-units --aot > /dev/null
( export FLINT_SLOTS_OUT=dist/slots-aot.json
  indent ./bin/flint :src dist/src :fn loader/main :out dist/flint-runtime-aot.wasm --loader )
./bin/build-units > /dev/null

echo "==> the compiler, as a module and as bytecode"
# Two forms of the same compiler. The MODULE is the artifact: it is what a wasm
# host runs, and what the SDK carries. The BYTECODE is an implementation
# detail -- it never leaves the process that produced it, and it is here only
# so the CLI can embed it and run the compiler as native code, which is 2.7 s
# against 15.6 s through a wasm engine. It is not published and not attached to
# a release.
indent ./bin/flint :src src :fn flint.selfhost/main :out dist/flintc.bytecode --emit-image

indent ./bin/flint :src src :fn flint.selfhost/main :out dist/flintc.wasm

# The SDK is a separate package with its own build (`sdks/`), and it is what
# exercises these artifacts end to end. This produces them; `sdks/esm/build`
# calls it and then tests the result.
