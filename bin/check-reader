#!/bin/sh
# THE ONE READER'S CONFORMITY GUARD, on all three generated copies
# (`DECISIONS.md#namespaces-over-the-system-port`, migration step 1).
#
# The source reader and the `flint.compiler.forms` encoder are generated by kin
# (`kin/readcore.kin` .. `kin/formsenc.kin`) into the native runtime, the JVM
# and the CLR. Their contract is BYTES: for every file in `lib/`, `src/`,
# `corpus/` and the test fixtures, read deferred, eager under the default
# features and eager under `:optimize [perf]`'s, each copy must answer exactly
# what the guest's `flint.compiler.reader` + `flint.compiler.forms/encode` answer -- or fail with
# the same message.
#
#   1. `cargo test -p flint-cli kin_reader` reads every file through the
#      embedded compiler (the reference) and the native kin reader, compares,
#      and writes the reference to a private directory;
#   1b. `test/wasm-reader.mjs` reads them through `dist/flint-reader.wasm`;
#   2. `runtimes/jvm/test/RtReader.java` reads the same files on the JVM;
#   3. `Conform --rt-reader` reads them on the CLR.
#
# A PRIVATE DIRECTORY PER RUN, so two worktrees' runs cannot read each
# other's reference (`AGENTS.md` sec. 7).
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
work=$(mktemp -d "${TMPDIR:-/tmp}/check-reader.XXXXXX")
trap 'rm -rf "$work"' EXIT

if ! FLINT_READER_REF_DIR="$work/refs" cargo test --release -p flint-cli kin_reader -- --nocapture \
     > "$work/native.out" 2>&1; then
  grep -E "kin reader|DIFF|^error|panicked" "$work/native.out" | head -40
  echo "  FAIL the native kin reader does not match the guest's bytes"
  exit 1
fi
grep -E "^kin reader" "$work/native.out" | sed 's/^/  native: /'

# 1b. the WASM copy -- `dist/flint-reader.wasm`, which the JavaScript doors read
# source with -- through one module instance for every read, as a host runs it.
if [ -f dist/flint-reader.wasm ]; then
  if node test/wasm-reader.mjs "$work/refs" > "$work/wasm.out" 2>&1; then
    sed 's/^/  /' "$work/wasm.out"
  else
    sed 's/^/  /' "$work/wasm.out"; echo "  FAIL the wasm kin reader"; exit 1
  fi
else
  echo "  FAIL no dist/flint-reader.wasm: run bin/build-dist; the wasm row was NOT checked"
  exit 1
fi

JDK="${FLINT_JDK:-${JAVA_HOME:-/opt/homebrew/opt/openjdk}}"
[ -x "$JDK/bin/javac" ] || JDK=/opt/homebrew/opt/openjdk
if [ -x "$JDK/bin/javac" ]; then
  "$JDK/bin/javac" -d "$work/jvm" runtimes/jvm/src/com/flint/*.java runtimes/jvm/src/com/flint/rt/*.java \
    runtimes/jvm/src/com/_3sln/flint/kgen/rt/*.java runtimes/jvm/test/RtReader.java > "$work/javac.out" 2>&1 \
    || { head -20 "$work/javac.out"; echo "  FAIL the jvm runtime does not compile"; exit 1; }
  # NOT piped into `sed`: a pipeline exits with its last command, and the
  # runner's own exit status is the verdict.
  if "$JDK/bin/java" -cp "$work/jvm" RtReader "$work/refs" > "$work/jvm.out" 2>&1; then
    sed 's/^/  /' "$work/jvm.out"
  else
    sed 's/^/  /' "$work/jvm.out"; echo "  FAIL the jvm kin reader"; exit 1
  fi
else
  echo "  --   no javac at $JDK: the jvm row was NOT checked"
  exit 1
fi

if command -v dotnet > /dev/null 2>&1; then
  (cd runtimes/clr/conform && dotnet build -v q --nologo -c Release -o "$work/clr") > "$work/dotnet.out" 2>&1 \
    || { grep -E " error " "$work/dotnet.out" | head -20; echo "  FAIL the clr runtime does not compile"; exit 1; }
  if dotnet "$work/clr/Conform.dll" --rt-reader "$work/refs" > "$work/clr.out" 2>&1; then
    sed 's/^/  /' "$work/clr.out"
  else
    sed 's/^/  /' "$work/clr.out"; echo "  FAIL the clr kin reader"; exit 1
  fi
else
  echo "  --   no dotnet: the clr row was NOT checked"
  exit 1
fi
