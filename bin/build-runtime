#!/bin/sh
# Build the bare wasm runtime module. Exports __heap_base so the image patcher
# knows where it may place the program's data segment.
set -e
cd "$(dirname "$0")/.."
RUSTFLAGS="-C link-arg=--export=__heap_base -C link-arg=-zstack-size=131072" \
  ./bin/cargo-wasm build --release --target wasm32-unknown-unknown -p flint-rt "$@"
mkdir -p out
cp target/wasm32-unknown-unknown/release/flint_rt.wasm out/flint-runtime.wasm
ls -l out/flint-runtime.wasm
