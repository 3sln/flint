#!/bin/sh
# The native CLI, with the checkout path and cargo-registry path remapped,
# AND with the panic-location machinery itself absent -- not just remapped --
# so a release binary carries no `.rs` path at all (`bin/rust-release-flags`,
# DECISIONS.md#reproducible-build-paths). AGENTS.md's rebuild table and
# worktree setup call this instead of a bare `cargo build --release -p
# flint-cli`, and so does everything else in this tree that builds the same
# crate (`bin/test`, `bin/conform-hosts`, CI's binaries.yml) -- a second,
# differently-flagged invocation of the same package invalidates cargo's
# cache for it, so every caller has to agree on the flags or every other
# caller pays for a rebuild it did not ask for.
#
# `-Zlocation-detail=none` is unstable, so this runs through `bin/cargo-wasm`,
# which resolves the pinned nightly (`bin/nightly-toolchain`) instead of
# whatever stable cargo is on PATH -- the native CLI has no diagnostics
# variant, so it always gets the full release flags.
set -e
cd "$(dirname "$0")/.."
export RUSTFLAGS="$(./bin/rust-release-flags) ${RUSTFLAGS:-}"
exec ./bin/cargo-wasm build --release -p flint-cli "$@"
