#!/usr/bin/env node
// The guest source flint ships, READ: the standard library in its two layers,
// `dist/stdcore.forms` and `dist/stdextra.forms`
// (`DECISIONS.md#namespaces-over-the-system-port` §4), and the two units that
// are not the standard library, `dist/deps.forms` and `dist/cli.forms`
// (`DECISIONS.md#four-units`).
//
// Each is one wire-encoded map, `{"clojure/core" <answer bytes>, ..}`, keyed by
// the namespace's path without an extension, whose values are the COMPLETE
// resolver answers the JavaScript doors hand the compiler: `:file`, `:forms`
// (`flint.compiler.forms` bytes, read DEFERRED by the kin reader so one read serves every
// feature set), `:dialect`, and the workspace, tags, prelude, grants and guard
// of the `deps.edn` that owns the file. Built once here and embedded by both
// JS doors, so they cannot answer the library two ways.
//
// WHICH NAMESPACES ARE STDCORE IS ASKED OF THE COMPILER, not listed. stdcore is
// "every namespace an image needs whatever the host supplies", which is exactly
// what the compiler requests when it compiles a program that requires nothing:
// this compiles one, `:target :image`, under `[perf]`'s features, answering
// every request from all of `lib/`, and takes the answered names minus the
// probe's own. A ninth namespace pulled into the closure, or one dropped from
// it, moves here with no list to edit.
//
// `flint.check` LANDS IN STDCORE BY THIS SAME MEASUREMENT, not by a special
// case here -- it does not need one. `flint.compiler.resolve/project-roots` makes it a
// root UNCONDITIONALLY now, the same way it already does `flint.port` and
// `flint.wire` (`DECISIONS.md#checks`), so the probe below reaches it even
// though the probe's own features are `[perf]`'s (no `:flint/check`): the
// embedded compiler that runs this probe is built from the SAME `src/` this
// decision lives in, so the measurement and the fact it measures move
// together by construction, which is the whole point of asking the compiler
// rather than listing. What differs between a checked and an unchecked build
// is never WHETHER `flint.check` resolves -- it always does, from this one
// stdcore answer, before any host resolver is asked -- but which of its two
// internal variants each of its public names picks, via the ordinary
// `#?(:flint/check A :default B)` on each one (deferred here exactly like
// every other `#?` in the stdlib, resolved per compile rather than per
// read). There is deliberately no third blob: a `dist/stdcheck.forms` would
// hold the exact one answer stdcore already carries, under a second name a
// reader would have to learn is not actually a separate case (AGENTS.md §1).
//
//     bin/build-stdlib-forms            (bin/build-dist runs it)
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { codec } from '../sdks/esm/src/codec.js';
import { instantiate } from '../sdks/esm/src/guest.js';
import {
  Reader, SOURCE_EXTENSIONS, PERF_FEATURES, dialectOf, nsPath, compileCall, compileRequest,
  encodeAnswer, Encoded, renderErrors,
} from '../sdks/esm/src/resolve.js';
import { ednBlock, ednToken } from '../sdks/cli/src/edn.mjs';

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
const dist = path.join(root, 'dist');

// --- the source roots, and which blob each one goes to ------------------------
//
// FOUR UNITS, each a source root owned by CONTAINMENT (`DECISIONS.md#four-units`):
// the standard library's two layers, `lib/stdcore/` and `lib/stdextra/`, both
// owned by `lib/deps.edn` (one directory up, the same rule `bin/flint`'s
// `project-of` follows); `flint.deps` in `lib/deps/`; and `flint.cli` in
// `cli/lib/`. The two last are not the standard library: `dist/deps.forms` and
// `dist/cli.forms` are separate blobs, so the ESM SDK can leave `flint.cli` out
// and offer `flint.deps` as an optional building block.
//
// stdcore IS A DIRECTORY, AND THE COMPILER IS ASKED TO AGREE WITH IT. Which
// namespaces every image needs is measured below exactly as it always was; the
// build now FAILS when the measurement and `lib/stdcore/` disagree, naming the
// file to move -- a fact a directory listing shows, checked by the only thing
// that knows it.
const UNITS = [
  { root: 'lib/stdcore', blob: 'stdcore.forms' },
  { root: 'lib/stdextra', blob: 'stdextra.forms' },
  { root: 'lib/deps', blob: 'deps.forms' },
  { root: 'cli/lib', blob: 'cli.forms' },
];

// The `deps.edn` that owns a root: its own, or the one a directory up.
function ownerOf(dir) {
  for (const p of [path.join(dir, 'deps.edn'), path.join(path.dirname(dir), 'deps.edn')]) {
    if (fs.existsSync(p)) return workspace(fs.readFileSync(p, 'utf8'));
  }
  return {};
}

function workspace(text) {
  const tokens = (frag) => frag.split(/[\s,]+/).filter(Boolean);
  const tags = tokens(ednBlock(text, ':flint/tag-readers', '{', '}'));
  const pairs = [];
  for (let i = 0; i + 1 < tags.length; i += 2) pairs.push([tags[i], tags[i + 1]]);
  return {
    workspace: ednToken(text, ':flint/workspace'),
    tags: pairs,
    prelude: tokens(ednBlock(text, ':flint/prelude', '[', ']')),
    grants: tokens(ednBlock(text, ':flint/capabilities-grant', '[', ']')),
    guard: tokens(ednBlock(text, ':flint/capabilities-guard', '[', ']')),
  };
}

// --- read every file, deferred ------------------------------------------------
//
// THE DIALECT TRAVELS IN THE ANSWER, explicitly: `:dialect` beside `:forms`,
// which is what the reader was told and what the compiler checks it against.
const reader = Reader.loadSync(fs.readFileSync(path.join(dist, 'flint-reader.wasm')));
const answers = new Map();      // base path -> encoded answer bytes
const unitOf = new Map();       // base path -> blob name
for (const unit of UNITS) {
  const dir = path.join(root, unit.root);
  const ws = ownerOf(dir);
  const files = [];
  (function walk(d, prefix) {
    for (const name of fs.readdirSync(d).sort()) {
      const full = path.join(d, name);
      const rel = prefix ? `${prefix}/${name}` : name;
      if (fs.statSync(full).isDirectory()) walk(full, rel);
      else if (SOURCE_EXTENSIONS.some((e) => rel.endsWith(e))) files.push(rel);
    }
  })(dir, '');
  for (const p of files) {
    const ext = SOURCE_EXTENSIONS.find((e) => p.endsWith(e));
    const base = p.slice(0, -ext.length);
    // THE MOST SPECIFIC EXTENSION WINS, as it does for any namespace; and a
    // namespace two roots both hold is a mistake, not a shadow.
    if (answers.has(base)) {
      if (unitOf.get(base) !== unit.blob) {
        console.error(`    ${base} is in both ${unitOf.get(base)} and ${unit.blob}'s roots`);
        process.exit(1);
      }
      continue;
    }
    const dialect = dialectOf(p);
    const r = reader.read(fs.readFileSync(path.join(dir, p), 'utf8'),
                          { file: p, features: null, tags: ws.tags ?? [], dialect });
    if (r.error) {
      console.error(`    ${unit.root}/${p}:${r.error.line}:${r.error.column}: ${r.error.message}`);
      process.exit(1);
    }
    const a = { forms: r.forms, file: p, dialect, ...ws };
    answers.set(base, encodeAnswer(base, a, {}).encode());
    unitOf.set(base, unit.blob);
  }
}

// --- ask the compiler which of them every image needs -------------------------
const PROBE = 'flint-stdcore-probe';
// REFERRING NOTHING OF `clojure.core`: it is a library now, reached only by the
// namespaces that refer it (`DECISIONS.md#four-units`), so a probe that referred
// it would measure `clojure.core`'s closure rather than every image's.
const probeText = `(ns ${PROBE} (:refer-clojure :only []))\n(defn main [_] nil)\n`;
const slots = JSON.parse(fs.readFileSync(path.join(dist, 'slots.json'), 'utf8'));
const inst = instantiate(new WebAssembly.Module(fs.readFileSync(path.join(dist, 'flintc.wasm'))));
if (inst.exports.set_memory_limit) inst.exports.set_memory_limit(3_000_000_000);
const stdlib = (b) => unitOf.get(b) === 'stdcore.forms' || unitOf.get(b) === 'stdextra.forms';
const all = (ns) => (ns === PROBE ? { source: probeText, file: `${PROBE}.cljc` }
                     : stdlib(nsPath(ns)) ? new Encoded(answers.get(nsPath(ns))) : null);
const result = compileCall(inst, compileRequest({
  entry: `${PROBE}/main`, target: 'image', slots, features: PERF_FEATURES,
}), { resolve: all, reader, features: PERF_FEATURES });
if (result[':errors']) {
  console.error(`    the stdcore probe did not compile:\n${renderErrors(result[':errors'])}`);
  process.exit(1);
}
const core = new Set(result[':reached'].map((r) => nsPath(r[':ns'])).filter((b) => b !== nsPath(PROBE)));

// --- the blobs ---------------------------------------------------------------
for (const missing of [...core].filter((b) => !answers.has(b))) {
  console.error(`    the compiler reached ${missing}, which no standard-library root holds`);
  process.exit(1);
}
const wrong = [
  ...[...core].filter((b) => unitOf.get(b) !== 'stdcore.forms')
    .map((b) => `${b} is reached by every image, so it belongs in lib/stdcore/ (it is in ${unitOf.get(b)})`),
  ...[...unitOf].filter(([b, u]) => u === 'stdcore.forms' && !core.has(b))
    .map(([b]) => `${b} is in lib/stdcore/, and no image needs it: move it to lib/stdextra/`),
];
if (wrong.length) {
  console.error(`    lib/stdcore/ and what the compiler reaches disagree:\n      ${wrong.join('\n      ')}`);
  process.exit(1);
}
const freshen = (name, bytes) => {
  const at = path.join(dist, name);
  if (fs.existsSync(at) && Buffer.compare(fs.readFileSync(at), Buffer.from(bytes)) === 0) return;
  fs.writeFileSync(at, bytes);
};
for (const unit of UNITS) {
  const entries = [...answers].filter(([b]) => unitOf.get(b) === unit.blob)
    .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
  const bytes = codec.map(entries.map(([b, v]) => [codec.str(b), codec.bytes(v)])).encode();
  freshen(unit.blob, bytes);
  console.log(`    dist/${unit.blob} ${entries.length} namespaces, ${bytes.length} bytes` +
              (unit.blob === 'stdcore.forms' ? `: ${[...core].sort().join(' ')}` : ''));
}
