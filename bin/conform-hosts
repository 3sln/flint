#!/bin/sh
# Differential conformance: the SAME program on two runtimes, diffed.
#
# `doc/decisions/0010` is explicit that the bytecode makes a port cheap and
# does nothing to make two ports AGREE. This is the agreement: one source,
# compiled once, run on the native runtime and on the JVM, and the answers
# compared byte for byte.
#
# A port that runs is not a port that is correct. This is what tells them apart.
set -e
cd "$(dirname "$0")/.."

# Skipping is for a developer without a JDK installed; it is NOT for CI. A gate
# that silently passes when it ran nothing is worse than no gate, so CI sets
# FLINT_REQUIRE_HOSTS=1 and a missing toolchain is then a failure with a name.
require_hosts="${FLINT_REQUIRE_HOSTS:-0}"
missing() {
  if [ "$require_hosts" = "1" ]; then
    echo "  FAIL $1 (FLINT_REQUIRE_HOSTS=1, so this is not skippable)"
    exit 1
  fi
  echo "  ($1; skipped)"
}

# JDK 24+ for `java.lang.classfile`, which the AOT emitter uses. Falls back to
# 21 for the interpreter rows when a newer one is not there.
# FLINT_JDK first, then whatever the environment already points at -- CI and
# most JDK managers set JAVA_HOME, and asking a second question when the answer
# is already in the environment is how a gate ends up skipped on a machine that
# could have run it.
JDK="${FLINT_JDK:-${JAVA_HOME:-/opt/homebrew/opt/openjdk}}"
[ -x "$JDK/bin/javac" ] || JDK=/opt/homebrew/opt/openjdk
[ -x "$JDK/bin/javac" ] || JDK=/opt/homebrew/opt/openjdk@21
if [ ! -x "$JDK/bin/javac" ]; then
  missing "no JDK at $JDK; set FLINT_JDK to run the JVM rows"
  exit 0
fi

# The CLR rows are skipped rather than failed when there is no dotnet: the rest
# of the suite must not need one installed.
export DOTNET_ROOT="${DOTNET_ROOT:-/opt/homebrew/opt/dotnet/libexec}"
CLR=""
if command -v dotnet >/dev/null 2>&1; then
  (cd runtimes/clr/conform && dotnet build -v q --nologo -c Release) >/dev/null 2>&1 \
    && CLR="runtimes/clr/conform/bin/Release/net10.0/Conform"
  [ -x "$CLR" ] || CLR=""
fi
[ -n "$CLR" ] || missing "no dotnet, or the conform project did not build; CLR rows"

# Cleared, not reused. Images used to be kept if present, which meant one from
# an earlier build survived a change to the image FORMAT -- and the symptom was
# `this image is version 2 and this runtime reads 3` from a test that had
# nothing to do with the change. Compiling one costs under a second; a stale one
# costs an afternoon.
rm -rf out/conform
mkdir -p out/conform
# javac's exit status, not just its output. This used to be piped into `head`,
# which discards the status: a JDK too old for `java.lang.classfile` failed to
# compile `Aot.java`, the script carried on, and `java` then ran whatever class
# files were left over from the last good build. The confusing symptom was an
# UnsupportedClassVersionError from a test that had not been recompiled.
#
# Stale classes are removed first for the same reason: a compile that fails
# must not leave a runnable tree behind.
rm -rf runtimes/jvm/classes
if ! "$JDK/bin/javac" -d runtimes/jvm/classes runtimes/jvm/src/com/flint/*.java \
     runtimes/jvm/src/com/flint/rt/*.java runtimes/jvm/test/*.java > /tmp/flint-javac.out 2>&1; then
  head -20 /tmp/flint-javac.out
  if grep -q "java.lang.classfile" /tmp/flint-javac.out; then
    echo "  (this JDK is older than 24, which is what java.lang.classfile needs;"
    echo "   set FLINT_JDK to a 24+ install to run the JVM rows)"
  fi
  missing "javac failed at $JDK"
  exit 0
fi

# Multi-threading on the JVM, which is a different problem to the native
# runtime's: there is no safepoint to build because there is no collector of
# ours to stop. What has to be right is flint's own shared state.
if ./bin/flint :src runtimes/conform :fn threads/main \
     --emit-image :out out/conform/threads.img >/dev/null 2>&1; then
  if "$JDK/bin/java" -cp runtimes/jvm/classes ThreadTest out/conform/threads.img \
       > /tmp/flint-jvm-threads.out 2>&1; then
    grep -E "^  ok" /tmp/flint-jvm-threads.out | sed 's/$/ [jvm]/'
  else
    cat /tmp/flint-jvm-threads.out
    echo "  FAIL jvm threads"
    exit 1
  fi
  if [ -n "$CLR" ]; then
    if "$CLR" --threads out/conform/threads.img > /tmp/flint-clr-threads.out 2>&1; then
      grep -E "^  ok" /tmp/flint-clr-threads.out | sed 's/$/ [clr]/'
    else
      cat /tmp/flint-clr-threads.out
      echo "  FAIL clr threads"
      exit 1
    fi
  fi
fi

fails=0
total=0
for src in runtimes/conform/*.cljc; do
  ns="$(basename "$src" .cljc)"
  total=$((total + 1))
  ./bin/flint :src runtimes/conform :fn "$ns/main" --emit-image \
    :out "out/conform/$ns.img" >/dev/null 2>&1 \
    || { echo "  FAIL $ns (did not compile)"; fails=$((fails + 1)); continue; }

  # `|| true` on both: a runtime that FAILS is a result to report, not a
  # reason to stop the run. `set -e` would otherwise end the suite at the
  # first divergence and hide every case after it.
  native="$(./target/release/flint run :path runtimes/conform :fn "$ns/main" 2>&1 || true)"
  jvm="$("$JDK/bin/java" -cp runtimes/jvm/classes Conform "out/conform/$ns.img" 2>&1 || true)"
  clr=""
  [ -n "$CLR" ] && clr="$("$CLR" "out/conform/$ns.img" 2>&1 || true)"

  # AOT, on both hosts that have it: the same program compiled and interpreted,
  # and the answers diffed. The only thing worth asserting about a backend is
  # that it did not change the answer -- fast and wrong is worse than absent,
  # and "it ran" does not tell them apart.
  jaot="$("$JDK/bin/java" -cp runtimes/jvm/classes AotTest "out/conform/$ns.img" 2>&1 || true)"
  case "$jaot" in
    *"ok  "*) echo "  $(echo "$jaot" | head -1 | sed 's/^ *//') [jvm aot: '"$ns"']" ;;
    *) echo "  FAIL jvm aot $ns"; echo "$jaot"; fails=$((fails + 1)) ;;
  esac
  if [ -n "$CLR" ]; then
    aot="$("$CLR" --aot "out/conform/$ns.img" 2>&1 || true)"
    case "$aot" in
      *"ok  "*) echo "  $(echo "$aot" | head -1 | sed 's/^ *//') [clr aot: '"$ns"']" ;;
      *) echo "  FAIL clr aot $ns"; echo "$aot"; fails=$((fails + 1)) ;;
    esac
  fi

  bad=""
  [ "$native" = "$jvm" ] || bad="jvm"
  [ -n "$CLR" ] && [ "$native" != "$clr" ] && bad="${bad} clr"
  if [ -z "$bad" ]; then
    echo "  ok   $ns"
  else
    fails=$((fails + 1))
    echo "  FAIL $ns ($bad)"
    echo "        native $native"
    echo "        jvm    $jvm"
    [ -n "$CLR" ] && echo "        clr    $clr"
  fi
done

agree=$((total - fails))
echo "  $agree/$total agree"

# A FLOOR rather than "all must pass", because the port is unfinished and a case
# it cannot yet run should be visible rather than deleted. What must not happen
# is the number going DOWN.
#
# Map iteration order used to be the divergence here, and it is closed: flint's
# hash is ported bit-for-bit and the CHAMP walks in the same order, so a
# forty-key map prints identically on both. That was worth the trouble for the
# reason `doc/decisions/0010` gives -- `pr-str` of a map is how an answer is
# compared, and content-addressed artifacts would otherwise hash differently
# per host.
FLOOR="${FLINT_CONFORM_FLOOR:-10}"
if [ "$agree" -lt "$FLOOR" ]; then
  echo "  a case that used to agree no longer does ($agree < $FLOOR)"
  exit 1
fi

# THE PORTED RUNTIME'S FOUNDATION, on both hosts, with the same assertions in
# the same order.
#
# `doc/decisions/0010` says the bytecode makes a port cheap and does nothing to
# make two ports AGREE. These files are meant to be verbatim mirrors of the Rust
# and of each other, and the only way to know that is to run the same checks on
# both rather than to intend it.
echo "  .. the ported runtime's foundation"
"$JDK/bin/java" -cp runtimes/jvm/classes RtFoundation > /tmp/flint-rt-jvm.out 2>&1 \
  || { cat /tmp/flint-rt-jvm.out; echo "  FAIL the ported runtime [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-rt-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-foundation > /tmp/flint-rt-clr.out 2>&1 \
    || { cat /tmp/flint-rt-clr.out; echo "  FAIL the ported runtime [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-rt-clr.out

  # The two are meant to be VERBATIM MIRRORS, so the check is not that each
  # passes -- it is that they make the same decisions. The collector lines
  # carry the minor and major counts and the bytes reclaimed, and those being
  # equal means the two collectors collected at the same points and freed the
  # same things. Two collectors that merely both work would not.
  #
  # The timing line is excluded, and only that one: it is a measurement of the
  # machine rather than of the port.
  grep "^  ok" /tmp/flint-rt-jvm.out > /tmp/flint-rt-jvm.ok
  grep "^  ok" /tmp/flint-rt-clr.out > /tmp/flint-rt-clr.ok
  if cmp -s /tmp/flint-rt-jvm.ok /tmp/flint-rt-clr.ok; then
    echo "  ok   the two ported runtimes agree line for line"
  else
    echo "  FAIL the ported runtimes DIVERGED:"
    diff /tmp/flint-rt-jvm.ok /tmp/flint-rt-clr.ok | sed 's/^/        /'
    exit 1
  fi
fi

# The ported runtime on a REAL image, rather than on hand-assembled bytecode.
# It reports how far it gets: the standard library is not ported yet, and
# "loaded and then wanted `flint/num->str`" is the useful answer while that is
# true. A silent pass would be the misleading one.
mkdir -p out/rt-probe
cat > out/rt-probe/probe.cljc <<'PROBE'
(ns probe)
(defn- add [a b] (+ a b))
(defn- run [n] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (add acc i)) acc)))
(defn main [_] (run 1000))
PROBE
./bin/flint :src out/rt-probe :fn probe/main --emit-image \
  :out out/rt-probe/probe.img >/dev/null 2>&1
# The NATIVE answer for the same program, so the check is agreement rather
# than "it did not throw".
rt_want="$(./target/release/flint run :path out/rt-probe :fn probe/main 2>&1 || true)"
"$JDK/bin/java" -cp runtimes/jvm/classes RtImage out/rt-probe/probe.img "$rt_want" \
  > /tmp/flint-img-jvm.out 2>&1 \
  || { cat /tmp/flint-img-jvm.out; echo "  FAIL the ported runtime disagrees with the native one [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-img-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-image out/rt-probe/probe.img "$rt_want" > /tmp/flint-img-clr.out 2>&1 \
    || { cat /tmp/flint-img-clr.out; echo "  FAIL the ported runtime disagrees with the native one [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-img-clr.out
  # THREE runtimes on one program, and the two ports compared to each other as
  # well as to the native one. Agreeing with the native answer is what makes
  # each correct; agreeing line for line with each other -- constant counts,
  # code size, native count -- is what makes them the same port.
  cmp -s /tmp/flint-img-jvm.out /tmp/flint-img-clr.out \
    && echo "  ok   the two ported runtimes read the image identically" \
    || { diff /tmp/flint-img-jvm.out /tmp/flint-img-clr.out | head; \
         echo "  FAIL the two ported runtimes read the image differently"; exit 1; }
fi

# SNAPSHOTS on the ported runtime: both formats. The verbatim one is a memcpy
# that must come back at IDENTICAL addresses; the live one traverses and must
# come back correct at DIFFERENT ones, so it is imported into a heap with a
# different nursery and the test asserts the addresses moved as well as that
# the data survived. Checking only "the data is still there" would pass for a
# live import that had quietly kept the old addresses.
# The HASH, against the numbers a real Clojure produced. Its values are
# observable from Clojure code, so a program ported to flint should get the
# numbers it got before -- which makes this a compatibility check rather than a
# self-consistency one, and the reason the expected values came out of `bb`
# rather than out of this implementation.
"$JDK/bin/java" -cp runtimes/jvm/classes RtHash > /tmp/flint-hash-jvm.out 2>&1 \
  || { cat /tmp/flint-hash-jvm.out; echo "  FAIL the ported hash disagrees with Clojure [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-hash-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-hash > /tmp/flint-hash-clr.out 2>&1 \
    || { cat /tmp/flint-hash-clr.out; echo "  FAIL the ported hash disagrees with Clojure [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-hash-clr.out
  cmp -s /tmp/flint-hash-jvm.out /tmp/flint-hash-clr.out \
    || { echo "  FAIL the two ports hash differently"; exit 1; }
fi

# MAPS: the array-map, the promotion to CHAMP at 9 entries, and the two
# properties CHAMP is chosen FOR -- canonical form (a map built by deleting
# equals and hashes like the same map built directly) and collision nodes.
"$JDK/bin/java" -cp runtimes/jvm/classes RtMaps > /tmp/flint-maps-jvm.out 2>&1 \
  || { cat /tmp/flint-maps-jvm.out; echo "  FAIL maps on the ported runtime [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-maps-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-maps > /tmp/flint-maps-clr.out 2>&1 \
    || { cat /tmp/flint-maps-clr.out; echo "  FAIL maps on the ported runtime [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-maps-clr.out
  cmp -s /tmp/flint-maps-jvm.out /tmp/flint-maps-clr.out \
    || { diff /tmp/flint-maps-jvm.out /tmp/flint-maps-clr.out | head; \
         echo "  FAIL the two ports disagree about maps"; exit 1; }
fi

# SHELVING A REAL PROGRAM, mid-run. `RtSnapshot` next door round-trips a heap
# built by hand, which checks the FORMAT; this stops a program that is genuinely
# half-finished -- frames on the stack, locals live, a loop counter partway --
# moves it to a fresh runtime with a different nursery, and checks that it
# carries on to the answer it would have reached uninterrupted. A hand-built
# heap has no interpreter state in it at all, so none of that was covered.
"$JDK/bin/java" -cp runtimes/jvm/classes RtShelve out/rt-probe/probe.img "$rt_want" \
  > /tmp/flint-shelve-jvm.out 2>&1 \
  || { cat /tmp/flint-shelve-jvm.out; echo "  FAIL shelving a real program [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-shelve-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-shelve out/rt-probe/probe.img "$rt_want" > /tmp/flint-shelve-clr.out 2>&1 \
    || { cat /tmp/flint-shelve-clr.out; echo "  FAIL shelving a real program [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-shelve-clr.out
  cmp -s /tmp/flint-shelve-jvm.out /tmp/flint-shelve-clr.out \
    || { diff /tmp/flint-shelve-jvm.out /tmp/flint-shelve-clr.out | head -4
         echo "  FAIL the two ports shelve differently"; exit 1; }
fi

"$JDK/bin/java" -cp runtimes/jvm/classes RtSnapshot > /tmp/flint-snap-jvm.out 2>&1 \
  || { cat /tmp/flint-snap-jvm.out; echo "  FAIL snapshots on the ported runtime [jvm]"; exit 1; }
sed 's/$/ [jvm]/' /tmp/flint-snap-jvm.out
if [ -n "$CLR" ]; then
  "$CLR" --rt-snapshot > /tmp/flint-snap-clr.out 2>&1 \
    || { cat /tmp/flint-snap-clr.out; echo "  FAIL snapshots on the ported runtime [clr]"; exit 1; }
  sed 's/$/ [clr]/' /tmp/flint-snap-clr.out
  # BYTE FOR BYTE, not merely "both passed". The two runtimes were written
  # separately, so the strong evidence that they are mirrors is that they
  # produce the SAME NUMBERS -- the snapshot sizes are printed precisely
  # because they are what would move if a field were written at a different
  # width or in a different order.
  if cmp -s /tmp/flint-snap-jvm.out /tmp/flint-snap-clr.out; then
    echo "  ok   the two ported runtimes snapshot identically, byte counts included"
  else
    diff /tmp/flint-snap-jvm.out /tmp/flint-snap-clr.out | head -20
    echo "  FAIL the two ported runtimes disagree about snapshots"
    exit 1
  fi
fi

# EVERY conformance program the ported runtimes can run, each checked against
# the NATIVE answer and then the two ports against each other.
#
# `green` is the one to read. Its `:order` row is the ORDER three green threads
# and the main thread actually ran in, so matching means the three schedulers
# agree on an INTERLEAVING and not merely on an answer. That is possible only
# because the scheduler is the same one -- round-robin from just after the
# current thread, no randomness, no clock, no host-order dependence.
#
# Against native rather than merely run, because both ports were wrong the same
# way once: the arithmetic read a double's mantissa as an integer, so `numbers`
# said `:float [0 0 0]` on BOTH and the cross-port compare saw nothing. Only
# the native answer could tell.
#
# The answers are nested collections rather than numbers, so agreeing means
# agreeing about maps, vectors, sets, strings, seqs and doubles at once -- and
# `maps` prints its keys in trie order, so matching means the ported CHAMP
# ITERATES the way the Rust's does, which nothing asserts directly.
for prog in collections control green hosted lazy maps numbers regex strings threads; do
  ./bin/flint :src runtimes/conform :fn "$prog/main" --emit-image \
    :out "out/conform/$prog.img" >/dev/null 2>&1 || {
      echo "  .. $prog does not compile; skipped"; continue; }
  want="$(./target/release/flint run :path runtimes/conform :fn "$prog/main" 2>&1 || true)"
  "$JDK/bin/java" -cp runtimes/jvm/classes RtImage "out/conform/$prog.img" "$want" \
    > /tmp/flint-c-jvm.out 2>&1 \
    || { tail -3 /tmp/flint-c-jvm.out; echo "  FAIL $prog disagrees with native [jvm]"; exit 1; }
  echo "  ok   $prog agrees with the native runtime [jvm]"
  if [ -n "$CLR" ]; then
    "$CLR" --rt-image "out/conform/$prog.img" "$want" > /tmp/flint-c-clr.out 2>&1 \
      || { tail -3 /tmp/flint-c-clr.out; echo "  FAIL $prog disagrees with native [clr]"; exit 1; }
    echo "  ok   $prog agrees with the native runtime [clr]"
    cmp -s /tmp/flint-c-jvm.out /tmp/flint-c-clr.out \
      || { diff /tmp/flint-c-jvm.out /tmp/flint-c-clr.out | head -4
           echo "  FAIL the two ports disagree on $prog"; exit 1; }
  fi
done

# ONE CONFIG, THREE RUNTIMES. `:optimize [perf]` cannot be carried the same way
# on any two of them: on wasm it changes the ARTIFACT -- a different runtime
# binary, compiled arities emitted into the module -- while on the JVM and the
# CLR the arities are emitted at LOAD time from the same bytecode, so the two
# images are byte-identical apart from the flag. That is exactly why the flag
# exists, and why "is the compiled-arity table non-empty" could not answer it.
#
# Checked on both ports rather than asserted in a comment: the same source
# compiled twice, and each runtime asked what it decided to do about it.
./bin/flint :src runtimes/conform :fn numbers/main :optimize '[perf]' \
  --emit-image :out out/conform/perf.img >/dev/null 2>&1
./bin/flint :src runtimes/conform :fn numbers/main :optimize '[size]' \
  --emit-image :out out/conform/size.img >/dev/null 2>&1
for want in "perf 1 true" "size 0 false"; do
  set -- $want
  nm=$1; wf=$2; wa=$3
  got="$("$JDK/bin/java" -cp runtimes/jvm/classes Flags "out/conform/$nm.img")"
  if [ "$got" = "flags=$wf aot=$wa" ]; then
    echo "  ok   :optimize [$nm] reaches the runtime that has to act on it [jvm]"
  else
    echo "  FAIL :optimize [$nm] [jvm]: wanted 'flags=$wf aot=$wa', got '$got'"
    exit 1
  fi
  if [ -n "$CLR" ]; then
    got="$("$CLR" --flags "out/conform/$nm.img")"
    if [ "$got" = "flags=$wf aot=$wa" ]; then
      echo "  ok   :optimize [$nm] reaches the runtime that has to act on it [clr]"
    else
      echo "  FAIL :optimize [$nm] [clr]: wanted 'flags=$wf aot=$wa', got '$got'"
      exit 1
    fi
  fi
done

# SELF-HOSTING: run the flint COMPILER on each port and compare what it emits,
# byte for byte, with what the native compiler emits from the same input.
#
# This is the difference between "runs programs" and "self-hosts": the compiler
# is the largest flint program there is, so it reaches builtins a small program
# never does. Every case above passed while `assoc` on a vector returned a map,
# `seq?` answered `seqable?`, and `str-bytes` answered a count -- all three were
# found by running this.
#
# OFF by default because of what it costs, measured: 179 s on the JVM and 704 s
# on the CLR, against about a minute for everything above. Turn it on with
# FLINT_SELFHOST=1, and CI should.
if [ "${FLINT_SELFHOST:-0}" = "1" ]; then
  echo "  .. self-hosting (this takes about 15 minutes)"
  ./bin/flint :src bench/progs :fn hello/main --emit-spec :out out/conform/self.spec     >/dev/null 2>&1
  # The reference: the same spec through the compiler running as wasm.
  node host/flint-file.mjs dist/flintc.wasm out/conform/self.spec > out/conform/self.ref 2>/dev/null
  # The PORTED runtime, checked against that reference BYTE FOR BYTE.
  #
  # "It ran" would not have been enough. Every one of the four bugs this found
  # let the compiler run: map literals came back empty, a tail call to a
  # builtin read a slot off a fixnum, `=` threw where it should answer false,
  # and symbols compared by identity so every local looked unbound. Only
  # comparing the OUTPUT catches the first of those.
  if ! "$JDK/bin/java" -Xss1g -cp runtimes/jvm/classes RtSelfHost \
       out/conform/self.spec out/conform/self.ref; then
    echo "  FAIL jvm self-host"
    exit 1
  fi
  if [ -n "$CLR" ]; then
    if ! "$CLR" --rt-selfhost out/conform/self.spec out/conform/self.ref; then
      echo "  FAIL clr self-host"
      exit 1
    fi
  fi
fi
