#!/bin/sh
# flint across wasm ENGINES (doc/decisions/0018).
#
# Every number in the README is V8. This builds the module family and runs it on
# every engine present, reporting ns/instruction -- which is comparable across
# engines only because 0009 makes the instruction count identical on all of
# them.
#
# Engines are used if installed and SKIPPED BY NAME if not; nothing here is
# fabricated for an absent engine.
set -e
cd "$(dirname "$0")/.."
echo "building the module family (one per iteration count)"
for N in 0 25 50 100 200; do
  ./bin/flint :src bench/xrt :src bench/construe/gen \
    :fn "construe.bench.xrt$N/main" :out "out/xrt-$N.wasm" >/dev/null
done
exec node bench/xruntime.mjs "$@"
