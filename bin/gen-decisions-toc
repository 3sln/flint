#!/usr/bin/env bb
;; A table of contents for DECISIONS.md, generated between markers.
;;
;; The hand-written "Contents" block this replaces grouped 44 of the file's 79
;; `## ` sections by topic and never grew past that -- every decision added
;; since went un-indexed, which is drift between two lists of the same thing
;; (AGENTS.md#one-list-not-two): the heading IS the slug already (`## dispatch`
;; anchors as `#dispatch`), so a second hand-maintained copy of the heading
;; text can only ever restate or disagree with it. This generates the index
;; FROM the headings instead, so there is one list and it cannot fall behind.
;;
;; The one-line title per entry is lifted from the bold line each decision's
;; prose already carries right after its heading (e.g. `## dispatch` is
;; followed by "**Interpreter vs AOT, and stack vs register**") -- not
;; invented here, just surfaced. 18 of the 79 sections have no such line (the
;; first bold text after their heading is the `**Ratified:**` checkbox
;; itself), so for those the title falls back to the first sentence of the
;; `**Status` line, and failing that, of the section's own first paragraph --
;; both are a claim the section already makes, not new prose.
(require '[clojure.string :as str] '[babashka.fs :as fs] '[clojure.java.io :as io])

(def root (str (fs/parent (fs/parent (fs/real-path *file*)))))
(def path (io/file root "DECISIONS.md"))
(def src (slurp path))

(def marker-start "<!-- TOC:BEGIN (generated by bin/gen-decisions-toc -- do not hand-edit) -->")
(def marker-end "<!-- TOC:END -->")

(defn slugify [h]
  (-> h str/lower-case
      (str/replace #"[^a-z0-9]+" "-")
      (str/replace #"^-+|-+$" "")))

;; Same section boundary `bin/check_decisions.py` uses: split on `^## `, keep
;; the heading as the first line of each piece and the rest as its body.
(def pieces (str/split src #"(?m)^## "))

(def sections
  (for [piece (rest pieces)]
    (let [nl (str/index-of piece "\n")
          heading (str/trim (subs piece 0 nl))
          body (subs piece nl)]
      [heading body])))

(defn paragraphs [body]
  (->> (str/split body #"\n\s*\n")
       (map #(str/trim (str/replace % #"\s+" " ")))
       (remove str/blank?)))

(defn first-sentence [s]
  (let [cut (str/index-of s ". ")]
    (str/trim (subs s 0 (if cut (inc cut) (count s))))))

(defn leading-bold [p]
  (second (re-find #"^\*\*(.+?)\*\*" p)))

(defn one-liner [body]
  (or
    ;; A paragraph that OPENS with a `**...**` span -- the dedicated
    ;; one-liner, wherever it falls (some are immediately followed, same
    ;; paragraph, by an italic `*(formerly ...)*` with no blank line between,
    ;; so the span is taken non-greedily rather than requiring the whole
    ;; paragraph to be bold). Excludes `**Ratified:**` and `**Status...**`,
    ;; the two boilerplate bold openers every decision carries, and a bare
    ;; bold LABEL ("Reproduced", "Cause.", "Risk left open:") that amendment
    ;; prose uses as a sub-heading rather than a summary -- four words is
    ;; short for a title and long for a label, which separates the two well
    ;; enough on this file's actual text.
    (first (for [p (paragraphs body)
                 :let [b (leading-bold p)]
                 :when (and b (not (re-matches #"(?i)ratified:" b))
                            (not (re-find #"(?i)^status\b" b))
                            (>= (count (str/split b #"\s+")) 4))]
             b))
    (when-let [m (re-find #"(?s)\*\*Status:?\s*(.*?)\*\*" (str/join " " (paragraphs body)))]
      (first-sentence (second m)))
    (when-let [p (first (paragraphs body))]
      (first-sentence p))
    ""))

(defn render-row [[heading body]]
  (str "- [" heading "](#" (slugify heading) ") -- " (one-liner body)))

(def toc (str/join "\n" (map render-row sections)))
(def block (str marker-start "\n" toc "\n" marker-end))

;; `--check` is `bin/check-toc-current`'s whole implementation: compute, never
;; write, and fail if the tree disagrees. One generator, not a generator plus
;; a second script that re-derives the same TOC to compare against it.
(def check-only? (= "--check" (first *command-line-args*)))

(if (str/includes? src marker-start)
  (let [before (subs src 0 (str/index-of src marker-start))
        after-idx (+ (str/index-of src marker-end) (count marker-end))
        after (subs src after-idx)
        new-src (str before block after)]
    (cond
      (= new-src src)
      (println "gen-decisions-toc: DECISIONS.md's TOC is already current")

      check-only?
      (do (binding [*out* *err*]
            (println "check-toc-current: DECISIONS.md's TOC is stale -- run")
            (println "  bin/gen-decisions-toc")
            (println "and commit the result"))
          (System/exit 1))

      :else
      (do (spit path new-src)
          (println "gen-decisions-toc: regenerated DECISIONS.md's TOC"))))
  (binding [*out* *err*]
    (println "gen-decisions-toc: no TOC markers in DECISIONS.md -- add")
    (println (str "  " marker-start))
    (println (str "  " marker-end))
    (println "where the index should go, then run this again")
    (System/exit 1)))
