#!/usr/bin/env bash
# Every citation of a decision resolves to a section that exists.
#
# This used to assert that a decision's status banner agreed with its row in
# an index -- and never fired, because the rows were copies of the banners.
# Two copies of one claim agree by construction, including when both are
# false. See the docstring in check_decisions.py for what that let through.
exec python3 "$(dirname "$0")/check_decisions.py" "$@"
