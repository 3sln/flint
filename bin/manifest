#!/usr/bin/env bb
;; Generates doc/manifest.edn: for every namespace flint ships, what it defines,
;; what real Clojure has that it does not, and what it adds.
;;
;; Generated rather than written, and checked by test/manifest.clj, because a
;; hand-maintained table in a README drifts the moment somebody adds a function.
(require '[clojure.string :as str] '[clojure.java.io :as io]
         '[clojure.edn :as edn] '[babashka.fs :as fs])
(def root (str (fs/parent (fs/parent (fs/real-path *file*)))))
(babashka.classpath/add-classpath (str root "/src"))
(require '[flint.compiler.reader :as reader] '[flint.compiler.core :as compiler] '[flint.compiler.macros :as macros])

(def shipped
  "Namespace -> source file. These are what a flint program can require.

  The standard library is now two source roots (AGENTS.md's restructure
  note): `lib/stdcore/` and `lib/stdextra/`, both `.fln`, both owned by
  `lib/deps.edn`. Which of the two a namespace landed in is not meaningful
  here -- this map just has to point at the right file."
  '{clojure.core      "lib/stdcore/clojure/core.fln"
    clojure.string    "lib/stdcore/clojure/string.fln"
    clojure.core.protocols "lib/stdextra/clojure/core/protocols.fln"
    clojure.datafy    "lib/stdextra/clojure/datafy.fln"
    clojure.data      "lib/stdextra/clojure/data.fln"
    clojure.set       "lib/stdextra/clojure/set.fln"
    clojure.math      "lib/stdextra/clojure/math.fln"
    clojure.walk      "lib/stdextra/clojure/walk.fln"
    clojure.zip       "lib/stdextra/clojure/zip.fln"
    clojure.edn       "lib/stdextra/clojure/edn.fln"
    flint.core        "lib/stdcore/flint/core.fln"
    flint.protocols   "lib/stdcore/flint/protocols.fln"
    flint.regex       "lib/stdcore/flint/regex.fln"
    flint.thread      "lib/stdextra/flint/thread.fln"
    flint.port        "lib/stdcore/flint/port.fln"
    flint.protocols.io "lib/stdextra/flint/protocols/io.fln"
    flint.rpc         "lib/stdextra/flint/rpc.fln"
    flint.doc         "lib/stdextra/flint/doc.fln"
    flint.data.json   "lib/stdextra/flint/data/json.fln"
    flint.data.transit "lib/stdextra/flint/data/transit.fln"
    flint.data.xml    "lib/stdextra/flint/data/xml.fln"
    flint.data.html   "lib/stdextra/flint/data/html.fln"})

(def compared-with
  "Which real Clojure namespace to diff against, where there is one."
  '{clojure.core clojure.core
    clojure.string clojure.string
    clojure.set clojure.set
    clojure.math clojure.math
    clojure.walk clojure.walk
    clojure.edn clojure.edn
    clojure.zip clojure.zip})

;; `clojure.data`, `clojure.datafy` and `clojure.core.protocols` are deliberately
;; NOT in that map. This script runs on babashka, and babashka's versions of
;; those three are partial reimplementations -- its `clojure.data` publishes two
;; vars where Clojure's publishes five. Diffing against them would report gaps
;; in flint that are really gaps in the baseline.

(defn- defined-by
  "The names one top-level form defines, each with whether it is a macro and
  whether it is private.

  `defprotocol` defines SEVERAL -- the protocol itself and one function per
  method -- and until this handled it, a namespace whose whole surface is a
  protocol reported zero vars. `clojure.core.protocols` is exactly that, and
  the README table said so.

  A `Name__impls` atom is the one thing skipped: `defprotocol` emits one, the
  longhand protocol in `clojure.core` writes one by hand, and neither is
  something a caller uses. It was appearing in `clojure.core`'s :extra list as
  a var Clojure lacks, which is true and useless."
  [f]
  (let [head (first f)
        entry (fn [nm macro? private?]
                (when (and (symbol? nm)
                           (not (str/ends-with? (name nm) "__impls")))
                  [[(symbol (name nm)) {:macro macro? :private private?}]]))]
    (cond
      (= 'defprotocol head)
      (concat (entry (second f) false false)
              (mapcat (fn [sig] (when (seq? sig) (entry (first sig) false false)))
                      (drop 2 f)))

      (contains? '#{def defn defn- defmacro} head)
      (entry (second f)
             (= 'defmacro head)
             (boolean (or (= 'defn- head) (:private (meta (second f))))))

      :else nil)))

(defn defines
  "Every var a source file defines, with whether it is a macro and private."
  [file]
  (let [src (slurp (io/file root file))
        forms (compiler/flatten-top-level
               (reader/read-all src {:file file :features #{:flint}}))]
    (into {} (mapcat defined-by (filter seq? forms)))))

(def real-clojure-core
  "The public vars real Clojure 1.12.1's `clojure.core` publishes -- read ONCE
  from a real JVM Clojure and committed to `bin/clojure-core-publics.edn`,
  never introspected from the interpreter EXECUTING this script.

  This script runs on babashka, and babashka's bundled `clojure.core` (its sci
  implementation) is not real Clojure -- the comment above already says what
  that costs for the other compared namespaces (\"diffing against them would
  report gaps in flint that are really gaps in the baseline\"). For
  `clojure.core` specifically it used to be patched with a hardcoded
  `babashka-blind-spot` set (vars real Clojure has that babashka's bundled
  core, AS OF SOME PAST BABASHKA VERSION, did not) -- a second list trying to
  correct the first, the shape `AGENTS.md`'s \"one list, not two\" warns about.
  It broke the moment the babashka pin moved: bumping from v1.3.190 to
  v1.13.225 changed FOUR names in babashka's own bundled `clojure.core` with
  no change to real Clojure at all -- `-locking-impl`, `req!` and `some-vals`
  newly PRESENT (babashka's own internal-helper churn, not real Clojure vars,
  so `ns-publics` on that babashka now reports names the blind-spot set never
  anticipated needing to EXCLUDE), `binding-conveyor-fn` newly ABSENT (so the
  blind-spot set would have needed a new entry just to stay correct against
  the same real baseline). `doc/manifest.edn`'s `:absent` list for
  `clojure.core` became a function of the babashka VERSION this script
  happens to run on, not of flint or of Clojure
  (`DECISIONS.md#pin-the-babashka-version`). Reading a static snapshot of the
  real baseline instead removes the dependency outright, rather than patching
  babashka's answer release by release.

  Regenerate `bin/clojure-core-publics.edn` when the real Clojure version
  flint targets moves (currently 1.12.1, named in that file's own header):

      clojure -M -e '(->> (ns-publics (quote clojure.core)) keys (map name) sort (run! println))'

  one name per line, sorted, wrapped as `#{...}`."
  (into (sorted-set)
        (map symbol (edn/read-string (slurp (io/file root "bin/clojure-core-publics.edn"))))))

(def clojure-special-forms
  "Names Clojure HAS that no `ns-publics` anywhere will show, because they are
  SPECIAL FORMS rather than vars.

  flint implements some of them as macros -- `letfn*` is one, and
  `clojure.core/letfn` expands into it exactly as Clojure's does -- which makes
  them vars HERE. A comparison against a var list then reports them as names flint
  invented, and `:extra`'s docstring above already records that failure mode for
  three names babashka cannot see. Same error, different cause: there the baseline
  was incomplete, here the baseline is the wrong KIND of list.

  Only `letfn*` is here because only it is affected: every other special form
  (`fn*`, `let*`, `try`, `new`, `case*`, `deftype*` ..) is a special form in
  flint's analyzer too, so none of them is a var in `clojure.core` and none has
  ever appeared in `:extra` -- which was `#{}` until `letfn*` landed."
  '#{letfn*})

(defn clojure-publics [ns-sym]
  (if (= ns-sym 'clojure.core)
    ;; The static baseline (`real-clojure-core`), not this interpreter's own
    ;; `clojure.core` -- see its docstring. `letfn*` is still merged in: it is
    ;; a special form in flint, never a var even in real Clojure's ns-publics.
    (into real-clojure-core clojure-special-forms)
    (try
      (require ns-sym)
      (set (map (comp symbol name) (keys (ns-publics (find-ns ns-sym)))))
      (catch Throwable _ nil))))

(def bootstrap-macros
  "Macros the compiler knows without compiling anything. They are as present as
  anything in core -- they just are not defined in core's source."
  (into (sorted-set) (keys macros/bootstrap)))

(def manifest
  (into (sorted-map)
        (for [[ns file] shipped]
          (let [d (defines file)
                boot (if (= ns 'clojure.core) bootstrap-macros #{})
                public (into (sorted-set) (concat boot (map key (remove (comp :private val) d))))
                macros (into (sorted-set) (concat boot (map key (filter (comp :macro val) d))))
                theirs (some-> (compared-with ns) clojure-publics)]
            [ns (cond-> {:file file
                         :present public
                         :macros macros
                         :count (count public)}
                  theirs (assoc :absent (into (sorted-set) (remove public theirs))
                                :extra (into (sorted-set) (remove theirs public))
                                :compared-with (compared-with ns)))]))))

(def out (io/file root "doc/manifest.edn"))
(.mkdirs (.getParentFile out))
(spit out
      (str ";; GENERATED by bin/manifest -- do not edit.\n"
           ";; `test/manifest.clj` regenerates this and fails if it differs, and\n"
           ";; separately asserts that every var listed under :present really is\n"
           ";; callable from a compiled module.\n"
           (with-out-str (clojure.pprint/pprint manifest))))
(println "wrote" (str out))
(doseq [[ns m] manifest]
  (println (format "  %-18s %4d present  %4d absent  %3d extra  %3d macros"
                   ns (:count m) (count (:absent m)) (count (:extra m)) (count (:macros m)))))
