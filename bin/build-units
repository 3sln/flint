#!/bin/sh
# Compile each namespace unit to a relocatable wasm object, and emit its
# manifest. No cargo on the compile path: `flint` only links these.
set -e
cd "$(dirname "$0")/.."
# rustup's nightly carries the wasm32 target and the sysroot these objects link
# against. Resolve it through rustup rather than naming a host triple: the same
# script has to run on a developer's macOS box and on a Linux CI runner.
#
# PINNED, not the rolling `nightly` alias (DECISIONS.md#pin-the-nightly-toolchain):
# an unpinned nightly fetched the day it runs, and a nightly between
# 2026-06-01 and 2026-09-01 changed where a build-script-bearing dependency's
# own rlib lands under `--target wasm32-unknown-unknown` (into its OWN
# `build/<crate>/<hash>/out/`, not `release/deps/`). `rlib()` below no longer
# assumes `deps/` -- see the cargo build below, which reads cargo's own
# `--message-format=json` artifact list and copies whatever it finds into
# `$DEPS`, wherever cargo actually put it (`bin/cargo-artifacts.py`).
NIGHTLY="$(cat "$(dirname "$0")/nightly-toolchain")"
RUSTC="$(rustup which --toolchain "$NIGHTLY" rustc 2>/dev/null)" || RUSTC=""
if [ -z "$RUSTC" ]; then
  echo "no $NIGHTLY rustc: install it with"
  echo "  rustup toolchain install $NIGHTLY --profile minimal"
  echo "  rustup target add wasm32-unknown-unknown --toolchain $NIGHTLY"
  exit 1
fi
TC="$(dirname "$(dirname "$RUSTC")")"
SYS="$TC/lib/rustlib/wasm32-unknown-unknown/lib"
if [ ! -d "$SYS" ]; then
  echo "$NIGHTLY has no wasm32-unknown-unknown std at $SYS"
  echo "  rustup target add wasm32-unknown-unknown --toolchain $NIGHTLY"
  exit 1
fi
DEPS=target/wasm32-unknown-unknown/release/deps

# Which build this invocation is, decided BEFORE the flags below are built --
# the two builds choose different flags, not just different `--cfg`s, so the
# choice has to exist first (DECISIONS.md#two-builds).
DIAG=""
AOT=""
for arg in "$@"; do
  case "$arg" in
    --diagnostics) DIAG=1 ;;
    --aot) AOT=1 ;;
  esac
done

# REMAP, not restated: `bin/rust-remap-flags` is the one definition of the
# checkout-path and cargo-registry-path remap (DECISIONS.md#reproducible-build-paths).
# Appending it to every direct rustc call is a safe no-op where the call's own
# sources already use repo-relative paths (`units-src/.../lib.rs`), since the
# FROM prefix then never appears in what gets embedded, and it is what fixes
# the cargo-built dependency rlibs (`flint_rt`, `serde_json`, `htmlparser`...)
# that the `cargo build` below links into every one of them.
#
# A production build also drops the panic-location machinery itself via
# `bin/rust-release-flags` (`-Zlocation-detail=none`), so no `.rs` path
# remains at all, not just an unidentifying one. The DIAGNOSTICS build keeps
# `bin/rust-remap-flags` alone -- a crash location is the point of it
# (DECISIONS.md#reproducible-build-paths). This runs under the pinned nightly
# `rustc` unconditionally already (the wasm32 target demands it), so the
# unstable `-Z` flag needs no extra toolchain plumbing here, unlike the
# native release build sites.
REMAP="$(./bin/rust-remap-flags)"
if [ -n "$DIAG" ]; then
  RELFLAGS="$REMAP"
else
  RELFLAGS="$(./bin/rust-release-flags)"
fi
export RUSTFLAGS="$RELFLAGS ${RUSTFLAGS:-}"
FLAGS="--target wasm32-unknown-unknown --edition 2021 -C opt-level=3 -C panic=abort -C debuginfo=0 $RELFLAGS"

# Two builds (DECISIONS.md#two-builds). A production module carries NO diagnostic
# machinery -- absent, not disabled -- so it is a cargo feature rather than a
# runtime flag. `--diagnostics` builds the instrumented runtime and the units
# that need it.
if [ -n "$DIAG" ]; then
  FLAGS="$FLAGS --cfg feature=\"diagnostics\""
  echo "  (diagnostics build)"
fi
# Compiled arities (DECISIONS.md#emit-wasm-instead-of-dispatch). Absent by default for the same
# reason diagnostics are: measured at 7 002 bytes of production module, for
# machinery a module without compiled code never runs.
if [ -n "$AOT" ]; then
  FLAGS="$FLAGS --cfg feature=\"aot\""
  echo "  (aot build)"
fi
mkdir -p out units/.sysroot

# WHICH BUILD IS IN THE TREE, recorded where anything can read it. A
# diagnostics units tree is not a broken one, it is a DIFFERENT one -- it
# carries `stat_heap_used`, `set_gc_verify_remset` and the rest -- and
# everything measured against it afterwards means something else. Nothing used
# to say which was there.
#
# Written BEFORE the build, not after, and that direction is the point: a
# build that is killed half way has left diagnostics units behind, and the
# stamp must already say so. Recording it on success would leave the stamp
# reading `production` over a tree that is no longer production -- silent, and
# in the flattering direction.
#
# This happened: `bin/test-diagnostics` was killed between its build and its
# restore, and the only reason it was noticed is that the restore is the line
# after. `bin/check` reads this.
if [ -n "$DIAG" ]; then echo diagnostics > units/.build-mode
else echo production > units/.build-mode
fi

# cargo builds the DEPENDENCY rlibs once (serde_json, xmlparser, htmlparser and
# their transitive deps). Unit objects themselves are emitted by rustc below, so
# a `flint` invocation never runs cargo.
echo "  dependencies (cargo, once)"
# The excludes are the HOST crates. `flint-cli` embeds a compiler and reads
# files; `flint` is the Rust SDK and does the same; `flint-c` is that SDK's C
# ABI; `flint-native-abi` is the archive a `:to :llvm` artifact links against,
# which is a native `staticlib` by definition. None can be built for wasm32,
# and a workspace-wide build tries -- so the exclusion is not a preference, it
# is the difference between this working and not.
# NOT silenced. This used to be `>/dev/null 2>&1`, and when a host-only binary
# was added to a unit crate without `required-features`, cargo failed here,
# `set -e` ended the script, and `bin/build-dist` printed "==> production units"
# and stopped -- with dist/ still holding yesterday's artifacts, looking current.
# A build step that can fail has to be able to say why.
# `--message-format=json-render-diagnostics`, not a plain log: the artifact
# list below is what makes `rlib()` independent of where cargo decides to put
# an rlib, and the rendered text in each `compiler-message` is what a real
# error looks like regardless of how many warnings sort after it (the CI
# incident this decision records: 52 warnings, then the real `error[...]`
# scrolled off a plain `tail -20`).
if ! PATH="$TC/bin:$PATH" cargo build --release --target wasm32-unknown-unknown \
       --workspace --exclude flint-cli --exclude flint --exclude flint-c \
       --exclude flint-native-abi \
       --message-format=json-render-diagnostics \
       > /tmp/flint-units-cargo.json 2>/tmp/flint-units-cargo.stderr; then
  echo "  the dependency build FAILED:"
  python3 bin/cargo-artifacts.py diagnostics /tmp/flint-units-cargo.json | tail -60
  sed 's/^/    /' /tmp/flint-units-cargo.stderr | tail -30
  exit 1
fi
# Copy every rlib cargo reported, wherever it actually put it, into $DEPS --
# so `rlib()` below (and `bin/build-test-unit`'s own `-L $DEPS`) see it under
# the one directory both already searched by convention, instead of each
# needing to know cargo's current layout (DECISIONS.md#pin-the-nightly-toolchain,
# "Risk left open").
mkdir -p "$DEPS"
python3 bin/cargo-artifacts.py rlibs /tmp/flint-units-cargo.json "$DEPS"

rlib() { ls "$DEPS"/lib$1-*.rlib 2>/dev/null | head -1; }
# `--extern NAME=<path>` wants THIS, not `rlib()`, for a build-script-bearing
# dependency on this nightly: cargo now writes its `.rlib` as a METADATA STUB
# (real compiled object code, but a placeholder metadata section) and the
# FULL metadata only into the sibling `.rmeta` cargo-artifacts.py copied
# alongside it -- confirmed by rustc's own error without this, "only metadata
# stub found for `rlib` dependency `libm` please provide path to the
# corresponding .rmeta file with full metadata". `rlib()` itself still has to
# return the real `.rlib`: that is what the final link step needs (rust-lld
# reads compiled object code, not rustc's metadata format, so a stub there is
# fine), and what gets copied into a unit's `.libs/` below.
metalib() {
  m=$(ls "$DEPS"/lib$1-*.rmeta 2>/dev/null | head -1)
  if [ -n "$m" ]; then echo "$m"; else rlib "$1"; fi
}

# Units are laid out by NAMESPACE, the way :src lays out source, so that
# `units/` is just the default entry on the :wasm-path search path rather than a
# second mechanism:  flint.data.json -> <dir>/flint/data/json.{unit.edn,o,libs/}
echo "  flint.rt"
mkdir -p units/flint
LIBM=$(metalib libm)
$RUSTC $FLAGS --crate-type rlib --crate-name flint_rt --extern libm="$LIBM" \
  --emit=obj runtime/src/lib.rs -o units/flint/rt.o
$RUSTC $FLAGS --crate-type rlib --crate-name flint_rt --extern libm="$LIBM" \
  --emit=link runtime/src/lib.rs -o units/flint/libflint_rt.rlib
# REMAP ONLY, not $RELFLAGS: this is a HOST binary (the catalogue generator,
# `host-tools`), built by whatever cargo is on PATH by default -- stable, not
# the pinned nightly $RUSTC resolved above -- and `-Zlocation-detail=none` is
# unstable, so stable rustc refuses it outright ("the option `Z` is only
# accepted on the nightly compiler"). Found by running this exact line by
# hand after `bin/build-dist` died here with no visible error (its stderr
# does not reach the log when stdout alone is redirected past `cargo run`'s
# own `-q`, which is itself the thing to watch out for next time this goes
# quiet). This generator is not shipped, so it has no reason to carry
# `-Zlocation-detail=none` at all -- only the remap, for the same cache
# reason `bin/build-cli`'s header gives.
RUSTFLAGS="$REMAP" cargo run -q -p flint-rt --features host-tools --bin catalogue > units/flint/rt.unit.edn
# The diagnostic edge lives on the runtime unit, so only this build declares it
# and `flint` needs no flag of its own.
if [ -n "$DIAG" ]; then
  python3 bin/diag-exports.py units/flint/rt.unit.edn
fi
if [ -n "$AOT" ]; then
  python3 bin/aot-exports.py units/flint/rt.unit.edn
fi

# One parser unit per namespace. Each is its own object AND carries its own
# dependency rlibs, so linking a program that never mentions XML never puts
# xmlparser on the link line at all.
build_parser() {          # name path crate_dir crate_name symbol clj_name deps...
  name=$1; path=$2; dir=$3; crate=$4; sym=$5; provides=$6; shift 6
  echo "  $name"
  base="units/$path"
  mkdir -p "$(dirname "$base")" "$base.libs"
  rm -f "$base.libs"/*.rlib
  EXTERNS="--extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS"
  for d in "$@"; do
    r=$(metalib "$d")
    if [ -n "$r" ]; then EXTERNS="$EXTERNS --extern $d=$r"; fi
  done
  # Every rlib the unit or its dependencies need lives beside the unit, so the
  # link line for a program that never mentions this namespace never sees them.
  for d in "$@" serde serde_core memchr itoa zmij htmlparser xmlparser; do
    r=$(rlib "$d"); if [ -n "$r" ]; then cp "$r" "$base.libs/" 2>/dev/null || true; fi
  done
  $RUSTC $FLAGS --crate-type rlib --crate-name "$crate" $EXTERNS \
    --emit=obj "$dir/src/lib.rs" -o "$base.o"
  cat > "$base.unit.edn" <<UNIT
{:flint/unit 1
 :name $name
 :kind :wasm-object
 :artifact "$(basename "$path").o"
 :libs "$(basename "$path").libs"
 :requires [flint.rt]
 :abi {:runtime 1 :value 1 :image 1}
 :provides {"$provides" {:symbol "$sym"}}}
UNIT
}

# The concurrency unit: green threads, ports, the scheduler, and the host-facing
# exports that let a host answer a parked thread. A unit like any other, so a
# program that never spawns or opens never links it (DECISIONS.md#threads-and-ports).
echo "  flint.conc"
mkdir -p units/flint
$RUSTC $FLAGS --crate-type rlib --crate-name flint_conc \
  --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
  --emit=obj units-src/flint-conc/src/lib.rs -o units/flint/conc.o
# REMAP ONLY -- see the identical note on the catalogue generator above.
RUSTFLAGS="$REMAP" cargo run -q -p flint-conc --features host-tools --bin manifest > units/flint/conc.unit.edn

# The snapshot unit (DECISIONS.md#snapshots). Capture and restore live in the
# runtime; this carries the host-facing surface, so a program that never asks
# for a snapshot never links one and the pure-module floor is untouched.
if [ -n "$DIAG" ]; then
echo "  flint.snapshot"
$RUSTC $FLAGS --crate-type rlib --crate-name flint_snap \
  --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
  --emit=obj units-src/flint-snap/src/lib.rs -o units/flint/snapshot.o
cat > units/flint/snapshot.unit.edn <<'UNIT'
{:flint/unit 1
 :name flint.snapshot
 :kind :wasm-object
 :artifact "snapshot.o"
 :requires [flint.rt]
 :abi {:runtime 1 :value 1 :image 1}
 :exports ["flint_snapshot_capture" "flint_snapshot_ptr" "flint_snapshot_alloc" "flint_snapshot_restore" "flint_snapshot_refused" "flint_image_fingerprint" "flint_snapshot_export" "flint_snapshot_import" "flint_snapshot_export_and_stop" "flint_snapshot_stopped"]
 :provides {"flint/snapshot" {:symbol "flint_b_snapshot"}
            "flint/snapshot-size" {:symbol "flint_b_snapshot_size"}
            "flint/snapshot-restore" {:symbol "flint_b_snapshot_restore"}}}
UNIT
else
  # A production build must not leave a linkable snapshot unit behind: absent is
  # a different guarantee from disabled (DECISIONS.md#two-builds).
  rm -f units/flint/snapshot.o units/flint/snapshot.unit.edn
fi

build_parser flint.data.json flint/data/json units-src/flint-data-json flint_data_json \
  flint_b_json_parse "flint/json-parse" serde serde_json
build_parser flint.data.xml flint/data/xml units-src/flint-data-xml flint_data_xml \
  flint_b_xml_parse "flint/xml-parse" xmlparser
build_parser flint.data.html flint/data/html units-src/flint-data-html flint_data_html \
  flint_b_html_parse "flint/html-parse" htmlparser

cp "$SYS"/libcore-*.rlib "$SYS"/liballoc-*.rlib "$SYS"/libcompiler_builtins-*.rlib \
   "$SYS"/librustc_std_workspace_core-*.rlib units/.sysroot/ 2>/dev/null || true
# The REAL `.rlib` (`rlib()`, not `metalib()`): this is what `flint.compiler.link`'s
# own final link step needs (real compiled object code), not metadata --
# copying the metadata-only `.rmeta` here left `trunc`/`cos`/`sin`/... all
# undefined at that later link, found building `dist/flint-loader.wasm`.
cp "$(rlib libm)" units/.sysroot/ 2>/dev/null || true

# THE READER MODULE (`DECISIONS.md#namespaces-over-the-system-port`): the kin
# reader and forms encoder alone, for a JavaScript host that has to read source
# outside the compiler sandbox. Not a unit -- no manifest, no builtin, linked
# into no program -- so it is linked HERE, by rust-lld directly, into
# `units/.reader/flint-reader.wasm`, which `bin/build-dist` copies to `dist/`.
# Production builds only: a diagnostics or AOT runtime is a different reader
# module, and `dist/` carries one.
if [ -z "$DIAG" ] && [ -z "$AOT" ]; then
  echo "  flint-reader.wasm"
  mkdir -p units/.reader
  $RUSTC $FLAGS --crate-type rlib --crate-name flint_reader \
    --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
    --emit=obj units-src/flint-reader/src/lib.rs -o units/.reader/reader.o
  LLD=$(ls "$TC"/lib/rustlib/*/bin/rust-lld 2>/dev/null | head -1)
  if [ -z "$LLD" ]; then echo "no rust-lld under $TC/lib/rustlib"; exit 1; fi
  # This pinned nightly's `rust-lld` dynamically links against a shared
  # `libLLVM.dylib`/`.so` at the TOOLCHAIN ROOT's own `lib/` -- its `LC_RPATH`
  # (`@loader_path/../lib`) resolves to `lib/rustlib/<triple>/lib`, which does
  # not exist. `rustc` sets this up itself before running `rust-lld` as its
  # own linker subprocess; a direct call, as this always was, needs it set by
  # hand (`src/flint/compiler/link.cljc`'s `lld-env` needed the identical fix for the
  # compiler's own direct `rust-lld` call).
  export DYLD_LIBRARY_PATH="$TC/lib:${DYLD_LIBRARY_PATH:-}"
  export LD_LIBRARY_PATH="$TC/lib:${LD_LIBRARY_PATH:-}"
  # The same stack placement every flint module gets (`flint.compiler.link/link-objects`
  # says why: an overflow must trap at address zero, not scribble the statics).
  #
  # `runtime/wasm-imports.txt` is the ONE list of symbols `units/flint/rt.o` leaves
  # undefined ON PURPOSE -- `flint_panic`, the wasm panic-message import
  # (`DECISIONS.md#panic-message-import`) -- read directly by this call and by
  # `flint.compiler.link/link-objects`'s own `--allow-undefined-file`, rather
  # than restated in each (AGENTS.md sec. 1). Without it `rust-lld` refuses the
  # link outright ("undefined symbol: flint_panic"): an undefined FUNCTION is
  # not an import by default, only one this flag names is.
  "$LLD" -flavor wasm --no-entry --gc-sections --strip-all \
    -z stack-size=1048576 --stack-first \
    --export=flint_reader_in --export=flint_reader_read \
    --export=flint_reader_out_ptr --export=flint_reader_out_len \
    --allow-undefined-file=runtime/wasm-imports.txt \
    -o units/.reader/flint-reader.wasm \
    units/.reader/reader.o units/flint/rt.o units/.sysroot/*.rlib \
    > units/.reader/link.log 2>&1 || { sed 's/^/    /' units/.reader/link.log | grep -v 'neither Wasm object' | tail -30; exit 1; }
fi

find units -name "*.unit.edn" | sed 's/^/  /'
