#!/bin/sh
# Compile each namespace unit to a relocatable wasm object, and emit its
# manifest. No cargo on the compile path: `flint` only links these.
set -e
cd "$(dirname "$0")/.."
# rustup's nightly carries the wasm32 target and the sysroot these objects link
# against. Resolve it through rustup rather than naming a host triple: the same
# script has to run on a developer's macOS box and on a Linux CI runner.
RUSTC="$(rustup which --toolchain nightly rustc 2>/dev/null)" || RUSTC=""
if [ -z "$RUSTC" ]; then
  echo "no nightly rustc: install it with"
  echo "  rustup toolchain install nightly"
  echo "  rustup target add wasm32-unknown-unknown --toolchain nightly"
  exit 1
fi
TC="$(dirname "$(dirname "$RUSTC")")"
SYS="$TC/lib/rustlib/wasm32-unknown-unknown/lib"
if [ ! -d "$SYS" ]; then
  echo "nightly has no wasm32-unknown-unknown std at $SYS"
  echo "  rustup target add wasm32-unknown-unknown --toolchain nightly"
  exit 1
fi
DEPS=target/wasm32-unknown-unknown/release/deps
FLAGS="--target wasm32-unknown-unknown --edition 2021 -C opt-level=3 -C panic=abort -C debuginfo=0"

# Two builds (doc/decisions/0016). A production module carries NO diagnostic
# machinery -- absent, not disabled -- so it is a cargo feature rather than a
# runtime flag. `--diagnostics` builds the instrumented runtime and the units
# that need it.
DIAG=""
if [ "$1" = "--diagnostics" ]; then
  DIAG=1
  FLAGS="$FLAGS --cfg feature=\"diagnostics\""
  echo "  (diagnostics build)"
fi
mkdir -p out units/.sysroot

# cargo builds the DEPENDENCY rlibs once (serde_json, xmlparser, htmlparser and
# their transitive deps). Unit objects themselves are emitted by rustc below, so
# a `flint` invocation never runs cargo.
echo "  dependencies (cargo, once)"
PATH="$TC/bin:$PATH" cargo build --release --target wasm32-unknown-unknown >/dev/null 2>&1

rlib() { ls "$DEPS"/lib$1-*.rlib 2>/dev/null | head -1; }

# Units are laid out by NAMESPACE, the way :src lays out source, so that
# `units/` is just the default entry on the :wasm-path search path rather than a
# second mechanism:  flint.data.json -> <dir>/flint/data/json.{unit.edn,o,libs/}
echo "  flint.rt"
mkdir -p units/flint
LIBM=$(rlib libm)
$RUSTC $FLAGS --crate-type rlib --crate-name flint_rt --extern libm="$LIBM" \
  --emit=obj runtime/src/lib.rs -o units/flint/rt.o
$RUSTC $FLAGS --crate-type rlib --crate-name flint_rt --extern libm="$LIBM" \
  --emit=link runtime/src/lib.rs -o units/flint/libflint_rt.rlib
cargo run -q -p flint-rt --features host-tools --bin catalogue > units/flint/rt.unit.edn
# The diagnostic edge lives on the runtime unit, so only this build declares it
# and `flint` needs no flag of its own.
if [ -n "$DIAG" ]; then
  python3 bin/diag-exports.py units/flint/rt.unit.edn
fi

# One parser unit per namespace. Each is its own object AND carries its own
# dependency rlibs, so linking a program that never mentions XML never puts
# xmlparser on the link line at all.
build_parser() {          # name path crate_dir crate_name symbol clj_name deps...
  name=$1; path=$2; dir=$3; crate=$4; sym=$5; provides=$6; shift 6
  echo "  $name"
  base="units/$path"
  mkdir -p "$(dirname "$base")" "$base.libs"
  rm -f "$base.libs"/*.rlib
  EXTERNS="--extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS"
  for d in "$@"; do
    r=$(rlib "$d")
    if [ -n "$r" ]; then EXTERNS="$EXTERNS --extern $d=$r"; fi
  done
  # Every rlib the unit or its dependencies need lives beside the unit, so the
  # link line for a program that never mentions this namespace never sees them.
  for d in "$@" serde serde_core memchr itoa zmij htmlparser xmlparser; do
    r=$(rlib "$d"); if [ -n "$r" ]; then cp "$r" "$base.libs/" 2>/dev/null || true; fi
  done
  $RUSTC $FLAGS --crate-type rlib --crate-name "$crate" $EXTERNS \
    --emit=obj "$dir/src/lib.rs" -o "$base.o"
  cat > "$base.unit.edn" <<UNIT
{:flint/unit 1
 :name $name
 :kind :wasm-object
 :artifact "$(basename "$path").o"
 :libs "$(basename "$path").libs"
 :requires [flint.rt]
 :abi {:runtime 1 :value 1 :image 1}
 :provides {"$provides" {:symbol "$sym"}}}
UNIT
}

# The concurrency unit: green threads, ports, the scheduler, and the host-facing
# exports that let a host answer a parked thread. A unit like any other, so a
# program that never spawns or opens never links it (doc/decisions/0005).
echo "  flint.conc"
mkdir -p units/flint
$RUSTC $FLAGS --crate-type rlib --crate-name flint_conc \
  --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
  --emit=obj units-src/flint-conc/src/lib.rs -o units/flint/conc.o
cargo run -q -p flint-conc --features host-tools --bin manifest > units/flint/conc.unit.edn

# The snapshot unit (doc/decisions/0015). Capture and restore live in the
# runtime; this carries the host-facing surface, so a program that never asks
# for a snapshot never links one and the pure-module floor is untouched.
if [ -n "$DIAG" ]; then
echo "  flint.snapshot"
$RUSTC $FLAGS --crate-type rlib --crate-name flint_snap \
  --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
  --emit=obj units-src/flint-snap/src/lib.rs -o units/flint/snapshot.o
cat > units/flint/snapshot.unit.edn <<'UNIT'
{:flint/unit 1
 :name flint.snapshot
 :kind :wasm-object
 :artifact "snapshot.o"
 :requires [flint.rt]
 :abi {:runtime 1 :value 1 :image 1}
 :exports ["flint_snapshot_capture" "flint_snapshot_ptr" "flint_snapshot_alloc" "flint_snapshot_restore"]
 :provides {"flint/snapshot" {:symbol "flint_b_snapshot"}
            "flint/snapshot-size" {:symbol "flint_b_snapshot_size"}
            "flint/snapshot-restore" {:symbol "flint_b_snapshot_restore"}}}
UNIT
else
  # A production build must not leave a linkable snapshot unit behind: absent is
  # a different guarantee from disabled (doc/decisions/0016).
  rm -f units/flint/snapshot.o units/flint/snapshot.unit.edn
fi

build_parser flint.data.json flint/data/json units-src/flint-data-json flint_data_json \
  flint_b_json_parse "flint/json-parse" serde serde_json
build_parser flint.data.xml flint/data/xml units-src/flint-data-xml flint_data_xml \
  flint_b_xml_parse "flint/xml-parse" xmlparser
build_parser flint.data.html flint/data/html units-src/flint-data-html flint_data_html \
  flint_b_html_parse "flint/html-parse" htmlparser

cp "$SYS"/libcore-*.rlib "$SYS"/liballoc-*.rlib "$SYS"/libcompiler_builtins-*.rlib \
   "$SYS"/librustc_std_workspace_core-*.rlib units/.sysroot/ 2>/dev/null || true
cp "$LIBM" units/.sysroot/ 2>/dev/null || true

find units -name "*.unit.edn" | sed 's/^/  /'
