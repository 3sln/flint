#!/bin/sh
# The toy unit `test/unitpath.clj` puts on the :wasm-path search path. Kept out of
# `units/` deliberately: the point of the test is that a unit flint did not ship
# links exactly like one it did.
set -e
cd "$(dirname "$0")/.."
# rustup's nightly carries the wasm32 target and the sysroot these objects link
# against. Resolve it through rustup rather than naming a host triple: the same
# script has to run on a developer's macOS box and on a Linux CI runner.
RUSTC="$(rustup which --toolchain nightly rustc 2>/dev/null)" || RUSTC=""
if [ -z "$RUSTC" ]; then
  echo "no nightly rustc: install it with"
  echo "  rustup toolchain install nightly"
  echo "  rustup target add wasm32-unknown-unknown --toolchain nightly"
  exit 1
fi
TC="$(dirname "$(dirname "$RUSTC")")"
SYS="$TC/lib/rustlib/wasm32-unknown-unknown/lib"
if [ ! -d "$SYS" ]; then
  echo "nightly has no wasm32-unknown-unknown std at $SYS"
  echo "  rustup target add wasm32-unknown-unknown --toolchain nightly"
  exit 1
fi
RUSTC="$TC/bin/rustc"
FLAGS="--target wasm32-unknown-unknown --edition 2021 -C opt-level=3 -C panic=abort -C debuginfo=0"
DEPS=target/wasm32-unknown-unknown/release/deps
OUT=test/fixtures/wasm-path/demo
[ -f units/flint/libflint_rt.rlib ] || { echo "run bin/build-units first"; exit 1; }
mkdir -p "$OUT"
$RUSTC $FLAGS --crate-type rlib --crate-name flint_demo_shout \
  --extern flint_rt=units/flint/libflint_rt.rlib -L $DEPS \
  --emit=obj units-src/flint-demo-shout/src/lib.rs -o "$OUT/shout.o"
cat > "$OUT/shout.unit.edn" <<'UNIT'
{:flint/unit 1
 :name demo.shout
 :kind :wasm-object
 :artifact "shout.o"
 :requires [flint.rt]
 :abi {:runtime 1 :value 1 :image 1}
 :provides {"demo-shout" {:symbol "flint_b_demo_shout"}}}
UNIT
# The same unit with an ABI flint cannot link, for the refusal test.
mkdir -p test/fixtures/wasm-path-bad/demo
cp "$OUT/shout.o" test/fixtures/wasm-path-bad/demo/shout.o
sed 's/:abi {:runtime 1/:abi {:runtime 2/' "$OUT/shout.unit.edn" \
  > test/fixtures/wasm-path-bad/demo/shout.unit.edn
cp "$OUT/shout.cljc" test/fixtures/wasm-path-bad/demo/shout.cljc
echo "  $OUT/shout.unit.edn"
echo "  test/fixtures/wasm-path-bad/demo/shout.unit.edn (abi :runtime 2, refused)"
