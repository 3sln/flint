#!/bin/sh
# The image-per-call shape across engines (doc/decisions/0018, 0021, 0023).
#
# A resident loader instantiated once, an image loaded per call. This is what
# flint's first real consumer deploys, and under a Worker isolate's 128 MiB
# ceiling the numbers that matter are instantiation cost and peak memory rather
# than steady-state throughput.
#
# workerd is used if present. Set WORKERD to point at a binary; the default is
# where `npm install workerd` puts one.
set -e
cd "$(dirname "$0")/.."
echo "building the loader and two images"
./bin/flint :src bench/xrt :src bench/construe/gen \
  :fn construe.bench.xrt25/main :out out/xrt-loader.wasm --loader >/dev/null
./bin/flint :src bench/xrt :src bench/construe/gen \
  :fn construe.bench.xrt25/main :out out/xrt.image --emit-image >/dev/null
./bin/flint :src bench/xrt :src bench/construe/gen \
  :fn construe.bench.xrt0/main :out out/xrt0.image --emit-image >/dev/null
cp out/xrt-loader.wasm out/xrt.image out/xrt0.image bench/workerd/
node bench/ximage.mjs "$@"
echo
echo "per-call latency distribution -- a Worker has a CPU budget per REQUEST,"
echo "so the tail is what decides whether a deployment works, not the mean."
echo
printf '%-30s %s\n' "engine / image" "p50 / p90 / p99 / max (us)"
for eng in node bun; do
  command -v "$eng" >/dev/null 2>&1 || continue
  printf '%-30s ' "$eng, no work"
  "$eng" bench/xtail.mjs out/xrt-loader.wasm out/xrt0.image 3000
  printf '%-30s ' "$eng, +25 iterations"
  "$eng" bench/xtail.mjs out/xrt-loader.wasm out/xrt.image 400
done
echo
echo "  flint brings its own collector inside the wasm heap, so a pause is flint's"
echo "  rather than the engine's. The tail is TIGHTER under allocation-heavy load"
echo "  than at idle, because the nursery collects little and often rather than"
echo "  rarely and at length."
