#!/bin/sh
# The host-provides-the-runtime proof of concept, wasm half
# (`DECISIONS.md#the-host-provides-the-runtime`). Needs `bin/build-dist` and
# `cargo build --release -p flint-cli` run first, in that order (AGENTS.md sec. 3).
set -e
cd "$(dirname "$0")/../.."
OUT=out/host-runtime
mkdir -p $OUT/src/triv $OUT/src/json
printf '(ns t) (defn main [_] "hi")\n' > $OUT/src/triv/t.cljc
cat > $OUT/src/json/j.cljc <<'CLJ'
(ns j (:require [flint.data.json :as json]))
(defn main [_]
  (let [doc (json/read-str "{\"a\": [1, 2, 3.5, {\"b\": null, \"c\": \"x\"}], \"d\": true}")]
    (str (get-in doc ["a" 3 "c"]) " " (count (get doc "a")) " " (json/write-str (get doc "a")))))
CLJ
PROGS="triv:$OUT/src/triv:t nqueens:corpus:nqueens words:corpus:words lzw:corpus:lzw sudoku:corpus:sudoku json:$OUT/src/json:j"
ARGS=""
for p in $PROGS; do
  name=${p%%:*}; rest=${p#*:}; dir=${rest%%:*}; ns=${rest#*:}
  ./target/release/flint compile :path "$dir" :fn "$ns/main" :to :wasm :out $OUT/$name.wasm > /dev/null
  ./target/release/flint compile :path "$dir" :fn "$ns/main" :to :wasm :optimize '[perf]' :out $OUT/$name.perf.wasm > /dev/null
  ARGS="$ARGS $name=$ns/main"
done
node bench/host-runtime/poc.mjs $OUT $ARGS
