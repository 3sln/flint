    internal const long NIL = 0xFFFFL;
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal static bool IsDouble(long v) { return (v >> 60) == 2; }
        internal static long OfDouble(double d) { return 0x2000000000000000L | (((long) (d * 2.0)) & 0xFF); }
    }
    internal static long Fix(long n) { return 0x1000000000000000L | (n & 0x0FFFFFFFFFFFFFFFL); }
    internal static long Big(long i) { return 0x3000000000000000L | i; }
    internal static long Dbl(long i) { return 0x2000000000000000L | i; }
    internal sealed class Rt {
        internal string thrown = "";
        internal long[] boxes = { long.MinValue, -1, 7 };
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return NIL; }
    }
    internal static class Num {
        internal static bool IsInt(Rt rt, long v) { return (v >> 60) == 1 || (v >> 60) == 3; }
        internal static long I64Of(Rt rt, long v) {
            if ((v >> 60) == 3) return rt.boxes[(int) (v & 0xFF)];
            return (v << 4) >> 4;
        }
        internal static bool IsNumber(Rt rt, long v) { return IsInt(rt, v) || Val.IsDouble(v); }
        internal static double F64(Rt rt, long v) {
            if (Val.IsDouble(v)) return (v & 0xFF) / 2.0;
            return (double) I64Of(rt, v);
        }
        internal static long Integer(Rt rt, long n) { return Fix(n); }
        internal static double Trunc(double d) { return d < 0 ? System.Math.Ceiling(d) : System.Math.Floor(d); }
        internal static long NotNumber(Rt rt, long a, long b) {
            rt.thrown = "ClassCastException/not a number"; return NIL;
        }
    }
    internal static string Show(Rt rt, long v) {
        if (v == NIL) return "!";
        if (Val.IsDouble(v)) return "d" + Fmt(Num.F64(rt, v));
        return "i" + Num.I64Of(rt, v);
    }
    internal static string Fmt(double d) {
        if (d == System.Math.Round(d) && !double.IsInfinity(d)) return ((long) d).ToString();
        return d.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
