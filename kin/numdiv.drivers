--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
struct Rt { thrown: String, boxes: Vec<i64> }
// `f-trunc` resolves to `crate::fmath::trunc`, so the probe declares that
// module rather than a bare function.
pub mod fmath { pub fn trunc(d: f64) -> f64 { if d < 0.0 { libm_ceil(d) } else { libm_floor(d) } }
    fn libm_floor(d: f64) -> f64 { let t = d as i64 as f64; if t > d { t - 1.0 } else { t } }
    fn libm_ceil(d: f64) -> f64 { let t = d as i64 as f64; if t < d { t + 1.0 } else { t } } }
// A FIXNUM holds its value; a BIGINT is an index into `boxes`, so the probe
// can hand `is-int` a value that is not a fixnum and still get a real number
// out of `i64-of` -- which is the pair that replaced `Option<i64>`.
impl Value {
    fn is_double(self) -> bool { (self.0 >> 60) == 2 }
}
fn fix(n: i64) -> Value { Value(0x1000_0000_0000_0000u64 | (n as u64 & 0x0FFF_FFFF_FFFF_FFFF)) }
fn big(i: u64) -> Value { Value(0x3000_0000_0000_0000u64 | i) }
fn dbl(i: u64) -> Value { Value(0x2000_0000_0000_0000u64 | i) }
impl Rt {
    fn is_int(&self, v: Value) -> bool { (v.0 >> 60) == 1 || (v.0 >> 60) == 3 }
    fn i64_of(&self, v: Value) -> i64 {
        if (v.0 >> 60) == 3 { return self.boxes[(v.0 & 0xFF) as usize]; }
        ((v.0 & 0x0FFF_FFFF_FFFF_FFFF) << 4) as i64 >> 4
    }
    fn is_number(&self, v: Value) -> bool { self.is_int(v) || v.is_double() }
    fn both_ints(&mut self, a: Value, b: Value) -> bool { self.is_int(a) && self.is_int(b) }
    fn num_f64(&self, v: Value) -> f64 {
        if v.is_double() { return (v.0 & 0xFF) as f64 / 2.0; }
        self.i64_of(v) as f64
    }
    // The ANSWERS are tagged so the probe can tell an integer result from a
    // double one without a printer.
    fn integer(&mut self, n: i64) -> Value { fix(n) }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn throw_not_a_number(&mut self, _a: Value, _b: Value) -> Value {
        self.thrown = alloc::string::String::from("ClassCastException/not a number"); NIL
    }
}
impl Value {
    fn from_f64(d: f64) -> Value { Value(0x2000_0000_0000_0000u64 | ((d * 2.0) as i64 as u64 & 0xFF)) }
}
impl Rt {
--rust
}
extern crate alloc;
fn show(rt: &Rt, v: Value) -> String {
    if v.0 == NIL.0 { return String::from("!"); }
    if v.is_double() { return format!("d{}", rt.num_f64(v)); }
    format!("i{}", rt.i64_of(v))
}
fn main() {
    // Index 0 is the MOST NEGATIVE integer, reached as a BIGINT so that the
    // `is-int`/`i64-of` pair is what finds it -- the shape both ports used to
    // get wrong by asking `isFixnum` instead.
    let mut rt = Rt { thrown: String::new(), boxes: vec![i64::MIN, -1, 7] };
    let mut o = String::new();
    let min = big(0);
    let neg1 = fix(-1);

    // THE EDGE, on every operation that has one.
    for (name, which) in [("div", 0), ("quot", 1), ("rem", 2), ("neg", 3)] {
        rt.thrown.clear();
        let r = match which {
            0 => rt.num_div(min, neg1),
            1 => rt.num_quot(min, neg1),
            2 => rt.num_rem(min, neg1),
            _ => rt.num_neg(min),
        };
        let shown = show(&rt, r);
        o.push_str(&format!("{}={}|{}| ", name, shown, rt.thrown));
    }

    // DIVIDE BY ZERO is a DIFFERENT refusal and comes first.
    rt.thrown.clear();
    let z = rt.num_div(fix(7), fix(0));
    let s_z = show(&rt, z);
    o.push_str(&format!("z={}|{}| ", s_z, rt.thrown));
    rt.thrown.clear();
    let zq = rt.num_quot(fix(7), fix(0));
    let s_zq = show(&rt, zq);
    o.push_str(&format!("zq={}|{}| ", s_zq, rt.thrown));
    rt.thrown.clear();
    let zr = rt.num_rem(fix(7), fix(0));
    let s_zr = show(&rt, zr);
    o.push_str(&format!("zr={}|{}| ", s_zr, rt.thrown));

    // ORDINARY INTEGER DIVISION: exact yields an integer, inexact a double.
    let (e1, e2) = (rt.num_div(fix(6), fix(3)), rt.num_div(fix(7), fix(2)));
    o.push_str(&format!("exact={} inexact={} ", show(&rt, e1), show(&rt, e2)));
    // `quot` and `rem` TRUNCATE toward zero, with `rem` taking the dividend's
    // sign -- which is Clojure's rule and not the modulo one.
    let q = [rt.num_quot(fix(7), fix(2)), rt.num_quot(fix(-7), fix(2)),
             rt.num_quot(fix(7), fix(-2)), rt.num_quot(fix(-7), fix(-2))];
    o.push_str(&format!("q={}/{}/{}/{} ", show(&rt, q[0]), show(&rt, q[1]),
                        show(&rt, q[2]), show(&rt, q[3])));
    let rr = [rt.num_rem(fix(7), fix(2)), rt.num_rem(fix(-7), fix(2)),
              rt.num_rem(fix(7), fix(-2)), rt.num_rem(fix(-7), fix(-2))];
    o.push_str(&format!("r={}/{}/{}/{} ", show(&rt, rr[0]), show(&rt, rr[1]),
                        show(&rt, rr[2]), show(&rt, rr[3])));
    // NEGATION, and a BIGINT negates like a fixnum.
    let (n1, n2) = (rt.num_neg(fix(5)), rt.num_neg(big(2)));
    o.push_str(&format!("n={}/{} ", show(&rt, n1), show(&rt, n2)));
    // A DOUBLE on either side promotes the whole operation.
    let half = dbl(1);
    let (f1, f2) = (rt.num_div(half, fix(1)), rt.num_neg(half));
    o.push_str(&format!("f={}/{} ", show(&rt, f1), show(&rt, f2)));
    // AND A NON-NUMBER IS REFUSED, by every one of them.
    let bad = Value(0x4000_0000_0000_0000);
    let mut refused = String::new();
    for which in 0..4 {
        rt.thrown.clear();
        let _ = match which {
            0 => rt.num_div(bad, fix(1)),
            1 => rt.num_quot(bad, fix(1)),
            2 => rt.num_rem(bad, fix(1)),
            _ => rt.num_neg(bad),
        };
        refused.push_str(if rt.thrown.is_empty() { "0" } else { "1" });
    }
    o.push_str(&format!("refused={}", refused));
    println!("{}", o);
}
