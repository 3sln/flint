    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long min = Big(0), neg1 = Fix(-1);

        string[] names = { "div", "quot", "rem", "neg" };
        for (int which = 0; which < 4; which++) {
            rt.thrown = "";
            long r = which == 0 ? NumDiv(rt, min, neg1)
                   : which == 1 ? NumQuot(rt, min, neg1)
                   : which == 2 ? NumRem(rt, min, neg1)
                   : NumNeg(rt, min);
            o.Append(names[which]).Append("=").Append(Show(rt, r))
             .Append("|").Append(rt.thrown).Append("| ");
        }

        rt.thrown = "";
        long z = NumDiv(rt, Fix(7), Fix(0));
        o.Append("z=").Append(Show(rt, z)).Append("|").Append(rt.thrown).Append("| ");
        rt.thrown = "";
        long zq = NumQuot(rt, Fix(7), Fix(0));
        o.Append("zq=").Append(Show(rt, zq)).Append("|").Append(rt.thrown).Append("| ");
        rt.thrown = "";
        long zr = NumRem(rt, Fix(7), Fix(0));
        o.Append("zr=").Append(Show(rt, zr)).Append("|").Append(rt.thrown).Append("| ");

        o.Append("exact=").Append(Show(rt, NumDiv(rt, Fix(6), Fix(3))))
         .Append(" inexact=").Append(Show(rt, NumDiv(rt, Fix(7), Fix(2)))).Append(' ');
        o.Append("q=").Append(Show(rt, NumQuot(rt, Fix(7), Fix(2)))).Append("/")
         .Append(Show(rt, NumQuot(rt, Fix(-7), Fix(2)))).Append("/")
         .Append(Show(rt, NumQuot(rt, Fix(7), Fix(-2)))).Append("/")
         .Append(Show(rt, NumQuot(rt, Fix(-7), Fix(-2)))).Append(' ');
        o.Append("r=").Append(Show(rt, NumRem(rt, Fix(7), Fix(2)))).Append("/")
         .Append(Show(rt, NumRem(rt, Fix(-7), Fix(2)))).Append("/")
         .Append(Show(rt, NumRem(rt, Fix(7), Fix(-2)))).Append("/")
         .Append(Show(rt, NumRem(rt, Fix(-7), Fix(-2)))).Append(' ');
        o.Append("n=").Append(Show(rt, NumNeg(rt, Fix(5)))).Append("/")
         .Append(Show(rt, NumNeg(rt, Big(2)))).Append(' ');
        long half = Dbl(1);
        o.Append("f=").Append(Show(rt, NumDiv(rt, half, Fix(1)))).Append("/")
         .Append(Show(rt, NumNeg(rt, half))).Append(' ');

        long bad = 0x4000000000000000L;
        var refused = new System.Text.StringBuilder();
        for (int which = 0; which < 4; which++) {
            rt.thrown = "";
            if (which == 0) NumDiv(rt, bad, Fix(1));
            else if (which == 1) NumQuot(rt, bad, Fix(1));
            else if (which == 2) NumRem(rt, bad, Fix(1));
            else NumNeg(rt, bad);
            refused.Append(rt.thrown.Length == 0 ? "0" : "1");
        }
        o.Append("refused=").Append(refused);
        System.Console.WriteLine(o.ToString());
    }
--expect
div=!|ArithmeticException/integer overflow| quot=!|ArithmeticException/integer overflow| rem=i0|| neg=!|ArithmeticException/integer overflow| z=!|ArithmeticException/Divide by zero| zq=!|ArithmeticException/Divide by zero| zr=!|ArithmeticException/Divide by zero| exact=i2 inexact=d3.5 q=i3/i-3/i-3/i3 r=i1/i-1/i1/i-1 n=i-5/i-7 f=d0.5/d127.5 refused=1111
--expect-why
DERIVED FROM CLOJURE'S RULES AND THIS FILE'S OWN HEADER, not from a run. The
header records what each runtime did BEFORE kin owned this code -- native
panicked, the JVM silently answered MIN, the CLR raised a host exception -- so
three targets agreeing is exactly the state this file was written to leave
behind, and says nothing on its own about the answer being right.

THE EDGE, MIN over -1.

  div  -- guarded before the remainder, so: throw, not a panic and not MIN
  quot -- same guard, same throw
  rem  -- `MIN % -1` IS 0 as a value; the guard answers 0 DIRECTLY rather than
          computing it, so this one is `i0` with NO exception. It is the field
          that separates "guarded correctly" from "guarded by throwing at
          everything", and a source that copied the `div` arm into `rem` would
          print `!` with a message here.
  neg  -- MIN has no positive counterpart: throw.

Clojure raises `ArithmeticException` "integer overflow" for all three, which
is the text the header commits to.

DIVIDE BY ZERO IS A DIFFERENT REFUSAL and is asked FIRST -- a question about
the divisor, not about the width of the answer -- so all three of `z`, `zq`,
`zr` say "Divide by zero" and not "integer overflow".

ORDINARY DIVISION. `(/ 6 3)` divides evenly, so an INTEGER 2; `(/ 7 2)` does
not, so a double 3.5. (flint yields a double where Clojure yields a Ratio;
`doc/goals` records that divergence.)

`quot` TRUNCATES TOWARD ZERO and `rem` TAKES THE DIVIDEND'S SIGN -- Clojure's
rule, not the modulo one. Checked in real Clojure 1.12:

  (quot 7 2)=3  (quot -7 2)=-3  (quot 7 -2)=-3  (quot -7 -2)=3
  (rem  7 2)=1  (rem  -7 2)=-1  (rem  7 -2)=1   (rem  -7 -2)=-1

`r=i1/i-1/i1/i-1` is the discriminating one: `mod` would give 1/1/-1/-1, so
these four fields tell `rem` from `mod` -- which no pair of equal outputs
could.

NEGATION: 5 negates to -5, and `big(2)` is boxes[2] = 7, so -7 -- the BIGINT
path reached through `is-int`/`i64-of` rather than `isFixnum`, which is the
shape both ports used to get wrong.

`f=d0.5/d127.5`. THE SECOND IS AN ARTEFACT OF THE FIXTURE, not of the code,
and it is written down here so nobody reads it as an answer about negation.
The probe's toy double is an 8-BIT payload holding `d*2`, so `of-double(-0.5)`
stores `(-1) & 0xFF` = 255 and reads back 255/2 = 127.5. What the field
actually checks is that `num-neg` took the DOUBLE arm and multiplied by -1.0
rather than subtracting from zero: `0.0 - 0.0` is `+0.0` under IEEE 754, and
negating by subtraction loses the sign of zero (the header records that
`(- 0.0)` answered 0.0 where Clojure answers -0.0). A subtract-based negation
would store `(0.5*2)=1` -> `d0.5` here, not `d127.5`.

`refused=1111`: a non-number is refused by ALL FOUR, including unary `neg`,
which takes neither the int nor the double arm. `1111` and not `1110`.
