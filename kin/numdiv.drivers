        static final long NIL = Probe.NIL;
        static boolean isDouble(long v) { return (v >>> 60) == 2; }
        static long ofDouble(double d) { return 0x2000000000000000L | (((long) (d * 2.0)) & 0xFF); }
    }
    static long fix(long n) { return 0x1000000000000000L | (n & 0x0FFFFFFFFFFFFFFFL); }
    static long big(long i) { return 0x3000000000000000L | i; }
    static long dbl(long i) { return 0x2000000000000000L | i; }
    static final class Rt {
        String thrown = "";
        long[] boxes = { Long.MIN_VALUE, -1, 7 };
        long throwStr(String cls, String msg) { thrown = cls + "/" + msg; return NIL; }
    }
    static final class Num {
        static long i64Of(Rt rt, long v) {
            if ((v >>> 60) == 3) return rt.boxes[(int) (v & 0xFF)];
            return (v << 4) >> 4;
        }
        static double f64(Rt rt, long v) {
            if (Val.isDouble(v)) return (v & 0xFF) / 2.0;
            return (double) i64Of(rt, v);
        }
        static long integer(Rt rt, long n) { return fix(n); }
        static double trunc(double d) { return d < 0 ? Math.ceil(d) : Math.floor(d); }
        static long notNumber(Rt rt, long a, long b) {
            rt.thrown = "ClassCastException/not a number"; return NIL;
        }
    }
    static String show(Rt rt, long v) {
        if (v == NIL) return "!";
        if (Val.isDouble(v)) return "d" + fmt(Num.f64(rt, v));
        return "i" + Num.i64Of(rt, v);
    }
    static String fmt(double d) {
        if (d == Math.rint(d) && !Double.isInfinite(d)) return String.valueOf((long) d);
        return String.valueOf(d);
    }
    static boolean isInt(Rt rt, long v) { return (v >>> 60) == 1 || (v >>> 60) == 3; }
    static boolean isNumber(Rt rt, long v) { return isInt(rt, v) || Val.isDouble(v); }
    static boolean bothInts(Rt rt, long a, long b) { return isInt(rt, a) && isInt(rt, b); }
