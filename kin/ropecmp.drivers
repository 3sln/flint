    static long node(Rt rt, long[] kids) {
        long a = rt.alloc(TY_ROPE, Str.RP_KIDS + kids.length);
        rt.set(a, Str.RP_FLAT, NIL);
        rt.set(a, Str.RP_HASH, NIL);
        for (int i = 0; i < kids.length; i++) rt.set(a, Str.RP_KIDS + i, kids[i]);
        return Val.heap(a);
    }
    static String show(Rt rt, long v) {
        StringBuilder s = new StringBuilder();
