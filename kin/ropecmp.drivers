        internal System.Collections.Generic.List<System.Collections.Generic.List<long[]>> walks =
            new System.Collections.Generic.List<System.Collections.Generic.List<long[]>>();
        internal int WalkOpen(long v) {
            var st = new System.Collections.Generic.List<long[]>();
            st.Add(new long[]{v, 0}); walks.Add(st); return walks.Count - 1;
        }
        internal void WalkClose(int w) { while (walks.Count > w) walks.RemoveAt(walks.Count - 1); }
        internal int WalkDup(int w) {
            var c = new System.Collections.Generic.List<long[]>();
            foreach (var e in walks[w]) c.Add(new long[]{e[0], e[1]});
            walks.Add(c); return walks.Count - 1;
        }
        internal void WalkTake(int w, int src) {
            var c = new System.Collections.Generic.List<long[]>();
            foreach (var e in walks[src]) c.Add(new long[]{e[0], e[1]});
            walks[w] = c;
