    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long x = flat(rt, new int[]{1,2,3,4,5,6});
        long y = node(rt, new long[]{flat(rt, new int[]{1}), flat(rt, new int[]{2,3}),
                                     flat(rt, new int[]{4,5,6})});
        long z = node(rt, new long[]{flat(rt, new int[]{1,2,3}), flat(rt, new int[]{4,5,6})});
        o.append("shapes=").append(strCmp(rt, x, y)).append(',').append(strCmp(rt, y, z))
         .append(',').append(strCmp(rt, z, x)).append(' ');
        o.append("same=").append(strCmp(rt, y, y)).append(' ');
        long shortS = flat(rt, new int[]{1,2,3});
        o.append("prefix=").append(strCmp(rt, shortS, x)).append(',')
         .append(strCmp(rt, x, shortS)).append(' ');
        long front = flat(rt, new int[]{0,2,3,4,5,6});
        long last = node(rt, new long[]{flat(rt, new int[]{1,2,3}), flat(rt, new int[]{4,5,9})});
        o.append("diff=").append(strCmp(rt, front, x)).append(',')
         .append(strCmp(rt, x, last)).append(' ');
        long w = node(rt, new long[]{flat(rt, new int[]{1}), inlineOf(new int[]{2,3,4}),
                                     flat(rt, new int[]{5,6})});
        long wd = node(rt, new long[]{flat(rt, new int[]{1}), inlineOf(new int[]{2,9,4}),
                                      flat(rt, new int[]{5,6})});
        o.append("inline=").append(strCmp(rt, x, w)).append(',')
         .append(strCmp(rt, w, wd)).append(' ');
        long hi = flat(rt, new int[]{0x80});
        long lo = flat(rt, new int[]{0x01});
        o.append("unsigned=").append(strCmp(rt, hi, lo)).append(',')
         .append(strCmp(rt, lo, hi)).append(' ');
        long inner = node(rt, new long[]{flat(rt, new int[]{1,2}), inlineOf(new int[]{3})});
        long inner2 = node(rt, new long[]{inlineOf(new int[]{4,5}), flat(rt, new int[]{6})});
        long deep = node(rt, new long[]{inner, inner2});
        o.append("deep=").append(strCmp(rt, deep, x)).append(',')
         .append(strCmp(rt, deep, last)).append(' ');
        System.out.println(o.toString());
    }
