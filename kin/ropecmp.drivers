    internal static int Pow31(Rt rt, int n) { return rt.Pow31(n); }
    // The generated code calls `Str.SBytes` UNQUALIFIED. The constants live in
    // `global::Flint.Rt.Str`, which the head names in full everywhere, so a
    // local `Str` holding just this one method is free of ambiguity.
    internal static class Str {
        internal static int SBytes(Rt rt, long v) { return rt.SBytes(v); }
    }
    internal static int SBytes(Rt rt, long v) { return Str.SBytes(rt, v); }
    internal static int Olen(Rt rt, long v) { return rt.lens[(int) v]; }
    internal static bool IsRope(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyRope;
    }
    internal static int RopeKids(Rt rt, long v) { return Olen(rt, v) - global::Flint.Rt.Str.RP_KIDS; }
    internal static long Flat(Rt rt, int[] bs) {
        long a = rt.Alloc(Obj.TyStr, bs.Length);
        for (int i = 0; i < bs.Length; i++) rt.gc.sp.m[(int) (a + Obj.StrData) + i] = (byte) bs[i];
        return Val.Heap(a);
    }
    internal static long InlineOf(int[] bs) {
        long v = (0xEL << 60) | ((long) bs.Length << 56);
        for (int i = 0; i < bs.Length; i++) v |= ((long) bs[i]) << (8 * i);
        return v;
    }
    internal static long Node(Rt rt, long[] kids) {
        long a = rt.Alloc(Obj.TyRope, global::Flint.Rt.Str.RP_KIDS + kids.Length);
        rt.Set(a, global::Flint.Rt.Str.RP_FLAT, Val.Nil);
        rt.Set(a, global::Flint.Rt.Str.RP_HASH, Val.Nil);
        for (int i = 0; i < kids.Length; i++) rt.Set(a, global::Flint.Rt.Str.RP_KIDS + i, kids[i]);
        return Val.Heap(a);
    }
    internal static string Show(Rt rt, long v) {
        var s = new System.Text.StringBuilder();
        for (int i = 0; i < Olen(rt, v); i++) {
            if (i > 0) s.Append('.');
            s.Append(rt.gc.sp.ReadU8(v + Obj.StrData + i));
        }
        return s.ToString();
    }
--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long x = Flat(rt, new int[]{1,2,3,4,5,6});
        long y = Node(rt, new long[]{Flat(rt, new int[]{1}), Flat(rt, new int[]{2,3}),
                                     Flat(rt, new int[]{4,5,6})});
        long z = Node(rt, new long[]{Flat(rt, new int[]{1,2,3}), Flat(rt, new int[]{4,5,6})});
        o.Append("shapes=").Append(StrCmp(rt, x, y)).Append(',').Append(StrCmp(rt, y, z))
         .Append(',').Append(StrCmp(rt, z, x)).Append(' ');
        o.Append("same=").Append(StrCmp(rt, y, y)).Append(' ');
        long shortS = Flat(rt, new int[]{1,2,3});
        o.Append("prefix=").Append(StrCmp(rt, shortS, x)).Append(',')
         .Append(StrCmp(rt, x, shortS)).Append(' ');
        long front = Flat(rt, new int[]{0,2,3,4,5,6});
        long last = Node(rt, new long[]{Flat(rt, new int[]{1,2,3}), Flat(rt, new int[]{4,5,9})});
        o.Append("diff=").Append(StrCmp(rt, front, x)).Append(',')
         .Append(StrCmp(rt, x, last)).Append(' ');
        long w = Node(rt, new long[]{Flat(rt, new int[]{1}), InlineOf(new int[]{2,3,4}),
                                     Flat(rt, new int[]{5,6})});
        long wd = Node(rt, new long[]{Flat(rt, new int[]{1}), InlineOf(new int[]{2,9,4}),
                                      Flat(rt, new int[]{5,6})});
        o.Append("inline=").Append(StrCmp(rt, x, w)).Append(',')
         .Append(StrCmp(rt, w, wd)).Append(' ');
        long hi = Flat(rt, new int[]{0x80});
        long lo = Flat(rt, new int[]{0x01});
        o.Append("unsigned=").Append(StrCmp(rt, hi, lo)).Append(',')
         .Append(StrCmp(rt, lo, hi)).Append(' ');
        long inner = Node(rt, new long[]{Flat(rt, new int[]{1,2}), InlineOf(new int[]{3})});
        long inner2 = Node(rt, new long[]{InlineOf(new int[]{4,5}), Flat(rt, new int[]{6})});
        long deep = Node(rt, new long[]{inner, inner2});
        o.Append("deep=").Append(StrCmp(rt, deep, x)).Append(',')
         .Append(StrCmp(rt, deep, last)).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
