        internal bool WalkDone(int w) { return walks[w].Count == 0; }
        internal long WalkNext(int w) {
            while (true) {
                var st = walks[w];
                if (st.Count == 0) return Val.Nil;
                long[] top = st[st.Count - 1];
                long nd = top[0];
                if (!IsRope(this, nd)) { st.RemoveAt(st.Count - 1); return nd; }
                int kids = RopeKids(this, nd);
                if (top[1] >= kids) { st.RemoveAt(st.Count - 1); continue; }
                int i = (int) top[1];
                top[1] = i + 1;
                st.Add(new long[]{Slot(nd, global::Flint.Rt.Str.RP_KIDS + i), 0});
