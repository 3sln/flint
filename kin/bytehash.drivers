extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_BYTES: u8 = 44; const TY_BROPE: u8 = 45; const TY_VEC: u8 = 9;
pub mod obj { pub const HDR: u64 = 8; }
pub mod bytes {
    pub const BB_BYTES: u32 = 0; pub const BB_FLAT: u32 = 1;
    pub const BB_DEPTH: u32 = 2; pub const BB_HASH: u32 = 3; pub const BB_KIDS: u32 = 4;
}
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_fixnum(self) -> bool { self.0 < 100 && self.0 != NIL.0 }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
// A BYTE-ADDRESSABLE space, which the earlier byte fixtures did not need: they
// modelled a leaf by its LENGTH alone. `b-at` reads the bytes themselves, so
// this one stores them -- at `addr + HDR`, where the runtime puts them.
struct Space { m: Vec<u8> }
impl Space {
    fn read_u8(&self, a: Addr) -> u8 { self.m[a as usize] }
}
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, sinks: Vec<Vec<u8>>, roots: Vec<Value>, walks: Vec<Vec<(Value, u32)>> }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn b_count(&self, v: Value) -> u32 {
        if !v.is_heap() { return 0; }
        match ty(&self.gc.sp, v.as_heap()) {
            TY_BYTES => self.lens[v.0 as usize],
            TY_BROPE => self.slot(v, bytes::BB_BYTES).as_fixnum() as u32,
            _ => 0,
        }
    }
    fn is_brope(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_BROPE
    }
    fn walk_open(&mut self, v: Value) -> u32 {
        self.walks.push(vec![(v, 0u32)]); (self.walks.len() - 1) as u32
    }
    fn walk_close(&mut self, w: u32) { self.walks.truncate(w as usize); }
    fn walk_dup(&mut self, w: u32) -> u32 {
        let c = self.walks[w as usize].clone(); self.walks.push(c);
        (self.walks.len() - 1) as u32
    }
    fn walk_take(&mut self, w: u32, src: u32) {
        let c = self.walks[src as usize].clone(); self.walks[w as usize] = c;
    }
    fn walk_done(&self, w: u32) -> bool { self.walks[w as usize].is_empty() }
    fn walk_next(&mut self, w: u32) -> Value {
        loop {
            let top = match self.walks[w as usize].last() { None => return NIL, Some(t) => *t };
            let (node, i) = top;
            if !self.is_brope(node) { self.walks[w as usize].pop(); return node; }
            let kids = self.lens[node.0 as usize] - bytes::BB_KIDS;
            if i >= kids { self.walks[w as usize].pop(); continue; }
            if let Some(t) = self.walks[w as usize].last_mut() { t.1 = i + 1; }
            let k = self.slot(node, bytes::BB_KIDS + i);
            self.walks[w as usize].push((k, 0));
        }
    }
    fn run_eq(&self, a: Addr, b: Addr, len: u32) -> bool {
        (0..len).all(|i| self.gc.sp.read_u8(a + i as u64) == self.gc.sp.read_u8(b + i as u64))
    }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_close(&mut self, s: u32) { self.sinks.truncate(s as usize); }
    fn sink_len(&self, s: u32) -> u32 { self.sinks[s as usize].len() as u32 }
    fn sink_put_run(&mut self, s: u32, addr: Addr, len: u32) {
        let src: Vec<u8> = (0..len).map(|i| self.gc.sp.m[(addr + i as u64) as usize]).collect();
        self.sinks[s as usize].extend_from_slice(&src);
    }
    fn sink_bytes(&mut self, s: u32) -> Value {
        let bs = self.sinks[s as usize].clone();
        self.leaf(&bs)
    }
    // SPACED so a leaf's bytes cannot land on the next object's type tag:
    // objects are `n + 16` apart and the bytes occupy `HDR .. HDR + n`.
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn leaf(&mut self, bs: &[u8]) -> Value {
        let a = self.alloc(TY_BYTES, bs.len() as u32);
        for (i, b) in bs.iter().enumerate() { self.gc.sp.m[(a + obj::HDR) as usize + i] = *b; }
        Value::heap(a)
    }
    fn node(&mut self, kids: &[Value]) -> Value {
        let mut total = 0u32;
        for k in kids { total += self.b_count(*k); }
        let a = self.alloc(TY_BROPE, bytes::BB_KIDS + kids.len() as u32);
        self.set_slot(a, bytes::BB_BYTES, Value::fixnum(total as i64));
        self.set_slot(a, bytes::BB_FLAT, NIL);
        self.set_slot(a, bytes::BB_HASH, NIL);
        self.set_slot(a, bytes::BB_DEPTH, Value::fixnum(1));
        for (i, k) in kids.iter().enumerate() { self.set_slot(a, bytes::BB_KIDS + i as u32, *k); }
        Value::heap(a)
    }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, sinks: Vec::new(),
                      roots: Vec::new(), walks: Vec::new() };
    let mut o = String::new();
    // THE SAME BYTES IN DIFFERENT SHAPES must hash alike -- that is the whole
    // requirement, and the only one a structural hash would fail.
    let x = rt.leaf(&[1,2,3,4,5,6]);
    let y = { let a = rt.leaf(&[1]); let b = rt.leaf(&[2,3]); let c = rt.leaf(&[4,5,6]);
              rt.node(&[a, b, c]) };
    let z = { let a = rt.leaf(&[1,2,3]); let b = rt.leaf(&[4,5,6]); rt.node(&[a, b]) };
    let hx = rt.b_hash(x); let hy = rt.b_hash(y); let hz = rt.b_hash(z);
    // THE HASH ITSELF, and not only that the three agree. Equality of two
    // hashes is satisfied by a function that answers a constant; the number
    // pins `h*31 + c` per byte and the `ha * 31^len(b) + hb` join.
    o.push_str(&format!("hx={} ", hx));
    o.push_str(&format!("shapes={}{} ", (hx == hy) as u32, (hy == hz) as u32));
    // AND DIFFERENT BYTES SHOULD NOT, or the check above passes with a
    // constant.
    let d = rt.leaf(&[1,2,3,4,5,7]);
    o.push_str(&format!("differs={} ", (rt.b_hash(d) != hx) as u32));
    // THE CACHE: asked twice, and the slot holds it after the first.
    o.push_str(&format!("cached={} slot={} ", (rt.b_hash(y) == hy) as u32,
                        (rt.slot(y, bytes::BB_HASH).as_fixnum() as u32 == hy) as u32));
    // ORDER MATTERS: the same bytes reversed is a different hash.
    let r = rt.leaf(&[6,5,4,3,2,1]);
    o.push_str(&format!("order={} ", (rt.b_hash(r) != hx) as u32));
    // EMPTY hashes to zero, and `pow31` of zero is one.
    let e = rt.leaf(&[]);
    o.push_str(&format!("empty={} p0={} p1={} p3={} ", rt.b_hash(e),
                        rt.pow31(0), rt.pow31(1), rt.pow31(3)));
    // A LONG one, to cross the point where the multiply wraps.
    let long: Vec<u8> = (0..40u32).map(|i| (i * 7) as u8).collect();
    let l1 = rt.leaf(&long);
    let l2 = { let a = rt.leaf(&long[..17]); let b = rt.leaf(&long[17..]); rt.node(&[a, b]) };
    o.push_str(&format!("wrap={} ", (rt.b_hash(l1) == rt.b_hash(l2)) as u32));
    println!("{}", o);
}
