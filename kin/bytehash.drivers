    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long x = leaf(rt, new int[]{1,2,3,4,5,6});
        long y = node(rt, new long[]{leaf(rt, new int[]{1}), leaf(rt, new int[]{2,3}),
                                     leaf(rt, new int[]{4,5,6})});
        long z = node(rt, new long[]{leaf(rt, new int[]{1,2,3}), leaf(rt, new int[]{4,5,6})});
        int hx = bHash(rt, x), hy = bHash(rt, y), hz = bHash(rt, z);
        o.append("hx=").append(hx).append(' ');
        o.append("shapes=").append(hx == hy ? 1 : 0).append(hy == hz ? 1 : 0).append(' ');
        o.append("differs=").append(bHash(rt, leaf(rt, new int[]{1,2,3,4,5,7})) != hx ? 1 : 0).append(' ');
        o.append("cached=").append(bHash(rt, y) == hy ? 1 : 0)
         .append(" slot=").append((int) rt.slot(y, Bytes.BB_HASH) == hy ? 1 : 0).append(' ');
        o.append("order=").append(bHash(rt, leaf(rt, new int[]{6,5,4,3,2,1})) != hx ? 1 : 0).append(' ');
        long e = leaf(rt, new int[0]);
        o.append("empty=").append(bHash(rt, e))
         .append(" p0=").append(pow31(rt, 0)).append(" p1=").append(pow31(rt, 1))
         .append(" p3=").append(pow31(rt, 3)).append(' ');
        int[] lng = new int[40];
        for (int i = 0; i < 40; i++) lng[i] = (i * 7) & 0xFF;
        int[] head = new int[17], tail = new int[23];
        System.arraycopy(lng, 0, head, 0, 17);
        System.arraycopy(lng, 17, tail, 0, 23);
        long l1 = leaf(rt, lng);
        long l2 = node(rt, new long[]{leaf(rt, head), leaf(rt, tail)});
        o.append("wrap=").append(bHash(rt, l1) == bHash(rt, l2) ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
