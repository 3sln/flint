--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
impl Value { fn is_nil(self) -> bool { self.0 == NIL } }
const NIL: u64 = u64::MAX - 1;
const UNB: u64 = u64::MAX - 2;
struct Rt { h: Vec<f64>, nils: Vec<bool> }
impl Rt {
    fn slot(&self, v: Value, i: u32) -> Value {
        if v.0 == UNB { return Value(if i == 1 { NIL } else { UNB }); }
        Value(v.0 + i as u64)
    }
    fn num_f64(&self, v: Value) -> f64 { self.h[v.0 as usize] }
}
impl Rt {
--rust
}
fn main() {
    // Each range is three consecutive slots: start, end, step.
    let rt = Rt { h: vec![0.0,10.0,1.0,  10.0,0.0,1.0,  10.0,0.0,-1.0,
                          0.0,10.0,-1.0, 0.0,10.0,0.0,  5.0,5.0,1.0],
                  nils: vec![] };
    let _ = &rt.nils;
    let mut o = String::new();
    for base in [0u64, 3, 6, 9, 12, 15] {
        o.push_str(if rt.range_empty(Value(base)) { "1" } else { "0" });
    }
    // An unbounded range: end is nil.
    o.push_str(if rt.range_empty(Value(UNB)) { "1" } else { "0" });
    println!("{}", o);
}
