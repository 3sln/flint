    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.h = new double[]{0,10,1, 10,0,1, 10,0,-1, 0,10,-1, 0,10,0, 5,5,1};
        StringBuilder o = new StringBuilder();
        for (long base : new long[]{0, 3, 6, 9, 12, 15}) o.append(rangeEmpty(rt, base) ? "1" : "0");
        o.append(rangeEmpty(rt, -3L) ? "1" : "0");
        System.out.println(o);
    }
