;; The MAP LAYER's plumbing: what a map is, how big it is, and how a fresh one
;; is built.
;;
;; The first slice ported after the region scrub, and the first written the new
;; way throughout -- one module per namespace, no regions, and cross-namespace
;; references through a `:require` of the defining namespace rather than a
;; declaration in the subject vocabulary.
;;
;; Two map representations live behind these:
;;
;;     ARRAY MAP    AM_META | AM_HASH | k0 v0 | k1 v1 | ...   linear, small
;;     HASH MAP     HM_CNT | HM_ROOT | HM_META | HM_HASH      a CHAMP root
;;
;; and a ROW REF answers `map?` as well, which is why `is-map` names three tags
;; and not two. Every map internal is reachable with a ref because of that, and
;; forgetting it is what made `(dissoc row :b)` return nil on all four runtimes.
(ns flint.rt.mapcore
  (:require [flint.impl.rt :refer [defn return if let do comment doc not or ==
                                   mark push r pop-to alloc set-at heap fixnum
                                   slot olen as-fixnum to-i32 quot
                                   schema-len RF_SCHEMA ty as-heap is-heap
                                   - * +
                                   Rt Value Addr RootIx I32 Ty Bool NIL
                                   AM_BASE AM_META AM_HASH
                                   HM_CNT HM_ROOT HM_META HM_HASH
                                   TY_ARRAYMAP TY_HASHMAP TY_TABLEREF
                                   TY_MAPENTRY]]))

(doc "Is this a map? A ROW REF answers yes, which is what lets code that does"
     "not know it holds a table keep working (`doc/decisions/0026`).")
(defn ^:pub ^:method ^Bool is-map [^Rt rt ^Value v]
  (if (not (is-heap v))
    (return false))
  (let [^Ty t (ty rt (as-heap v))]
    (return (or (== t TY_ARRAYMAP)
                (or (== t TY_HASHMAP) (== t TY_TABLEREF))))))

(defn ^:pub ^:method ^Bool is-array-map [^Rt rt ^Value v]
  (if (not (is-heap v))
    (return false))
  (return (== (ty rt (as-heap v)) TY_ARRAYMAP)))

(doc "How many entries: an array map counts its slots, a hash map is told."
     ""
     "NO ROW-REF ARM, and that is a change from the ports, made on a"
     "measurement. Both ports carried one -- a ref counting its COLUMNS -- on"
     "the defensive reasoning that `isMap` is true for a ref, so anything"
     "asking \"is this a map?\" could arrive here with one."
     ""
     "It is unreachable in all three. Every `count` builtin tests TY_TABLEREF"
     "BEFORE it tests `isMap`, so a ref is answered before this is called, and"
     "a probe of every map operation against a row ref showed no difference"
     "with the arm or without it."
     ""
     "It cost 636 bytes in every shipped module -- 303 564 against 304 200,"
     "measured by building the floor both ways -- and that is what the module"
     "budget in `test/threads.clj` exists to catch. Dead defence is still"
     "carried by every program that never uses a table.")
(defn ^:pub ^:method ^I32 map-count [^Rt rt ^Value m]
  (comment "Early returns rather than one match arm each: kin's `case` is for"
           "tags in statement position, and the ports already spell it this"
           "way. Both are correct and the flatter one is the tie-breaker.")
  (let [^Ty t (ty rt (as-heap m))]
    (if (== t TY_ARRAYMAP)
      (return (quot (- (olen rt m) AM_BASE) 2)))
    (if (== t TY_HASHMAP)
      (return (to-i32 (as-fixnum (slot rt m HM_CNT)))))
    (return 0)))

(defn ^:inline ^:method ^Value am-key [^Rt rt ^Value m ^I32 i]
  (return (slot rt m (+ AM_BASE (* 2 i)))))

(defn ^:inline ^:method ^Value am-val [^Rt rt ^Value m ^I32 i]
  (return (slot rt m (+ (+ AM_BASE (* 2 i)) 1))))

(doc "A fresh array map with room for `n` entries, or NIL if the heap is full.")
(defn ^:method ^Value new-array-map [^:mut ^Rt rt ^I32 n]
  (let [^Addr a (alloc rt TY_ARRAYMAP (+ AM_BASE (* 2 n)))]
    (if (== a 0)
      (return NIL))
    (set-at rt a AM_META NIL)
    (set-at rt a AM_HASH NIL)
    (return (heap a))))

(doc "A fresh hash map over `root`."
     ""
     "`root` and `meta` are ROOTED across the allocation and read back after"
     "it: `alloc` collects, and a value in a host local does not survive that"
     "(`doc/decisions/0031`).")
(defn ^:method ^Value new-hash-map [^:mut ^Rt rt ^I32 cnt ^Value root ^Value meta]
  (let [^RootIx base (mark rt)
        ^RootIx ri (push rt root)
        ^RootIx mi (push rt meta)
        ^Addr a (alloc rt TY_HASHMAP 4)]
    (if (== a 0)
      (do
        (pop-to rt base)
        (return NIL)))
    (let [^Value rv (r rt ri)
          ^Value mv (r rt mi)]
      (pop-to rt base)
      (set-at rt a HM_CNT (fixnum cnt))
      (set-at rt a HM_ROOT rv)
      (set-at rt a HM_META mv)
      (set-at rt a HM_HASH NIL)
      (return (heap a)))))

(doc "A key/value pair as a value. It is a VECTOR, as in Clojure -- `vector?`"
     "is true of one, it prints `[:a 1]`, and `conj` appends.")
(defn ^:pub ^:method ^Value map-entry [^:mut ^Rt rt ^Value k ^Value v]
  (let [^RootIx base (mark rt)
        ^RootIx ki (push rt k)
        ^RootIx vi (push rt v)
        ^Addr a (alloc rt TY_MAPENTRY 2)]
    (if (== a 0)
      (do
        (pop-to rt base)
        (return NIL)))
    (let [^Value kv (r rt ki)
          ^Value vv (r rt vi)]
      (pop-to rt base)
      (set-at rt a 0 kv)
      (set-at rt a 1 vv)
      (return (heap a)))))
