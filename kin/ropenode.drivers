namespace Flint.Rt {
    internal static class Str {
        internal const int RP_BYTES = 0, RP_CPS = 1, RP_FLAT = 2, RP_HASH = 3, RP_KIDS = 4;
        internal const int FANOUT = 3, FLAT_MAX = 8;
        internal static int SBytes(Probe.Rt rt, long v) { return Probe.SBytesOf(rt, v); }
        internal static int SCount(Probe.Rt rt, long v) { return Probe.SCountOf(rt, v); }
        internal static bool SAscii(Probe.Rt rt, long v) { return Probe.SAsciiOf(rt, v); }
        internal static long SEmpty(Probe.Rt rt) { return Probe.Leaf(rt, 0, 0, true); }
    }
}
--csharp-head
    internal static class Obj { internal const int TyRope = 26, TyStr = 2; }
    // The siblings emit `Str.SBytes` unqualified; the shipped file gets that
    // name from `using global::Flint.Rt;`, which a probe has no room for.
    internal static class Str {
        internal static int SBytes(Rt rt, long v) { return SBytesOf(rt, v); }
        internal static int SCount(Rt rt, long v) { return SCountOf(rt, v); }
        internal static bool SAscii(Rt rt, long v) { return SAsciiOf(rt, v); }
        internal static long SEmpty(Rt rt) { return Leaf(rt, 0, 0, true); }
    }
    internal static bool SAscii(Rt rt, long v) { return Str.SAscii(rt, v); }
    internal static int SCount(Rt rt, long v) { return Str.SCount(rt, v); }
    internal static int SBytes(Rt rt, long v) { return Str.SBytes(rt, v); }
    internal static class Rope { internal const int FANOUT = 3; }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil; }
        internal static long AsHeap(long v) { return v; }
        internal static long AsFixnum(long v) { return v; }
        internal static long Fixnum(long n) { return n; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
    }
    internal sealed class Rt {
        internal long[] h = new long[40000];
        internal sealed class GcT { internal int[] sp = new int[40000]; }
        internal GcT gc = new GcT();
        internal int[] lens = new int[40000];
        internal int[] cps = new int[40000];
        internal int[] asc = new int[40000];
        internal long bump = 100;
        internal bool starve = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    internal static bool IsRope(Rt rt, long v) {
        return Val.IsHeap(v) && rt.gc.sp[(int) v] == Obj.TyRope;
    }
    internal static long Leaf(Rt rt, int bytes, int cps, bool ascii) {
        long a = rt.Alloc(Obj.TyStr, bytes);
        rt.cps[(int) a] = cps; rt.asc[(int) a] = ascii ? 1 : 0;
        return Val.Heap(a);
    }
    internal static int SBytesOf(Rt rt, long v) {
        if (IsRope(rt, v)) return (int) rt.Slot(v, global::Flint.Rt.Str.RP_BYTES);
        return rt.lens[(int) v];
    }
    internal static int SCountOf(Rt rt, long v) {
        if (IsRope(rt, v)) return (int) (rt.Slot(v, global::Flint.Rt.Str.RP_CPS) >> 1);
        return rt.cps[(int) v];
    }
    internal static bool SAsciiOf(Rt rt, long v) {
        if (IsRope(rt, v)) return (rt.Slot(v, global::Flint.Rt.Str.RP_CPS) & 1) != 0;
        return rt.asc[(int) v] != 0;
    }
