    static final long NIL = 0xFFFFL;
    static final int HASH_BITS = 5;
    static int mask(int h, int shift) { return (h >>> shift) & 0x1f; }
    static int bitpos(int h, int shift) { return 1 << mask(h, shift); }
    static int indexOf(int bm, int bit) { return Integer.bitCount(bm & (bit - 1)); }
    static final class Rt {
        long[] h = new long[300];
        long bump = 200;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        StringBuilder log = new StringBuilder();
        boolean champAdded = false;
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long obj(String tag) { long a = bump; bump += 1; log.append(tag); return a; }
    }
    static final class Eq {
        static boolean eq(Rt rt, long a, long b) { return a == b; }
        static int hashValue(Rt rt, long v) { return (int) ((v * 7) & 0xff); }
    }
    static boolean isBmnode(Rt rt, long n) { return rt.h[(int) n] != 0xDEADL; }
    static int bnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int bnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long bnKey(Rt rt, long n, int at) { return rt.h[(int) n + 2 + 2 * at]; }
    static long bnVal(Rt rt, long n, int at) { return rt.h[(int) n + 3 + 2 * at]; }
    static long bnNode(Rt rt, long n, int at) { return rt.h[(int) n + 20 + at]; }
    static long collAssoc(Rt rt, long n, int h, long k, long v, long e, int s) { return rt.obj("A"); }
    static long mergeTwo(Rt rt, int s, long k0, long v0, int h0, long k1, long v1, int h1, long e) { return rt.obj("M"); }
    static long bnCopySetValue(Rt rt, long n, int at, long v, long e) { return rt.obj("V"); }
    static long bnCopySetNode(Rt rt, long n, int at, long s, long e) { return rt.obj("N"); }
    static long bnCopyInsertEntry(Rt rt, long n, int bit, long k, long v, long e) { return rt.obj("E"); }
    static long bnInlineToNode(Rt rt, long n, int bit, long s, long e) { return rt.obj("I"); }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.h[1] = 2; rt.h[2] = 4; rt.h[3] = 1000; rt.h[4] = 1001; rt.h[21] = 50;
        rt.h[50] = 0; rt.h[51] = 0;
        rt.h[100] = 0xDEADL;
        StringBuilder o = new StringBuilder();
        long a = nodeAssoc(rt, 100, 0, 0x01, 1, 2, NIL);
        o.append(a).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long b = nodeAssoc(rt, 1, 0, 0x01, 1000, 1001, NIL);
        o.append(b).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long c = nodeAssoc(rt, 1, 0, 0x01, 1000, 9999, NIL);
        o.append(c).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long d = nodeAssoc(rt, 1, 0, 0x01, 7777, 8888, NIL);
        o.append(d).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long e = nodeAssoc(rt, 1, 0, 0x02, 5555, 6666, NIL);
        o.append(e).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long f = nodeAssoc(rt, 1, 0, 0x03, 4444, 3333, NIL);
        o.append(f).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        o.append("log=").append(rt.log).append(" roots=").append(rt.roots.size())
         .append(" bump=").append(rt.bump);
        System.out.println(o);
    }
