    const long NIL = 0xFFFFL;
    const int HASH_BITS = 5;
    static int Mask(int h, int shift) { return (int)((uint) h >> shift) & 0x1f; }
    static int Bitpos(int h, int shift) { return 1 << Mask(h, shift); }
    static int IndexOf(int bm, int bit) { return BitOperations.PopCount((uint)(bm & (bit - 1))); }
    internal sealed class Rt {
        internal long[] h = new long[300];
        internal long bump = 200;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal StringBuilder log = new StringBuilder();
        internal bool champAdded = false;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Obj(string tag) { long a = bump; bump += 1; log.Append(tag); return a; }
    }
    // Nested to reproduce the port's FULLY QUALIFIED `Flint.Rt.Eq`, which the
    // real C# needs because `Maps` has its own `Eq` member shadowing the class.
    internal static class Flint {
        internal static class Rt {
            internal static class Eq {
                internal static bool Equal(Probe.Rt rt, long a, long b) { return a == b; }
                internal static int HashValue(Probe.Rt rt, long v) { return (int) ((v * 7) & 0xff); }
            }
        }
    }
    static bool IsBmnode(Rt rt, long n) { return rt.h[(int) n] != 0xDEADL; }
    static int BnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int BnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long BnKey(Rt rt, long n, int at) { return rt.h[(int) n + 2 + 2 * at]; }
    static long BnVal(Rt rt, long n, int at) { return rt.h[(int) n + 3 + 2 * at]; }
    static long BnNode(Rt rt, long n, int at) { return rt.h[(int) n + 20 + at]; }
    static long CollAssoc(Rt rt, long n, int h, long k, long v, long e, int s) { return rt.Obj("A"); }
    static long MergeTwo(Rt rt, int s, long k0, long v0, int h0, long k1, long v1, int h1, long e) { return rt.Obj("M"); }
    static long BnCopySetValue(Rt rt, long n, int at, long v, long e) { return rt.Obj("V"); }
    static long BnCopySetNode(Rt rt, long n, int at, long s, long e) { return rt.Obj("N"); }
