--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_VEC: u8 = 9; const TY_MAPENTRY: u8 = 15; const TY_ARRAYMAP: u8 = 16;
const TY_HASHMAP: u8 = 17; const TY_SET: u8 = 18; const TY_TABLEREF: u8 = 19;
const TY_TABLE: u8 = 20; const TY_TVEC: u8 = 23; const TY_TMAP: u8 = 24;
const TY_TSET: u8 = 25; const TY_TTABLE: u8 = 27; const TY_TBYTES: u8 = 28;
const TY_OTHER: u8 = 30;
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { gc: Gc, bump: u64, roots: Vec<Value>, thrown: String, kv: (u64, u64), tvn: u32, alive: bool }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && (self.0 >> 40) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
}
// EVERY CALLEE IS A STUB THAT NAMES ITSELF. What this source does is choose
// one of them, so what the probe has to compare is WHICH -- not what any of
// them computes. A stub that answered a plausible value would hide a branch
// landing on the wrong one.
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, _v: Value, _i: u32) -> Value { NIL }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn describe(&mut self, v: Value) -> alloc::string::String {
        if !v.is_heap() { return alloc::string::String::from("a fixnum"); }
        alloc::format!("a #{}", ty(&self.gc.sp, v.as_heap()))
    }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 8;
        self.gc.sp.m[a as usize] = t;
        Value(a)
    }
    fn vec_transient(&mut self, _v: Value) -> Value { Value(0x901) }
    fn map_transient(&mut self, _v: Value) -> Value { Value(0x902) }
    fn set_transient(&mut self, _v: Value) -> Value { Value(0x903) }
    fn table_transient(&mut self, _v: Value) -> Value { Value(0x904) }
    fn ref_to_map(&mut self, _v: Value) -> Value { Value(0x905) }
    fn tvec_persistent(&mut self, _v: Value) -> Value { Value(0x911) }
    fn tmap_persistent(&mut self, _v: Value) -> Value { Value(0x912) }
    fn tset_persistent(&mut self, _v: Value) -> Value { Value(0x913) }
    fn ttable_persistent(&mut self, _v: Value) -> Value { Value(0x914) }
    fn tvec_conj(&mut self, _t: Value, _x: Value) -> Value { Value(0x921) }
    fn tset_conj(&mut self, _t: Value, _x: Value) -> Value { Value(0x922) }
    fn ttable_conj(&mut self, _t: Value, _x: Value) -> Value { Value(0x923) }
    // `tmap_assoc` RECORDS ITS KEY AND VALUE. `conj!` of a pair has to take
    // them apart in the right order, and a stub that only named itself would
    // pass whether it got them backwards.
    fn tmap_assoc(&mut self, _t: Value, k: Value, v: Value) -> Value {
        self.kv = (k.0, v.0); Value(0x931)
    }
    fn tmap_dissoc(&mut self, _t: Value, _k: Value) -> Value { Value(0x932) }
    fn tset_disj(&mut self, _t: Value, _k: Value) -> Value { Value(0x933) }
    fn tvec_assoc(&mut self, _t: Value, i: u32, _v: Value) -> Value { Value(0x940 + i as u64) }
    fn tvec_pop(&mut self, _t: Value) -> Value { Value(0x951) }
    fn b_persistent(&mut self, _t: Value) -> Value { Value(0x915) }
    fn tvec_alive(&mut self, _t: Value) -> bool { self.alive }
    fn tvec_count(&mut self, _t: Value) -> u32 { self.tvn }
    fn slot_or_nth_pub(&mut self, _v: Value, i: u32) -> Value { Value(0x960 + i as u64) }
    fn is_int(&mut self, v: Value) -> bool { (v.0 >> 40) == 1 }
    fn i64_of(&mut self, v: Value) -> i64 { ((v.0 & 0xFFFF_FFFF) as u32) as i32 as i64 }
}
impl Rt {
--rust
}
extern crate alloc;
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 4000] } }, bump: 100,
                      roots: Vec::new(), thrown: String::new(), kv: (0, 0), tvn: 3, alive: true };
    let mut o = String::new();
    // `transient` over every tag it takes, then one it does not.
    for t in [TY_VEC, TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_TABLE, TY_OTHER] {
        let v = rt.obj(t);
        rt.thrown.clear();
        let got = rt.to_transient(v);
        o.push_str(&format!("{:x}", got.0));
        if !rt.thrown.is_empty() { o.push_str(&format!("[{}]", rt.thrown)); }
        o.push(' ');
    }
    // ... and over a NON-HEAP value, which is the arm that says which half of
    // the mistake it was.
    rt.thrown.clear();
    let _ = rt.to_transient(Value(7));
    o.push_str(&format!("|{}| ", rt.thrown));

    // `persistent!` over every transient tag, then a persistent one.
    for t in [TY_TVEC, TY_TMAP, TY_TSET, TY_TTABLE, TY_VEC] {
        let v = rt.obj(t);
        rt.thrown.clear();
        let got = rt.to_persistent(v);
        o.push_str(&format!("{:x}", got.0));
        if !rt.thrown.is_empty() { o.push_str("!"); }
        o.push(' ');
    }
    o.push_str(&format!("|{}| ", rt.thrown));
    // A TRANSIENT IS TAKEN ONCE.
    rt.alive = false;
    rt.thrown.clear();
    let dead = rt.obj(TY_TVEC);
    let _ = rt.to_persistent(dead);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.alive = true;

    // `conj!`. The map arm wants a PAIR, and the two shapes that count as one.
    let x = rt.obj(TY_VEC);
    for t in [TY_TVEC, TY_TSET, TY_TTABLE] {
        let tv = rt.obj(t);
        o.push_str(&format!("{:x} ", rt.transient_conj(tv, x).0));
    }
    let tm = rt.obj(TY_TMAP);
    let pair = rt.obj(TY_MAPENTRY);
    rt.kv = (0, 0);
    let got = rt.transient_conj(tm, pair);
    o.push_str(&format!("{:x}/{:x},{:x} ", got.0, rt.kv.0, rt.kv.1));
    let vpair = rt.obj(TY_VEC);
    o.push_str(&format!("{:x} ", rt.transient_conj(tm, vpair).0));
    rt.thrown.clear();
    let bad = rt.obj(TY_SET);
    let _ = rt.transient_conj(tm, bad);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.thrown.clear();
    let notrans = rt.obj(TY_VEC);
    let _ = rt.transient_conj(notrans, x);
    o.push_str(&format!("|{}| ", rt.thrown));

    // `assoc!`. A TRANSIENT VECTOR TAKES AN INDEX, and -1 is a thing to
    // REFUSE -- which means being able to hold it rather than widening it
    // into four billion.
    let tv = rt.obj(TY_TVEC);
    let two = Value(0x100_0000_0002);
    let neg = Value(0x100_FFFF_FFFF);
    let notint = rt.obj(TY_SET);
    o.push_str(&format!("{:x} ", rt.transient_assoc(tm, notint, x).0));
    o.push_str(&format!("{:x} ", rt.transient_assoc(tv, two, x).0));
    rt.thrown.clear();
    let _ = rt.transient_assoc(tv, neg, x);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.thrown.clear();
    let _ = rt.transient_assoc(tv, notint, x);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.thrown.clear();
    let ats = rt.obj(TY_TSET);
    let _ = rt.transient_assoc(ats, two, x);
    o.push_str(&format!("|{}| ", rt.thrown));

    // `dissoc!` and `disj!`, which are one entry point.
    let dts = rt.obj(TY_TSET);
    let d1 = rt.transient_dissoc(tm, x).0;
    let d2 = rt.transient_dissoc(dts, x).0;
    o.push_str(&format!("{:x} {:x} ", d1, d2));
    rt.thrown.clear();
    let _ = rt.transient_dissoc(tv, x);
    o.push_str(&format!("|{}| ", rt.thrown));

    // `pop!`, vector-only, and the EMPTY case is refused here.
    o.push_str(&format!("{:x} ", rt.transient_pop(tv).0));
    rt.tvn = 0;
    rt.thrown.clear();
    let _ = rt.transient_pop(tv);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.tvn = 3;
    rt.thrown.clear();
    let _ = rt.transient_pop(tm);
    o.push_str(&format!("|{}|", rt.thrown));
    println!("{}", o);
}
