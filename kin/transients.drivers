    static final int TY_TABLE = 20, TY_TVEC = 23, TY_TMAP = 24;
    static final int TY_TSET = 25, TY_TTABLE = 27, TY_TBYTES = 28, TY_OTHER = 30;
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && (v >>> 40) == 0; }
        static long asHeap(long v) { return v; }
    }
    static final class Space { byte[] m = new byte[4000]; }
    static final class Rt {
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        long bump = 100;
        String thrown = "";
        long kvK = 0, kvV = 0;
