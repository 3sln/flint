    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        int[] ins = { TY_VEC, TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_TABLE, TY_OTHER };
        for (int t : ins) {
            long v = rt.obj(t);
            rt.thrown = "";
            long got = toTransient(rt, v);
            o.append(Long.toHexString(got));
            if (!rt.thrown.isEmpty()) o.append("[").append(rt.thrown).append("]");
            o.append(' ');
        }
        rt.thrown = "";
        toTransient(rt, 7L);
        o.append("|").append(rt.thrown).append("| ");

        int[] outs = { TY_TVEC, TY_TMAP, TY_TSET, TY_TTABLE, TY_VEC };
        for (int t : outs) {
            long v = rt.obj(t);
            rt.thrown = "";
            long got = toPersistent(rt, v);
            o.append(Long.toHexString(got));
            if (!rt.thrown.isEmpty()) o.append("!");
            o.append(' ');
        }
        o.append("|").append(rt.thrown).append("| ");
        rt.alive = false;
        rt.thrown = "";
        long dead = rt.obj(TY_TVEC);
        toPersistent(rt, dead);
        o.append("|").append(rt.thrown).append("| ");
        rt.alive = true;

        long x = rt.obj(TY_VEC);
        int[] conjs = { TY_TVEC, TY_TSET, TY_TTABLE };
        for (int t : conjs) {
            long tv0 = rt.obj(t);
            o.append(Long.toHexString(transientConj(rt, tv0, x))).append(' ');
        }
        long tm = rt.obj(TY_TMAP);
        long pair = rt.obj(TY_MAPENTRY);
        rt.kvK = 0; rt.kvV = 0;
        long got = transientConj(rt, tm, pair);
        o.append(Long.toHexString(got)).append("/").append(Long.toHexString(rt.kvK))
         .append(",").append(Long.toHexString(rt.kvV)).append(' ');
        long vpair = rt.obj(TY_VEC);
        o.append(Long.toHexString(transientConj(rt, tm, vpair))).append(' ');
        rt.thrown = "";
        long bad = rt.obj(TY_SET);
        transientConj(rt, tm, bad);
        o.append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        transientConj(rt, rt.obj(TY_VEC), x);
        o.append("|").append(rt.thrown).append("| ");

        long tv = rt.obj(TY_TVEC);
        long two = 0x10000000002L;
        long neg = 0x100FFFFFFFFL;
        long notint = rt.obj(TY_SET);
        o.append(Long.toHexString(transientAssoc(rt, tm, notint, x))).append(' ');
        o.append(Long.toHexString(transientAssoc(rt, tv, two, x))).append(' ');
        rt.thrown = "";
        transientAssoc(rt, tv, neg, x);
        o.append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        transientAssoc(rt, tv, notint, x);
        o.append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        transientAssoc(rt, rt.obj(TY_TSET), two, x);
        o.append("|").append(rt.thrown).append("| ");

        o.append(Long.toHexString(transientDissoc(rt, tm, x))).append(' ')
         .append(Long.toHexString(transientDissoc(rt, rt.obj(TY_TSET), x))).append(' ');
        rt.thrown = "";
        transientDissoc(rt, tv, x);
        o.append("|").append(rt.thrown).append("| ");

        o.append(Long.toHexString(transientPop(rt, tv))).append(' ');
        rt.tvn = 0;
        rt.thrown = "";
        transientPop(rt, tv);
        o.append("|").append(rt.thrown).append("| ");
        rt.tvn = 3;
        rt.thrown = "";
        transientPop(rt, tm);
        o.append("|").append(rt.thrown).append("|");
        System.out.println(o.toString());
    }
