        internal const int TyTable = 20, TyTvec = 23, TyTmap = 24;
        internal const int TyTset = 25, TyTtable = 27, TyTbytes = 28, TyOther = 30;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
