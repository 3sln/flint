         .Append(Val.AsFixnum(rt.Slot(o2, 1)))
         .Append(" distinct=").Append(rt.Slot(o1, 1) != rt.Slot(o2, 1) ? 1 : 0).Append(' ');
        o.Append("host=").Append(OpaqueHostId(rt, o1)).Append('.').Append(OpaqueHostId(rt, o2))
         .Append(" label=").Append(Val.AsFixnum(OpaqueLabel(rt, o1))).Append('.')
