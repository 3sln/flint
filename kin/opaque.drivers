    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long tag = Val.fixnum(11), form = Val.fixnum(22);
        long t = newTagged(rt, tag, form);
        o.append("tagged=").append(isTagged(rt, t) ? 1 : 0).append(isOpaque(rt, t) ? 1 : 0)
         .append('/').append(Val.asFixnum(rt.slot(t, 0))).append('.')
         .append(Val.asFixnum(rt.slot(t, 1))).append(' ');
        long label = Val.fixnum(55);
        long o1 = newOpaque(rt, label, 900), o2 = newOpaque(rt, label, 901);
        o.append("opaque=").append(isOpaque(rt, o1) ? 1 : 0).append(isTagged(rt, o1) ? 1 : 0)
         .append(" ids=").append(Val.asFixnum(rt.slot(o1, 1))).append('.')
         .append(Val.asFixnum(rt.slot(o2, 1)))
         .append(" distinct=").append(rt.slot(o1, 1) != rt.slot(o2, 1) ? 1 : 0).append(' ');
        o.append("host=").append(opaqueHostId(rt, o1)).append('.').append(opaqueHostId(rt, o2))
         .append(" label=").append(Val.asFixnum(opaqueLabel(rt, o1))).append('.')
         .append(Val.asFixnum(opaqueLabel(rt, o2))).append(' ');
        o.append("notopaque=").append(opaqueHostId(rt, t)).append('/')
         .append(Val.isNil(opaqueLabel(rt, t)) ? 1 : 0)
         .append(" nonheap=").append(opaqueHostId(rt, tag)).append('/')
         .append(Val.isNil(opaqueLabel(rt, tag)) ? 1 : 0).append(' ');
        rt.starve = true;
        o.append("starved=").append(Val.isNil(newTagged(rt, tag, form)) ? 1 : 0)
         .append(Val.isNil(newOpaque(rt, label, 1)) ? 1 : 0);
        System.out.println(o.toString());
    }
--csharp-head
    internal const long NIL = 0xFFFFL;
    internal static class Obj {
        internal const int TyTagged = 36, TyOpaque = 37, TyVec = 9;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) {
            return v >= 100 && v != Nil && (long)((ulong) v >> 60) != 0xDL;
        }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static bool IsFixnum(long v) { return (long)((ulong) v >> 60) == 0xDL; }
        internal static long AsFixnum(long v) { return v & 0xFFFFFFFFL; }
        internal static long Fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
    internal sealed class Rt {
        internal long[] h = new long[4000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal long nextOpaque = 1;
        internal bool starve = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
        internal void SetSlot(long a, int i, long x) { h[(int) a + i] = x; }
        internal long TakeOpaqueId() { return nextOpaque++; }
    }
    internal static class Conc {
        internal static long NewObj(Rt rt, int t, int n) {
            if (rt.starve) return Val.Nil;
            long a = rt.bump; rt.bump += n + 8;
            rt.gc.sp.m[(int) a] = (byte) t;
            return Val.Heap(a);
        }
    }
