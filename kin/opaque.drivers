        var o = new System.Text.StringBuilder();
        long tag = Val.Fixnum(11), form = Val.Fixnum(22);
        long t = NewTagged(rt, tag, form);
        o.Append("tagged=").Append(IsTagged(rt, t) ? 1 : 0).Append(IsOpaque(rt, t) ? 1 : 0)
         .Append('/').Append(Val.AsFixnum(rt.Slot(t, 0))).Append('.')
         .Append(Val.AsFixnum(rt.Slot(t, 1))).Append(' ');
