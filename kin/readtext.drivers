    static final long NIL = 0xFFFFFFFFFFFFFFFFL;
    static final long BOX = 0xFFF8000000000000L;
    static final int RS_OK = 0;
    static final int RS_NONE = 2;
    static final int RS_ERR = 4;
    static final int NO_CP = 1114112;
    static final class Reader { int[] cps; int i; long errmsg = NIL; }
    static final class Rt {
        java.util.ArrayList<Long> ints = new java.util.ArrayList<>();
        java.util.ArrayList<String> strs = new java.util.ArrayList<>();
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        java.util.ArrayList<Reader> readers = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Integer>> sinks = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Long>> vecs = new java.util.ArrayList<>();
        int mk(String text) {
            Reader rd = new Reader();
            rd.cps = text.codePoints().toArray();
            rd.i = 0;
            rd.errmsg = NIL;
            readers.add(rd);
            return readers.size() - 1;
        }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        int sinkOpen() { sinks.add(new java.util.ArrayList<>()); return sinks.size() - 1; }
        void sinkPut(int sk, int c) { sinks.get(sk).add(c); }
        void sinkClose(int sk) { while (sinks.size() > sk) sinks.remove(sinks.size() - 1); }
        long sinkString(int sk) {
            StringBuilder b = new StringBuilder();
            for (int c : sinks.get(sk)) b.appendCodePoint(c);
            return Str.of(this, b.toString());
        }
    }
    static boolean boxed(long v) { return (v & BOX) == BOX; }
    static int tag(long v) { return boxed(v) ? (int) ((v >>> 32) & 0xFF) : 9; }
    static int idx(long v) { return (int) (v & 0xFFFFFFFFL); }
    static boolean isWs(int c) {
        return (c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12) || (c == 44);
    }
    static boolean isTerm(int c) {
        return (c == 34) || (c == 59) || (c == 64) || (c == 94) || (c == 96) || (c == 126)
            || (c == 40) || (c == 41) || (c == 91) || (c == 93) || (c == 123) || (c == 125) || (c == 92);
    }
    static boolean isScalar(long n) { return (n >= 0) && (n <= 1114111) && ((n < 55296) || (n > 57343)); }
    static boolean isDigit(int c) { return (c >= 48) && (c <= 57); }
    static int hexDigit(int c) {
        if ((c >= 48) && (c <= 57)) return c - 48;
        if ((c >= 97) && (c <= 102)) return c - 87;
        if ((c >= 65) && (c <= 70)) return c - 55;
        return 16;
    }
    static final class Str {
        static long of(Rt rt, String s) { rt.strs.add(s); return BOX | (3L << 32) | (rt.strs.size() - 1); }
    }
    static long integer(Rt rt, long n) { rt.ints.add(n); return BOX | (1L << 32) | (rt.ints.size() - 1); }
    static long integerValue(Rt rt, long v) { return rt.ints.get(idx(v)); }
    static int rdAt(Rt rt, int sti, int i) { return rt.readers.get(sti).cps[i]; }
    static int rdPos(Rt rt, int sti) { return rt.readers.get(sti).i; }
    static int rdPeek(Rt rt, int sti) {
        Reader rd = rt.readers.get(sti);
