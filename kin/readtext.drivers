    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();

        String[] strsIn = {
            "\"hello\"", "\"a\\tb\\nc\"", "\"café\"", "\"\\101\"", "\"\\q\"",
            "\"abc", "\"\\u00e9\"", "\"\\ud800\"", "\"\\uZZZZ\"",
        };
        for (int n = 0; n < strsIn.length; n++) {
            int sti = rt.mk(strsIn[n]);
            int st = readStringLit(rt, sti);
            o.append("S").append(n + 1).append('=').append(show(rt, sti, st)).append(' ');
        }

        String[] charsIn = {
            "\\a", "\\é", "\\newline", "\\space", "\\tab", "\\return",
            "\\formfeed", "\\backspace", "\\o101", "\\u0041", "\\foo", "\\",
        };
        for (int n = 0; n < charsIn.length; n++) {
            int sti = rt.mk(charsIn[n]);
            int st = readCharLit(rt, sti);
            o.append("C").append(n + 1).append('=').append(show(rt, sti, st)).append(' ');
        }

        String[] regexIn = { "\"a.b\"", "\"a\\.b\"", "\"abc", "\"ab\\" };
        for (int n = 0; n < regexIn.length; n++) {
            int sti = rt.mk(regexIn[n]);
            int st = readRegexLit(rt, sti);
            o.append("R").append(n + 1).append('=').append(show(rt, sti, st));
            if (n + 1 != regexIn.length) o.append(' ');
        }

        System.out.println(o.toString());
    }
--csharp-head
    internal const long Nil = unchecked((long) 0xFFFFFFFFFFFFFFFFUL);
    internal const long Box = unchecked((long) 0xFFF8000000000000UL);
    internal const int RsOk = 0;
    internal const int RsNone = 2;
    internal const int RsErr = 4;
    internal const int NoCp = 1114112;
    internal sealed class Reader { internal int[] Cps; internal int I; internal long Errmsg = Nil; }
    internal sealed class Rt {
        internal System.Collections.Generic.List<long> Ints = new System.Collections.Generic.List<long>();
        internal System.Collections.Generic.List<string> Strs = new System.Collections.Generic.List<string>();
        internal System.Collections.Generic.List<long> Roots = new System.Collections.Generic.List<long>();
        internal System.Collections.Generic.List<Reader> Readers = new System.Collections.Generic.List<Reader>();
        internal System.Collections.Generic.List<System.Collections.Generic.List<int>> Sinks
            = new System.Collections.Generic.List<System.Collections.Generic.List<int>>();
        internal System.Collections.Generic.List<System.Collections.Generic.List<long>> Vecs
            = new System.Collections.Generic.List<System.Collections.Generic.List<long>>();
        internal int Mk(string text) {
            var rd = new Reader();
            var cps = new System.Collections.Generic.List<int>();
            int i = 0;
            while (i < text.Length) {
                int cp = char.ConvertToUtf32(text, i);
                cps.Add(cp);
                i += char.IsSurrogatePair(text, i) ? 2 : 1;
            }
            rd.Cps = cps.ToArray();
            rd.I = 0;
            rd.Errmsg = Nil;
            Readers.Add(rd);
            return Readers.Count - 1;
        }
        internal int Mark() { return Roots.Count; }
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) { return Roots[i]; }
        internal void PopTo(int n) { while (Roots.Count > n) Roots.RemoveAt(Roots.Count - 1); }
        internal int SinkOpen() { Sinks.Add(new System.Collections.Generic.List<int>()); return Sinks.Count - 1; }
        internal void SinkPut(int sk, int c) { Sinks[sk].Add(c); }
        internal void SinkClose(int sk) { while (Sinks.Count > sk) Sinks.RemoveAt(Sinks.Count - 1); }
        internal long SinkString(int sk) {
            var b = new System.Text.StringBuilder();
            foreach (int c in Sinks[sk]) b.Append(char.ConvertFromUtf32(c));
            return Str.Of(this, b.ToString());
        }
    }
    internal static bool Boxed(long v) { return (v & Box) == Box; }
    internal static int Tag(long v) { return Boxed(v) ? (int) (((ulong) v >> 32) & 0xFF) : 9; }
    internal static int Idx(long v) { return (int) (v & 0xFFFFFFFFL); }
    internal static bool IsWs(int c) {
        return (c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12) || (c == 44);
    }
    internal static bool IsTerm(int c) {
        return (c == 34) || (c == 59) || (c == 64) || (c == 94) || (c == 96) || (c == 126)
            || (c == 40) || (c == 41) || (c == 91) || (c == 93) || (c == 123) || (c == 125) || (c == 92);
    }
    internal static bool IsScalar(long n) { return (n >= 0) && (n <= 1114111) && ((n < 55296) || (n > 57343)); }
    internal static bool IsDigit(int c) { return (c >= 48) && (c <= 57); }
    internal static int HexDigit(int c) {
        if ((c >= 48) && (c <= 57)) return c - 48;
        if ((c >= 97) && (c <= 102)) return c - 87;
        if ((c >= 65) && (c <= 70)) return c - 55;
        return 16;
    }
    internal static class Str {
        internal static long Of(Rt rt, string s) { rt.Strs.Add(s); return Box | (3L << 32) | (rt.Strs.Count - 1); }
    }
    internal static long Integer(Rt rt, long n) { rt.Ints.Add(n); return Box | (1L << 32) | (rt.Ints.Count - 1); }
    internal static long IntegerValue(Rt rt, long v) { return rt.Ints[Idx(v)]; }
    internal static int RdAt(Rt rt, int sti, int i) { return rt.Readers[sti].Cps[i]; }
    internal static int RdPos(Rt rt, int sti) { return rt.Readers[sti].I; }
    internal static int RdPeek(Rt rt, int sti) {
        Reader rd = rt.Readers[sti];
        return rd.I >= rd.Cps.Length ? NoCp : rd.Cps[rd.I];
    }
    internal static int RdNext(Rt rt, int sti) {
        int c = RdPeek(rt, sti);
        if (c != NoCp) rt.Readers[sti].I += 1;
        return c;
    }
    internal static int RdToken(Rt rt, int sti) {
        int from = RdPos(rt, sti);
        for (;;) {
            int c = RdPeek(rt, sti);
            if ((c == NoCp) || IsWs(c) || IsTerm(c)) break;
            RdNext(rt, sti);
        }
        return from;
    }
    internal static long RdString(Rt rt, int sti, int from, int to) {
        var b = new System.Text.StringBuilder();
        for (int i = from; i < to; i++) b.Append(char.ConvertFromUtf32(RdAt(rt, sti, i)));
        return Str.Of(rt, b.ToString());
    }
    internal static bool RdRangeIs(Rt rt, int sti, int from, int to, long v) {
        var b = new System.Text.StringBuilder();
        for (int i = from; i < to; i++) b.Append(char.ConvertFromUtf32(RdAt(rt, sti, i)));
        return b.ToString() == rt.Strs[Idx(v)];
    }
    internal static int RdFailLit(Rt rt, int sti, string t) {
        long m = Str.Of(rt, t);
        rt.Readers[sti].Errmsg = m;
        return RsErr;
    }
    internal static int RdFailSink(Rt rt, int sti, int sk) {
        long m = rt.SinkString(sk);
        rt.SinkClose(sk);
        rt.Readers[sti].Errmsg = m;
        return RsErr;
    }
    internal static int RdFailCp(Rt rt, int sti, bool ok, long n) {
        string msg = "not a code point";
        if (ok) msg = msg + ": " + n;
        long m = Str.Of(rt, msg);
        rt.Readers[sti].Errmsg = m;
        return RsErr;
    }
    internal static void MsgLit(Rt rt, int sk, string t) {
        var cps = new System.Collections.Generic.List<int>();
        int i = 0;
        while (i < t.Length) {
            int cp = char.ConvertToUtf32(t, i);
            cps.Add(cp);
            i += char.IsSurrogatePair(t, i) ? 2 : 1;
        }
        foreach (int c in cps) rt.Sinks[sk].Add(c);
    }
    internal static void MsgCp(Rt rt, int sk, int c) {
        if (c != NoCp) rt.Sinks[sk].Add(c);
    }
    internal static void SinkPutCp(Rt rt, int sk, int c) { rt.Sinks[sk].Add(c); }
    internal static long LitKeyword(Rt rt, string ns, string nm) {
        rt.Strs.Add(ns + "/" + nm);
        return Box | (4L << 32) | (rt.Strs.Count - 1);
    }
    internal static long VecFromRoots(Rt rt, int @base, int n) {
        var v = new System.Collections.Generic.List<long>();
        for (int i = 0; i < n; i++) v.Add(rt.R(@base + i));
        rt.Vecs.Add(v);
        return Box | (5L << 32) | (rt.Vecs.Count - 1);
    }
    internal static long OrderedMap(Rt rt, long kv) { return Box | (6L << 32) | (long) Idx(kv); }
    // EXTERNAL, from `readnum.kin` -- see the Rust head for why this is a
    // faithful copy rather than a stub.
    internal static int ParseIntRadix(Rt rt, int sti, int from, int to, long radix, bool neg) {
        if (from >= to) return RsNone;
        long acc = 0;
        int i = from;
        while (i < to) {
            long d = HexDigit(RdAt(rt, sti, i));
            if (d >= radix) return RsNone;
            if (neg) {
                if (acc < (long.MinValue + d) / radix) {
                    long m = Str.Of(rt, "integer overflow");
                    rt.Readers[sti].Errmsg = m;
                    return RsErr;
                }
                acc = (acc * radix) - d;
            } else {
                if (acc > (long.MaxValue - d) / radix) {
                    long m = Str.Of(rt, "integer overflow");
                    rt.Readers[sti].Errmsg = m;
                    return RsErr;
                }
                acc = (acc * radix) + d;
            }
            i += 1;
        }
        long n = Integer(rt, acc);
        rt.Push(n);
        return RsOk;
    }
    // Same DISTINCT tagging as the Rust head.
    internal static string Disp(string s) {
        var o = new System.Text.StringBuilder();
        var cps = new System.Collections.Generic.List<int>();
        int i = 0;
        while (i < s.Length) {
            int cp = char.ConvertToUtf32(s, i);
            cps.Add(cp);
            i += char.IsSurrogatePair(s, i) ? 2 : 1;
        }
        foreach (int c in cps) {
            switch (c) {
                case 32: o.Append("<SP>"); break;
                case 9: o.Append("<TAB>"); break;
                case 10: o.Append("<LF>"); break;
                case 13: o.Append("<CR>"); break;
                case 12: o.Append("<FF>"); break;
                case 8: o.Append("<BKSP>"); break;
                case 92: o.Append("<BS>"); break;
                default: o.Append(char.ConvertFromUtf32(c)); break;
            }
        }
        return o.ToString();
    }
    internal static string DispErr(string s) {
        var o = new System.Text.StringBuilder();
        var cps = new System.Collections.Generic.List<int>();
        int i = 0;
        while (i < s.Length) {
            int cp = char.ConvertToUtf32(s, i);
            cps.Add(cp);
            i += char.IsSurrogatePair(s, i) ? 2 : 1;
        }
        foreach (int c in cps) {
            if (c == 92) o.Append("<BS>"); else o.Append(char.ConvertFromUtf32(c));
        }
        return o.ToString();
    }
    internal static string Show(Rt rt, int sti, int st) {
        if (st == RsOk) {
            long v = rt.Roots[rt.Roots.Count - 1];
            if (Tag(v) == 3) return "ok:" + Disp(rt.Strs[Idx(v)]);
            if (Tag(v) == 6) {
                var pair = rt.Vecs[Idx(v)];
                return "ok:map(" + rt.Strs[Idx(pair[0])] + "=" + Disp(rt.Strs[Idx(pair[1])]) + ")";
            }
            return "ok:?tag" + Tag(v);
        }
        if (st == RsNone) return "none";
        return "err:" + DispErr(rt.Strs[Idx(rt.Readers[sti].Errmsg)]);
    }
--csharp
    static void Main() {
        var rt = new Rt();
        var o = new System.Text.StringBuilder();

        string[] strsIn = {
            "\"hello\"", "\"a\\tb\\nc\"", "\"café\"", "\"\\101\"", "\"\\q\"",
            "\"abc", "\"\\u00e9\"", "\"\\ud800\"", "\"\\uZZZZ\"",
        };
        for (int n = 0; n < strsIn.Length; n++) {
            int sti = rt.Mk(strsIn[n]);
            int st = ReadStringLit(rt, sti);
            o.Append("S").Append(n + 1).Append('=').Append(Show(rt, sti, st)).Append(' ');
        }

        string[] charsIn = {
            "\\a", "\\é", "\\newline", "\\space", "\\tab", "\\return",
            "\\formfeed", "\\backspace", "\\o101", "\\u0041", "\\foo", "\\",
        };
        for (int n = 0; n < charsIn.Length; n++) {
            int sti = rt.Mk(charsIn[n]);
            int st = ReadCharLit(rt, sti);
            o.Append("C").Append(n + 1).Append('=').Append(Show(rt, sti, st)).Append(' ');
        }

        string[] regexIn = { "\"a.b\"", "\"a\\.b\"", "\"abc", "\"ab\\" };
        for (int n = 0; n < regexIn.Length; n++) {
            int sti = rt.Mk(regexIn[n]);
            int st = ReadRegexLit(rt, sti);
            o.Append("R").Append(n + 1).Append('=').Append(Show(rt, sti, st));
            if (n + 1 != regexIn.Length) o.Append(' ');
        }

        System.Console.WriteLine(o.ToString());
    }
--expect
S1=ok:hello S2=ok:a<TAB>b<LF>c S3=ok:café S4=ok:A S5=err:unsupported escape <BS>q S6=err:unterminated string S7=ok:é S8=err:not a code point: 55296 S9=err:not a code point C1=ok:a C2=ok:é C3=ok:<LF> C4=ok:<SP> C5=ok:<TAB> C6=ok:<CR> C7=ok:<FF> C8=ok:<BKSP> C9=ok:A C10=ok:A C11=err:unknown character literal <BS>foo C12=err:unterminated character R1=ok:map(flint/regex=a.b) R2=ok:map(flint/regex=a<BS>.b) R3=err:unterminated regex R4=err:unterminated regex
--expect-why
DERIVED BY TRACING `readtext.kin`'s OWN TEXT against each probe input, not
pasted from a run. `disp` is the reason this is trustworthy as a check and
not just an agreement: a DECODED control character prints as a tag like
`<TAB>`, and an UNDECODED literal backslash prints as `<BS>` -- two different
spellings for two different things. A `read-escape` that left `\t` alone
(bug: treat the backslash as ordinary) would put the RAW characters
backslash, 't' into the string, and `disp` would print that as `<BS>t` --
visibly different from the correctly-decoded `<TAB>`. Printing both as the
two-character `\t` (the obvious choice) would have made a broken decoder and
a correct one agree, which is exactly the trap `AGENTS.md`'s "make the toy
hostile" note is about.

ERROR TEXT goes through its own `disp-err` -- the same backslash-only tag as
`disp`, but leaving ordinary spaces alone, since the message is prose and not
decoded content and a blanket `disp` would turn every space into `<SP>` --
not because the message needs escaping (it is the GUEST's exact wording,
`\q` and `\foo` included), but because measured here: `kin/scripts/verify`
records each target's stdout with a plain `echo`,
and on this machine `/bin/sh`'s `echo` is XSI-flavoured and DECODES
backslash sequences IN THE CAPTURED TEXT before anything is compared. The
error text "unknown character literal \foo" has `\f`, which such an `echo`
turns into a raw form-feed byte, eating the backslash and the `f` together,
so three CORRECT and agreeing answers get silently rewritten to the same
WRONG one, which reads exactly like a real three-way disagreement until
traced through to the shell that built the answers file. Confirmed by
running the compiled probe binary directly (prints "...literal \foo"
every time) against the byte capture `kin/scripts/verify` itself produced
for the same binary (prints "...literal oo", a lone form-feed before
"oo"). Rather than fight the harness's own quoting, this file's `disp`
already had the right shape for the job and now covers both cases.

STRING LITERALS (`read-string-lit`, `read-escape`, `put-code`):

  S1 "hello"            no escapes at all.                        ok:hello
  S2 "a\tb\nc"           TWO-LETTER escapes, `t` and `n`, decoded
                         to the real TAB and LINE FEED characters,
                         each shown as its own tag.                ok:a<TAB>b<LF>c
  S3 "café"              a direct UTF-8 code point with no
                         backslash anywhere -- passes through
                         untouched.                                 ok:café
  S4 "\101"              a BARE-DIGIT escape (no prefix letter) is
                         OCTAL in a string: 1*64 + 0*8 + 1 = 65 = 'A'.
                         Up to three digits are taken; here all
                         three are present and the token ends
                         exactly there.                             ok:A
  S5 "\q"                'q' matches none of `read-escape`'s
                         branches (t r n \ " b f u 0-7), so it is
                         the GUEST's own error text, verbatim,
                         backslash included (shown as `<BS>`, this
                         file's tag for a literal backslash byte,
                         for the shell-quoting reason above).         err:unsupported escape <BS>q
  S6 "abc                no closing quote -- `rd-next` answers
                         `NO_CP` and the loop fails rather than
                         reading past the end.                      err:unterminated string
  S7 "\u00e9"            a HEX escape, `u`-prefixed, exactly four
                         digits: 0x00e9 = 233 = 'é'.                 ok:é
  S8 "\ud800"            same shape, but 0xd800 = 55296 is the
                         FIRST code point of the surrogate hole
                         (`is-scalar` false) -- the error names the
                         number, because `rd-fail-cp` was called
                         with `ok = true`.                           err:not a code point: 55296
  S9 "\uZZZZ"            'Z' is not a hex digit at all, so
                         `parse-int-radix` answers `RS_NONE` before
                         any integer exists -- the SAME error text,
                         but with no number, because `rd-fail-cp`
                         was called with `ok = false`. S8 and S9
                         together are the field that shows the
                         `ok` flag is wired to the right branch.     err:not a code point

CHARACTER LITERALS (`read-char-lit`, `named-char`, `put-code`):

  C1 \a                  a single ordinary character.               ok:a
  C2 \é                  a single UTF-8 character -- `to - from == 1`
                         counts CODE POINTS, not bytes, so this
                         does not fall through to the multi-
                         character cases.                           ok:é
  C3 \newline  C4 \space  C5 \tab  C6 \return  C7 \formfeed
  C8 \backspace          all SIX names `named-char` recognises,
                         each landing on its own control character,
                         each printed as its own tag -- this is
                         the field that would catch two names
                         swapped (`\tab` landing on code 13
                         instead of 9, say).
                         ok:<LF> ok:<SP> ok:<TAB> ok:<CR> ok:<FF> ok:<BKSP>
  C9 \o101               `o`-PREFIXED octal: digits start at
                         `from + 1` (skipping the `o`), "101" base
                         8 = 65 = 'A'. Confirms string escapes and
                         char literals spell octal two DIFFERENT
                         ways (bare digits vs. `o`-prefixed) and
                         both land on the same number here.          ok:A
  C10 \u0041             `u`-PREFIXED hex, four digits, 0x41 = 65 =
                         'A' -- the same answer as C9 by a
                         different radix and a different prefix.     ok:A
  C11 \foo               not a name, not `u`- or `o`-prefixed,
                         more than one character -- the GUEST's
                         "unknown character literal" text, with
                         every character of the token appended; the
                         backslash again shown as `<BS>`.             err:unknown character literal <BS>foo
  C12 \                  the backslash and then `NO_CP` immediately
                         -- `rd-next` has nothing left to give, and
                         the function fails rather than reading
                         off the end.                                err:unterminated character

REGEX LITERALS (`read-regex-lit`):

  R1 "a.b"               plain text, built into `{:flint/regex
                         "a.b"}` -- printed here as `map(key=val)`
                         with the key FIRST, matching the header's
                         own claim about push order.                 ok:map(flint/regex=a.b)
  R2 "a\.b"              a backslash is COPIED VERBATIM along with
                         whatever follows it, never interpreted --
                         the stored text still has a literal
                         backslash in it, which `disp` shows as
                         `<BS>` (not `<TAB>`-style sugar, because it
                         really is the raw byte, not an escape).     ok:map(flint/regex=a<BS>.b)
  R3 "abc                unterminated with ordinary trailing
                         characters.                                 err:unterminated regex
  R4 "ab\                unterminated with a LONE trailing
                         backslash: the function stores the
                         backslash itself, then asks for one more
                         character, gets `NO_CP`, and must not read
                         past that -- the one shape here that could
                         walk off the end of the buffer if `rd-next`
                         were not guarded.                            err:unterminated regex

NOT COVERED HERE, and why: `parse-int-radix`'s own overflow guard (a REAL
dependency of `put-code`, faithfully re-implemented in this file's head) is
unreachable from `readtext.kin`'s own call sites -- at most four hex digits
(max 0xFFFF) or three octal digits (max 511), neither anywhere near 64-bit
overflow. `readnum.drivers` is where that guard is actually exercised,
directly, against both signs.

Put in the exact order and with the exact separators the probe builds them,
the result is the line in `--expect`.
