--rust-head
// A TOY READER STATE WITH A MOVING CURSOR, unlike `readnum.drivers`'s: every
// public function here walks the text with `rd-next`/`rd-peek` rather than
// only random-accessing it, so the mock has to track position for real.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_FFFF_FFFF_FFFF);
// NAN-BOXED, the same scheme `strnum.drivers` and `readnum.drivers` use.
// Tag 1 int, 3 string, 4 keyword, 5 vector, 6 "map" (an alias of its
// backing vector's slot -- this toy never needs CHAMP fidelity, only that
// the KEY COMES FIRST and the VALUE second, which is what `readtext.kin`'s
// own header calls out).
const BOX: u64 = 0xFFF8_0000_0000_0000;
const RS_OK: u32 = 0;
const RS_NONE: u32 = 2;
const RS_ERR: u32 = 4;
const NO_CP: u32 = 1114112;
struct Reader { cps: Vec<u32>, i: u32, errmsg: Value }
struct Rt {
    ints: Vec<i64>, strs: Vec<String>, roots: Vec<Value>,
    readers: Vec<Reader>, sinks: Vec<Vec<u32>>, vecs: Vec<Vec<Value>>,
}
impl Value {
    fn boxed(self) -> bool { (self.0 & BOX) == BOX }
    fn tag(self) -> u64 { if self.boxed() { (self.0 >> 32) & 0xFF } else { 9 } }
    fn idx(self) -> usize { (self.0 & 0xFFFF_FFFF) as usize }
}
fn is_ws(c: u32) -> bool {
    (c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12) || (c == 44)
}
fn is_term(c: u32) -> bool {
    (c == 34) || (c == 59) || (c == 64) || (c == 94) || (c == 96) || (c == 126)
        || (c == 40) || (c == 41) || (c == 91) || (c == 93) || (c == 123) || (c == 125) || (c == 92)
}
fn is_scalar(n: i64) -> bool { (n >= 0) && (n <= 1114111) && ((n < 55296) || (n > 57343)) }
fn is_digit(c: u32) -> bool { (c >= 48) && (c <= 57) }
fn hex_digit(c: u32) -> u32 {
    if (c >= 48) && (c <= 57) { return c - 48; }
    if (c >= 97) && (c <= 102) { return c - 87; }
    if (c >= 65) && (c <= 70) { return c - 55; }
    16
}
impl Rt {
    fn mk(&mut self, text: &str) -> usize {
        self.readers.push(Reader { cps: text.chars().map(|c| c as u32).collect(), i: 0, errmsg: NIL });
        self.readers.len() - 1
    }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn string(&mut self, s: &str) -> Value { self.strs.push(String::from(s)); Value(BOX | (3u64 << 32) | (self.strs.len() - 1) as u64) }
    fn integer(&mut self, n: i64) -> Value { self.ints.push(n); Value(BOX | (1u64 << 32) | (self.ints.len() - 1) as u64) }
    fn integer_value(&self, v: Value) -> i64 { self.ints[v.idx()] }
    fn rd_at(&self, sti: usize, i: u32) -> u32 { self.readers[sti].cps[i as usize] }
    fn rd_pos(&self, sti: usize) -> u32 { self.readers[sti].i }
    fn rd_peek(&self, sti: usize) -> u32 {
        let rd = &self.readers[sti];
        if (rd.i as usize) >= rd.cps.len() { NO_CP } else { rd.cps[rd.i as usize] }
    }
    fn rd_next(&mut self, sti: usize) -> u32 {
        let c = self.rd_peek(sti);
        if c != NO_CP { self.readers[sti].i += 1; }
        c
    }
    fn rd_token(&mut self, sti: usize) -> u32 {
        let from = self.rd_pos(sti);
        loop {
            let c = self.rd_peek(sti);
            if (c == NO_CP) || is_ws(c) || is_term(c) { break; }
            self.rd_next(sti);
        }
        from
    }
    fn rd_string(&mut self, sti: usize, from: u32, to: u32) -> Value {
        let s: String = (from..to).map(|i| char::from_u32(self.rd_at(sti, i)).unwrap()).collect();
        self.string(&s)
    }
    fn rd_range_is(&mut self, sti: usize, from: u32, to: u32, v: Value) -> bool {
        let s: String = (from..to).map(|i| char::from_u32(self.rd_at(sti, i)).unwrap()).collect();
        s == self.strs[v.idx()]
    }
    fn rd_fail_lit(&mut self, sti: usize, t: &str) -> u32 {
        let m = self.string(t);
        self.readers[sti].errmsg = m;
        RS_ERR
    }
    fn rd_fail_sink(&mut self, sti: usize, sk: u32) -> u32 {
        let m = self.sink_string(sk);
        self.sink_close(sk);
        self.readers[sti].errmsg = m;
        RS_ERR
    }
    fn rd_fail_cp(&mut self, sti: usize, ok: bool, n: i64) -> u32 {
        let mut msg = String::from("not a code point");
        if ok {
            msg.push_str(": ");
            msg.push_str(&n.to_string());
        }
        let m = self.string(&msg);
        self.readers[sti].errmsg = m;
        RS_ERR
    }
    fn msg_lit(&mut self, sk: u32, t: &str) {
        for c in t.chars() { self.sinks[sk as usize].push(c as u32); }
    }
    fn msg_cp(&mut self, sk: u32, c: u32) {
        if c != NO_CP { self.sinks[sk as usize].push(c); }
    }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_put(&mut self, sk: u32, c: u32) { self.sinks[sk as usize].push(c); }
    fn sink_put_cp(&mut self, sk: u32, c: u32) { self.sinks[sk as usize].push(c); }
    fn sink_string(&mut self, sk: u32) -> Value {
        let s: String = self.sinks[sk as usize].iter().map(|&c| char::from_u32(c).unwrap()).collect();
        self.string(&s)
    }
    fn sink_close(&mut self, sk: u32) { self.sinks.truncate(sk as usize); }
    fn lit_keyword(&mut self, ns: &str, nm: &str) -> Value {
        self.strs.push(format!("{}/{}", ns, nm));
        Value(BOX | (4u64 << 32) | (self.strs.len() - 1) as u64)
    }
    fn vec_from_roots(&mut self, base: usize, n: u32) -> Value {
        let v: Vec<Value> = (0..n as usize).map(|i| self.r(base + i)).collect();
        self.vecs.push(v);
        Value(BOX | (5u64 << 32) | (self.vecs.len() - 1) as u64)
    }
    fn ordered_map(&mut self, kv: Value) -> Value { Value(BOX | (6u64 << 32) | kv.idx() as u64) }
    // EXTERNAL, from `readnum.kin` -- a faithful copy of its own logic
    // (`readnum.drivers` is where ITS overflow and sign behaviour are
    // actually probed; here it only needs to be RIGHT, since `put-code`
    // leans on it for every `\u` and `\o` escape).
    fn parse_int_radix(&mut self, sti: usize, from: u32, to: u32, radix: i64, neg: bool) -> u32 {
        if from >= to { return RS_NONE; }
        let mut acc: i64 = 0;
        let mut i = from;
        while i < to {
            let d = hex_digit(self.rd_at(sti, i)) as i64;
            if d >= radix { return RS_NONE; }
            if neg {
                if acc < (i64::MIN + d) / radix {
                    let m = self.string("integer overflow");
                    self.readers[sti].errmsg = m;
                    return RS_ERR;
                }
                acc = (acc * radix) - d;
            } else {
                if acc > (i64::MAX - d) / radix {
                    let m = self.string("integer overflow");
                    self.readers[sti].errmsg = m;
                    return RS_ERR;
                }
                acc = (acc * radix) + d;
            }
            i += 1;
        }
        let n = self.integer(acc);
        self.push(n);
        RS_OK
    }
}
// DISPLAY WITH NO AMBIGUITY: a real control character prints as a tag like
// `<TAB>`, and a LITERAL backslash character prints as `<BS>` -- distinct
// tags, so a decoder that left an escape UNDECODED (raw backslash + letter)
// prints visibly differently from one that decoded it to the real
// character. Folding both to the same two-character spelling (`\t` for
// either) is exactly the trap this function avoids: it would make a broken
// `read-escape` and a correct one print identically.
fn disp(s: &str) -> String {
    let mut o = String::new();
    for c in s.chars() {
        match c as u32 {
            32 => o.push_str("<SP>"),
            9 => o.push_str("<TAB>"),
            10 => o.push_str("<LF>"),
            13 => o.push_str("<CR>"),
            12 => o.push_str("<FF>"),
            8 => o.push_str("<BKSP>"),
            92 => o.push_str("<BS>"),
            _ => o.push(c),
        }
    }
    o
}
// Error text keeps its ordinary spaces (it is prose, not decoded content) --
// only the literal backslash is retagged, which is all `/bin/sh`'s `echo`
// needs defused. See the long note in `--expect-why` for why this exists.
fn disp_err(s: &str) -> String {
    let mut o = String::new();
    for c in s.chars() {
        if (c as u32) == 92 { o.push_str("<BS>"); } else { o.push(c); }
    }
    o
}
// Error text goes through `disp` too, same as decoded string content --
// NOT because the message itself needs escaping (it is exactly the
// guest's own wording), but because `kin/scripts/verify` builds its
// `answers` file with a plain `echo`, and this machine's `/bin/sh` `echo`
// is XSI-flavoured: it decodes backslash sequences IN THE CAPTURED OUTPUT
// before this probe's answer is ever compared. "unknown character
// literal \foo" has `\f`, which such an `echo` quietly turns into a raw
// form-feed BYTE, consuming both the backslash and the `f` -- so the
// three targets can agree perfectly and still have their real answer
// (correct) replaced by a mangled one before the comparison ever runs,
// which is indistinguishable from a real three-way disagreement until
// traced to the shell. Routing error text through the same no-raw-
// backslash `disp` this file already needed for decoded escapes sidesteps
// the harness's own quoting hazard rather than fighting it.
fn show(rt: &Rt, sti: usize, st: u32) -> String {
    if st == RS_OK {
        let v = rt.roots[rt.roots.len() - 1];
        if v.tag() == 3 {
            format!("ok:{}", disp(&rt.strs[v.idx()]))
        } else if v.tag() == 6 {
            let pair = &rt.vecs[v.idx()];
            format!("ok:map({}={})", rt.strs[pair[0].idx()], disp(&rt.strs[pair[1].idx()]))
        } else {
            format!("ok:?tag{}", v.tag())
        }
    } else if st == RS_NONE {
        String::from("none")
    } else {
        format!("err:{}", disp_err(&rt.strs[rt.readers[sti].errmsg.idx()]))
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { ints: Vec::new(), strs: Vec::new(), roots: Vec::new(),
                      readers: Vec::new(), sinks: Vec::new(), vecs: Vec::new() };
    let mut o = String::new();

    // STRING LITERALS: plain text, both two-letter escapes (`\t` `\n`), a
    // direct UTF-8 passthrough character, a bare-digit OCTAL escape, an
    // unsupported escape, an unterminated string, a HEX escape that lands
    // on an ordinary character, one that lands in the surrogate hole (an
    // error WITH the offending number), and one whose digits are not hex
    // at all (the same error WITHOUT a number).
    let strs_in = [
        "\"hello\"",
        "\"a\\tb\\nc\"",
        "\"café\"",
        "\"\\101\"",
        "\"\\q\"",
        "\"abc",
        "\"\\u00e9\"",
        "\"\\ud800\"",
        "\"\\uZZZZ\"",
    ];
    for (n, t) in strs_in.iter().enumerate() {
        let sti = rt.mk(t);
        let st = rt.read_string_lit(sti);
        o.push_str(&format!("S{}={} ", n + 1, show(&rt, sti, st)));
    }

    // CHARACTER LITERALS: a plain one, a direct UTF-8 one, all six NAMED
    // characters, an `o`-prefixed octal escape, a `u`-prefixed hex escape,
    // an unknown name, and an unterminated one (just the backslash, EOF
    // right after it).
    let chars_in = [
        "\\a", "\\é", "\\newline", "\\space", "\\tab", "\\return",
        "\\formfeed", "\\backspace", "\\o101", "\\u0041", "\\foo", "\\",
    ];
    for (n, t) in chars_in.iter().enumerate() {
        let sti = rt.mk(t);
        let st = rt.read_char_lit(sti);
        o.push_str(&format!("C{}={} ", n + 1, show(&rt, sti, st)));
    }

    // REGEX LITERALS: plain text, a literal backslash kept VERBATIM (not
    // interpreted, per the file's own header), unterminated with ordinary
    // characters at the end, and unterminated with a lone trailing
    // backslash (the one case that could run the cursor past the end if
    // `rd-next`'s own `NO_CP` guard were wrong).
    let regex_in = ["\"a.b\"", "\"a\\.b\"", "\"abc", "\"ab\\"];
    for (n, t) in regex_in.iter().enumerate() {
        let sti = rt.mk(t);
        let st = rt.read_regex_lit(sti);
        o.push_str(&format!("R{}={}", n + 1, show(&rt, sti, st)));
        if n + 1 != regex_in.len() { o.push(' '); }
    }

    println!("{}", o);
}
