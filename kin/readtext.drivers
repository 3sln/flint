        return BOX | (5L << 32) | (rt.vecs.size() - 1);
    }
    static long orderedMap(Rt rt, long kv) { return BOX | (6L << 32) | idx(kv); }
    // EXTERNAL, from `readnum.kin` -- see the Rust head for why this is a
    // faithful copy rather than a stub.
    static int parseIntRadix(Rt rt, int sti, int from, int to, long radix, boolean neg) {
        if (from >= to) return RS_NONE;
        long acc = 0;
        int i = from;
        while (i < to) {
            long d = hexDigit(rdAt(rt, sti, i));
            if (d >= radix) return RS_NONE;
            if (neg) {
                if (acc < (Long.MIN_VALUE + d) / radix) {
