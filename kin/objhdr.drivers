--rust-head
type Addr = u64;
// A SPACE IS A BYTE ARRAY HERE, which is all these six need it to be: they
// read one 32-bit word and take it apart. `read_u32` is `&self` in the real
// runtime too -- the space is an arena whose interior mutability lives below
// this level -- so the shared reference in the signature is not a weakening
// of the fixture.
struct Space { m: Vec<u8> }
impl Space {
    fn read_u32(&self, a: Addr) -> u32 {
        let i = a as usize;
        u32::from_le_bytes([self.m[i], self.m[i + 1], self.m[i + 2], self.m[i + 3]])
    }
    // `&self`, matching the real `Space`: it is an arena whose interior
    // mutability lives below this level, which is what lets one `Space` tag
    // serve both the readers and the writers.
    fn write_u32(&self, a: Addr, v: u32) {
        let i = a as usize;
        let p = self.m.as_ptr() as *mut u8;
        unsafe { core::ptr::copy_nonoverlapping(v.to_le_bytes().as_ptr(), p.add(i), 4) };
    }
}
--rust
fn main() {
    let sp = Space { m: vec![0u8; 64] };
    let cases: [(u32, u32); 5] = [
        (0xABB4_0000, 1234), (0, 0), (0xFFE8_0000, 0x7FFF_FFFF),
        (0x0010_0000, 8), (0x0004_0000, 16),
    ];
    let mut o = String::new();
    for (i, (w0, w1)) in cases.iter().enumerate() {
        let a = (i * 8) as Addr;
        sp.write_u32(a, *w0);
        sp.write_u32(a + 4, *w1);
    }
    for i in 0..cases.len() {
        let a = (i * 8) as Addr;
        if i > 0 { o.push_str(" | "); }
        o.push_str(&show(&sp, a));
    }
    // THE WRITERS, over ONE address that starts dirty. Every step below is a
    // read-modify-write, so each observation depends on the one before it.
    let w: Addr = 40;
    sp.write_u32(w, 0xFFFF_FFFF);
    sp.write_u32(w + 4, 0xFFFF_FFFF);
    obj_write_header(&sp, w, 7, 99);          o.push_str(&format!(" || {}", show(&sp, w)));
    obj_set_age(&sp, w, 5);                   o.push_str(&format!(" | {}", show(&sp, w)));
    obj_set_age(&sp, w, 8);                   o.push_str(&format!(" | {}", show(&sp, w)));
    obj_set_in_remset(&sp, w, true);
    obj_set_str_ascii(&sp, w, true);
    obj_set_marked(&sp, w, true);             o.push_str(&format!(" | {}", show(&sp, w)));
    obj_set_marked(&sp, w, false);            o.push_str(&format!(" | {}", show(&sp, w)));
    obj_set_in_remset(&sp, w, false);         o.push_str(&format!(" | {}", show(&sp, w)));
    obj_set_str_ascii(&sp, w, false);         o.push_str(&format!(" | {}", show(&sp, w)));
    println!("{}", o);
}
fn show(sp: &Space, a: Addr) -> String {
    format!("{} {} {} {} {} {}",
        obj_ty(sp, a), obj_age(sp, a), obj_marked(sp, a) as u32,
        obj_in_remset(sp, a) as u32, obj_str_ascii(sp, a) as u32, obj_len(sp, a))
}
--java-head
    static final class Space {
        final byte[] m = new byte[64];
        int readU32(long a) {
            int i = (int) a;
            return (m[i] & 0xFF) | ((m[i+1] & 0xFF) << 8)
                 | ((m[i+2] & 0xFF) << 16) | ((m[i+3] & 0xFF) << 24);
        }
        void writeU32(long a, int v) {
            int i = (int) a;
            m[i] = (byte) v; m[i+1] = (byte) (v >>> 8);
            m[i+2] = (byte) (v >>> 16); m[i+3] = (byte) (v >>> 24);
        }
    }
--java
    public static void main(String[] args) {
        Space sp = new Space();
        int[][] cases = { {0xABB40000, 1234}, {0, 0}, {0xFFE80000, 0x7FFFFFFF},
                          {0x00100000, 8}, {0x00040000, 16} };
        for (int i = 0; i < cases.length; i++) {
            sp.writeU32(i * 8L, cases[i][0]);
            sp.writeU32(i * 8L + 4, cases[i][1]);
        }
        StringBuilder o = new StringBuilder();
        for (int i = 0; i < cases.length; i++) {
            long a = i * 8L;
            if (i > 0) o.append(" | ");
            o.append(show(sp, a));
        }
        // THE WRITERS, over ONE address that starts dirty. Every step is a
        // read-modify-write, so each observation depends on the one before.
        long w = 40;
        sp.writeU32(w, 0xFFFFFFFF);
        sp.writeU32(w + 4, 0xFFFFFFFF);
        objWriteHeader(sp, w, 7, 99);   o.append(" || ").append(show(sp, w));
        objSetAge(sp, w, 5);            o.append(" | ").append(show(sp, w));
        objSetAge(sp, w, 8);            o.append(" | ").append(show(sp, w));
        objSetInRemset(sp, w, true);
        objSetStrAscii(sp, w, true);
        objSetMarked(sp, w, true);      o.append(" | ").append(show(sp, w));
        objSetMarked(sp, w, false);     o.append(" | ").append(show(sp, w));
        objSetInRemset(sp, w, false);   o.append(" | ").append(show(sp, w));
        objSetStrAscii(sp, w, false);   o.append(" | ").append(show(sp, w));
        System.out.println(o);
    }
    static String show(Space sp, long a) {
        return objTy(sp, a) + " " + objAge(sp, a) + " "
             + (objMarked(sp, a) ? 1 : 0) + " " + (objInRemset(sp, a) ? 1 : 0) + " "
             + (objStrAscii(sp, a) ? 1 : 0) + " " + objLen(sp, a);
    }
--csharp-head
    internal sealed class Space {
        internal readonly byte[] m = new byte[64];
        internal int ReadU32(long a) {
            int i = (int) a;
            return (m[i] & 0xFF) | ((m[i+1] & 0xFF) << 8)
                 | ((m[i+2] & 0xFF) << 16) | ((m[i+3] & 0xFF) << 24);
        }
        internal void WriteU32(long a, int v) {
            int i = (int) a;
            m[i] = (byte) v; m[i+1] = (byte) ((uint) v >> 8);
            m[i+2] = (byte) ((uint) v >> 16); m[i+3] = (byte) ((uint) v >> 24);
        }
    }
