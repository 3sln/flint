        ObjSetMarked(sp, w, false);     o.Append(" | ").Append(Show(sp, w));
        ObjSetInRemset(sp, w, false);   o.Append(" | ").Append(Show(sp, w));
        ObjSetStrAscii(sp, w, false);   o.Append(" | ").Append(Show(sp, w));
