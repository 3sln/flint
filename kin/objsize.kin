;; HOW BIG AN OBJECT IS, written once.
;;
;; Twelve lines across three runtimes, and every allocation in flint goes
;; through them: `alloc` charges `size_for(ty, len) >> 3` in gas, so these two
;; functions set the price of every object the guest ever makes. The three
;; copies agreed when this was taken -- `DECISIONS.md#calls-are-ports` records
;; someone reading them "branch for branch" during the gas-gap hunt, which is
;; the check this replaces with one that cannot drift.
;;
;; THEY ARE FREE FUNCTIONS, not methods: a size depends on the type tag and
;; the length and on nothing in the runtime, which is why the AOT emitter can
;; fold it at compile time.
(ns flint.rt.objsize
  (:require [flint.impl.rt :refer [defn return if let do comment doc
                                   == or + * align8 to-addr
                                   Ty I32 Addr Layout
                                   HDR STR_DATA
                                   L_VALS L_STR L_RAW
                                   TY_STR TY_BIGINT TY_RAW TY_BYTES
                                   TY_FREE TY_FWD
                                   Space U32 to-ty addr-of-u32
                                   Gc Bool >= > LARGE_OBJECT
                                   gc-bump gc-from gc-half]]
            [flint.rt.objhdr :refer [obj-ty obj-len]]))

(doc "Which of the three shapes `ty` has."
     ""
     "SLOTS UNLESS NAMED OTHERWISE, and the default is the safe one: a type"
     "the allocator has not heard of is laid out as values, so the collector"
     "traces it. Defaulting to RAW would hide a new type's references from"
     "the collector, and the failure would be a freed live object rather than"
     "a wasted word."
     ""
     "A STRING IS ITS OWN SHAPE because its bytes do not begin where every"
     "other object's body does -- `STR_DATA` and not `HDR`."
     ""
     "THE RAW FIVE ARE THE ALLOCATOR'S OWN, three of which no guest ever"
     "sees: `TY_FREE` is a hole in the old space and `TY_FWD` an object that"
     "has moved. Both are walked by the sweeper, so both must size correctly"
     "or the walk steps into the middle of the next object.")
(defn ^:pub ^Layout layout-of [^Ty ty]
  (if (== ty TY_STR)
    (return L_STR))
  (if (or (== ty TY_BIGINT) (or (== ty TY_RAW) (or (== ty TY_BYTES)
                                                   (or (== ty TY_FREE)
                                                       (== ty TY_FWD)))))
    (return L_RAW))
  (return L_VALS))

(doc "How many BYTES an object of `ty` with `len` occupies."
     ""
     "`len` MEANS DIFFERENT THINGS PER LAYOUT, which is the whole reason this"
     "is one function and not three call sites. For slots it is a COUNT and"
     "each is eight bytes wide; for the other two it is already a byte count."
     "Reading it as bytes for a vector would size a ten-element vector at"
     "ten bytes and hand back an object the collector walks off the end of."
     ""
     "ONLY THE BYTE LAYOUTS ROUND. A slot count multiplied by eight is"
     "already a multiple of eight, so rounding it is a no-op that would only"
     "hide a mistake in the multiply; the two byte layouts round because a"
     "caller may ask for any length at all."
     ""
     "THE ANSWER IS BYTES AND THE CHARGE IS `>> 3`. The caller divides; this"
     "does not, because the sweeper walks in bytes and would step wrong on a"
     "size already divided.")
(defn ^:pub ^Addr size-for [^Ty ty ^I32 len]
  (let [^Layout lay (layout-of ty)]
    (comment "WIDENED BEFORE THE ARITHMETIC. A length is 32-bit and an"
             "address is 64; Java and C# widen silently and Rust does not,"
             "so the conversion is said here rather than left to whichever"
             "target happens to tolerate it. Native's copy says `len as"
             "Addr` in the same three places.")
    (if (== lay L_VALS)
      (return (+ HDR (* (to-addr len) 8))))
    (if (== lay L_STR)
      (return (align8 (+ STR_DATA (to-addr len)))))
    (return (align8 (+ HDR (to-addr len))))))

(doc "How many bytes this object occupies, header included."
     ""
     "IN THIS FILE AND NOT `objhdr.kin`, which is where it was written"
     "first and where it did not compile: the generated module globs both"
     "the hand-written `Obj` and its own siblings, and `size-for` exists in"
     "BOTH -- once here and once as the delegator `Obj` keeps for its four"
     "callers. Two globs offering one name make it ambiguous rather than"
     "resolving it. Beside `size-for` the call is to a LOCAL definition,"
     "which shadows a glob on all three targets, and the two belong"
     "together anyway: they must agree for every type, since one measures"
     "a live object and the other reserves room for a new one."
     ""
     "TWO SPECIAL CASES AND THEN `size-for`, which is the point. This used to"
     "carry its own copy of the layout match, and a type added to `layout-of`"
     "but not to that copy was sized as `HDR + len * 8` -- a 513-byte"
     "`TY_BYTES` measured as 4112. The collector then walked from-space with"
     "the wrong stride and blamed an object that was perfectly fine. Deriving"
     "the size from one table removes the second one."
     ""
     "A FREE BLOCK'S LENGTH IS ITS SIZE IN BYTES, and it is the one length"
     "that can genuinely set the high bit -- which is why it is widened with"
     "`addr-of-u32` rather than `to-addr`. All three runtimes already did this"
     "by three different routes: `len as Addr`, `Integer.toUnsignedLong(len)`"
     "and `(uint) len`.")
(defn ^:pub ^Addr obj-size-of [^Space sp ^Addr addr]
  (let [^Ty ty (to-ty (obj-ty sp addr))
        ^U32 len (obj-len sp addr)]
    (if (== ty TY_FREE)
      (return (addr-of-u32 len)))
    (if (== ty TY_FWD)
      (return HDR))
    (return (size-for ty len))))

(doc "Would allocating a `ty`/`len` object trigger a collection?"
     ""
     "Asked BEFORE allocating, because under several executors a collection"
     "has to be staged -- everyone stopped -- and staging one around every"
     "allocation would be a stop-the-world per allocation. Conservative on"
     "purpose: a false yes costs one needless safepoint, a false no would let"
     "the collector move objects while another thread was running."
     ""
     "IN THIS FILE for the reason `size-of` is: it calls `size-for`, and"
     "beside `size-for` that is a LOCAL call. From anywhere else the"
     "generated module globs both the hand-written `Obj` and its siblings,"
     "both of which offer a `size_for`, and two globs offering one name make"
     "it ambiguous rather than resolving it."
     ""
     "NATIVE SATURATED HERE AND THE PORTS DID NOT -- `bump.saturating_add`"
     "against a plain `+`. That is a real difference and it is unreachable:"
     "`max_heap` is built from a `u32`, so every operand is at most 4 GiB and"
     "the sum is at most about 2^33, nowhere near where a 64-bit add wraps."
     "Plain addition IS the saturating answer over that range, so the three"
     "converge on the simpler body rather than on a guard that cannot fire."
     "If the heap limit ever stops being a `u32`, this is the line that has"
     "to change with it.")
(defn ^:pub ^Bool gc-would-collect [^Gc gc ^Ty ty ^I32 len]
  (let [^Addr size (size-for ty len)]
    (if (>= size LARGE_OBJECT)
      (return true))
    (return (> (+ (gc-bump gc) size) (+ (gc-from gc) (gc-half gc))))))
