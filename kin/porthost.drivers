--rust-head
// A TOY SANDBOX seen from the HOST's side: ports, waiters and threads, and
// recorders for the three things these functions do to the outside -- install
// a port, wake a waiter, wake whoever is parked on a port.
//
// `install_bridge_at` is STUBBED, not modelled: what it builds is pinned in
// `kin/portinstall.drivers`, and what matters here is WHICH label and WHICH
// announce flag it is handed. Id 99 is the one that refuses, so the failure
// path has a way in.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
mod conc {
    pub const PT_STATE: u32 = 0;
    pub const PT_PEER: u32 = 1;
    pub const PT_LABEL: u32 = 2;
    pub const W_PORT: u32 = 0;
    pub const W_THREAD: u32 = 1;
    pub const TH_PENDING: u32 = 0;
    // THE REAL VALUES, because the expected answers name them.
    pub const P_OPEN: i64 = 1;
    pub const P_CLOSED: i64 = 2;
    pub const P_HALF: i64 = 4;
    pub const P_ORPHANED: i64 = 5;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt {
    objs: Vec<Vec<Value>>, roots: Vec<Value>,
    ports: Vec<(i64, Value)>, waiters: Vec<(i64, Value)>,
    installs: Vec<(i64, Value, bool)>, woke_waiters: u32, woke_ports: u32,
    // HOW MANY TIMES a port was looked up by id, which is the only way to see
    // that the bridge case never asks.
    lookups: u32,
}
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn port_by_id(&mut self, id: i64) -> Value {
        self.lookups += 1;
        for (k, v) in &self.ports { if *k == id { return *v; } }
        NIL
    }
    fn waiter_at(&mut self, token: i64) -> Value {
        for (k, v) in &self.waiters { if *k == token { return *v; } }
        NIL
    }
    fn wake_waiter(&mut self, _w: Value) -> Value { self.woke_waiters += 1; NIL }
    fn wake_on(&mut self, _p: Value) -> Value { self.woke_ports += 1; NIL }
    fn install_bridge_at(&mut self, id: i64, label: Value, announce: bool) -> Value {
        self.installs.push((id, label, announce));
        if id == 99 { return NIL; }
        let p = self.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), label]);
        self.ports.push((id, p));
        p
    }
--rust
}
fn fresh() -> Rt {
    Rt { objs: vec![], roots: vec![], ports: vec![], waiters: vec![],
         installs: vec![], woke_waiters: 0, woke_ports: 0, lookups: 0 }
}
// `<result>:<label installed>:<announce>:<pending set>:<waiters woken>`
fn granted(rt: &Rt, ok: bool, label: Value, th: Value) -> String {
    let ins = match rt.installs.last() {
        None => "-:-".to_string(),
        Some((_, l, a)) => format!("{}:{}",
            if l.is_nil() { "nil".to_string() } else if *l == label { "L".to_string() }
            else { "?".to_string() },
            if *a { 1 } else { 0 }),
    };
    let pend = if th.is_nil() { 0 }
               else if rt.slot(th, conc::TH_PENDING).is_nil() { 0 } else { 1 };
    format!("{}:{}:{}:{}", if ok { 1 } else { 0 }, ins, pend, rt.woke_waiters)
}
fn main() {
    // 1. A TOKEN THAT NAMES NOTHING. Nothing installed, nothing woken.
    let mut a = fresh();
    let r1 = { let ok1 = a.host_grant_at(7, 1); granted(&a, ok1, NIL, NIL) };

    // 2. THE ORDINARY GRANT: the label comes from the waiter's port, the
    //    install is NOT announced, the port lands on the thread, and the
    //    waiter is woken.
    let mut b = fresh();
    let lbl = b.obj(vec![]);
    let wport = b.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), lbl]);
    let th = b.obj(vec![NIL]);
    let w = b.obj(vec![wport, th]);
    b.waiters.push((7, w));
    let r2 = { let ok2 = b.host_grant_at(7, 1); granted(&b, ok2, lbl, th) };

    // 3. A WAITER WITH NO PORT. Not an error: the label is absent and the
    //    grant still happens.
    let mut c = fresh();
    let th3 = c.obj(vec![NIL]);
    let w3 = c.obj(vec![NIL, th3]);
    c.waiters.push((7, w3));
    let r3 = { let ok3 = c.host_grant_at(7, 1); granted(&c, ok3, NIL, th3) };

    // 4. THE INSTALL REFUSES. False, and NOTHING is woken -- the host may
    //    offer again.
    let mut d = fresh();
    let dl = d.obj(vec![]);
    let dp = d.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), dl]);
    let dth = d.obj(vec![NIL]);
    let dw = d.obj(vec![dp, dth]);
    d.waiters.push((7, dw));
    let r4 = { let ok4 = d.host_grant_at(7, 99); granted(&d, ok4, dl, dth) };

    // 5. A WAITER WHOSE THREAD IS GONE. Still granted: the port exists and the
    //    host must be told the same story either way.
    let mut e = fresh();
    let el = e.obj(vec![]);
    let ep = e.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), el]);
    let ew = e.obj(vec![ep, NIL]);
    e.waiters.push((7, ew));
    let r5 = { let ok5 = e.host_grant_at(7, 1); granted(&e, ok5, el, NIL) };

    // 6. CONTINUE WITH `ok` TRUE. False, and it must touch NOTHING.
    let mut f = fresh();
    let fw = f.obj(vec![NIL, NIL]);
    f.waiters.push((7, fw));
    let ok6 = f.host_continue_at(7, true);
    let r6 = format!("{}:{}", if ok6 { 1 } else { 0 }, f.woke_waiters);

    // 7. CONTINUE AS A REFUSAL. True, and the waiter is woken.
    let mut g = fresh();
    let gw = g.obj(vec![NIL, NIL]);
    g.waiters.push((7, gw));
    let ok7 = g.host_continue_at(7, false);
    let r7 = format!("{}:{}", if ok7 { 1 } else { 0 }, g.woke_waiters);

    // 8-10. THE HOST HANGS UP.  `<state after>:<ports woken>`
    let mut h = fresh();
    h.host_close_at(4);                      // an id that names nothing
    let r8 = format!("-:{}", h.woke_ports);
    let mut i = fresh();
    let ip = i.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), NIL]);
    i.ports.push((4, ip));
    i.host_close_at(4);
    let r9 = format!("{}:{}", i.slot(ip, conc::PT_STATE).as_fixnum(), i.woke_ports);
    let mut j = fresh();
    let jp = j.obj(vec![Value::fixnum(conc::P_CLOSED), Value::fixnum(-1), NIL]);
    j.ports.push((4, jp));
    j.host_close_at(4);
    let r10 = format!("{}:{}", j.slot(jp, conc::PT_STATE).as_fixnum(), j.woke_ports);

    // 11-14. THE STATE, WITH AN ORPHANING NOTICED LAZILY.
    //        `<answer>:<state after>:<lookups>`
    let state = |st: i64, peer: i64, live: bool| -> String {
        let mut rt = fresh();
        let p = rt.obj(vec![Value::fixnum(st), Value::fixnum(peer), NIL]);
        if live {
            let q = rt.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(-1), NIL]);
            rt.ports.push((peer, q));
        }
        let ans = rt.port_state_now_at(p);
        format!("{}:{}:{}", ans, rt.slot(p, conc::PT_STATE).as_fixnum(), rt.lookups)
    };
    println!("{} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {}",
             r1, r2, r3, r4, r5, r6, r7, r8, r9, r10,
             state(conc::P_CLOSED, 8, true),
             state(conc::P_OPEN, -1, false),
             state(conc::P_OPEN, 8, true),
             state(conc::P_OPEN, 8, false));
}
--java-head
    // THE SAME TOY, field for field.
    static final long NIL = 0xFFFF000000000000L;
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static boolean isNil(long v) { return v == NIL; }
        static long fixnum(long n) { return n; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
    }
    static long fx(long v) { return v; }
    static final class Conc {
        static final int PT_STATE = 0, PT_PEER = 1, PT_LABEL = 2;
        static final int W_PORT = 0, W_THREAD = 1, TH_PENDING = 0;
        static final long P_OPEN = 1, P_CLOSED = 2, P_HALF = 4, P_ORPHANED = 5;
        static long portById(Rt rt, long id) {
            rt.lookups++;
            for (int i = 0; i < rt.portIds.size(); i++)
                if (rt.portIds.get(i) == id) return rt.portVals.get(i);
            return NIL;
        }
        static long wakeOn(Rt rt, long p) { rt.wokePorts++; return NIL; }
    }
    // BARE, not on a class: cross-namespace kin calls land unqualified.
    static long waiterAt(Rt rt, long token) {
        for (int i = 0; i < rt.wIds.size(); i++)
            if (rt.wIds.get(i) == token) return rt.wVals.get(i);
        return NIL;
    }
    static long wakeWaiter(Rt rt, long w) { rt.wokeWaiters++; return NIL; }
    static long installBridgeAt(Rt rt, long id, long label, boolean announce) {
        rt.insId.add(id); rt.insLabel.add(label); rt.insAnn.add(announce);
        if (id == 99) return NIL;
        long p = rt.obj(new long[]{Conc.P_OPEN, -1, label});
        rt.portIds.add(id); rt.portVals.add(p);
        return p;
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<Long> roots = new java.util.ArrayList<>();
        java.util.List<Long> portIds = new java.util.ArrayList<>();
        java.util.List<Long> portVals = new java.util.ArrayList<>();
        java.util.List<Long> wIds = new java.util.ArrayList<>();
        java.util.List<Long> wVals = new java.util.ArrayList<>();
        java.util.List<Long> insId = new java.util.ArrayList<>();
        java.util.List<Long> insLabel = new java.util.ArrayList<>();
        java.util.List<Boolean> insAnn = new java.util.ArrayList<>();
        int wokeWaiters = 0, wokePorts = 0, lookups = 0;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
        void setSlot(long v, int i, long x) { objs.get((int) v)[i] = x; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
    }
--java
    static Rt fresh() { return new Rt(); }
    static String granted(Rt rt, boolean ok, long label, long th) {
        String ins;
        if (rt.insId.isEmpty()) ins = "-:-";
        else {
            long l = rt.insLabel.get(rt.insLabel.size() - 1);
            boolean a = rt.insAnn.get(rt.insAnn.size() - 1);
            ins = (l == NIL ? "nil" : (l == label ? "L" : "?")) + ":" + (a ? 1 : 0);
        }
        int pend = (th == NIL) ? 0 : (rt.slot(th, Conc.TH_PENDING) == NIL ? 0 : 1);
        return (ok ? 1 : 0) + ":" + ins + ":" + pend + ":" + rt.wokeWaiters;
    }
    static String state(long st, long peer, boolean live) {
        Rt rt = fresh();
        long p = rt.obj(new long[]{st, peer, NIL});
        if (live) {
            long q = rt.obj(new long[]{Conc.P_OPEN, -1, NIL});
            rt.portIds.add(peer); rt.portVals.add(q);
        }
        long ans = portStateNowAt(rt, p);
        return ans + ":" + rt.slot(p, Conc.PT_STATE) + ":" + rt.lookups;
    }
    public static void main(String[] args) {
        Rt a = fresh();
        String r1 = granted(a, hostGrantAt(a, 7, 1), NIL, NIL);

        Rt b = fresh();
        long lbl = b.obj(new long[0]);
        long wport = b.obj(new long[]{Conc.P_OPEN, -1, lbl});
        long th = b.obj(new long[]{NIL});
        long w = b.obj(new long[]{wport, th});
        b.wIds.add(7L); b.wVals.add(w);
        String r2 = granted(b, hostGrantAt(b, 7, 1), lbl, th);

        Rt c = fresh();
        long th3 = c.obj(new long[]{NIL});
        long w3 = c.obj(new long[]{NIL, th3});
        c.wIds.add(7L); c.wVals.add(w3);
        String r3 = granted(c, hostGrantAt(c, 7, 1), NIL, th3);

        Rt d = fresh();
        long dl = d.obj(new long[0]);
        long dp = d.obj(new long[]{Conc.P_OPEN, -1, dl});
        long dth = d.obj(new long[]{NIL});
        long dw = d.obj(new long[]{dp, dth});
        d.wIds.add(7L); d.wVals.add(dw);
        String r4 = granted(d, hostGrantAt(d, 7, 99), dl, dth);

        Rt e = fresh();
        long el = e.obj(new long[0]);
        long ep = e.obj(new long[]{Conc.P_OPEN, -1, el});
        long ew = e.obj(new long[]{ep, NIL});
        e.wIds.add(7L); e.wVals.add(ew);
        String r5 = granted(e, hostGrantAt(e, 7, 1), el, NIL);

        Rt f = fresh();
        f.wIds.add(7L); f.wVals.add(f.obj(new long[]{NIL, NIL}));
        boolean ok6 = hostContinueAt(f, 7, true);
        String r6 = (ok6 ? 1 : 0) + ":" + f.wokeWaiters;

        Rt g = fresh();
        g.wIds.add(7L); g.wVals.add(g.obj(new long[]{NIL, NIL}));
        boolean ok7 = hostContinueAt(g, 7, false);
        String r7 = (ok7 ? 1 : 0) + ":" + g.wokeWaiters;

        Rt h = fresh();
        hostCloseAt(h, 4);
        String r8 = "-:" + h.wokePorts;
        Rt i = fresh();
        long ip = i.obj(new long[]{Conc.P_OPEN, -1, NIL});
        i.portIds.add(4L); i.portVals.add(ip);
        hostCloseAt(i, 4);
        String r9 = i.slot(ip, Conc.PT_STATE) + ":" + i.wokePorts;
        Rt j = fresh();
        long jp = j.obj(new long[]{Conc.P_CLOSED, -1, NIL});
        j.portIds.add(4L); j.portVals.add(jp);
        hostCloseAt(j, 4);
        String r10 = j.slot(jp, Conc.PT_STATE) + ":" + j.wokePorts;

        System.out.println(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5
            + " | " + r6 + " | " + r7 + " | " + r8 + " | " + r9 + " | " + r10
            + " | " + state(Conc.P_CLOSED, 8, true)
            + " | " + state(Conc.P_OPEN, -1, false)
            + " | " + state(Conc.P_OPEN, 8, true)
            + " | " + state(Conc.P_OPEN, 8, false));
    }
--csharp-head
    // THE SAME TOY AGAIN, in this target's spelling.
    const long NIL = unchecked((long)0xFFFF000000000000UL);
    static class Val {
        public const long Nil = unchecked((long)0xFFFF000000000000UL);
        public static bool IsNil(long v) => v == Nil;
        public static long Fixnum(long n) => n;
        public static long AsHeap(long v) => v;
        public static long AsFixnum(long v) => v;
    }
    static long Fx(long v) => v;
    static class Conc {
        public const int PT_STATE = 0, PT_PEER = 1, PT_LABEL = 2;
        public const int W_PORT = 0, W_THREAD = 1, TH_PENDING = 0;
        public const long P_OPEN = 1, P_CLOSED = 2, P_HALF = 4, P_ORPHANED = 5;
        public static long PortById(Rt rt, long id) {
            rt.Lookups++;
            for (int i = 0; i < rt.PortIds.Count; i++)
                if (rt.PortIds[i] == id) return rt.PortVals[i];
            return Val.Nil;
        }
        public static long WakeOn(Rt rt, long p) { rt.WokePorts++; return Val.Nil; }
    }
    // BARE -- see the Java head.
    static long WaiterAt(Rt rt, long token) {
        for (int i = 0; i < rt.WIds.Count; i++)
            if (rt.WIds[i] == token) return rt.WVals[i];
        return Val.Nil;
    }
    static long WakeWaiter(Rt rt, long w) { rt.WokeWaiters++; return Val.Nil; }
    static long InstallBridgeAt(Rt rt, long id, long label, bool announce) {
        rt.InsId.Add(id); rt.InsLabel.Add(label); rt.InsAnn.Add(announce);
        if (id == 99) return Val.Nil;
        long p = rt.MakeObj(new long[]{ Conc.P_OPEN, -1, label });
        rt.PortIds.Add(id); rt.PortVals.Add(p);
        return p;
    }
    public class Rt {
        public System.Collections.Generic.List<long[]> Objs = new System.Collections.Generic.List<long[]>();
        public System.Collections.Generic.List<long> Roots = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortVals = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> WIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> WVals = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> InsId = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> InsLabel = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<bool> InsAnn = new System.Collections.Generic.List<bool>();
        public int WokeWaiters = 0, WokePorts = 0, Lookups = 0;
        public long MakeObj(long[] slots) { Objs.Add(slots); return Objs.Count - 1; }
        public long Slot(long v, int i) => Objs[(int) v][i];
        public void SetSlot(long v, int i, long x) { Objs[(int) v][i] = x; }
        public int Mark() => Roots.Count;
        public int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        public long R(int i) => Roots[i];
        public void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
    }
--csharp
    static Rt Fresh() { return new Rt(); }
    static string Granted(Rt rt, bool ok, long label, long th) {
        string ins;
        if (rt.InsId.Count == 0) ins = "-:-";
        else {
            long l = rt.InsLabel[rt.InsLabel.Count - 1];
            bool a = rt.InsAnn[rt.InsAnn.Count - 1];
            ins = (l == NIL ? "nil" : (l == label ? "L" : "?")) + ":" + (a ? 1 : 0);
        }
        int pend = (th == NIL) ? 0 : (rt.Slot(th, Conc.TH_PENDING) == NIL ? 0 : 1);
        return (ok ? 1 : 0) + ":" + ins + ":" + pend + ":" + rt.WokeWaiters;
    }
    static string State(long st, long peer, bool live) {
        var rt = Fresh();
        long p = rt.MakeObj(new long[]{ st, peer, NIL });
        if (live) {
            long q = rt.MakeObj(new long[]{ Conc.P_OPEN, -1, NIL });
            rt.PortIds.Add(peer); rt.PortVals.Add(q);
        }
        long ans = PortStateNowAt(rt, p);
        return ans + ":" + rt.Slot(p, Conc.PT_STATE) + ":" + rt.Lookups;
    }
    static void Main() {
        var a = Fresh();
        string r1 = Granted(a, HostGrantAt(a, 7, 1), NIL, NIL);

        var b = Fresh();
        long lbl = b.MakeObj(new long[0]);
        long wport = b.MakeObj(new long[]{ Conc.P_OPEN, -1, lbl });
        long th = b.MakeObj(new long[]{ NIL });
        long w = b.MakeObj(new long[]{ wport, th });
        b.WIds.Add(7); b.WVals.Add(w);
        string r2 = Granted(b, HostGrantAt(b, 7, 1), lbl, th);

        var c = Fresh();
        long th3 = c.MakeObj(new long[]{ NIL });
        long w3 = c.MakeObj(new long[]{ NIL, th3 });
        c.WIds.Add(7); c.WVals.Add(w3);
        string r3 = Granted(c, HostGrantAt(c, 7, 1), NIL, th3);

        var d = Fresh();
        long dl = d.MakeObj(new long[0]);
        long dp = d.MakeObj(new long[]{ Conc.P_OPEN, -1, dl });
        long dth = d.MakeObj(new long[]{ NIL });
        long dw = d.MakeObj(new long[]{ dp, dth });
        d.WIds.Add(7); d.WVals.Add(dw);
        string r4 = Granted(d, HostGrantAt(d, 7, 99), dl, dth);

        var e = Fresh();
        long el = e.MakeObj(new long[0]);
        long ep = e.MakeObj(new long[]{ Conc.P_OPEN, -1, el });
        long ew = e.MakeObj(new long[]{ ep, NIL });
        e.WIds.Add(7); e.WVals.Add(ew);
        string r5 = Granted(e, HostGrantAt(e, 7, 1), el, NIL);

        var f = Fresh();
        f.WIds.Add(7); f.WVals.Add(f.MakeObj(new long[]{ NIL, NIL }));
        bool ok6 = HostContinueAt(f, 7, true);
        string r6 = (ok6 ? 1 : 0) + ":" + f.WokeWaiters;

        var g = Fresh();
        g.WIds.Add(7); g.WVals.Add(g.MakeObj(new long[]{ NIL, NIL }));
        bool ok7 = HostContinueAt(g, 7, false);
        string r7 = (ok7 ? 1 : 0) + ":" + g.WokeWaiters;

        var h = Fresh();
        HostCloseAt(h, 4);
        string r8 = "-:" + h.WokePorts;
        var i = Fresh();
        long ip = i.MakeObj(new long[]{ Conc.P_OPEN, -1, NIL });
        i.PortIds.Add(4); i.PortVals.Add(ip);
        HostCloseAt(i, 4);
        string r9 = i.Slot(ip, Conc.PT_STATE) + ":" + i.WokePorts;
        var j = Fresh();
        long jp = j.MakeObj(new long[]{ Conc.P_CLOSED, -1, NIL });
        j.PortIds.Add(4); j.PortVals.Add(jp);
        HostCloseAt(j, 4);
        string r10 = j.Slot(jp, Conc.PT_STATE) + ":" + j.WokePorts;

        System.Console.WriteLine(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5
            + " | " + r6 + " | " + r7 + " | " + r8 + " | " + r9 + " | " + r10
            + " | " + State(Conc.P_CLOSED, 8, true)
            + " | " + State(Conc.P_OPEN, -1, false)
            + " | " + State(Conc.P_OPEN, 8, true)
            + " | " + State(Conc.P_OPEN, 8, false));
    }
--expect
0:-:-:0:0 | 1:L:0:1:1 | 1:nil:0:1:1 | 0:L:0:0:0 | 1:L:0:0:1 | 0:0 | 1:1 | -:0 | 4:1 | 2:1 | 2:2:0 | 1:1:0 | 1:1:1 | 5:5:1
--expect-why
DERIVED FROM WHAT THE HOST'S FOUR ENTRY POINTS PROMISE.

GRANT, as `<result>:<label>:<announce>:<pending set>:<waiters woken>`:

  1 `0:-:-:0:0`   A TOKEN THAT NAMES NOTHING answers false and does nothing
                  else -- no install attempted, nobody woken. The host is
                  allowed to be late; a token it still holds may name a waiter
                  that has already been retired.
  2 `1:L:0:1:1`   THE ORDINARY GRANT, and four separate promises:
                  the label is the one on the WAITER'S port, so a diagnostic
                  about the granted port names what the guest asked for rather
                  than an id it has never seen;
                  `announce` is 0 -- the host is not told it now holds a port
                  it has just handed over, or the retain would never be matched;
                  the port is left on the thread as `TH_PENDING`, which is what
                  makes a resumed `port-open` one request and not two;
                  and the waiter is woken exactly once.
  3 `1:nil:0:1:1` A WAITER WITH NO PORT still grants, with an absent label. A
                  runtime that read `PT_LABEL` off nil would fault here, and
                  one that refused the grant would strand a host that asked
                  before the port existed.
  4 `0:L:0:0:0`   THE INSTALL REFUSED. False -- and the last two fields are the
                  point: NOTHING was woken and nothing was left on the thread,
                  so the host may offer again. A version that woke first and
                  installed second would read `0:L:0:0:1` and the guest would
                  resume to find no port.
  5 `1:L:0:0:1`   A WAITER WHOSE THREAD IS GONE. Still true, still woken; only
                  `pending` is 0, because there is no thread to leave it on.
                  The port exists, and the host must be told the same story
                  whether or not the guest is still there to receive it.

CONTINUE, as `<result>:<waiters woken>`:

  6 `0:0`         **`ok` TRUE IS REFUSED, AND TOUCHES NOTHING.** There is no
                  port to grant until the host says WHICH one, so this form can
                  only ever mean a refusal; answering true would have to invent
                  a port, which is the construction the sandbox may not do and
                  the host must not do by accident. The `:0` is half the
                  contract -- it returns BEFORE looking the token up, so a host
                  that calls it this way has changed nothing and can call
                  `host-grant` instead. Reads `0:1` if the early return is
                  dropped, and every other field in this group is unchanged.
  7 `1:1`         AND AS A REFUSAL it wakes the waiter, which is how the guest
                  finds out. `TH_PENDING` is deliberately not written: the
                  thread resumes, finds no port, and raises its own refusal.

CLOSE, as `<state after>:<ports woken>`:

  8 `-:0`         AN UNKNOWN ID DOES NOTHING. The host may close a port the
                  collector has already taken.
  9 `4:1`         AN OPEN PORT BECOMES HALF-CLOSED, not closed. What is already
                  in the guest's buffer is still the guest's to read; closing
                  outright would discard messages the host itself sent.
 10 `2:1`         **AN ALREADY-CLOSED PORT KEEPS ITS STATE AND IS STILL WOKEN.**
                  The state is not overwritten -- a tidy close outranks a half
                  -- and the wake sits OUTSIDE that test on purpose: a thread
                  parked on a port that was already half-closed is waiting for
                  something that will never come, and a host hanging up is the
                  last event it will ever get. Only this case separates the
                  wake from the state change; move the wake inside the `if` and
                  fields 9 and 8 both still pass.

STATE, as `<answer>:<state after>:<lookups>`:

 11 `2:2:0`       A CLOSED PORT IS REPORTED CLOSED and NOT re-examined -- the
                  0 lookups say the peer was never consulted. Orphaning a
                  closed port would turn an ordinary end-of-stream into an
                  error.
 12 `1:1:0`       **A BRIDGE IS LEFT ALONE, AND THE 0 PROVES IT.** Its peer id
                  is -1 because its far end is the host's registry and is in no
                  heap; looking for it would find nothing and orphan a
                  perfectly live port. A version without the `peer-id < 0`
                  test reads `5:5:1` -- one lookup, and a live bridge marked
                  orphaned.
 13 `1:1:1`       A CHANNEL WITH A LIVE PEER is open, and it cost one lookup.
 14 `5:5:1`       A CHANNEL WHOSE PEER IS GONE is ORPHANED -- and RECORDED, not
                  merely reported. The second field is the recording: without
                  it the next ask has to look again, and two readers can
                  disagree about a port whose peer vanished between them.
