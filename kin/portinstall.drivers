--rust-head
// A TOY SANDBOX. Ports are rows, the scheduler is a row, and `new_port_at` is
// stubbed to the shape the real one has -- this fixture is about WHICH port is
// installed and what the host is told, not about how a port is built; that is
// pinned next door in `kin/portmake.drivers`.
//
// IT CANNOT SHOW THE ROOTING ORDER. Nothing here collects, so the bug this
// file exists to fix is invisible to it; the guard for that is the GC-stress
// row in `bin/conform-hosts`. Saying so beats implying the cases cover it.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
mod conc {
    pub const PT_ID: u32 = 0;
    pub const PT_STATE: u32 = 1;
    pub const PT_LABEL: u32 = 2;
    pub const PT_KIND: u32 = 3;
    pub const SC_BRIDGES: u32 = 0;
    pub const SC_SYSTEM: u32 = 1;
    // THE REAL VALUES, because the expected answers name them.
    pub const K_BRIDGE: i64 = 1;
    pub const P_OPEN: i64 = 1;
    pub const EV_RETAIN: i64 = 4;
    pub const DEFAULT_BRIDGE_CAP: i64 = 1 << 20;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt { objs: Vec<Vec<Value>>, roots: Vec<Value>, sched_v: Value,
            ports: Vec<(i64, Value)>, events: Vec<(i64, i64)>, sched_calls: u32 }
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn sched(&self) -> Value { self.sched_v }
    // COUNTED, so a case can say it was called at all -- the ordering it is
    // part of cannot be seen here, but its PRESENCE can.
    fn ensure_sched(&mut self) -> Value { self.sched_calls += 1; self.sched_v }
    fn port_by_id(&mut self, id: i64) -> Value {
        for (k, v) in &self.ports { if *k == id { return *v; } }
        NIL
    }
    fn push_event(&mut self, kind: i64, a: i64, _b: i64, _p: Value) { self.events.push((kind, a)); }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let mut next = self.objs[v.0 as usize].clone();
        next.push(x);
        self.obj(next)
    }
    fn vec_count(&self, v: Value) -> u32 { self.objs[v.0 as usize].len() as u32 }
    // The real one is generated next door; here it only has to make something
    // with the right slots and register it by id.
    fn new_port_at(&mut self, _cap: i64, label: Value, kind: i64, state: i64, id: i64) -> Value {
        let p = self.obj(vec![Value::fixnum(id), Value::fixnum(state), label, Value::fixnum(kind)]);
        self.ports.push((id, p));
        p
    }
--rust
}
fn fresh() -> Rt {
    let mut rt = Rt { objs: vec![], roots: vec![], sched_v: NIL, ports: vec![],
                      events: vec![], sched_calls: 0 };
    let brs = rt.obj(vec![]);
    rt.sched_v = rt.obj(vec![brs, NIL]);
    rt
}
fn shown(rt: &Rt, p: Value, label: Value) -> String {
    let s = rt.sched_v;
    let brs = rt.slot(s, conc::SC_BRIDGES);
    let ev: Vec<String> = rt.events.iter().map(|(k, a)| format!("{k}:{a}")).collect();
    format!("{} {} {} {} {} {}",
        rt.slot(p, conc::PT_KIND).as_fixnum(),
        rt.slot(p, conc::PT_STATE).as_fixnum(),
        rt.slot(p, conc::PT_ID).as_fixnum(),
        if rt.slot(p, conc::PT_LABEL) == label { 1 } else { 0 },
        rt.vec_count(brs),
        if ev.is_empty() { "-".to_string() } else { ev.join(",") })
}
fn main() {
    // 1. A NEGATIVE ID IS REFUSED, and nothing happens at all.
    let mut a = fresh();
    let la = a.obj(vec![]);
    let r1 = format!("{} {} {}",
        if a.install_bridge_at(-1, la, true).is_nil() { 1 } else { 0 },
        a.vec_count(a.slot(a.sched_v, conc::SC_BRIDGES)),
        a.events.len());

    // 2. A FRESH ID, ANNOUNCED.
    let mut b = fresh();
    let lb = b.obj(vec![]);
    let p = b.install_bridge_at(7, lb, true);
    let r2 = shown(&b, p, lb);

    // 3. THE SAME ID AGAIN, with a DIFFERENT label, gets the SAME object --
    //    and the host is not told twice.
    let lb2 = b.obj(vec![]);
    let p2 = b.install_bridge_at(7, lb2, true);
    let r3 = format!("{} {} {} {}",
        if p2 == p { 1 } else { 0 },
        if b.slot(p2, conc::PT_LABEL) == lb { 1 } else { 0 },
        b.vec_count(b.slot(b.sched_v, conc::SC_BRIDGES)),
        b.events.len());

    // 4. NOT ANNOUNCED when the host did not ask.
    let mut c = fresh();
    let lc = c.obj(vec![]);
    c.install_bridge_at(3, lc, false);
    let r4 = format!("{} {}", c.vec_count(c.slot(c.sched_v, conc::SC_BRIDGES)), c.events.len());

    // 5. THE SYSTEM PORT: recorded in `SC_SYSTEM`, and never announced.
    let mut d = fresh();
    let ld = d.obj(vec![]);
    let sp = d.install_system_at(9, ld);
    let r5 = format!("{} {} {}",
        if d.slot(d.sched_v, conc::SC_SYSTEM) == sp { 1 } else { 0 },
        d.events.len(),
        d.sched_calls);

    println!("{} | {} | {} | {} | {}", r1, r2, r3, r4, r5);
}
--java-head
    // THE SAME TOY, field for field.
    static final long NIL = 0xFFFF000000000000L;
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static boolean isNil(long v) { return v == NIL; }
        static long fixnum(long n) { return n; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
    }
    static long fx(long v) { return v; }
    static final class Conc {
        static final int PT_ID = 0, PT_STATE = 1, PT_LABEL = 2, PT_KIND = 3;
        static final int SC_BRIDGES = 0, SC_SYSTEM = 1;
        static final long K_BRIDGE = 1, P_OPEN = 1, EV_RETAIN = 4;
        static final long DEFAULT_BRIDGE_CAP = 1L << 20;
        static long sched(Rt rt) { return rt.schedV; }
        static long ensureSched(Rt rt) { rt.schedCalls++; return rt.schedV; }
        static long portById(Rt rt, long id) {
            for (int i = 0; i < rt.portIds.size(); i++)
                if (rt.portIds.get(i) == id) return rt.portVals.get(i);
            return NIL;
        }
        static void pushEvent(Rt rt, long k, long a, long b, long p) {
            rt.evKind.add(k); rt.evId.add(a);
        }
    }
    // BARE, not on a class: `kin/scripts/gen` strips the imports, so a call
    // into another kin namespace lands unqualified in the probe.
    static long newPortAt(Rt rt, long cap, long label, long kind, long state, long id) {
        long p = rt.obj(new long[]{id, state, label, kind});
        rt.portIds.add(id); rt.portVals.add(p);
        return p;
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<Long> roots = new java.util.ArrayList<>();
        java.util.List<Long> portIds = new java.util.ArrayList<>();
        java.util.List<Long> portVals = new java.util.ArrayList<>();
        java.util.List<Long> evKind = new java.util.ArrayList<>();
        java.util.List<Long> evId = new java.util.ArrayList<>();
        long schedV = NIL;
        int schedCalls = 0;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
        void setSlot(long v, int i, long x) { objs.get((int) v)[i] = x; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
    }
    static long vecConj(Rt rt, long v, long x) {
        long[] cur = rt.objs.get((int) v);
        long[] next = java.util.Arrays.copyOf(cur, cur.length + 1);
        next[cur.length] = x;
        return rt.obj(next);
    }
    static int vecCount(Rt rt, long v) { return rt.objs.get((int) v).length; }
--java
    static Rt fresh() {
        Rt rt = new Rt();
        long brs = rt.obj(new long[0]);
        rt.schedV = rt.obj(new long[]{brs, NIL});
        return rt;
    }
    static String shown(Rt rt, long p, long label) {
        long brs = rt.slot(rt.schedV, Conc.SC_BRIDGES);
        StringBuilder ev = new StringBuilder();
        for (int i = 0; i < rt.evKind.size(); i++) {
            if (ev.length() > 0) ev.append(',');
            ev.append(rt.evKind.get(i)).append(':').append(rt.evId.get(i));
        }
        return rt.slot(p, Conc.PT_KIND) + " " + rt.slot(p, Conc.PT_STATE)
             + " " + rt.slot(p, Conc.PT_ID)
             + " " + (rt.slot(p, Conc.PT_LABEL) == label ? 1 : 0)
             + " " + vecCount(rt, brs)
             + " " + (ev.length() == 0 ? "-" : ev.toString());
    }
    public static void main(String[] args) {
        Rt a = fresh();
        long la = a.obj(new long[0]);
        String r1 = (Val.isNil(installBridgeAt(a, -1, la, true)) ? 1 : 0)
                  + " " + vecCount(a, a.slot(a.schedV, Conc.SC_BRIDGES))
                  + " " + a.evKind.size();

        Rt b = fresh();
        long lb = b.obj(new long[0]);
        long p = installBridgeAt(b, 7, lb, true);
        String r2 = shown(b, p, lb);

        long lb2 = b.obj(new long[0]);
        long p2 = installBridgeAt(b, 7, lb2, true);
        String r3 = (p2 == p ? 1 : 0) + " " + (b.slot(p2, Conc.PT_LABEL) == lb ? 1 : 0)
                  + " " + vecCount(b, b.slot(b.schedV, Conc.SC_BRIDGES))
                  + " " + b.evKind.size();

        Rt c = fresh();
        long lc = c.obj(new long[0]);
        installBridgeAt(c, 3, lc, false);
        String r4 = vecCount(c, c.slot(c.schedV, Conc.SC_BRIDGES)) + " " + c.evKind.size();

        Rt d = fresh();
        long ld = d.obj(new long[0]);
        long sp = installSystemAt(d, 9, ld);
        String r5 = (d.slot(d.schedV, Conc.SC_SYSTEM) == sp ? 1 : 0)
                  + " " + d.evKind.size() + " " + d.schedCalls;

        System.out.println(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5);
    }
--csharp-head
    // THE SAME TOY AGAIN, in this target's spelling.
    const long NIL = unchecked((long)0xFFFF000000000000UL);
    static class Val {
        public const long Nil = unchecked((long)0xFFFF000000000000UL);
        public static bool IsNil(long v) => v == Nil;
        public static long Fixnum(long n) => n;
        public static long AsHeap(long v) => v;
        public static long AsFixnum(long v) => v;
    }
    static long Fx(long v) => v;
    static class Conc {
        public const int PT_ID = 0, PT_STATE = 1, PT_LABEL = 2, PT_KIND = 3;
        public const int SC_BRIDGES = 0, SC_SYSTEM = 1;
        public const long K_BRIDGE = 1, P_OPEN = 1, EV_RETAIN = 4;
        public const long DEFAULT_BRIDGE_CAP = 1L << 20;
        public static long Sched(Rt rt) => rt.SchedV;
        public static long EnsureSched(Rt rt) { rt.SchedCalls++; return rt.SchedV; }
        public static long PortById(Rt rt, long id) {
            for (int i = 0; i < rt.PortIds.Count; i++)
                if (rt.PortIds[i] == id) return rt.PortVals[i];
            return Val.Nil;
        }
        public static void PushEvent(Rt rt, long k, long a, long b, long p) {
            rt.EvKind.Add(k); rt.EvId.Add(a);
        }
    }
    // BARE, not on a class -- see the Java head.
    static long NewPortAt(Rt rt, long cap, long label, long kind, long state, long id) {
        long p = rt.MakeObj(new long[]{ id, state, label, kind });
        rt.PortIds.Add(id); rt.PortVals.Add(p);
        return p;
    }
    public class Rt {
        public System.Collections.Generic.List<long[]> Objs = new System.Collections.Generic.List<long[]>();
        public System.Collections.Generic.List<long> Roots = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortVals = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> EvKind = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> EvId = new System.Collections.Generic.List<long>();
        public long SchedV = NIL;
        public int SchedCalls = 0;
        public long MakeObj(long[] slots) { Objs.Add(slots); return Objs.Count - 1; }
        public long Slot(long v, int i) => Objs[(int) v][i];
        public void SetSlot(long v, int i, long x) { Objs[(int) v][i] = x; }
        public int Mark() => Roots.Count;
        public int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        public long R(int i) => Roots[i];
        public void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
    }
    static long VecConj(Rt rt, long v, long x) {
        var cur = rt.Objs[(int) v];
        var next = new long[cur.Length + 1];
        System.Array.Copy(cur, next, cur.Length);
        next[cur.Length] = x;
        return rt.MakeObj(next);
    }
    static int VecCount(Rt rt, long v) => rt.Objs[(int) v].Length;
--csharp
    static Rt Fresh() {
        var rt = new Rt();
        long brs = rt.MakeObj(new long[0]);
        rt.SchedV = rt.MakeObj(new long[]{ brs, NIL });
        return rt;
    }
    static string Shown(Rt rt, long p, long label) {
        long brs = rt.Slot(rt.SchedV, Conc.SC_BRIDGES);
        var ev = new System.Collections.Generic.List<string>();
        for (int i = 0; i < rt.EvKind.Count; i++) ev.Add(rt.EvKind[i] + ":" + rt.EvId[i]);
        return rt.Slot(p, Conc.PT_KIND) + " " + rt.Slot(p, Conc.PT_STATE)
             + " " + rt.Slot(p, Conc.PT_ID)
             + " " + (rt.Slot(p, Conc.PT_LABEL) == label ? 1 : 0)
             + " " + VecCount(rt, brs)
             + " " + (ev.Count == 0 ? "-" : string.Join(",", ev));
    }
    static void Main() {
        var a = Fresh();
        long la = a.MakeObj(new long[0]);
        string r1 = (Val.IsNil(InstallBridgeAt(a, -1, la, true)) ? 1 : 0)
                  + " " + VecCount(a, a.Slot(a.SchedV, Conc.SC_BRIDGES))
                  + " " + a.EvKind.Count;

        var b = Fresh();
        long lb = b.MakeObj(new long[0]);
        long p = InstallBridgeAt(b, 7, lb, true);
        string r2 = Shown(b, p, lb);

        long lb2 = b.MakeObj(new long[0]);
        long p2 = InstallBridgeAt(b, 7, lb2, true);
        string r3 = (p2 == p ? 1 : 0) + " " + (b.Slot(p2, Conc.PT_LABEL) == lb ? 1 : 0)
                  + " " + VecCount(b, b.Slot(b.SchedV, Conc.SC_BRIDGES))
                  + " " + b.EvKind.Count;

        var c = Fresh();
        long lc = c.MakeObj(new long[0]);
        InstallBridgeAt(c, 3, lc, false);
        string r4 = VecCount(c, c.Slot(c.SchedV, Conc.SC_BRIDGES)) + " " + c.EvKind.Count;

        var d = Fresh();
        long ld = d.MakeObj(new long[0]);
        long sp = InstallSystemAt(d, 9, ld);
        string r5 = (d.Slot(d.SchedV, Conc.SC_SYSTEM) == sp ? 1 : 0)
                  + " " + d.EvKind.Count + " " + d.SchedCalls;

        System.Console.WriteLine(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5);
    }
--expect
1 0 0 | 1 1 7 1 1 4:7 | 1 1 1 1 | 1 0 | 1 0 1
--expect-why
DERIVED FROM WHAT INSTALLING A HOST PORT PROMISES.

  Case 1, a NEGATIVE ID: `1 0 0` -- nil is returned, the held list is still
  empty, and the host was told nothing. Ids come from the host and -1 is the
  absent marker used throughout this runtime; minting a port for it would make
  `port-by-id` answer for a handle nobody holds. All three fields matter: a
  version that refused but had already appended would read `1 1 0`.

  Case 2, a FRESH ID, ANNOUNCED. `<kind> <state> <id> <label kept> <held>
  <events>`:

    `1`     K_BRIDGE. It crosses a heap, which is what makes it the host's.
    `1`     P_OPEN, usable immediately -- a host that installs a port has not
            asked for anything and has nothing to wait for.
    `7`     THE HOST'S OWN ID, used as given. A bridge's id is the host's and
            not this sandbox's counter, which is why `new-port-at` takes one.
    `1`     the label given is the label kept.
    `1`     RECORDED AS HELD. `reap-all` walks that list to notice the script
            has dropped the handle; a bridge missing from it is never released
            and the host holds it for ever.
    `4:7`   ONE `EV_RETAIN` NAMING THAT ID. The host's count of holders is
            built from these.

  Case 3, THE SAME ID AGAIN with a DIFFERENT label: `1 1 1 1`.

    `1`     **THE SAME OBJECT COMES BACK.** Two objects for one host id would
            give the sandbox two ends of a bridge the host thinks is one, and
            closing either would leave the other live.
    `1`     AND ITS LABEL IS THE FIRST ONE. The second call's label is
            discarded rather than overwriting -- the port already exists and
            renaming it would make an earlier diagnostic refer to a name
            nothing has any more.
    `1`     the held list still has ONE entry, not two.
    `1`     **AND THE HOST IS NOT TOLD TWICE.** One retain per handle; a
            second here is a retain no release will ever match, and the host
            holds the port for ever.

  Case 4, NOT ANNOUNCED: `1 0` -- held, but silent. The flag controls only
  whether the host hears, never whether the port is recorded.

  Case 5, THE SYSTEM PORT: `1 0 1`.

    `1`     recorded in `SC_SYSTEM`, where `drive` looks for it every
            iteration rather than searching.
    `0`     **AND NEVER ANNOUNCED.** It is the host's own end of the door
            rather than a handle the host asked for; a retain here would never
            be matched by a release.
    `1`     `ensure-sched` WAS called. The ordering it takes part in cannot be
            seen from here -- nothing in this fixture collects -- but its
            PRESENCE can, and a version that dropped it would build a port
            with no scheduler to record it in. The order itself is guarded by
            the GC-stress row in `bin/conform-hosts`, which is where the bug
            this file was written for is actually caught.
