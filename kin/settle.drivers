    static Rt Fresh() {
        Rt rt = new Rt();
        rt.frames.L.Add(1); rt.handlers.L.Add(1);
        return rt;
    }
    static string Name(Rt rt, long v, long on, long err, long res, long stk) {
        if (v == NIL) return "-";
        if (v == on) return "on";
        if (v == err) return "e";
        if (v == res) return "r";
        if (v == stk) return "s";
        if (v == rt.binds) return "b";
        return "?";
    }
    static string After(Rt rt, long th, long on, long err, long res, long stk) {
        bool loaded = !(rt.frames.IsEmpty() && rt.handlers.IsEmpty() && rt.roots.StackTop == 0);
        return rt.Slot(th, Conc.TH_STATUS)
            + ":" + Name(rt, rt.Slot(th, Conc.TH_PARK_ON), on, err, res, stk)
            + ":" + Name(rt, rt.Slot(th, Conc.TH_RESULT), on, err, res, stk)
            + ":" + Name(rt, rt.Slot(th, Conc.TH_STACK), on, err, res, stk)
            + ":" + Name(rt, rt.Slot(th, Conc.TH_BINDINGS), on, err, res, stk)
            + ":" + (rt.parkOn == NIL ? "-" : "P")
            + ":" + (rt.thrown == NIL ? "-" : "T")
            + ":" + rt.saves
            + ":" + (rt.saw == NIL ? "-" : "P")
            + ":" + rt.woke
            + ":" + (loaded ? 1 : 0)
            + ":" + rt.rootv.Count;
    }
    static string Run(int kind, bool thrownIsErr) {
        Rt rt = Fresh();
        long b = rt.Obj(new long[]{});
        long e = rt.Obj(new long[]{});
        long s = rt.Obj(new long[]{});
        long res = rt.Obj(new long[]{});
        long th = rt.Obj(new long[]{Conc.ST_RUNNABLE, NIL, NIL, s, NIL});
        long on = kind == 1 ? rt.Obj(new long[]{})
                : kind == 2 ? Conc.PARK_YIELD
                : kind == 3 ? 5 : NIL;
        rt.binds = b; rt.cur = th; rt.parkOn = on;
        if (thrownIsErr) rt.thrown = e;
        SettleThread(rt, res);
        return After(rt, th, on, e, res, s);
    }
    static void Main() {
        Rt a = Fresh();
        long ae = a.Obj(new long[]{});
        a.thrown = ae;
        SettleThread(a, NIL);
        string r1 = a.saves + ":" + a.woke + ":" + (a.frames.IsEmpty() ? 0 : 1)
                    + ":" + (a.thrown == NIL ? "-" : "T");
        string r2 = Run(1, true);
        string r3 = Run(2, true);
        string r4 = Run(3, true);
        string r5 = Run(0, true);
        string r6 = Run(0, false);
        System.Console.WriteLine(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5 + " | " + r6);
    }
--expect
0:0:1:T | 2:on:-:s:b:-:-:1:-:0:1:0 | 1:-:-:s:b:-:-:1:-:0:1:0 | 2:on:-:s:b:-:-:1:-:0:1:0 | 4:-:e:s:b:-:-:0:-:1:0:0 | 3:-:r:-:b:-:-:0:-:1:0:0
--expect-why
DERIVED FROM THE CONTRACT, not recorded from a run. Twelve fields per thread
row: the five slots `settle` writes, the two runtime fields it consumes, the
two stubbed acts, the wake count, whether the interpreter is still loaded, and
how many roots are left behind.

1  NO SCHEDULER, AND AN ERROR IN FLIGHT -- `0:0:1:T`. Nothing saved, nothing
   woken, the interpreter untouched, AND the error still set. A program with
   no threads still runs its entry, and the host boundary is what reads
   `thrown` afterwards; consuming it here would lose the only copy.

2  A PARK, WITH THE SENTINEL STILL SET -- `2:on:...:-:-:1:-:0:1:0`. `2` is
   `ST_PARKED`, `on` is the key it waits on, and both runtime fields come back
   `-`: the park cleared BOTH. THIS ROW IS THE ORDER TEST. A park travels as
   `thrown = PARK`, so a parked thread is also a thrown one; ask about the
   throw first and this row reads `4:-:e:s:b:-:-:0:-:1:0:0` -- a failure, with
   the sentinel recorded as the thread's result and its joiners woken.

3  A COURTESY YIELD -- `1:-:...:1:-:0:1:0`. `1` is `ST_RUNNABLE` and
   `TH_PARK_ON` is `-`: it waits for nothing, so `pick` may choose it again
   with no wake at all. The saves count is still `1` -- BOTH park branches
   save a continuation, because the thread was interrupted mid-execution
   either way. Only the status and the wake key differ.

4  A PARK ON A FIXNUM THAT IS NOT `PARK_YIELD` -- `2:on:...`, the same as row
   2. The yield test compares BITS against one value. "Is it a fixnum" and "is
   it not a heap object" both read this row as a yield and answer `1:-:...`,
   and both are the mistake an author reaches for when `PARK_YIELD` is spelled
   as the fixnum zero.

5  A FAILURE -- `4:-:e:s:b:-:-:0:-:1:0:0`. The error becomes `TH_RESULT`,
   which is what makes a dead thread impossible to ignore: its joiner
   re-throws it. `e` REQUIRES THE PUSH BEFORE THE CLEAR -- `thrown` is not a
   root, so the order is forced, and clearing first reads `-`. No save, one
   wake, and `0` for the interpreter: a thread that is off has no frames, no
   handlers and nothing rooted.

6  A CLEAN FINISH -- `3:-:r:-:b:...`. The result is the value, and `TH_STACK`
   is `-`: cleared, unlike row 5's `s`. That asymmetry is deliberate. A failed
   thread's continuation is still on the object because nothing has decided it
   is unreachable; a done thread's never runs again, and holding it holds its
   whole heap.

`b` IN EVERY THREAD ROW. Bindings are saved before the branch, on all three
paths, rather than on the one path that will read them back.

`0` IN THE LAST FIELD OF EVERY THREAD ROW. Every path pops to the mark it
took, including the two that return early.

FIELD 9 IS THE ROOTING RULE. The toy's `save_current_state` records `park_on`
as it sees it, and the real one allocates while `park_on` is scanned by no
root walk on any runtime. `-` says the clear already happened. Move the clear
below the save and every park row reads `P`.
