;; THE OBJECT HEADER, read. Two 32-bit words in front of every heap object.
;;
;;   word 0   bits 31..24  the type tag        bits 23..21  the age
;;            bit  20      marked              bit  19      in the remset
;;            bit  18      this string is ascii
;;   word 1   the length, whose UNIT depends on the layout
;;
;; ROOTED AT THE SPACE, not at the `Rt`, and that is the whole reason this
;; file needed a new tag before it could exist. Every other memory word in the
;; vocabulary reaches memory as `{0}.gc.sp.read_u64(...)`, which is right for
;; generated code that already holds an `Rt`. The header layer cannot hold
;; one: the collector reads these from `&mut self` methods of `Gc`, and `Gc`
;; is a field of `Rt`, so borrowing the whole `Rt` there does not compile.
;; `sp-read-u32` takes the space as argument zero instead.
;;
;; THE THREE COPIES ALREADY AGREED. Before porting, every shift and mask in
;; all three runtimes was extracted and compared -- fifteen functions, and
;; they match exactly. So this is a consolidation and not a bug fix, which is
;; worth saying plainly: the value is that the next change to the header is
;; made once rather than three times.
;;
;; THE WRITERS ARE HERE TOO, and the read-modify-write they do is the reason
;; `bit-not` had to be added: clearing a field in place is `w & ~(7 << 21)`,
;; and Rust spells the complement `!` where both ports say `~`. Nothing else
;; generated had ever cleared a field, so no source had needed the word.
;;
;; THE FORWARD PAIR splits a 48-bit address across both header words: the top
;; 24 bits share word zero with the `TY_FWD` tag, and the low 32 are word one.
;; It needed `addr-of-u32`, a widening that ZERO-extends -- `to-addr` is the
;; trap, since on both ports it emits nothing and a low word at or above 2^31
;; would widen with its sign into an address with its top 32 bits set.
;;
;; The names are prefixed because `ty` and `len` are VOCABULARY WORDS -- `(ty
;; rt (as-heap v))` is how ten sources ask a value's type -- and a `^:pub`
;; function shadows a word of the same name across the whole project.
(ns flint.rt.objhdr
  (:require [flint.impl.rt :refer [defn return comment doc if != + bit-and bit-or
                                   bit-not shl ushr ushr64 to-i32 addr-of-u32 TY_FWD
                                   Space Addr I32 U32 Bool
                                   sp-read-u32 sp-write-u32]]
))

(doc "The type tag: the top byte of word zero."
     ""
     "Answered as an `I32` rather than a `Ty` so that one spelling serves all"
     "three targets -- native's `ty` narrows to `u8` in its own wrapper, and"
     "both ports call a `Ty` an `int` already.")
(defn ^:pub ^I32 obj-ty [^Space sp ^Addr a]
  (return (ushr (sp-read-u32 sp a) 24)))

(doc "The length word, whose UNIT is the layout's business and not this"
     "file's: slots for a vals layout, bytes for a string, and for a free"
     "block the size of the block itself."
     ""
     "`U32` AND NOT `I32`, which is the one place these six differ from each"
     "other. `I32` promises its high bit is clear; a FREE BLOCK's size has"
     "made no such promise, which is why `size-of` reaches for"
     "`Integer.toUnsignedLong` on the jvm rather than using the value as it"
     "stands. Same host types either way -- `u32` and `int` -- so this changes"
     "no generated character; it changes what the next reader is told.")
(defn ^:pub ^U32 obj-len [^Space sp ^Addr a]
  (return (sp-read-u32 sp (+ a 4))))

(doc "How many collections this object has survived, three bits of it."
     ""
     "Masked to 7 AFTER the shift, because the tag sits above it and would"
     "otherwise come along.")
(defn ^:pub ^I32 obj-age [^Space sp ^Addr a]
  (return (bit-and (ushr (sp-read-u32 sp a) 21) 7)))

(doc "The mark bit, bit 20.")
(defn ^:pub ^Bool obj-marked [^Space sp ^Addr a]
  (return (!= (bit-and (sp-read-u32 sp a) (shl 1 20)) 0)))

(doc "In the remembered set, bit 19: an old object holding a young pointer.")
(defn ^:pub ^Bool obj-in-remset [^Space sp ^Addr a]
  (return (!= (bit-and (sp-read-u32 sp a) (shl 1 19)) 0)))

(doc "This string's bytes are all ascii, bit 18, so its length in characters"
     "is its length in bytes and indexing need not decode.")
(defn ^:pub ^Bool obj-str-ascii [^Space sp ^Addr a]
  (return (!= (bit-and (sp-read-u32 sp a) (shl 1 18)) 0)))

(doc "Stamp a fresh header: the type in the top byte of word zero, the length"
     "in word one, and EVERY OTHER FIELD CLEARED -- age zero, unmarked, not in"
     "the remset, not ascii. That is what makes it a `write` rather than a"
     "`set`: it does not read the old word, so a recycled address cannot"
     "inherit a mark or an age from whatever lived there before.")
(defn ^:pub obj-write-header [^Space sp ^Addr a ^I32 ty ^U32 len]
  (sp-write-u32 sp a (shl ty 24))
  (sp-write-u32 sp (+ a 4) len))

(doc "Set the age, bits 23..21, leaving every other field alone."
     ""
     "The age is masked to 7 BEFORE it is shifted in, so a caller passing 8"
     "cannot write into the type tag above it, and the destination is cleared"
     "with `~(7 << 21)` first so the old age does not OR through.")
(defn ^:pub obj-set-age [^Space sp ^Addr a ^I32 age]
  (sp-write-u32 sp a (bit-or (bit-and (sp-read-u32 sp a) (bit-not (shl 7 21)))
                             (shl (bit-and age 7) 21))))

(doc "Set or clear the mark bit, bit 20.")
(defn ^:pub obj-set-marked [^Space sp ^Addr a ^Bool m]
  (if m
    (sp-write-u32 sp a (bit-or (sp-read-u32 sp a) (shl 1 20)))
    (sp-write-u32 sp a (bit-and (sp-read-u32 sp a) (bit-not (shl 1 20))))))

(doc "Set or clear the remembered-set bit, bit 19.")
(defn ^:pub obj-set-in-remset [^Space sp ^Addr a ^Bool m]
  (if m
    (sp-write-u32 sp a (bit-or (sp-read-u32 sp a) (shl 1 19)))
    (sp-write-u32 sp a (bit-and (sp-read-u32 sp a) (bit-not (shl 1 19))))))

(doc "Set or clear the ascii bit, bit 18.")
(defn ^:pub obj-set-str-ascii [^Space sp ^Addr a ^Bool v]
  (if v
    (sp-write-u32 sp a (bit-or (sp-read-u32 sp a) (shl 1 18)))
    (sp-write-u32 sp a (bit-and (sp-read-u32 sp a) (bit-not (shl 1 18))))))

(doc "Stamp a forwarding pointer: this object has MOVED, and `dest` is where."
     ""
     "A forwarded object's new address does not fit in the length word any"
     "more, so it is split -- the top 24 bits share word zero with the"
     "`TY_FWD` tag, the low 32 are word one. 24 + 32 is 56, comfortably past"
     "the 48 bits an address actually uses."
     ""
     "The high half is masked to 24 bits so it cannot reach up into the tag"
     "it shares the word with.")
(defn ^:pub obj-set-forward [^Space sp ^Addr a ^Addr dest]
  (sp-write-u32 sp a (bit-or (shl (to-i32 TY_FWD) 24)
                             (to-i32 (bit-and (ushr64 dest 32) 16777215))))
  (sp-write-u32 sp (+ a 4) (to-i32 dest)))

(doc "Read a forwarding pointer back."
     ""
     "`addr-of-u32` AND NOT `to-addr` on the low word, which is the whole"
     "hazard here: a low word at or above 2^31 has its high bit set, and"
     "widening it with its sign yields an address with all 32 top bits set"
     "rather than the address that was written. All three hand-written"
     "versions got this right by three different routes -- `as Addr`,"
     "`Integer.toUnsignedLong`, a trip through `uint` -- and the word is what"
     "keeps the fourth from getting it wrong.")
(defn ^:pub ^Addr obj-forward-target [^Space sp ^Addr a]
  (return (bit-or (shl (addr-of-u32 (bit-and (sp-read-u32 sp a) 16777215)) 32)
                  (addr-of-u32 (sp-read-u32 sp (+ a 4))))))

(doc "Round an address up to the next multiple of eight."
     ""
     "Every object starts on an eight-byte boundary, so the two layouts whose"
     "size is a BYTE count round and the one measured in slots does not.")
(defn ^:pub ^Addr obj-align8 [^Addr n]
  (return (bit-and (+ n 7) (bit-not 7))))
