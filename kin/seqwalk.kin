;; Walking a seq: `first`, `next` and `rest`.
;;
;; Both start by calling `seq`, so neither has to know what a collection is --
;; only what a SEQ is, which is one of four heap shapes:
;;
;;     TY_CONS     a cell, with the value in slot 0
;;     TY_VECSEQ   an indexed collection and a position
;;     TY_STRSEQ   a string and a CODE POINT index
;;     TY_RANGE    start, end, step -- computed, never stored
;;
;; `first` had FOUR divergences before it could be written once, and no two
;; were settled the same way. A map entry rides `TY_VECSEQ` directly rather
;; than being copied into a vector (measured: 13.9% off a map walk). The string
;; index is code points, not bytes (the byte version read a rope's header as
;; text). And the two sentinels below -- what `nth` answers past the end, and
;; what the default arm answers -- were probed to be unreachable and then given
;; the simpler answer.
;;
;; NO DEFAULT ARM WORTH RAISING FROM. `seq` answers nil or one of the four
;; above, so nothing reaches the end of either dispatch. Both return nil, which
;; is what a total `match` needs in Rust and what the probe says can never be
;; seen.
(ns flint.rt.seqwalk
  (:require [flint.impl.rt :refer [defn return if let do comment doc
                                   not and == + >= local set while break set-slot
                                   slot as-fixnum to-i32 nil? as-heap ty
                                   seq-of vec-nth vec-count char-at char-len
                                   table-ref table-count num-add
                                   empty-list invoke-thunk
                                   mark push r set-r pop-to is-heap
                                   is-fixnum
                                   TY_LAZYSEQ LS_THUNK LS_SEQ RootIx
                                   Rt Value I32 Ty NIL
                                   C_FIRST C_REST
                                   TY_CONS TY_VECSEQ TY_STRSEQ TY_RANGE
                                   TY_MAPENTRY TY_TABLE]]
            [flint.rt.seqs :refer [vecseq strseq range]]
            [flint.rt.seqcore :refer [count-hint]]))

(doc "The first element of `v`, or nil when there is none.")
(defn ^:pub ^:method ^Value first [^:mut ^Rt rt ^Value v]
  (let [^Value s (seq-of rt v)]
    (if (nil? rt s)
      (return NIL))
    (let [^Ty t (ty rt (as-heap s))]
      (if (== t TY_CONS)
        (return (slot rt s C_FIRST)))
      (if (== t TY_VECSEQ)
        (do
          (let [^Value coll (slot rt s 0)
                ^I32 i (to-i32 (as-fixnum (slot rt s 1)))]
            (comment "A MAP ENTRY rides the same vecseq, read directly. A"
                     "TABLE rides it too and answers a ROW REF, which is the"
                     "one thing about a table seq that differs"
                     "(`doc/decisions/0026`).")
            (if (== (ty rt (as-heap coll)) TY_MAPENTRY)
              (return (slot rt coll i)))
            (if (== (ty rt (as-heap coll)) TY_TABLE)
              (return (table-ref rt coll i)))
            (return (vec-nth rt coll i NIL)))))
      (if (== t TY_STRSEQ)
        (return (char-at rt (slot rt s 0) (to-i32 (as-fixnum (slot rt s 1))) NIL)))
      (if (== t TY_RANGE)
        (return (slot rt s 0)))
      (return NIL))))

(doc "The seq after the first element, or nil when it is exhausted.")
(defn ^:pub ^:method ^Value next [^:mut ^Rt rt ^Value v]
  (let [^Value s (seq-of rt v)]
    (if (nil? rt s)
      (return NIL))
    (let [^Ty t (ty rt (as-heap s))]
      (if (== t TY_CONS)
        (return (seq-of rt (slot rt s C_REST))))
      (if (== t TY_VECSEQ)
        (do
          (let [^Value coll (slot rt s 0)
                ^I32 i (to-i32 (as-fixnum (slot rt s 1)))]
            (local ^:mut ^I32 n)
            (if (== (ty rt (as-heap coll)) TY_MAPENTRY)
              (set n 2)
              (if (== (ty rt (as-heap coll)) TY_TABLE)
                (set n (table-count rt coll))
                (set n (vec-count rt coll))))
            (if (>= (+ i 1) n)
              (return NIL))
            (return (vecseq rt coll (+ i 1))))))
      (if (== t TY_STRSEQ)
        (do
          (let [^Value st (slot rt s 0)
                ^I32 i (to-i32 (as-fixnum (slot rt s 1)))]
            (if (>= (+ i 1) (char-len rt st))
              (return NIL))
            (return (strseq rt st (+ i 1))))))
      (if (== t TY_RANGE)
        (do
          (comment "A FRESH range, not a mutated cursor: a range IS a value,"
                   "so walking one must not disturb anything else holding it.")
          (comment "HOISTED. `seq-of` and `range` both take `&mut self` in"
                   "Rust, so nesting them is two mutable borrows at once. The"
                   "other two targets read the hoisted form fine.")
          (let [^Value nstart (num-add rt (slot rt s 0) (slot rt s 2))
                ^Value r (range rt nstart (slot rt s 1) (slot rt s 2))]
            (return (seq-of rt r)))))
      (return NIL))))

(doc "`rest`: the seq after the first element, and NEVER nil."
     ""
     "Clojure's rule, and the difference from `next` is the whole of it: an"
     "exhausted `rest` is the empty list, so `(rest (rest [1]))` is `()` and"
     "keeps being seqable, where `next` answers nil and stops.")
(defn ^:pub ^:method ^Value rest [^:mut ^Rt rt ^Value v]
  (let [^Value n (next rt v)]
    (if (nil? rt n)
      (return (empty-list rt)))
    (return n)))

(doc "Force a lazy seq to whatever it actually is, and CACHE that in it."
     ""
     "A thunk already run leaves `LS_THUNK` nil and the answer in `LS_SEQ`, so"
     "forcing twice runs nothing twice -- which is what makes a lazy seq a"
     "value rather than a generator."
     ""
     "The loop is for CHAINED lazy seqs: a thunk may answer another lazy seq,"
     "and that one another, and only the end of the chain is concrete."
     ""
     "The cursor lives in the ROOT throughout. Rust used to hold it in a host"
     "local with a `set_r` alongside -- correct, because the local was always"
     "overwritten by the result of the call that could have moved it, but"
     "correct by an argument the reader has to rebuild each time. Both ports"
     "already did it this way.")
(defn ^:pub ^:method ^Value force [^:mut ^Rt rt ^Value ls]
  (let [^Value thunk (slot rt ls LS_THUNK)]
    (if (nil? rt thunk)
      (return (slot rt ls LS_SEQ)))
    (let [^RootIx base (mark rt)
          ^RootIx li (push rt ls)
          ^Value first-forced (invoke-thunk rt thunk)
          ^RootIx vi (push rt first-forced)]
      (comment "HOISTED, both calls: `push`, `set-r` and `invoke-thunk` all"
               "take `&mut self` in Rust, so nesting an invoke inside either"
               "is two mutable borrows at once.")
      (while (and (is-heap (r rt vi))
                  (== (ty rt (as-heap (r rt vi))) TY_LAZYSEQ))
        (let [^Value t2 (slot rt (r rt vi) LS_THUNK)]
          (if (nil? rt t2)
            (do (set-r rt vi (slot rt (r rt vi) LS_SEQ))
                (break)))
          (let [^Value forced (invoke-thunk rt t2)]
            (set-r rt vi forced))))
      (let [^Value cur (r rt vi)
            ^Value l (r rt li)]
        (pop-to rt base)
        (set-slot rt l LS_THUNK NIL)
        (set-slot rt l LS_SEQ cur)
        (return cur)))))

(doc "How many elements `v` has -- asking first, walking only if it must."
     ""
     "THE ASK IS THE POINT, and it is what both ports were missing. A vector,"
     "a map, a counted cons chain all know their size without being walked,"
     "and `count-hint` answers it; only when the answer is nil does this walk."
     "Rust had the fast path and the JVM and CLR did not, so `(count v)` was"
     "O(1) on native and O(n) on both ports -- the same function, a different"
     "complexity class, which is not a difference a conform diff can see"
     "because both answers are right."
     ""
     "The cursor lives in the ROOT, not a host local: `next` forces a lazy"
     "seq, forcing allocates, and `doc/decisions/0031` is that a value in a"
     "host local does not survive an allocation.")
(defn ^:pub ^:method ^I32 seq-count [^:mut ^Rt rt ^Value v]
  (let [^Value hint (count-hint rt v)]
    (if (is-fixnum rt hint)
      (return (to-i32 (as-fixnum hint))))
    (let [^RootIx base (mark rt)
          ^Value s (seq-of rt v)
          ^RootIx ci (push rt s)]
      (comment "HOISTED: `seq-of` and `push` both take `&mut self` in Rust.")
      (local ^:mut ^I32 n)
      (set n 0)
      (while (not (nil? rt (r rt ci)))
        (set n (+ n 1))
        (let [^Value nx (next rt (r rt ci))]
          (set-r rt ci nx)))
      (pop-to rt base)
      (return n))))
