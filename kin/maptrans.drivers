namespace Flint.Rt {
    internal static class Eq {
        internal static int HashValue(Probe.Rt rt, long k) { return (int) (k & 0xFF); }
    }
    internal static class Maps {
        internal const int TM_CNT = 0, TM_ROOT = 1, TM_EDIT = 2;
        internal static long Empty(Probe.Rt rt) { return rt.empty; }
    }
    internal static class Sets {
        internal const int S_MAP = 0, S_META = 1, S_HASH = 2;
        internal const int TS_MAP = 0, TS_EDIT = 1;
    }
}
