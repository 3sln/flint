    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.empty = newHashMap(rt, 0, newNode(rt, NIL), NIL);
        StringBuilder o = new StringBuilder();
        long k1 = 0xA1L, k2 = 0xB2L, k3 = 0xC3L;
        long v1 = 0xD4L, v2 = 0xE5L, v3 = 0xF6L;

        long am = newArrayMap(rt, new long[]{k1, v1, k2, v2});
        long t = mapTransient(rt, am);
        o.append("cnt=").append(tmapCount(rt, t))
         .append(" edit=").append(Val.isNil(rt.slot(t, Maps.TM_EDIT)) ? 0 : 1).append(" ");
        o.append("get=").append(tmapGet(rt, t, k1, NIL)).append("/")
         .append(tmapGet(rt, t, k2, NIL)).append("/")
         .append(tmapGet(rt, t, k3, 0x11L)).append(" ");

        long t2 = tmapAssoc(rt, t, k3, v3);
        long t3 = tmapAssoc(rt, t2, k1, v3);
        o.append("same=").append(t2 == t ? 1 : 0).append(t3 == t ? 1 : 0)
         .append(" cnt3=").append(tmapCount(rt, t3))
         .append(" k1=").append(tmapGet(rt, t3, k1, NIL)).append(" ");

        long t4 = tmapDissoc(rt, t3, k2);
        long t5 = tmapDissoc(rt, t4, k2);
        o.append("cnt5=").append(tmapCount(rt, t5))
         .append(" gone=").append(tmapGet(rt, t5, k2, 0x22L) == 0x22L ? 1 : 0).append(" ");

        long p = tmapPersistent(rt, t5);
        o.append("pcnt=").append(mapCount(rt, p)).append(" ");
        rt.thrown = "";
        long after = tmapAssoc(rt, t5, k1, v1);
        o.append("after=").append(Val.isNil(after) ? 1 : 0).append("/")
         .append(rt.thrown.length()).append(" ");

        long e = mapTransient(rt, newArrayMap(rt, new long[]{}));
        long ep = tmapPersistent(rt, e);
        o.append("empty=").append(ep == rt.empty ? 1 : 0).append(" ");

        long sm = newArrayMap(rt, new long[]{k1, k1});
        long s = newSet(rt, sm, NIL);
        long ts = setTransient(rt, s);
        o.append("scnt=").append(tsetCount(rt, ts))
         .append(" sedit=").append(rt.slot(ts, Sets.TS_EDIT)
                 == rt.slot(rt.slot(ts, Sets.TS_MAP), Maps.TM_EDIT) ? 1 : 0).append(" ");
        long ts2 = tsetConj(rt, ts, k2);
        long ts3 = tsetConj(rt, ts2, k2);
        o.append("ssame=").append(ts2 == ts ? 1 : 0).append(ts3 == ts ? 1 : 0)
         .append(" scnt3=").append(tsetCount(rt, ts3))
         .append(" sget=").append(tsetGet(rt, ts3, k2, NIL)).append("/")
         .append(tsetGet(rt, ts3, k3, 0x33L)).append(" ");
        long ts4 = tsetDisj(rt, ts3, k1);
        o.append("sdisj=").append(tsetCount(rt, ts4)).append(" ");
        long sp = tsetPersistent(rt, ts4);
        o.append("sp=").append(mapCount(rt, rt.slot(sp, Sets.S_MAP)))
         .append(" sedit2=").append(Val.isNil(rt.slot(ts4, Sets.TS_EDIT)) ? 1 : 0)
         .append(" smedit=").append(Val.isNil(rt.slot(rt.slot(ts4, Sets.TS_MAP), Maps.TM_EDIT)) ? 1 : 0);
        System.out.println(o.toString());
    }
