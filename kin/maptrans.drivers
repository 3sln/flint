--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_ARRAYMAP: u8 = 12; const TY_HASHMAP: u8 = 13;
const TY_TMAP: u8 = 24; const TY_TSET: u8 = 25;
const TY_SET: u8 = 18; const TY_VOLATILE: u8 = 20; const TY_NODE: u8 = 26;
const HM_CNT: u32 = 0; const HM_ROOT: u32 = 1; const HM_META: u32 = 2;
pub mod map { pub const TM_CNT: u32 = 0; pub const TM_ROOT: u32 = 1; pub const TM_EDIT: u32 = 2; }
pub mod set { pub const S_MAP: u32 = 0; pub const S_META: u32 = 1; pub const S_HASH: u32 = 2;
              pub const TS_MAP: u32 = 0; pub const TS_EDIT: u32 = 1; }
// A FIXNUM IS TAGGED and sign-extends. An untagged small integer falls inside
// the probe's `is_heap` range and gets walked as an address; one that does not
// sign-extend prints a count of -1 as four billion. Both have happened.
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != NOT_FOUND.0 && (self.0 >> 44) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn fixnum(n: i64) -> Value { Value(0x2000_0000_0000u64 | (n as u64 & 0xFFFF_FFFF)) }
    fn as_fixnum(self) -> i64 { ((self.0 & 0xFFFF_FFFF) as u32) as i32 as i64 }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>,
            champ_added: bool, empty: Value, thrown: String }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
// THE NODE'S CAPACITY, fixed. A real CHAMP grows; what this models is only the
// property the transient layer depends on -- a node whose edit token matches
// is written IN PLACE, and one whose does not is copied.
const CAP: u32 = 8;
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 8;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.h[v.0 as usize + i as usize] = x.0; }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.h[v.0 as usize + i as usize]) }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}: {}", class, msg); NIL
    }
    fn hash_value(&mut self, k: Value) -> u32 { (k.0 & 0xFF) as u32 }
    fn empty_map(&self) -> Value { self.empty }
    fn new_edit_token(&mut self) -> Value { let a = self.alloc(TY_VOLATILE, 1); Value::heap(a) }
    fn is_array_map(&self, m: Value) -> bool { m.is_heap() && ty(&self.gc.sp, m.as_heap()) == TY_ARRAYMAP }
    fn map_count(&mut self, m: Value) -> u32 { self.slot(m, HM_CNT).as_fixnum() as u32 }
    fn new_hash_map(&mut self, cnt: u32, root: Value, meta: Value) -> Value {
        let a = self.alloc(TY_HASHMAP, 4);
        self.set_slot(a, HM_CNT, Value::fixnum(cnt as i64));
        self.set_slot(a, HM_ROOT, root);
        self.set_slot(a, HM_META, meta);
        Value::heap(a)
    }
    fn new_set(&mut self, m: Value, meta: Value) -> Value {
        let a = self.alloc(TY_SET, 3);
        self.set_slot(a, set::S_MAP, m);
        self.set_slot(a, set::S_META, meta);
        Value::heap(a)
    }
    // slot 0 is the node's EDIT TOKEN; pairs run from slot 1.
    fn new_node(&mut self, edit: Value) -> Value {
        let a = self.alloc(TY_NODE, 1 + 2 * CAP);
        self.set_slot(a, 0, edit);
        Value::heap(a)
    }
    fn node_at(&mut self, n: Value, k: Value) -> i32 {
        for i in 0..CAP {
            if self.slot(n, 1 + 2 * i).0 == k.0 { return i as i32; }
        }
        -1
    }
    fn node_free(&mut self, n: Value) -> i32 {
        for i in 0..CAP {
            if self.slot(n, 1 + 2 * i).is_nil() { return i as i32; }
        }
        -1
    }
    fn node_find(&mut self, n: Value, _shift: u32, _h: u32, k: Value) -> Value {
        let at = self.node_at(n, k);
        if at < 0 { NOT_FOUND } else { self.slot(n, 2 + 2 * at as u32) }
    }
    fn node_copy(&mut self, n: Value, edit: Value) -> Value {
        let out = self.new_node(edit);
        for i in 0..2 * CAP { let v = self.slot(n, 1 + i); self.set(out, 1 + i, v); }
        out
    }
    fn node_assoc(&mut self, n: Value, _shift: u32, _h: u32, k: Value, v: Value, edit: Value) -> Value {
        let mine = self.slot(n, 0).0 == edit.0;
        let t = if mine { n } else { self.node_copy(n, edit) };
        let at = self.node_at(t, k);
        if at >= 0 {
            self.champ_added = false;
            self.set(t, 2 + 2 * at as u32, v);
            return t;
        }
        self.champ_added = true;
        let f = self.node_free(t);
        self.set(t, 1 + 2 * f as u32, k);
        self.set(t, 2 + 2 * f as u32, v);
        t
    }
    fn node_dissoc(&mut self, n: Value, _shift: u32, _h: u32, k: Value, edit: Value) -> Value {
        let at = self.node_at(n, k);
        if at < 0 { self.champ_added = false; return n; }
        let mine = self.slot(n, 0).0 == edit.0;
        let t = if mine { n } else { self.node_copy(n, edit) };
        let at = self.node_at(t, k);
        self.champ_added = true;
        self.set(t, 1 + 2 * at as u32, NIL);
        self.set(t, 2 + 2 * at as u32, NIL);
        t
    }
    fn promote(&mut self, m: Value) -> Value {
        let n = self.lens[m.0 as usize] / 2;
        let edit = self.new_edit_token();
        let root = self.new_node(edit);
        for i in 0..n {
            let (k, v) = (self.slot(m, 2 * i), self.slot(m, 2 * i + 1));
            self.set(root, 1 + 2 * i, k);
            self.set(root, 2 + 2 * i, v);
        }
        self.new_hash_map(n, root, NIL)
    }
    fn new_array_map(&mut self, pairs: &[Value]) -> Value {
        let a = self.alloc(TY_ARRAYMAP, pairs.len().max(1) as u32);
        self.lens[a as usize] = pairs.len() as u32;
        for (i, p) in pairs.iter().enumerate() { self.h[a as usize + i] = p.0; }
        Value::heap(a)
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 20000], gc: Gc { sp: Space { m: vec![0u8; 20000] } },
                      lens: vec![0; 20000], bump: 100, roots: Vec::new(),
                      champ_added: false, empty: NIL, thrown: String::new() };
    let root0 = rt.new_node(NIL);
    rt.empty = rt.new_hash_map(0, root0, NIL);
    let mut o = String::new();
    let (k1, k2, k3) = (Value(0xA1), Value(0xB2), Value(0xC3));
    let (v1, v2, v3) = (Value(0xD4), Value(0xE5), Value(0xF6));

    // AN ARRAY MAP IS PROMOTED. The transient's count comes from the promoted
    // map, not from the array map it was handed.
    let am = rt.new_array_map(&[k1, v1, k2, v2]);
    let t = rt.map_transient(am);
    o.push_str(&format!("cnt={} edit={} ", rt.tmap_count(t),
                        (!rt.slot(t, map::TM_EDIT).is_nil()) as u32));
    o.push_str(&format!("get={}/{}/{} ", rt.tmap_get(t, k1, NIL).0,
                        rt.tmap_get(t, k2, NIL).0, rt.tmap_get(t, k3, Value(0x11)).0));

    // ASSOC ANSWERS THE SAME HANDLE, and only a NEW key moves the count.
    let t2 = rt.tmap_assoc(t, k3, v3);
    let t3 = rt.tmap_assoc(t2, k1, v3);
    o.push_str(&format!("same={}{} cnt3={} k1={} ", (t2.0 == t.0) as u32,
                        (t3.0 == t.0) as u32, rt.tmap_count(t3), rt.tmap_get(t3, k1, NIL).0));

    // DISSOC of an absent key leaves the count alone.
    let t4 = rt.tmap_dissoc(t3, k2);
    let t5 = rt.tmap_dissoc(t4, k2);
    o.push_str(&format!("cnt5={} gone={} ", rt.tmap_count(t5),
                        (rt.tmap_get(t5, k2, Value(0x22)).0 == 0x22) as u32));

    // PERSISTENT! FREEZES IT, and the handle is refused afterwards.
    let p = rt.tmap_persistent(t5);
    o.push_str(&format!("pcnt={} ", rt.map_count(p)));
    rt.thrown.clear();
    let after = rt.tmap_assoc(t5, k1, v1);
    o.push_str(&format!("after={}/{} ", after.is_nil() as u32, rt.thrown.len()));

    // AN EMPTY TRANSIENT FREEZES TO THE SHARED EMPTY MAP, by identity.
    let em = rt.new_array_map(&[]);
    let e = rt.map_transient(em);
    let ep = rt.tmap_persistent(e);
    o.push_str(&format!("empty={} ", (ep.0 == rt.empty.0) as u32));

    // THE SET SIDE, which is the map side wearing a different tag.
    let sm = rt.new_array_map(&[k1, k1]);
    let s = rt.new_set(sm, NIL);
    let ts = rt.set_transient(s);
    o.push_str(&format!("scnt={} sedit={} ", rt.tset_count(ts),
                        (rt.slot(ts, set::TS_EDIT).0 == rt.slot(rt.slot(ts, set::TS_MAP), map::TM_EDIT).0) as u32));
    let ts2 = rt.tset_conj(ts, k2);
    let ts3 = rt.tset_conj(ts2, k2);
    o.push_str(&format!("ssame={}{} scnt3={} sget={}/{} ", (ts2.0 == ts.0) as u32,
                        (ts3.0 == ts.0) as u32, rt.tset_count(ts3),
                        rt.tset_get(ts3, k2, NIL).0, rt.tset_get(ts3, k3, Value(0x33)).0));
    let ts4 = rt.tset_disj(ts3, k1);
    o.push_str(&format!("sdisj={} ", rt.tset_count(ts4)));
    let sp = rt.tset_persistent(ts4);
    // BOTH HANDLES ARE INVALIDATED. Native nilled only the inner map's token,
    // so the set's own said it was still live.
    o.push_str(&format!("sp={} sedit2={} smedit={}",
                        rt.map_count(rt.slot(sp, set::S_MAP)),
                        rt.slot(ts4, set::TS_EDIT).is_nil() as u32,
                        rt.slot(rt.slot(ts4, set::TS_MAP), map::TM_EDIT).is_nil() as u32));
    println!("{}", o);
}
