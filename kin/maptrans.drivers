    // `hash-value` IS `valhash`'s OWN now, so it is called BARE.
    internal static int HashValue(Rt rt, long v) { return global::Flint.Rt.Eq.HashValue(rt, v); }
    internal const long NIL = 0xFFFFL;
    internal const long NOT_FOUND = 0xFFFEL;
    internal const int TY_ARRAYMAP = 12, TY_HASHMAP = 13;
    internal const int TY_SET = 18, TY_VOLATILE = 20, TY_NODE = 26;
    internal const int HM_CNT = 0, HM_ROOT = 1, HM_META = 2;
    internal const int CAP = 8;
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal const long NotFound = Probe.NOT_FOUND;
        internal static bool IsHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >> 44) == 0; }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == NIL; }
        internal static long Fixnum(long n) { return 0x200000000000L | (n & 0xFFFFFFFFL); }
        internal static long AsFixnum(long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[20000]; }
    internal sealed class Rt {
        internal long[] h = new long[20000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[20000];
        internal long bump = 100;
        internal bool champAdded = false;
        internal long empty = NIL;
        internal string thrown = "";
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 8;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal void Set(long v, int i, long x) { h[(int) v + i] = x; }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
        internal long ThrowStr(string cls, string msg) { thrown = cls + ": " + msg; return NIL; }
        internal long EmptyMap() { return empty; }
    }
    internal static class Obj {
        internal const int TyTmap = 24, TyTset = 25;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static int Ty(Space sp, long a) { return Obj.Ty(sp, a); }
    internal static long NewEditToken(Rt rt) { return Val.Heap(rt.Alloc(TY_VOLATILE, 1)); }
    internal static bool IsArrayMap(Rt rt, long m) { return Val.IsHeap(m) && Ty(rt.gc.sp, Val.AsHeap(m)) == TY_ARRAYMAP; }
    internal static int MapCount(Rt rt, long m) { return (int) Val.AsFixnum(rt.Slot(m, HM_CNT)); }
    internal static long NewHashMap(Rt rt, int cnt, long root, long meta) {
        long a = rt.Alloc(TY_HASHMAP, 4);
        rt.SetSlot(a, HM_CNT, Val.Fixnum(cnt));
        rt.SetSlot(a, HM_ROOT, root);
        rt.SetSlot(a, HM_META, meta);
        return Val.Heap(a);
    }
    internal static long NewSet(Rt rt, long m, long meta) {
        long a = rt.Alloc(TY_SET, 3);
        rt.SetSlot(a, global::Flint.Rt.Sets.S_MAP, m);
        rt.SetSlot(a, global::Flint.Rt.Sets.S_META, meta);
        return Val.Heap(a);
    }
    internal static long NewNode(Rt rt, long edit) {
        long a = rt.Alloc(TY_NODE, 1 + 2 * CAP);
        rt.SetSlot(a, 0, edit);
        return Val.Heap(a);
    }
    internal static int NodeAt(Rt rt, long n, long k) {
        for (int i = 0; i < CAP; i++) if (rt.Slot(n, 1 + 2 * i) == k) return i;
        return -1;
    }
    internal static int NodeFree(Rt rt, long n) {
        for (int i = 0; i < CAP; i++) if (Val.IsNil(rt.Slot(n, 1 + 2 * i))) return i;
        return -1;
    }
    internal static long NodeFind(Rt rt, long n, int shift, int h, long k) {
        int at = NodeAt(rt, n, k);
        return at < 0 ? NOT_FOUND : rt.Slot(n, 2 + 2 * at);
    }
    internal static long NodeCopy(Rt rt, long n, long edit) {
        long outn = NewNode(rt, edit);
        for (int i = 0; i < 2 * CAP; i++) rt.Set(outn, 1 + i, rt.Slot(n, 1 + i));
        return outn;
    }
    internal static long NodeAssoc(Rt rt, long n, int shift, int h, long k, long v, long edit) {
        long t = rt.Slot(n, 0) == edit ? n : NodeCopy(rt, n, edit);
        int at = NodeAt(rt, t, k);
        if (at >= 0) { rt.champAdded = false; rt.Set(t, 2 + 2 * at, v); return t; }
        rt.champAdded = true;
        int f = NodeFree(rt, t);
        rt.Set(t, 1 + 2 * f, k);
        rt.Set(t, 2 + 2 * f, v);
        return t;
    }
    internal static long NodeDissoc(Rt rt, long n, int shift, int h, long k, long edit) {
        if (NodeAt(rt, n, k) < 0) { rt.champAdded = false; return n; }
        long t = rt.Slot(n, 0) == edit ? n : NodeCopy(rt, n, edit);
        int at = NodeAt(rt, t, k);
        rt.champAdded = true;
        rt.Set(t, 1 + 2 * at, NIL);
        rt.Set(t, 2 + 2 * at, NIL);
        return t;
    }
    internal static long Promote(Rt rt, long m) {
        int n = rt.lens[(int) m] / 2;
        long root = NewNode(rt, NewEditToken(rt));
        for (int i = 0; i < n; i++) {
            rt.Set(root, 1 + 2 * i, rt.Slot(m, 2 * i));
            rt.Set(root, 2 + 2 * i, rt.Slot(m, 2 * i + 1));
        }
        return NewHashMap(rt, n, root, NIL);
    }
    internal static long NewArrayMap(Rt rt, long[] pairs) {
        long a = rt.Alloc(TY_ARRAYMAP, System.Math.Max(pairs.Length, 1));
        rt.lens[(int) a] = pairs.Length;
        for (int i = 0; i < pairs.Length; i++) rt.h[(int) a + i] = pairs[i];
        return Val.Heap(a);
    }
--csharp
    public static void Main() {
        Rt rt = new Rt();
        rt.empty = NewHashMap(rt, 0, NewNode(rt, NIL), NIL);
        var o = new System.Text.StringBuilder();
        long k1 = 0xA1L, k2 = 0xB2L, k3 = 0xC3L;
        long v1 = 0xD4L, v3 = 0xF6L;

        long am = NewArrayMap(rt, new long[]{k1, v1, k2, 0xE5L});
        long t = MapTransient(rt, am);
        o.Append("cnt=").Append(TmapCount(rt, t))
         .Append(" edit=").Append(Val.IsNil(rt.Slot(t, global::Flint.Rt.Maps.TM_EDIT)) ? 0 : 1).Append(" ");
        o.Append("get=").Append(TmapGet(rt, t, k1, NIL)).Append("/")
         .Append(TmapGet(rt, t, k2, NIL)).Append("/")
         .Append(TmapGet(rt, t, k3, 0x11L)).Append(" ");

        long t2 = TmapAssoc(rt, t, k3, v3);
        long t3 = TmapAssoc(rt, t2, k1, v3);
        o.Append("same=").Append(t2 == t ? 1 : 0).Append(t3 == t ? 1 : 0)
         .Append(" cnt3=").Append(TmapCount(rt, t3))
         .Append(" k1=").Append(TmapGet(rt, t3, k1, NIL)).Append(" ");

        long t4 = TmapDissoc(rt, t3, k2);
        long t5 = TmapDissoc(rt, t4, k2);
        o.Append("cnt5=").Append(TmapCount(rt, t5))
         .Append(" gone=").Append(TmapGet(rt, t5, k2, 0x22L) == 0x22L ? 1 : 0).Append(" ");

        long p = TmapPersistent(rt, t5);
        o.Append("pcnt=").Append(MapCount(rt, p)).Append(" ");
        rt.thrown = "";
        long after = TmapAssoc(rt, t5, k1, v1);
        o.Append("after=").Append(Val.IsNil(after) ? 1 : 0).Append("/")
         .Append(rt.thrown.Length).Append(" ");

        long e = MapTransient(rt, NewArrayMap(rt, new long[]{}));
        long ep = TmapPersistent(rt, e);
        o.Append("empty=").Append(ep == rt.empty ? 1 : 0).Append(" ");

        long sm = NewArrayMap(rt, new long[]{k1, k1});
        long s = NewSet(rt, sm, NIL);
        long ts = SetTransient(rt, s);
        o.Append("scnt=").Append(TsetCount(rt, ts))
         .Append(" sedit=").Append(rt.Slot(ts, global::Flint.Rt.Sets.TS_EDIT)
                 == rt.Slot(rt.Slot(ts, global::Flint.Rt.Sets.TS_MAP), global::Flint.Rt.Maps.TM_EDIT) ? 1 : 0).Append(" ");
        long ts2 = TsetConj(rt, ts, k2);
        long ts3 = TsetConj(rt, ts2, k2);
        o.Append("ssame=").Append(ts2 == ts ? 1 : 0).Append(ts3 == ts ? 1 : 0)
         .Append(" scnt3=").Append(TsetCount(rt, ts3))
         .Append(" sget=").Append(TsetGet(rt, ts3, k2, NIL)).Append("/")
         .Append(TsetGet(rt, ts3, k3, 0x33L)).Append(" ");
        long ts4 = TsetDisj(rt, ts3, k1);
        o.Append("sdisj=").Append(TsetCount(rt, ts4)).Append(" ");
        long sp = TsetPersistent(rt, ts4);
        o.Append("sp=").Append(MapCount(rt, rt.Slot(sp, global::Flint.Rt.Sets.S_MAP)))
         .Append(" sedit2=").Append(Val.IsNil(rt.Slot(ts4, global::Flint.Rt.Sets.TS_EDIT)) ? 1 : 0)
         .Append(" smedit=").Append(Val.IsNil(rt.Slot(rt.Slot(ts4, global::Flint.Rt.Sets.TS_MAP), global::Flint.Rt.Maps.TM_EDIT)) ? 1 : 0);
        System.Console.WriteLine(o.ToString());
    }
--expect
cnt=2 edit=1 get=212/229/17 same=11 cnt3=3 k1=246 cnt5=2 gone=1 pcnt=2 after=1/55 empty=1 scnt=1 sedit=1 ssame=11 scnt3=2 sget=178/51 sdisj=1 sp=1 sedit2=1 smedit=1
--expect-why
DERIVED from `maptrans.kin` against the driver's node model. No address is
printed anywhere on this line -- every field is a count, a flag, or a stored
value -- so nothing here is pinned. The keys and values in decimal:
k1 = 0xA1 = 161, k2 = 0xB2 = 178, k3 = 0xC3 = 195,
v1 = 0xD4 = 212, v2 = 0xE5 = 229, v3 = 0xF6 = 246,
and the three defaults 0x11 = 17, 0x22 = 34, 0x33 = 51.

  cnt=2 edit=1   `map-transient` of a 2-entry ARRAY MAP. It is promoted first
                 (the header: "there is one transient implementation and it is
                 the trie's"), and the count is LIFTED OUT of the promoted map
                 -- 2, read from the hash map's HM_CNT, not from the array
                 map's slot count. `edit=1` says a token was minted and
                 stored; that same slot is the validity bit, and `after=`
                 below is what happens when it is nil.

  get=212/229/17 both keys read back their own values -- 212 for k1 and 229
                 for k2, not swapped -- and a MISSING key answers the caller's
                 default 17. The default is the third field because `tmap-get`
                 must return the caller's `not-found` and not NOT_FOUND: a
                 leaked NOT_FOUND (0xFFFE) would print 65534 here.

  same=11        BOTH assocs answer the SAME HANDLE. That is the whole point
                 of a transient -- there is only ever one -- so a version that
                 returned a fresh box would print 00 and every `assoc!` in a
                 loop would allocate.
  cnt3=3         only the NEW key moved the count: 2 + 1 for k3, and then
                 nothing for re-assoc'ing k1. `champ-added` is set false
                 before each descent and read after, so a count that ignored
                 it would print 4 here.
  k1=246         and the re-assoc did REPLACE: k1 now reads v3 = 246, not
                 v1 = 212. So `same=11 cnt3=3 k1=246` is three separate
                 claims about one operation -- same handle, count unmoved,
                 value changed -- and no two of them imply the third.

  cnt5=2         3 - 1 for the first dissoc, and NOTHING for the second, which
                 asks for the same already-absent key. `champ-added` again:
                 the mock `node-dissoc` clears it when the key is not there,
                 and the source only decrements when it is set. A decrement
                 that ignored the flag prints 1 and the map's count drifts
                 below its contents.
  gone=1         and the key really is gone -- the default comes back.

  pcnt=2         `persistent!` freezes to a hash map carrying the transient's
                 own count.
  after=1/55     the handle is REFUSED afterwards: nil out, and a thrown
                 message of exactly 55 characters --
                 "IllegalStateException: transient used after persistent!",
                 21 + 2 + 32. The length is checked rather than the text
                 because the three probes build it the same way; what the
                 number proves is that a message was produced at all, so
                 `after=1/0` (nil with nothing thrown) fails. The header
                 records why this matters: the edit token IS the validity bit,
                 and a handle used after freezing would otherwise quietly
                 mutate a value somebody else now owns.

  empty=1        an EMPTY transient freezes to the SHARED empty map, BY
                 IDENTITY -- not to a fresh wrapper around an empty root. So
                 `(persistent! (transient {}))` is `{}` in the `==` sense.

THE SET SIDE, which is the map side wearing a different tag.

  scnt=1         a transient set of a 1-element set: its count is its inner
                 map's count.
  sedit=1        and the set's OWN token is the same object as the inner map's
                 -- one token, two slots. This is what makes the invalidation
                 below checkable.

  ssame=11       `conj!` answers the same transient set, twice.
  scnt3=2        the first conj of k2 adds it (1 -> 2); the second conj of the
                 SAME element does not (still 2). A set that counted every
                 conj would print 3.
  sget=178/51    `get` on a set answers the STORED element, not the one asked
                 for -- they are `=` here because the mock compares by value,
                 but the field still says the answer came out of the node
                 rather than being handed back -- and a missing element gives
                 the caller's default 51.
  sdisj=1        `disj!` of k1 takes it back to 1.

  sp=1           `persistent!` on the set gives a set whose map carries the
                 count.
  sedit2=1       the SET's token is nil afterwards,
  smedit=1       AND the inner MAP's token is nil afterwards.

THE LAST TWO ARE THE POINT, and they must BOTH be 1. The header records the
bug exactly: "Native never nilled the SET's token -- only the inner map's --
so the two runtimes refused the same program through different slots." That
divergence prints as `sedit2=0 smedit=1`, and the three-target comparison
cannot see it, because one source emits the same omission into all three.
