    // `hash-value` IS `valhash`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.hashValue` below stays where other entries reach it,
    // and this forwards to it.
    static int hashValue(Rt rt, long v) { return com.flint.rt.Eq.hashValue(rt, v); }
    static final long NIL = 0xFFFFL;
    static final long NOT_FOUND = 0xFFFEL;
    static final int TY_ARRAYMAP = 12, TY_HASHMAP = 13, TY_TMAP = 24, TY_TSET = 25;
    static final int TY_SET = 18, TY_VOLATILE = 20, TY_NODE = 26;
    static final int HM_CNT = 0, HM_ROOT = 1, HM_META = 2;
    static final int CAP = 8;
    static final class Maps { static final int TM_CNT = 0, TM_ROOT = 1, TM_EDIT = 2; }
    static final class Sets { static final int S_MAP = 0, S_META = 1, S_HASH = 2;
                              static final int TS_MAP = 0, TS_EDIT = 1; }
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >>> 44) == 0; }
        static long asHeap(long v) { return v; }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
        static final long NOT_FOUND = Probe.NOT_FOUND;
        static long fixnum(long n) { return 0x200000000000L | (n & 0xFFFFFFFFL); }
        static long asFixnum(long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    static final class Space { byte[] m = new byte[20000]; }
    static final class Rt {
        long[] h = new long[20000];
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        int[] lens = new int[20000];
        long bump = 100;
        boolean champAdded = false;
        long empty = NIL;
        String thrown = "";
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long alloc(int t, int n) {
            long a = bump; bump += n + 8;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        void set(long v, int i, long x) { h[(int) v + i] = x; }
        long slot(long v, int i) { return h[(int) v + i]; }
        long throwStr(String cls, String msg) { thrown = cls + ": " + msg; return NIL; }
        long emptyMap() { return empty; }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    // `hash-value` resolves to `com.flint.rt.Eq.hashValue`, and a probe has no
    // such package -- so it declares one, the way `assoc.drivers` does.
    static final class com { static final class flint { static final class rt {
        static final class Eq {
            static int hashValue(Rt rt, long k) { return (int) (k & 0xFF); }
        }
        static final class Maps { static long empty(Rt rt) { return rt.empty; } }
    } } }
    static long newEditToken(Rt rt) { return Val.heap(rt.alloc(TY_VOLATILE, 1)); }
    static boolean isArrayMap(Rt rt, long m) { return Val.isHeap(m) && ty(rt.gc.sp, Val.asHeap(m)) == TY_ARRAYMAP; }
    static int mapCount(Rt rt, long m) { return (int) Val.asFixnum(rt.slot(m, HM_CNT)); }
    static long newHashMap(Rt rt, int cnt, long root, long meta) {
        long a = rt.alloc(TY_HASHMAP, 4);
        rt.setSlot(a, HM_CNT, Val.fixnum(cnt));
        rt.setSlot(a, HM_ROOT, root);
        rt.setSlot(a, HM_META, meta);
        return Val.heap(a);
    }
    static long newSet(Rt rt, long m, long meta) {
        long a = rt.alloc(TY_SET, 3);
        rt.setSlot(a, Sets.S_MAP, m);
        rt.setSlot(a, Sets.S_META, meta);
        return Val.heap(a);
    }
    static long newNode(Rt rt, long edit) {
        long a = rt.alloc(TY_NODE, 1 + 2 * CAP);
        rt.setSlot(a, 0, edit);
        return Val.heap(a);
    }
    static int nodeAt(Rt rt, long n, long k) {
        for (int i = 0; i < CAP; i++) if (rt.slot(n, 1 + 2 * i) == k) return i;
        return -1;
    }
    static int nodeFree(Rt rt, long n) {
        for (int i = 0; i < CAP; i++) if (Val.isNil(rt.slot(n, 1 + 2 * i))) return i;
        return -1;
    }
    static long nodeFind(Rt rt, long n, int shift, int h, long k) {
        int at = nodeAt(rt, n, k);
        return at < 0 ? NOT_FOUND : rt.slot(n, 2 + 2 * at);
    }
    static long nodeCopy(Rt rt, long n, long edit) {
        long out = newNode(rt, edit);
        for (int i = 0; i < 2 * CAP; i++) rt.set(out, 1 + i, rt.slot(n, 1 + i));
        return out;
    }
    static long nodeAssoc(Rt rt, long n, int shift, int h, long k, long v, long edit) {
        long t = rt.slot(n, 0) == edit ? n : nodeCopy(rt, n, edit);
        int at = nodeAt(rt, t, k);
        if (at >= 0) { rt.champAdded = false; rt.set(t, 2 + 2 * at, v); return t; }
        rt.champAdded = true;
        int f = nodeFree(rt, t);
        rt.set(t, 1 + 2 * f, k);
        rt.set(t, 2 + 2 * f, v);
        return t;
    }
    static long nodeDissoc(Rt rt, long n, int shift, int h, long k, long edit) {
        if (nodeAt(rt, n, k) < 0) { rt.champAdded = false; return n; }
        long t = rt.slot(n, 0) == edit ? n : nodeCopy(rt, n, edit);
        int at = nodeAt(rt, t, k);
        rt.champAdded = true;
        rt.set(t, 1 + 2 * at, NIL);
        rt.set(t, 2 + 2 * at, NIL);
        return t;
    }
    static long promote(Rt rt, long m) {
        int n = rt.lens[(int) m] / 2;
        long root = newNode(rt, newEditToken(rt));
        for (int i = 0; i < n; i++) {
            rt.set(root, 1 + 2 * i, rt.slot(m, 2 * i));
            rt.set(root, 2 + 2 * i, rt.slot(m, 2 * i + 1));
        }
        return newHashMap(rt, n, root, NIL);
    }
    static long newArrayMap(Rt rt, long[] pairs) {
        long a = rt.alloc(TY_ARRAYMAP, Math.max(pairs.length, 1));
        rt.lens[(int) a] = pairs.length;
        for (int i = 0; i < pairs.length; i++) rt.h[(int) a + i] = pairs[i];
        return Val.heap(a);
    }
