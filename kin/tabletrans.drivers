--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 900000], gc: Gc { sp: Space { m: vec![0u8; 900000] } },
                      lens: vec![0; 900000], bump: 100, roots: Vec::new(), steps: 0,
                      thrown: alloc::string::String::new() };
    let mut o = String::new();
    let na = Value::fixnum(101); let nb = Value::fixnum(102);
    let sch = rt.schema(&[na, nb]);
    // A PERSISTENT TABLE of 300 rows: one full chunk and 44 in the next.
    let mut chunks = alloc::vec::Vec::new();
    for c in 0..2u32 {
        let rows = if c == 0 { table::CHUNK } else { 44 };
        let ch = rt.new_chunk(2, rows);
        for id in 0..2u32 {
            let col = rt.obj(TY_NODE, rows);
            for k in 0..rows {
                let v = if id == 0 { (c * table::CHUNK + k) as i64 } else { 7 };
                rt.set(col, k, Value::fixnum(v));
            }
            rt.set(ch, table::CH_BASE + id, col);
        }
        chunks.push(ch);
    }
    let chv = rt.vector(&chunks);
    let tab = rt.obj(TY_TABLE, table::TB_LEN);
    rt.set(tab, table::TB_SCHEMA, sch);
    rt.set(tab, table::TB_CHUNKS, chv);
    rt.set(tab, table::TB_COUNT, Value::fixnum(300));
    rt.set(tab, table::TB_OFFSET, Value::fixnum(0));
    // THE PARTIAL CHUNK MOVES into the open one and is dropped from the list;
    // the full one is carried by reference.
    let tt = rt.table_transient(tab);
    let carried = rt.slot(tt, table::TT_CHUNKS);
    let ncar = rt.vec_count(carried);
    let open = rt.slot(tt, table::TT_OPEN);
    let fill = rt.chunk_rows(open);
    let cnt = rt.ttable_count(tt);
    o.push_str(&format!("carried={} fill={} count={} ", ncar, fill, cnt));
    // The moved rows are readable through the open chunk.
    let m0 = rt.chunk_get(open, 0, 0).as_fixnum();
    let m43 = rt.chunk_get(open, 0, 43).as_fixnum();
    o.push_str(&format!("moved={}.{} ", m0, m43));
    // CONJ up to the chunk boundary: at 256 the open chunk is handed over
    // whole and a fresh one takes its place.
    let mkrow = |rt: &mut Rt, a: i64| -> Value {
        let mut m = rt.empty_map();
        m = rt.map_assoc(m, na, Value::fixnum(a));
        m = rt.map_assoc(m, nb, Value::fixnum(7));
        m
    };
    let mut tt2 = tt;
    for k in 0..212u32 {
        let row = mkrow(&mut rt, 1000 + k as i64);
        tt2 = rt.ttable_conj(tt2, row);
    }
    let carried2 = rt.slot(tt2, table::TT_CHUNKS);
    let ncar2 = rt.vec_count(carried2);
    let open2 = rt.slot(tt2, table::TT_OPEN);
    let fill2 = rt.chunk_rows(open2);
    let cnt2 = rt.ttable_count(tt2);
    o.push_str(&format!("afterfill={}/{}/{} ", ncar2, fill2, cnt2));
    // The HANDED-OVER chunk was collapsed, not copied: column 1 is all sevens.
    let handed = rt.vec_nth(carried2, 1, NIL);
    let henc = rt.chunk_enc(handed, 1);
    o.push_str(&format!("handedenc={} ", henc));
    // ONE MORE ROW, then persistent!: the open chunk is sealed to exactly the
    // rows written.
    let row = mkrow(&mut rt, 9999);
    let tt3 = rt.ttable_conj(tt2, row);
    let out = rt.ttable_persistent(tt3);
    let ochunks = rt.slot(out, table::TB_CHUNKS);
    let nout = rt.vec_count(ochunks);
    let total = rt.slot(out, table::TB_COUNT).as_fixnum();
    let lastch = rt.vec_nth(ochunks, nout - 1, NIL);
    let lastrows = rt.chunk_rows(lastch);
    o.push_str(&format!("persist={}/{}/{} ", nout, total, lastrows));
    // THE VALUES SURVIVED, across the carried chunk, the moved rows and the
    // conjed ones.
    let ch0 = rt.vec_nth(ochunks, 0, NIL);
    let v0 = rt.chunk_get(ch0, 0, 5).as_fixnum();
    let lastv = rt.chunk_get(lastch, 0, lastrows - 1).as_fixnum();
    o.push_str(&format!("values={}.{} ", v0, lastv));
    // AND THE TRANSIENT IS DEAD. A second operation refuses BY NAME.
    let again = rt.ttable_conj(tt3, row);
    let dead = rt.thrown.clone();
    o.push_str(&format!("dead={} msg={}", again.is_nil() as u32,
                        &dead[..dead.find(';').unwrap_or(dead.len())]));
    println!("{}", o);
}
