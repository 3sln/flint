    fn set_slot(&mut self, a: Value, i: u32, v: Value) { self.set(a, i, v); }
    // A MAP as alternating key/value slots. Small, ordered, and enough: the
    // schema index is the only map here and it holds one entry per column.
    fn empty_map(&mut self) -> Value { let a = self.alloc(TY_MAP, 0); Value::heap(a) }
    fn map_get(&mut self, m: Value, k: Value, dflt: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(m, i).0 == k.0 { return self.slot(m, i + 1); }
            i += 2;
        }
        dflt
    }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let a = self.alloc(TY_MAP, n + 2);
        let out = Value::heap(a);
        for i in 0..n { let x = self.slot(m, i); self.set(out, i, x); }
        self.set(out, n, k);
        self.set(out, n + 1, v);
        self.lens[a as usize] = n + 2;
        out
    }
    fn map_pairs(&self, m: Value) -> u32 { self.lens[m.0 as usize] / 2 }
    fn obj(&mut self, t: u8, n: u32) -> Value { let a = self.alloc(t, n); Value::heap(a) }
    // `new-obj` answers NIL when the heap refuses. The probe's heap never
    // does, but the wrapper is what the source calls.
    fn new_obj(&mut self, t: u8, n: u32) -> Value { self.obj(t, n) }
    fn charge_work(&mut self, n: u64) { self.steps += n; }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
// THE ACCESSORS THIS SOURCE CONSUMES AS SIBLINGS -- `tablemeta` generates
// them, so the probe supplies its own.
impl Rt {
    fn schema_len(&self, s: Value) -> u32 { self.vec_count(self.slot(s, table::SC_NAMES)) }
    fn schema_name_at(&mut self, s: Value, c: u32) -> Value {
        let names = self.slot(s, table::SC_NAMES);
        self.vec_nth(names, c, NIL)
    }
    fn table_count(&mut self, t: Value) -> u32 { self.slot(t, table::TB_COUNT).as_fixnum() as u32 }
    fn is_table_ref(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_TABLEREF
    }
    fn schema_width(&mut self, s: Value) -> u32 {
        self.slot(s, table::SC_WIDTH).as_fixnum() as u32
    }
    fn schema_id(&mut self, s: Value, name: Value) -> u32 {
        let p = self.map_get(self.slot(s, table::SC_INDEX), name, NIL);
        if p.is_fixnum() { p.as_fixnum() as u32 } else { self.schema_width(s) }
    }
    fn ref_get(&mut self, rf: Value, name: Value, dflt: Value) -> Value {
        let s = self.slot(rf, table::RF_SCHEMA);
        let id = self.schema_id(s, name);
        if id >= self.schema_width(s) { return dflt; }
        let ch = self.slot(rf, table::RF_CHUNK);
        let row = self.slot(rf, table::RF_ROW).as_fixnum() as u32;
        self.chunk_get(ch, id, row)
    }
    fn table_offset(&mut self, t: Value) -> u32 { self.slot(t, table::TB_OFFSET).as_fixnum() as u32 }
    fn chunk_get(&mut self, ch: Value, id: u32, row: u32) -> Value {
        let col = self.slot(ch, table::CH_BASE + id);
        let e = self.slot(ch, table::CH_ENC);
        if self.slot(e, id).as_fixnum() as u32 == table::ENC_CONST { col } else { self.slot(col, row) }
    }
