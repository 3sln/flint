        long name = Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES), c, Val.Nil);
        return IsTableRef(rt, row) ? RefGet(rt, row, name, Val.NotFound)
                                   : MapGet(rt, row, name, Val.NotFound);
    }
    internal static long Schema(Rt rt, long[] names) {
        long s = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(s, global::Flint.Rt.Table.SC_NAMES, Vector(rt, names));
        long[] ids = new long[names.Length];
        for (int i = 0; i < names.Length; i++) ids[i] = Val.Fixnum(i);
        rt.Set(s, global::Flint.Rt.Table.SC_IDS, Vector(rt, ids));
        rt.Set(s, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(names.Length));
        long idx = EmptyMap(rt);
        for (int i = 0; i < names.Length; i++) idx = MapAssoc(rt, idx, names[i], Val.Fixnum(i));
        rt.Set(s, global::Flint.Rt.Table.SC_INDEX, idx);
        return s;
    }
    internal static string ShowChunk(Rt rt, long ch, int ids, int rows) {
        var o = new System.Text.StringBuilder();
        for (int id = 0; id < ids; id++) {
            if (id > 0) o.Append(',');
            o.Append(ChunkEnc(rt, ch, id)).Append('[');
            for (int r = 0; r < rows; r++) {
                if (r > 0) o.Append('.');
                o.Append(Val.AsFixnum(ChunkGet(rt, ch, id, r)));
            }
            o.Append(']');
        }
        return o.ToString();
    }
    internal static long NA, NB, SCH;
    internal static long Mkrow(Rt rt, long a, long b) {
        long m = EmptyMap(rt);
        m = MapAssoc(rt, m, NA, Val.Fixnum(a));
        m = MapAssoc(rt, m, NB, Val.Fixnum(b));
        return m;
    }
    internal static long VecConj(Rt rt, long v, long x) {
        int n = Vec.Count(rt, v);
        long a = rt.Alloc(Obj.TyVec, n + 1);
        rt.lens[(int) a] = n + 1;
        for (int i = 0; i < n; i++) rt.h[(int) a + i] = rt.h[(int) v + i];
        rt.h[(int) a + n] = x;
        return Val.Heap(a);
    }
    internal static long VecPop(Rt rt, long v) {
        int n = Vec.Count(rt, v), m = n == 0 ? 0 : n - 1;
        long a = rt.Alloc(Obj.TyVec, m == 0 ? 1 : m);
        rt.lens[(int) a] = m;
        for (int i = 0; i < m; i++) rt.h[(int) a + i] = rt.h[(int) v + i];
        return Val.Heap(a);
    }
    internal static string THROWN = "";
    internal static long OpenChunk(Rt rt, long s) {
        long ch = NewChunk(rt, SchemaWidth(rt, s), 0);
        int ncols = SchemaLen(rt, s);
        for (int c = 0; c < ncols; c++)
            rt.Set(ch, global::Flint.Rt.Table.CH_BASE + SchemaIdAt(rt, s, c),
                   Conc.NewObj(rt, Obj.TyNode, global::Flint.Rt.Table.CHUNK));
        return ch;
    }
    internal static void WriteRow(Rt rt, long s, long ch, int k, long row) {
        int n = SchemaLen(rt, s);
        for (int c = 0; c < n; c++) {
            int id = SchemaIdAt(rt, s, c);
            rt.Set(rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id), k, RowColumn(rt, s, row, c));
        }
    }
    internal static long Seal(Rt rt, long s, long open, int rows) {
        long ch = NewChunk(rt, SchemaWidth(rt, s), rows);
        int ncols = SchemaLen(rt, s);
        for (int c = 0; c < ncols; c++) {
            int id = SchemaIdAt(rt, s, c);
            long col = Conc.NewObj(rt, Obj.TyNode, rows == 0 ? 1 : rows);
            long src = rt.Slot(open, global::Flint.Rt.Table.CH_BASE + id);
            for (int k = 0; k < rows; k++) rt.Set(col, k, rt.Slot(src, k));
            rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, col);
            Collapse(rt, ch, id);
        }
        return ch;
    }
    internal static long Mkrow1(Rt rt, long a) {
        long m = EmptyMap(rt);
        m = MapAssoc(rt, m, NA, Val.Fixnum(a));
        m = MapAssoc(rt, m, NB, Val.Fixnum(7));
        return m;
    }
--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        NA = Val.Fixnum(101); NB = Val.Fixnum(102);
        SCH = Schema(rt, new long[]{NA, NB});
        long[] chunks = new long[2];
        for (int c = 0; c < 2; c++) {
            int rows = c == 0 ? global::Flint.Rt.Table.CHUNK : 44;
            long ch = NewChunk(rt, 2, rows);
            for (int id = 0; id < 2; id++) {
                long col = Obj2(rt, Obj.TyNode, rows);
                for (int k = 0; k < rows; k++)
                    rt.Set(col, k, Val.Fixnum(id == 0 ? c * global::Flint.Rt.Table.CHUNK + k : 7));
                rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, col);
            }
            chunks[c] = ch;
        }
        long tab = Obj2(rt, Obj.TyTable, global::Flint.Rt.Table.TB_LEN);
        rt.Set(tab, global::Flint.Rt.Table.TB_SCHEMA, SCH);
        rt.Set(tab, global::Flint.Rt.Table.TB_CHUNKS, Vector(rt, chunks));
        rt.Set(tab, global::Flint.Rt.Table.TB_COUNT, Val.Fixnum(300));
        rt.Set(tab, global::Flint.Rt.Table.TB_OFFSET, Val.Fixnum(0));
        long tt = TableTransient(rt, tab);
        long open = rt.Slot(tt, global::Flint.Rt.Table.TT_OPEN);
        o.Append("carried=").Append(Vec.Count(rt, rt.Slot(tt, global::Flint.Rt.Table.TT_CHUNKS)))
         .Append(" fill=").Append(ChunkRows(rt, open))
         .Append(" count=").Append(TtableCount(rt, tt)).Append(' ');
        o.Append("moved=").Append(Val.AsFixnum(ChunkGet(rt, open, 0, 0))).Append('.')
         .Append(Val.AsFixnum(ChunkGet(rt, open, 0, 43))).Append(' ');
        long tt2 = tt;
        for (int k = 0; k < 212; k++) tt2 = TtableConj(rt, tt2, Mkrow1(rt, 1000 + k));
        long carried2 = rt.Slot(tt2, global::Flint.Rt.Table.TT_CHUNKS);
        o.Append("afterfill=").Append(Vec.Count(rt, carried2)).Append('/')
         .Append(ChunkRows(rt, rt.Slot(tt2, global::Flint.Rt.Table.TT_OPEN))).Append('/')
         .Append(TtableCount(rt, tt2)).Append(' ');
        o.Append("handedenc=").Append(ChunkEnc(rt, Vec.Nth(rt, carried2, 1, Val.Nil), 1)).Append(' ');
        long tt3 = TtableConj(rt, tt2, Mkrow1(rt, 9999));
        long outv = TtablePersistent(rt, tt3);
        long ochunks = rt.Slot(outv, global::Flint.Rt.Table.TB_CHUNKS);
        int nout = Vec.Count(rt, ochunks);
        long lastch = Vec.Nth(rt, ochunks, nout - 1, Val.Nil);
        int lastrows = ChunkRows(rt, lastch);
        o.Append("persist=").Append(nout).Append('/')
         .Append(Val.AsFixnum(rt.Slot(outv, global::Flint.Rt.Table.TB_COUNT))).Append('/')
         .Append(lastrows).Append(' ');
        o.Append("values=").Append(Val.AsFixnum(ChunkGet(rt, Vec.Nth(rt, ochunks, 0, Val.Nil), 0, 5)))
         .Append('.').Append(Val.AsFixnum(ChunkGet(rt, lastch, 0, lastrows - 1))).Append(' ');
        long again = TtableConj(rt, tt3, Mkrow1(rt, 1));
        int semi = THROWN.IndexOf(';');
        o.Append("dead=").Append(again == Val.Nil ? 1 : 0)
         .Append(" msg=").Append(semi < 0 ? THROWN : THROWN.Substring(0, semi));
        System.Console.WriteLine(o.ToString());
    }
