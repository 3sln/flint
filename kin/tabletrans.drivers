--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        NA = Val.fixnum(101); NB = Val.fixnum(102);
        SCH = schema(rt, new long[]{NA, NB});
        long[] chunks = new long[2];
        for (int c = 0; c < 2; c++) {
            int rows = c == 0 ? Table.CHUNK : 44;
            long ch = newChunk(rt, 2, rows);
            for (int id = 0; id < 2; id++) {
                long col = obj(rt, TY_NODE, rows);
                for (int k = 0; k < rows; k++)
                    rt.set(col, k, Val.fixnum(id == 0 ? c * Table.CHUNK + k : 7));
                rt.set(ch, Table.CH_BASE + id, col);
            }
            chunks[c] = ch;
        }
        long tab = obj(rt, TY_TABLE, Table.TB_LEN);
        rt.set(tab, Table.TB_SCHEMA, SCH);
        rt.set(tab, Table.TB_CHUNKS, vector(rt, chunks));
        rt.set(tab, Table.TB_COUNT, Val.fixnum(300));
        rt.set(tab, Table.TB_OFFSET, Val.fixnum(0));
        long tt = tableTransient(rt, tab);
        long open = rt.slot(tt, Table.TT_OPEN);
        o.append("carried=").append(Vec.count(rt, rt.slot(tt, Table.TT_CHUNKS)))
         .append(" fill=").append(chunkRows(rt, open))
         .append(" count=").append(ttableCount(rt, tt)).append(' ');
        o.append("moved=").append(Val.asFixnum(chunkGet(rt, open, 0, 0))).append('.')
         .append(Val.asFixnum(chunkGet(rt, open, 0, 43))).append(' ');
        long tt2 = tt;
        for (int k = 0; k < 212; k++) tt2 = ttableConj(rt, tt2, mkrow1(rt, 1000 + k));
        long carried2 = rt.slot(tt2, Table.TT_CHUNKS);
        o.append("afterfill=").append(Vec.count(rt, carried2)).append('/')
         .append(chunkRows(rt, rt.slot(tt2, Table.TT_OPEN))).append('/')
         .append(ttableCount(rt, tt2)).append(' ');
        o.append("handedenc=").append(chunkEnc(rt, Vec.nth(rt, carried2, 1, NIL), 1)).append(' ');
        long tt3 = ttableConj(rt, tt2, mkrow1(rt, 9999));
        long out = ttablePersistent(rt, tt3);
        long ochunks = rt.slot(out, Table.TB_CHUNKS);
        int nout = Vec.count(rt, ochunks);
        long lastch = Vec.nth(rt, ochunks, nout - 1, NIL);
        int lastrows = chunkRows(rt, lastch);
        o.append("persist=").append(nout).append('/')
         .append(Val.asFixnum(rt.slot(out, Table.TB_COUNT))).append('/')
         .append(lastrows).append(' ');
        o.append("values=").append(Val.asFixnum(chunkGet(rt, Vec.nth(rt, ochunks, 0, NIL), 0, 5)))
         .append('.').append(Val.asFixnum(chunkGet(rt, lastch, 0, lastrows - 1))).append(' ');
        long again = ttableConj(rt, tt3, mkrow1(rt, 1));
        int semi = THROWN.indexOf(';');
        o.append("dead=").append(again == NIL ? 1 : 0)
         .append(" msg=").append(semi < 0 ? THROWN : THROWN.substring(0, semi));
        System.out.println(o.toString());
    }
