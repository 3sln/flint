        let name = self.vec_nth(names, c, NIL);
        if self.is_table_ref(row) { self.ref_get(row, name, NOT_FOUND) }
        else { self.map_get(row, name, NOT_FOUND) }
    }
    // A SCHEMA whose ids are its positions, which is what an unmigrated one
    // looks like. `col` reads a column out whatever its encoding.
    fn schema(&mut self, names: &[Value]) -> Value {
        let s = self.obj(TY_SCHEMA, table::SC_LEN);
        let nv = self.vector(names);
        self.set(s, table::SC_NAMES, nv);
        let ids: alloc::vec::Vec<Value> = (0..names.len()).map(|i| Value::fixnum(i as i64)).collect();
        let iv = self.vector(&ids);
        self.set(s, table::SC_IDS, iv);
        self.set(s, table::SC_WIDTH, Value::fixnum(names.len() as i64));
        let mut idx = self.empty_map();
        for (i, n) in names.iter().enumerate() { idx = self.map_assoc(idx, *n, Value::fixnum(i as i64)); }
        self.set(s, table::SC_INDEX, idx);
