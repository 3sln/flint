--csharp-head
    internal const long Nil = 0xFFFFL;
    internal const int TyExinfo = 44;
    internal static class Val {
        internal const long Nil = Probe.Nil;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil; }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
    }
    internal class Space { internal byte[] m = new byte[4096]; }
    internal class Gc { internal Space sp = new Space(); }
    internal class Rt {
        internal long[] h = new long[4096];
        internal Gc gc = new Gc();
        internal long bump = 100;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal bool starve = false;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
        internal void SetSlot(long v, int i, long x) { h[(int) v + i] = x; }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 8;
            gc.sp.m[(int) a] = (byte) t;
            for (int i = 0; i < n; i++) h[(int) a + i] = Nil;
            return a;
        }
    }
    internal static class Obj {
        internal const int TyExinfo = TyExinfo_;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a]; }
    }
    internal const int TyExinfo_ = 44;
--csharp
    static string Show(long v) { return v == Nil ? "nil" : v.ToString(); }
    public static void Main(string[] args) {
        var rt = new Rt();
        var o = new System.Text.StringBuilder();
        long k = 200, m = 201, d = 202, c = 203;
        long e = ExInfo(rt, k, m, d, c);
        o.Append(" made=").Append(Show(e));
        o.Append(" isex=").Append(IsException(rt, e) ? "true" : "false");
        o.Append(" kind=").Append(Show(ExKind(rt, e)));
        o.Append(" msg=").Append(Show(ExMessage(rt, e)));
        o.Append(" data=").Append(Show(ExData(rt, e)));
        o.Append(" roots=").Append(rt.roots.Count);
        long notex = 300;
        rt.gc.sp.m[300] = 9;
        o.Append(" other-isex=").Append(IsException(rt, notex) ? "true" : "false");
        o.Append(" other-kind=").Append(Show(ExKind(rt, notex)));
        o.Append(" nil-msg=").Append(Show(ExMessage(rt, Nil)));
        rt.starve = true;
        o.Append(" starved=").Append(Show(ExInfo(rt, k, m, d, c)));
        o.Append(" starved-roots=").Append(rt.roots.Count);
        System.Console.WriteLine(o.ToString().Trim());
    }
