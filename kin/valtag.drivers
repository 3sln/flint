--rust-head
// NO HEAP AND NO `Rt`. These six are pure bit manipulation over a 64-bit
// word, which is why they are free functions -- so the toy is the real
// constants, the newtype, and nothing else.
//
// THE CONSTANTS ARE THE REAL ONES. A toy that picked a narrow tag would still
// catch a shift in the wrong direction and would NOT catch a missing mask,
// which is the defect this source exists to make impossible.
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
mod value {
    pub const TAG_HEAP: u64 = 0xFFF9;
    pub const TAG_FIXNUM: u64 = 0xFFFA;
    pub const PAYLOAD: u64 = 0x0000_FFFF_FFFF_FFFF;
    pub const FIXNUM_MAX: i64 = (1 << 47) - 1;
    pub const FIXNUM_MIN: i64 = -(1 << 47);
}
--rust
fn main() {
    let b = |x: bool| if x { 1 } else { 0 };
    println!("{} {} | {}{}{}{} | {} {} {} {} | {} {} {} | {} {}",
             // 1-2. THE TAG COMES BACK, from each constructor.
             tag_of(make_fixnum(0)), tag_of(make_heap(0)),
             // 3-6. THE BOUND, both sides of both ends.
             b(fits_fixnum(value::FIXNUM_MAX)), b(fits_fixnum(value::FIXNUM_MAX + 1)),
             b(fits_fixnum(value::FIXNUM_MIN)), b(fits_fixnum(value::FIXNUM_MIN - 1)),
             // 7-10. FIXNUM ROUND TRIP, including the negatives that the mask
             // and the sign extension both have to get right.
             fixnum_payload(make_fixnum(0)), fixnum_payload(make_fixnum(-1)),
             fixnum_payload(make_fixnum(value::FIXNUM_MAX)),
             fixnum_payload(make_fixnum(value::FIXNUM_MIN)),
             // 11-13. HEAP ROUND TRIP, then the address that separated the
             // three runtimes: 2^48 is one past the payload field.
             heap_payload(make_heap(0x1234)),
             heap_payload(make_heap(1 << 48)),
             tag_of(make_heap(1 << 48)),
             // 14-15. And an address with BOTH halves set: the payload must
             // survive and the tag must not be touched.
             heap_payload(make_heap((1 << 48) | 0x1234)),
             tag_of(make_heap((1 << 48) | 0x1234)));
}
