;; Building a table in bulk: from ROWS, and from COLUMNS.
;;
;; TWO SHAPES OF THE SAME LOOP. Both fill one chunk of at most `CHUNK` rows at
;; a time, collapse each column as it is finished, and refuse a value that does
;; not match its declared type -- naming the row and the column, because `checks`
;; says "bad row" is the message this codebase keeps replacing.
;;
;; THE COLUMN FORM IS WHAT THE WIRE DECODER BUILDS INTO (`tables` step 9). Going
;; through rows would mean building a map per row only to take it apart again,
;; which is the shape the type exists to avoid -- and on the decode path it
;; would be the receiver paying for the sender's compactness. The values are
;; still CHECKED: a decoder that skipped that would be a way to make a table
;; that is not closed, which is the one property everything else rests on.
(ns flint.rt.tablebuild
  (:require [flint.impl.rt :refer [defn declarefn return if let do comment doc == < > +
                                   - not alloc heap slot set-slot fixnum
                                   empty-vec new-obj mark push r set-r pop-to
                                   for local set while charge-checked
                                   throw-str static-text Rt Value I32 RootIx
                                   Bool CH_ENC ENC_CONST
                                   Text NIL TY_NODE TY_TABLE CHUNK CH_BASE
                                   SC_TYPES TB_SCHEMA TB_CHUNKS TB_COUNT
                                   TB_OFFSET TB_LEN]]
            [flint.rt.vecwrite :refer [vec-conj]]
            [flint.rt.vecread :refer [vec-nth vec-count]]
            [flint.rt.tablemeta :refer [schema-id-at schema-len schema-name-at
                                        schema-width]]
            [flint.rt.tablecell :refer [new-chunk collapse]]
            [flint.rt.tablekind :refer [type-ok]]
            [flint.rt.tablesay :refer [column-type-error]]
            [flint.rt.mapread :refer [map-get]]))

(doc "A table from `rows`, a vector of maps."
     ""
     "CHARGED PER CHUNK RATHER THAN PER ROW. A chunk is 256 rows of bounded"
     "work, so checking every chunk bounds the overshoot at 256 rows and costs"
     "one branch per 256. Charging `rows * cols` up front is what this used to"
     "do, and it ran 637 379 steps past an exhausted budget.")
(declarefn flint.rt.valeq/val-eq)

(defn ^:pub ^:method ^Value new-table [^:mut ^Rt rt ^Value schema ^Value rows]
  (let [^RootIx base (mark rt)
        ^RootIx si (push rt schema)
        ^RootIx ri (push rt rows)
        ^I32 ncols (schema-len rt (r rt si))
        ^I32 width (schema-width rt (r rt si))
        ^I32 nrows (vec-count rt (r rt ri))
        ^Value chunks0 (empty-vec rt)
        ^RootIx ci (push rt chunks0)]
    (local ^:mut ^I32 row)
    (set row 0)
    (while (< row nrows)
      (if (not (charge-checked rt 1 (static-text "table")))
        (do (pop-to rt base)
            (return NIL)))
      (local ^:mut ^I32 take)
      (set take (- nrows row))
      (if (> take CHUNK) (set take CHUNK))
      (let [^Value ch (new-chunk rt width take)
            ^RootIx chi (push rt ch)]
        (for [^I32 c 0 ncols]
          (comment "NO RUN UNTIL A VALUE DIFFERS."
                   ""
                   "The run used to be allocated here, filled, and only then"
                   "handed to `collapse` -- so a column that is constant"
                   "allocated a full `CHUNK`-slot node and threw it away."
                   "The finished table never held it, but it was live at the"
                   "peak, which is why `test/tables.clj` could see only 32 288"
                   "of the 160 632 bytes a constant column actually saves."
                   ""
                   "So the first value is remembered instead, and the run is"
                   "allocated at the FIRST value that differs -- backfilling"
                   "the rows already seen, which all held the first value. One"
                   "pass still, and one comparison per value; the varying case"
                   "reads each row exactly once, as before.")
          (let [^I32 id (schema-id-at rt (r rt si) c)
                ^Value name0 (schema-name-at rt (r rt si) c)
                ^Value types (slot rt (r rt si) SC_TYPES)
                ^Value tp0 (vec-nth rt types c NIL)
                ;; ALL FOUR ROOTED, and that is not caution. The run is now
                ;; allocated from INSIDE the row loop, and an allocation moves
                ;; whatever a host local points at -- so the column's name and
                ;; its declared type, which the old builder could read once
                ;; because it allocated before reading them, would be read as
                ;; something else from the row after the expansion. Measured:
                ;; the type came back `:?` and a legal keyword was refused at
                ;; row 5 890.
                ^RootIx namei (push rt name0)
                ^RootIx tpi (push rt tp0)
                ^RootIx v0i (push rt NIL)
                ^RootIx coli (push rt NIL)
                ;; THE CURRENT VALUE, in a root that is reused rather than
                ;; pushed per row: `val-eq` may allocate -- comparing two ropes
                ;; can flatten one -- so the value cannot stay in a host local
                ;; across it either.
                ^RootIx vi (push rt NIL)]
            (local ^:mut ^Bool expanded)
            (set expanded false)
            (for [^I32 k 0 take]
              (let [^Value rowv (vec-nth rt (r rt ri) (+ row k) NIL)
                    ^Value val (map-get rt rowv (r rt namei) NIL)]
                (set-r rt vi val))
              (if (not (type-ok rt (r rt tpi) (r rt vi)))
                (do
                  (let [^Text msg (column-type-error rt (r rt namei) (r rt tpi)
                                                     (r rt vi) (+ row k))]
                    (pop-to rt base)
                    (return (throw-str rt "IllegalArgumentException" msg)))))
              (if (== k 0)
                (set-r rt v0i (r rt vi)))
              (if expanded
                (set-slot rt (r rt coli) k (r rt vi))
                (if (not (val-eq rt (r rt v0i) (r rt vi)))
                  (do
                    (comment "A VALUE DIFFERS, so the run is needed after all."
                             "Backfill what came before it -- every one of"
                             "those rows held the first value, which is why"
                             "they did not need storing until now.")
                    (let [^Value col (new-obj rt TY_NODE take)]
                      (set-r rt coli col))
                    (for [^I32 j 0 k]
                      (set-slot rt (r rt coli) j (r rt v0i)))
                    (set-slot rt (r rt coli) k (r rt vi))
                    (set expanded true)))))
            (if expanded
              (do (set-slot rt (r rt chi) (+ CH_BASE id) (r rt coli))
                  (collapse rt (r rt chi) id))
              (do (comment "CONSTANT: one value for the whole chunk and no run"
                           "at all. `collapse` is not called -- this IS the"
                           "state it would have reached.")
                  (set-slot rt (r rt chi) (+ CH_BASE id) (r rt v0i))
                  (set-slot rt (slot rt (r rt chi) CH_ENC) id (fixnum ENC_CONST))))
            (pop-to rt namei)))
        (let [^Value nv (vec-conj rt (r rt ci) (r rt chi))]
          (set-r rt ci nv))
        (pop-to rt chi))
      (set row (+ row take)))
    (let [^Value t (heap (alloc rt TY_TABLE TB_LEN))
          ^RootIx ti (push rt t)]
      (set-slot rt (r rt ti) TB_SCHEMA (r rt si))
      (set-slot rt (r rt ti) TB_CHUNKS (r rt ci))
      (set-slot rt (r rt ti) TB_COUNT (fixnum nrows))
      (set-slot rt (r rt ti) TB_OFFSET (fixnum 0))
      (let [^Value out (r rt ti)]
        (pop-to rt base)
        (return out)))))

(doc "A table from COLUMNS -- `cols` is a vector of column vectors, in schema"
     "order.")
(defn ^:pub ^:method ^Value table-from-columns
  [^:mut ^Rt rt ^Value schema ^Value cols ^I32 nrows]
  (let [^RootIx base (mark rt)
        ^RootIx si (push rt schema)
        ^RootIx ci (push rt cols)
        ^I32 ncols (schema-len rt (r rt si))
        ^I32 width (schema-width rt (r rt si))
        ^Value chunks0 (empty-vec rt)
        ^RootIx ki (push rt chunks0)]
    (local ^:mut ^I32 row)
    (set row 0)
    (while (< row nrows)
      (if (not (charge-checked rt 1 (static-text "table")))
        (do (pop-to rt base)
            (return NIL)))
      (local ^:mut ^I32 take)
      (set take (- nrows row))
      (if (> take CHUNK) (set take CHUNK))
      (let [^Value ch (new-chunk rt width take)
            ^RootIx chi (push rt ch)]
        (for [^I32 c 0 ncols]
          (let [^I32 id (schema-id-at rt (r rt si) c)
                ^Value src (vec-nth rt (r rt ci) c NIL)
                ^RootIx sj (push rt src)
                ^Value types (slot rt (r rt si) SC_TYPES)
                ^Value tp (vec-nth rt types c NIL)
                ^Value col (new-obj rt TY_NODE take)
                ^RootIx cj (push rt col)]
            (for [^I32 k 0 take]
              (let [^Value v (vec-nth rt (r rt sj) (+ row k) NIL)]
                (if (not (type-ok rt tp v))
                  (do
                    (let [^Value name (schema-name-at rt (r rt si) c)
                          ^Text msg (column-type-error rt name tp v (+ row k))]
                      (pop-to rt base)
                      (return (throw-str rt "IllegalArgumentException" msg)))))
                (set-slot rt (r rt cj) k v)))
            (set-slot rt (r rt chi) (+ CH_BASE id) (r rt cj))
            (collapse rt (r rt chi) id)
            (pop-to rt sj)))
        (let [^Value nv (vec-conj rt (r rt ki) (r rt chi))]
          (set-r rt ki nv))
        (pop-to rt chi))
      (set row (+ row take)))
    (let [^Value t (heap (alloc rt TY_TABLE TB_LEN))
          ^RootIx ti (push rt t)]
      (set-slot rt (r rt ti) TB_SCHEMA (r rt si))
      (set-slot rt (r rt ti) TB_CHUNKS (r rt ki))
      (set-slot rt (r rt ti) TB_COUNT (fixnum nrows))
      (set-slot rt (r rt ti) TB_OFFSET (fixnum 0))
      (let [^Value out (r rt ti)]
        (pop-to rt base)
        (return out)))))
