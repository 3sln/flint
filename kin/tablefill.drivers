            if (!Val.isHeap(a) || !Val.isHeap(b)) return false;
            if (ty(rt.gc.sp, a) != TY_VEC || ty(rt.gc.sp, b) != TY_VEC) return false;
            int n = vecCount(rt, a);
            if (n != vecCount(rt, b)) return false;
            for (int i = 0; i < n; i++) if (!valEq(rt, rt.slot(a, i), rt.slot(b, i))) return false;
            return true;
        }
    }
