extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_SCHEMA: u8 = 48; const TY_TABLE: u8 = 49; const TY_TABLEREF: u8 = 50;
const TY_VEC: u8 = 9; const TY_NODE: u8 = 12; const TY_MAP: u8 = 14;
const TY_TTABLE: u8 = 51;
pub mod table {
    pub const SC_NAMES: u32 = 0; pub const SC_TYPES: u32 = 1; pub const SC_INDEX: u32 = 2;
    pub const SC_IDS: u32 = 3; pub const SC_WIDTH: u32 = 4; pub const SC_LEN: u32 = 5;
    pub const TB_SCHEMA: u32 = 0; pub const TB_CHUNKS: u32 = 1; pub const TB_COUNT: u32 = 2;
    pub const TB_OFFSET: u32 = 3; pub const TB_LEN: u32 = 4;
    pub const CH_ROWS: u32 = 0; pub const CH_ENC: u32 = 1; pub const CH_BASE: u32 = 2;
    pub const ENC_FLAT: u32 = 0; pub const ENC_CONST: u32 = 1;
    pub const RF_SCHEMA: u32 = 0; pub const RF_CHUNK: u32 = 1; pub const RF_ROW: u32 = 2;
    pub const RF_LEN: u32 = 3;
    pub const CHUNK: u32 = 256; pub const CHUNK_SHIFT: u32 = 8;
}
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && (self.0 >> 60) != 0xD }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, steps: u64 }
impl Rt {
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    // A VECTOR flat enough for a schema: the probe never builds one big enough
    // to need a trie, and `vec_count`/`vec_nth` are what the source asks for.
    fn vec_count(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn vec_nth(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        if i >= self.vec_count(v) { dflt } else { self.slot(v, i) }
    }
    // STRUCTURAL equality over the probe's vectors, because `schema-eq` is
    // about what two schemas SAY and not about which objects they are.
    fn val_eq(&mut self, a: Value, b: Value) -> bool {
        if a.0 == b.0 { return true; }
        if !a.is_heap() || !b.is_heap() { return false; }
        if ty(&self.gc.sp, a.as_heap()) != TY_VEC || ty(&self.gc.sp, b.as_heap()) != TY_VEC {
            return false;
        }
        let n = self.vec_count(a);
        if n != self.vec_count(b) { return false; }
        for i in 0..n {
            let (x, y) = (self.slot(a, i), self.slot(b, i));
            if !self.val_eq(x, y) { return false; }
        }
        true
    }
    fn vector(&mut self, xs: &[Value]) -> Value {
        let a = self.alloc(TY_VEC, xs.len().max(1) as u32);
        self.lens[a as usize] = xs.len() as u32;
        for (i, x) in xs.iter().enumerate() { self.h[a as usize + i] = x.0; }
        Value::heap(a)
    }
    // ROOTS. `table-ref` and `ref-to-map` allocate, so the shadow stack is the
    // one thing the probe cannot leave out: `0031` says a value in a host
    // local does not survive an allocation.
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_slot(&mut self, a: Value, i: u32, v: Value) { self.set(a, i, v); }
    // A MAP as alternating key/value slots. Small, ordered, and enough: the
    // schema index is the only map here and it holds one entry per column.
    fn empty_map(&mut self) -> Value { let a = self.alloc(TY_MAP, 0); Value::heap(a) }
    fn map_get(&mut self, m: Value, k: Value, dflt: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(m, i).0 == k.0 { return self.slot(m, i + 1); }
            i += 2;
        }
        dflt
    }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let a = self.alloc(TY_MAP, n + 2);
        let out = Value::heap(a);
        for i in 0..n { let x = self.slot(m, i); self.set(out, i, x); }
        self.set(out, n, k);
        self.set(out, n + 1, v);
        self.lens[a as usize] = n + 2;
        out
    }
    fn map_pairs(&self, m: Value) -> u32 { self.lens[m.0 as usize] / 2 }
    fn obj(&mut self, t: u8, n: u32) -> Value { let a = self.alloc(t, n); Value::heap(a) }
    // `new-obj` answers NIL when the heap refuses. The probe's heap never
    // does, but the wrapper is what the source calls.
    fn new_obj(&mut self, t: u8, n: u32) -> Value { self.obj(t, n) }
    fn charge_work(&mut self, n: u64) { self.steps += n; }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
// THE ACCESSORS THIS SOURCE CONSUMES AS SIBLINGS -- `tablemeta` generates
// them, so the probe supplies its own.
impl Rt {
    fn schema_len(&self, s: Value) -> u32 { self.vec_count(self.slot(s, table::SC_NAMES)) }
    fn schema_name_at(&mut self, s: Value, c: u32) -> Value {
        let names = self.slot(s, table::SC_NAMES);
        self.vec_nth(names, c, NIL)
    }
    fn table_count(&mut self, t: Value) -> u32 { self.slot(t, table::TB_COUNT).as_fixnum() as u32 }
    fn is_table_ref(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_TABLEREF
    }
    fn schema_width(&mut self, s: Value) -> u32 {
        self.slot(s, table::SC_WIDTH).as_fixnum() as u32
    }
    fn schema_id(&mut self, s: Value, name: Value) -> u32 {
        let p = self.map_get(self.slot(s, table::SC_INDEX), name, NIL);
        if p.is_fixnum() { p.as_fixnum() as u32 } else { self.schema_width(s) }
    }
    fn ref_get(&mut self, rf: Value, name: Value, dflt: Value) -> Value {
        let s = self.slot(rf, table::RF_SCHEMA);
        let id = self.schema_id(s, name);
        if id >= self.schema_width(s) { return dflt; }
        let ch = self.slot(rf, table::RF_CHUNK);
        let row = self.slot(rf, table::RF_ROW).as_fixnum() as u32;
        self.chunk_get(ch, id, row)
    }
    fn table_offset(&mut self, t: Value) -> u32 { self.slot(t, table::TB_OFFSET).as_fixnum() as u32 }
    fn chunk_get(&mut self, ch: Value, id: u32, row: u32) -> Value {
        let col = self.slot(ch, table::CH_BASE + id);
        let e = self.slot(ch, table::CH_ENC);
        if self.slot(e, id).as_fixnum() as u32 == table::ENC_CONST { col } else { self.slot(col, row) }
    }
}
impl Rt {
    // The siblings this source consumes: `tablemeta` and `tablecell` generate
    // them, so the probe brings its own.
    fn schema_id_at(&mut self, s: Value, c: u32) -> u32 {
        let ids = self.slot(s, table::SC_IDS);
        self.vec_nth(ids, c, NIL).as_fixnum() as u32
    }
    fn chunk_rows(&mut self, ch: Value) -> u32 { self.slot(ch, table::CH_ROWS).as_fixnum() as u32 }
    fn chunk_enc(&mut self, ch: Value, id: u32) -> u32 {
        let e = self.slot(ch, table::CH_ENC);
        self.slot(e, id).as_fixnum() as u32
    }
    fn new_chunk(&mut self, width: u32, rows: u32) -> Value {
        let ch = self.new_obj(TY_NODE, table::CH_BASE + width);
        self.set(ch, table::CH_ROWS, Value::fixnum(rows as i64));
        let enc = self.new_obj(TY_NODE, if width < 1 { 1 } else { width });
        for id in 0..width { self.set(enc, id, Value::fixnum(table::ENC_FLAT as i64)); }
        self.set(ch, table::CH_ENC, enc);
        ch
    }
    fn collapse(&mut self, ch: Value, id: u32) {
        let col = self.slot(ch, table::CH_BASE + id);
        let n = self.olen(col);
        if n == 0 { return; }
        let first = self.slot(col, 0);
        for k in 1..n { if self.slot(col, k).0 != first.0 { return; } }
        self.set(ch, table::CH_BASE + id, first);
        let e = self.slot(ch, table::CH_ENC);
        self.set(e, id, Value::fixnum(table::ENC_CONST as i64));
    }
    fn row_column(&mut self, s: Value, row: Value, c: u32) -> Value {
        let names = self.slot(s, table::SC_NAMES);
        let name = self.vec_nth(names, c, NIL);
        if self.is_table_ref(row) { self.ref_get(row, name, NOT_FOUND) }
        else { self.map_get(row, name, NOT_FOUND) }
    }
    // A SCHEMA whose ids are its positions, which is what an unmigrated one
    // looks like. `col` reads a column out whatever its encoding.
    fn schema(&mut self, names: &[Value]) -> Value {
        let s = self.obj(TY_SCHEMA, table::SC_LEN);
        let nv = self.vector(names);
        self.set(s, table::SC_NAMES, nv);
        let ids: alloc::vec::Vec<Value> = (0..names.len()).map(|i| Value::fixnum(i as i64)).collect();
        let iv = self.vector(&ids);
        self.set(s, table::SC_IDS, iv);
        self.set(s, table::SC_WIDTH, Value::fixnum(names.len() as i64));
        let mut idx = self.empty_map();
        for (i, n) in names.iter().enumerate() { idx = self.map_assoc(idx, *n, Value::fixnum(i as i64)); }
        self.set(s, table::SC_INDEX, idx);
        s
    }
    fn show_chunk(&mut self, ch: Value, ids: u32, rows: u32) -> alloc::string::String {
        let mut out = alloc::vec::Vec::new();
        for id in 0..ids {
            let e = self.chunk_enc(ch, id);
            let mut cells = alloc::vec::Vec::new();
            for r in 0..rows { cells.push(self.chunk_get(ch, id, r).as_fixnum().to_string()); }
            out.push(alloc::format!("{}[{}]", e, cells.join(".")));
        }
        out.join(",")
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 200000], gc: Gc { sp: Space { m: vec![0u8; 200000] } },
                      lens: vec![0; 200000], bump: 100, roots: Vec::new(), steps: 0 };
    let mut o = String::new();
    let na = Value::fixnum(101); let nb = Value::fixnum(102);
    let sch = rt.schema(&[na, nb]);
    let mkrow = |rt: &mut Rt, a: i64, b: i64| -> Value {
        let mut m = rt.empty_map();
        m = rt.map_assoc(m, na, Value::fixnum(a));
        m = rt.map_assoc(m, nb, Value::fixnum(b));
        m
    };
    // WRITE-ROW fills a chunk that is already the right shape.
    let ch = rt.new_chunk(2, 3);
    for id in 0..2u32 { let col = rt.obj(TY_NODE, 3); rt.set(ch, table::CH_BASE + id, col); }
    for k in 0..3u32 {
        let row = mkrow(&mut rt, 10 + k as i64, 7);
        rt.write_row(sch, ch, k, row);
    }
    let w = rt.show_chunk(ch, 2, 3);
    o.push_str(&format!("write={} ", w));
    // OPEN-CHUNK is full width and CHUNK long, whatever gets written.
    let open = rt.open_chunk(sch);
    let ocol = rt.slot(open, table::CH_BASE);
    let olen = rt.lens[ocol.0 as usize];
    let orows = rt.chunk_rows(open);
    o.push_str(&format!("open={}/{} ", olen, orows));
    // SEAL copies out only the rows written, and collapses on the way: column
    // 1 is all sevens and becomes constant, column 0 is not.
    for k in 0..3u32 {
        let row = mkrow(&mut rt, 20 + k as i64, 7);
        rt.write_row(sch, open, k, row);
    }
    let sealed = rt.seal(sch, open, 3);
    let sc = rt.slot(sealed, table::CH_BASE);
    let sclen = rt.lens[sc.0 as usize];
    let s1 = rt.show_chunk(sealed, 2, 3);
    o.push_str(&format!("seal={}/{} ", sclen, s1));
    // CHUNK-WITH-ROW, replacing row 1 without growing. Column 1 stays
    // constant because the new value is the same value.
    let r1 = mkrow(&mut rt, 99, 7);
    let rep = rt.chunk_with_row(sch, sealed, 1, r1, false);
    let reprows = rt.chunk_rows(rep);
    let s2 = rt.show_chunk(rep, 2, 3);
    o.push_str(&format!("replace={}/{} ", reprows, s2));
    // A CONSTANT COLUMN GIVEN A DIFFERENT VALUE has to expand back to flat.
    let r2 = mkrow(&mut rt, 99, 8);
    let broke = rt.chunk_with_row(sch, sealed, 1, r2, false);
    let s3 = rt.show_chunk(broke, 2, 3);
    o.push_str(&format!("broke={} ", s3));
    // AND GROWING: one row longer, written at the end.
    let r3 = mkrow(&mut rt, 40, 7);
    let grown = rt.chunk_with_row(sch, sealed, 3, r3, true);
    let growrows = rt.chunk_rows(grown);
    let s4 = rt.show_chunk(grown, 2, 4);
    o.push_str(&format!("grow={}/{} ", growrows, s4));
    // COLLAPSING ON THE WAY OUT: a flat column whose one differing row is
    // replaced becomes constant again. Without that check a table would only
    // ever LOSE encodings.
    let r4 = mkrow(&mut rt, 99, 8);
    let flat = rt.chunk_with_row(sch, sealed, 1, r4, false);
    let r5 = mkrow(&mut rt, 99, 7);
    let refolded = rt.chunk_with_row(sch, flat, 1, r5, false);
    let s5 = rt.show_chunk(refolded, 2, 3);
    o.push_str(&format!("refold={}", s5));
    println!("{}", o);
}
--java-head
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.eq` below stays for `hash-value`'s sake and this
    // forwards to it, which keeps whatever counting each probe does.
    static boolean valEq(Rt rt, long a, long b) { return com.flint.rt.Eq.eq(rt, a, b); }
    static final long NIL = 0xFFFFL;
    static final int TY_SCHEMA = 48, TY_TABLE = 49, TY_TABLEREF = 50,
                     TY_VEC = 9, TY_NODE = 12, TY_MAP = 14, TY_TTABLE = 51;
    static final class Table {
        static final int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                         SC_WIDTH = 4, SC_LEN = 5;
        static final int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, TB_OFFSET = 3, TB_LEN = 4;
        static final int CH_ROWS = 0, CH_ENC = 1, CH_BASE = 2;
        static final int ENC_FLAT = 0, ENC_CONST = 1;
        static final int RF_SCHEMA = 0, RF_CHUNK = 1, RF_ROW = 2, RF_LEN = 3;
        static final int CHUNK = 256, CHUNK_SHIFT = 8;
    }
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && (v >>> 60) != 0xDL; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v & 0xFFFFFFFFL; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
        static boolean isFixnum(long v) { return (v >>> 60) == 0xDL; }
        static final long NOT_FOUND = 0xFFFEL;
