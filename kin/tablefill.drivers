        long ch = Conc.newObj(rt, TY_NODE, Table.CH_BASE + width);
        rt.set(ch, Table.CH_ROWS, Val.fixnum(rows));
        long enc = Conc.newObj(rt, TY_NODE, width < 1 ? 1 : width);
        for (int id = 0; id < width; id++) rt.set(enc, id, Val.fixnum(Table.ENC_FLAT));
        rt.set(ch, Table.CH_ENC, enc);
        return ch;
    }
    static void collapse(Rt rt, long ch, int id) {
        long col = rt.slot(ch, Table.CH_BASE + id);
        int n = olen(rt, col);
        if (n == 0) return;
        long first = rt.slot(col, 0);
        for (int k = 1; k < n; k++) if (rt.slot(col, k) != first) return;
        rt.set(ch, Table.CH_BASE + id, first);
        rt.set(rt.slot(ch, Table.CH_ENC), id, Val.fixnum(Table.ENC_CONST));
    }
    static long rowColumn(Rt rt, long s, long row, int c) {
        long name = Vec.nth(rt, rt.slot(s, Table.SC_NAMES), c, NIL);
        return isTableRef(rt, row) ? refGet(rt, row, name, Val.NOT_FOUND)
                                   : mapGet(rt, row, name, Val.NOT_FOUND);
    }
    static long schema(Rt rt, long[] names) {
        long s = obj(rt, TY_SCHEMA, Table.SC_LEN);
        rt.set(s, Table.SC_NAMES, vector(rt, names));
        long[] ids = new long[names.length];
        for (int i = 0; i < names.length; i++) ids[i] = Val.fixnum(i);
        rt.set(s, Table.SC_IDS, vector(rt, ids));
        rt.set(s, Table.SC_WIDTH, Val.fixnum(names.length));
        long idx = emptyMap(rt);
        for (int i = 0; i < names.length; i++) idx = mapAssoc(rt, idx, names[i], Val.fixnum(i));
        rt.set(s, Table.SC_INDEX, idx);
        return s;
    }
    static String showChunk(Rt rt, long ch, int ids, int rows) {
        StringBuilder o = new StringBuilder();
        for (int id = 0; id < ids; id++) {
            if (id > 0) o.append(',');
            o.append(chunkEnc(rt, ch, id)).append('[');
            for (int r = 0; r < rows; r++) {
                if (r > 0) o.append('.');
                o.append(Val.asFixnum(chunkGet(rt, ch, id, r)));
            }
            o.append(']');
        }
        return o.toString();
    }
    static long NA, NB, SCH;
    static long mkrow(Rt rt, long a, long b) {
        long m = emptyMap(rt);
        m = mapAssoc(rt, m, NA, Val.fixnum(a));
        m = mapAssoc(rt, m, NB, Val.fixnum(b));
        return m;
    }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        NA = Val.fixnum(101); NB = Val.fixnum(102);
        SCH = schema(rt, new long[]{NA, NB});
        long ch = newChunk(rt, 2, 3);
        for (int id = 0; id < 2; id++) rt.set(ch, Table.CH_BASE + id, obj(rt, TY_NODE, 3));
        for (int k = 0; k < 3; k++) writeRow(rt, SCH, ch, k, mkrow(rt, 10 + k, 7));
        o.append("write=").append(showChunk(rt, ch, 2, 3)).append(' ');
        long open = openChunk(rt, SCH);
        o.append("open=").append(olen(rt, rt.slot(open, Table.CH_BASE))).append('/')
         .append(chunkRows(rt, open)).append(' ');
        for (int k = 0; k < 3; k++) writeRow(rt, SCH, open, k, mkrow(rt, 20 + k, 7));
        long sealed = seal(rt, SCH, open, 3);
        o.append("seal=").append(olen(rt, rt.slot(sealed, Table.CH_BASE))).append('/')
         .append(showChunk(rt, sealed, 2, 3)).append(' ');
        long rep = chunkWithRow(rt, SCH, sealed, 1, mkrow(rt, 99, 7), false);
        o.append("replace=").append(chunkRows(rt, rep)).append('/')
         .append(showChunk(rt, rep, 2, 3)).append(' ');
        long broke = chunkWithRow(rt, SCH, sealed, 1, mkrow(rt, 99, 8), false);
        o.append("broke=").append(showChunk(rt, broke, 2, 3)).append(' ');
        long grown = chunkWithRow(rt, SCH, sealed, 3, mkrow(rt, 40, 7), true);
        o.append("grow=").append(chunkRows(rt, grown)).append('/')
         .append(showChunk(rt, grown, 2, 4)).append(' ');
        long flat = chunkWithRow(rt, SCH, sealed, 1, mkrow(rt, 99, 8), false);
        long refolded = chunkWithRow(rt, SCH, flat, 1, mkrow(rt, 99, 7), false);
        o.append("refold=").append(showChunk(rt, refolded, 2, 3));
        System.out.println(o.toString());
    }
--csharp-pre
namespace Flint.Rt {
    internal static class Table {
        internal const int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                           SC_WIDTH = 4, SC_LEN = 5;
        internal const int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, TB_OFFSET = 3, TB_LEN = 4;
        internal const int CH_ROWS = 0, CH_ENC = 1, CH_BASE = 2;
        internal const int ENC_FLAT = 0, ENC_CONST = 1;
        internal const int RF_SCHEMA = 0, RF_CHUNK = 1, RF_ROW = 2, RF_LEN = 3;
        internal const int CHUNK = 256, CHUNK_SHIFT = 8;
    }
    // A REAL top-level namespace: the generated C# reaches this as
    // `global::Flint.Rt.Eq`, and `global::` needs a genuine root.
    // The generated C# reaches these as `global::Flint.Rt.X`, and `global::`
    // needs a genuine root namespace -- a shim nested in `class Probe` is not
    // one.
    internal static class Maps {
        internal static long Empty(Probe.Rt rt) { return Probe.Val.Heap(rt.Alloc(Probe.Obj.TyMap, 0)); }
    }
    internal static class Eq {
        internal static bool Equal(Probe.Rt rt, long a, long b) {
            if (a == b) return true;
            if (!Probe.Val.IsHeap(a) || !Probe.Val.IsHeap(b)) return false;
            if (Probe.Obj.Ty(rt.gc.sp, a) != Probe.Obj.TyVec
                || Probe.Obj.Ty(rt.gc.sp, b) != Probe.Obj.TyVec) return false;
            int n = Probe.VecCount(rt, a);
            if (n != Probe.VecCount(rt, b)) return false;
            for (int i = 0; i < n; i++) if (!Equal(rt, rt.Slot(a, i), rt.Slot(b, i))) return false;
            return true;
        }
    }
}
--csharp-head
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE.
    internal static bool ValEq(Rt rt, long a, long b) { return global::Flint.Rt.Eq.Equal(rt, a, b); }
    internal static class Obj {
        internal const int TySchema = 48, TyTable = 49, TyTableref = 50,
                           TyVec = 9, TyNode = 12, TyMap = 14, TyTtable = 51;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil && (long)((ulong) v >> 60) != 0xDL; }
        internal static long AsHeap(long v) { return v; }
        internal static long AsFixnum(long v) { return v & 0xFFFFFFFFL; }
        internal static long Fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static bool IsFixnum(long v) { return (long)((ulong) v >> 60) == 0xDL; }
        internal const long NotFound = 0xFFFEL;
    }
    internal sealed class Space { internal byte[] m = new byte[40000]; }
    internal sealed class Rt {
        internal long[] h = new long[40000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[40000];
        internal long bump = 100;
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long steps = 0;
        internal void ChargeWork(long n) { steps += n; }
        internal void Set(long n, int i, long v) { h[(int) n + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    internal static int VecCount(Rt rt, long v) { return rt.lens[(int) v]; }
    internal static class Vec {
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            return i >= VecCount(rt, v) ? dflt : rt.Slot(v, i);
        }
    }
    internal static long VecNth(Rt rt, long v, int i, long dflt) { return Vec.Nth(rt, v, i, dflt); }
    internal static long Vector(Rt rt, long[] xs) {
        long a = rt.Alloc(Obj.TyVec, System.Math.Max(1, xs.Length));
        rt.lens[(int) a] = xs.Length;
        for (int i = 0; i < xs.Length; i++) rt.h[(int) a + i] = xs[i];
        return Val.Heap(a);
    }
    internal static int Olen(Rt rt, long v) { return rt.lens[(int) v]; }
    internal static long Obj2(Rt rt, int t, int n) { return Val.Heap(rt.Alloc(t, n)); }
    internal static class Conc {
        internal static long NewObj(Rt rt, int t, int n) { return Obj2(rt, t, n); }
    }
    internal static long EmptyMap(Rt rt) { return global::Flint.Rt.Maps.Empty(rt); }
    internal static long MapGet(Rt rt, long m, long k, long dflt) {
        int n = rt.lens[(int) m];
        for (int i = 0; i < n; i += 2) if (rt.Slot(m, i) == k) return rt.Slot(m, i + 1);
        return dflt;
    }
    internal static long MapAssoc(Rt rt, long m, long k, long v) {
        int n = rt.lens[(int) m];
        long a = rt.Alloc(Obj.TyMap, n + 2);
        long outv = Val.Heap(a);
        for (int i = 0; i < n; i++) rt.Set(outv, i, rt.Slot(m, i));
        rt.Set(outv, n, k);
        rt.Set(outv, n + 1, v);
        rt.lens[(int) a] = n + 2;
        return outv;
    }
    internal static int MapPairs(Rt rt, long m) { return rt.lens[(int) m] / 2; }
    internal static int SchemaLen(Rt rt, long s) { return VecCount(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES)); }
    internal static long SchemaNameAt(Rt rt, long s, int c) {
        return Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES), c, Val.Nil);
    }
    internal static int TableCount(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_COUNT)); }
    internal static bool IsTableRef(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyTableref;
    }
    internal static int SchemaWidth(Rt rt, long s) { return (int) Val.AsFixnum(rt.Slot(s, global::Flint.Rt.Table.SC_WIDTH)); }
    internal static int SchemaId(Rt rt, long s, long name) {
        long p = MapGet(rt, rt.Slot(s, global::Flint.Rt.Table.SC_INDEX), name, Val.Nil);
        return Val.IsFixnum(p) ? (int) Val.AsFixnum(p) : SchemaWidth(rt, s);
    }
    internal static long RefGet(Rt rt, long rf, long name, long dflt) {
        long s = rt.Slot(rf, global::Flint.Rt.Table.RF_SCHEMA);
        int id = SchemaId(rt, s, name);
        if (id >= SchemaWidth(rt, s)) return dflt;
        return ChunkGet(rt, rt.Slot(rf, global::Flint.Rt.Table.RF_CHUNK), id,
                        (int) Val.AsFixnum(rt.Slot(rf, global::Flint.Rt.Table.RF_ROW)));
    }
    internal static int TableOffset(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_OFFSET)); }
    internal static long ChunkGet(Rt rt, long ch, int id, int row) {
        long col = rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id);
        long e = rt.Slot(ch, global::Flint.Rt.Table.CH_ENC);
        return (int) Val.AsFixnum(rt.Slot(e, id)) == global::Flint.Rt.Table.ENC_CONST ? col : rt.Slot(col, row);
    }
    internal static int SchemaIdAt(Rt rt, long s, int c) {
        return (int) Val.AsFixnum(Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_IDS), c, Val.Nil));
    }
    internal static int ChunkRows(Rt rt, long ch) { return (int) Val.AsFixnum(rt.Slot(ch, global::Flint.Rt.Table.CH_ROWS)); }
    internal static int ChunkEnc(Rt rt, long ch, int id) {
        return (int) Val.AsFixnum(rt.Slot(rt.Slot(ch, global::Flint.Rt.Table.CH_ENC), id));
    }
    internal static long NewChunk(Rt rt, int width, int rows) {
        long ch = Conc.NewObj(rt, Obj.TyNode, global::Flint.Rt.Table.CH_BASE + width);
        rt.Set(ch, global::Flint.Rt.Table.CH_ROWS, Val.Fixnum(rows));
        long enc = Conc.NewObj(rt, Obj.TyNode, width < 1 ? 1 : width);
        for (int id = 0; id < width; id++) rt.Set(enc, id, Val.Fixnum(global::Flint.Rt.Table.ENC_FLAT));
        rt.Set(ch, global::Flint.Rt.Table.CH_ENC, enc);
        return ch;
    }
    internal static void Collapse(Rt rt, long ch, int id) {
        long col = rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id);
        int n = Olen(rt, col);
        if (n == 0) return;
        long first = rt.Slot(col, 0);
        for (int k = 1; k < n; k++) if (rt.Slot(col, k) != first) return;
        rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, first);
        rt.Set(rt.Slot(ch, global::Flint.Rt.Table.CH_ENC), id, Val.Fixnum(global::Flint.Rt.Table.ENC_CONST));
    }
    internal static long RowColumn(Rt rt, long s, long row, int c) {
        long name = Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES), c, Val.Nil);
        return IsTableRef(rt, row) ? RefGet(rt, row, name, Val.NotFound)
                                   : MapGet(rt, row, name, Val.NotFound);
    }
    internal static long Schema(Rt rt, long[] names) {
        long s = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(s, global::Flint.Rt.Table.SC_NAMES, Vector(rt, names));
        long[] ids = new long[names.Length];
        for (int i = 0; i < names.Length; i++) ids[i] = Val.Fixnum(i);
        rt.Set(s, global::Flint.Rt.Table.SC_IDS, Vector(rt, ids));
        rt.Set(s, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(names.Length));
        long idx = EmptyMap(rt);
        for (int i = 0; i < names.Length; i++) idx = MapAssoc(rt, idx, names[i], Val.Fixnum(i));
        rt.Set(s, global::Flint.Rt.Table.SC_INDEX, idx);
        return s;
    }
    internal static string ShowChunk(Rt rt, long ch, int ids, int rows) {
        var o = new System.Text.StringBuilder();
        for (int id = 0; id < ids; id++) {
            if (id > 0) o.Append(',');
            o.Append(ChunkEnc(rt, ch, id)).Append('[');
            for (int r = 0; r < rows; r++) {
                if (r > 0) o.Append('.');
                o.Append(Val.AsFixnum(ChunkGet(rt, ch, id, r)));
            }
            o.Append(']');
        }
        return o.ToString();
    }
    internal static long NA, NB, SCH;
    internal static long Mkrow(Rt rt, long a, long b) {
        long m = EmptyMap(rt);
        m = MapAssoc(rt, m, NA, Val.Fixnum(a));
        m = MapAssoc(rt, m, NB, Val.Fixnum(b));
        return m;
    }
--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        NA = Val.Fixnum(101); NB = Val.Fixnum(102);
        SCH = Schema(rt, new long[]{NA, NB});
        long ch = NewChunk(rt, 2, 3);
        for (int id = 0; id < 2; id++)
            rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, Obj2(rt, Obj.TyNode, 3));
        for (int k = 0; k < 3; k++) WriteRow(rt, SCH, ch, k, Mkrow(rt, 10 + k, 7));
        o.Append("write=").Append(ShowChunk(rt, ch, 2, 3)).Append(' ');
        long open = OpenChunk(rt, SCH);
        o.Append("open=").Append(Olen(rt, rt.Slot(open, global::Flint.Rt.Table.CH_BASE))).Append('/')
         .Append(ChunkRows(rt, open)).Append(' ');
        for (int k = 0; k < 3; k++) WriteRow(rt, SCH, open, k, Mkrow(rt, 20 + k, 7));
        long sealed_ = Seal(rt, SCH, open, 3);
        o.Append("seal=").Append(Olen(rt, rt.Slot(sealed_, global::Flint.Rt.Table.CH_BASE))).Append('/')
         .Append(ShowChunk(rt, sealed_, 2, 3)).Append(' ');
        long rep = ChunkWithRow(rt, SCH, sealed_, 1, Mkrow(rt, 99, 7), false);
        o.Append("replace=").Append(ChunkRows(rt, rep)).Append('/')
         .Append(ShowChunk(rt, rep, 2, 3)).Append(' ');
        long broke = ChunkWithRow(rt, SCH, sealed_, 1, Mkrow(rt, 99, 8), false);
        o.Append("broke=").Append(ShowChunk(rt, broke, 2, 3)).Append(' ');
        long grown = ChunkWithRow(rt, SCH, sealed_, 3, Mkrow(rt, 40, 7), true);
        o.Append("grow=").Append(ChunkRows(rt, grown)).Append('/')
         .Append(ShowChunk(rt, grown, 2, 4)).Append(' ');
        long flat = ChunkWithRow(rt, SCH, sealed_, 1, Mkrow(rt, 99, 8), false);
        long refolded = ChunkWithRow(rt, SCH, flat, 1, Mkrow(rt, 99, 7), false);
        o.Append("refold=").Append(ShowChunk(rt, refolded, 2, 3));
        System.Console.WriteLine(o.ToString());
    }
