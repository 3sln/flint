    static final int TY_BYTES = 44, TY_BROPE = 45, TY_TBYTES = 46, TY_VEC = 9;
    // Reached as `Bytes.BB_BYTES`, as in the real runtime.
    static final class Str { static final int FLAT_MAX = 8, FANOUT = 3; }
    static final class Bytes {
        static final int FLAT_MAX = 8, FANOUT = 3;
        static final int BB_BYTES = 0, BB_FLAT = 1, BB_DEPTH = 2, BB_HASH = 3, BB_KIDS = 4;
        static final int TB_TREE = 0, TB_TAIL = 1, TB_FILL = 2, TB_LIVE = 3;
        static final int TAIL_CAP = 8;
    }
    // `byteflat`'s now, reached across modules. A leaf is modelled by its
    // LENGTH alone here, so joining two is a leaf of the summed length.
    static long bCopyConcat(Rt rt, long a, long b) {
        int n = bCount(rt, a) + bCount(rt, b);
        long x = rt.alloc(TY_BYTES, n);
        if (x == 0) return NIL;
        return Val.heap(x);
    }
    static final class Val {
        static boolean isNil(long v) { return v == NIL; }
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != TRUE; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
        static long fixnum(long n) { return n; }
        static long heap(long a) { return a; }
        static final long TRUE = Probe.TRUE, NIL = Probe.NIL;
    }
    static final class Rt {
        long[] h = new long[4000];
        static final class GcT { int[] sp = new int[4000]; }
        GcT gc = new GcT();
        int[] lens = new int[4000];
        long bump = 100;
        boolean starve = false;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        void setR(int i, long v) { roots.set(i, v); }
        long alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
    static int olen(Rt rt, long v) { return rt.lens[(int) v]; }
    // `bytecore`'s, reached through `import static` in the shipped file.
    static int bCount(Rt rt, long v) {
        if (!Val.isHeap(v)) return 0;
        int t = ty(rt.gc.sp, v);
        if (t == TY_BYTES) return olen(rt, v);
        if (t == TY_BROPE) return (int) rt.slot(v, Bytes.BB_BYTES);
        return 0;
    }
    static int bDepth(Rt rt, long v) {
        if (Val.isHeap(v) && ty(rt.gc.sp, v) == TY_BROPE) return (int) rt.slot(v, Bytes.BB_DEPTH);
        return 0;
    }
    static long bNode(Rt rt, int base, int n) {
        int total = 0;
        for (int i = 0; i < n; i++) total += bCount(rt, rt.r(base + i));
        long a = rt.alloc(TY_BROPE, Bytes.BB_KIDS + n);
        if (a == 0) return NIL;
        rt.setSlot(a, Bytes.BB_BYTES, total);
        rt.setSlot(a, Bytes.BB_FLAT, NIL);
        rt.setSlot(a, Bytes.BB_HASH, NIL);
        rt.setSlot(a, Bytes.BB_DEPTH, bDepth(rt, rt.r(base)) + 1);
        for (int i = 0; i < n; i++) rt.setSlot(a, Bytes.BB_KIDS + i, rt.r(base + i));
        return Val.heap(a);
    }
    static long bWrapTo(Rt rt, long v, int d) {
        int base = rt.mark();
        int ci = rt.push(v);
        while (bDepth(rt, rt.r(ci)) < d) rt.setR(ci, bNode(rt, ci, 1));
        long out = rt.r(ci);
        rt.popTo(base);
        return out;
    }

