        long g = bConcat(rt, acc, big);
        o.append("t45=").append(bCount(rt, g)).append(',')
         .append(bDepth(rt, g) - d0).append(' ');
        o.append("decl=").append(Val.isNil(bMergeRight(rt, l3, big)) ? 1 : 0)
         .append(Val.isNil(bAbsorb(rt, l3, l3)) ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
