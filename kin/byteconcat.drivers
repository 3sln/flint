        for (int k = 0; k < 8; k++) {
            long piece = Val.heap(rt.alloc(TY_BYTES, 6));
            int base = rt.mark();
            rt.push(acc); rt.push(piece);
            long out = bConcat(rt, rt.r(base), rt.r(base + 1));
            rt.popTo(base);
            acc = out;
        }
        o.append("built=").append(ty(rt.gc.sp, acc)).append(',')
         .append(bCount(rt, acc)).append(',').append(bDepth(rt, acc)).append(' ');
        int d0 = bDepth(rt, acc);
        long m = bConcat(rt, acc, l3);
        o.append("t3=").append(bCount(rt, m)).append(',')
         .append(bDepth(rt, m) == d0 ? 1 : 0).append(' ');
