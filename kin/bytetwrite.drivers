--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, sinks: Vec::new(), roots: Vec::new() };
    let mut o = String::new();
    // TAIL_CAP is 4 here, so the flush boundary is reachable by hand.
    let mk = |rt: &mut Rt| {
        let tail = rt.leaf(&[0, 0, 0, 0]);
        let a = rt.alloc(TY_TBYTES, 4);
        rt.set(Value::heap(a), bytes::TB_TREE, NIL);
        rt.set(Value::heap(a), bytes::TB_TAIL, tail);
        rt.set(Value::heap(a), bytes::TB_FILL, Value::fixnum(0));
        rt.set(Value::heap(a), bytes::TB_LIVE, TRUE);
        Value::heap(a)
    };
    let show = |rt: &Rt, v: Value| -> String {
        (0..rt.lens[v.0 as usize])
            .map(|i| rt.gc.sp.read_u8(v.as_heap() + obj::HDR + i as u64).to_string())
            .collect::<Vec<_>>().join(".")
    };
    // BELOW CAPACITY: the tail fills in place, and the tree stays nil.
    let t = mk(&mut rt);
    for b in 1..4u32 { rt.b_conj(t, b); }
    o.push_str(&format!("fill={} tree={} ", rt.slot(t, bytes::TB_FILL).as_fixnum(),
                        (rt.slot(t, bytes::TB_TREE).0 == NIL.0) as u32));
    // PAST CAPACITY: the fourth fits, the fifth flushes and starts over.
    rt.b_conj(t, 4); rt.b_conj(t, 5);
    o.push_str(&format!("after={} flushed={} ", rt.slot(t, bytes::TB_FILL).as_fixnum(),
                        show(&rt, rt.slot(t, bytes::TB_TREE))));
    // SEALED: the partial tail joins, and the transient goes dead.
    let out = rt.b_persistent(t);
    o.push_str(&format!("out={} live={} ", show(&rt, out), rt.tb_live(t) as u32));
    // A DEAD one refuses rather than answering.
    let again = rt.b_persistent(t);
    o.push_str(&format!("reuse={} ", again.is_nil() as u32));
    // BULK APPEND, crossing the flush boundary twice: nine bytes into a
    // four-byte tail is two flushes and a partial remainder.
    let t3 = mk(&mut rt);
    let piece = rt.leaf(&[10,11,12,13,14,15,16,17,18]);
    rt.b_append_bytes(t3, piece);
    let bulk = rt.b_persistent(t3);
    o.push_str(&format!("bulk={} ", show(&rt, bulk)));
    // NOTHING APPENDED is the empty byte string, not nil.
    let t2 = mk(&mut rt);
    let e = rt.b_persistent(t2);
    o.push_str(&format!("empty={},{} ", rt.lens[e.0 as usize], e.is_nil() as u32));
    println!("{}", o);
}
