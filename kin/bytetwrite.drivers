            .map(|i| self.gc.sp.read_u8(a.as_heap() + obj::HDR + i as u64)).collect();
        let more: Vec<u8> = (0..self.lens[b.0 as usize])
            .map(|i| self.gc.sp.read_u8(b.as_heap() + obj::HDR + i as u64)).collect();
        bs.extend_from_slice(&more);
