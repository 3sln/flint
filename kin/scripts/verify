#!/bin/sh
# Generate a kin source for all three targets, compile each, run each, and
# require BYTE-IDENTICAL output.
#
# This is the acceptance check `doc/goals/kin-port.md` asks for, made
# repeatable. Compiling is not enough: three implementations can each compile
# and disagree, which is the failure the whole port exists to prevent.
#
#     kin/scripts/verify kin/codec.kin
set -e
root=$(cd "$(dirname "$0")/../.." && pwd)   # kin/scripts -> repo root
src=${1:-kin/codec.kin}
# A PRIVATE WORK DIRECTORY PER RUN.
#
# This used to be a fixed `$TMPDIR/kin-verify`, which two concurrent runs
# delete out from under each other -- the script starts with `rm -rf "$work"`.
# The symptom is a missing `probe.rust` and a `targets disagree` on a source
# that verifies perfectly on its own, which is a gate reporting red for a
# reason that has nothing to do with the code under test. A gate that fails
# at random gets re-run until it passes, and then it gets ignored.
work=$(mktemp -d "${TMPDIR:-/tmp}/kin-verify.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work"
cd "$root"

mkdir -p "$work/sec"
./kin/scripts/gen "$src" > "$work/gen.txt"
# Split on what the generator PRINTED, not on three names this script knows --
# a source with `:kin/only` generates fewer sections, and one for a language
# this script cannot compile generates a section it has to say it skipped.
awk -v dir="$work/sec" '/^==== .* =/ { f = dir "/" $2; next } f { print > f }' "$work/gen.txt"
cp "$work/sec/rust"   "$work/gen.rs"   2>/dev/null || true
cp "$work/sec/java"   "$work/gen.java" 2>/dev/null || true
cp "$work/sec/csharp" "$work/gen.cs"   2>/dev/null || true

# WHAT THIS SCRIPT CAN ACTUALLY COMPILE, against what the source produced.
# Comparing one output against itself is not a check, so a source that
# generates for fewer than two of these is refused rather than passed: the
# whole claim of `verify` is that independent implementations AGREE, and one
# implementation cannot.
present=""
for t in rust java csharp; do
  [ -s "$work/sec/$t" ] && present="$present $t"
done
skipped=""
for f in "$work"/sec/*; do
  [ -e "$f" ] || continue
  case " rust java csharp " in *" $(basename "$f") "*) ;; *) skipped="$skipped $(basename "$f")";; esac
done
[ -n "$skipped" ] && echo "  note kin/verify cannot compile:$skipped -- not checked here"
n=$(echo $present | wc -w | tr -d ' ')
if [ "$n" -lt 2 ]; then
  echo "kin/scripts/verify: $src generates for$present -- fewer than two targets this"
  echo "            script can compile, so there is nothing to compare. An"
  echo "            output identical to itself is not a check."
  exit 2
fi
echo "  comparing:$present"

# The driver each language needs. Kept beside the source so a new port writes
# one and the harness stays the same.
drv="${src%.kin}.drivers"
[ -f "$drv" ] || { echo "kin/scripts/verify: no drivers file at $drv"; exit 2; }

# A named section of the drivers file: everything after `--name` up to the
# next line that starts with `--`. A `-head` section is emitted BEFORE the
# generated code, which is how a source whose functions need a receiver or a
# type to exist gets one -- `impl Rt {` has to open before the methods and
# close after them.
section() {
  awk -v want="--$1" '
    /^--/ { on = ($0 == want); next }
    on { print }
  ' "$drv"
}

{ section rust-head; cat "$work/gen.rs"; section rust; } > "$work/probe.rs"
mv "$work/probe.rs" "$work/gen.rs"
{ echo 'import java.io.ByteArrayOutputStream; import java.nio.charset.StandardCharsets;'
  echo 'public class Probe {'; section java-head; cat "$work/gen.java"
  section java; echo '}'; } > "$work/Probe.java"

# A `--java-pre` section, for the same reason `--csharp-pre` exists.
#
# Some vocabulary entries name a host function FULLY QUALIFIED, because a
# generated module lives in a different package from the hand-written runtime
# and a bare name would not resolve there: `hash-double` is
# `com.flint.rt.Hash.hashDouble` on this target. A class nested inside `Probe`
# cannot answer to that -- Java allows many classes in a file and exactly one
# package -- so a fixture needing one writes its own file.
#
# `javac -d` places a class by its DECLARED package rather than by where the
# source sat, so the file needs no directory to match it.
# NAMED AFTER THE CLASS IT DECLARES, because javac insists a public class sit
# in a file of its own name -- the one rule that makes this section awkward and
# the reason it cannot simply be `pre.java`.
section java-pre > "$work/pre.java"
if [ -s "$work/pre.java" ]; then
  pre_class=$(sed -n 's/^public class \([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' "$work/pre.java" | head -1)
  [ -n "$pre_class" ] || { echo "  FAIL --java-pre must declare one \`public class X\`"; exit 1; }
  mv "$work/pre.java" "$work/$pre_class.java"
  pre_java="$work/$pre_class.java"
else
  rm -f "$work/pre.java"
fi
# A `--csharp-pre` section, emitted OUTSIDE the probe class.
#
# The generated C# reaches the runtime as `global::Flint.Rt.X`, because its own
# namespace ends in `Rt` and a bare `Flint.Rt` would resolve against the
# enclosing one. `global::` needs a REAL top-level namespace, and a fixture
# nested inside `class Probe` cannot provide one -- so the shims for the
# hand-written runtime go here, before the class, and the rest of the fixture
# stays where it was.
{ echo 'using System; using System.IO; using System.Text; using System.Numerics;'
  section csharp-pre
  echo 'class Probe {'
  section csharp-head; cat "$work/gen.cs"; section csharp; echo '}'; } > "$work/Program.cs"

# Each present target is built, run, and its answer recorded. The comparison
# below is over the answers that exist rather than over three fixed ones.
: > "$work/answers"
for t in $present; do
  case $t in
    rust)
      # `-A warnings`, and the reason is not tidiness. A probe fixture is
      # deliberately partial, so it is full of unused-method and unused-mut
      # noise. Once that noise passed twenty lines, `head` closed the pipe,
      # rustc took SIGPIPE and DIED BEFORE LINKING -- so there was no binary,
      # no error text, and an empty answer that read as "the targets
      # disagree". The compiler was being killed by its own log.
      #
      # `head` stays, as a bound on a real error. Silencing warnings is what
      # keeps a real error inside it.
      rustc -O -A warnings -o "$work/probe.rust" "$work/gen.rs" 2>&1 | head -20
      echo "rust $("$work/probe.rust")" >> "$work/answers" ;;
    java)
      JDK=/opt/homebrew/opt/openjdk
      [ -x "$JDK/bin/javac" ] || JDK=$(/usr/libexec/java_home 2>/dev/null)
      "$JDK/bin/javac" -d "$work" ${pre_java:+"$pre_java"} "$work/Probe.java" 2>&1 | head -20
      echo "java $("$JDK/bin/java" -cp "$work" Probe)" >> "$work/answers" ;;
    csharp)
      mkdir -p "$work/cs" && (cd "$work/cs" && dotnet new console -o . --force >/dev/null 2>&1)
      cp "$work/Program.cs" "$work/cs/Program.cs"
      echo "csharp $(cd "$work/cs" && dotnet run 2>/dev/null | tail -1)" >> "$work/answers" ;;
  esac
done

while read -r t out; do echo "  $t   $out"; done < "$work/answers"

# AN EMPTY ANSWER IS NOT AN ANSWER, and this check exists because the absence
# of it produced a green run over three CRASHED probes. Every target threw, so
# every target printed nothing, so all three "agreed" -- silence and success
# being indistinguishable unless something is built to tell them apart, which
# is the same defect `bin/check-builtins` and `conform` each had once.
#
# It is checked BEFORE the comparison, because after it the three are equal.
while read -r t out; do
  if [ -z "$out" ]; then
    echo "  FAIL $t produced no output -- it did not build, or it crashed"; exit 1
  fi
done < "$work/answers"

if [ "$(cut -d' ' -f2- < "$work/answers" | sort -u | wc -l | tr -d ' ')" = "1" ]; then
  echo "  ok   $n targets, one source, identical output"
else
  echo "  FAIL the targets disagree"; exit 1
fi
