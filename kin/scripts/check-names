#!/usr/bin/env bb
;; Every NAME in the vocabulary, checked against the runtime that has to define it.
;;
;;     kin/scripts/check-names
;;
;; A name table is an assertion that three runtimes agree about a spelling, and
;; nothing was checking it. `TY_SYMBOL` and `TY_KEYWORD` sat in `type-tags` for
;; the life of this port; no target has ever defined either -- they are `TY_SYM`
;; and `TY_KW` everywhere. Nothing broke, because no source had named a symbol's
;; type tag yet. The first one to do so would have emitted an undefined constant
;; into all three targets at once.
;;
;; That is the third time this exact shape has been found: `LS_THUNK` spelled
;; `LsThunk` on the CLR, `vec-nth` still claiming arity 2 after it grew a
;; `dflt`, and now this. Each was invisible for the same reason -- an entry
;; nothing used yet is an entry nothing checked -- and each was found by a
;; source finally using it rather than by a gate. This is the gate.
;;
;; It asks the WEAKEST question that catches it: does the emitted spelling
;; appear anywhere in that target's runtime sources? Not "is it a constant of
;; the right type" -- that needs a parser per language, and the failure being
;; caught here is a name that appears NOWHERE.
(require '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[flint.impl.rt :as rt])

(def trees
  {:rust   ["runtime/src"]
   :java   ["runtimes/jvm/src/com/flint/rt"]
   :csharp ["runtimes/clr/src/rt"]})

(defn sources [target]
  (mapcat (fn [d] (filter #(re-find #"\.(rs|java|cs)$" (str %))
                          (file-seq (java.io.File. d))))
          (trees target)))

(def text
  (into {} (for [t (keys trees)]
             [t (str/join "\n" (map slurp (sources t)))])))

;; The bare identifier a spelling ends in: `Obj.TyCons` is defined as `TyCons`,
;; `Val.NIL` as `NIL`. Qualification is the CALLER's business and says nothing
;; about how the definition is written.
(defn ident [s] (last (str/split s #"[.:]")))

(def failures (atom 0))

;; ---------------------------------------------------------------------------
;; AND EVERY CALL TEMPLATE, which was HALF THE VOCABULARY going unchecked.
;;
;; The names above are one kind of assertion that three runtimes agree about a
;; spelling; a `core/call` template is the other, and this gate only ever asked
;; about the first. `heap-ty?` emitted `{0}.is_heap_ty({1}, {2})` for Rust and
;; NO SUCH FUNCTION EXISTED -- the JVM had `isHeapTy` and the CLR `IsHeapTy`,
;; so two targets defined it and one did not. Invisible for the same reason as
;; every entry in the comment at the top of this file: no source had used the
;; form yet, and an entry nothing uses is an entry nothing checks.
;;
;; The templates are read as TEXT out of the vocabulary source, because
;; `core/call` closes over them and a closure cannot be asked what it would
;; emit. That is the same weakest question the rest of this file asks, applied
;; to the other half.
(def host-library
  "Identifiers a template calls that belong to the HOST's library rather than
  to a flint runtime, so no file of ours defines them and none should. Listed
  rather than pattern-matched: each one is a decision that this call is the
  host's to answer, and a list this short having to grow is the right kind of
  friction.

  The four float predicates are here for the same reason as the two integer
  ones: whether a double is a NaN or an infinity is a question every host
  answers already, and a flint spelling of it would be three copies of
  `d != d` waiting to disagree."
  #{"divideUnsigned" "remainderUnsigned"
    "isNaN" "IsNaN" "isInfinite" "IsInfinity"
    "POSITIVE_INFINITY" "PositiveInfinity"
    ;; A DOUBLE'S BITS. Reinterpreting an IEEE double as an integer is the
    ;; host's job everywhere -- `f64::to_bits`, `Double.doubleToLongBits`,
    ;; `BitConverter.DoubleToInt64Bits` -- and the three names share nothing,
    ;; which is exactly why `f64-bits` is a vocabulary entry. A flint spelling
    ;; would be three copies of a cast that no language will do with a cast.
    "to_bits" "doubleToLongBits" "DoubleToInt64Bits"})

(defn check [what nm target spelling]
  (let [id (ident spelling)]
    ;; `host-library` APPLIES HERE TOO. A name can be the host's as easily as
    ;; a call can -- `Double.POSITIVE_INFINITY` is not something a flint
    ;; runtime defines and never will be -- and this half of the gate did not
    ;; ask. `I64_MIN` passed it only because `MIN_VALUE` happens to appear in
    ;; a port source somewhere, which is a pass by coincidence rather than by
    ;; assertion; declaring the host's names makes the difference visible.
    (when-not (or (host-library id) (str/includes? (get text target) id))
      (swap! failures inc)
      (println (format "  FAIL %s `%s` emits `%s` for %s, and no file under %s defines `%s`"
                       what nm spelling (name target)
                       (str/join ", " (get trees target)) id)))))


(def templates
  (let [src (slurp "kin/src/flint/impl/rt.cljc")]
    (for [[_ target tmpl] (re-seq #":(rust|java|csharp)\s+\"((?:[^\"\\\\]|\\\\.)*)\"" src)
          [_ id] (re-seq #"([A-Za-z_][A-Za-z0-9_]*)\s*\(" tmpl)
          :when (not (host-library id))]
      [(keyword target) id tmpl])))

(println "\nkin/check-names: every name, against the runtime that defines it\n")

(doseq [[nm per-target] (sort-by key rt/names)
        :when (map? per-target)
        [target spelling] per-target
        :when (contains? trees target)]
  (check "name" nm target spelling))

(println (format "  %d names over %d targets" (count rt/names) (count trees)))

(doseq [[target id tmpl] (distinct templates)
        :when (contains? trees target)]
  (when-not (str/includes? (get text target) id)
    (swap! failures inc)
    (println (format "  FAIL a template emits `%s` for %s, and no file under %s defines it\n         template: %s"
                     id (name target) (str/join ", " (get trees target)) tmpl))))

(println (format "  %d call templates over the same targets" (count (distinct templates))))
(if (zero? @failures)
  (do (println "\ncheck-names: every name is defined by the runtime that has to have it\n")
      (System/exit 0))
  (do (println (format "\ncheck-names: %d FAILURE(S)\n" @failures))
      (System/exit 1)))
