#!/usr/bin/env bb
;; Write kin's output INTO the runtimes, between markers.
;;
;;     kin/scripts/emit kin/hash.kin      one source
;;     kin/emit                   every source
;;
;; The generated code is CHECKED IN. A runtime build must not need babashka --
;; somebody cloning this repo to build the JVM runtime should not have to
;; install a Clojure to do it, and a generator in the build path is a
;; generator that breaks the build. So the tool is run by hand, its output is
;; committed, and the markers make the next run a diff rather than a merge.
;;
;;     // kin:begin <source>       <- everything between these two lines
;;     ...generated...                   is replaced wholesale
;;     // kin:end <source>
;;
;; The scanning is kin's now, not this script's: `emit-all!` walks the source
;; vfs and emits every source ATOMICALLY -- all sixteen and all three targets,
;; or nothing. A partial tree is a state nobody designed and no gate
;; describes: with eight of sixteen emitted, check-kin reports the other eight
;; as drifted, which is true and says nothing about what happened.
;;
;; The I/O is still ours -- every byte goes through the vfs on each target in
;; `flint.impl.targets`.
(require '[kin.project :as kp]
         '[flint.impl.project :as fp]
         '[flint.impl.targets :as targets])

(defn show [label results]
  (println label)
  (doseq [{:keys [target] p :path} results]
    (println (format "  %-8s %s" (name target)
                     (if p
                       (targets/resolve-path target p)
                       "(no destination -- generated and not written)")))))

(let [[path] *command-line-args*]
  (if path
    (show path (kp/emit! @fp/project (kp/source-text @fp/project path) path))
    ;; ATOMIC over the whole batch: every source, every target, or nothing.
    ;; A failure throws rather than being reported per source, because there
    ;; is no partial result to report -- the tree is exactly as it was.
    (let [{:keys [order emitted]} (kp/emit-all! @fp/project)]
      (doseq [label order] (show label (get emitted label))))))
