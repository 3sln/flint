;; THE TAG LAYOUT: how a flint value carries what it is.
;;
;; A value is 64 bits -- a 16-bit TAG over a 48-bit PAYLOAD -- and this is the
;; layer every other one stands on. It was written three times, and the three
;; copies were not the same: until 2026-09-22 native's `heap` ORed the address
;; in whole where both ports masked it into the payload field, so an address
;; at or above 2^48 would have corrupted the TAG on one runtime and been
;; truncated on the other two. Unreachable -- the heap is a wasm linear memory
;; bounded at 2^32 -- and invisible to every instrument here: the two PORTS
;; agree, so a port-versus-port diff sees nothing; no conformance program can
;; reach that address; and the constants are identical, so a constants gate
;; passes over it too. The difference was in the EXPRESSION.
;;
;; THAT IS THE ARGUMENT FOR GENERATING IT rather than fixing it. The mask was
;; put back by hand, and nothing stops it going again; one source cannot
;; disagree with itself.
;;
;; THE NAMES ARE NEW ON PURPOSE. `fixnum`, `as-fixnum`, `heap`, `as-heap`,
;; `is-fixnum` and `is-heap` are all vocabulary words already -- they emit
;; `Val.fixnum(..)` and its siblings -- and a `^:pub` kin function of any of
;; those names would shadow the word for every source that calls it. The
;; generated bodies take different names and each runtime's `Val` keeps the
;; name its callers use, which is the same shape `make-integer` sits under
;; `Num.integer` in `kin/numint.kin`.
;;
;; `^:inline` ON ALL SIX, which is not decoration here. Each is a single
;; expression on the hottest path the runtime has -- `fixnum` and `heap` run
;; for essentially every value it creates -- and the hand-written originals
;; all carried `#[inline(always)]`. Generated code does not get the marker by
;; default (`vecwrite`, `eq` and `mapread` have none); `kin/hash.kin` asks for
;; it the same way.
;;
;; `bits` AND `of-bits` ARE THE NEWTYPE SEAM. Native wraps a value in
;; `Value(..)` where the ports pass a bare `long`; those two words are the
;; whole of that difference, and they are why this source can speak in bits
;; and still answer a `Value` on all three.
(ns flint.rt.valtag
  (:require [flint.impl.rt :refer [defn return doc let if
                                   and >= <= == != < not shl ushr64 sar64 bit-and bit-or
                                   bits of-bits to-addr to-i32 f64-bits f64-of-bits
                                   Value I64 I32 Addr Bool F64
                                   TAG_HEAP TAG_FIXNUM TAG_STR TAG_KW
                                   TAG_MIN_BOXED PAYLOAD NIL TRUE FALSE
                                   FIXNUM_MIN FIXNUM_MAX CANONICAL_NAN]]))

(doc "The 16-bit tag `v` carries -- what kind of value it is."
     ""
     "AN UNSIGNED SHIFT, because the tag lives in the top bits and an"
     "arithmetic shift would smear the sign of a heap value across it.")
(defn ^:pub ^:inline ^I64 tag-of [^Value v]
  (return (ushr64 (bits v) 48)))

(doc "Whether `n` fits a fixnum's 48 signed bits."
     ""
     "PAST THIS A VALUE IS A BOXED BIGINT, which still answers `is-int` --"
     "which is why the specialised integer opcodes have to test rather than"
     "assume.")
(defn ^:pub ^:inline ^Bool fits-fixnum [^I64 n]
  (return (and (>= n FIXNUM_MIN) (<= n FIXNUM_MAX))))

(doc "`n` as a fixnum value."
     ""
     "MASKED, not merely shifted in: a negative `n` is all ones above bit 47,"
     "and without the mask those bits land in the TAG and the answer reads"
     "back as a value of some other kind.")
(defn ^:pub ^:inline ^Value make-fixnum [^I64 n]
  ;; `to-addr` IS THE CAST NATIVE ALREADY WRITES: `(n as u64) & PAYLOAD`.
  ;; `n` is signed and `PAYLOAD` is not, and Rust will not mix the two -- on
  ;; both ports it is a `long` either way and the word emits nothing.
  (return (of-bits (bit-or (shl TAG_FIXNUM 48) (bit-and (to-addr n) PAYLOAD)))))

(doc "The integer a fixnum carries, sign-extended from 48 bits."
     ""
     "SHIFT UP THEN ARITHMETIC DOWN. The payload is signed and 48 bits wide,"
     "so the sign has to be propagated from bit 47; masking alone would"
     "answer a large positive for every negative fixnum.")
(defn ^:pub ^:inline ^I64 fixnum-payload [^Value v]
  (return (sar64 (shl (bits v) 16) 16)))

(doc "A heap address as a value."
     ""
     "MASK, do not merely cast -- the comment both ports carried and native"
     "did not, which is exactly where the three copies came apart.")
(defn ^:pub ^:inline ^Value make-heap [^Addr off]
  (return (of-bits (bit-or (shl TAG_HEAP 48) (bit-and off PAYLOAD)))))

(doc "The address a heap value points at."
     ""
     "MASK, do not merely cast: with a 48-bit address the tag would otherwise"
     "come back as part of the answer.")
(defn ^:pub ^:inline ^Addr heap-payload [^Value v]
  (return (bit-and (bits v) PAYLOAD)))

(doc "TAG COMPARISONS CAST. `tag-of` answers `I64` and the tag constants are"
     "`u64` on native, which Rust will not compare across -- `Val.tag`'s own"
     "shim casts for exactly this reason. `to-addr` emits the cast there and"
     "nothing on either port."
     ""
     "Whether `v` is an INLINE string -- five bytes or fewer carried in the"
     "value itself rather than on the heap."
     ""
     "FIVE, because the payload is 48 bits: eight for the length and forty for"
     "the bytes. That covers most keywords, which is what makes a map keyed by"
     "keywords cheap -- the comparison is one 64-bit compare and allocates"
     "nothing.")
(defn ^:pub ^:inline ^Bool inline-string [^Value v]
  (return (== (to-addr (tag-of v)) TAG_STR)))

(doc "Whether `v` is an inline keyword.")
(defn ^:pub ^:inline ^Bool inline-keyword [^Value v]
  (return (== (to-addr (tag-of v)) TAG_KW)))

(doc "How many bytes an inline value carries: the length field, bits 40-47.")
(defn ^:pub ^:inline ^I32 inline-length [^Value v]
  (return (to-i32 (bit-and (ushr64 (bits v) 40) 255))))

(doc "An inline KEYWORD as the inline STRING of its name."
     ""
     "A TAG SWAP, NOT A REBUILD. Going through the bytes --"
     "`inline-str(inline-bytes(v))` -- allocates an array to copy at most five"
     "bytes onto themselves, and all three runtimes carried a comment saying"
     "while ALL THREE wrote the mask out by hand: `Val.java`, `Val.cs` and"
     "`value.rs` each spelled `0x0000_FFFF_FFFF_FFFF` here, every one of them"
     "with `PAYLOAD` declared in the same file.")
;; NAMED `kw-as-str`, NOT `kw-to-str`, and I got this wrong first: `kw-to-str`
;; is already a vocabulary word and `kin/names.kin` calls it, with its drivers
;; stubbing it three times. A `^:pub` function of that name shadows the word
;; project-wide, so `names` silently started resolving to this module --
;; `check-kin` caught it as drift in a file I had not touched, which is the
;; only reason it did not ship. Third time today this trap came up; the first
;; two were checked for, this one was not.
(defn ^:pub ^:inline ^Value kw-as-str [^Value v]
  (return (of-bits (bit-or (bit-and (bits v) PAYLOAD) (shl TAG_STR 48)))))

(doc "Whether `v` is a double."
     ""
     "EVERY TAG BELOW THE BOXED RANGE IS A DOUBLE, which is the whole trick of"
     "this representation: a float needs no tag of its own, it is simply any"
     "bit pattern that is not one of ours. `TAG_MIN_BOXED` is where ours"
     "begin.")
(defn ^:pub ^:inline ^Bool double-tagged [^Value v]
  (return (< (to-addr (tag-of v)) TAG_MIN_BOXED)))

(doc "Whether `v` carries the fixnum tag.")
(defn ^:pub ^:inline ^Bool fixnum-tagged [^Value v]
  (return (== (to-addr (tag-of v)) TAG_FIXNUM)))

(doc "Whether `v` carries the heap tag.")
(defn ^:pub ^:inline ^Bool heap-tagged [^Value v]
  (return (== (to-addr (tag-of v)) TAG_HEAP)))

(doc "Whether `v` is nil.")
(defn ^:pub ^:inline ^Bool is-nil [^Value v]
  (return (== (bits v) (bits NIL))))

(doc "Whether `v` is the boolean true.")
(defn ^:pub ^:inline ^Bool is-true [^Value v]
  (return (== (bits v) (bits TRUE))))

(doc "Whether `v` is the boolean false.")
(defn ^:pub ^:inline ^Bool is-false [^Value v]
  (return (== (bits v) (bits FALSE))))

(doc "Whether `v` counts as true in a conditional."
     ""
     "NIL AND FALSE ARE THE ONLY FALSE THINGS, as in Clojure: 0 is true, the"
     "empty string is true, an empty collection is true. Anything else would"
     "be a different language.")
(defn ^:pub ^:inline ^Bool truthy [^Value v]
  (return (and (!= (bits v) (bits NIL)) (!= (bits v) (bits FALSE)))))

(doc "`d` as a value."
     ""
     "A DOUBLE NEEDS NO TAG: any bit pattern that is not one of ours IS one,"
     "which is what makes this representation cheap. The exception is a NaN"
     "whose top bits land in the tag range -- only negative NaNs with a large"
     "payload can -- and such a value would read back as a heap pointer or a"
     "keyword. It is replaced by the canonical NaN, losing a payload nobody"
     "carries, rather than answering a value of the wrong kind."
     ""
     "ALL THREE DERIVED THAT REPLACEMENT FROM THEIR OWN HOST until 2026-09-22,"
     "and .NET's `double.NaN` is the NEGATIVE canonical NaN where java's and"
     "rust's is positive -- so the clr answered different BITS from the other"
     "two for every double reaching this arm. Both are NaN, so `=` never"
     "noticed; hashing, snapshots and the wire codec would.")
(defn ^:pub ^:inline ^Value make-double [^F64 d]
  (let [^I64 b (f64-bits d)]
    (if (>= (to-addr (ushr64 b 48)) TAG_MIN_BOXED)
      (return (of-bits CANONICAL_NAN)))
    ;; `to-addr` because `f64-bits` answers `I64` and the newtype wraps a
    ;; `u64` on native; the ports are a `long` either way and it emits
    ;; nothing there.
    (return (of-bits (to-addr b)))))

(doc "The double `v` carries."
     ""
     "A REINTERPRETATION, not a conversion: the same 64 bits read as a float."
     "`to-f64` is the other operation and would turn the integer 1 into 1.0"
     "rather than into 5e-324.")
(defn ^:pub ^:inline ^F64 double-value [^Value v]
  (return (f64-of-bits (bits v))))
