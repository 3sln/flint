;; `node_assoc`: the CHAMP insert, one level of the trie at a time.
;;
;; Phase 3 of `doc/goals/kin-port.md`, and the first slice that calls mostly
;; GENERATED code: `merge_two` came from `merge.kin` and four of the five
;; copy helpers from `copies.kin`, so every branch below but one lands in a
;; function kin already emits. That is the point at which porting starts
;; paying back rather than merely accumulating.
;;
;; Three cases, which is the whole of CHAMP's insert:
;;
;;   the bit is in the DATAMAP  -- an entry already sits in this slot. Same
;;                                 key, so replace the value (or return the
;;                                 node untouched when the value is `==` too);
;;                                 different key, so `merge_two` builds a sub
;;                                 -node and the entry is INLINED down into it
;;   the bit is in the NODEMAP  -- a sub-node sits here already, so recurse
;;                                 and copy only if the sub-node changed
;;   the bit is in NEITHER      -- an empty slot, so insert the entry
;;
;; `champ_added` is how the caller learns whether the count moved. It is a
;; field on the runtime rather than a returned pair because the return value
;; is already the new node, and the two ports cannot return two values without
;; allocating something to hold them.
(ns runtime.nodeassoc
  (:require [flint.impl.rt :refer [defn return if let local set do comment
                                   mark push r pop-to not == .
                                   is-bmnode coll-assoc bitpos index-of
                                   bn-datamap bn-nodemap bn-key bn-val bn-node
                                   val-eq hash-value merge-two
                                   bn-copy-set-value bn-copy-set-node
                                   bn-copy-insert-entry bn-inline-to-node
                                   + != bit-and
                                   Rt Value RootIx I32]]))

(defn ^:method ^Value node-assoc
  [^:mut ^Rt rt ^Value n ^I32 shift ^I32 h ^Value key ^Value val ^Value edit]
  (let [^RootIx base (mark rt)
        ^RootIx ni (push rt n)
        ^RootIx ki (push rt key)
        ^RootIx vi (push rt val)
        ^RootIx ei (push rt edit)]
    (comment "A collision node has no bitmaps to consult, so it is not this"
             "function's shape at all -- hand it straight over.")
    (comment "The result here is named `handed` and not `out`: C# forbids a"
             "local in an inner scope that reuses an enclosing scope's name,"
             "and `out` is declared at method scope just below.")
    (if (not (is-bmnode rt n))
      (let [^Value handed (coll-assoc rt (r rt ni) h (r rt ki) (r rt vi)
                                      (r rt ei) shift)]
        (pop-to rt base)
        (return handed)))
    (let [^I32 bit (bitpos h shift)
          ^I32 dm (bn-datamap rt n)
          ^I32 nm (bn-nodemap rt n)]
      (local ^Value out)
      (if (!= (bit-and dm bit) 0)
        (let [^I32 at (index-of dm bit)
              ^RootIx k0i (push rt (bn-key rt (r rt ni) at))]
          (if (val-eq rt (r rt k0i) (r rt ki))
            (do
              (comment "The key was already here, so the map's count does not"
                       "move however the value changes.")
              (set (. rt champ-added) false)
              (let [^Value v0 (bn-val rt (r rt ni) at)]
                (if (== v0 (r rt vi))
                  (set out (r rt ni))
                  (set out (bn-copy-set-value rt (r rt ni) at (r rt vi)
                                              (r rt ei))))))
            (do
              (comment "A different key in the same slot: the two are pushed"
                       "down into a sub-node, and the entry stops being an"
                       "entry at this level.")
              (set (. rt champ-added) true)
              (let [^RootIx v0i (push rt (bn-val rt (r rt ni) at))
                    ^I32 h0 (hash-value rt (r rt k0i))
                    ^Value sub (merge-two rt (+ shift HASH_BITS)
                                          (r rt k0i) (r rt v0i) h0
                                          (r rt ki) (r rt vi) h (r rt ei))
                    ^RootIx si (push rt sub)]
                (set out (bn-inline-to-node rt (r rt ni) bit (r rt si)
                                            (r rt ei)))))))
        (if (!= (bit-and nm bit) 0)
          (let [^I32 at (index-of nm bit)]
            (comment "Rooted, because the comparison below is what decides"
                     "whether this node changed. `node_assoc` allocates, a"
                     "collection can move `sub`, and a stale address that"
                     "happened to match the new one would drop the whole"
                     "subtree's update on the floor -- a key silently missing"
                     "from a map whose count says it is there.")
            (let [^RootIx subi (push rt (bn-node rt (r rt ni) at))
                  ^Value newsub (node-assoc rt (r rt subi) (+ shift HASH_BITS)
                                            h (r rt ki) (r rt vi) (r rt ei))]
              (if (== newsub (r rt subi))
                (set out (r rt ni))
                (set out (bn-copy-set-node rt (r rt ni) at newsub
                                           (r rt ei))))))
          (do
            (comment "An empty slot, which is the only branch that always"
                     "grows the map.")
            (set (. rt champ-added) true)
            (set out (bn-copy-insert-entry rt (r rt ni) bit (r rt ki)
                                           (r rt vi) (r rt ei))))))
      (pop-to rt base)
      (return out))))
