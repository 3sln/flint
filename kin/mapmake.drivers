--csharp-head
    internal const long NIL = 0xFFFFL;
    internal const int AM_META = 0, AM_HASH = 1, AM_BASE = 2;
    internal static class Obj { internal const int TyArraymap = 10, TyVolatile = 11; }
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal static bool IsNil(long v) { return v == NIL; }
        internal static long Heap(long a) { return a; }
    }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal long[] h = new long[4000];
        internal string thrown = "";
        internal int seqn = 4;
        internal bool refuse = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Alloc(int t, int n) {
            if (refuse) return 0;
            long a = bump; bump += n + 4;
            gc.sp.m[(int) a] = (byte) t;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot_(long v, int i) { return h[(int) v + i]; }
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return NIL; }
    }
    internal static long Seq(Rt rt, long c) { return rt.seqn == 0 ? NIL : 0xC000L + rt.seqn; }
    internal static long First(Rt rt, long s) { return 0xE000L + (s - 0xC000L); }
    internal static long Next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    internal static string HEX(long v) { return v.ToString("x"); }
--csharp
    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();

        rt.seqn = 4;
        long m = OrderedMap(rt, NIL);
        o.Append("m=").Append(HEX(m)).Append(' ');
        o.Append("slots=").Append(HEX(rt.Slot_(m, AM_BASE))).Append(",")
         .Append(HEX(rt.Slot_(m, AM_BASE + 1))).Append(",")
         .Append(HEX(rt.Slot_(m, AM_BASE + 2))).Append(",")
         .Append(HEX(rt.Slot_(m, AM_BASE + 3))).Append(' ');
        o.Append("meta=").Append(Val.IsNil(rt.Slot_(m, AM_META)) ? 1 : 0)
         .Append(" hash=").Append(Val.IsNil(rt.Slot_(m, AM_HASH)) ? 1 : 0).Append(' ');

        rt.seqn = 0;
        long e = OrderedMap(rt, NIL);
        o.Append("empty=").Append(e != NIL ? 1 : 0).Append(' ');

        rt.seqn = 3;
        rt.thrown = "";
        long odd = OrderedMap(rt, NIL);
        o.Append("odd=").Append(Val.IsNil(odd) ? 1 : 0).Append("|").Append(rt.thrown)
         .Append("| roots=").Append(rt.roots.Count).Append(' ');

        rt.seqn = 4;
        rt.refuse = true;
        rt.thrown = "";
        long no = OrderedMap(rt, NIL);
        o.Append("norm=").Append(Val.IsNil(no) ? 1 : 0)
         .Append(" roots=").Append(rt.roots.Count).Append(' ');

        long vv = NewVolatile(rt, 0x77L);
        o.Append("volno=").Append(Val.IsNil(vv) ? 1 : 0).Append(' ');
        rt.refuse = false;
        long v = NewVolatile(rt, 0x77L);
        o.Append("vol=").Append(HEX(rt.Slot_(v, 0)))
         .Append(" roots=").Append(rt.roots.Count);
        System.Console.WriteLine(o.ToString());
    }
