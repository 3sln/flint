        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long x = leaf(rt, new int[]{1,2,3,4,5,6});
        long y = node(rt, new long[]{leaf(rt, new int[]{1}), leaf(rt, new int[]{2,3}),
                                     leaf(rt, new int[]{4,5,6})});
        long z = node(rt, new long[]{leaf(rt, new int[]{1,2,3}), leaf(rt, new int[]{4,5,6})});
        o.append("shapes=").append(bEq(rt, x, y) ? 1 : 0).append(bEq(rt, y, z) ? 1 : 0)
         .append(bEq(rt, z, x) ? 1 : 0).append(' ');
        o.append("same=").append(bEq(rt, y, y) ? 1 : 0).append(' ');
        long d = node(rt, new long[]{leaf(rt, new int[]{9}), leaf(rt, new int[]{2,3}),
                                     leaf(rt, new int[]{4,5,6})});
        o.append("first=").append(bEq(rt, x, d) ? 1 : 0).append(' ');
        long e = node(rt, new long[]{leaf(rt, new int[]{1,2,3}), leaf(rt, new int[]{4,5,9})});
        o.append("last=").append(bEq(rt, x, e) ? 1 : 0).append(' ');
        o.append("len=").append(bEq(rt, x, leaf(rt, new int[]{1,2,3})) ? 1 : 0).append(' ');
        long shared = leaf(rt, new int[]{4,5,6});
        long p = node(rt, new long[]{leaf(rt, new int[]{1,2,3}), shared});
        long q = node(rt, new long[]{leaf(rt, new int[]{1,2,3}), shared});
        o.append("shared=").append(bEq(rt, p, q) ? 1 : 0).append(' ');
        long e1 = leaf(rt, new int[0]);
        o.append("empty=").append(bEq(rt, e1, leaf(rt, new int[0])) ? 1 : 0).append(' ');
        long e2 = node(rt, new long[]{leaf(rt, new int[0]), leaf(rt, new int[0])});
        o.append("emptytree=").append(bEq(rt, e1, e2) ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
