--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const CAT_SCALAR: u8 = 0;
impl Value { fn is_heap(self) -> bool { self.0 >= 100 } }
struct Rt { cats: Vec<u8> }
impl Rt {
    fn category(&self, v: Value) -> u8 { if v.is_heap() { self.cats[v.0 as usize - 100] } else { CAT_SCALAR } }
}
impl Rt {
--rust
}
fn main() {
    // 0..99 are immediates; 100.. are heap values whose category is looked up.
    let rt = Rt { cats: vec![0, 1, 2, 3] };
    let mut o = String::new();
    for v in [Value(5), Value(100), Value(101), Value(102), Value(103)] {
        o.push_str(&format!("{},", rt.eq_may_alloc(v) as u32));
    }
    println!("{}", o);
}
