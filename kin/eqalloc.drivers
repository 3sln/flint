    static final int CAT_SCALAR = 0;
    static final class Val { static boolean isHeap(long v) { return v >= 100; } }
    static final class Rt { int[] cats = {0, 1, 2, 3}; }
    static int category(Rt rt, long v) { return Val.isHeap(v) ? rt.cats[(int) v - 100] : CAT_SCALAR; }
