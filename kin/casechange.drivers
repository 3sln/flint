    static final long NIL = 0xFFFF;
    static final class Val { static final long NIL = 0xFFFF; }
    static final int[] CASE_FULL = new int[515];
    static final int CASE_FULL_UPPER_LEN = 102;
    static final class Rt {
        java.util.ArrayList<java.util.ArrayList<Integer>> cps = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Integer>> sinks = new java.util.ArrayList<>();
        int[] subject; int[] up, lo; long steps = 0;
        int cpsOpen() { cps.add(new java.util.ArrayList<>()); return cps.size() - 1; }
        int cpsLen(int c) { return cps.get(c).size(); }
        int cpsAt(int c, int i) { return cps.get(c).get(i); }
        void cpsClose(int c) { while (cps.size() > c) cps.remove(cps.size() - 1); }
        int sinkOpen() { sinks.add(new java.util.ArrayList<>()); return sinks.size() - 1; }
        void sinkPut(int s, int b) { sinks.get(s).add(b); }
        void sinkClose(int s) { while (sinks.size() > s) sinks.remove(sinks.size() - 1); }
        long sinkString(int s) { long h = 0; for (int b : sinks.get(s)) h = h * 31 + b; return h; }
        boolean chargeChecked(long n, String w) { steps += n; return true; }
        long throwStr(String k, String m) { return NIL; }
        int caseN(boolean u) { return (u ? up.length : lo.length) / 4; }
        int caseAt(boolean u, int i, int f) { return (u ? up : lo)[i * 4 + f]; }
    }
    static int codePoints(Rt rt, long s) {
        int c = rt.cpsOpen();
        for (int v : rt.subject) rt.cps.get(c).add(v);
        return c;
    }
    static boolean isString(Rt rt, long v) { return true; }
    static int fullIndex(Rt rt, int cp, boolean up) { return -1; }
    static int caseMap(Rt rt, int cp, boolean up) {
        int lo2 = 0, hi = rt.caseN(up) - 1;
        while (lo2 <= hi) {
            int mid = lo2 + (hi - lo2) / 2, s = rt.caseAt(up, mid, 0), e = rt.caseAt(up, mid, 1);
            if (cp < s) hi = mid - 1;
            else if (cp > e) lo2 = mid + 1;
            else if (rt.caseAt(up, mid, 3) == 1) return cp + rt.caseAt(up, mid, 2);
            else if (((cp - s) & 1) == 0) return cp + rt.caseAt(up, mid, 2);
            else return cp;
        }
        return cp;
    }
