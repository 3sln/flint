--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
struct Rt { cps: Vec<Vec<u32>>, sinks: Vec<Vec<u32>>, subject: Vec<u32>,
            up: Vec<i32>, lo: Vec<i32>, steps: u64 }
// SIZE FIXED BY THE REAL TABLE: `case-full-n` inlines as a literal, so the
// generated code carries the real length and a shorter array would be indexed
// past. Zeros -- what this probe checks is that three targets generated the
// same walk, not that the mapping is right; that is the language suite's job.
static CASE_FULL: [i32; 515] = [0; 515];
const CASE_FULL_UPPER_LEN: u32 = 102;
impl Rt {
    fn cps_open(&mut self) -> u32 { self.cps.push(Vec::new()); (self.cps.len() - 1) as u32 }
    fn cps_len(&self, c: u32) -> u32 { self.cps[c as usize].len() as u32 }
    fn cps_at(&self, c: u32, i: u32) -> u32 { self.cps[c as usize][i as usize] }
    fn cps_close(&mut self, c: u32) { self.cps.truncate(c as usize); }
    fn code_points(&mut self, _s: Value) -> u32 {
        let c = self.cps_open();
        let subj = self.subject.clone();
        for v in subj { self.cps[c as usize].push(v); }
        c
    }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_put(&mut self, s: u32, b: u32) { self.sinks[s as usize].push(b); }
    fn sink_close(&mut self, s: u32) { self.sinks.truncate(s as usize); }
    fn sink_string(&mut self, s: u32) -> Value {
        // The BYTES the walk produced, folded to one number so three targets
        // can be compared without a string implementation in the probe.
        let mut h: u64 = 0;
        for b in &self.sinks[s as usize] { h = h * 31 + (*b as u64); }
        Value(h)
    }
    fn is_string(&self, _v: Value) -> bool { true }
    fn charge_checked(&mut self, n: u64, _w: &str) -> bool { self.steps += n; true }
    fn throw_str(&mut self, _k: &str, _m: &str) -> Value { NIL }
    fn case_n(&self, u: bool) -> i32 { (if u { self.up.len() } else { self.lo.len() }) as i32 / 4 }
    fn case_at(&self, u: bool, i: i32, f: i32) -> i32 {
        let t = if u { &self.up } else { &self.lo };
        t[(i * 4 + f) as usize]
    }
    fn full_index(&self, _cp: u32, _up: bool) -> i32 { -1 }
    fn case_map(&self, cp: u32, up: bool) -> u32 {
        let c = cp as i32;
        let n = self.case_n(up);
        let mut lo = 0; let mut hi = n - 1;
        while lo <= hi {
            let mid = lo + (hi - lo) / 2;
            let s = self.case_at(up, mid, 0); let e = self.case_at(up, mid, 1);
            if c < s { hi = mid - 1; } else if c > e { lo = mid + 1; }
            else if self.case_at(up, mid, 3) == 1 { return (c + self.case_at(up, mid, 2)) as u32; }
            else if (c - s) & 1 == 0 { return (c + self.case_at(up, mid, 2)) as u32; }
            else { return cp; }
        }
        cp
    }
--rust
}
fn main() {
    // "aß" upcased: 'a' by delta, sharp s by a FULL mapping to two code points.
    let mut rt = Rt { cps: Vec::new(), sinks: Vec::new(),
                      subject: vec![97, 223, 233],
                      up: vec![97, 122, -32, 1, 224, 246, -32, 1],
                      lo: vec![65, 90, 32, 1],
                      steps: 0 };
    let a = rt.change_case(Value(1), true);
    let b = rt.change_case(Value(1), false);
    println!("{} {} {}", a.0, b.0, rt.steps);
}
