        internal int CpsLen(int c) { return cps[c].Count; }
        internal int CpsAt(int c, int i) { return cps[c][i]; }
        internal void CpsClose(int c) { while (cps.Count > c) cps.RemoveAt(cps.Count - 1); }
        internal int SinkOpen() { sinks.Add(new System.Collections.Generic.List<int>()); return sinks.Count - 1; }
        internal void SinkPut(int s, int b) { sinks[s].Add(b); }
        internal void SinkClose(int s) { while (sinks.Count > s) sinks.RemoveAt(sinks.Count - 1); }
        internal long SinkString(int s) { long h = 0; foreach (int b in sinks[s]) h = h * 31 + b; return h; }
        internal bool ChargeChecked(long n, string w) { steps += n; return true; }
        internal long ThrowStr(string k, string m) { return NIL; }
        internal int CaseN(bool u) { return (u ? up.Length : lo.Length) / 4; }
        internal int CaseAt(bool u, int i, int f) { return (u ? up : lo)[i * 4 + f]; }
    }
    static int CodePoints(Rt rt, long s) {
        int c = rt.CpsOpen();
        foreach (int v in rt.subject) rt.cps[c].Add(v);
        return c;
    }
