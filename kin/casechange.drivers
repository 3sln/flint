        while (lo2 <= hi) {
            int mid = lo2 + (hi - lo2) / 2, s = rt.CaseAt(up, mid, 0), e = rt.CaseAt(up, mid, 1);
            if (cp < s) hi = mid - 1;
            else if (cp > e) lo2 = mid + 1;
            else if (rt.CaseAt(up, mid, 3) == 1) return cp + rt.CaseAt(up, mid, 2);
            else if (((cp - s) & 1) == 0) return cp + rt.CaseAt(up, mid, 2);
            else return cp;
        }
        return cp;
    }
