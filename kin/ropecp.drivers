--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        o.Append("width=").Append(Utf8Width(rt, 0x61)).Append(Utf8Width(rt, 0xC3))
         .Append(Utf8Width(rt, 0xE2)).Append(Utf8Width(rt, 0xF0)).Append(' ');
        long l1 = Flat(rt, new int[]{0x61, 0xC3, 0xA9});
        long l2 = Flat(rt, new int[]{0xE2, 0x82, 0xAC});
        long l3 = InlineOf(new int[]{0x62, 0x63});
        long t = Node(rt, new long[]{l1, l2, l3});
        o.Append("cps=").Append(rt.SCount(t)).Append(" ascii=").Append(rt.SAscii(t) ? 1 : 0)
         .Append(" bytes=").Append(Str.SBytes(rt, t)).Append(' ');
        var offs = new System.Text.StringBuilder();
        for (int k = 0; k < 6; k++) { if (k > 0) offs.Append('.'); offs.Append(RopeByteOfCp(rt, t, k)); }
        o.Append("offs=").Append(offs).Append(' ');
        long at = Node(rt, new long[]{Flat(rt, new int[]{0x78, 0x79}), InlineOf(new int[]{0x7A})});
        var ao = new System.Text.StringBuilder();
        for (int k = 0; k < 4; k++) { if (k > 0) ao.Append('.'); ao.Append(RopeByteOfCp(rt, at, k)); }
        o.Append("asciioffs=").Append(ao).Append(' ');
        var got = new System.Text.StringBuilder();
        for (int k = 0; k < 5; k++) {
            if (k > 0) got.Append(',');
            int b = RopeByteOfCp(rt, t, k);
            int s = rt.SinkOpen();
            int w = RopeBytesAt(rt, t, b, s);
            byte[] bs = rt.sinks[s].ToArray();
            got.Append(w).Append(':');
            foreach (byte x in bs) got.Append(x.ToString("x2"));
            rt.SinkClose(s);
        }
        o.Append("at=").Append(got).Append(' ');
        int s2 = rt.SinkOpen();
        int past = RopeBytesAt(rt, t, 99, s2);
        rt.SinkClose(s2);
        o.Append("past=").Append(past).Append(" steps=").Append(rt.steps);
        System.Console.WriteLine(o.ToString());
    }
