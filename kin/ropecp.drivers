--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_STR: u8 = 2; const TY_ROPE: u8 = 26; const TY_VEC: u8 = 9;
pub mod obj {
    pub const HDR: u64 = 8; pub const STR_DATA: u64 = 16;
    pub const RP_BYTES: u32 = 0; pub const RP_CPS: u32 = 1;
    pub const RP_FLAT: u32 = 2; pub const RP_HASH: u32 = 3; pub const RP_KIDS: u32 = 4;
}
impl Value {
    // AN INLINE STRING is tagged and carries its own bytes -- here, one byte of
    // length and up to three of payload, which is enough to be a leaf.
    fn is_inline_str(self) -> bool { (self.0 >> 60) == 0xE }
    fn inline_len(self) -> u32 { ((self.0 >> 56) & 0xF) as u32 }
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && (self.0 >> 60) != 0xE }
    fn as_heap(self) -> Addr { self.0 as Addr }
    // THE PROBE TAGS ITS FIXNUMS so that a heap address is not mistaken for
    // one -- `rope_hash` asks `is_fixnum` of a slot that may hold either.
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Space { m: Vec<u8> }
impl Space {
    fn read_u8(&self, a: Addr) -> u8 { self.m[a as usize] }
}
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64,
            roots: Vec<Value>, sinks: Vec<Vec<u8>>, steps: u64 }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 32;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn leaf_len(&self, v: Value) -> u32 {
        if v.is_inline_str() { v.inline_len() } else if v.is_heap() { self.olen(v) } else { 0 }
    }
    fn leaf_byte(&self, v: Value, i: u32) -> u32 {
        if v.is_inline_str() { ((v.0 >> (8 * i)) & 0xFF) as u32 }
        else if v.is_heap() { self.gc.sp.read_u8(v.as_heap() + obj::STR_DATA + i as u64) as u32 }
        else { 0 }
    }
    fn pow31(&self, n: u32) -> u32 {
        let mut p: u32 = 1;
        for _ in 0..n { p = p.wrapping_mul(31); }
        p
    }
    fn s_bytes(&self, v: Value) -> u32 {
        if !self.is_rope(v) { return self.leaf_len(v); }
        let mut n = 0u32;
        for i in 0..self.rope_kids(v) { n += self.s_bytes(self.slot(v, obj::RP_KIDS + i)); }
        n
    }
    fn is_rope(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_ROPE
    }
    fn rope_kids(&self, v: Value) -> u32 { self.olen(v) - obj::RP_KIDS }
    // A FLAT STRING puts its bytes at STR_DATA, not at HDR.
    fn flat(&mut self, bs: &[u8]) -> Value {
        let a = self.alloc(TY_STR, bs.len() as u32);
        for (i, b) in bs.iter().enumerate() { self.gc.sp.m[(a + obj::STR_DATA) as usize + i] = *b; }
        Value::heap(a)
    }
    fn inline_of(&self, bs: &[u8]) -> Value {
        let mut v: u64 = (0xEu64 << 60) | ((bs.len() as u64) << 56);
        for (i, b) in bs.iter().enumerate() { v |= (*b as u64) << (8 * i); }
        Value(v)
    }
    fn node(&mut self, kids: &[Value]) -> Value {
        let a = self.alloc(TY_ROPE, obj::RP_KIDS + kids.len() as u32);
        self.set(Value::heap(a), obj::RP_FLAT, NIL);
        self.set(Value::heap(a), obj::RP_HASH, NIL);
        for (i, k) in kids.iter().enumerate() { self.set(Value::heap(a), obj::RP_KIDS + i as u32, *k); }
        let (mut cps, mut asc) = (0u32, 1u64);
        for k in kids { cps += self.s_count(*k); if !self.s_ascii(*k) { asc = 0; } }
        self.set(Value::heap(a), obj::RP_CPS, Value::fixnum(((cps << 1) as u64 | asc) as i64));
        Value::heap(a)
    }
    // CODE POINTS. A leaf counts its non-continuation bytes; a node keeps the
    // count and the ascii flag packed in `RP_CPS`, exactly as the runtime does.
    fn s_count(&self, v: Value) -> u32 {
        if self.is_rope(v) { return (self.slot(v, obj::RP_CPS).as_fixnum() as u32) >> 1; }
        let n = self.leaf_len(v);
        let mut c = 0u32;
        for i in 0..n { if (self.leaf_byte(v, i) & 0xC0) != 0x80 { c += 1; } }
        c
    }
    fn s_ascii(&self, v: Value) -> bool {
        if self.is_rope(v) { return self.slot(v, obj::RP_CPS).as_fixnum() & 1 != 0; }
        let n = self.leaf_len(v);
        for i in 0..n { if self.leaf_byte(v, i) >= 0x80 { return false; } }
        true
    }
    // The probe COUNTS the charges rather than enforcing a budget: what the
    // fixture checks is that all three charge the same amount for the same
    // walk, which is what `resource-limits` actually asks of them.
    fn charge_work(&mut self, n: u64) { self.steps += n; }
    fn charge_bytes(&mut self, n: u32) { self.charge_work((n as u64 / 8) + 1); }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_close(&mut self, s: u32) { self.sinks.truncate(s as usize); }
    fn sink_put_run(&mut self, s: u32, addr: Addr, len: u32) {
        let run: Vec<u8> = (0..len).map(|i| self.gc.sp.m[(addr + i as u64) as usize]).collect();
        self.sinks[s as usize].extend_from_slice(&run);
    }
    fn sink_put(&mut self, s: u32, b: u32) { self.sinks[s as usize].push(b as u8); }
    fn sink_put_inline(&mut self, s: u32, v: Value) {
        let n = v.inline_len();
        let run: Vec<u8> = (0..n).map(|i| ((v.0 >> (8 * i)) & 0xFF) as u8).collect();
        self.sinks[s as usize].extend_from_slice(&run);
    }
    // The probe answers a FLAT STRING rather than interning one.
    fn sink_contiguous(&mut self, s: u32) -> Value {
        let bs = self.sinks[s as usize].clone();
        self.flat(&bs)
    }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      sinks: Vec::new(), steps: 0 };
    let mut o = String::new();
    // WIDTH, over one byte of each class.
    o.push_str(&format!("width={}{}{}{} ", rt.utf8_width(0x61), rt.utf8_width(0xC3),
                        rt.utf8_width(0xE2), rt.utf8_width(0xF0)));
    // "aé€bc" SPLIT ACROSS TIERS, so the code points do not line up with the
    // leaves and one of the leaves has no address:
    //   a   = 61            cp 0, byte 0
    //   é   = C3 A9         cp 1, byte 1
    //   €   = E2 82 AC      cp 2, byte 3
    //   b c = 62 63         cp 3, 4; byte 6, 7
    let l1 = rt.flat(&[0x61, 0xC3, 0xA9]);
    let l2 = rt.flat(&[0xE2, 0x82, 0xAC]);
    let l3 = rt.inline_of(&[0x62, 0x63]);
    let t = rt.node(&[l1, l2, l3]);
    o.push_str(&format!("cps={} ascii={} bytes={} ",
                        rt.s_count(t), rt.s_ascii(t) as u32, rt.s_bytes(t)));
    let offs: Vec<String> = (0..6).map(|k| rt.rope_byte_of_cp(t, k).to_string()).collect();
    o.push_str(&format!("offs={} ", offs.join(".")));
    // ALL ASCII takes the other branch -- the offset IS the index and no leaf
    // is scanned.
    let a1 = rt.flat(&[0x78, 0x79]);
    let a2 = rt.inline_of(&[0x7A]);
    let at = rt.node(&[a1, a2]);
    let aoffs: Vec<String> = (0..4).map(|k| rt.rope_byte_of_cp(at, k).to_string()).collect();
    o.push_str(&format!("asciioffs={} ", aoffs.join(".")));
    // THE BYTES AT AN OFFSET, for every code point of the mixed tree.
    let mut got = alloc::vec::Vec::new();
    for k in 0..5 {
        let b = rt.rope_byte_of_cp(t, k);
        let s = rt.sink_open();
        let w = rt.rope_bytes_at(t, b, s);
        let hex: Vec<String> = rt.sinks[s as usize].iter().map(|x| format!("{:02x}", x)).collect();
        rt.sink_close(s);
        got.push(format!("{}:{}", w, hex.join("")));
    }
    o.push_str(&format!("at={} ", got.join(",")));
    // PAST THE END on both, and the gas the walk charged.
    let s = rt.sink_open();
    let past = rt.rope_bytes_at(t, 99, s);
    rt.sink_close(s);
    o.push_str(&format!("past={} steps={}", past, rt.steps));
    println!("{}", o);
}
