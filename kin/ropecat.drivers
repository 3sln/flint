         .Append(SBytesOf(rt, small)).Append(' ');
        long acc = Leaf(rt, 6, 6, true);
        for (int k = 0; k < 12; k++) {
            long piece = Leaf(rt, 6, 6, true);
            int bas = rt.Mark();
            rt.Push(acc); rt.Push(piece);
            long outv = SConcat(rt, rt.R(bas), rt.R(bas + 1));
            rt.PopTo(bas);
            acc = outv;
        }
        o.Append("built=").Append(SBytesOf(rt, acc)).Append(',')
         .Append(SCountOf(rt, acc)).Append(',').Append(RopeHeight(rt, acc)).Append(' ');
        long u = Leaf(rt, 9, 4, false);
        long mixed = SConcat(rt, acc, u);
        o.Append("mixed=").Append(SBytesOf(rt, mixed)).Append(',')
         .Append(SCountOf(rt, mixed)).Append(',').Append(SAsciiOf(rt, mixed) ? 1 : 0).Append(' ');
        o.Append("leafdecl=").Append(Val.IsNil(RopeAppend(rt, s3, s3)) ? 1 : 0).Append(' ');
        o.Append("kids=").Append(RopeKids(rt, acc)).Append(' ');
