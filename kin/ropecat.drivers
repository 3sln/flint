    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long e = leaf(rt, 0, 0, true);
        long s3 = leaf(rt, 3, 3, true);
        o.append("t1=").append(sConcat(rt, e, s3) == s3 ? 1 : 0)
         .append(sConcat(rt, s3, e) == s3 ? 1 : 0).append(' ');
        long small = sConcat(rt, s3, s3);
        o.append("t2=").append(isRope(rt, small) ? 1 : 0).append(',')
         .append(Str.sBytes(rt, small)).append(' ');
        long acc = leaf(rt, 6, 6, true);
        for (int k = 0; k < 12; k++) {
            long piece = leaf(rt, 6, 6, true);
            int base = rt.mark();
            rt.push(acc); rt.push(piece);
            long out = sConcat(rt, rt.r(base), rt.r(base + 1));
            rt.popTo(base);
            acc = out;
        }
        o.append("built=").append(Str.sBytes(rt, acc)).append(',')
         .append(Str.sCount(rt, acc)).append(',').append(ropeHeight(rt, acc)).append(' ');
        long u = leaf(rt, 9, 4, false);
        long mixed = sConcat(rt, acc, u);
        o.append("mixed=").append(Str.sBytes(rt, mixed)).append(',')
         .append(Str.sCount(rt, mixed)).append(',').append(Str.sAscii(rt, mixed) ? 1 : 0).append(' ');
        o.append("leafdecl=").append(Val.isNil(ropeAppend(rt, s3, s3)) ? 1 : 0).append(' ');
        o.append("kids=").append(ropeKids(rt, acc)).append(' ');
        System.out.println(o.toString());
    }
