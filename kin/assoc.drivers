    static void probeNodeAssoc(StringBuilder o) {
        Rt rt = new Rt();
        rt.h[1] = 2; rt.h[2] = 4; rt.h[3] = 1000; rt.h[4] = 1001; rt.h[21] = 50;
        rt.h[50] = 0; rt.h[51] = 0;
        rt.h[100] = 0xDEADL;
        long a = nodeAssoc(rt, 100, 0, 0x01, 1, 2, NIL);
        o.append(a).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long b = nodeAssoc(rt, 1, 0, 0x01, 1000, 1001, NIL);
        o.append(b).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long c = nodeAssoc(rt, 1, 0, 0x01, 1000, 9999, NIL);
        o.append(c).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long d = nodeAssoc(rt, 1, 0, 0x01, 7777, 8888, NIL);
        o.append(d).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long e = nodeAssoc(rt, 1, 0, 0x02, 5555, 6666, NIL);
        o.append(e).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long f = nodeAssoc(rt, 1, 0, 0x03, 4444, 3333, NIL);
        o.append(f).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        o.append("log=").append(rt.log).append(" roots=").append(rt.roots.size())
         .append(" bump=").append(rt.bump).append(" | ");
    }
    static void probeCollAssoc(StringBuilder o) {
        Rt rt = new Rt();
        rt.h[1] = 0x55; rt.h[2] = 2;
        rt.h[3] = 100; rt.h[4] = 101;
        rt.h[5] = 200; rt.h[6] = 201;
        long a = collAssoc(rt, 1, 0x99, 300, 301, NIL, 0);
        o.append(a).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long b = collAssoc(rt, 1, 0x55, 200, 999, NIL, 0);
        o.append(b).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long c = collAssoc(rt, 1, 0x55, 100, 888, NIL, 0);
        o.append(c).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        long d = collAssoc(rt, 1, 0x55, 300, 301, NIL, 0);
        o.append(d).append(':').append(rt.champAdded ? 1 : 0).append(' ');
        for (int k = (int) d; k < (int) d + 10; k++) o.append(rt.h[k]).append(',');
        rt.starve = true;
        long e = collAssoc(rt, 1, 0x55, 400, 401, NIL, 0);
        o.append(" oom=").append(e).append(" roots=").append(rt.roots.size())
         .append(" log=").append(rt.log);
    }
    public static void main(String[] args) {
        StringBuilder o = new StringBuilder();
        probeNodeAssoc(o);
        probeCollAssoc(o);
        System.out.println(o);
    }
