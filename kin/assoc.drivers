        rt.starve = true;
        long e = CollAssoc(rt, 1, 0x55, 400, 401, NIL, 0);
        o.Append(" oom=").Append(e).Append(" roots=").Append(rt.roots.Count)
         .Append(" log=").Append(rt.log);
    }
    static void Main() {
        var o = new StringBuilder();
        ProbeNodeAssoc(o);
        ProbeCollAssoc(o);
        Console.WriteLine(o.ToString());
    }
