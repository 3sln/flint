--rust-head
// ONE harness for a PAIR that calls both ways. `nodeassoc.drivers` stubbed
// `coll_assoc` and `collassoc.drivers` stubbed `node_assoc`; merged, neither
// can be stubbed, so the mock has to be good enough for both to run for
// real -- which is the point. The two probes below build their OWN `Rt` each,
// because the two old harnesses laid out incompatible heaps at the same
// addresses (a bitmap node at 1 for one, a collision node at 1 for the other)
// and relocating either would have been a silent edit to a test.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const CN_BASE: u32 = 2;
const HASH_BITS: u32 = 5;
impl Value { fn is_nil(self) -> bool { self.0 == 0xFFFF } }
fn mask(h: u32, shift: u32) -> u32 { (h >> shift) & 0x1f }
fn bitpos(h: u32, shift: u32) -> u32 { 1 << mask(h, shift) }
fn index_of(bm: u32, bit: u32) -> u32 { (bm & (bit - 1)).count_ones() }
struct Rt { h: Vec<u64>, bump: u64, roots: Vec<Value>, log: String,
            champ_added: bool, starve: bool, gas: u64 }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    // Counted rather than ignored: a collision scan must be BILLED for what it
    // walks, and a probe that no-oped this would pass with the hole open.
    fn charge_work(&mut self, n: u64) { self.gas += n; }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn obj(&mut self, tag: &str, n: u64) -> Value {
        let a = self.bump; self.bump += n + 1; self.log.push_str(tag); Value(a)
    }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[(n.0 + i as u64) as usize] = v.0; }
    fn val_eq(&self, a: Value, b: Value) -> bool { a == b }
    fn hash_value(&self, v: Value) -> u32 { ((v.0 * 7) & 0xff) as u32 }
    // A collision node is marked by 0xDEAD in its first slot; everything else
    // is a bitmap node. That is what lets one heap hold both shapes.
    fn is_bmnode(&self, n: Value) -> bool { self.h[n.0 as usize] != 0xDEAD }
    fn bn_datamap(&self, n: Value) -> u32 { self.h[n.0 as usize] as u32 }
    fn bn_nodemap(&self, n: Value) -> u32 { self.h[n.0 as usize + 1] as u32 }
    fn bn_key(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 2 + 2 * at as usize]) }
    fn bn_val(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 3 + 2 * at as usize]) }
    fn bn_node(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 20 + at as usize]) }
    fn bn_set_node(&mut self, n: Value, j: u32, v: Value) { self.set(n, 7 - j, v); }
    fn cn_hash(&self, n: Value) -> u32 { self.h[n.0 as usize] as u32 }
    fn cn_count(&self, n: Value) -> u32 { self.h[n.0 as usize + 1] as u32 }
    fn cn_key(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + 2 + 2 * i as usize]) }
    // A REAL SCAN, not a constant: the callers use the index it returns to
    // decide between replacing an entry and appending one, so a stub that
    // always answered "absent" would leave half of each caller untested.
    fn cn_index_of(&mut self, sni: usize, ski: usize) -> u32 {
        let cnt = self.cn_count(self.r(sni));
        let mut at = cnt;
        for i in 0..cnt {
            self.charge_work(1);
            let k = self.cn_key(self.r(sni), i);
            if self.val_eq(k, self.r(ski)) { at = i; break; }
        }
        at
    }
    fn cn_val(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + 3 + 2 * i as usize]) }
    fn cn_new(&mut self, hh: u32, npairs: u32, _e: Value) -> Value {
        if self.starve { self.log.push_str("x"); return NIL; }
        let a = self.obj("C", (npairs * 2 + 2) as u64);
        self.h[a.0 as usize] = hh as u64;
        self.h[a.0 as usize + 1] = npairs as u64;
        a
    }
    fn cn_copy_set_val(&mut self, _n: Value, _i: u32, _v: Value, _e: Value) -> Value { self.obj("V", 8) }
    fn bn_new(&mut self, _dm: u32, _nm: u32, _e: Value) -> Value { self.obj("B", 8) }
    fn merge_two(&mut self, _s: u32, _k0: Value, _v0: Value, _h0: u32, _k1: Value, _v1: Value, _h1: u32, _e: Value) -> Value { self.obj("M", 8) }
    fn bn_copy_set_value(&mut self, _n: Value, _at: u32, _v: Value, _e: Value) -> Value { self.obj("V", 8) }
    fn bn_copy_set_node(&mut self, _n: Value, _at: u32, _s: Value, _e: Value) -> Value { self.obj("N", 8) }
    fn bn_copy_insert_entry(&mut self, _n: Value, _bit: u32, _k: Value, _v: Value, _e: Value) -> Value { self.obj("E", 8) }
    fn bn_inline_to_node(&mut self, _n: Value, _bit: u32, _s: Value, _e: Value) -> Value { self.obj("I", 8) }
}
impl Rt {
--rust
}
fn fresh() -> Rt {
    Rt { h: vec![0; 400], bump: 200, roots: Vec::new(), log: String::new(),
         champ_added: false, starve: false, gas: 0 }
}
fn probe_node_assoc(o: &mut String) {
    let mut rt = fresh();
    // Node A: one ENTRY in slot 1 (mask(0x01,0)) and one SUB-NODE in slot 2
    // (mask(0x02,0)), so a single node covers three of the six branches.
    rt.h[1] = 2; rt.h[2] = 4; rt.h[3] = 1000; rt.h[4] = 1001; rt.h[21] = 50;
    // Node B: empty, so the recursion below terminates in the insert branch.
    rt.h[50] = 0; rt.h[51] = 0;
    // Node C: a collision node, which is the one shape this function hands
    // over -- and now hands to the REAL `coll_assoc` rather than a stub.
    rt.h[100] = 0xDEAD;
    let a = rt.node_assoc(Value(100), 0, 0x01, Value(1), Value(2), NIL);
    o.push_str(&format!("{}:{} ", a.0, rt.champ_added as u32));
    let b = rt.node_assoc(Value(1), 0, 0x01, Value(1000), Value(1001), NIL);
    o.push_str(&format!("{}:{} ", b.0, rt.champ_added as u32));
    let c = rt.node_assoc(Value(1), 0, 0x01, Value(1000), Value(9999), NIL);
    o.push_str(&format!("{}:{} ", c.0, rt.champ_added as u32));
    let d = rt.node_assoc(Value(1), 0, 0x01, Value(7777), Value(8888), NIL);
    o.push_str(&format!("{}:{} ", d.0, rt.champ_added as u32));
    let e = rt.node_assoc(Value(1), 0, 0x02, Value(5555), Value(6666), NIL);
    o.push_str(&format!("{}:{} ", e.0, rt.champ_added as u32));
    let f = rt.node_assoc(Value(1), 0, 0x03, Value(4444), Value(3333), NIL);
    o.push_str(&format!("{}:{} ", f.0, rt.champ_added as u32));
    o.push_str(&format!("log={} roots={} bump={} | ", rt.log, rt.roots.len(), rt.bump));
}
fn probe_coll_assoc(o: &mut String) {
    let mut rt = fresh();
    // A collision node at 1: hash 0x55, two pairs.
    rt.h[1] = 0x55; rt.h[2] = 2;
    rt.h[3] = 100; rt.h[4] = 101;
    rt.h[5] = 200; rt.h[6] = 201;
    // Hashes differ at this depth: wrapped and handed to the REAL `node_assoc`.
    let a = rt.coll_assoc(Value(1), 0x99, Value(300), Value(301), NIL, 0);
    o.push_str(&format!("{}:{} ", a.0, rt.champ_added as u32));
    // The key is already here, at the LAST index, so the scan runs to the end.
    let b = rt.coll_assoc(Value(1), 0x55, Value(200), Value(999), NIL, 0);
    o.push_str(&format!("{}:{} ", b.0, rt.champ_added as u32));
    // The key is already here, at the FIRST index, so the scan breaks early.
    let c = rt.coll_assoc(Value(1), 0x55, Value(100), Value(888), NIL, 0);
    o.push_str(&format!("{}:{} ", c.0, rt.champ_added as u32));
    // A new key: a fresh node one pair longer, old pairs copied across.
    let d = rt.coll_assoc(Value(1), 0x55, Value(300), Value(301), NIL, 0);
    o.push_str(&format!("{}:{} ", d.0, rt.champ_added as u32));
    for k in (d.0 as usize)..(d.0 as usize + 10) { o.push_str(&format!("{},", rt.h[k])); }
    // The allocation fails: NIL out, and the stack unwound to where it started.
    rt.starve = true;
    let e = rt.coll_assoc(Value(1), 0x55, Value(400), Value(401), NIL, 0);
    o.push_str(&format!(" oom={} roots={} log={}", e.0, rt.roots.len(), rt.log));
}
fn main() {
    let mut o = String::new();
    probe_node_assoc(&mut o);
    probe_coll_assoc(&mut o);
    println!("{}", o);
}
