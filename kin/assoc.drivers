    // `hash-value` IS `valhash`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.hashValue` below stays where other entries reach it,
    // and this forwards to it.
    static int hashValue(Rt rt, long v) { return com.flint.rt.Eq.hashValue(rt, v); }
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.eq` below stays for `hash-value`'s sake and this
    // forwards to it, which keeps whatever counting each probe does.
    static boolean valEq(Rt rt, long a, long b) { return com.flint.rt.Eq.eq(rt, a, b); }
    static final long NIL = 0xFFFFL;
    static final int CN_BASE = 2;
    static final int HASH_BITS = 5;
    static final class Val {
        static long asHeap(long v) { return v; }
        static final long NIL = 0xFFFFL;
        static boolean isNil(long v) { return v == NIL; }
    }
    static int mask(int h, int shift) { return (h >>> shift) & 0x1f; }
    static int bitpos(int h, int shift) { return 1 << mask(h, shift); }
    static int indexOf(int bm, int bit) { return Integer.bitCount(bm & (bit - 1)); }
    static final class Rt {
        long[] h = new long[400];
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long bump = 200;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        StringBuilder log = new StringBuilder();
        boolean champAdded = false;
        boolean starve = false;
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long obj(String tag, long n) { long a = bump; bump += n + 1; log.append(tag); return a; }
        boolean isNil(long v) { return v == NIL; }
    }
    // Nested to reproduce the port's FULLY QUALIFIED `com.flint.rt.Eq`.
    // The vocabulary spells it in full because `eq.kin` generates a
    // class called `Eq` into package `flint.rt`, and inside a file of
    // that package a bare `Eq` is the generated one. The C# side below
    // nests `Flint.Rt.Eq` for its own version of the same shadowing.
    static final class com { static final class flint { static final class rt {
        static final class Eq {
            static boolean eq(Rt rt, long a, long b) { return a == b; }
            static int hashValue(Rt rt, long v) { return (int) ((v * 7) & 0xff); }
        }
    } } }
    static boolean isBmnode(Rt rt, long n) { return rt.h[(int) n] != 0xDEADL; }
    static int bnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int bnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long bnKey(Rt rt, long n, int at) { return rt.h[(int) n + 2 + 2 * at]; }
    static long bnVal(Rt rt, long n, int at) { return rt.h[(int) n + 3 + 2 * at]; }
    static long bnNode(Rt rt, long n, int at) { return rt.h[(int) n + 20 + at]; }
    static void cnSet(Rt rt, long n, int i, long v) { rt.h[(int) n + i] = v; }
    static void bnSetNode(Rt rt, long n, int j, long v) { cnSet(rt, n, 7 - j, v); }
    static int cnHash(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int cnCount(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long cnKey(Rt rt, long n, int i) { return rt.h[(int) n + 2 + 2 * i]; }
    static long cnVal(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    static long cnNew(Rt rt, int hh, int npairs, long e) {
        if (rt.starve) { rt.log.append("x"); return NIL; }
        long a = rt.obj("C", npairs * 2 + 2);
        rt.h[(int) a] = hh; rt.h[(int) a + 1] = npairs;
        return a;
    }
    static long cnCopySetVal(Rt rt, long n, int i, long v, long e) { return rt.obj("V", 8); }
    static long bnNew(Rt rt, int dm, int nm, long e) { return rt.obj("B", 8); }
    static long mergeTwo(Rt rt, int s, long k0, long v0, int h0, long k1, long v1, int h1, long e) { return rt.obj("M", 8); }
    static long bnCopySetValue(Rt rt, long n, int at, long v, long e) { return rt.obj("V", 8); }
    static long bnCopySetNode(Rt rt, long n, int at, long s, long e) { return rt.obj("N", 8); }
    static long bnCopyInsertEntry(Rt rt, long n, int bit, long k, long v, long e) { return rt.obj("E", 8); }
    static long bnInlineToNode(Rt rt, long n, int bit, long s, long e) { return rt.obj("I", 8); }
