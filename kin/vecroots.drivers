--rust-head
// A MOCK VECTOR THAT COPIES ON CONJ, as `collvec.drivers` uses, so the
// rooting the real `vec-from-roots` needs is actually exercised: a vector
// read into a host local before `vec-conj` would be stale here too.
//
//     vector    [count, e0, e1, ...]
//     entry     [key, val]
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
struct Sp { h: Vec<u64> }
struct Gc { sp: Sp }
struct Rt { gc: Gc, roots: Vec<Value>, bump: u64 }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.gc.sp.h[(v.0 + i as u64) as usize]) }
    fn empty_vec(&self) -> Value { Value(1) }
    // THE EMPTY VECTOR IS A SHARED SINGLETON at address 1, written once by
    // `main`. Conj copies it rather than growing it, which is what makes a
    // stale accumulator visible.
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let n = self.gc.sp.h[v.0 as usize];
        let a = self.bump; self.bump += n + 2;
        self.gc.sp.h[a as usize] = n + 1;
        for i in 0..n { self.gc.sp.h[(a + 1 + i) as usize] = self.gc.sp.h[(v.0 + 1 + i) as usize]; }
        self.gc.sp.h[(a + 1 + n) as usize] = x.0;
        Value(a)
    }
    fn entry(&mut self, k: Value, v: Value) -> Value {
        let a = self.bump; self.bump += 2;
        self.gc.sp.h[a as usize] = k.0; self.gc.sp.h[(a + 1) as usize] = v.0;
        Value(a)
    }
}
impl Rt {
--rust
}
fn show(rt: &Rt, v: Value) -> String {
    let n = rt.gc.sp.h[v.0 as usize];
    let mut s = format!("[{}", n);
    for i in 0..n { s.push_str(&format!(":{}", rt.gc.sp.h[(v.0 + 1 + i) as usize])); }
    s.push(']');
    s
}
fn main() {
    let mut rt = Rt { gc: Gc { sp: Sp { h: vec![0; 4000] } }, roots: Vec::new(), bump: 100 };
    rt.gc.sp.h[1] = 0;   // the empty vector
    let mut o = String::new();

    // THREE ROOTS, IN ORDER. The order is the contract: `base + i` counting
    // up has to hand them out the way they were pushed.
    let b = rt.mark();
    rt.push(Value(0x41)); rt.push(Value(0x42)); rt.push(Value(0x43));
    let v3 = rt.vec_from_roots(b, 3);
    o.push_str(&format!("v3={} ", show(&rt, v3)));
    // AND ZERO OF THEM, which must answer the empty vector rather than walk.
    let v0 = rt.vec_from_roots(b, 0);
    o.push_str(&format!("v0={} ", show(&rt, v0)));
    // A SUFFIX of the same run, to prove `base` is honoured and not assumed
    // to be the caller's mark.
    let v2 = rt.vec_from_roots(b + 1, 2);
    o.push_str(&format!("v2={} ", show(&rt, v2)));
    // THE SHADOW STACK IS BACK WHERE IT WAS. A function that popped to its
    // own mark and not the caller's would strand roots here.
    o.push_str(&format!("depth={} ", rt.mark() - b));
    rt.pop_to(b);

    // A MAP ENTRY BECOMES [key val], in that order. Reaching for the wrong
    // slot is the bug this fixture is named after.
    let e = rt.entry(Value(0x6B), Value(0x76));
    let ev = rt.map_entry_as_vec(e);
    o.push_str(&format!("entry={} after={} ", show(&rt, ev), rt.mark()));
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFL;
    static final class Val {
        static final long NIL = 0xFFFFL;
    }
    static final class Rt {
        long[] h = new long[4000];
        static final class Gc { long[] h; }
        Gc gc = new Gc();
        long bump = 100;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        Rt() { gc.h = h; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long v, int i) { return h[(int) v + i]; }
        long entry(long k, long v) {
            long a = bump; bump += 2;
            h[(int) a] = k; h[(int) a + 1] = v;
            return a;
        }
    }
    // `empty-vec` and `vec-conj` are ABSOLUTE names in the generated Java --
    // `Vec.empty` from the hand-written runtime, `vecConj` from the sibling
    // generated module. The probe has neither, so it nests a class of that
    // name and declares the static the `import static` would have supplied.
    static final class Vec {
        static long empty(Rt rt) { return 1; }
    }
    static long vecConj(Rt rt, long v, long x) {
        long n = rt.h[(int) v];
        long a = rt.bump; rt.bump += n + 2;
        rt.h[(int) a] = n + 1;
        for (long i = 0; i < n; i++) rt.h[(int) (a + 1 + i)] = rt.h[(int) (v + 1 + i)];
        rt.h[(int) (a + 1 + n)] = x;
        return a;
    }
--java
    static String show(Rt rt, long v) {
        long n = rt.h[(int) v];
        StringBuilder s = new StringBuilder("[").append(n);
        for (long i = 0; i < n; i++) s.append(':').append(rt.h[(int) (v + 1 + i)]);
        return s.append(']').toString();
    }

    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.h[1] = 0;   // the empty vector
        StringBuilder o = new StringBuilder();
        int b = rt.mark();
        rt.push(0x41); rt.push(0x42); rt.push(0x43);
        o.append("v3=").append(show(rt, vecFromRoots(rt, b, 3))).append(' ');
        o.append("v0=").append(show(rt, vecFromRoots(rt, b, 0))).append(' ');
        o.append("v2=").append(show(rt, vecFromRoots(rt, b + 1, 2))).append(' ');
        o.append("depth=").append(rt.mark() - b).append(' ');
        rt.popTo(b);
        long e = rt.entry(0x6B, 0x76);
        o.append("entry=").append(show(rt, mapEntryAsVec(rt, e)))
         .append(" after=").append(rt.mark()).append(' ');
        System.out.println(o.toString());
    }
--csharp-head
    // `empty-vec` emits as a BARE `Vec.Empty`, which the real generated file
    // resolves through `using global::Flint.Rt`. A nested class of that name
    // is what the probe has instead -- the same trick `collvec.drivers` uses.
    internal static class Vec {
        internal static long Empty(Rt rt) { return 1; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
    }
    internal sealed class Rt {
        internal long[] h = new long[4000];
        internal sealed class GcT { internal long[] h; }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal Rt() { gc.h = h; }
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
        internal long Entry(long k, long v) {
            long a = bump; bump += 2;
            h[(int) a] = k; h[(int) a + 1] = v;
            return a;
        }
    }
    internal static long VecConj(Rt rt, long v, long x) {
        long n = rt.h[(int) v];
        long a = rt.bump; rt.bump += n + 2;
        rt.h[(int) a] = n + 1;
        for (long i = 0; i < n; i++) rt.h[(int) (a + 1 + i)] = rt.h[(int) (v + 1 + i)];
        rt.h[(int) (a + 1 + n)] = x;
        return a;
    }
--csharp
    internal static string Show(Rt rt, long v) {
        long n = rt.h[(int) v];
        var s = new System.Text.StringBuilder("[").Append(n);
        for (long i = 0; i < n; i++) s.Append(':').Append(rt.h[(int) (v + 1 + i)]);
        return s.Append(']').ToString();
    }

    internal static void Main() {
        Rt rt = new Rt();
        rt.h[1] = 0;   // the empty vector
        var o = new System.Text.StringBuilder();
        int b = rt.Mark();
        rt.Push(0x41); rt.Push(0x42); rt.Push(0x43);
        o.Append("v3=").Append(Show(rt, VecFromRoots(rt, b, 3))).Append(' ');
        o.Append("v0=").Append(Show(rt, VecFromRoots(rt, b, 0))).Append(' ');
        o.Append("v2=").Append(Show(rt, VecFromRoots(rt, b + 1, 2))).Append(' ');
        o.Append("depth=").Append(rt.Mark() - b).Append(' ');
        rt.PopTo(b);
        long e = rt.Entry(0x6B, 0x76);
        o.Append("entry=").Append(Show(rt, MapEntryAsVec(rt, e)))
         .Append(" after=").Append(rt.Mark()).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
--expect
v3=[3:65:66:67] v0=[0] v2=[2:66:67] depth=3 entry=[2:107:118] after=0
--expect-why
DERIVED BY HAND from `vecroots.kin` against the mock vector this fixture
defines, not pasted from a run. `show` prints `[count:e0:e1:...]` in DECIMAL,
so the fixture's hex pushes come back as digits:

  0x41 = 65   0x42 = 66   0x43 = 67   0x6B = 107   0x76 = 118

`vec-from-roots base n` starts from `empty-vec` and conjes `r(base + i)` for
i in 0..n, in that order.

  v3: base = the caller's mark, n = 3 -> r(0), r(1), r(2) = 65, 66, 67, conjed
      in that order. `[3:65:66:67]`. THE ORDER IS THE ASSERTION: the three
      values are distinct and ascending, so a descending walk prints
      `[3:67:66:65]` and a fixed `mark` rather than `base` prints the same
      three whatever `base` is.

  v0: n = 0, so the loop never runs and the answer is the empty vector it
      started from -- `[0]`, printed from the singleton at address 1. A
      `for` that ran once on zero would print `[1:...]` reading a root that
      is not the caller's.

  v2: base + 1, n = 2 -> r(1), r(2) = 66, 67. `[2:66:67]`. This is the field
      that proves `base` is HONOURED: an implementation that took the
      caller's current mark instead would answer `[2:65:66]` or `[3:...]`,
      and v3 alone cannot tell the two apart because there base IS the mark.

  depth=3: the three values `main` pushed are still on the shadow stack.
      `vec-from-roots` pops back to ITS OWN mark and must not take the
      caller's roots with it (the file's header says "the SOURCE values are
      the caller's roots and the caller keeps them"). 0 would be a function
      that popped to `base`, stranding the caller's live values.

  entry: `map-entry-as-vec` pushes slot 0 then slot 1 and hands the pair to
      `vec-from-roots (base, 2)`, so a `TY_MAPENTRY` of (0x6B, 0x76) becomes
      `[2:107:118]` -- KEY FIRST. `[2:118:107]` is the bug this function is
      named after, the one that gave `(assoc [:a 1] 0 :z)` the answer `[:z]`.

  after=0: the shadow stack is back to empty, so the two roots it pushed for
      its own use were popped.
