;; `node_find` and `node_find_scalar`: reading a key back out of a CHAMP.
;;
;; Phase 3 of `doc/goals/kin-port.md`. Two walks of the same trie that differ
;; only in whether they root what they are holding, and the split is what makes
;; `get` fast:
;;
;;   `node_find_scalar` -- the key cannot allocate when compared, so nothing
;;                         can move mid-walk and the node is an ordinary local
;;   `node_find`        -- the key is compound, so `eq` seqs both sides, which
;;                         allocates, which can collect and move the node this
;;                         walk is standing on. Everything is rooted, and the
;;                         current node is updated IN THE ROOT with `set-r`
;;
;; THE FAST PATH EXISTED IN RUST AND IN NEITHER PORT. Measured before porting
;; rather than after: 20,000,000 scalar-key lookups into a 2,000-entry CHAMP,
;; two binaries run interleaved with the compile cost subtracted, 2.05s against
;; 2.18s. Six percent of the most common map operation, so it ports outward.
;;
;; THE LOOP SHAPE is the ports', not Rust's. Rust wrote `loop { ... break v }`,
;; which yields a value and has no counterpart in the other two; the ports set
;; an `out` variable and `break` plain. `forever` is new vocabulary for the
;; loop itself -- `(while true ...)` would emit `while true`, which rustc lints
;; and which does not tell the type checker the loop diverges.
;; A COLLISION NODE COSTS WHAT IT SCANS.
;;
;; Both loops below charge one unit per entry examined, which is what
;; `kin/mapeq.kin` already does and what these two did not. Without it a
;; lookup on a map whose keys share a hash scans the whole node and is billed
;; a FLAT 16 STEPS -- measured at 1 024, 4 096 and 16 384 colliding keys, and
;; flat at every one of them. At 16 384 that is 179us of work billed the same
;; as 1.70us: 105x, with the multiplier chosen by whoever supplies the keys.
;;
;; REACHABLE, not theoretical. Flint's string hash is a base-31 polynomial, so
;; `Aa` and `BB` hash alike and the property composes -- a choice of `Aa` or
;; `BB` at each of k positions gives 2^k strings with one hash. Any map holding
;; attacker-influenced strings can be made to do unbounded uncharged work.
;;
;; `0009` is the promise this restores, and `kin/collhash.kin` names the class
;; about a defect fixed the same way: "it is not a slow path, it is a metering
;; hole". Full measurement and reproduction in `doc/goals/hash-flooding.md`.
;;
;; NEARLY FREE FOR LEGITIMATE CODE: a map with no collisions never goes round
;; the loop more than once, so its gas moves by the one unit it always should
;; have paid.
(ns flint.rt.find
  (:require [flint.impl.rt :refer [defn return if let local set do comment
                                   forever for break mark push r set-r pop-to
                                   not == != < + bit-and charge-work Rt Value
                                   RootIx I32 Bool NOT_FOUND HASH_BITS
                                   declarefn]]
            [flint.rt.nodeclass :refer [is-bmnode]]
            [flint.rt.eqalloc :refer [eq-may-alloc]]
            [flint.rt.collnode :refer [cn-count cn-hash cn-key cn-val]]
            [flint.rt.champ :refer [bn-datamap bn-key bn-node bn-nodemap
                                    bn-val]]
            [flint.rt.maps :refer [bitpos index-of]]))

(declarefn flint.rt.valeq/val-eq)

(defn ^:pub ^:method ^Value node-find-scalar
  [^:mut ^Rt rt ^Value n ^:mut ^I32 shift ^I32 h ^Value key]
  (comment "No rooting anywhere in here: the key is a scalar, so `eq` cannot"
           "allocate, so nothing can move while this walks.")
  (local ^:mut ^Value node)
  (set node n)
  (local ^:mut ^Value out)
  (set out NOT_FOUND)
  (forever
    (if (not (is-bmnode rt node))
      (do
        (if (!= (cn-hash rt node) h)
          (break))
        (let [^I32 cnt (cn-count rt node)]
          (for [^I32 i 0 cnt]
            (do
              (charge-work rt 1)
              (if (val-eq rt (cn-key rt node i) key)
                (do
                  (set out (cn-val rt node i))
                  (break))))))
        (break)))
    (let [^I32 bit (bitpos h shift)
          ^I32 dm (bn-datamap rt node)]
      (if (!= (bit-and dm bit) 0)
        (do
          (let [^I32 i (index-of dm bit)]
            (if (val-eq rt (bn-key rt node i) key)
              (set out (bn-val rt node i))))
          (break)))
      (let [^I32 nm (bn-nodemap rt node)]
        (if (== (bit-and nm bit) 0)
          (break))
        (set node (bn-node rt node (index-of nm bit)))
        (set shift (+ shift HASH_BITS)))))
  (return out))

(defn ^:pub ^:method ^Value node-find
  [^:mut ^Rt rt ^Value n ^:mut ^I32 shift ^I32 h ^Value key]
  (if (not (eq-may-alloc rt key))
    (return (node-find-scalar rt n shift h key)))
  (comment "The node being walked and the key are rooted: `eq` on a compound"
           "key allocates (it seqs both sides), so a collection can happen in"
           "the middle of a lookup and move everything this walk is holding.")
  (let [^RootIx base (mark rt)
        ^RootIx ni (push rt n)
        ^RootIx ki (push rt key)]
    (local ^:mut ^Value out)
    (set out NOT_FOUND)
    (forever
      (if (not (is-bmnode rt (r rt ni)))
        (do
          (if (!= (cn-hash rt (r rt ni)) h)
            (break))
          (let [^I32 cnt (cn-count rt (r rt ni))]
            (for [^I32 i 0 cnt]
              (do
                (charge-work rt 1)
                (let [^RootIx kk (push rt (cn-key rt (r rt ni) i))
                      ^Bool same (val-eq rt (r rt kk) (r rt ki))]
                  (pop-to rt kk)
                  (if same
                    (do
                      (set out (cn-val rt (r rt ni) i))
                      (break)))))))
          (break)))
      (let [^I32 bit (bitpos h shift)
            ^I32 dm (bn-datamap rt (r rt ni))]
        (if (!= (bit-and dm bit) 0)
          (do
            (let [^I32 i (index-of dm bit)
                  ^RootIx kk (push rt (bn-key rt (r rt ni) i))
                  ^Bool same (val-eq rt (r rt kk) (r rt ki))]
              (pop-to rt kk)
              (if same
                (set out (bn-val rt (r rt ni) i))))
            (break)))
        (let [^I32 nm (bn-nodemap rt (r rt ni))]
          (if (== (bit-and nm bit) 0)
            (break))
          (set-r rt ni (bn-node rt (r rt ni) (index-of nm bit)))
          (set shift (+ shift HASH_BITS)))))
    (pop-to rt base)
    (return out)))
