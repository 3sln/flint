    // `hash-value` IS `valhash`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.hashValue` below stays where other entries reach it,
    // and this forwards to it.
    static int hashValue(Rt rt, long v) { return com.flint.rt.Eq.hashValue(rt, v); }
    static final long NIL = 0xFFFFL;
    static final int AM_BASE = 2, AM_META = 0, HM_ROOT = 1, HM_META = 2;
    static final int ARRAY_MAP_MAX = 8;
    static final int TY_ARRAYMAP = 14, TY_HASHMAP = 15, TY_TABLEREF = 50;
    static final class Val {
        static final long NIL = 0xFFFFL;
        static long asHeap(long v) { return v; }
    }
    static final class Rt {
        long[] h = new long[900];
        static final class Gc { int[] sp = new int[900]; }
        Gc gc = new Gc();
        int[] counts = new int[900];
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        long bump = 100;
        boolean champAdded = false;
        StringBuilder log = new StringBuilder();
        int maxroots = 0;
        int mark() { return roots.size(); }
        int push(long v) {
            roots.add(v);
            if (roots.size() > maxroots) maxroots = roots.size();
            return roots.size() - 1;
        }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long n, int i) { return h[(int) n + i]; }
        void setSlot(long n, int i, long v) { h[(int) n + i] = v; }
        long obj(int t, String tag) {
            long a = bump; bump += 24; gc.sp[(int) a] = t; log.append(tag); return a;
        }
    }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
    // BARE: siblings come through `import static`.
    static int mapCount(Rt rt, long m) { return rt.counts[(int) m]; }
    static long amKey(Rt rt, long m, int i) { return rt.h[(int) m + 2 + 2 * i]; }
    static long amVal(Rt rt, long m, int i) { return rt.h[(int) m + 3 + 2 * i]; }
    static long newArrayMap(Rt rt, int n) {
        long v = rt.obj(TY_ARRAYMAP, "A"); rt.counts[(int) v] = n; return v;
    }
    static long newHashMap(Rt rt, int cnt, long root, long meta) {
        long v = rt.obj(TY_HASHMAP, "H");
        rt.counts[(int) v] = cnt;
        rt.setSlot(v, HM_ROOT, root); rt.setSlot(v, HM_META, meta);
        return v;
    }
    static int amIndexOf(Rt rt, long m, long k) {
        int n = mapCount(rt, m);
        for (int i = 0; i < n; i++) if (amKey(rt, m, i) == k) return i;
        return n;
    }
    static long bnNew(Rt rt, int d, int n, long e) { return rt.obj(TY_HASHMAP, "B"); }
    static long nodeAssoc(Rt rt, long n, int s, int h, long k, long v, long e) {
        rt.champAdded = true; return rt.obj(TY_HASHMAP, "N");
    }
    static long nodeDissoc(Rt rt, long n, int s, int h, long k, long e) {
        if (h == 0x77) { rt.champAdded = true; return rt.obj(TY_HASHMAP, "D"); }
        rt.champAdded = false; return n;
    }
    // Nested to reproduce the qualified names the vocabulary emits.
    static final class com { static final class flint { static final class rt {
        static final class Eq {
            static int hashValue(Rt rt, long v) { return (int) ((v * 7) & 0xff); }
        }
        static final class Maps { static long empty(Rt rt) { return 0xEL; } }
    } } }
    static final class Table {
        static long refToMap(Rt rt, long r) {
            long v = rt.obj(TY_ARRAYMAP, "M"); rt.counts[(int) v] = 0; return v;
        }
    }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.gc.sp[60] = TY_ARRAYMAP; rt.counts[60] = 2;
        rt.h[62] = 0x31; rt.h[63] = 0x32; rt.h[64] = 0x41; rt.h[65] = 0x42;
        rt.gc.sp[80] = TY_HASHMAP; rt.counts[80] = 5; rt.h[81] = 90;
        rt.gc.sp[70] = TY_TABLEREF;
        StringBuilder o = new StringBuilder();
        long a = mapAssoc(rt, 60, 0x31, 0x32);
        o.append("same=").append(a == 60 ? 1 : 0).append(' ');
        long b = mapAssoc(rt, 60, 0x31, 0x99);
        o.append("repl=").append(amVal(rt, b, 0)).append(',').append(amKey(rt, b, 1)).append(' ');
        long c = mapAssoc(rt, 60, 0x51, 0x52);
        o.append("grow=").append(mapCount(rt, c)).append(',').append(amKey(rt, c, 2)).append(' ');
        rt.counts[60] = ARRAY_MAP_MAX;
        long d = mapAssoc(rt, 60, 0x61, 0x62);
        o.append("promoted=").append(ty(rt.gc.sp, Val.asHeap(d)) == TY_HASHMAP ? 1 : 0).append(' ');
        rt.counts[60] = 2;
        long e = mapAssoc(rt, 80, 0x71, 0x72);
        o.append("hcount=").append(mapCount(rt, e)).append(' ');
        long f = mapDissoc(rt, 60, 0x99);
        o.append("| miss=").append(f == 60 ? 1 : 0).append(' ');
        long g = mapDissoc(rt, 60, 0x31);
        o.append("shrunk=").append(mapCount(rt, g)).append(',').append(amKey(rt, g, 0)).append(' ');
        long refd = mapDissoc(rt, 70, 0x31);
        o.append("ref=").append(ty(rt.gc.sp, Val.asHeap(refd)) == TY_ARRAYMAP ? 1 : 0).append(' ');
        long h1 = mapDissoc(rt, 80, 0x01);
        o.append("| huntouched=").append(h1 == 80 ? 1 : 0).append(' ');
        long h2 = mapDissoc(rt, 80, 0x11);
        o.append("hshrunk=").append(mapCount(rt, h2)).append(' ');
        o.append("log=").append(rt.log).append(" roots=").append(rt.roots.size())
         .append(" max=").append(rt.maxroots);
        System.out.println(o);
    }
--csharp-pre
// The hand-written runtime, as a REAL top-level namespace.
//
// The generated C# reaches it as `global::Flint.Rt.X`, because its own
// namespace ends in `Rt` and a bare `Flint.Rt` would resolve against that
// instead. `global::` needs a genuine root namespace, which a shim nested
// inside `class Probe` cannot be -- so these live out here now.
namespace Flint.Rt {
        internal static class Eq {
            internal static int HashValue(Probe.Rt rt, long v) { return (int) ((v * 7) & 0xff); }
        }
        internal static class Maps { internal static long Empty(Probe.Rt rt) { return 0xEL; } }
        internal static class Table {
            internal static long refToMap(Probe.Rt rt, long r) {
                long v = rt.ObjNew(Probe.Obj.TyArraymap, "M"); rt.counts[(int) v] = 0; return v;
            }
        }
}

