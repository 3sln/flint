    // `hash-value` IS `valhash`'s OWN now, so it is called BARE.
    internal static int HashValue(Rt rt, long v) { return global::Flint.Rt.Eq.HashValue(rt, v); }
    const long NIL = 0xFFFFL;
    const int AM_BASE = 2, AM_META = 0, HM_ROOT = 1, HM_META = 2;
    const int ARRAY_MAP_MAX = 8;
    internal static class Obj {
        internal const int TyArraymap = 14, TyHashmap = 15, TyTableref = 50;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static long AsHeap(long v) { return v; }
    }
    internal sealed class Rt {
        internal long[] h = new long[900];
        internal sealed class GcT { internal int[] sp = new int[900]; }
        internal GcT gc = new GcT();
        internal int[] counts = new int[900];
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal long bump = 100;
        internal bool champAdded = false;
        internal StringBuilder log = new StringBuilder();
        internal int maxroots = 0;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) {
            roots.Add(v);
            if (roots.Count > maxroots) maxroots = roots.Count;
            return roots.Count - 1;
        }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
        internal void SetSlot(long n, int i, long v) { h[(int) n + i] = v; }
        internal long ObjNew(int t, string tag) {
            long a = bump; bump += 24; gc.sp[(int) a] = t; log.Append(tag); return a;
        }
    }
    static int MapCount(Rt rt, long m) { return rt.counts[(int) m]; }
    static long AmKey(Rt rt, long m, int i) { return rt.h[(int) m + 2 + 2 * i]; }
    static long AmVal(Rt rt, long m, int i) { return rt.h[(int) m + 3 + 2 * i]; }
    static long NewArrayMap(Rt rt, int n) {
        long v = rt.ObjNew(Obj.TyArraymap, "A"); rt.counts[(int) v] = n; return v;
    }
    static long NewHashMap(Rt rt, int cnt, long root, long meta) {
        long v = rt.ObjNew(Obj.TyHashmap, "H");
        rt.counts[(int) v] = cnt;
        rt.SetSlot(v, HM_ROOT, root); rt.SetSlot(v, HM_META, meta);
        return v;
    }
    static int AmIndexOf(Rt rt, long m, long k) {
        int n = MapCount(rt, m);
        for (int i = 0; i < n; i++) if (AmKey(rt, m, i) == k) return i;
        return n;
    }
    static long BnNew(Rt rt, int d, int n, long e) { return rt.ObjNew(Obj.TyHashmap, "B"); }
    static long NodeAssoc(Rt rt, long n, int s, int h, long k, long v, long e) {
        rt.champAdded = true; return rt.ObjNew(Obj.TyHashmap, "N");
    }
    static long NodeDissoc(Rt rt, long n, int s, int h, long k, long e) {
        if (h == 0x77) { rt.champAdded = true; return rt.ObjNew(Obj.TyHashmap, "D"); }
        rt.champAdded = false; return n;
    }
