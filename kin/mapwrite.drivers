--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const AM_BASE: u32 = 2; const AM_META: u32 = 0;
const HM_ROOT: u32 = 1; const HM_META: u32 = 2;
const ARRAY_MAP_MAX: u32 = 8;
const TY_ARRAYMAP: u8 = 14; const TY_HASHMAP: u8 = 15; const TY_TABLEREF: u8 = 50;
impl Value { fn as_heap(self) -> u32 { self.0 as u32 } }
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, counts: Vec<u32>, roots: Vec<Value>,
            bump: u64, champ_added: bool, log: String, maxroots: usize }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize {
        self.roots.push(v);
        if self.roots.len() > self.maxroots { self.maxroots = self.roots.len(); }
        self.roots.len() - 1
    }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn obj(&mut self, t: u8, tag: &str) -> Value {
        let a = self.bump; self.bump += 24;
        self.gc.sp[a as usize] = t; self.log.push_str(tag);
        Value(a)
    }
    fn map_count(&self, m: Value) -> u32 { self.counts[m.0 as usize] }
    fn am_key(&self, m: Value, i: u32) -> Value { Value(self.h[m.0 as usize + 2 + 2 * i as usize]) }
    fn am_val(&self, m: Value, i: u32) -> Value { Value(self.h[m.0 as usize + 3 + 2 * i as usize]) }
    fn new_array_map(&mut self, n: u32) -> Value {
        let v = self.obj(TY_ARRAYMAP, "A"); self.counts[v.0 as usize] = n; v
    }
    fn new_hash_map(&mut self, cnt: u32, root: Value, meta: Value) -> Value {
        let v = self.obj(TY_HASHMAP, "H");
        self.counts[v.0 as usize] = cnt;
        self.set(v, HM_ROOT, root); self.set(v, HM_META, meta);
        v
    }
    fn am_index_of(&mut self, m: Value, k: Value) -> u32 {
        let n = self.map_count(m);
        for i in 0..n { if self.am_key(m, i) == k { return i; } }
        n
    }
    fn hash_value(&mut self, v: Value) -> u32 { ((v.0 * 7) & 0xff) as u32 }
    fn bn_new(&mut self, _d: u32, _n: u32, _e: Value) -> Value { self.obj(TY_HASHMAP, "B") }
    fn node_assoc(&mut self, _n: Value, _s: u32, _h: u32, _k: Value, _v: Value, _e: Value) -> Value {
        self.champ_added = true; self.obj(TY_HASHMAP, "N")
    }
    fn node_dissoc(&mut self, n: Value, _s: u32, h: u32, _k: Value, _e: Value) -> Value {
        // h 0x77 means "found and removed"; anything else means untouched.
        if h == 0x77 { self.champ_added = true; self.obj(TY_HASHMAP, "D") }
        else { self.champ_added = false; n }
    }
    fn ref_to_map(&mut self, _r: Value) -> Value {
        let v = self.obj(TY_ARRAYMAP, "M"); self.counts[v.0 as usize] = 0; v
    }
    fn empty_map(&self) -> Value { Value(0xE) }
}
fn ty(sp: &Vec<u8>, a: u32) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 900], gc: Gc { sp: vec![0u8; 900] }, counts: vec![0; 900],
                      roots: Vec::new(), bump: 100, champ_added: false,
                      log: String::new(), maxroots: 0 };
    // An array map at 60 with two entries, and a hash map at 80.
    rt.gc.sp[60] = TY_ARRAYMAP; rt.counts[60] = 2;
    rt.h[62] = 0x31; rt.h[63] = 0x32; rt.h[64] = 0x41; rt.h[65] = 0x42;
    rt.gc.sp[80] = TY_HASHMAP; rt.counts[80] = 5; rt.h[81] = 90;
    rt.gc.sp[70] = TY_TABLEREF;
    let mut o = String::new();
    // assoc: existing key with the SAME value hands the map straight back.
    let a = rt.map_assoc(Value(60), Value(0x31), Value(0x32));
    o.push_str(&format!("same={} ", (a == Value(60)) as u32));
    // existing key, different value: a fresh flat map with the slot replaced.
    let b = rt.map_assoc(Value(60), Value(0x31), Value(0x99));
    o.push_str(&format!("repl={},{} ", rt.am_val(b, 0).0, rt.am_key(b, 1).0));
    // a NEW key with room: appended, still flat.
    let c = rt.map_assoc(Value(60), Value(0x51), Value(0x52));
    o.push_str(&format!("grow={},{} ", rt.map_count(c), rt.am_key(c, 2).0));
    // a new key with NO room: promotes, then takes the CHAMP arm.
    rt.counts[60] = ARRAY_MAP_MAX;
    let d = rt.map_assoc(Value(60), Value(0x61), Value(0x62));
    o.push_str(&format!("promoted={} ", (ty(&rt.gc.sp, d.as_heap()) == TY_HASHMAP) as u32));
    rt.counts[60] = 2;
    // assoc into a hash map counts up when the key was new.
    let e = rt.map_assoc(Value(80), Value(0x71), Value(0x72));
    o.push_str(&format!("hcount={} ", rt.map_count(e)));
    // dissoc: absent key hands the map back; present key shrinks it.
    let f = rt.map_dissoc(Value(60), Value(0x99));
    o.push_str(&format!("| miss={} ", (f == Value(60)) as u32));
    let g = rt.map_dissoc(Value(60), Value(0x31));
    o.push_str(&format!("shrunk={},{} ", rt.map_count(g), rt.am_key(g, 0).0));
    // a ROW REF materialises rather than failing.
    let refd = rt.map_dissoc(Value(70), Value(0x31));
    o.push_str(&format!("ref={} ", (ty(&rt.gc.sp, refd.as_heap()) == TY_ARRAYMAP) as u32));
    // dissoc from a hash map: untouched, then a real removal.
    let h1 = rt.map_dissoc(Value(80), Value(0x01));
    o.push_str(&format!("| huntouched={} ", (h1 == Value(80)) as u32));
    let h2 = rt.map_dissoc(Value(80), Value(0x11));
    o.push_str(&format!("hshrunk={} ", rt.map_count(h2)));
    o.push_str(&format!("log={} roots={} max={}", rt.log, rt.roots.len(), rt.maxroots));
    println!("{}", o);
}
