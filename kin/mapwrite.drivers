    static void Main() {
        var rt = new Rt();
        rt.gc.sp[60] = Obj.TyArraymap; rt.counts[60] = 2;
        rt.h[62] = 0x31; rt.h[63] = 0x32; rt.h[64] = 0x41; rt.h[65] = 0x42;
        rt.gc.sp[80] = Obj.TyHashmap; rt.counts[80] = 5; rt.h[81] = 90;
        rt.gc.sp[70] = Obj.TyTableref;
        var o = new StringBuilder();
        long a = MapAssoc(rt, 60, 0x31, 0x32);
        o.Append("same=").Append(a == 60 ? 1 : 0).Append(' ');
        long b = MapAssoc(rt, 60, 0x31, 0x99);
        o.Append("repl=").Append(AmVal(rt, b, 0)).Append(',').Append(AmKey(rt, b, 1)).Append(' ');
        long c = MapAssoc(rt, 60, 0x51, 0x52);
        o.Append("grow=").Append(MapCount(rt, c)).Append(',').Append(AmKey(rt, c, 2)).Append(' ');
        rt.counts[60] = ARRAY_MAP_MAX;
        long d = MapAssoc(rt, 60, 0x61, 0x62);
        o.Append("promoted=").Append(Obj.Ty(rt.gc.sp, Val.AsHeap(d)) == Obj.TyHashmap ? 1 : 0).Append(' ');
        rt.counts[60] = 2;
        long e = MapAssoc(rt, 80, 0x71, 0x72);
        o.Append("hcount=").Append(MapCount(rt, e)).Append(' ');
        long f = MapDissoc(rt, 60, 0x99);
        o.Append("| miss=").Append(f == 60 ? 1 : 0).Append(' ');
        long g = MapDissoc(rt, 60, 0x31);
        o.Append("shrunk=").Append(MapCount(rt, g)).Append(',').Append(AmKey(rt, g, 0)).Append(' ');
        long refd = MapDissoc(rt, 70, 0x31);
        o.Append("ref=").Append(Obj.Ty(rt.gc.sp, Val.AsHeap(refd)) == Obj.TyArraymap ? 1 : 0).Append(' ');
        long h1 = MapDissoc(rt, 80, 0x01);
        o.Append("| huntouched=").Append(h1 == 80 ? 1 : 0).Append(' ');
        long h2 = MapDissoc(rt, 80, 0x11);
        o.Append("hshrunk=").Append(MapCount(rt, h2)).Append(' ');
        o.Append("log=").Append(rt.log).Append(" roots=").Append(rt.roots.Count)
         .Append(" max=").Append(rt.maxroots);
        Console.WriteLine(o.ToString());
    }
