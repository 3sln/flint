--rust-head
// A REAL STRING COMES OUT OF THIS PROBE, unlike most of them, and that is the
// point. `numdiv.drivers` folds its sink to a hash so three targets can be
// compared without a string implementation -- fine when the question is "did
// they generate the same walk". Here the question is "is the answer right",
// because all three hosts USED to agree with each other and disagree with
// Clojure. Three targets printing the same wrong string would pass a hash
// probe and teach us nothing.
//
// EACH HOST'S OWN NOTATION IS FED IN ON PURPOSE: `f64_shortest` is the real
// one-liner here, so Rust hands the walk `1e20`, Java hands it `1.0E20` and
// C# hands it `1E+20`. Identical output means the re-rendering actually
// erased the difference rather than the probe hiding it.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_FFFF_FFFF_FFFF);
struct Rt { ints: Vec<i64>, dbls: Vec<f64>, strs: Vec<String>,
            cps: Vec<Vec<u32>>, sinks: Vec<Vec<u8>> }
impl Value {
    fn tag(self) -> u64 { self.0 >> 60 }
    fn idx(self) -> usize { (self.0 & 0x0FFF_FFFF_FFFF_FFFF) as usize }
    fn is_double(self) -> bool { self.tag() == 2 }
}
impl Rt {
    fn int(&mut self, n: i64) -> Value { self.ints.push(n); Value((1u64 << 60) | (self.ints.len() - 1) as u64) }
    fn dbl(&mut self, d: f64) -> Value { self.dbls.push(d); Value((2u64 << 60) | (self.dbls.len() - 1) as u64) }
    fn is_int(&self, v: Value) -> bool { v.tag() == 1 }
    fn i64_of(&self, v: Value) -> i64 { self.ints[v.idx()] }
    fn num_f64(&self, v: Value) -> f64 { self.dbls[v.idx()] }
    fn string(&mut self, s: &str) -> Value {
        self.strs.push(String::from(s)); Value((3u64 << 60) | (self.strs.len() - 1) as u64)
    }
    fn f64_digits(&mut self, c: u32, d: f64) {
        let s = format!("{:e}", d);
        for b in s.bytes() { self.cps_put(c, b as u32); }
    }
    fn cps_open(&mut self) -> u32 { self.cps.push(Vec::new()); (self.cps.len() - 1) as u32 }
    fn cps_put(&mut self, c: u32, v: u32) { self.cps[c as usize].push(v); }
    fn cps_len(&self, c: u32) -> u32 { self.cps[c as usize].len() as u32 }
    fn cps_at(&self, c: u32, i: u32) -> u32 { self.cps[c as usize][i as usize] }
    fn cps_close(&mut self, c: u32) { self.cps.truncate(c as usize); }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_put(&mut self, s: u32, b: u32) { self.sinks[s as usize].push(b as u8); }
    fn sink_close(&mut self, s: u32) { self.sinks.truncate(s as usize); }
    fn sink_string(&mut self, s: u32) -> Value {
        let t = String::from_utf8(self.sinks[s as usize].clone()).unwrap();
        self.string(&t)
    }
    fn throw_str(&mut self, _k: &str, _m: &str) -> Value { NIL }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { ints: Vec::new(), dbls: Vec::new(), strs: Vec::new(),
                      cps: Vec::new(), sinks: Vec::new() };
    let mut o = String::new();
    let ds = [0.0f64, -0.0, 1.0, 1.5, 100.0, 1e6, 1234567.0, 1e7, 12345678.0,
              1e14, 1e15, 1e20, 1e-3, 1e-4, 5e-4, 0.1, 123.456, 1e-300, 1e300,
              3.14159265358979, 1.0 / 3.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
    for d in ds {
        let v = rt.dbl(d);
        let s = rt.num_to_str(v);
        if s == NIL { o.push('!'); } else { o.push_str(&rt.strs[s.idx()].clone()); }
        o.push(' ');
    }
    for n in [0i64, 7, -7, i64::MAX, i64::MIN] {
        let v = rt.int(n);
        let s = rt.num_to_str(v);
        o.push_str(&rt.strs[s.idx()].clone());
        o.push(' ');
    }
    // A NON-NUMBER is refused rather than formatted.
    let bad = Value(4u64 << 60);
    o.push_str(if rt.num_to_str(bad) == NIL { "refused" } else { "FORMATTED" });
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFFFFFFFFFFFFFL;
    static final class Val {
        static boolean isDouble(long v) { return (v >>> 60) == 2; }
    }
    static final class Rt {
        java.util.ArrayList<Long> ints = new java.util.ArrayList<>();
        java.util.ArrayList<Double> dbls = new java.util.ArrayList<>();
        java.util.ArrayList<String> strs = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Integer>> cps = new java.util.ArrayList<>();
        java.util.ArrayList<java.io.ByteArrayOutputStream> sinks = new java.util.ArrayList<>();
        long anInt(long n) { ints.add(n); return (1L << 60) | (ints.size() - 1); }
        long aDbl(double d) { dbls.add(d); return (2L << 60) | (dbls.size() - 1); }
        long throwStr(String cls, String msg) { return NIL; }
        int cpsOpen() { cps.add(new java.util.ArrayList<>()); return cps.size() - 1; }
        void cpsPut(int c, int v) { cps.get(c).add(v); }
        int cpsLen(int c) { return cps.get(c).size(); }
        int cpsAt(int c, int i) { return cps.get(c).get(i); }
        void cpsClose(int c) { while (cps.size() > c) cps.remove(cps.size() - 1); }
        int sinkOpen() { sinks.add(new java.io.ByteArrayOutputStream()); return sinks.size() - 1; }
        void sinkPut(int s, int b) { sinks.get(s).write(b); }
        void sinkClose(int s) { while (sinks.size() > s) sinks.remove(sinks.size() - 1); }
        long sinkString(int s) {
            return Str.of(this, new String(sinks.get(s).toByteArray(),
                                           java.nio.charset.StandardCharsets.UTF_8));
        }
    }
    static int idx(long v) { return (int) (v & 0x0FFFFFFFFFFFFFFFL); }

    static final class Str {
        static long of(Rt rt, String s) { rt.strs.add(s); return (3L << 60) | (rt.strs.size() - 1); }
        static void f64Digits(Rt rt, int c, double d) {
            String s = Double.toString(d);
            for (int i = 0; i < s.length(); i++) rt.cpsPut(c, s.charAt(i));
        }
    }
    static final class Num {
        static long i64Of(Rt rt, long v) { return rt.ints.get(idx(v)); }
        static double f64(Rt rt, long v) { return rt.dbls.get(idx(v)); }
    }
    static boolean isInt(Rt rt, long v) { return (v >>> 60) == 1; }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        double[] ds = { 0.0, -0.0, 1.0, 1.5, 100.0, 1e6, 1234567.0, 1e7, 12345678.0,
                        1e14, 1e15, 1e20, 1e-3, 1e-4, 5e-4, 0.1, 123.456, 1e-300, 1e300,
                        3.14159265358979, 1.0 / 3.0, Double.NaN,
                        Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY };
        for (double d : ds) {
            long s = numToStr(rt, rt.aDbl(d));
            o.append(s == NIL ? "!" : rt.strs.get(idx(s))).append(' ');
        }
        long[] ns = { 0, 7, -7, Long.MAX_VALUE, Long.MIN_VALUE };
        for (long n : ns) {
            long s = numToStr(rt, rt.anInt(n));
            o.append(rt.strs.get(idx(s))).append(' ');
        }
        o.append(numToStr(rt, 4L << 60) == NIL ? "refused" : "FORMATTED");
        System.out.println(o.toString());
    }
--csharp-head
    internal const long NIL = unchecked((long) 0xFFFFFFFFFFFFFFFFUL);
    internal static class Val {
        internal static bool IsDouble(long v) { return (long)((ulong) v >> 60) == 2; }
    }
    internal sealed class Rt {
        internal System.Collections.Generic.List<long> Ints = new System.Collections.Generic.List<long>();
        internal System.Collections.Generic.List<double> Dbls = new System.Collections.Generic.List<double>();
        internal System.Collections.Generic.List<string> Strs = new System.Collections.Generic.List<string>();
        internal System.Collections.Generic.List<System.Collections.Generic.List<int>> Cps
            = new System.Collections.Generic.List<System.Collections.Generic.List<int>>();
        internal System.Collections.Generic.List<System.Collections.Generic.List<byte>> Sinks
            = new System.Collections.Generic.List<System.Collections.Generic.List<byte>>();
        internal long AnInt(long n) { Ints.Add(n); return (1L << 60) | (Ints.Count - 1); }
        internal long ADbl(double d) { Dbls.Add(d); return (2L << 60) | (Dbls.Count - 1); }
        internal long ThrowStr(string cls, string msg) { return NIL; }
        internal int CpsOpen() { Cps.Add(new System.Collections.Generic.List<int>()); return Cps.Count - 1; }
        internal void CpsPut(int c, int v) { Cps[c].Add(v); }
        internal int CpsLen(int c) { return Cps[c].Count; }
        internal int CpsAt(int c, int i) { return Cps[c][i]; }
        internal void CpsClose(int c) { while (Cps.Count > c) Cps.RemoveAt(Cps.Count - 1); }
        internal int SinkOpen() { Sinks.Add(new System.Collections.Generic.List<byte>()); return Sinks.Count - 1; }
        internal void SinkPut(int s, int b) { Sinks[s].Add((byte) b); }
        internal void SinkClose(int s) { while (Sinks.Count > s) Sinks.RemoveAt(Sinks.Count - 1); }
        internal long SinkString(int s) {
            return Str.Of(this, System.Text.Encoding.UTF8.GetString(Sinks[s].ToArray()));
        }
    }
    internal static int Idx(long v) { return (int) (v & 0x0FFFFFFFFFFFFFFFL); }

    internal static class Str {
        internal static long Of(Rt rt, string s) { rt.Strs.Add(s); return (3L << 60) | (rt.Strs.Count - 1); }
        internal static void F64Digits(Rt rt, int c, double d) {
            string s = d.ToString("R", System.Globalization.CultureInfo.InvariantCulture);
            for (int i = 0; i < s.Length; i++) rt.CpsPut(c, s[i]);
        }
    }
    internal static class Num {
        internal static long I64Of(Rt rt, long v) { return rt.Ints[Idx(v)]; }
        internal static double F64(Rt rt, long v) { return rt.Dbls[Idx(v)]; }
    }
    internal static bool IsInt(Rt rt, long v) { return (long)((ulong) v >> 60) == 1; }
