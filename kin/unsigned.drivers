--rust-head
struct Rt {}
impl Rt {
--rust
}
fn main() {
    let rt = Rt {};
    // The high bit set: the whole point. Below 2^31 signed and unsigned agree
    // and the check would pass while proving nothing.
    let hi: u32 = 0x80000001;
    println!("{} {} {} {} {} {} | {} {} {}",
             rt.ult(hi, 5) as u32, rt.ugt(hi, 5) as u32,
             rt.ule(hi, hi) as u32, rt.uge(5, hi) as u32,
             rt.udiv(hi, 3), rt.umod(hi, 3),
             rt.ult(5, hi) as u32, rt.udiv(100, 7), rt.umod(100, 7));
}
--java-head
    static final class Rt {}
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        int hi = 0x80000001;
        System.out.println((ult(rt, hi, 5) ? 1 : 0) + " " + (ugt(rt, hi, 5) ? 1 : 0)
            + " " + (ule(rt, hi, hi) ? 1 : 0) + " " + (uge(rt, 5, hi) ? 1 : 0)
            + " " + (udiv(rt, hi, 3) & 0xFFFFFFFFL) + " " + (umod(rt, hi, 3) & 0xFFFFFFFFL)
            + " | " + (ult(rt, 5, hi) ? 1 : 0)
            + " " + (udiv(rt, 100, 7) & 0xFFFFFFFFL) + " " + (umod(rt, 100, 7) & 0xFFFFFFFFL));
    }
--csharp-head
    internal sealed class Rt {}
--csharp
    static void Main() {
        var rt = new Rt();
        int hi = unchecked((int) 0x80000001);
        Console.WriteLine((Ult(rt, hi, 5) ? 1 : 0) + " " + (Ugt(rt, hi, 5) ? 1 : 0)
            + " " + (Ule(rt, hi, hi) ? 1 : 0) + " " + (Uge(rt, 5, hi) ? 1 : 0)
            + " " + (Udiv(rt, hi, 3) & 0xFFFFFFFFL) + " " + (Umod(rt, hi, 3) & 0xFFFFFFFFL)
            + " | " + (Ult(rt, 5, hi) ? 1 : 0)
            + " " + (Udiv(rt, 100, 7) & 0xFFFFFFFFL) + " " + (Umod(rt, 100, 7) & 0xFFFFFFFFL));
    }
--expect
0 1 1 0 715827883 0 | 1 14 2
--expect-why
DERIVED, and then found to match a claim `unsigned.kin` already makes in
prose: its header says "the three runtimes still answer
`0 1 1 0 715827883 0 | 1 14 2`". Until now nothing checked that sentence --
it was a status line about the tree, and those decay silently (`AGENTS.md`
§2). It is now the assertion.

hi = 0x80000001 = 2147483649, UNSIGNED. Signed, the same bits are
-2147483647, and that is the entire difference this file exists to pin.

  ult hi 5   2147483649 <  5            = 0   (signed: -2147483647 < 5 -> 1)
  ugt hi 5   2147483649 >  5            = 1   (signed: 0)
  ule hi hi  equal                      = 1
  uge 5 hi   5 >= 2147483649            = 0   (signed: 1)
  udiv hi 3  2147483649 / 3             = 715827883, and 3*715827883
                                          = 2147483649 exactly
  umod hi 3                             = 0
  ult 5 hi   5 < 2147483649             = 1
  udiv 100 7                            = 14
  umod 100 7                            = 2

FOUR OF THE NINE FLIP under a signed reading: fields 1, 2, 4 and 7. The last
two are the control -- both operands below 2^31, where signed and unsigned
agree -- so a failure that moved every field would be something other than
the sign, and a failure in exactly the first four is the sign.

`715827883` is the field that catches a signed DIVISION: -2147483647/3
truncates toward zero to -715827882, a different magnitude AND a different
sign, so it cannot be reached from the right answer by a formatting
difference.
