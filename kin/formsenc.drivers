    static String hexs(java.util.ArrayList<Integer> bs) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < bs.size(); i++) {
            if (i > 0) sb.append(' ');
            sb.append(String.format("%02x", bs.get(i)));
        }
        return sb.toString();
    }

    static String runVarint(Rt rt) {
        int sk = rt.sinkOpen();
        putVarint(rt, sk, 0);
        putVarint(rt, sk, 127);
        putVarint(rt, sk, 128);
        putVarint(rt, sk, 300);
        putVarint(rt, sk, 16384);
        long bv = rt.sinkBytes(sk);
        rt.sinkClose(sk);
        return hexs(rt.objs.get(vidx(bv)).bytes);
    }

    static String runForms(Rt rt, long header, java.util.ArrayList<Long> forms, long file) {
        int base = rt.mark();
        int hi = rt.push(header);
        long fv = mkVec(rt, forms, NIL);
        int fi = rt.push(fv);
        int filei = rt.push(file);
        formsEncode(rt, hi, fi, filei);
        long out = rt.r(base + 3);
        String s = hexs(rt.objs.get(vidx(out)).bytes);
        rt.popTo(base);
        return s;
    }

    static String runRead(Rt rt, long features) {
        int base = rt.mark();
        long file = Str.of(rt, "t.fln");
        rt.script = new java.util.ArrayList<>();
        rt.script.add(Val.fixnum(7));
        long out = readForms(rt, NIL, file, features, NIL, false, 0);
        String s = hexs(rt.objs.get(vidx(out)).bytes);
        rt.popTo(base);
        return s;
    }

    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder out = new StringBuilder();

        out.append("varint ").append(runVarint(rt)).append(" / ");

        long file = Str.of(rt, "t.fln");
        long m1 = metaSimple(rt, 5, 3, file);
        long sym = mkSym(rt, null, "abc", m1);
        java.util.ArrayList<Long> f1 = new java.util.ArrayList<>();
        f1.add(sym);
        long h1 = com.flint.rt.Maps.empty(rt);
        out.append("possym ").append(runForms(rt, h1, f1, file)).append(" / ");

        long mx1 = metaSimple(rt, 10, 1, file);
        long x1 = mkSym(rt, null, "x", mx1);
        long mx2 = metaSimple(rt, 4, 2, file);
        long x2 = mkSym(rt, null, "x", mx2);
        java.util.ArrayList<Long> f2 = new java.util.ArrayList<>();
        f2.add(x1); f2.add(x2);
        long h2 = com.flint.rt.Maps.empty(rt);
        out.append("zigzag ").append(runForms(rt, h2, f2, file)).append(" / ");

        long kw = mkKw(rt, "ns", "kw");
        java.util.ArrayList<Long> f3 = new java.util.ArrayList<>();
        f3.add(kw);
        long h3 = com.flint.rt.Maps.empty(rt);
        out.append("nsname ").append(runForms(rt, h3, f3, file)).append(" / ");

        long big = mkBigint(rt, 140737488355328L + 5);
        long negbig = mkBigint(rt, -(140737488355328L + 5));
        long d25 = mkDouble(rt, 2.5);
        long dnan = mkDouble(rt, Double.NaN);
        long dinf = mkDouble(rt, Double.POSITIVE_INFINITY);
        long dninf = mkDouble(rt, Double.NEGATIVE_INFINITY);
        java.util.ArrayList<Long> f4 = new java.util.ArrayList<>();
        f4.add(Val.fixnum(42)); f4.add(Val.fixnum(-17)); f4.add(big); f4.add(negbig);
        f4.add(d25); f4.add(dnan); f4.add(dinf); f4.add(dninf);
        long h4 = com.flint.rt.Maps.empty(rt);
        out.append("numbers ").append(runForms(rt, h4, f4, file)).append(" / ");

        long mp = metaSimple(rt, 2, 5, file);
        long p = mkSym(rt, null, "p", mp);
        long mq = metaSimple(rt, 3, 7, file);
        long q = mkSym(rt, null, "q", mq);
        long mvd = metaWithCp(rt, 1, 1, new long[]{2, 5, 3, 7}, file);
        java.util.ArrayList<Long> vdElems = new java.util.ArrayList<>();
        vdElems.add(p); vdElems.add(q);
        long vderived = mkVec(rt, vdElems, mvd);
        long mr = metaSimple(rt, 2, 5, file);
        long r = mkSym(rt, null, "r", mr);
        long mvf = metaWithCp(rt, 1, 1, new long[]{99, 99, 11, 11}, file);
        java.util.ArrayList<Long> vfElems = new java.util.ArrayList<>();
        vfElems.add(r); vfElems.add(Val.fixnum(300));
        long vfull = mkVec(rt, vfElems, mvf);
        java.util.ArrayList<Long> f5 = new java.util.ArrayList<>();
        f5.add(vderived); f5.add(vfull);
        long h5 = com.flint.rt.Maps.empty(rt);
        out.append("vecs ").append(runForms(rt, h5, f5, file)).append(" / ");

        long kauthor = litKeyword1(rt, "author");
        long ray = Str.of(rt, "ray");
        long mzz = metaWithExtra(rt, 9, 2, new long[][]{{kauthor, ray}}, file);
        long zz = mkSym(rt, null, "zz", mzz);
        java.util.ArrayList<Long> f6 = new java.util.ArrayList<>();
        f6.add(zz);
        long h6 = com.flint.rt.Maps.empty(rt);
        out.append("extra ").append(runForms(rt, h6, f6, file)).append(" / ");

        long other = Str.of(rt, "OTHER");
        long e7 = com.flint.rt.Maps.empty(rt);
        long kl7 = litKeyword1(rt, "line");
        long m7a = mapAssoc(rt, e7, kl7, Val.fixnum(1));
        long kc7 = litKeyword1(rt, "column");
        long m7b = mapAssoc(rt, m7a, kc7, Val.fixnum(1));
        long kf7 = litKeyword1(rt, "file");
        long badmeta = mapAssoc(rt, m7b, kf7, other);
        long bad = mkSym(rt, null, "bad", badmeta);
        java.util.ArrayList<Long> f7 = new java.util.ArrayList<>();
        f7.add(bad);
        long h7 = com.flint.rt.Maps.empty(rt);
        out.append("fallback ").append(runForms(rt, h7, f7, file)).append(" / ");

        out.append("deferred ").append(runRead(rt, NIL)).append(" / ");
        long perf = litKeyword1(rt, "perf");
        java.util.ArrayList<Long> featElems = new java.util.ArrayList<>();
        featElems.add(perf);
        long featset = mkSet(rt, featElems);
        out.append("eager ").append(runRead(rt, featset));

        System.out.println(out.toString());
    }
--java-pre
package com.flint.rt;
// `empty-map` is qualified `com.flint.rt.Maps.empty` for java (and
// `global::Flint.Rt.Maps.Empty` for C#) by the real vocabulary -- see
// `kin/src/flint/impl/rt.cljc`'s `empty-map` entry -- so the fixture needs a
// real class at that package-qualified name, which cannot live inside
// `Probe`.
//
// NOT a `Probe.Rt` reference: a class in a NAMED package cannot import, or
// even name, a type from the unnamed package at all -- there is no
// qualified form of "Probe" to write, because the unnamed package has no
// name. `public static long empty(Probe.Rt rt)` here fails to compile with
// "package Probe does not exist", which names the wrong thing (there is no
// missing package; there is a package Java will not let this one see).
// Reflection is the one route that needs no such reference: `Probe.Rt` is
// public, and so is the method it is asked for.
public class Maps {
    public static long empty(Object rt) {
        try {
            java.lang.reflect.Method m = rt.getClass().getMethod("newEmptyMapForMaps");
            return (Long) m.invoke(rt);
        } catch (ReflectiveOperationException e) {
            throw new RuntimeException(e);
        }
    }
}
--csharp-pre
namespace Flint.Rt {
    // See the Java `--java-pre` section: `empty-map` is qualified
    // `global::Flint.Rt.Maps.Empty` for C# by the real vocabulary, which
    // needs a real top-level namespace a nested class cannot provide.
    internal static class Maps {
        internal static long Empty(Probe.Rt rt) { return Probe.AllocEmptyMap(rt); }
    }
}
--csharp-head
    // A TOY HEAP, the same shape as the Rust and Java fixtures.
    internal const long NIL = unchecked((long) 0xF000000000000000UL);
    internal const long TRUE = unchecked((long) 0xF000000000000001UL);
    internal const long FALSE = unchecked((long) 0xF000000000000002UL);
    internal const long NOT_FOUND = unchecked((long) 0xF000000000000003UL);
    internal const long TAG_HEAP = 0x1L;
    internal const long TAG_DOUBLE = 0xAL;
    internal const long TAG_BIGINT = 0xBL;
    internal const long TAG_FIXNUM = 0xDL;
    internal static long Vtag(long v) { return (long) ((ulong) v >> 60); }
    internal static int Vidx(long v) { return (int) (v & 0x0FFFFFFFFFFFFFFFL); }

    internal const int TY_NODE = 1, TY_STRING = 2, TY_SYM = 3, TY_KW = 4, TY_VEC = 5, TY_LIST = 6, TY_SET = 7,
        TY_MAP = 8, TY_ENTRY = 9, TY_TAGGED = 10, TY_BYTES = 11;

    internal sealed class Obj {
        internal int Ty;
        internal System.Collections.Generic.List<long> Slots = new();
        internal string Text = "";
        internal string Ns = null;
        internal long Meta = NIL;
        internal System.Collections.Generic.List<int> Bytes = new();
    }

    internal sealed class Rt {
        internal System.Collections.Generic.List<Obj> Objs = new();
        internal System.Collections.Generic.List<long> Roots = new();
        internal System.Collections.Generic.List<long> Bigints = new();
        internal System.Collections.Generic.List<double> Doubles = new();
        internal System.Collections.Generic.List<System.Collections.Generic.List<int>> Sinks = new();
        internal System.Collections.Generic.List<long> Script = new();
        internal int ScriptPos = 0;
        internal int Mark() { return Roots.Count; }
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) { return Roots[i]; }
        internal void SetR(int i, long v) { Roots[i] = v; }
        internal void PopTo(int n) { while (Roots.Count > n) Roots.RemoveAt(Roots.Count - 1); }
        internal long Slot(long v, int i) { return Objs[Vidx(v)].Slots[i]; }
        internal int SinkOpen() { Sinks.Add(new System.Collections.Generic.List<int>()); return Sinks.Count - 1; }
        internal void SinkPut(int sk, int b) { Sinks[sk].Add(b & 0xFF); }
        internal void SinkClose(int sk) {}
        internal long SinkString(int sk) {
            byte[] bs = new byte[Sinks[sk].Count];
            for (int i = 0; i < bs.Length; i++) bs[i] = (byte) Sinks[sk][i];
            return Str.Of(this, System.Text.Encoding.UTF8.GetString(bs));
        }
        internal long SinkBytes(int sk) {
            int i = NewObj(this, TY_BYTES);
            Objs[i].Bytes = new System.Collections.Generic.List<int>(Sinks[sk]);
            return Heap(i);
        }
    }

    internal static int NewObj(Rt rt, int ty) {
        Obj o = new Obj();
        o.Ty = ty;
        rt.Objs.Add(o);
        return rt.Objs.Count - 1;
    }
    internal static long Heap(int i) { return (TAG_HEAP << 60) | (long) i; }
    internal static bool IsHeapTy(Rt rt, long v, int ty) {
        if (v == NIL || v == TRUE || v == FALSE || v == NOT_FOUND) return false;
        if (Vtag(v) != TAG_HEAP) return false;
        return rt.Objs[Vidx(v)].Ty == ty;
    }
    internal static long AllocEmptyMap(Rt rt) { return Heap(NewObj(rt, TY_MAP)); }

    internal static long Zigzag(long n) { return n < 0 ? (-2 * n) - 1 : 2 * n; }

    internal static class Val {
        internal const long Nil = Probe.NIL, True = Probe.TRUE, False = Probe.FALSE, NotFound = Probe.NOT_FOUND;
        internal static bool IsNil(long v) { return v == Nil; }
        internal static bool IsDouble(long v) { return Vtag(v) == TAG_DOUBLE; }
        internal static long Fixnum(long n) { return (TAG_FIXNUM << 60) | (n & 0x0000FFFFFFFFFFFFL); }
        internal static long AsFixnum(long v) { return (v << 16) >> 16; }
    }
    internal static class Vec { internal static long Empty(Rt rt) { return Heap(NewObj(rt, TY_VEC)); } }
    internal static class Str {
        internal static long Of(Rt rt, string s) {
            int i = NewObj(rt, TY_STRING);
            rt.Objs[i].Text = s;
            return Heap(i);
        }
    }
    internal static class Num {
        internal static double F64(Rt rt, long v) { return rt.Doubles[Vidx(v)]; }
    }

    // --- node (the encoder's own mutable scratch record) -----------------
    internal static long NewNode(Rt rt, int n, long init) {
        int i = NewObj(rt, TY_NODE);
        for (int k = 0; k < n; k++) rt.Objs[i].Slots.Add(init);
        return Heap(i);
    }
    internal static long NodeGet(Rt rt, long v, int i) { return rt.Objs[Vidx(v)].Slots[i]; }
    internal static void NodeSet(Rt rt, long v, int i, long x) { rt.Objs[Vidx(v)].Slots[i] = x; }

    // --- strings -----------------------------------------------------------
    internal static bool IsString(Rt rt, long v) { return IsHeapTy(rt, v, TY_STRING); }
    internal static int SBytes(Rt rt, long v) { return System.Text.Encoding.UTF8.GetByteCount(rt.Objs[Vidx(v)].Text); }
    internal static void SAppend(Rt rt, long v, int sk) {
        byte[] bs = System.Text.Encoding.UTF8.GetBytes(rt.Objs[Vidx(v)].Text);
        foreach (byte b in bs) rt.Sinks[sk].Add(b & 0xFF);
    }

    // --- numbers -------------------------------------------------------------
    internal static long MkBigint(Rt rt, long n) { rt.Bigints.Add(n); return (TAG_BIGINT << 60) | (long) (rt.Bigints.Count - 1); }
    internal static long MkDouble(Rt rt, double d) { rt.Doubles.Add(d); return (TAG_DOUBLE << 60) | (long) (rt.Doubles.Count - 1); }
    internal static bool IsInt(Rt rt, long v) { return Vtag(v) == TAG_FIXNUM || Vtag(v) == TAG_BIGINT; }
    internal static long IntegerValue(Rt rt, long v) { return Vtag(v) == TAG_FIXNUM ? Val.AsFixnum(v) : rt.Bigints[Vidx(v)]; }
    internal static long NumToStr(Rt rt, long v) {
        if (Val.IsDouble(v)) {
            double d = Num.F64(rt, v);
            string text = (d == 2.5) ? "2.5" : d.ToString(System.Globalization.CultureInfo.InvariantCulture);
            return Str.Of(rt, text);
        } else {
            long n = IntegerValue(rt, v);
            return Str.Of(rt, n.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
    }

    // --- symbols and keywords ----------------------------------------------
    internal static bool IsSymbol(Rt rt, long v) { return IsHeapTy(rt, v, TY_SYM); }
    internal static bool IsKeyword(Rt rt, long v) { return IsHeapTy(rt, v, TY_KW); }
    internal static long MkSym(Rt rt, string ns, string name, long meta) {
        int i = NewObj(rt, TY_SYM);
        rt.Objs[i].Text = name;
        rt.Objs[i].Ns = ns;
        rt.Objs[i].Meta = meta;
        return Heap(i);
    }
    internal static long MkKw(Rt rt, string ns, string name) {
        int i = NewObj(rt, TY_KW);
        rt.Objs[i].Text = name;
        rt.Objs[i].Ns = ns;
        return Heap(i);
    }
    internal static long LitKeyword1(Rt rt, string s) { return MkKw(rt, null, s); }
    internal static long NameOf(Rt rt, long v) { return Str.Of(rt, rt.Objs[Vidx(v)].Text); }
    internal static long NsOf(Rt rt, long v) {
        string ns = rt.Objs[Vidx(v)].Ns;
        return ns == null ? NIL : Str.Of(rt, ns);
    }

    // --- metadata ------------------------------------------------------------
    internal static long MetaOf(Rt rt, long v) {
        return Vtag(v) == TAG_HEAP ? rt.Objs[Vidx(v)].Meta : NIL;
    }

    // --- equality, ignoring a symbol's/keyword's own metadata ---------------
    internal static bool ValEq(Rt rt, long a, long b) {
        if (a == NIL || b == NIL || a == TRUE || b == TRUE || a == FALSE || b == FALSE || a == NOT_FOUND || b == NOT_FOUND) {
            return a == b;
        }
        if (IsInt(rt, a) || IsInt(rt, b)) {
            return IsInt(rt, a) && IsInt(rt, b) && IntegerValue(rt, a) == IntegerValue(rt, b);
        }
        if (Val.IsDouble(a) || Val.IsDouble(b)) {
            return Val.IsDouble(a) && Val.IsDouble(b) && Num.F64(rt, a) == Num.F64(rt, b);
        }
        if (Vtag(a) != TAG_HEAP || Vtag(b) != TAG_HEAP) return false;
        Obj oa = rt.Objs[Vidx(a)];
        Obj ob = rt.Objs[Vidx(b)];
        if (oa.Ty != ob.Ty) return false;
        switch (oa.Ty) {
            case TY_STRING: return oa.Text == ob.Text;
            case TY_SYM: case TY_KW:
                return oa.Ns == ob.Ns && oa.Text == ob.Text;
            case TY_VEC: case TY_LIST: case TY_SET: {
                if (oa.Slots.Count != ob.Slots.Count) return false;
                for (int i = 0; i < oa.Slots.Count; i++) {
                    if (!ValEq(rt, oa.Slots[i], ob.Slots[i])) return false;
                }
                return true;
            }
            case TY_MAP: {
                if (oa.Slots.Count != ob.Slots.Count) return false;
                int i = 0;
                while (i < oa.Slots.Count) {
                    long k = oa.Slots[i], v = oa.Slots[i + 1];
                    bool found = false;
                    int j = 0;
                    while (j < ob.Slots.Count) {
                        if (ValEq(rt, k, ob.Slots[j])) {
                            if (!ValEq(rt, v, ob.Slots[j + 1])) return false;
                            found = true;
                            break;
                        }
                        j += 2;
                    }
                    if (!found) return false;
                    i += 2;
                }
                return true;
            }
            default: return false;
        }
    }

    // --- maps (a flat [k0 v0 k1 v1 ..] array-map: new keys append) ---------
    internal static bool IsMap(Rt rt, long v) { return IsHeapTy(rt, v, TY_MAP); }
    internal static long MapGet(Rt rt, long m, long k, long d) {
        var slots = rt.Objs[Vidx(m)].Slots;
        int i = 0;
        while (i < slots.Count) {
            if (ValEq(rt, slots[i], k)) return slots[i + 1];
            i += 2;
        }
        return d;
    }
    internal static int MapCount(Rt rt, long m) { return rt.Objs[Vidx(m)].Slots.Count / 2; }
    internal static long MapAssoc(Rt rt, long m, long k, long v) {
        var slots = new System.Collections.Generic.List<long>(rt.Objs[Vidx(m)].Slots);
        long meta = rt.Objs[Vidx(m)].Meta;
        int i = 0;
        bool found = false;
        while (i < slots.Count) {
            if (ValEq(rt, slots[i], k)) { slots[i + 1] = v; found = true; break; }
            i += 2;
        }
        if (!found) { slots.Add(k); slots.Add(v); }
        int oi = NewObj(rt, TY_MAP);
        rt.Objs[oi].Slots = slots;
        rt.Objs[oi].Meta = meta;
        return Heap(oi);
    }
    internal static long MapEntryVector(Rt rt, long m) {
        var slots = rt.Objs[Vidx(m)].Slots;
        var entries = new System.Collections.Generic.List<long>();
        int i = 0;
        while (i < slots.Count) {
            int ei = NewObj(rt, TY_ENTRY);
            var es = new System.Collections.Generic.List<long>();
            es.Add(slots[i]);
            es.Add(slots[i + 1]);
            rt.Objs[ei].Slots = es;
            entries.Add(Heap(ei));
            i += 2;
        }
        int vi = NewObj(rt, TY_VEC);
        rt.Objs[vi].Slots = entries;
        return Heap(vi);
    }
    internal static long OrderedMap(Rt rt, long flat) {
        var elems = rt.Objs[Vidx(flat)].Slots;
        long m = global::Flint.Rt.Maps.Empty(rt);
        int i = 0;
        while (i < elems.Count) { m = MapAssoc(rt, m, elems[i], elems[i + 1]); i += 2; }
        return m;
    }
    internal static long ToTransient(Rt rt, long m) { return m; }
    internal static long TransientAssoc(Rt rt, long tm, long k, long v) { return MapAssoc(rt, tm, k, v); }
    internal static long TmapGet(Rt rt, long tm, long k, long d) { return MapGet(rt, tm, k, d); }
    internal static void Merge3(Rt rt, int ai, int bi, int ci) {
        long res = rt.R(ai);
        long bv = rt.R(bi);
        if (!Val.IsNil(bv)) {
            var slots = rt.Objs[Vidx(bv)].Slots;
            int i = 0;
            while (i < slots.Count) { res = MapAssoc(rt, res, slots[i], slots[i + 1]); i += 2; }
        }
        long cv = rt.R(ci);
        if (!Val.IsNil(cv)) {
            var slots = rt.Objs[Vidx(cv)].Slots;
            int i = 0;
            while (i < slots.Count) { res = MapAssoc(rt, res, slots[i], slots[i + 1]); i += 2; }
        }
        rt.Push(res);
    }

    // --- vectors, lists and sets --------------------------------------------
    internal static bool IsVectorLike(Rt rt, long v) { return IsHeapTy(rt, v, TY_VEC); }
    internal static bool IsSeq(Rt rt, long v) { return IsHeapTy(rt, v, TY_LIST); }
    internal static bool IsSet(Rt rt, long v) { return IsHeapTy(rt, v, TY_SET); }
    internal static bool IsTagged(Rt rt, long v) { return IsHeapTy(rt, v, TY_TAGGED); }
    internal static int VecCount(Rt rt, long v) { return rt.Objs[Vidx(v)].Slots.Count; }
    internal static long VecNth(Rt rt, long v, int i, long d) {
        var slots = rt.Objs[Vidx(v)].Slots;
        return (i < 0 || i >= slots.Count) ? d : slots[i];
    }
    internal static long VecConj(Rt rt, long v, long x) {
        var slots = new System.Collections.Generic.List<long>(rt.Objs[Vidx(v)].Slots);
        long meta = rt.Objs[Vidx(v)].Meta;
        slots.Add(x);
        int oi = NewObj(rt, TY_VEC);
        rt.Objs[oi].Slots = slots;
        rt.Objs[oi].Meta = meta;
        return Heap(oi);
    }
    internal static long VecFromRoots(Rt rt, int bse, int n) {
        var slots = new System.Collections.Generic.List<long>();
        for (int i = 0; i < n; i++) slots.Add(rt.R(bse + i));
        int oi = NewObj(rt, TY_VEC);
        rt.Objs[oi].Slots = slots;
        return Heap(oi);
    }
    internal static long MkVec(Rt rt, System.Collections.Generic.List<long> elems, long meta) {
        int oi = NewObj(rt, TY_VEC);
        rt.Objs[oi].Slots = elems;
        rt.Objs[oi].Meta = meta;
        return Heap(oi);
    }
    internal static long MkSet(Rt rt, System.Collections.Generic.List<long> elems) {
        int oi = NewObj(rt, TY_SET);
        rt.Objs[oi].Slots = elems;
        return Heap(oi);
    }
    internal static long SetElementVector(Rt rt, long v) {
        var slots = new System.Collections.Generic.List<long>(rt.Objs[Vidx(v)].Slots);
        int oi = NewObj(rt, TY_VEC);
        rt.Objs[oi].Slots = slots;
        return Heap(oi);
    }
    internal static long Seq(Rt rt, long v) {
        if (IsSeq(rt, v)) { return rt.Objs[Vidx(v)].Slots.Count == 0 ? NIL : v; }
        return NIL;
    }
    internal static long First(Rt rt, long v) { return rt.Objs[Vidx(v)].Slots[0]; }
    internal static long Next(Rt rt, long v) {
        var slots = rt.Objs[Vidx(v)].Slots;
        if (slots.Count <= 1) return NIL;
        int oi = NewObj(rt, TY_LIST);
        rt.Objs[oi].Slots = new System.Collections.Generic.List<long>(slots.GetRange(1, slots.Count - 1));
        return Heap(oi);
    }

    // --- bytes -----------------------------------------------------------------
    internal static long BConcat(Rt rt, long a, long b) {
        int oi = NewObj(rt, TY_BYTES);
        var bytes = new System.Collections.Generic.List<int>(rt.Objs[Vidx(a)].Bytes);
        bytes.AddRange(rt.Objs[Vidx(b)].Bytes);
        rt.Objs[oi].Bytes = bytes;
        return Heap(oi);
    }

    // --- the mocked reader: `ReadTop` hands back the scripted forms, one per
    // call, pushing each as a side effect the way the real reader does. ----
    internal static long RdNew(Rt rt, long src, long file, long features, long tags, bool portable, long gensym0) {
        rt.ScriptPos = 0;
        return NIL;
    }
    internal static void RdClose(Rt rt, int sti) {}
    internal static long RdGet(Rt rt, int sti, int domain) { return NIL; }
    internal static long RdInt(Rt rt, int sti, int domain) { return 0; }
    internal static bool RdFlag(Rt rt, int sti, int domain) { return false; }
    internal static int ReadTop(Rt rt, int sti) {
        if (rt.ScriptPos < rt.Script.Count) {
            long f = rt.Script[rt.ScriptPos];
            rt.ScriptPos++;
            rt.Push(f);
            return RsOk;
        }
        return RsEof;
    }
    internal static void MsgLit(Rt rt, int sk, string s) {
        byte[] bs = System.Text.Encoding.UTF8.GetBytes(s);
        foreach (byte b in bs) rt.Sinks[sk].Add(b & 0xFF);
    }
    internal static void MsgVal(Rt rt, int sk, long v) {}
    internal static void MsgInt(Rt rt, int sk, long n) {}

    // --- test-only helpers: metadata maps in the order THIS file's own
    // MapAssoc/Merge3 rebuild them (line, column, file, [child-pos]) -- and
    // the extra case (line, column, file, [extra keys..]). -------------------
    internal static long MetaSimple(Rt rt, long line, long col, long file) {
        long e = global::Flint.Rt.Maps.Empty(rt);
        long kl = LitKeyword1(rt, "line");
        long m1 = MapAssoc(rt, e, kl, Val.Fixnum(line));
        long kc = LitKeyword1(rt, "column");
        long m2 = MapAssoc(rt, m1, kc, Val.Fixnum(col));
        long kf = LitKeyword1(rt, "file");
        return MapAssoc(rt, m2, kf, file);
    }
    internal static long MetaWithCp(Rt rt, long line, long col, long[] cp, long file) {
        long m = MetaSimple(rt, line, col, file);
        long kcp = LitKeyword1(rt, "child-pos");
        var cpvals = new System.Collections.Generic.List<long>();
        foreach (long n in cp) cpvals.Add(Val.Fixnum(n));
        long cpv = MkVec(rt, cpvals, NIL);
        return MapAssoc(rt, m, kcp, cpv);
    }
    internal static long MetaWithExtra(Rt rt, long line, long col, long[][] extra, long file) {
        long m = MetaSimple(rt, line, col, file);
        foreach (long[] kv in extra) m = MapAssoc(rt, m, kv[0], kv[1]);
        return m;
    }

    // --- the constants `kin/readconst.kin` declares, mirrored exactly ------
    internal const int RdsDefer = 10;
    internal const int RdsConds = 11;
    internal const int RdsErrmsg = 17;
    internal const int RdsErrline = 18;
    internal const int RdsErrcol = 19;
    internal const int RdsErrplain = 20;
    internal const int RsOk = 0;
    internal const int RsEof = 1;
    internal const int RsErr = 4;
    internal const int FtNil = 0;
    internal const int FtTrue = 1;
    internal const int FtFalse = 2;
    internal const int FtInt = 3;
    internal const int FtNeg = 4;
    internal const int FtNum = 5;
    internal const int FtStr = 6;
    internal const int FtName = 7;
    internal const int FtList = 8;
    internal const int FtVec = 9;
    internal const int FtMap = 10;
    internal const int FtSet = 11;
    internal const int FtTagged = 12;
    internal const int FtMeta = 13;
    internal const int FtPos = 14;
    internal const int FtPosSym = 15;
    internal const int FfCpDerived = 1;
    internal const int FfCpFull = 2;
    internal const int FfExtra = 4;
    internal const int FnSym = 0;
    internal const int FnSymNs = 1;
    internal const int FnKw = 2;
    internal const int FnKwNs = 3;
    internal const long VarintLimit = 140737488355328L;
    internal const int FeBody = 0;
    internal const int FeFile = 1;
    internal const int FeLine = 2;
    internal const int FeStrs = 3;
    internal const int FeStrxs = 4;
    internal const int FeNames = 5;
    internal const int FeNamexs = 6;
