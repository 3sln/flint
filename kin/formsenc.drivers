--csharp
    internal static string Hexs(System.Collections.Generic.List<int> bs) {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < bs.Count; i++) {
            if (i > 0) sb.Append(' ');
            sb.Append(bs[i].ToString("x2"));
        }
        return sb.ToString();
    }

    internal static string RunVarint(Rt rt) {
        int sk = rt.SinkOpen();
        PutVarint(rt, sk, 0);
        PutVarint(rt, sk, 127);
        PutVarint(rt, sk, 128);
        PutVarint(rt, sk, 300);
        PutVarint(rt, sk, 16384);
        long bv = rt.SinkBytes(sk);
        rt.SinkClose(sk);
        return Hexs(rt.Objs[Vidx(bv)].Bytes);
    }

    internal static string RunForms(Rt rt, long header, System.Collections.Generic.List<long> forms, long file) {
        int bse = rt.Mark();
        int hi = rt.Push(header);
        long fv = MkVec(rt, forms, NIL);
        int fi = rt.Push(fv);
        int filei = rt.Push(file);
        FormsEncode(rt, hi, fi, filei);
        long outv = rt.R(bse + 3);
        string s = Hexs(rt.Objs[Vidx(outv)].Bytes);
        rt.PopTo(bse);
        return s;
    }

    internal static string RunRead(Rt rt, long features) {
        int bse = rt.Mark();
        long file = Str.Of(rt, "t.fln");
        rt.Script = new System.Collections.Generic.List<long>();
        rt.Script.Add(Val.Fixnum(7));
        long outv = ReadForms(rt, NIL, file, features, NIL, false, 0);
        string s = Hexs(rt.Objs[Vidx(outv)].Bytes);
        rt.PopTo(bse);
        return s;
    }

    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();

        o.Append("varint ").Append(RunVarint(rt)).Append(" / ");

        long file = Str.Of(rt, "t.fln");
        long m1 = MetaSimple(rt, 5, 3, file);
        long sym = MkSym(rt, null, "abc", m1);
        var f1 = new System.Collections.Generic.List<long>();
        f1.Add(sym);
        long h1 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("possym ").Append(RunForms(rt, h1, f1, file)).Append(" / ");

        long mx1 = MetaSimple(rt, 10, 1, file);
        long x1 = MkSym(rt, null, "x", mx1);
        long mx2 = MetaSimple(rt, 4, 2, file);
        long x2 = MkSym(rt, null, "x", mx2);
        var f2 = new System.Collections.Generic.List<long>();
        f2.Add(x1); f2.Add(x2);
        long h2 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("zigzag ").Append(RunForms(rt, h2, f2, file)).Append(" / ");

        long kw = MkKw(rt, "ns", "kw");
        var f3 = new System.Collections.Generic.List<long>();
        f3.Add(kw);
        long h3 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("nsname ").Append(RunForms(rt, h3, f3, file)).Append(" / ");

        long big = MkBigint(rt, 140737488355328L + 5);
        long negbig = MkBigint(rt, -(140737488355328L + 5));
        long d25 = MkDouble(rt, 2.5);
        long dnan = MkDouble(rt, double.NaN);
        long dinf = MkDouble(rt, double.PositiveInfinity);
        long dninf = MkDouble(rt, double.NegativeInfinity);
        var f4 = new System.Collections.Generic.List<long>();
        f4.Add(Val.Fixnum(42)); f4.Add(Val.Fixnum(-17)); f4.Add(big); f4.Add(negbig);
        f4.Add(d25); f4.Add(dnan); f4.Add(dinf); f4.Add(dninf);
        long h4 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("numbers ").Append(RunForms(rt, h4, f4, file)).Append(" / ");

        long mp = MetaSimple(rt, 2, 5, file);
        long p = MkSym(rt, null, "p", mp);
        long mq = MetaSimple(rt, 3, 7, file);
        long q = MkSym(rt, null, "q", mq);
        long mvd = MetaWithCp(rt, 1, 1, new long[]{2, 5, 3, 7}, file);
        var vdElems = new System.Collections.Generic.List<long>();
        vdElems.Add(p); vdElems.Add(q);
        long vderived = MkVec(rt, vdElems, mvd);
        long mr = MetaSimple(rt, 2, 5, file);
        long r = MkSym(rt, null, "r", mr);
        long mvf = MetaWithCp(rt, 1, 1, new long[]{99, 99, 11, 11}, file);
        var vfElems = new System.Collections.Generic.List<long>();
        vfElems.Add(r); vfElems.Add(Val.Fixnum(300));
        long vfull = MkVec(rt, vfElems, mvf);
        var f5 = new System.Collections.Generic.List<long>();
        f5.Add(vderived); f5.Add(vfull);
        long h5 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("vecs ").Append(RunForms(rt, h5, f5, file)).Append(" / ");

        long kauthor = LitKeyword1(rt, "author");
        long ray = Str.Of(rt, "ray");
        long mzz = MetaWithExtra(rt, 9, 2, new long[][]{new long[]{kauthor, ray}}, file);
        long zz = MkSym(rt, null, "zz", mzz);
        var f6 = new System.Collections.Generic.List<long>();
        f6.Add(zz);
        long h6 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("extra ").Append(RunForms(rt, h6, f6, file)).Append(" / ");

        long other = Str.Of(rt, "OTHER");
        long e7 = global::Flint.Rt.Maps.Empty(rt);
        long kl7 = LitKeyword1(rt, "line");
        long m7a = MapAssoc(rt, e7, kl7, Val.Fixnum(1));
        long kc7 = LitKeyword1(rt, "column");
        long m7b = MapAssoc(rt, m7a, kc7, Val.Fixnum(1));
        long kf7 = LitKeyword1(rt, "file");
        long badmeta = MapAssoc(rt, m7b, kf7, other);
        long bad = MkSym(rt, null, "bad", badmeta);
        var f7 = new System.Collections.Generic.List<long>();
        f7.Add(bad);
        long h7 = global::Flint.Rt.Maps.Empty(rt);
        o.Append("fallback ").Append(RunForms(rt, h7, f7, file)).Append(" / ");

        o.Append("deferred ").Append(RunRead(rt, NIL)).Append(" / ");
        long perf = LitKeyword1(rt, "perf");
        var featElems = new System.Collections.Generic.List<long>();
        featElems.Add(perf);
        long featset = MkSet(rt, featElems);
        o.Append("eager ").Append(RunRead(rt, featset));

        System.Console.WriteLine(o.ToString());
    }
--expect
varint 00 7f 80 01 ac 02 80 80 01 / possym 46 4c 46 31 01 03 61 62 63 01 00 00 0a 00 01 0f 08 03 00 / zigzag 46 4c 46 31 01 01 78 01 00 00 0a 00 02 0f 12 01 00 0f 0b 02 00 / nsname 46 4c 46 31 02 02 6e 73 02 6b 77 01 03 00 01 0a 00 01 07 00 / numbers 46 4c 46 31 06 0f 31 34 30 37 33 37 34 38 38 33 35 35 33 33 33 10 2d 31 34 30 37 33 37 34 38 38 33 35 35 33 33 33 03 32 2e 35 05 23 23 4e 61 4e 05 23 23 49 6e 66 06 23 23 2d 49 6e 66 00 0a 00 08 03 2a 04 11 05 00 05 01 05 02 05 03 05 04 05 05 / vecs 46 4c 46 31 03 01 70 01 71 01 72 03 00 00 00 01 00 02 0a 00 02 0e 00 01 01 09 02 0f 02 05 00 0f 02 07 01 0e 03 01 02 09 02 0f 02 05 02 03 ac 02 02 c4 01 63 14 0b / extra 46 4c 46 31 03 03 72 61 79 06 61 75 74 68 6f 72 02 7a 7a 02 02 01 00 02 0a 00 01 0e 10 02 04 01 07 00 06 00 07 01 / fallback 46 4c 46 31 05 05 4f 54 48 45 52 04 6c 69 6e 65 06 63 6f 6c 75 6d 6e 04 66 69 6c 65 03 62 61 64 04 02 01 02 02 02 03 00 04 0a 00 01 0d 0a 03 07 00 03 01 07 01 03 01 07 02 06 00 07 03 / deferred 46 4c 46 31 09 05 74 2e 66 6c 6e 04 6f 70 74 73 04 66 69 6c 65 08 66 65 61 74 75 72 65 73 03 61 6e 79 04 74 61 67 73 07 64 69 61 6c 65 63 74 05 66 6c 69 6e 74 05 63 6f 6e 64 73 08 02 01 02 02 02 03 02 04 02 05 02 06 02 07 02 08 0a 02 07 00 0a 04 07 01 06 00 07 02 07 03 07 04 00 07 05 07 06 07 07 09 00 01 03 07 / eager 46 4c 46 31 09 05 74 2e 66 6c 6e 04 6f 70 74 73 04 66 69 6c 65 08 66 65 61 74 75 72 65 73 04 70 65 72 66 04 74 61 67 73 07 64 69 61 6c 65 63 74 05 66 6c 69 6e 74 05 63 6f 6e 64 73 08 02 01 02 02 02 03 02 04 02 05 02 06 02 07 02 08 0a 02 07 00 0a 04 07 01 06 00 07 02 0b 01 07 03 07 04 00 07 05 07 06 07 07 09 00 01 03 07
--expect-why
DERIVED FROM THE FORMAT (`src/flint/forms.cljc`, mirrored by this file), by
hand-assembling each byte and cross-checking with an independent Python
re-implementation of `put-bare`/`put-value`/`pos-parts`/`derivable?` (not
committed; this is the method, not the artefact) before transcribing. Every
line is `FLF1` + string table + name table + body, in that order, over a
header that is always the same two cases asked about directly:

  varint     `put-varint` of 0,127,128,300,16384: 00; 7f; 80 01 (128 =
             0*128+128 continuation, then 1); ac 02 (300 = 44+128, then 2);
             80 80 01 (16384 = 128*128). Pins the 128-boundary both ways.

  possym     one symbol `abc` at line 5 col 3, no child-pos, no extra: the
             T_POS_SYM(15) fast path. Line delta from FE_LINE's start (1) is
             zigzag(4)=8; interning "abc" is the string table's only entry.

  zigzag     symbol `x` at (10,1) then again at (4,2): the SAME name reused
             (index 0 both times, one string-table entry) and the delta
             going UP (zigzag(9)=18) then DOWN (zigzag(-6)=11).

  nsname     a bare namespaced keyword `ns/kw`, no position: FT_NAME(7), and
             the name table resolves it to TWO strings, namespace then name
             (`FN_KW_NS`=3, then the "ns" index, then the "kw" index).

  numbers    42 (FT_INT), -17 (FT_NEG), 2^47+5 and -(2^47+5) (both past
             VARINT_LIMIT, so FT_NUM text -- plain decimal, which every
             host's integer-to-string already agrees on), 2.5 (FT_NUM text,
             hardcoded by this file's own `num-to-str` mock rather than
             formatted, so no language's float printer can disagree), then
             NaN, +Inf, -Inf (FT_NUM text "##NaN"/"##Inf"/"##-Inf" -- these
             never reach `num-to-str` at all, `put-num-text` special-cases
             them first). Five new strings, in that order.

  vecs       two forms. First a 2-element vector at (1,1) whose child-pos
             is `[2 5 3 7]` and whose children `p`,`q` carry exactly those
             positions themselves -- `derivable?` is true, so the flag is
             F_CP_DERIVED(1) and NOTHING further is written for the child
             positions (both are recovered from the children's own T_POS_SYM
             encoding). Second, a vector at (1,1) whose first child `r` has
             its OWN position (2,5) but the vector's child-pos says (99,99)
             for it -- a MISMATCH, so `derivable?` is false, flag is
             F_CP_FULL(2), and the full pair list is written after the
             children: quot(4,2)=2 pairs, each `zigzag(line-1)` then column.

  extra      symbol `zz` at (9,2) with one extra metadata key `:author
             "ray"`, no child-pos: flag is F_EXTRA(4) alone, the pair count
             is 1, then the key (interned as a name) and the string "ray".

  fallback   symbol `bad` whose recorded `:file` is `"OTHER"`, not the file
             `forms-encode` was called with -- `pos-parts`'s file check
             fails first, so this is T_META(13): the metadata map itself
             (three entries, :line/:column/:file, each key a freshly
             interned name) written as an ordinary value, then the bare
             symbol.

  deferred/eager  `read-forms` end to end, through a mocked `read-top` that
             hands back one scripted form (the int 7) and then RS_EOF, as
             the task asks. `deferred` passes `features` nil, so the opts
             map's `:features` is the keyword `:any`; `eager` passes a
             one-element set `#{:perf}`, so it is that set, FT_SET(11) with
             one FT_NAME element. Everything else -- the opts map's key
             order (file, features, tags, dialect), the header's (opts,
             conds), and conds staying an empty vector since the mocked
             reader never sets `RDS_DEFER` -- is identical between the two,
             which is what makes the diff legible as exactly the one key.

THE MAP ORDER THIS FILE RELIES ON: `map-assoc` here always APPENDS a new
key at the end and leaves an existing one in place (array-map/insertion
order), and `merge3` folds `b` then `c` into `a` the same way. That is a
choice this fixture makes once, not a guess at the real runtime's CHAMP
order -- `forms-encode`'s own `cp-first?` probe (lines 584-622 of the kin
source) asks ITS OWN runtime the same question the real encoder asks of
ITS, and under this fixture's map it comes back false (`:child-pos` lands
AFTER `:file`), which is why every `push-literal` above writes the column
before the child-pos pair. `pos-parts`'s own rebuild-and-compare is what
makes this self-consistent regardless of which order wins.
