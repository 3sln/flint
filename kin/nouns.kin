;; `describe`: what a value IS, in the words an error message uses.
;;
;; RUST DID NOT HAVE THIS AT ALL. Both ports carried it and Rust carried only
;; `throw_str(&str, &str)`, so every message Rust raised about a value was
;; written without naming the value -- `seq` over the wrong thing said "seq
;; over this type needs more of the data structures" where the ports said "seq
;; over a keyword ...". That is not a message being terser on one runtime. It
;; is the runtimes disagreeing about what a program is told, and `conform`
;; cannot see it because it diffs ANSWERS and an exception's message is not
;; one.
;;
;; So the ports are the reference here, as they were for `seq` refusing rather
;; than answering nil: where two agree against one, and the two are the ones
;; matching Clojure, the one converges.
;;
;; NO `case`. Thirty-odd arms and this is written as a chain of `if`s, because
;; hole 3 is still open and because the chain costs nothing here: these are
;; compared in the order a value is most likely to be, and the arms after the
;; heap check are mutually exclusive so an early `return` leaves nothing to
;; fall through to.
;; THE NAMESPACE IS `nouns` AND THE FUNCTION IS `describe`, which looks like a
;; mismatch and is a C# rule: a member cannot share its enclosing type's name,
;; so a namespace `flint.rt.describe` emits `static class Describe { string
;; Describe(...) }` and CS0542 refuses it. The function name is the one with
;; forty call sites across three runtimes, so the namespace is the one that
;; moved. `nouns` is what the file produces -- the noun phrase an error message
;; needs.
(ns flint.rt.nouns
  (:require [flint.impl.rt :refer [defn return if let comment doc
                                   not == nil? is-heap is-fixnum is-double
                                   is-inline-str is-inline-kw as-heap ty
                                   static-text own-text text-empty str-cat
                                   Rt Value Ty Text StaticText TRUE FALSE
                                   TY_STR TY_SYM TY_KW TY_CONS TY_EMPTY_LIST
                                   TY_LAZYSEQ TY_VEC TY_VECSEQ TY_RANGE
                                   TY_ARRAYMAP TY_HASHMAP TY_SET TY_MAPENTRY
                                   TY_CLOSURE TY_NATIVEFN TY_TVEC TY_TMAP
                                   TY_TSET TY_ROPE TY_BYTES TY_RECORD TY_ATOM
                                   TY_VAR TY_DELAY TY_REGEX TY_MULTIFN
                                   TY_REDUCED TY_EXINFO]]))

(doc "The literal noun phrase for `v`, or the empty one when there is none."
     ""
     "BORROWED, not built. Every answer here is a string literal, which is a"
     "`&'"'"'static str` in Rust and already a `String` in both ports, so naming"
     "one costs nothing anywhere -- the conversion happens once, in `describe`."
     ""
     "The empty answer means `no literal fits`, which only a heap value with a"
     "tag this function does not know can produce.")
(defn ^:method ^StaticText describe-literal [^Rt rt ^Value v]
  (if (nil? rt v) (return (static-text "nil")))
  (if (is-fixnum rt v) (return (static-text "an integer")))
  (if (is-double rt v) (return (static-text "a double")))
  (if (== v TRUE) (return (static-text "a boolean")))
  (if (== v FALSE) (return (static-text "a boolean")))
  (if (is-inline-str rt v) (return (static-text "a string")))
  (if (is-inline-kw rt v) (return (static-text "a keyword")))
  (if (not (is-heap v)) (return (static-text "an unknown immediate")))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_STR) (return (static-text "a string")))
    (if (== t TY_SYM) (return (static-text "a symbol")))
    (if (== t TY_KW) (return (static-text "a keyword")))
    (if (== t TY_CONS) (return (static-text "a list")))
    (if (== t TY_EMPTY_LIST) (return (static-text "an empty list")))
    (if (== t TY_LAZYSEQ) (return (static-text "a lazy seq")))
    (if (== t TY_VEC) (return (static-text "a vector")))
    (if (== t TY_VECSEQ) (return (static-text "a vector seq")))
    (if (== t TY_RANGE) (return (static-text "a range")))
    (if (== t TY_ARRAYMAP) (return (static-text "an array-map")))
    (if (== t TY_HASHMAP) (return (static-text "a hash-map")))
    (if (== t TY_SET) (return (static-text "a set")))
    (if (== t TY_MAPENTRY) (return (static-text "a map entry")))
    (if (== t TY_CLOSURE) (return (static-text "a function")))
    (if (== t TY_NATIVEFN) (return (static-text "a builtin")))
    (if (== t TY_TVEC) (return (static-text "a transient vector")))
    (if (== t TY_TMAP) (return (static-text "a transient map")))
    (if (== t TY_TSET) (return (static-text "a transient set")))
    (if (== t TY_ROPE) (return (static-text "a rope")))
    (if (== t TY_BYTES) (return (static-text "a byte string")))
    (if (== t TY_RECORD) (return (static-text "a record")))
    (if (== t TY_ATOM) (return (static-text "an atom")))
    (if (== t TY_VAR) (return (static-text "a var")))
    (if (== t TY_DELAY) (return (static-text "a delay")))
    (if (== t TY_REGEX) (return (static-text "a regex")))
    (if (== t TY_MULTIFN) (return (static-text "a multimethod")))
    (if (== t TY_REDUCED) (return (static-text "a reduced")))
    (if (== t TY_EXINFO) (return (static-text "an ex-info")))
    (comment "NO LITERAL FOR THIS ONE, which is the single case that has to"
             "BUILD a string. Answering the empty literal says so without"
             "needing an `Option`, and the empty string is not a noun phrase"
             "any other arm could return.")
    (return (static-text ""))))

(doc "What `v` is, as the noun phrase an error message needs."
     ""
     "`\"a keyword\"`, `\"an empty list\"` -- with the article, because every"
     "call site reads `\"seq over \" + describe(v) + \" ...\"` and an article"
     "chosen at the call site would have to know what the noun begins with."
     ""
     "ONE ALLOCATION, AND USUALLY NONE OF THE STRING. Forty of the forty-one"
     "answers are literals, so they are borrowed and converted once here rather"
     "than each built where it is named -- in Rust that is one `String::from`"
     "instead of forty, and in both ports it is nothing at all, because a"
     "literal there is already the type this returns."
     ""
     "THE TIER IS INVISIBLE, as it is everywhere else. An inline string and a"
     "heap string are both `\"a string\"`, and an inline keyword and a heap one"
     "are both `\"a keyword\"` -- these used to say `\"an inline keyword\"`, which"
     "tells a reader about a representation they cannot see from the language"
     "and cannot act on. `doc/decisions/0011` makes the tiers invisible to"
     "every other operation; an error message is not the place to leak them."
     ""
     "The last arm names the NUMBER of a tag it does not know. A tag added to"
     "one runtime and not to this function still produces something a person"
     "can act on, which is the only arm here that could ever be reached by a"
     "correct program and the reason it builds a string instead of refusing.")
(defn ^:pub ^:method ^Text describe [^Rt rt ^Value v]
  (let [^StaticText lit (describe-literal rt v)]
    (if (not (text-empty rt lit))
      (return (own-text lit)))
    (comment "HOLE 5's one live use in this file: `str-cat` is variadic, so its"
             "Rust side constructs the format string from the argument count,"
             "which no template can do.")
    (return (str-cat "object type " (ty rt (as-heap v))))))
