;; `describe`: what a value IS, in the words an error message uses.
;;
;; RUST DID NOT HAVE THIS AT ALL. Both ports carried it and Rust carried only
;; `throw_str(&str, &str)`, so every message Rust raised about a value was
;; written without naming the value -- `seq` over the wrong thing said "seq
;; over this type needs more of the data structures" where the ports said "seq
;; over a keyword ...". That is not a message being terser on one runtime. It
;; is the runtimes disagreeing about what a program is told, and `conform`
;; cannot see it because it diffs ANSWERS and an exception's message is not
;; one.
;;
;; So the ports are the reference here, as they were for `seq` refusing rather
;; than answering nil: where two agree against one, and the two are the ones
;; matching Clojure, the one converges.
;;
;; NO `case`. Thirty-odd arms and this is written as a chain of `if`s, because
;; hole 3 is still open and because the chain costs nothing here: these are
;; compared in the order a value is most likely to be, and the arms after the
;; heap check are mutually exclusive so an early `return` leaves nothing to
;; fall through to.
;; THE NAMESPACE IS `nouns` AND THE FUNCTION IS `describe`, which looks like a
;; mismatch and is a C# rule: a member cannot share its enclosing type's name,
;; so a namespace `flint.rt.describe` emits `static class Describe { string
;; Describe(...) }` and CS0542 refuses it. The function name is the one with
;; forty call sites across three runtimes, so the namespace is the one that
;; moved. `nouns` is what the file produces -- the noun phrase an error message
;; needs.
(ns flint.rt.nouns
  (:require [flint.impl.rt :refer [defn return if let comment doc
                                   not == nil? is-heap is-fixnum is-double
                                   is-inline-str is-inline-kw as-heap ty
                                   text str-cat
                                   Rt Value Ty Text TRUE FALSE
                                   TY_STR TY_SYM TY_KW TY_CONS TY_EMPTY_LIST
                                   TY_LAZYSEQ TY_VEC TY_VECSEQ TY_RANGE
                                   TY_ARRAYMAP TY_HASHMAP TY_SET TY_MAPENTRY
                                   TY_CLOSURE TY_NATIVEFN TY_TVEC TY_TMAP
                                   TY_TSET TY_ROPE TY_BYTES TY_RECORD TY_ATOM
                                   TY_VAR TY_DELAY TY_REGEX TY_MULTIFN
                                   TY_REDUCED TY_EXINFO]]))

(doc "What `v` is, as the noun phrase an error message needs."
     ""
     "`\"a keyword\"`, `\"an empty list\"` -- with the article, because every"
     "call site reads `\"seq over \" + describe(v) + \" ...\"` and an article"
     "chosen at the call site would have to know what the noun begins with."
     ""
     "The last arm names the NUMBER of a tag it does not know. A tag added to"
     "one runtime and not to this function still produces something a person"
     "can act on, which is the only arm here that could ever be reached by a"
     "correct program and the reason it builds a string instead of refusing.")
(defn ^:pub ^:method ^Text describe [^Rt rt ^Value v]
  (if (nil? rt v) (return (text "nil")))
  (if (is-fixnum rt v) (return (text "an integer")))
  (if (is-double rt v) (return (text "a double")))
  (if (== v TRUE) (return (text "a boolean")))
  (if (== v FALSE) (return (text "a boolean")))
  (if (is-inline-str rt v) (return (text "an inline string")))
  (if (is-inline-kw rt v) (return (text "an inline keyword")))
  (if (not (is-heap v)) (return (text "an unknown immediate")))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_STR) (return (text "a string")))
    (if (== t TY_SYM) (return (text "a symbol")))
    (if (== t TY_KW) (return (text "a keyword")))
    (if (== t TY_CONS) (return (text "a list")))
    (if (== t TY_EMPTY_LIST) (return (text "an empty list")))
    (if (== t TY_LAZYSEQ) (return (text "a lazy seq")))
    (if (== t TY_VEC) (return (text "a vector")))
    (if (== t TY_VECSEQ) (return (text "a vector seq")))
    (if (== t TY_RANGE) (return (text "a range")))
    (if (== t TY_ARRAYMAP) (return (text "an array-map")))
    (if (== t TY_HASHMAP) (return (text "a hash-map")))
    (if (== t TY_SET) (return (text "a set")))
    (if (== t TY_MAPENTRY) (return (text "a map entry")))
    (if (== t TY_CLOSURE) (return (text "a function")))
    (if (== t TY_NATIVEFN) (return (text "a builtin")))
    (if (== t TY_TVEC) (return (text "a transient vector")))
    (if (== t TY_TMAP) (return (text "a transient map")))
    (if (== t TY_TSET) (return (text "a transient set")))
    (if (== t TY_ROPE) (return (text "a rope")))
    (if (== t TY_BYTES) (return (text "a byte string")))
    (if (== t TY_RECORD) (return (text "a record")))
    (if (== t TY_ATOM) (return (text "an atom")))
    (if (== t TY_VAR) (return (text "a var")))
    (if (== t TY_DELAY) (return (text "a delay")))
    (if (== t TY_REGEX) (return (text "a regex")))
    (if (== t TY_MULTIFN) (return (text "a multimethod")))
    (if (== t TY_REDUCED) (return (text "a reduced")))
    (if (== t TY_EXINFO) (return (text "an ex-info")))
    (comment "THE ONLY ARM THAT BUILDS. Hole 5, and the reason this file is"
             "the one that closes it: `str-cat` is variadic, so its Rust side"
             "constructs the format string from the argument count -- which no"
             "template can do, and which is all hole 5 ever was.")
    (return (str-cat "object type " t))))
