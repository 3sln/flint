type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const AM_BASE: u32 = 2; const AM_META: u32 = 0; const AM_HASH: u32 = 1;
const HM_CNT: u32 = 0; const HM_ROOT: u32 = 1; const HM_META: u32 = 2; const HM_HASH: u32 = 3;
const TY_ARRAYMAP: u8 = 14; const TY_HASHMAP: u8 = 15;
const TY_CONS: u8 = 1; const TY_EMPTY_LIST: u8 = 7; const TY_LAZYSEQ: u8 = 3;
const TY_VECSEQ: u8 = 11; const TY_STRSEQ: u8 = 12; const TY_RANGE: u8 = 13;
const TY_VEC: u8 = 6; const TY_SET: u8 = 16;
const C_FIRST: u32 = 0; const C_REST: u32 = 1; const C_META: u32 = 2; const C_COUNT: u32 = 3;
const TY_TABLEREF: u8 = 50;
mod table { pub const RF_SCHEMA: u32 = 0; } const TY_MAPENTRY: u8 = 20;
impl Value {
    // NIL is 0xFFFF and must NOT read as a heap value -- it does not in the
    // real runtime, and a fixture that says otherwise sends `is_seq(NIL)`
    // off the end of the type array.
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    // A FIXNUM in the fixture is anything below the heap floor and not
    // NIL, which is all `count_hint` needs to discriminate.
    fn is_fixnum(self) -> bool { self.0 < 100 && self.0 != NIL.0 }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    // `list-from-roots` builds onto one. Same shape as `seqwalk.drivers`'
    // stub, because the two probes have to agree about what a list IS.
    fn empty_list(&mut self) -> Value {
        let a = self.alloc(TY_EMPTY_LIST, 1);
        Value::heap(a)
    }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        // NIL-FILLED, as the real allocator does (`gc.zero_body` fills value
        // slots with NIL). Leaving them at 0 makes "this slot is absent" read
        // as present, because NIL is 0xFFFF -- and every target agrees on the
        // wrong answer, which is the one failure a three-way comparison cannot
        // catch. It hid `vec_pop`'s level collapse entirely.
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, n: Value) -> u32 { self.lens[n.0 as usize] }
    // A ref's schema is one slot away and its length is the column count.
    fn schema_len(&self, s: Value) -> u32 { self.h[s.0 as usize] as u32 }
    fn vec_count(&self, v: Value) -> u32 { self.h[v.0 as usize] as u32 }
}
// `ty` answers a u8 in the real runtime; the fixture says so too, because
// a driver that widens it compiles here and does not compile there.
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn mk_range(rt: &mut Rt, s: u64, e: u64, st: u64) -> Value {
    let a = rt.alloc(TY_RANGE, 4);
    rt.h[a as usize] = s; rt.h[a as usize + 1] = e; rt.h[a as usize + 2] = st;
    Value::heap(a)
}
fn main() {
    let mut rt = Rt { h: vec![0; 4000], gc: Gc { sp: vec![0u8; 4000] }, lens: vec![0; 4000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();

    // count_hint over every case it answers, and one it does not.
    let el = { let a = rt.alloc(TY_EMPTY_LIST, 1); Value::heap(a) };
    let vv = { let a = rt.alloc(TY_VEC, 6); rt.h[a as usize] = 7; Value::heap(a) };
    let lz = { let a = rt.alloc(TY_LAZYSEQ, 2); Value::heap(a) };
    // `is_seq` over each tag it accepts and two it does not.
    let am = { let a = rt.alloc(TY_ARRAYMAP, 4); Value::heap(a) };
    let cn = { let a = rt.alloc(TY_CONS, 4); Value::heap(a) };
    let rg = { let a = rt.alloc(TY_RANGE, 4); Value::heap(a) };
    o.push_str(&format!("seq={}{}{}{}{} ",
        rt.is_seq(cn) as u32, rt.is_seq(rg) as u32,
        rt.is_seq(Value(5)) as u32, rt.is_seq(am) as u32, rt.is_seq(NIL) as u32));

    o.push_str(&format!("hnil={} hel={} hvec={} hlazy={} ",
        rt.count_hint(NIL).0, rt.count_hint(el).0,
        rt.count_hint(vv).0, rt.count_hint(lz).0));

    // A RANGE COUNTS WITHOUT WALKING. The mock's fixnums are the values below
    // the heap floor, so these are small on purpose -- and a NEGATIVE step
    // cannot be spelled here, which is why `lang.seqs` asks the descending
    // case of the real runtime instead.
    let r10 = mk_range(&mut rt, 0, 10, 1);
    let r4 = mk_range(&mut rt, 0, 10, 3);
    let rempty = mk_range(&mut rt, 5, 5, 1);
    let rzero = mk_range(&mut rt, 0, 10, 0);
    let runb = mk_range(&mut rt, 0, NIL.0, 1);
    o.push_str(&format!("rng={},{},{},{},{} ",
        rt.count_hint(r10).0, rt.count_hint(r4).0, rt.count_hint(rempty).0,
        rt.count_hint(rzero).0, rt.count_hint(runb).0));

    // cons onto a counted tail keeps counting; onto an uncounted one stops.
    let c1 = rt.cons(Value(11), el);
    let c2 = rt.cons(Value(12), c1);
    let c3 = rt.cons(Value(13), c2);
    o.push_str(&format!("counts={},{},{} ",
        rt.slot(c1, C_COUNT).0, rt.slot(c2, C_COUNT).0, rt.slot(c3, C_COUNT).0));
    o.push_str(&format!("firsts={},{},{} ",
        rt.slot(c3, C_FIRST).0, rt.slot(c2, C_FIRST).0, rt.slot(c1, C_FIRST).0));
    o.push_str(&format!("restis={} meta={} ",
        (rt.slot(c3, C_REST) == c2) as u32, rt.slot(c3, C_META).0));

    // Onto a LAZY tail: the count is unknown, so the cell holds nil and it
    // stays nil however many cells are built on top.
    let u1 = rt.cons(Value(21), lz);
    let u2 = rt.cons(Value(22), u1);
    o.push_str(&format!("uncounted={},{} ", rt.slot(u1, C_COUNT).0, rt.slot(u2, C_COUNT).0));

    // Onto a VECTOR tail, which is counted without walking.
    let cv = rt.cons(Value(31), vv);
    o.push_str(&format!("onvec={} ", rt.slot(cv, C_COUNT).0));

    // A starved allocator answers nil rather than a half-built cell.
    rt.starve = true;
    rt.starve = false;
    // LIST-FROM-ROOTS, read back head-first. The values go on the shadow stack
    // in order and must come back in that order: `base + n - 1 - i` counting up
    // has to reproduce what `(0..n).rev()` did, and reversing it would still
    // build a three-long list -- so the ELEMENTS are what is printed, not the
    // length.
    let b = rt.mark();
    rt.push(Value(0x41)); rt.push(Value(0x42)); rt.push(Value(0x43));
    let lst = rt.list_from_roots(b, 3);
    let e0 = rt.slot(lst, C_FIRST);
    let r1 = rt.slot(lst, C_REST); let e1 = rt.slot(r1, C_FIRST);
    let r2 = rt.slot(r1, C_REST); let e2 = rt.slot(r2, C_FIRST);
    let tail_empty = ty(&rt.gc.sp, rt.slot(r2, C_REST).as_heap()) == TY_EMPTY_LIST;
    o.push_str(&format!("lfr={},{},{} lfrtail={} lfrcount={} ",
                        e0.0, e1.0, e2.0, tail_empty as u32, rt.slot(lst, C_COUNT).0));
    let empty_lst = rt.list_from_roots(b, 0);
    o.push_str(&format!("lfr0={} ",
                        (ty(&rt.gc.sp, empty_lst.as_heap()) == TY_EMPTY_LIST) as u32));
    rt.pop_to(b);
    rt.starve = true;
    o.push_str(&format!("starved={} ", rt.cons(Value(1), el).is_nil() as u32));
    println!("{}", o);
}
