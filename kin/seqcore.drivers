// The hand-written runtime as a REAL top-level namespace. The generated C#
// reaches `empty-list` as `global::Flint.Rt.Seqs.EmptyList`, and `global::`
// needs a genuine root -- a shim nested inside `class Probe` cannot be one.
namespace Flint.Rt {
    internal static class Seqs {
        internal static long EmptyList(Probe.Rt rt) { return Probe.EmptyListOf(rt); }
    }
}
