         .Append(" lfrcount=").Append(rt.Slot(lst, C_COUNT)).Append(' ');
        long emptyLst = ListFromRoots(rt, b, 0);
        o.Append("lfr0=").Append(Obj.Ty(rt.gc.sp, Val.AsHeap(emptyLst)) == Obj.TyEmptyList ? 1 : 0).Append(' ');
        rt.PopTo(b);
        rt.starve = true;
        o.Append("starved=").Append(Val.IsNil(Cons(rt, 1, el)) ? 1 : 0).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
