    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long el = Val.heap(rt.alloc(TY_EMPTY_LIST, 1));
        long vv = Val.heap(rt.alloc(TY_VEC, 6)); rt.h[(int) vv] = 7;
        long lz = Val.heap(rt.alloc(TY_LAZYSEQ, 2));
        o.append("hnil=").append(countHint(rt, NIL)).append(" hel=").append(countHint(rt, el))
         .append(" hvec=").append(countHint(rt, vv)).append(" hlazy=").append(countHint(rt, lz)).append(' ');
        long c1 = cons(rt, 11, el), c2 = cons(rt, 12, c1), c3 = cons(rt, 13, c2);
        o.append("counts=").append(rt.slot(c1, C_COUNT)).append(',').append(rt.slot(c2, C_COUNT))
         .append(',').append(rt.slot(c3, C_COUNT)).append(' ');
        o.append("firsts=").append(rt.slot(c3, C_FIRST)).append(',').append(rt.slot(c2, C_FIRST))
         .append(',').append(rt.slot(c1, C_FIRST)).append(' ');
        o.append("restis=").append(rt.slot(c3, C_REST) == c2 ? 1 : 0)
         .append(" meta=").append(rt.slot(c3, C_META)).append(' ');
        long u1 = cons(rt, 21, lz), u2 = cons(rt, 22, u1);
        o.append("uncounted=").append(rt.slot(u1, C_COUNT)).append(',').append(rt.slot(u2, C_COUNT)).append(' ');
        long cv = cons(rt, 31, vv);
        o.append("onvec=").append(rt.slot(cv, C_COUNT)).append(' ');
        rt.starve = true;
        o.append("starved=").append(Val.isNil(cons(rt, 1, el)) ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
