;; THE ORDERED HASH: what a vector, a list, a seq and a map entry all hash as.
;;
;; ONE WALK, and both ports had TWO. Their `hashValue` hashed a VECTOR with an
;; indexed loop that CACHED but charged nothing, and everything else sequential
;; with a seq walk that CHARGED but did not cache. Native had this, which does
;; both -- and the uncharged half is the defect `resource-limits` records costing 998 068
;; steps past an exhausted budget, still live on the JVM and the CLR for the
;; one shape most likely to be big.
;;
;; A TICK AND NOT A PRE-CHARGE, because this walks a SEQ: its length is not
;; known until it ends, and it may not end at all.
;;
;; `v` IS ROOTED FOR THE WHOLE WALK. `seq`, `first` and `next` allocate, and
;; the cache write at the end would otherwise land on a stale address -- which
;; is not a wrong hash, it is a corrupted heap (`a-vec-of-values-is-not-a-root`).
(ns flint.rt.valhash
  (:require [flint.impl.rt :refer [defn return if let do comment doc local set
                                   == not nil? is-heap as-heap ty is-fixnum
                                   as-fixnum to-i32 fixnum slot set-slot mark
                                   push r set-r pop-to forever break while + *
                                   charge-tick to-i64 bit-or bit-xor is-double
                                   num-f64 is-fixnum < is-inline-str
                                   is-inline-kw i64-of hash-double ref-to-map
                                   wadd wmul or Rt Value I32 U32 Ty Bool
                                   RootIx NIL F64 TRUE FALSE TY_VEC TY_STR
                                   TY_ROPE TY_KW TY_SYM TY_BIGINT TY_MAPENTRY
                                   TY_CONS TY_EMPTY_LIST TY_LAZYSEQ TY_VECSEQ
                                   TY_STRSEQ TY_RANGE TY_ARRAYMAP TY_HASHMAP
                                   TY_SET TY_BYTES TY_BROPE TY_OPAQUE TY_TABLE
                                   TY_TABLEREF TY_TAGGED V_HASH declarefn]]
            [flint.rt.tableref :refer [table-ref]]
            [flint.rt.tablemeta :refer [table-count]]
            [flint.rt.collhash :refer [hash-map hash-set]]
            [flint.rt.strs :refer [keyword-hash string-hash]]
            [flint.rt.hash :refer [ordered-step mix-coll-hash hash-long hash-int
                                   HASH_TRUE HASH_FALSE]]
            [flint.rt.names :refer [symbol-hash]]
            [flint.rt.bytehash :refer [b-hash]]
            [flint.rt.ropeflat :refer [rope-hash]]
            [flint.rt.ropemeas :refer [s-ascii]]
            [flint.rt.seqwalk :refer [seq first next]]
            [flint.rt.vecread :refer [vec-nth vec-count]]))

(declarefn ^:pub hash-value)

(doc "A PLAIN VECTOR IS HASHED BY INDEX, not by walking a seq."
     ""
     "The same defect `kin/valeq.kin` carries the fix for, in the sibling"
     "function, found by the same benchmark. `bench/equiv.mjs` reported"
     "`hash-vec` at TWO ALLOCATIONS for a two-element vector -- one seq cell"
     "per element -- on an operation that should allocate nothing."
     ""
     "THE CACHE HIDES IT AND DOES NOT REMOVE IT. A vector used repeatedly as a"
     "map key hashes once, which is what the cache above is for. But the FIRST"
     "hash still walks, and a vector hashed exactly once -- every element going"
     "into a set, every key inserted rather than looked up -- never reaches the"
     "cache at all. Those are the cases that allocate per element."
     ""
     "`has-hash-slot` is already the test for `is this a plain vector`, since"
     "only a vector has somewhere to cache. So this needed no new predicate."
     ""
     "GAS IS UNCHANGED, and the tick order is not the same as `seq-eq`'s. This"
     "loop checks the END FIRST and charges after, so a vector of n elements"
     "ticks n times and not n+1 -- the final round that finds the seq empty"
     "breaks before charging. `n` is both the index and the count ticked so"
     "far, exactly as the seq version uses it, and STARVATION returns 0 with"
     "nothing written to the cache, which is the behaviour that matters: a"
     "half-computed hash must never be cached."
     ""
     "THE CACHE WRITE RE-READS `v` FROM THE ROOT STACK, because `hash-value`"
     "on an element allocates -- a row ref materialises as a map -- and a raw"
     "address held across it is `a-vec-of-values-is-not-a-root`.")
(defn ^:method ^U32 hash-vec-indexed [^:mut ^Rt rt ^Value v]
  (let [^RootIx base (mark rt)
        ^RootIx vi (push rt v)
        ^I32 total (vec-count rt v)]
    (local ^:mut ^U32 acc)
    (local ^:mut ^I32 n)
    (local ^:mut ^Bool starved)
    (set acc 1)
    (set n 0)
    (set starved false)
    (forever
      (do (if (== n total)
            (break))
          (if (not (charge-tick rt (to-i64 n) 1 "hash"))
            (do (set starved true)
                (break)))
          (let [^Value f (vec-nth rt (r rt vi) n NIL)
                ^RootIx fi (push rt f)
                ^U32 h (hash-value rt (r rt fi))]
            (pop-to rt fi)
            (set acc (ordered-step acc h)))
          (set n (+ n 1))))
    (if starved
      (do (pop-to rt base)
          (return 0)))
    (let [^U32 out (mix-coll-hash acc n)]
      (set-slot rt (r rt vi) V_HASH (fixnum (to-i64 out)))
      (pop-to rt base)
      (return out))))

(doc "Is `v` a VECTOR, strictly? Only a vector has a slot to cache in.")
(defn ^:method ^Bool has-hash-slot [^Rt rt ^Value v]
  (if (not (is-heap v))
    (return false))
  (return (== (ty rt (as-heap v)) TY_VEC)))

(doc "The hash of a sequential value, in order."
     ""
     "CACHED IN THE VECTOR'S OWN HEADER when there is one. A vector used as a"
     "map key must not rehash on every lookup, and a seq has nowhere to put"
     "the answer -- so the cache is asked for and written only where it"
     "exists.")
(defn ^:pub ^:method ^U32 hash-ordered [^:mut ^Rt rt ^Value v]
  (if (has-hash-slot rt v)
    (let [^Value cached (slot rt v V_HASH)]
      (if (is-fixnum rt cached)
        (return (to-i32 (as-fixnum cached))))))
  (if (has-hash-slot rt v)
    (return (hash-vec-indexed rt v)))
  (let [^RootIx base (mark rt)
        ^RootIx vi (push rt v)
        ^Value s0 (seq rt (r rt vi))
        ^RootIx si (push rt s0)]
    (local ^:mut ^U32 acc)
    (local ^:mut ^I32 n)
    (local ^:mut ^Bool starved)
    (set acc 1)
    (set n 0)
    (set starved false)
    (forever
      (do (if (nil? rt (r rt si))
            (break))
          (if (not (charge-tick rt (to-i64 n) 1 "hash"))
            (do (set starved true)
                (break)))
          (let [^Value f (first rt (r rt si))
                ^RootIx fi (push rt f)
                ^U32 h (hash-value rt (r rt fi))]
            (pop-to rt fi)
            (set acc (ordered-step acc h)))
          (set n (+ n 1))
          (let [^Value nx (next rt (r rt si))]
            (set-r rt si nx))))
    (if starved
      (do (pop-to rt base)
          (return 0)))
    (let [^U32 out (mix-coll-hash acc n)]
      (if (has-hash-slot rt (r rt vi))
        (set-slot rt (r rt vi) V_HASH (fixnum (to-i64 out))))
      (pop-to rt base)
      (return out))))

(doc "The hash of any value."
     ""
     "TWO VALUES THAT ARE `=` MUST HASH ALIKE, or a map keyed by one is not"
     "found by the other. That is the contract this shares with `val-eq`, and"
     "it is why the two are read together: every arm here has a matching arm"
     "there, and a tier that is invisible to one must be invisible to both."
     ""
     "A BYTE STRING GOES THROUGH `b-hash` WHATEVER TIER IT IS IN. Native had"
     "an inline byte walk for the flat case and called `b-hash` for the tree,"
     "which is the same walk written twice; both ports already routed both."
     ""
     "FUNCTIONS, ATOMS AND VARS hash to a PER-TYPE CONSTANT. They are only"
     "ever `=` to themselves, so it is correct if unhelpful -- and a moving"
     "collector rules out using the address.")
(defn ^:pub ^:method ^U32 hash-value [^:mut ^Rt rt ^Value v]
  (if (is-double rt v)
    (return (hash-double (num-f64 rt v))))
  (if (nil? rt v)
    (return 0))
  (if (== v TRUE)
    (return HASH_TRUE))
  (if (== v FALSE)
    (return HASH_FALSE))
  (if (is-fixnum rt v)
    (return (hash-long (as-fixnum v))))
  (if (is-inline-str rt v)
    (return (string-hash rt v)))
  (if (is-inline-kw rt v)
    (return (keyword-hash rt v)))
  (if (not (is-heap v))
    (return 0))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_STR)
      (return (string-hash rt v)))
    (comment "HASH THE CONTENT, so `\"abc\"` inline, flat and as a rope are"
             "one key -- but WALK it rather than flattening. Flattening was"
             "here for the caching, which is real: a rope used as a map key"
             "must not rehash every lookup. `RP_HASH` gives the same caching"
             "per node and keeps the tree, so the trade is gone rather than"
             "chosen (`strings-and-matching`).")
    (comment "THROUGH `hash-int`, which a FLAT string's hash also goes"
             "through -- `string-hash` is `hash-int(java-string-hash(s))` and"
             "`rope-hash` is the raw 31-walk. Without the finaliser here a"
             "rope and an equal flat string hashed DIFFERENTLY, which breaks"
             "the one rule `strings-and-matching` states about tiers: two values that are `=`"
             "must hash alike or a map keyed by one is not found by the"
             "other. All three runtimes agreed, so no cross-runtime check"
             "could see it; `(= x (read-string (pr-str x)))` did."
             ""
             "The RECURSION keeps the raw accumulator -- `rope-hash` calls"
             "itself, not this -- because a parent combines its children's"
             "with `pow31` and a finalised child cannot be combined.")
    (comment "ONE WALK FOR EVERY TIER. A string hashes as a 31-walk over its"
             "UTF-8 BYTES whether it is inline, flat or a tree -- `string-hash`"
             "does it for the first two and caches in the header, `rope-hash`"
             "does it for the third and caches per node."
             ""
             "IT USED TO BE TWO. Flat strings walked UTF-16 UNITS, to match"
             "Java's `String.hashCode`, and trees walked bytes -- so a"
             "non-ASCII string hashed one way while it was flat and another"
             "once it passed FLAT_MAX. Measured at the boundary with `\u00e9`"
             "repeated: 1 024 bytes agreed with Clojure and 1 026 did not."
             "Nothing caught it. All four runtimes were wrong together, so no"
             "cross-runtime check could see it, and flint's own tier rule held"
             "as well, because no short string is EQUAL to a long one."
             ""
             "AND BYTES ARE THE RIGHT BASIS, not merely the cheaper fix."
             "Matching Clojure's NUMBERS buys nothing that is promised --"
             "Clojure changed its own hash in 1.6 and documents no stability"
             "across versions -- while a UTF-16 walk cannot compose with"
             "`pow31`, because that needs the child's length in the units the"
             "walk counts and no node carries a UTF-16 count. Bytes compose,"
             "so a rope keeps its per-node cache. ASCII still agrees with"
             "Clojure, because there a byte IS a unit.")
    (if (== t TY_ROPE)
      (return (hash-int (to-i32 (to-i64 (rope-hash rt v))))))
    (if (or (== t TY_BYTES) (== t TY_BROPE))
      (return (to-i32 (to-i64 (b-hash rt v)))))
    (if (== t TY_KW)
      (return (keyword-hash rt v)))
    (if (== t TY_SYM)
      (return (symbol-hash rt v)))
    (if (== t TY_BIGINT)
      (return (hash-long (i64-of rt v))))
    (if (or (or (or (== t TY_VEC) (== t TY_MAPENTRY))
                (or (== t TY_CONS) (== t TY_EMPTY_LIST)))
            (or (or (== t TY_LAZYSEQ) (== t TY_VECSEQ))
                (or (== t TY_STRSEQ) (== t TY_RANGE))))
      (return (hash-ordered rt v)))
    (if (or (== t TY_ARRAYMAP) (== t TY_HASHMAP))
      (return (hash-map rt v)))
    (if (== t TY_SET)
      (return (hash-set rt v)))
    (comment "AN OPAQUE VALUE CARRIES ITS OWN IDENTITY, assigned at creation"
             "and STORED (`opaque-values`). The per-type constant below would be"
             "correct -- equality is identity, so collisions only cost time --"
             "but it would put every opaque value in one bucket, and the whole"
             "point of the type is to be a distinct key.")
    (if (== t TY_OPAQUE)
      (let [^Value id (slot rt v 1)]
        (if (is-fixnum rt id)
          (return (hash-long (as-fixnum id))))
        (return (hash-long 0))))
    (comment "COLUMNAR is available precisely because a table is not `=` to a"
             "vector of maps, so this need not agree with what one would"
             "hash. ROOTED for the reason the equality arm is: `table-ref`"
             "allocates and `v` is a host local (`a-vec-of-values-is-not-a-root`).")
    (if (== t TY_TABLE)
      (let [^RootIx base (mark rt)
            ^RootIx vi (push rt v)
            ^I32 n (table-count rt (r rt vi))]
        (local ^:mut ^U32 acc)
        (local ^:mut ^I32 i)
        (set acc 1)
        (set i 0)
        (while (< i n)
          (do (let [^Value row (table-ref rt (r rt vi) i)
                    ^RootIx ri (push rt row)
                    ^U32 h (hash-value rt (r rt ri))]
                (pop-to rt ri)
                (set acc (wadd (wmul acc 31) h)))
              (set i (+ i 1))))
        (pop-to rt base)
        (return (hash-int (bit-xor acc n)))))
    (comment "A REF HASHES AS THE MAP IT IS, or a map keyed by a row would"
             "not find it.")
    (if (== t TY_TABLEREF)
      (let [^RootIx base (mark rt)
            ^Value m (ref-to-map rt v)
            ^RootIx mi (push rt m)
            ^U32 h (hash-value rt (r rt mi))]
        (pop-to rt base)
        (return h)))
    (comment "BOTH HALVES, so a tagged literal hashes like the pair it is and"
             "two equal ones land in the same bucket. The final `hash-int` is"
             "the mix both ports dropped, which made a tagged literal hash"
             "differently on wasm than on the JVM and the CLR.")
    (if (== t TY_TAGGED)
      (let [^RootIx base (mark rt)
            ^RootIx vi (push rt v)
            ^U32 th (hash-value rt (slot rt (r rt vi) 0))
            ^U32 fh (hash-value rt (slot rt (r rt vi) 1))]
        (pop-to rt base)
        (return (hash-int (wadd (wmul th 31) fh)))))
    (return (hash-int (bit-or 0x51ed0000 (to-i32 (to-i64 t)))))))
