;; The intern table's slot arithmetic, written once.
;;
;; Phase 2 of `doc/goals/kin-port.md`, and the file that was nearly refused.
;; It was moved to phase 5 on the grounds that its three differences from Rust
;; were structural -- which used the divergence as its own evidence, inverting
;; this project's rule. Measured, only the STORAGE difference was real, and it
;; pointed at converging rather than refusing: parallel arrays are
;; equal-or-better at every size AND the only layout the JVM can have, since
;; Java has no value types. Rust converged onto them, and the file became
;; portable.
;;
;; What is here is the arithmetic every probe and insert runs through. What is
;; NOT here is `lookup` and `grow`: `lookup` returns "the value, or where to
;; put one" -- `Result` in Rust, a mutable `slot` field on the others -- and
;; takes a closure; `grow` allocates two arrays. Those are honest gaps, not
;; drift.
;;
;; THESE WERE `^:instance` -- instance methods on all three -- and they are
;; not any more, because a whole-module emit and a Java instance method
;; cannot both be had.
;;
;; `^:instance` emits `this.values` and `this.count`, which only compiles
;; INSIDE the class that declares those fields. Rust can put an `impl
;; InternTable` block in any module of the crate and C# has `partial class`,
;; so both could still take it; Java has no partial class and no way to add
;; an instance method to a class from another file. So the moment this
;; source became `kingen/flint/rt/Interns.java` rather than a region spliced
;; into `com.flint.rt.Interns`, `^:instance` stopped being expressible.
;;
;; `^:method` is what the other thirteen sources already use: Rust `self`,
;; the others a static taking the receiver. Rust's output does not change at
;; all. Java and C# gain a `t` parameter and lose a `this.`, and the table's
;; three fields widen to match, which is the cost of the module boundary
;; being a package boundary on the JVM.
;;
;; `^:instance` stays in kin -- it is the right answer for a vocabulary whose
;; target can express it, and C# could still have it. flint cannot use it
;; while it wants one source to serve all three.
(ns flint.rt.interns
  (:require [flint.impl.rt :refer [defn return while set let doc as-idx
                                   aget aset alen bits of-bits
                                   . + - * >= != bit-and
                                   Interns Idx I32 Bits Value Bool]]))

(defn ^:method ^Idx mask [^Interns t]
  (return (- (alen (. t values)) 1)))

(defn ^:pub ^:method insert-at [^:mut ^Interns t ^Idx idx ^I32 hash ^Value v]
  (aset (. t hashes) idx hash)
  (aset (. t values) idx (bits v))
  (set (. t count) (+ (. t count) 1)))

(defn ^:pub ^:method ^Bool needs-grow [^Interns t]
  (return (>= (* (. t count) 4) (* (alen (. t values)) 3))))

(doc "Insert with no probe for equality: the caller already knows this hash"
     "and value are not present. Used only by a rebuild, where every entry"
     "came out of a table that had already established that.")

(defn ^:method raw-insert [^:mut ^Interns t ^I32 h ^Bits v]
  (let [^Idx m (mask t)
        ^:mut ^Idx i (bit-and (as-idx h) m)]
    (while (!= (aget (. t values) i) 0)
      (set i (bit-and (+ i 1) m)))
    (aset (. t hashes) i h)
    (aset (. t values) i v)
    (set (. t count) (+ (. t count) 1))))
