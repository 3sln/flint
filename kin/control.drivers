    static final long NIL = 0xFFFF000000000000L;
    static final long TRUE = 0xFFFF000000000001L;
    static final class Val {
        static final long NIL = Probe.NIL;
        static final long TRUE = Probe.TRUE;
        static boolean isNil(long v) { return v == Probe.NIL; }
        static long asFixnum(long v) { return v; }
        static long fixnum(long n) { return n; }
        static long asHeap(long v) { return v; }
    }
    static final class Conc {
        static final int PT_KIND = 0, PT_BYTES = 1, SC_BOUND = 0, SC_CTRL = 1;
        static long sched(Rt rt) { return rt.schedV; }
        static boolean isPort(Rt rt, long v) { return !Val.isNil(v) && rt.portVals.contains(v); }
        static boolean crossesAHeap(long kind) { return kind == 1; }
        static void wakeOn(Rt rt, long p) { rt.wakeCalls++; }
        static long portById(Rt rt, long id) {
            for (int i = 0; i < rt.portIds.size(); i++)
                if (rt.portIds.get(i) == id) return rt.portVals.get(i);
            return NIL;
        }
        static boolean hasCallLoop(Rt rt) { return rt.hasLoop; }
        static boolean spawnCall(Rt rt, long p) {
            if (!rt.spawnOk) return false;
            Long id = rt.portIdOf(p);
            if (id != null) rt.spawnCalls.add(id);
            return true;
        }
    }
    static final class Snap {
        static boolean idle(Rt rt) { return rt.idle; }
        static void begin(Rt rt, long p) {
            Long id = rt.portIdOf(p);
            if (id != null) rt.snapCalls.add(id);
            rt.idle = false;
        }
    }
    static final class Vec { static long empty(Rt rt) { return rt.emptyVec; } }
    // BARE, not on a class: `kin/scripts/gen` strips the imports, so a call
    // into another kin namespace lands unqualified in the probe.
    static long concSystemPort(Rt rt) { return rt.systemPort; }
    static int ringInboxCount(Rt rt, long p) { return rt.inboxLen.size(); }
    static long ringDequeue(Rt rt, long p) {
        long n = rt.inboxLen.remove(0);
        long code = rt.inboxCode.remove(0);
        return rt.obj(new long[]{2, n, code});
    }
    static long receiveDrained(Rt rt, long p) { return rt.drained ? 1 : 0; }
    static void closeAt(Rt rt, long p) {
        Long id = rt.portIdOf(p);
        if (id != null) rt.closedIds.add(id);
    }
    static long wireReader(Rt rt, long body, boolean streaming) { return body; }
    static long wireControlOp(Rt rt, long rd, long acc) { return Val.asFixnum(rd); }
    static int vecCount(Rt rt, long v) {
        if (Val.isNil(v)) return 0;
        return (int) rt.objs.get((int) v)[0];
    }
    static long vecNth(Rt rt, long v, int i, long d) {
        int n = vecCount(rt, v);
        return i >= n ? d : rt.objs.get((int) v)[i + 1];
    }
    static long vecConj(Rt rt, long v, long x) {
        int n = vecCount(rt, v);
        long[] cur = Val.isNil(v) ? new long[]{0} : rt.objs.get((int) v);
        long[] next = new long[n + 2];
        next[0] = n + 1;
        for (int k = 0; k < n; k++) next[k + 1] = cur[k + 1];
        next[n + 1] = x;
        return rt.obj(next);
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<Long> roots = new java.util.ArrayList<>();
        long schedV = NIL;
        long emptyVec;
        java.util.List<Long> portIds = new java.util.ArrayList<>();
        java.util.List<Long> portVals = new java.util.ArrayList<>();
        java.util.List<Long> closedIds = new java.util.ArrayList<>();
        java.util.List<Long> spawnCalls = new java.util.ArrayList<>();
        boolean spawnOk = true;
        int wakeCalls = 0;
        long systemPort = NIL;
        java.util.List<Long> inboxLen = new java.util.ArrayList<>();
        java.util.List<Long> inboxCode = new java.util.ArrayList<>();
        boolean drained = false;
        boolean idle = true;
        java.util.List<Long> snapCalls = new java.util.ArrayList<>();
        boolean ensureOk = true;
        boolean hasLoop = true;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
        void setSlot(long v, int i, long x) { objs.get((int) v)[i] = x; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
        boolean ensureStarted() { return ensureOk; }
        Long portIdOf(long v) {
            for (int i = 0; i < portIds.size(); i++)
                if (portVals.get(i) == v) return portIds.get(i);
            return null;
        }
    }
