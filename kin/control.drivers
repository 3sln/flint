--csharp-head
    internal const long NIL = unchecked((long) 0xFFFF000000000000UL);
    internal const long TRUE = unchecked((long) 0xFFFF000000000001UL);
    internal static class Val {
        internal const long Nil = unchecked((long) 0xFFFF000000000000UL);
        internal const long True = unchecked((long) 0xFFFF000000000001UL);
        internal static bool IsNil(long v) => v == NIL;
        internal static long AsFixnum(long v) => v;
        internal static long Fixnum(long n) => n;
        internal static long AsHeap(long v) => v;
    }
    internal static class Conc {
        internal const int PT_KIND = 0, PT_BYTES = 1, SC_BOUND = 0, SC_CTRL = 1;
        internal static long Sched(Rt rt) => rt.SchedV;
        internal static bool IsPort(Rt rt, long v) => !Val.IsNil(v) && rt.PortVals.Contains(v);
        internal static bool CrossesAHeap(long kind) => kind == 1;
        internal static void WakeOn(Rt rt, long p) { rt.WakeCalls++; }
        internal static long PortById(Rt rt, long id) {
            for (int i = 0; i < rt.PortIds.Count; i++)
                if (rt.PortIds[i] == id) return rt.PortVals[i];
            return NIL;
        }
        internal static bool HasCallLoop(Rt rt) => rt.HasLoop;
        internal static bool SpawnCall(Rt rt, long p) {
            if (!rt.SpawnOk) return false;
            long? id = rt.PortIdOf(p);
            if (id != null) rt.SpawnCalls.Add(id.Value);
            return true;
        }
    }
    internal static class Snap {
        internal static bool Idle(Rt rt) => rt.Idle;
        internal static void Begin(Rt rt, long p) {
            long? id = rt.PortIdOf(p);
            if (id != null) rt.SnapCalls.Add(id.Value);
            rt.Idle = false;
        }
    }
    internal static class Vec { internal static long Empty(Rt rt) => rt.EmptyVec; }
    // BARE, not on a class -- see the Java head.
    static long ConcSystemPort(Rt rt) => rt.SystemPort;
    static int RingInboxCount(Rt rt, long p) => rt.InboxLen.Count;
    static long RingDequeue(Rt rt, long p) {
        long n = rt.InboxLen[0]; rt.InboxLen.RemoveAt(0);
        long code = rt.InboxCode[0]; rt.InboxCode.RemoveAt(0);
        return rt.MakeObj(new long[]{2, n, code});
    }
    static long ReceiveDrained(Rt rt, long p) => rt.Drained ? 1 : 0;
    static void CloseAt(Rt rt, long p) {
        long? id = rt.PortIdOf(p);
        if (id != null) rt.ClosedIds.Add(id.Value);
    }
    static long WireReader(Rt rt, long body, bool streaming) => body;
    static long WireControlOp(Rt rt, long rd, long acc) => Val.AsFixnum(rd);
    static int VecCount(Rt rt, long v) {
        if (Val.IsNil(v)) return 0;
        return (int) rt.Objs[(int) v][0];
    }
    static long VecNth(Rt rt, long v, int i, long d) {
        int n = VecCount(rt, v);
        return i >= n ? d : rt.Objs[(int) v][i + 1];
    }
    static long VecConj(Rt rt, long v, long x) {
        int n = VecCount(rt, v);
        var cur = Val.IsNil(v) ? new long[]{0} : rt.Objs[(int) v];
        var next = new long[n + 2];
        next[0] = n + 1;
        for (int k = 0; k < n; k++) next[k + 1] = cur[k + 1];
        next[n + 1] = x;
        return rt.MakeObj(next);
    }
    internal sealed class Rt {
        internal System.Collections.Generic.List<long[]> Objs = new();
        internal System.Collections.Generic.List<long> Roots = new();
        internal long SchedV = NIL;
        internal long EmptyVec;
        internal System.Collections.Generic.List<long> PortIds = new();
        internal System.Collections.Generic.List<long> PortVals = new();
        internal System.Collections.Generic.List<long> ClosedIds = new();
        internal System.Collections.Generic.List<long> SpawnCalls = new();
        internal bool SpawnOk = true;
        internal int WakeCalls = 0;
        internal long SystemPort = NIL;
        internal System.Collections.Generic.List<long> InboxLen = new();
        internal System.Collections.Generic.List<long> InboxCode = new();
        internal bool Drained = false;
        internal bool Idle = true;
        internal System.Collections.Generic.List<long> SnapCalls = new();
        internal bool EnsureOk = true;
        internal bool HasLoop = true;
        internal long MakeObj(long[] slots) { Objs.Add(slots); return Objs.Count - 1; }
        internal long Slot(long v, int i) => Objs[(int) v][i];
        internal void SetSlot(long v, int i, long x) { Objs[(int) v][i] = x; }
        internal int Mark() => Roots.Count;
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) => Roots[i];
        internal void SetR(int i, long v) { Roots[i] = v; }
        internal void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
        internal bool EnsureStarted() => EnsureOk;
        internal long? PortIdOf(long v) {
            for (int i = 0; i < PortIds.Count; i++)
                if (PortVals[i] == v) return PortIds[i];
            return null;
        }
    }
--csharp
    static Rt Fresh() {
        var rt = new Rt();
        long e = rt.MakeObj(new long[]{0});
        rt.EmptyVec = e;
        long s = rt.MakeObj(new long[]{NIL, NIL});
        rt.SchedV = s;
        return rt;
    }
    static long MkPort(Rt rt, long id) {
        long p = rt.MakeObj(new long[]{id});
        rt.PortIds.Add(id);
        rt.PortVals.Add(p);
        return p;
    }
    static long MkSystemPort(Rt rt) => rt.MakeObj(new long[]{0, 0});
    static string BoundIds(Rt rt) {
        long b = rt.Slot(rt.SchedV, Conc.SC_BOUND);
        int n = VecCount(rt, b);
        var ids = new System.Collections.Generic.List<string>();
        for (int i = 0; i < n; i++) {
            long v = VecNth(rt, b, i, NIL);
            long? id = rt.PortIdOf(v);
            ids.Add((id ?? -1).ToString());
        }
        return ids.Count == 0 ? "-" : string.Join(",", ids);
    }
    static int Ctrl(Rt rt) => rt.Slot(rt.SchedV, Conc.SC_CTRL) == TRUE ? 1 : 0;
    static string Joined(System.Collections.Generic.List<long> v) {
        if (v.Count == 0) return "-";
        var s = new System.Collections.Generic.List<string>();
        foreach (var x in v) s.Add(x.ToString());
        return string.Join(",", s);
    }
    static void Main() {
        var outp = new System.Text.StringBuilder();

        var a = Fresh();
        outp.Append(ControlWaiting(a) ? 1 : 0);
        outp.Append(' ');
        var b = Fresh();
        long bp = MkSystemPort(b);
        b.SystemPort = bp;
        outp.Append(ControlWaiting(b) ? 1 : 0);
        outp.Append(' ');
        b.SetSlot(b.SchedV, Conc.SC_CTRL, TRUE);
        outp.Append(ControlWaiting(b) ? 1 : 0);
        outp.Append(' ');
        var c = Fresh();
        long cp = MkSystemPort(c);
        c.SystemPort = cp;
        c.HasLoop = false;
        outp.Append(ControlWaiting(c) ? 1 : 0);
        outp.Append(" | ");

        var d = Fresh();
        long dp = MkSystemPort(d);
        d.SystemPort = dp;
        MkPort(d, 5);
        d.InboxLen.Add(0); d.InboxCode.Add(49);
        ServeControlAt(d);
        outp.Append("spawn=").Append(Joined(d.SpawnCalls))
            .Append(" bound=").Append(BoundIds(d))
            .Append(" ctrl=").Append(Ctrl(d))
            .Append(" left=").Append(d.InboxLen.Count);
        outp.Append(" | ");

        var e = Fresh();
        long ep = MkSystemPort(e);
        e.SystemPort = ep;
        long up = MkPort(e, 7);
        long b0 = VecConj(e, e.EmptyVec, up);
        e.SetSlot(e.SchedV, Conc.SC_BOUND, b0);
        e.InboxLen.Add(0); e.InboxCode.Add(66);
        ServeControlAt(e);
        outp.Append("closed=").Append(Joined(e.ClosedIds))
            .Append(" bound=").Append(BoundIds(e))
            .Append(" ctrl=").Append(Ctrl(e));
        outp.Append(" | ");

        var f = Fresh();
        long fp = MkSystemPort(f);
        f.SystemPort = fp;
        long p3 = MkPort(f, 3);
        long p4 = MkPort(f, 4);
        long fb0 = VecConj(f, f.EmptyVec, p3);
        long fb1 = VecConj(f, fb0, p4);
        f.SetSlot(f.SchedV, Conc.SC_BOUND, fb1);
        f.InboxLen.Add(0); f.InboxCode.Add(3);
        f.InboxLen.Add(0); f.InboxCode.Add(999);
        ServeControlAt(f);
        outp.Append("closed=").Append(Joined(f.ClosedIds))
            .Append(" bound=").Append(BoundIds(f))
            .Append(" ctrl=").Append(Ctrl(f))
            .Append(" left=").Append(f.InboxLen.Count);
        outp.Append(" | ");

        var g = Fresh();
        long gp = MkSystemPort(g);
        g.SystemPort = gp;
        MkPort(g, 2);
        g.InboxLen.Add(0); g.InboxCode.Add(28);
        g.InboxLen.Add(0); g.InboxCode.Add(999);
        ServeControlAt(g);
        outp.Append("snap=").Append(Joined(g.SnapCalls))
            .Append(" ctrl=").Append(Ctrl(g))
            .Append(" left=").Append(g.InboxLen.Count);
        outp.Append(" | ");

        var h = Fresh();
        long hp = MkSystemPort(h);
        h.SystemPort = hp;
        long p9 = MkPort(h, 9);
        long p10 = MkPort(h, 10);
        long hb0 = VecConj(h, h.EmptyVec, p9);
        long hb1 = VecConj(h, hb0, p10);
        h.SetSlot(h.SchedV, Conc.SC_BOUND, hb1);
        h.Drained = true;
        ServeControlAt(h);
        outp.Append("closed=").Append(Joined(h.ClosedIds))
            .Append(" bound=").Append(BoundIds(h))
            .Append(" ctrl=").Append(Ctrl(h));

        System.Console.WriteLine(outp.ToString());
    }
--expect
0 1 0 0 | spawn=5 bound=5 ctrl=0 left=0 | closed=7 bound=- ctrl=0 | closed=3,4 bound=- ctrl=1 left=1 | snap=2 ctrl=0 left=1 | closed=9,10 bound=- ctrl=1
--expect-why
DERIVED FROM THE SOURCE in `kin/control.kin`, read line by line, not from a
run. `wire-control-op` is stubbed to answer a code this file chose, so every
code below is `op + 8 * (port-id + 1)` by construction, not by parsing.

  --- CONTROL-WAITING, read off its four guards in order:
      no call loop -> false; no system port -> false; no scheduler -> false;
      else `not (SC_CTRL == TRUE)` ---

  `0`  NO SYSTEM PORT. `conc-system-port` answers NIL and the second guard
       takes it, before SC_CTRL is ever read.
  `1`  A SYSTEM PORT, `SC_CTRL` still NIL (the "NIL until the first" state
       every scheduler starts in). `not (NIL == TRUE)` is true.
  `0`  THE SAME SCHEDULER with `SC_CTRL` set to TRUE: `not (TRUE == TRUE)`
       is false.
  `0`  NO CALL LOOP, with a system port present and `SC_CTRL` NIL -- the
       state that answered `1` two fields back. The FIRST guard now fires
       before the system port or `SC_CTRL` are read at all, which is the
       only field here that isolates it: every other field already passes
       with `has-call-loop` left at its default `true`.

  --- SERVE-CONTROL-AT, one call each, from a scheduler with nothing bound
      unless a case says otherwise ---

  BIND (code 65 would be `:bind :port 7`; this case uses port id 5, so
  `1 + 8*(5+1) = 49`):
    `spawn=5`   `spawn-call` was invoked with the port whose id is 5 --
                `bind-port`'s own call, unconditional once the op and the
                port agree.
    `bound=5`   and `SC_BOUND` now holds that same port: the vector built
                from `empty-vec` (SC_BOUND started NIL) by one `vec-conj`.
    `ctrl=0`    unchanged -- `:bind` never touches `SC_CTRL`.
    `left=0`    the one queued message is gone: `ring-dequeue` took it and
                nothing else was queued.

  UNBIND (id 7: `2 + 8*(7+1) = 66`), starting with port 7 already in
  `SC_BOUND`:
    `closed=7`  `close-at` is unconditional in `unbind-port`, before the
                bound list is even rebuilt.
    `bound=-`   port 7 was the ONLY entry, so the rebuilt list (every
                element that is NOT port 7, by identity) is empty --
                `vec-count` of it is 0, read here as "-".
    `ctrl=0`    unchanged, same reason as BIND.

  CLOSE (`3 + 8*0 = 3`, no port), starting with TWO ports bound (3, 4), and
  a SECOND message queued behind the close:
    `closed=3,4`  `close-bound` walks `SC_BOUND` front to back, closing
                  every element that `is-port` -- both of them, in the
                  order they were added.
    `bound=-`     `close-bound` sets `SC_BOUND` to NIL explicitly, which is
                  why this reads "-" and not merely "empty": a vector that
                  happened to end up with zero live entries would print
                  the same, but only this case proves the SLOT itself was
                  cleared.
    `ctrl=1`      `SC_CTRL` is set TRUE on `:close`, unconditionally.
    `left=1`      **THE FIELD THAT PROVES THE EARLY RETURN.** `:close`
                  returns from `serve-control-at` immediately after acting,
                  without looping back to look at the ring again -- so the
                  message queued behind it is never dequeued. A version
                  that fell through to the loop's top would read `left=0`
                  here and still pass every field above.

  SNAPSHOT (id 2: `4 + 8*(2+1) = 28`), with a second message queued behind
  it:
    `snap=2`      `snapshot-begin` was called with the port whose id is 2.
    `ctrl=0`      `:snapshot` never touches `SC_CTRL`.
    `left=1`      **THE FIELD THAT PROVES SERVING STOPS.** This harness's
                  `snapshot-begin` stub sets `snapshot-idle` false once run
                  -- exactly what a real export in flight does -- so the
                  `(if (not (snapshot-idle rt)) (return ...))` right after
                  `snapshot-begin` in the source fires, and the loop never
                  reaches the second message. A version that kept looping
                  regardless would read `left=0` and still pass `snap=2`.

  THE DRAINED SYSTEM PORT (no message queued at all, and `receive-drained`
  answers non-zero), with TWO ports bound (9, 10):
    `closed=9,10` the `ring-inbox-count == 0` branch takes the DRAINED arm
                  rather than returning quietly, and closes every bound
                  port exactly as `:close` does -- the same `close-bound`.
    `bound=-`     `SC_BOUND` cleared, same as the CLOSE case.
    `ctrl=1`      `SC_CTRL` set TRUE here too: the end of the system port
                  is the end of the control plane, same as `:close`.

EVERY BYTE COUNT QUEUED IS 0 AND EVERY SYSTEM PORT HAS `PT_KIND = 0` ON
PURPOSE: the byte-refund arithmetic inside the cross-a-heap branch is
`reap-ports`'s own bookkeeping, not part of the dispatch on `:bind`,
`:unbind`, `:close` and `:snapshot` this file exists to pin, so every case
here is built never to take that branch at all.
