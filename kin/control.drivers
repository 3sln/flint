    static Rt fresh() {
        Rt rt = new Rt();
        long e = rt.obj(new long[]{0});
        rt.emptyVec = e;
        long s = rt.obj(new long[]{NIL, NIL});
        rt.schedV = s;
        return rt;
    }
    static long mkPort(Rt rt, long id) {
        long p = rt.obj(new long[]{id});
        rt.portIds.add(id);
        rt.portVals.add(p);
        return p;
    }
    static long mkSystemPort(Rt rt) { return rt.obj(new long[]{0, 0}); }
    static String boundIds(Rt rt) {
        long b = rt.slot(rt.schedV, Conc.SC_BOUND);
        int n = vecCount(rt, b);
        java.util.List<String> ids = new java.util.ArrayList<>();
        for (int i = 0; i < n; i++) {
            long v = vecNth(rt, b, i, NIL);
            Long id = rt.portIdOf(v);
            ids.add(String.valueOf(id == null ? -1 : id));
        }
        return ids.isEmpty() ? "-" : String.join(",", ids);
    }
    static int ctrl(Rt rt) { return rt.slot(rt.schedV, Conc.SC_CTRL) == TRUE ? 1 : 0; }
    static String joined(java.util.List<Long> v) {
        if (v.isEmpty()) return "-";
        java.util.List<String> s = new java.util.ArrayList<>();
        for (long x : v) s.add(String.valueOf(x));
        return String.join(",", s);
    }
