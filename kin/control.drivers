--rust-head
// THE CONTROL PLANE'S OWN TOY SANDBOX.
//
// A scheduler row (`SC_BOUND`, `SC_CTRL`), a registry of ports the host has
// already minted -- as `kin/wirescan.kin`'s own walk would have, which this
// file does not re-test -- and a system port modelled as an inbox of
// `(byte-len, code)` pairs. `wire-control-op` is stubbed to answer the CODE
// directly, stored on the queued message, so what is under test is
// `serve-control-at`'s DISPATCH on that code, not the wire format
// `kin/wirescan.drivers` already has its own verify of.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
const TRUE: Value = Value(0xFFFF_0000_0000_0001);
impl Value {
    fn is_nil(self) -> bool { self == NIL }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
}
mod conc {
    pub const PT_KIND: u32 = 0;
    pub const PT_BYTES: u32 = 1;
    pub const SC_BOUND: u32 = 0;
    pub const SC_CTRL: u32 = 1;
    // A BRIDGE crosses a heap; NOTHING does here -- every system port this
    // file builds carries `PT_KIND = 0`, so the byte-refund branch in
    // `serve-control-at` never fires. That branch is accounting
    // `reap-ports` shares, not part of the DISPATCH this file exists to
    // test, so leaving it untaken is the simpler fixture rather than a gap.
    pub fn crosses_a_heap(kind: i64) -> bool { kind == 1 }
    pub fn has_call_loop(rt: &mut super::Rt) -> bool { rt.has_loop }
    pub fn spawn_call(rt: &mut super::Rt, p: super::Value) -> bool {
        if !rt.spawn_ok { return false; }
        if let Some(id) = rt.port_id_of(p) { rt.spawn_calls.push(id); }
        true
    }
}
mod snap {
    // `idle` ANSWERS BUSY ONCE `begin` HAS RUN, which is what lets one row
    // show `serve-control-at` stopping mid-queue rather than draining it --
    // exactly as a real export in flight would.
    pub fn idle(rt: &mut super::Rt) -> bool { rt.idle }
    pub fn begin(rt: &mut super::Rt, p: super::Value) {
        if let Some(id) = rt.port_id_of(p) { rt.snap_calls.push(id); }
        rt.idle = false;
    }
}
struct Rt {
    objs: Vec<Vec<Value>>,
    roots: Vec<Value>,
    sched_v: Value,
    empty: Value,
    port_ids: Vec<i64>,
    port_vals: Vec<Value>,
    closed: Vec<i64>,
    spawn_calls: Vec<i64>,
    spawn_ok: bool,
    wake_calls: u32,
    system_port: Value,
    // THE SYSTEM PORT'S INBOX: `(byte-len, code)`, dequeued front first.
    inbox: Vec<(i64, i64)>,
    drained: bool,
    idle: bool,
    snap_calls: Vec<i64>,
    ensure_ok: bool,
    has_loop: bool,
}
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn sched(&self) -> Value { self.sched_v }
    fn empty_vec(&self) -> Value { self.empty }
    // A VECTOR is an object whose slot 0 is its count; the items follow --
    // the same convention `kin/sched.drivers` and `kin/wirescan.drivers` use.
    fn vec_count(&self, v: Value) -> u32 {
        if v.is_nil() { return 0; }
        self.objs[v.0 as usize][0].as_fixnum() as u32
    }
    fn vec_nth(&self, v: Value, i: u32, d: Value) -> Value {
        let n = self.vec_count(v);
        if i >= n { return d; }
        self.objs[v.0 as usize][(i + 1) as usize]
    }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let n = self.vec_count(v);
        let cur = if v.is_nil() { vec![Value::fixnum(0)] } else { self.objs[v.0 as usize].clone() };
        let mut next = cur;
        next.truncate((n + 1) as usize);
        next.push(x);
        next[0] = Value::fixnum((n + 1) as i64);
        self.obj(next)
    }
    fn is_port(&self, v: Value) -> bool {
        !v.is_nil() && self.port_vals.contains(&v)
    }
    fn port_by_id(&mut self, id: i64) -> Value {
        for (k, v) in self.port_ids.iter().zip(self.port_vals.iter()) {
            if *k == id { return *v; }
        }
        NIL
    }
    fn wake_on(&mut self, _p: Value) { self.wake_calls += 1; }
    fn conc_system_port(&mut self) -> Value { self.system_port }
    fn ring_inbox_count(&mut self, _p: Value) -> u32 { self.inbox.len() as u32 }
    fn ring_dequeue(&mut self, _p: Value) -> Value {
        let (n, code) = self.inbox.remove(0);
        self.obj(vec![Value::fixnum(2), Value::fixnum(n), Value::fixnum(code)])
    }
    fn receive_drained(&mut self, _p: Value) -> i64 { if self.drained { 1 } else { 0 } }
    fn close_at(&mut self, p: Value) {
        if let Some(id) = self.port_id_of(p) { self.closed.push(id); }
    }
    fn wire_reader(&mut self, body: Value, _streaming: bool) -> Value { body }
    // THE STUB THE TASK ASKS FOR: the code is the message, not read from
    // bytes -- this file tests `serve-control-at`'s dispatch on a code,
    // which is what `kin/wirescan.drivers` already derives from real wire
    // bytes on its own.
    fn wire_control_op(&mut self, rd: Value, _acc: usize) -> i64 { rd.as_fixnum() }
    fn ensure_started(&mut self) -> bool { self.ensure_ok }
    // A HARNESS HELPER, not a kin word: the reverse of `port_by_id`, used
    // only to turn a port back into the id the expected answers are
    // written against.
    fn port_id_of(&self, v: Value) -> Option<i64> {
        for (k, val) in self.port_ids.iter().zip(self.port_vals.iter()) {
            if *val == v { return Some(*k); }
        }
        None
    }
--rust
}
fn fresh() -> Rt {
    let mut rt = Rt { objs: Vec::new(), roots: Vec::new(), sched_v: NIL, empty: NIL,
                      port_ids: Vec::new(), port_vals: Vec::new(), closed: Vec::new(),
                      spawn_calls: Vec::new(), spawn_ok: true, wake_calls: 0,
                      system_port: NIL, inbox: Vec::new(), drained: false, idle: true,
                      snap_calls: Vec::new(), ensure_ok: true, has_loop: true };
    let e = rt.obj(vec![Value::fixnum(0)]);
    rt.empty = e;
    // SC_BOUND = NIL, SC_CTRL = NIL -- "NIL until the first", per the source.
    let s = rt.obj(vec![NIL, NIL]);
    rt.sched_v = s;
    rt
}
fn mk_port(rt: &mut Rt, id: i64) -> Value {
    let p = rt.obj(vec![Value::fixnum(id)]);
    rt.port_ids.push(id);
    rt.port_vals.push(p);
    p
}
// PT_KIND = 0 (never crosses a heap here), PT_BYTES = 0 (unused).
fn mk_system_port(rt: &mut Rt) -> Value {
    rt.obj(vec![Value::fixnum(0), Value::fixnum(0)])
}
fn bound_ids(rt: &Rt) -> String {
    let b = rt.slot(rt.sched_v, conc::SC_BOUND);
    let n = rt.vec_count(b);
    let mut ids = Vec::new();
    for i in 0..n {
        let v = rt.vec_nth(b, i, NIL);
        ids.push(rt.port_id_of(v).unwrap_or(-1).to_string());
    }
    if ids.is_empty() { "-".to_string() } else { ids.join(",") }
}
fn ctrl(rt: &Rt) -> u32 { if rt.slot(rt.sched_v, conc::SC_CTRL) == TRUE { 1 } else { 0 } }
fn joined(v: &[i64]) -> String {
    if v.is_empty() { "-".to_string() } else { v.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(",") }
}
fn main() {
    let mut out = String::new();

    // 1-4. CONTROL-WAITING.
    let mut a = fresh();
    out.push_str(&format!("{}", a.control_waiting() as u32));
    out.push(' ');
    let mut b = fresh();
    let bp = mk_system_port(&mut b);
    b.system_port = bp;
    out.push_str(&format!("{}", b.control_waiting() as u32));
    out.push(' ');
    b.set(b.sched_v, conc::SC_CTRL, TRUE);
    out.push_str(&format!("{}", b.control_waiting() as u32));
    out.push(' ');
    let mut c = fresh();
    let cp = mk_system_port(&mut c);
    c.system_port = cp;
    c.has_loop = false;
    out.push_str(&format!("{}", c.control_waiting() as u32));
    out.push_str(" | ");

    // 5. SERVE-CONTROL-AT: a queued BIND.
    let mut d = fresh();
    let dp = mk_system_port(&mut d);
    d.system_port = dp;
    mk_port(&mut d, 5);
    d.inbox.push((0, 49)); // op 1 (bind), port id 5: 1 + 8*(5+1) = 49
    d.serve_control_at();
    out.push_str(&format!("spawn={} bound={} ctrl={} left={}",
        joined(&d.spawn_calls), bound_ids(&d), ctrl(&d), d.inbox.len()));
    out.push_str(" | ");

    // 6. An UNBIND of an already-bound port.
    let mut e = fresh();
    let ep = mk_system_port(&mut e);
    e.system_port = ep;
    let up = mk_port(&mut e, 7);
    let b0 = e.vec_conj(e.empty, up);
    e.set(e.sched_v, conc::SC_BOUND, b0);
    e.inbox.push((0, 66)); // op 2 (unbind), port id 7: 2 + 8*(7+1) = 66
    e.serve_control_at();
    out.push_str(&format!("closed={} bound={} ctrl={}",
        joined(&e.closed), bound_ids(&e), ctrl(&e)));
    out.push_str(" | ");

    // 7. A CLOSE, with two ports already bound, and a message left queued
    //    behind it.
    let mut f = fresh();
    let fp = mk_system_port(&mut f);
    f.system_port = fp;
    let p3 = mk_port(&mut f, 3);
    let p4 = mk_port(&mut f, 4);
    let fb0 = f.vec_conj(f.empty, p3);
    let fb1 = f.vec_conj(fb0, p4);
    f.set(f.sched_v, conc::SC_BOUND, fb1);
    f.inbox.push((0, 3));   // op 3 (close), no port: 3 + 8*0 = 3
    f.inbox.push((0, 999)); // left queued -- `:close` returns without it
    f.serve_control_at();
    out.push_str(&format!("closed={} bound={} ctrl={} left={}",
        joined(&f.closed), bound_ids(&f), ctrl(&f), f.inbox.len()));
    out.push_str(" | ");

    // 8. A SNAPSHOT, with a message left queued behind it because
    //    `snapshot-idle` goes false once `snapshot-begin` has run.
    let mut g = fresh();
    let gp = mk_system_port(&mut g);
    g.system_port = gp;
    mk_port(&mut g, 2);
    g.inbox.push((0, 28));  // op 4 (snapshot), port id 2: 4 + 8*(2+1) = 28
    g.inbox.push((0, 999)); // left queued -- serving STOPS
    g.serve_control_at();
    out.push_str(&format!("snap={} ctrl={} left={}",
        joined(&g.snap_calls), ctrl(&g), g.inbox.len()));
    out.push_str(" | ");

    // 9. THE SYSTEM PORT DRAINED AND CLOSED: no message waiting, and the
    //    host end is gone.
    let mut h = fresh();
    let hp = mk_system_port(&mut h);
    h.system_port = hp;
    let p9 = mk_port(&mut h, 9);
    let p10 = mk_port(&mut h, 10);
    let hb0 = h.vec_conj(h.empty, p9);
    let hb1 = h.vec_conj(hb0, p10);
    h.set(h.sched_v, conc::SC_BOUND, hb1);
    h.drained = true;
    h.serve_control_at();
    out.push_str(&format!("closed={} bound={} ctrl={}",
        joined(&h.closed), bound_ids(&h), ctrl(&h)));

    println!("{out}");
}
