--rust-head
// A TOY HEAP, enough to drive the FRAME LOGIC and nothing more.
//
// The frames are what this file exists to pin: the marker, its sign, and the
// bound. So `Value` models the real 48-bit fixnum EXACTLY -- payload masked to
// 48 bits, read back sign-extended -- because that width is the property under
// test. A driver that used a plain i64 would agree on all three targets and
// prove nothing about the thing that broke.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
const TRUE: Value = Value(0xFFFF_0000_0000_0001);
const NOT_FOUND: Value = Value(0xFFFF_0000_0000_0002);
const TY_WRITER: u8 = 52;
const TY_READER: u8 = 53;
const TY_BYTES: u8 = 20;
const TY_VEC: u8 = 9;
mod codec {
    pub const WR_BUF: u32 = 0;
    pub const WR_LIVE: u32 = 1;
    pub const WR_NEED: u32 = 2;
    pub const WR_LEN: u32 = 3;
    pub const RD_BYTES: u32 = 0;
    pub const RD_POS: u32 = 1;
    pub const RD_LIVE: u32 = 2;
    pub const RD_LEN: u32 = 3;
    pub const MAX_CELLS: i64 = 1 << 40;
}
impl Value {
    fn is_nil(self) -> bool { self == NIL }
    fn as_heap(self) -> usize { self.0 as usize }
    fn fixnum(n: i64) -> Value { Value((0xD << 60) | ((n as u64) & 0x0000_FFFF_FFFF_FFFF)) }
    fn as_fixnum(self) -> i64 { ((self.0 << 16) as i64) >> 16 }
}
struct Obj { ty: u8, slots: Vec<Value> }
struct Rt { objs: Vec<Obj>, roots: Vec<Value>, full: bool }
impl Rt {
    fn obj(&mut self, ty: u8, slots: Vec<Value>) -> Value {
        self.objs.push(Obj { ty, slots });
        Value((self.objs.len() - 1) as u64)
    }
    fn new_obj(&mut self, ty: u8, n: u32) -> Value {
        let s = vec![NIL; n as usize];
        self.obj(ty, s)
    }
    fn is_heap_ty(&self, v: Value, t: u8) -> bool {
        v != NIL && v != TRUE && v != NOT_FOUND && (v.0 >> 60) != 0xD
            && (v.0 as usize) < self.objs.len() && self.objs[v.0 as usize].ty == t
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.as_heap()].slots[i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.as_heap()].slots[i as usize] = x; }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    // PERSISTENT, like the real ones: every one answers a NEW vector, which is
    // why the state machine has to write the result back into its root.
    fn empty_vec(&mut self) -> Value { self.obj(TY_VEC, Vec::new()) }
    fn vec_count(&self, v: Value) -> u32 { self.objs[v.as_heap()].slots.len() as u32 }
    fn vec_nth(&self, v: Value, i: u32, d: Value) -> Value {
        *self.objs[v.as_heap()].slots.get(i as usize).unwrap_or(&d)
    }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let mut s = self.objs[v.as_heap()].slots.clone();
        s.push(x);
        self.obj(TY_VEC, s)
    }
    fn vec_pop(&mut self, v: Value) -> Value {
        let mut s = self.objs[v.as_heap()].slots.clone();
        s.pop();
        self.obj(TY_VEC, s)
    }
    fn vec_assoc(&mut self, v: Value, i: u32, x: Value) -> Value {
        let mut s = self.objs[v.as_heap()].slots.clone();
        s[i as usize] = x;
        self.obj(TY_VEC, s)
    }
    // A byte string is an object of bytes-as-fixnums. Enough for the writer to
    // append into and for the reader to walk.
    fn b_empty(&mut self) -> Value { self.obj(TY_BYTES, Vec::new()) }
    fn b_transient(&mut self, v: Value) -> Value {
        let s = self.objs[v.as_heap()].slots.clone();
        self.obj(TY_BYTES, s)
    }
    fn b_persistent(&mut self, v: Value) -> Value { v }
    fn b_count(&self, v: Value) -> u32 { self.objs[v.as_heap()].slots.len() as u32 }
    fn b_at(&self, v: Value, i: u32, d: Value) -> Value {
        *self.objs[v.as_heap()].slots.get(i as usize).unwrap_or(&d)
    }
    // A BUFFER THAT CAN REFUSE TO GROW. The real `b-conj` answers NIL when
    // `tb-flush` cannot allocate a fresh tail, and `full` is how the driver
    // reaches that case without a heap to exhaust.
    fn b_conj(&mut self, v: Value, b: u32) -> Value {
        if self.full {
            return NIL;
        }
        let mut s = self.objs[v.as_heap()].slots.clone();
        s.push(Value::fixnum(b as i64));
        self.obj(TY_BYTES, s)
    }
--rust
}
fn b(x: bool) -> u32 { if x { 1 } else { 0 } }
fn main() {
    let mut rt = Rt { objs: Vec::new(), roots: Vec::new(), full: false };
    // 1. A well-formed table: one column, named and typed, then one row.
    let w = rt.wire_writer();
    let ok1 = b(rt.wire_open_table(w, 1))
        + 2 * b(rt.wire_expect_value(w, 0)) + 4 * b(rt.wire_expect_value(w, 0))
        + 8 * b(rt.wire_expect_rowcount(w, 1)) + 16 * b(rt.wire_expect_value(w, 0))
        + 32 * b(rt.wire_complete(w));
    // 2. A VALUE where the count is due -- the refusal the marker exists for.
    let w2 = rt.wire_writer();
    rt.wire_open_table(w2, 1);
    rt.wire_expect_value(w2, 0);
    rt.wire_expect_value(w2, 0);
    let ok2 = b(rt.wire_expect_value(w2, 0));
    // 3. A row count where no table is open.
    let w3 = rt.wire_writer();
    let ok3 = b(rt.wire_expect_rowcount(w3, 1));
    // 4. An EMPTY table completes on its row count.
    let w4 = rt.wire_writer();
    rt.wire_open_table(w4, 1);
    rt.wire_expect_value(w4, 0);
    rt.wire_expect_value(w4, 0);
    let ok4 = b(rt.wire_expect_rowcount(w4, 0)) + 2 * b(rt.wire_complete(w4));
    // 5. THE PRODUCT BOUND, on a frame built by multiplying.
    let w5 = rt.wire_writer();
    rt.wire_open_table(w5, 2);
    for _ in 0..4 { rt.wire_expect_value(w5, 0); }
    let ok5 = b(rt.wire_expect_rowcount(w5, 1 << 40));
    // 6. THE MARKER'S SIGN, read straight back out of a frame. This is the
    // field that caught a 32-bit mask on the ports.
    let w6 = rt.wire_writer();
    rt.wire_open_table(w6, 3);
    let need = rt.slot(w6, codec::WR_NEED);
    let deep = rt.vec_count(need);
    let marker = rt.vec_nth(need, deep - 2, NOT_FOUND).as_fixnum();
    // 7. A BUFFER THAT CANNOT GROW. Two answers, and the second is the one
    //    that matters: `wire-byte` must refuse (0), and it must leave `WR_BUF`
    //    ALONE. A version that returns false and still stores the NIL passes
    //    on the return alone, and that version is what hung a host.
    let w7 = rt.wire_writer();
    let before = rt.slot(w7, codec::WR_BUF);
    rt.full = true;
    let refused = b(!rt.wire_byte(w7, 7));
    let intact = b(rt.slot(w7, codec::WR_BUF) == before);
    rt.full = false;
    // AND IT STILL WORKS AFTERWARDS: a refusal is not a kill. The writer was
    // never finished, so once the buffer can grow again the byte goes on.
    let again = b(rt.wire_byte(w7, 7));
    let ok7 = refused + 2 * intact + 4 * again;
    println!("{} {} {} {} {} {} {}", ok1, ok2, ok3, ok4, ok5, marker, ok7);
}
