    internal const long NIL = unchecked((long) 0xFFFF000000000000UL);
    internal const long TRUE = unchecked((long) 0xFFFF000000000001UL);
    internal const long NOT_FOUND = unchecked((long) 0xFFFF000000000002UL);
    internal const int TY_BYTES = 20, TY_VEC = 9;
    // C# PASCALISES the type tags, which is exactly the spelling difference
    // `kin/src/flint/impl/rt.cljc` keeps a table for.
    internal static class Obj { internal const int TyWriter = 52, TyReader = 53; }
    internal static class Codec { internal const long MAX_CELLS = 1L << 40; }
    internal static class Wire {
        internal const int WR_BUF = 0, WR_LIVE = 1, WR_NEED = 2, WR_LEN = 3;
        internal const int RD_BYTES = 0, RD_POS = 1, RD_LIVE = 2, RD_LEN = 3;
    }
    internal static class Val {
        internal const long Nil = Probe.NIL, True = Probe.TRUE, NotFound = Probe.NOT_FOUND;
        internal static bool IsNil(long v) => v == NIL;
        internal static int AsHeap(long v) => (int) v;
        internal static long Fixnum(long n) =>
            unchecked((long) ((0xDUL << 60) | ((ulong) n & 0x0000FFFFFFFFFFFFUL)));
        internal static long AsFixnum(long v) => (v << 16) >> 16;
    }
    internal sealed class Cell { internal int Ty; internal System.Collections.Generic.List<long> Slots = new(); }
    internal sealed class Rt {
        internal System.Collections.Generic.List<Cell> Objs = new();
        internal System.Collections.Generic.List<long> Roots = new();
        // A BUFFER THAT CAN REFUSE TO GROW -- see the Rust driver.
        internal bool Full = false;
        internal long MakeObj(int ty, System.Collections.Generic.List<long> s) {
            Objs.Add(new Cell { Ty = ty, Slots = s });
            return Objs.Count - 1;
        }
        internal bool IsHeapTy(long v, int t) {
            if (v == NIL || v == TRUE || v == NOT_FOUND) return false;
            if ((ulong) v >> 60 == 0xD) return false;
            return v >= 0 && v < Objs.Count && Objs[(int) v].Ty == t;
        }
        internal long Slot(long v, int i) => Objs[(int) v].Slots[i];
        internal void SetSlot(int a, int i, long x) { Objs[a].Slots[i] = x; }
        internal int Mark() => Roots.Count;
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) => Roots[i];
        internal void SetR(int i, long v) { Roots[i] = v; }
        internal void PopTo(int n) { while (Roots.Count > n) Roots.RemoveAt(Roots.Count - 1); }
    }
    internal static class Conc {
        internal static long NewObj(Rt rt, int ty, int n) {
            var s = new System.Collections.Generic.List<long>();
            for (int i = 0; i < n; i++) s.Add(NIL);
            return rt.MakeObj(ty, s);
        }
    }
    static System.Collections.Generic.List<long> Copy(Rt rt, long v) =>
        new System.Collections.Generic.List<long>(rt.Objs[(int) v].Slots);
    internal static class Vec { internal static long Empty(Rt rt) => rt.MakeObj(TY_VEC, new System.Collections.Generic.List<long>()); }
    static int VecCount(Rt rt, long v) => rt.Objs[(int) v].Slots.Count;
    static long VecNth(Rt rt, long v, int i, long d) {
        var s = rt.Objs[(int) v].Slots;
        return (i < 0 || i >= s.Count) ? d : s[i];
    }
    static long VecConj(Rt rt, long v, long x) {
        var s = Copy(rt, v); s.Add(x); return rt.MakeObj(TY_VEC, s);
    }
    static long VecPop(Rt rt, long v) {
        var s = Copy(rt, v);
        if (s.Count > 0) s.RemoveAt(s.Count - 1);
        return rt.MakeObj(TY_VEC, s);
    }
    static long VecAssoc(Rt rt, long v, int i, long x) {
        var s = Copy(rt, v); s[i] = x; return rt.MakeObj(TY_VEC, s);
    }
    static long BEmpty(Rt rt) => rt.MakeObj(TY_BYTES, new System.Collections.Generic.List<long>());
    static long BTransient(Rt rt, long v) => rt.MakeObj(TY_BYTES, Copy(rt, v));
    static long BPersistent(Rt rt, long v) => v;
    static int BCount(Rt rt, long v) => rt.Objs[(int) v].Slots.Count;
    static long BAt(Rt rt, long v, int i, long d) {
        var s = rt.Objs[(int) v].Slots;
        return (i < 0 || i >= s.Count) ? d : s[i];
    }
    static long BConj(Rt rt, long v, int x) {
        if (rt.Full) return NIL;
        var s = Copy(rt, v); s.Add(Val.Fixnum(x)); return rt.MakeObj(TY_BYTES, s);
    }
