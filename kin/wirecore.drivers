    static final long NIL = 0xFFFF000000000000L;
    static final long TRUE = 0xFFFF000000000001L;
    static final long NOT_FOUND = 0xFFFF000000000002L;
    static final int TY_WRITER = 52, TY_READER = 53, TY_BYTES = 20, TY_VEC = 9;
    static final class Codec { static final long MAX_CELLS = 1L << 40; }
    static final class Wire {
        static final int WR_BUF = 0, WR_LIVE = 1, WR_NEED = 2, WR_LEN = 3;
        static final int RD_BYTES = 0, RD_POS = 1, RD_LIVE = 2, RD_LEN = 3;
    }
    static final class Val {
        static final long NIL = Probe.NIL, TRUE = Probe.TRUE, NOT_FOUND = Probe.NOT_FOUND;
        static boolean isNil(long v) { return v == NIL; }
        static int asHeap(long v) { return (int) v; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0x0000FFFFFFFFFFFFL); }
        static long asFixnum(long v) { return (v << 16) >> 16; }
    }
    static final class Obj { int ty; java.util.ArrayList<Long> slots = new java.util.ArrayList<>(); }
    static final class Rt {
        java.util.ArrayList<Obj> objs = new java.util.ArrayList<>();
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        // A BUFFER THAT CAN REFUSE TO GROW -- see the Rust driver.
        boolean full = false;
        long obj(int ty, java.util.ArrayList<Long> s) {
            Obj o = new Obj(); o.ty = ty; o.slots = s; objs.add(o);
            return objs.size() - 1;
        }
        boolean isHeapTy(long v, int t) {
            if (v == NIL || v == TRUE || v == NOT_FOUND) return false;
            if ((v >>> 60) == 0xD) return false;
            return v >= 0 && v < objs.size() && objs.get((int) v).ty == t;
        }
        long slot(long v, int i) { return objs.get((int) v).slots.get(i); }
        void setSlot(int a, int i, long x) { objs.get(a).slots.set(i, x); }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
    }
    static final class Conc {
        static long newObj(Rt rt, int ty, int n) {
            java.util.ArrayList<Long> s = new java.util.ArrayList<>();
            for (int i = 0; i < n; i++) s.add(NIL);
            return rt.obj(ty, s);
        }
    }
    static java.util.ArrayList<Long> copy(Rt rt, long v) {
        return new java.util.ArrayList<>(rt.objs.get((int) v).slots);
    }
    static final class Vec { static long empty(Rt rt) { return rt.obj(TY_VEC, new java.util.ArrayList<>()); } }
    static int vecCount(Rt rt, long v) { return rt.objs.get((int) v).slots.size(); }
    static long vecNth(Rt rt, long v, int i, long d) {
        java.util.ArrayList<Long> s = rt.objs.get((int) v).slots;
        return (i < 0 || i >= s.size()) ? d : s.get(i);
    }
    static long vecConj(Rt rt, long v, long x) {
        java.util.ArrayList<Long> s = copy(rt, v); s.add(x); return rt.obj(TY_VEC, s);
    }
    static long vecPop(Rt rt, long v) {
        java.util.ArrayList<Long> s = copy(rt, v);
        if (!s.isEmpty()) s.remove(s.size() - 1);
        return rt.obj(TY_VEC, s);
    }
    static long vecAssoc(Rt rt, long v, int i, long x) {
        java.util.ArrayList<Long> s = copy(rt, v); s.set(i, x); return rt.obj(TY_VEC, s);
    }
    static long bEmpty(Rt rt) { return rt.obj(TY_BYTES, new java.util.ArrayList<>()); }
    static long bTransient(Rt rt, long v) { return rt.obj(TY_BYTES, copy(rt, v)); }
    static long bPersistent(Rt rt, long v) { return v; }
    static int bCount(Rt rt, long v) { return rt.objs.get((int) v).slots.size(); }
    static long bAt(Rt rt, long v, int i, long d) {
        java.util.ArrayList<Long> s = rt.objs.get((int) v).slots;
        return (i < 0 || i >= s.size()) ? d : s.get(i);
    }
    static long bConj(Rt rt, long v, int x) {
        if (rt.full) return NIL;
        java.util.ArrayList<Long> s = copy(rt, v); s.add(Val.fixnum(x)); return rt.obj(TY_BYTES, s);
    }
