    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long e = BEmpty(rt);
        o.Append("e=").Append(Obj.Ty(rt.gc.sp, e)).Append(',').Append(BCount(rt, e)).Append(' ');
        int[] ks = {0, 1, 2, 5, 10};
        foreach (int k in ks) {
            int bas = rt.Mark();
            for (int j = 0; j < k; j++) rt.Push(Val.Heap(rt.Alloc(Obj.TyBytes, 4)));
            long outv = BFromRoots(rt, bas, k);
            o.Append("n").Append(k).Append('=').Append(Obj.Ty(rt.gc.sp, outv)).Append(',')
             .Append(BCount(rt, outv)).Append(',').Append(BDepth(rt, outv)).Append(' ');
            rt.PopTo(bas);
        }
        int bas2 = rt.Mark();
        long only = Val.Heap(rt.Alloc(Obj.TyBytes, 7));
        rt.Push(only);
        o.Append("same=").Append(BFromRoots(rt, bas2, 1) == only ? 1 : 0).Append(' ');
        rt.PopTo(bas2);
        System.Console.WriteLine(o.ToString());
    }
