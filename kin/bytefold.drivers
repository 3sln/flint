    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long e = bEmpty(rt);
        o.append("e=").append(ty(rt.gc.sp, e)).append(',').append(bCount(rt, e)).append(' ');
        int[] ks = {0, 1, 2, 5, 10};
        for (int k : ks) {
            int base = rt.mark();
            for (int j = 0; j < k; j++) rt.push(Val.heap(rt.alloc(TY_BYTES, 4)));
            long out = bFromRoots(rt, base, k);
            o.append("n").append(k).append('=').append(ty(rt.gc.sp, out)).append(',')
             .append(bCount(rt, out)).append(',').append(bDepth(rt, out)).append(' ');
            rt.popTo(base);
        }
        int base = rt.mark();
        long only = Val.heap(rt.alloc(TY_BYTES, 7));
        rt.push(only);
        o.append("same=").append(bFromRoots(rt, base, 1) == only ? 1 : 0).append(' ');
        rt.popTo(base);
        System.out.println(o.toString());
    }
