--rust-head
extern crate alloc;
type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TRUE: Value = Value(0xFFFE);
const TY_BYTES: u8 = 44; const TY_BROPE: u8 = 45; const TY_TBYTES: u8 = 46;
const TY_VEC: u8 = 9;
// The generated Rust reaches these as `crate::bytes::BB_BYTES`, because in the
// real runtime they live on that module. A probe is its own crate, so it needs
// a module of that name for the same path to resolve.
pub mod rope { pub const FLAT_MAX: u32 = 8; pub const FANOUT: u32 = 3; }
pub mod bytes {
    pub const BB_BYTES: u32 = 0; pub const BB_FLAT: u32 = 1;
    pub const BB_DEPTH: u32 = 2; pub const BB_HASH: u32 = 3; pub const BB_KIDS: u32 = 4;
    pub const TB_TREE: u32 = 0; pub const TB_TAIL: u32 = 1;
    pub const TB_FILL: u32 = 2; pub const TB_LIVE: u32 = 3;
    pub const TAIL_CAP: u32 = 8;
}
impl Value {
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != TRUE.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
// `b_count` and `b_depth` are `bytecore`'s, reached across modules. The probe
// answers them the way the shipped ones do for the shapes this driver builds.
impl Rt {
    fn b_count(&self, v: Value) -> u32 {
        if !v.is_heap() { return 0; }
        match ty(&self.gc.sp, v.as_heap()) {
            TY_BYTES => self.olen(v),
            TY_BROPE => self.slot(v, bytes::BB_BYTES).as_fixnum() as u32,
            _ => 0,
        }
    }
    fn b_depth(&self, v: Value) -> u32 {
        if v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_BROPE {
            self.slot(v, bytes::BB_DEPTH).as_fixnum() as u32
        } else { 0 }
    }
    // `bytenode`'s, reproduced: the driver needs real tree behaviour, not a
    // placeholder, or the tiers below cannot be told apart.
    fn b_node(&mut self, base: usize, n: u32) -> Value {
        let mut total = 0u32;
        for i in 0..n { total += self.b_count(self.r(base + i as usize)); }
        let a = self.alloc(TY_BROPE, bytes::BB_KIDS + n);
        if a == 0 { return NIL; }
        self.set_slot(a, bytes::BB_BYTES, Value::fixnum(total as i64));
        self.set_slot(a, bytes::BB_FLAT, NIL);
        self.set_slot(a, bytes::BB_HASH, NIL);
        let d = self.b_depth(self.r(base)) + 1;
        self.set_slot(a, bytes::BB_DEPTH, Value::fixnum(d as i64));
        for i in 0..n { let v = self.r(base + i as usize); self.set_slot(a, bytes::BB_KIDS + i, v); }
        Value::heap(a)
    }
    fn b_wrap_to(&mut self, v: Value, d: u32) -> Value {
        let base = self.mark();
        let ci = self.push(v);
        while self.b_depth(self.r(ci)) < d {
            let w = self.b_node(ci, 1);
            self.set_r(ci, w);
        }
        let out = self.r(ci);
        self.pop_to(base);
        out
    }
    // The half of `Bytes` that is still hand-written. A leaf is modelled by its
    // LENGTH alone here, so joining two is a leaf of the summed length.
    fn b_copy_concat(&mut self, a: Value, b: Value) -> Value {
        let n = self.b_count(a) + self.b_count(b);
        let x = self.alloc(TY_BYTES, n);
        if x == 0 { return NIL; }
        Value::heap(x)
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: vec![0u8; 40000] },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    // EMPTY: a leaf, not nil, and zero long.
    let e = rt.b_empty();
    o.push_str(&format!("e={},{} ", ty(&rt.gc.sp, e.as_heap()), rt.b_count(e)));
    // FANOUT is 3 in this fixture, so the level counts are visible: 5 pieces
    // fold to 2 nodes then 1 (depth 2), and 10 fold 4 -> 2 -> 1 (depth 3).
    for k in [0u32, 1, 2, 5, 10].iter() {
        let base = rt.mark();
        for _ in 0..*k { let l = Value::heap(rt.alloc(TY_BYTES, 4)); rt.push(l); }
        let out = rt.b_from_roots(base, *k);
        o.push_str(&format!("n{}={},{},{} ", k, ty(&rt.gc.sp, out.as_heap()),
                            rt.b_count(out), rt.b_depth(out)));
        rt.pop_to(base);
    }
    // ONE piece is handed back UNCHANGED -- not wrapped in a node of one.
    let base = rt.mark();
    let only = Value::heap(rt.alloc(TY_BYTES, 7));
    rt.push(only);
    o.push_str(&format!("same={} ", (rt.b_from_roots(base, 1).0 == only.0) as u32));
    rt.pop_to(base);
    println!("{}", o);
}
