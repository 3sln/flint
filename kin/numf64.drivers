    static final class Val { static final long CANONICAL_NAN = 0x7FF8000000000000L;
        static boolean isDouble(long v) { return (v >>> 60) == 2; } }
    static long fix(long n) { return 0x1000000000000000L | (n & 0x0FFFFFFFFFFFFFFFL); }
    static long big(long i) { return 0x3000000000000000L | i; }
    static long dbl(long i) { return 0x2000000000000000L | i; }
    static double doubleValue(long v) { return (v & 0xFF) / 2.0; }
    static final class Rt { long[] boxes = new long[4]; }
    // `is-int` is a generated SIBLING, from `kin/numkind.kin`, so it is
    // called bare here where native calls it on the `Rt`.
    static boolean isInt(Rt rt, long v) { return (v >>> 60) == 1 || (v >>> 60) == 3; }
    static final class Num {
        static long i64Of(Rt rt, long v) {
            if ((v >>> 60) == 3) return rt.boxes[(int) (v & 0xFF)];
            return (v << 4) >> 4;
        }
    }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.boxes[0] = 9007199254740993L; rt.boxes[1] = 9007199254740992L;
        StringBuilder o = new StringBuilder();
        long[] vs = { fix(3), fix(-7), big(0), dbl(3), 0L };
        for (long v : vs) {
            // RAW. `doubleToLongBits` canonicalises every NaN it is shown and
            // would print 7FF8... whatever it was handed, which is precisely
            // the divergence this file exists to pin.
            o.append(String.format("%016X ", Double.doubleToRawLongBits(numberF64(rt, v))));
        }
        o.append('|');
        long[][] ps = { {fix(1), fix(2)}, {fix(2), fix(1)}, {fix(2), fix(2)},
                        {big(0), big(1)}, {big(1), big(0)},
                        {fix(1), dbl(3)}, {0L, fix(1)}, {fix(1), 0L} };
        for (long[] p : ps) o.append(' ').append(numberCmp(rt, p[0], p[1]));
        System.out.println(o);
    }
