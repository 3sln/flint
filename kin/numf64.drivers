--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
// `CANONICAL_NAN` resolves to `crate::value::CANONICAL_NAN`, so the probe
// declares that module rather than a bare constant. ITS VALUE IS THE POINT
// OF THIS FILE and is written out here in all three probes: if a runtime
// ever disagrees about it, these three lines are where it shows.
pub mod value { pub const CANONICAL_NAN: u64 = 0x7FF8_0000_0000_0000; }
struct Rt { boxes: Vec<i64> }
// A FIXNUM holds its own value, a BIGINT is an index into `boxes`, and a
// DOUBLE holds twice its value in the low byte. The bigint tier is not
// decoration: the pair of integers below differ by one and are the SAME
// double, so the toy has to be able to hand back a real i64.
fn fix(n: i64) -> Value { Value(0x1000_0000_0000_0000u64 | (n as u64 & 0x0FFF_FFFF_FFFF_FFFF)) }
fn big(i: u64) -> Value { Value(0x3000_0000_0000_0000u64 | i) }
fn dbl(i: u64) -> Value { Value(0x2000_0000_0000_0000u64 | i) }
impl Value {
    fn is_double(self) -> bool { (self.0 >> 60) == 2 }
}
fn double_value(v: Value) -> f64 { (v.0 & 0xFF) as f64 / 2.0 }
impl Rt {
    fn is_int(&self, v: Value) -> bool { (v.0 >> 60) == 1 || (v.0 >> 60) == 3 }
    fn i64_of(&self, v: Value) -> i64 {
        if (v.0 >> 60) == 3 { return self.boxes[(v.0 & 0xFF) as usize]; }
        ((v.0 & 0x0FFF_FFFF_FFFF_FFFF) << 4) as i64 >> 4
    }
--rust
}
fn main() {
    // boxes[0] = 2^53 + 1, boxes[1] = 2^53. Adjacent integers, one double.
    let rt = Rt { boxes: vec![9007199254740993, 9007199254740992] };
    let mut o = String::new();
    for v in [fix(3), fix(-7), big(0), dbl(3), Value(0)] {
        o.push_str(&format!("{:016X} ", rt.number_f64(v).to_bits()));
    }
    o.push('|');
    for (a, b) in [(fix(1), fix(2)), (fix(2), fix(1)), (fix(2), fix(2)),
                   (big(0), big(1)), (big(1), big(0)),
                   (fix(1), dbl(3)), (Value(0), fix(1)), (fix(1), Value(0))] {
        o.push_str(&format!(" {}", rt.number_cmp(a, b)));
    }
    println!("{}", o);
}
