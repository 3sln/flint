        long one = fix(1), negone = fix(-1), bad = 0L;
        o.append(" add=").append(run(rt, () -> numAdd(rt, fix(2), fix(3))));
        o.append(" sub=").append(run(rt, () -> numSub(rt, fix(7), fix(3))));
        o.append(" mul=").append(run(rt, () -> numMul(rt, fix(6), fix(7))));
        o.append(" maxinc=").append(run(rt, () -> numAdd(rt, max, one)));
        o.append(" mindec=").append(run(rt, () -> numSub(rt, min, one)));
        o.append(" maxok=").append(run(rt, () -> numAdd(rt, max, negone)));
        o.append(" minok=").append(run(rt, () -> numSub(rt, min, negone)));
        o.append(" mulmax=").append(run(rt, () -> numMul(rt, max, two)));
        o.append(" mulmin=").append(run(rt, () -> numMul(rt, min, two)));
        o.append(" minneg=").append(run(rt, () -> numMul(rt, min, negone)));
        o.append(" negmin=").append(run(rt, () -> numMul(rt, negone, min)));
        o.append(" mulok=").append(run(rt, () -> numMul(rt, max, one)));
        o.append(" mulzero=").append(run(rt, () -> numMul(rt, min, fix(0))));
        o.append(" dbl=").append(run(rt, () -> numAdd(rt, dbl(3), dbl(5))));
        o.append(" mixed=").append(run(rt, () -> numMul(rt, dbl(4), fix(3))));
