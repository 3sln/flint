// `hash-double` is `com.flint.rt.Hash.hashDouble` on this target -- fully
// qualified, because a generated module sits in a different package from the
// hand-written runtime. A class nested in `Probe` cannot answer to that name,
// so the shim is a real file in a real package.
package com.flint.rt;
public class Hash {
    public static int hashDouble(double d) { return (int) (long) d ^ 0xd0b1; }
}
