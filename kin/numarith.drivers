#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
pub mod hash { pub fn hash_double(d: f64) -> u32 { (d as i64 as u32) ^ 0xd0b1 } }
fn hash_long(n: i64) -> u32 { (n as u32) ^ 0x5eed }
const NIL: Value = Value(0xFFFF);
struct Rt { thrown: String, boxes: Vec<i64> }
// `f-trunc` resolves to `crate::fmath::trunc`, so the probe declares that
// module rather than a bare function.
pub mod fmath { pub fn trunc(d: f64) -> f64 { if d < 0.0 { libm_ceil(d) } else { libm_floor(d) } }
    fn libm_floor(d: f64) -> f64 { let t = d as i64 as f64; if t > d { t - 1.0 } else { t } }
    fn libm_ceil(d: f64) -> f64 { let t = d as i64 as f64; if t < d { t + 1.0 } else { t } } }
// A FIXNUM holds its value; a BIGINT is an index into `boxes`, so the probe
// can hand `is-int` a value that is not a fixnum and still get a real number
// out of `i64-of` -- which is the pair that replaced `Option<i64>`.
impl Value {
    fn is_double(self) -> bool { (self.0 >> 60) == 2 }
}
fn fix(n: i64) -> Value { Value(0x1000_0000_0000_0000u64 | (n as u64 & 0x0FFF_FFFF_FFFF_FFFF)) }
fn big(i: u64) -> Value { Value(0x3000_0000_0000_0000u64 | i) }
fn dbl(i: u64) -> Value { Value(0x2000_0000_0000_0000u64 | i) }
impl Rt {
    fn is_int(&self, v: Value) -> bool { (v.0 >> 60) == 1 || (v.0 >> 60) == 3 }
    fn i64_of(&self, v: Value) -> i64 {
        if (v.0 >> 60) == 3 { return self.boxes[(v.0 & 0xFF) as usize]; }
        ((v.0 & 0x0FFF_FFFF_FFFF_FFFF) << 4) as i64 >> 4
    }
    fn is_number(&self, v: Value) -> bool { self.is_int(v) || v.is_double() }
    fn num_f64(&self, v: Value) -> f64 {
        if v.is_double() { return (v.0 & 0xFF) as f64 / 2.0; }
        self.i64_of(v) as f64
    }
    // The ANSWERS are tagged so the probe can tell an integer result from a
    // double one without a printer.
    // A 60-BIT FIXNUM CANNOT HOLD AN ANSWER NEAR THE 64-BIT EDGE, and every
    // interesting case here is near it. Spilling to a BIGINT is what makes
    // `maxok` and `minok` report the number they computed rather than the
    // low sixty bits of it -- without this the probe still agrees across
    // three targets, and agrees on a truncation.
    fn integer(&mut self, n: i64) -> Value {
        if n >= -(1i64 << 59) && n < (1i64 << 59) { return fix(n); }
        self.boxes.push(n); big((self.boxes.len() - 1) as u64)
    }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn throw_not_a_number(&mut self, _a: Value, _b: Value) -> Value {
        self.thrown = alloc::string::String::from("ClassCastException/not a number"); NIL
    }
}
impl Value {
    fn from_f64(d: f64) -> Value { Value(0x2000_0000_0000_0000u64 | ((d * 2.0) as i64 as u64 & 0xFF)) }
}
impl Rt {
    fn both_ints(&mut self, a: Value, b: Value) -> bool { self.is_int(a) && self.is_int(b) }
--rust
}
extern crate alloc;
fn show(rt: &Rt, v: Value) -> String {
    if v.0 == NIL.0 { return String::from("!"); }
    if v.is_double() { return format!("d{}", rt.num_f64(v)); }
    format!("i{}", rt.i64_of(v))
}
fn main() {
    // Index 0 is the MOST NEGATIVE integer, and it is a BIGINT so that the
    // `is-int`/`i64-of` pair is what finds it rather than `is-fixnum`.
    let mut rt = Rt { thrown: String::new(), boxes: vec![i64::MIN, i64::MAX, 2] };
    let mut o = String::new();
    let (min, max, two) = (big(0), big(1), big(2));
    let one = fix(1);
    let negone = fix(-1);
    let bad = Value(0);
    macro_rules! go { ($label:expr, $e:expr) => {{
        rt.thrown = String::new();
        let r = $e;
        o.push_str(&format!(" {}={}", $label, if rt.thrown.is_empty() { show(&rt, r) } else { rt.thrown.clone() }));
    }}; }
    go!("add", rt.num_add(fix(2), fix(3)));
    go!("sub", rt.num_sub(fix(7), fix(3)));
    go!("mul", rt.num_mul(fix(6), fix(7)));
    // THE EDGES, each of which a host's own checked arithmetic used to own.
    go!("maxinc", rt.num_add(max, one));
    go!("mindec", rt.num_sub(min, one));
    go!("maxok", rt.num_add(max, negone));
    go!("minok", rt.num_sub(min, negone));
    go!("mulmax", rt.num_mul(max, two));
    go!("mulmin", rt.num_mul(min, two));
    // `MIN * -1` is the pair with no positive answer, and it is NOT a special
    // case in the source -- it falls out of the both-negative quadrant.
    go!("minneg", rt.num_mul(min, negone));
    go!("negmin", rt.num_mul(negone, min));
    go!("mulok", rt.num_mul(max, one));
    go!("mulzero", rt.num_mul(min, fix(0)));
    // The double arm, and the mixed arm that promotes.
    go!("dbl", rt.num_add(dbl(3), dbl(5)));
    go!("mixed", rt.num_mul(dbl(4), fix(3)));
    go!("notnum", rt.num_add(bad, fix(1)));
    // `==` ACROSS THE TIERS, which is the whole difference from `=`.
    o.push_str(&format!(" eqii={}", rt.num_eq(fix(3), fix(3))));
    o.push_str(&format!(" nei={}", rt.num_eq(fix(3), fix(4))));
    o.push_str(&format!(" eqid={}", rt.num_eq(fix(2), dbl(4))));
    o.push_str(&format!(" eqbad={}", rt.num_eq(bad, fix(1))));
    o.push_str(&format!(" eqmin={}", rt.num_eq(min, min)));
    // The two tiers hash SEPARATELY, and a non-number hashes as zero.
    o.push_str(&format!(" hi={}", rt.num_hash(fix(7))));
    o.push_str(&format!(" hd={}", rt.num_hash(dbl(4))));
    o.push_str(&format!(" hbad={}", rt.num_hash(bad)));
    println!("{}", o.trim());
}
