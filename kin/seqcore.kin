;; What a SEQ is, what can become one, and how a list is built.
;;
;; `cons` keeps a COUNT on the cell when the tail's count is known without
;; walking, which is what makes `count` O(1) on a list built by consing. When
;; it is not known -- a lazy seq, a range, anything that has to be walked --
;; the slot holds nil and `count` walks.
;;
;;     TY_CONS  [first, rest, meta, count]
;;
;; `is-seq` and `is-seqable` are different questions and the difference is the
;; whole of why both exist: a vector is not a seq but `seq` accepts one, and a
;; string is neither a heap seq nor excluded.
(ns flint.rt.seqcore
  (:require [flint.impl.rt :refer [defn return if let do comment doc not or ==
                                   != mark push r set-r pop-to alloc set-at
                                   slot heap for as-idx empty-list fixnum
                                   as-fixnum nil? is-heap as-heap ty is-fixnum
                                   + - Rt Value Addr RootIx I32 Ty Bool NIL
                                   C_FIRST C_REST C_META C_COUNT TY_CONS
                                   TY_EMPTY_LIST TY_LAZYSEQ TY_VECSEQ
                                   TY_STRSEQ TY_RANGE TY_VEC is-fixnum
                                   as-fixnum quot I64 and not > < local set]]
            [flint.rt.vector :refer [vec-count]]))

(doc "Is this a SEQ? Six heap tags and nothing else."
     ""
     "Narrower than `sequential?`, which also takes a vector and a map entry,"
     "and narrower than what `seq` accepts, which takes those plus maps, sets"
     "and strings. Three different questions that are easy to conflate: the"
     "JVM's kind table once spelled `sequential?` as `is-vec or is-seq` --"
     "that predicate minus map entries -- so `(sequential? (first (seq m)))`"
     "was false while the method two below it said true.")
(defn ^:pub ^:method ^Bool is-seq [^Rt rt ^Value v]
  (if (not (is-heap v))
    (return false))
  (let [^Ty t (ty rt (as-heap v))]
    (return (or (== t TY_CONS) (== t TY_EMPTY_LIST) (== t TY_LAZYSEQ)
                (== t TY_VECSEQ) (== t TY_STRSEQ) (== t TY_RANGE)))))

(doc "The count of `v` if it is known WITHOUT walking, else nil."
     ""
     "A VALUE and not an absent one: the answer goes straight into a slot that"
     "holds a fixnum or nil, so Rust's `Option<u32>` was being unwrapped into"
     "exactly that, one line later."
     ""
     "It answers `v`'s OWN count. Both ports folded the `+ 1` in here, which"
     "reads fine while `cons` is the only caller and is wrong for `seq-count`,"
     "which wants `v`'s own count -- so the `+ 1` moved to `cons`, and this is"
     "named for what it answers.")
(doc "How many values a range has, or NIL when it will not say."
     ""
     "FIXNUMS ONLY, and that is the whole subtlety. `range-empty` next door"
     "compares its endpoints in f64, which is right for a comparison and"
     "wrong for a count: two f64s near 1e18 are 128 apart, so the subtraction"
     "below would answer a size that is off by more than one. A fixnum is"
     "bounded at 2^47, so the difference cannot overflow an i64 either."
     ""
     "An UNBOUNDED range declines, and so does one whose size will not fit an"
     "int -- `count` answers an I32, and a wrong small number is worse than a"
     "walk that never finishes, which is what Clojure's `(count (range))`"
     "does too.")
(defn ^:method ^Value range-count [^Rt rt ^Value v]
  (let [^Value e (slot rt v 1)]
    (if (nil? rt e)
      (return NIL))
    (let [^Value s0 (slot rt v 0)
          ^Value st (slot rt v 2)]
      (if (not (and (is-fixnum rt s0) (and (is-fixnum rt e) (is-fixnum rt st))))
        (return NIL))
      (let [^I64 a (as-fixnum s0)
            ^I64 b (as-fixnum e)
            ^I64 k (as-fixnum st)]
        (comment "A zero step never advances, and `range-empty` calls that"
                 "empty rather than infinite.")
        (if (== k 0)
          (return (fixnum 0)))
        (local ^:mut ^I64 n)
        (set n 0)
        (if (> k 0)
          (if (< a b)
            (set n (quot (- (+ b (- k 1)) a) k)))
          (if (> a b)
            (set n (quot (- (+ a (- (- 0 k) 1)) b) (- 0 k)))))
        (if (> n 2147483647)
          (return NIL))
        (return (fixnum n))))))

(defn ^:pub ^:method ^Value count-hint [^Rt rt ^Value v]
  (if (nil? rt v)
    (return (fixnum 0)))
  (if (not (is-heap v))
    (return NIL))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_EMPTY_LIST)
      (return (fixnum 0)))
    (if (== t TY_CONS)
      (return (slot rt v C_COUNT)))
    (if (== t TY_VEC)
      (return (fixnum (vec-count rt v))))
    (comment "A RANGE KNOWS ITS SIZE. Clojure's Range is Counted; this walked"
             "instead, so `(count (range 2000000))` cost 11.92s against a"
             "1.40s baseline for every other accessor -- two million steps to"
             "answer what start, end and step already say.")
    (if (== t TY_RANGE)
      (return (range-count rt v)))
    (return NIL)))

(doc "`(cons head tail)`: a cell, counted when the tail's count is known."
     ""
     "Named `cons` and not `cons-cell`: it is what every runtime already calls"
     "it, and a generated name that differs from the one 40 call sites use is"
     "a rename dressed up as a port.")
(defn ^:pub ^:method ^Value cons [^:mut ^Rt rt ^Value head ^Value tail]
  (let [^RootIx base (mark rt)
        ^RootIx h (push rt head)
        ^RootIx t (push rt tail)
        ^Addr a (alloc rt TY_CONS 4)]
    (if (== a 0)
      (do (pop-to rt base)
          (return NIL)))
    (let [^Value hint (count-hint rt (r rt t))]
      (set-at rt a C_FIRST (r rt h))
      (set-at rt a C_REST (r rt t))
      (set-at rt a C_META NIL)
      (comment "The count of the CELL, which is the tail's plus one. Nil when"
               "the tail's is unknown, and then `count` walks.")
      (if (is-fixnum rt hint)
        (set-at rt a C_COUNT (fixnum (+ (as-fixnum hint) 1)))
        (set-at rt a C_COUNT NIL))
      (pop-to rt base)
      (return (heap a)))))

(doc "A list from `n` values rooted at `base`, last-first."
     ""
     "What a variadic arity folds its surplus arguments into -- and it must be"
     "a SEQ, not a vector: `clojure.core/list` is `[& xs] xs`, so a vector here"
     "makes `(list 1 2)` print as `[1 2]`, the right elements in the wrong"
     "shape."
     ""
     "THE LOOP COUNTS UP AND THE INDEX COUNTS DOWN. Rust wrote this as"
     "`for i in (0..n).rev()` and both ports as `for (i = n - 1; i >= 0; i--)`;"
     "kin's `for` is half-open and ASCENDING only. Converging the source is"
     "cheaper than a descending loop form -- one form, three targets, and the"
     "conses happen in the same order they did before."
     ""
     "`n` is tagged `I32` and not `RootIx`. It is a COUNT, and `RootIx` means"
     "an index into the shadow stack; borrowing it here would compile on all"
     "three and tell a reader something false, which is the reason `Ty` and"
     "`Cat` are two tags. The cast back to an index is `as-idx`, which is what"
     "Rust needs and what the ports spell as nothing at all.")
(defn ^:pub ^:method ^Value list-from-roots [^:mut ^Rt rt ^RootIx base ^I32 n]
  (let [^RootIx mk (mark rt)
        ^Value empty (empty-list rt)
        ^RootIx ai (push rt empty)]
    (comment "HOISTED: `empty-list` and `push` both take `&mut self` in Rust,"
             "so nesting them is two mutable borrows at once.")
    (for [^I32 i 0 n]
      (let [^Value x (r rt (+ base (as-idx (- (- n 1) i))))
            ^Value c (cons rt x (r rt ai))]
        (set-r rt ai c)))
    (let [^Value out (r rt ai)]
      (pop-to rt mk)
      (return out))))
