--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_VEC: u8 = 9; const TY_MAPENTRY: u8 = 15; const TY_TAGGED: u8 = 16;
const TY_TABLE: u8 = 17; const TY_TTABLE: u8 = 18; const TY_TABLEREF: u8 = 19;
const TY_ARRAYMAP: u8 = 20; const TY_HASHMAP: u8 = 21; const TY_SET: u8 = 22;
const TY_BYTES: u8 = 23; const TY_BROPE: u8 = 24; const TY_TVEC: u8 = 25;
const TY_TMAP: u8 = 26; const TY_TSET: u8 = 27; const TY_EMPTY_LIST: u8 = 28;
const TY_CONS: u8 = 29; const TY_OTHER: u8 = 30; const TY_STR: u8 = 31;
pub mod table { pub const RF_SCHEMA: u32 = 0; }
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { gc: Gc, bump: u64, thrown: String, vn: u32 }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
// STUBS THAT NAME THEMSELVES, and a `vec_count` that does not: `pop` and
// `peek` both branch on whether the vector is EMPTY, so that one number has to
// be settable rather than announced.
impl Rt {
    fn slot(&self, _v: Value, _i: u32) -> Value { Value(0x500) }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn describe(&mut self, v: Value) -> alloc::string::String {
        if !v.is_heap() { return alloc::string::String::from("a fixnum"); }
        alloc::format!("a #{}", ty(&self.gc.sp, v.as_heap()))
    }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 8;
        self.gc.sp.m[a as usize] = t;
        Value(a)
    }
    fn is_string(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_STR
    }
    fn is_seq(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_CONS
    }
    fn s_count(&mut self, _v: Value) -> u32 { 71 }
    fn vec_count(&mut self, _v: Value) -> u32 { self.vn }
    fn table_count(&mut self, _v: Value) -> u32 { 72 }
    fn ttable_count(&mut self, _v: Value) -> u32 { 73 }
    fn schema_len(&mut self, _s: Value) -> u32 { 74 }
    fn map_count(&mut self, _v: Value) -> u32 { 75 }
    fn set_count(&mut self, _v: Value) -> u32 { 76 }
    fn b_count(&mut self, _v: Value) -> u32 { 77 }
    fn tvec_count(&mut self, _v: Value) -> u32 { 78 }
    fn tmap_count(&mut self, _v: Value) -> u32 { 79 }
    fn tset_count(&mut self, _v: Value) -> u32 { 80 }
    fn seq_count(&mut self, _v: Value) -> u32 { 81 }
    fn vec_pop(&mut self, _v: Value) -> Value { Value(0x901) }
    fn vec_nth(&mut self, _v: Value, i: u32, _d: Value) -> Value { Value(0x910 + i as u64) }
    fn rest(&mut self, _v: Value) -> Value { Value(0x902) }
    fn first(&mut self, _v: Value) -> Value { Value(0x903) }
    fn empty_vec(&mut self) -> Value { Value(0x921) }
    fn empty_map(&mut self) -> Value { Value(0x922) }
    fn empty_set(&mut self) -> Value { Value(0x923) }
    fn empty_list(&mut self) -> Value { Value(0x924) }
}
impl Rt {
--rust
}
extern crate alloc;
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 4000] } }, bump: 100,
                      thrown: String::new(), vn: 5 };
    let mut o = String::new();
    o.push_str(&format!("nil={} ", rt.count_of(NIL)));
    let s = rt.obj(TY_STR);
    o.push_str(&format!("str={} ", rt.count_of(s)));
    for t in [TY_VEC, TY_MAPENTRY, TY_TAGGED, TY_TABLE, TY_TTABLE, TY_TABLEREF,
              TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_BYTES, TY_BROPE, TY_TVEC,
              TY_TMAP, TY_TSET, TY_EMPTY_LIST, TY_CONS] {
        let v = rt.obj(t);
        o.push_str(&format!("{} ", rt.count_of(v)));
    }
    // A HEAP VALUE IT DOES NOT KNOW, and a value that is not on the heap:
    // both refuse, and the message names what arrived.
    rt.thrown.clear();
    let unknown = rt.obj(TY_OTHER);
    o.push_str(&format!("unk={}|{}| ", rt.count_of(unknown), rt.thrown));
    rt.thrown.clear();
    o.push_str(&format!("fix={}|{}| ", rt.count_of(Value(7)), rt.thrown));

    // POP: the vector arm branches on empty, and everything else is `rest`.
    let v = rt.obj(TY_VEC);
    o.push_str(&format!("pop={:x} ", rt.pop_of(v).0));
    rt.vn = 0;
    rt.thrown.clear();
    let _ = rt.pop_of(v);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.vn = 5;
    rt.thrown.clear();
    let el = rt.obj(TY_EMPTY_LIST);
    let _ = rt.pop_of(el);
    o.push_str(&format!("|{}| ", rt.thrown));
    let c = rt.obj(TY_CONS);
    o.push_str(&format!("popc={:x} ", rt.pop_of(c).0));
    rt.thrown.clear();
    let _ = rt.pop_of(NIL);
    o.push_str(&format!("|{}| ", rt.thrown));

    // PEEK: the same two ends, and NIL rather than a refusal when empty.
    o.push_str(&format!("peek={:x} ", rt.peek_of(v).0));
    rt.vn = 0;
    o.push_str(&format!("peek0={:x} ", rt.peek_of(v).0));
    rt.vn = 5;
    o.push_str(&format!("peekc={:x} peekn={:x} ", rt.peek_of(c).0, rt.peek_of(NIL).0));

    // EMPTY: the shared singleton for each kind, and nil for a non-collection.
    for t in [TY_VEC, TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_CONS, TY_STR] {
        let e = rt.obj(t);
        o.push_str(&format!("{:x} ", rt.empty_of(e).0));
    }
    o.push_str(&format!("{:x}", rt.empty_of(Value(7)).0));
    println!("{}", o);
}
