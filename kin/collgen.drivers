        internal long Slot(long v, int i) { return 0x500L; }
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return NIL; }
        internal long Obj_(int t) { long a = bump; bump += 8; gc.sp.m[(int) a] = (byte) t; return a; }
    }
    internal static string Describe(Rt rt, long v) {
        if (!Val.IsHeap(v)) return "a fixnum";
