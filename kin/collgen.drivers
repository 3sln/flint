    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        o.Append("nil=").Append(CountOf(rt, NIL)).Append(' ');
        long s = rt.Obj_(Obj.TyStr);
        o.Append("str=").Append(CountOf(rt, s)).Append(' ');
        int[] tags = { Obj.TyVec, Obj.TyMapentry, Obj.TyTagged, Obj.TyTable, Obj.TyTtable,
                       Obj.TyTableref, Obj.TyArraymap, Obj.TyHashmap, Obj.TySet, Obj.TyBytes,
                       Obj.TyBrope, Obj.TyTvec, Obj.TyTmap, Obj.TyTset, Obj.TyEmptyList,
                       Obj.TyCons };
        foreach (int t in tags) o.Append(CountOf(rt, rt.Obj_(t))).Append(' ');
        rt.thrown = "";
        long unknown = rt.Obj_(Obj.TyOther);
        o.Append("unk=").Append(CountOf(rt, unknown)).Append("|").Append(rt.thrown).Append("| ");
        rt.thrown = "";
        o.Append("fix=").Append(CountOf(rt, 7L)).Append("|").Append(rt.thrown).Append("| ");

        long v = rt.Obj_(Obj.TyVec);
        o.Append("pop=").Append(PopOf(rt, v).ToString("x")).Append(' ');
        rt.vn = 0;
        rt.thrown = "";
        PopOf(rt, v);
        o.Append("|").Append(rt.thrown).Append("| ");
        rt.vn = 5;
        rt.thrown = "";
        long el = rt.Obj_(Obj.TyEmptyList);
        PopOf(rt, el);
        o.Append("|").Append(rt.thrown).Append("| ");
        long c = rt.Obj_(Obj.TyCons);
        o.Append("popc=").Append(PopOf(rt, c).ToString("x")).Append(' ');
        rt.thrown = "";
        PopOf(rt, NIL);
        o.Append("|").Append(rt.thrown).Append("| ");

        o.Append("peek=").Append(PeekOf(rt, v).ToString("x")).Append(' ');
        rt.vn = 0;
        o.Append("peek0=").Append(PeekOf(rt, v).ToString("x")).Append(' ');
        rt.vn = 5;
        o.Append("peekc=").Append(PeekOf(rt, c).ToString("x"))
         .Append(" peekn=").Append(PeekOf(rt, NIL).ToString("x")).Append(' ');

        int[] empties = { Obj.TyVec, Obj.TyArraymap, Obj.TyHashmap, Obj.TyTableref, Obj.TySet, Obj.TyCons, Obj.TyStr };
        foreach (int t in empties) o.Append(EmptyOf(rt, rt.Obj_(t)).ToString("x")).Append(' ');
        o.Append(EmptyOf(rt, 7L).ToString("x"));
        System.Console.WriteLine(o.ToString());
    }
