    internal const long NIL = 0xFFFFL;
    internal static class Obj {
        internal const int TyVec = 9, TyMapentry = 15, TyTagged = 16;
        internal const int TyTable = 17, TyTtable = 18, TyTableref = 19;
        internal const int TyArraymap = 20, TyHashmap = 21, TySet = 22;
        internal const int TyBytes = 23, TyBrope = 24, TyTvec = 25;
        internal const int TyTmap = 26, TyTset = 27, TyEmptyList = 28;
        internal const int TyCons = 29, TyOther = 30, TyStr = 31;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal static bool IsHeap(long v) { return v >= 100 && v != NIL; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
    }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
