--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        o.append("nil=").append(countOf(rt, NIL)).append(' ');
        long s = rt.obj(TY_STR);
        o.append("str=").append(countOf(rt, s)).append(' ');
        int[] tags = { TY_VEC, TY_MAPENTRY, TY_TAGGED, TY_TABLE, TY_TTABLE, TY_TABLEREF,
                       TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_BYTES, TY_BROPE, TY_TVEC,
                       TY_TMAP, TY_TSET, TY_EMPTY_LIST, TY_CONS };
        for (int t : tags) o.append(countOf(rt, rt.obj(t))).append(' ');
        rt.thrown = "";
        long unknown = rt.obj(TY_OTHER);
        o.append("unk=").append(countOf(rt, unknown)).append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        o.append("fix=").append(countOf(rt, 7L)).append("|").append(rt.thrown).append("| ");

        long v = rt.obj(TY_VEC);
        o.append("pop=").append(Long.toHexString(popOf(rt, v))).append(' ');
        rt.vn = 0;
        rt.thrown = "";
        popOf(rt, v);
        o.append("|").append(rt.thrown).append("| ");
        rt.vn = 5;
        rt.thrown = "";
        long el = rt.obj(TY_EMPTY_LIST);
        popOf(rt, el);
        o.append("|").append(rt.thrown).append("| ");
        long c = rt.obj(TY_CONS);
        o.append("popc=").append(Long.toHexString(popOf(rt, c))).append(' ');
        rt.thrown = "";
        popOf(rt, NIL);
        o.append("|").append(rt.thrown).append("| ");

        o.append("peek=").append(Long.toHexString(peekOf(rt, v))).append(' ');
        rt.vn = 0;
        o.append("peek0=").append(Long.toHexString(peekOf(rt, v))).append(' ');
        rt.vn = 5;
        o.append("peekc=").append(Long.toHexString(peekOf(rt, c)))
         .append(" peekn=").append(Long.toHexString(peekOf(rt, NIL))).append(' ');

        int[] empties = { TY_VEC, TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_CONS, TY_STR };
        for (int t : empties) o.append(Long.toHexString(emptyOf(rt, rt.obj(t)))).append(' ');
        o.append(Long.toHexString(emptyOf(rt, 7L)));
        System.out.println(o.toString());
    }
