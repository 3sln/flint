    // signatures must match what kin generates for them, because that is the
    // only thing being asserted here.
    fn new_node(&mut self, n: u32, edit: Value) -> Value {
        let a = self.alloc(TY_NODE, n + 1);
        if a == 0 { return NIL; }
        self.set_slot(a, 0, edit);
        Value::heap(a)
    }
    fn node_len(&self, n: Value) -> u32 { self.olen(n) - 1 }
    fn node_get(&self, n: Value, i: u32) -> Value { self.slot(n, i + 1) }
    fn node_set(&mut self, n: Value, i: u32, v: Value) { self.set(n, i + 1, v); }
