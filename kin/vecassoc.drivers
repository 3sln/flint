    fn node_clone(&mut self, n: Value, newlen: u32, edit: Value) -> Value {
        let fresh = self.new_node(newlen, edit);
        if fresh.is_nil() { return NIL; }
        let have = self.node_len(n);
        let copy = if newlen < have { newlen } else { have };
        for i in 0..copy { let x = self.node_get(n, i); self.node_set(fresh, i, x); }
        fresh
    }
    fn vec_shift(&self, v: Value) -> u32 { self.slot(v, V_SHIFT).as_fixnum() as u32 }
    fn tail_off(&self, v: Value) -> u32 {
        let c = self.vec_count(v);
        if c < WIDTH { 0 } else { ((c - 1) >> BITS) << BITS }
