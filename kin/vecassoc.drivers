--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 200000], gc: Gc { sp: vec![0u8; 200000] }, lens: vec![0; 200000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    let get = |rt: &Rt, v: Value, i: u32| -> u64 {
        let leaf = rt.array_for(v, i); rt.node_get(leaf, i & MASK).0
    };

    // --- assoc in the TAIL --------------------------------------------------
    let v3 = rt.build(3, BITS);
    let a3 = rt.vec_assoc(v3, 1, Value(0xAAA));
    o.push_str(&format!("t={},{},{} orig={} ", get(&rt, a3, 0), get(&rt, a3, 1),
                        get(&rt, a3, 2), get(&rt, v3, 1)));

    // --- assoc in the TRIE --------------------------------------------------
    let v33 = rt.build(33, BITS);
    let a33 = rt.vec_assoc(v33, 5, Value(0xBBB));
    o.push_str(&format!("r={} keep={} tail={} orig={} ",
        get(&rt, a33, 5), get(&rt, a33, 6), get(&rt, a33, 32), get(&rt, v33, 5)));

    // --- assoc AT the count routes to conj ----------------------------------
    o.push_str(&format!("append={} ", rt.vec_assoc(v33, 33, Value(1)).0));

    // --- pop in the tail ----------------------------------------------------
    let p3 = rt.vec_pop(v3);
    o.push_str(&format!("p3={} {},{} ", rt.vec_count(p3), get(&rt, p3, 0), get(&rt, p3, 1)));

    // --- pop pulling a leaf back out of the trie ---------------------------
    let p33 = rt.vec_pop(v33);
    o.push_str(&format!("p33={} sh={} toff={} last={} ",
        rt.vec_count(p33), rt.vec_shift(p33), rt.tail_off(p33), get(&rt, p33, 31)));

    // --- pop DROPPING A LEVEL ----------------------------------------------
    // 1025 at shift 10: the trie holds 0..1023 under child 0, child 1 is empty,
    // so unwinding leaves a root with one child and the tree loses a level.
    let v1025 = rt.build(1025, BITS + BITS);
    let p1025 = rt.vec_pop(v1025);
    o.push_str(&format!("p1025={} sh={}->{} last={} ",
        rt.vec_count(p1025), rt.vec_shift(v1025), rt.vec_shift(p1025), get(&rt, p1025, 1023)));

    // --- the empty and one-element edges -----------------------------------
    let v1 = rt.build(1, BITS);
    let p1 = rt.vec_pop(v1);
    o.push_str(&format!("p1={} ", rt.vec_count(p1)));
    let v0 = rt.build(0, BITS);
    o.push_str(&format!("p0nil={} ", rt.vec_pop(v0).is_nil() as u32));
    println!("{}", o);
}
