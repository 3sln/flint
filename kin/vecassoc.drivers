            let leaf = self.new_node(WIDTH, NIL);
            let li = self.push(leaf);
            for k in 0..WIDTH { self.node_set(self.r(li), k, Value(0x1000 + (i + k) as u64)); }
            if shift == BITS {
                let l = self.r(li); self.node_set(self.r(ri), i >> BITS, l);
            } else {
                // Two levels: one shift-5 node per 1024 elements.
                let outer = (i >> 10) & MASK;
                let mut mid = self.node_get(self.r(ri), outer);
                if mid.is_nil() { mid = self.new_node(WIDTH, NIL); self.node_set(self.r(ri), outer, mid); }
                let l = self.r(li); self.node_set(mid, (i >> BITS) & MASK, l);
            }
            self.pop_to(li);
            i += WIDTH;
        }
        let tailn = n - toff;
        let tail = self.new_node(tailn, NIL);
        let ti = self.push(tail);
        for k in 0..tailn { self.node_set(self.r(ti), k, Value(0x1000 + (toff + k) as u64)); }
        let (rr, tt) = (self.r(ri), self.r(ti));
        let out = self.new_vec(n, shift, rr, tt, NIL);
        self.pop_to(ri);
        out
    }
    fn array_for(&self, v: Value, i: u32) -> Value {
        if i >= self.tail_off(v) { return self.slot(v, V_TAIL); }
        let mut node = self.slot(v, V_ROOT);
        let mut level = self.vec_shift(v);
        while level > 0 { node = self.node_get(node, (i >> level) & MASK); level -= BITS; }
        node
    }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
