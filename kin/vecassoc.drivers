    // Leaves hold 0x1000 + index so a wrong leaf is a wrong number.
    fn build(&mut self, n: u32, shift: u32) -> Value {
        let toff = if n < WIDTH { 0 } else { ((n - 1) >> BITS) << BITS };
        let root = self.new_node(WIDTH, NIL);
        let ri = self.push(root);
        let mut i = 0u32;
