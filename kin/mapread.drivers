--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const HM_ROOT: u32 = 1;
const TY_ARRAYMAP: u8 = 14; const TY_HASHMAP: u8 = 15; const TY_TABLEREF: u8 = 50;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 }
    fn as_heap(self) -> u32 { self.0 as u32 }
    fn is_nil(self) -> bool { self.0 == 0xFFFF }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, counts: Vec<u32>, roots: Vec<Value>,
            eqs: u32, rooted: u32, maxroots: usize }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize {
        self.roots.push(v); self.rooted += 1;
        if self.roots.len() > self.maxroots { self.maxroots = self.roots.len(); }
        self.roots.len() - 1
    }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    // A key of 900 or more is "compound", so the rooted path is taken.
    fn eq_may_alloc(&self, v: Value) -> bool { v.0 >= 900 }
    fn eq(&mut self, a: Value, b: Value) -> bool { self.eqs += 1; a == b }
    fn hash_value(&mut self, v: Value) -> u32 { ((v.0 * 7) & 0xff) as u32 }
    fn map_count(&self, m: Value) -> u32 { self.counts[m.0 as usize] }
    fn am_key(&self, m: Value, i: u32) -> Value { Value(self.h[m.0 as usize + 2 + 2 * i as usize]) }
    fn am_val(&self, m: Value, i: u32) -> Value { Value(self.h[m.0 as usize + 3 + 2 * i as usize]) }
    fn node_find(&mut self, _n: Value, _s: u32, h: u32, _k: Value) -> Value {
        if h == 0x77 { Value(0xC0DE) } else { NOT_FOUND }
    }
    fn node_find_scalar(&mut self, _n: Value, _s: u32, h: u32, _k: Value) -> Value {
        if h == 0x77 { Value(0x5CA1) } else { NOT_FOUND }
    }
    fn ref_get(&mut self, _r: Value, _name: Value, _d: Value) -> Value { Value(0xBEEF) }
}
fn ty(sp: &Vec<u8>, a: u32) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 400], gc: Gc { sp: vec![0u8; 400] }, counts: vec![0; 400],
                      roots: Vec::new(), eqs: 0, rooted: 0, maxroots: 0 };
    // An array map at 100 with two entries: (0x31 -> 0x32), (0x41 -> 0x42).
    rt.gc.sp[100] = TY_ARRAYMAP; rt.counts[100] = 2;
    rt.h[102] = 0x31; rt.h[103] = 0x32; rt.h[104] = 0x41; rt.h[105] = 0x42;
    // A hash map at 200 whose root is at 210, and one at 220 with a NIL root.
    rt.gc.sp[200] = TY_HASHMAP; rt.h[201] = 210;
    rt.gc.sp[220] = TY_HASHMAP; rt.h[221] = 0xFFFF;
    // A row ref at 300.
    rt.gc.sp[300] = TY_TABLEREF;
    let mut o = String::new();
    // An immediate is not a map: the default comes straight back.
    o.push_str(&format!("{} ", rt.map_get(Value(5), Value(0x31), Value(7)).0));
    // A ROW REF is handed to the table unit.
    o.push_str(&format!("{} ", rt.map_get(Value(300), Value(0x31), Value(7)).0));
    // SCALAR keys in an array map: found, and missing.
    o.push_str(&format!("{} {} ", rt.map_get(Value(100), Value(0x41), Value(7)).0,
                                  rt.map_get(Value(100), Value(0x99), Value(7)).0));
    // SCALAR key in a hash map: the scalar walk, then the empty root.
    let hkey = Value(0x11);           // hash 0x77 -> the stub finds it
    o.push_str(&format!("{} {} ", rt.map_get(Value(200), hkey, Value(7)).0,
                                  rt.map_get(Value(220), hkey, Value(7)).0));
    // COMPOUND keys take the rooted path. 0x900 hashes to 0x77 * 7 & 0xff.
    let ck = Value(900);
    o.push_str(&format!("| {} ", rt.map_get(Value(100), ck, Value(7)).0));
    o.push_str(&format!("{} ", rt.map_get(Value(200), ck, Value(7)).0));
    // am_index_of directly: present, absent (answers n), and compound.
    o.push_str(&format!("| {} {} {} ",
        rt.am_index_of(Value(100), Value(0x41)),
        rt.am_index_of(Value(100), Value(0x99)),
        rt.am_index_of(Value(100), Value(900))));
    // Membership, and that the root stack is balanced after all of it.
    o.push_str(&format!("| {}{} roots={} max={}",
        rt.map_contains(Value(100), Value(0x31)) as u32,
        rt.map_contains(Value(100), Value(0x99)) as u32,
        rt.roots.len(), rt.maxroots));
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFL, NOT_FOUND = 0xFFFEL;
    static final int HM_ROOT = 1;
    static final int TY_ARRAYMAP = 14, TY_HASHMAP = 15, TY_TABLEREF = 50;
    static final class Val {
        static final long NIL = 0xFFFFL, NOT_FOUND = 0xFFFEL;
        static boolean isHeap(long v) { return v >= 100; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static final class Rt {
        long[] h = new long[400];
        static final class Gc { int[] sp = new int[400]; }
        Gc gc = new Gc();
        int[] counts = new int[400];
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int eqs = 0, maxroots = 0;
        int mark() { return roots.size(); }
        int push(long v) {
            roots.add(v);
            if (roots.size() > maxroots) maxroots = roots.size();
            return roots.size() - 1;
        }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long n, int i) { return h[(int) n + i]; }
        boolean isNil(long v) { return v == NIL; }
    }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
    // Nested to reproduce the FULLY QUALIFIED `com.flint.rt.Eq` the
    // vocabulary emits: a generated module lives in package `flint.rt`, so a
    // bare `Eq` there would be the GENERATED one, not the hand-written class.
    static final class com { static final class flint { static final class rt {
        static final class Eq {
            static boolean eq(Rt rt, long a, long b) { rt.eqs++; return a == b; }
            static int hashValue(Rt rt, long v) { return (int) ((v * 7) & 0xff); }
        }
    } } }
    // BARE, not nested in a class: a sibling generated module is reached
    // through `import static flint.rt.X.*`, so the generated code calls it
    // unqualified and the probe must offer it the same way.
    static boolean eqMayAlloc(Rt rt, long v) { return v >= 900; }
    static int mapCount(Rt rt, long m) { return rt.counts[(int) m]; }
    static long amKey(Rt rt, long m, int i) { return rt.h[(int) m + 2 + 2 * i]; }
    static long amVal(Rt rt, long m, int i) { return rt.h[(int) m + 3 + 2 * i]; }
    static long nodeFind(Rt rt, long n, int s, int h, long k) {
        return h == 0x77 ? 0xC0DEL : NOT_FOUND;
    }
    static long nodeFindScalar(Rt rt, long n, int s, int h, long k) {
        return h == 0x77 ? 0x5CA1L : NOT_FOUND;
    }
    static final class Table {
        static long refGet(Rt rt, long r, long name, long d) { return 0xBEEFL; }
    }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.gc.sp[100] = TY_ARRAYMAP; rt.counts[100] = 2;
        rt.h[102] = 0x31; rt.h[103] = 0x32; rt.h[104] = 0x41; rt.h[105] = 0x42;
        rt.gc.sp[200] = TY_HASHMAP; rt.h[201] = 210;
        rt.gc.sp[220] = TY_HASHMAP; rt.h[221] = 0xFFFFL;
        rt.gc.sp[300] = TY_TABLEREF;
        StringBuilder o = new StringBuilder();
        o.append(mapGet(rt, 5, 0x31, 7)).append(' ');
        o.append(mapGet(rt, 300, 0x31, 7)).append(' ');
        o.append(mapGet(rt, 100, 0x41, 7)).append(' ').append(mapGet(rt, 100, 0x99, 7)).append(' ');
        o.append(mapGet(rt, 200, 0x11, 7)).append(' ').append(mapGet(rt, 220, 0x11, 7)).append(' ');
        o.append("| ").append(mapGet(rt, 100, 900, 7)).append(' ');
        o.append(mapGet(rt, 200, 900, 7)).append(' ');
        o.append("| ").append(amIndexOf(rt, 100, 0x41)).append(' ')
         .append(amIndexOf(rt, 100, 0x99)).append(' ')
         .append(amIndexOf(rt, 100, 900)).append(' ');
        o.append("| ").append(mapContains(rt, 100, 0x31) ? 1 : 0)
         .append(mapContains(rt, 100, 0x99) ? 1 : 0)
         .append(" roots=").append(rt.roots.size()).append(" max=").append(rt.maxroots);
        System.out.println(o);
    }
--csharp-pre
// The hand-written runtime, as a REAL top-level namespace.
//
// The generated C# reaches it as `global::Flint.Rt.X`, because its own
// namespace ends in `Rt` and a bare `Flint.Rt` would resolve against that
// instead. `global::` needs a genuine root namespace, which a shim nested
// inside `class Probe` cannot be -- so these live out here now.
namespace Flint.Rt {
        internal static class Eq {
            internal static bool EqMayAlloc(Probe.Rt rt, long v) { return v >= 900; }
            internal static bool Equal(Probe.Rt rt, long a, long b) { rt.eqs++; return a == b; }
            internal static int HashValue(Probe.Rt rt, long v) { return (int) ((v * 7) & 0xff); }
        }
        internal static class Table {
            internal static long refGet(Probe.Rt rt, long r, long name, long d) { return 0xBEEFL; }
        }
}

--csharp-head
    const long NIL = 0xFFFFL, NOT_FOUND = 0xFFFEL;
    const int HM_ROOT = 1;
    static class Obj {
        internal const int TyArraymap = 14, TyHashmap = 15, TyTableref = 50;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    static class Val {
        internal const long Nil = 0xFFFFL, NotFound = 0xFFFEL;
        internal static bool IsHeap(long v) { return v >= 100; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == Nil; }
    }
    internal sealed class Rt {
        internal long[] h = new long[400];
        internal sealed class GcT { internal int[] sp = new int[400]; }
        internal GcT gc = new GcT();
        internal int[] counts = new int[400];
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int eqs = 0, maxroots = 0;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) {
            roots.Add(v);
            if (roots.Count > maxroots) maxroots = roots.Count;
            return roots.Count - 1;
        }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
        internal bool IsNil(long v) { return v == NIL; }
    }
    // BARE, matching Java: a sibling generated module is reached through
    // `using static flint.rt.X`, so the call is unqualified.
    static bool EqMayAlloc(Rt rt, long v) { return v >= 900; }
    static int MapCount(Rt rt, long m) { return rt.counts[(int) m]; }
    static long AmKey(Rt rt, long m, int i) { return rt.h[(int) m + 2 + 2 * i]; }
    static long AmVal(Rt rt, long m, int i) { return rt.h[(int) m + 3 + 2 * i]; }
    static long NodeFind(Rt rt, long n, int s, int h, long k) {
        return h == 0x77 ? 0xC0DEL : NOT_FOUND;
    }
    static long NodeFindScalar(Rt rt, long n, int s, int h, long k) {
        return h == 0x77 ? 0x5CA1L : NOT_FOUND;
    }
