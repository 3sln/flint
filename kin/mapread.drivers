        rt.h[102] = 0x31; rt.h[103] = 0x32; rt.h[104] = 0x41; rt.h[105] = 0x42;
        rt.gc.sp[200] = Obj.TyHashmap; rt.h[201] = 210;
        rt.gc.sp[220] = Obj.TyHashmap; rt.h[221] = 0xFFFFL;
        rt.gc.sp[300] = Obj.TyTableref;
        // The duplicate-key array map: see the rust arm for why it is duplicated.
        rt.gc.sp[320] = Obj.TyArraymap; rt.counts[320] = 2;
        rt.h[322] = 1041; rt.h[323] = 0xAA; rt.h[324] = 1041; rt.h[325] = 0xBB;
        var o = new StringBuilder();
