        for (long k : kids) { nb += sBytes(rt, k); cps += sCount(rt, k);
                              if (!sAscii(rt, k)) asc = 0; }
        rt.set(a, Str.RP_BYTES, Val.fixnum(nb));
        rt.set(a, Str.RP_CPS, Val.fixnum(((long) cps << 1) | asc));
