--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_STR: u8 = 2; const TY_ROPE: u8 = 26; const TY_VEC: u8 = 9;
pub mod obj {
    pub fn str_is_ascii(sp: &super::Space, a: super::Addr) -> bool {
        sp.read_u32(a) & (1 << 18) != 0
    }
    pub const HDR: u64 = 8; pub const STR_DATA: u64 = 16;
    pub const RP_BYTES: u32 = 0; pub const RP_CPS: u32 = 1;
    pub const RP_FLAT: u32 = 2; pub const RP_HASH: u32 = 3; pub const RP_KIDS: u32 = 4;
}
impl Value {
    // AN INLINE STRING is tagged and carries its own bytes -- here, one byte of
    // length and up to three of payload, which is enough to be a leaf.
    fn is_inline_str(self) -> bool { (self.0 >> 60) == 0xE }
    fn inline_len(self) -> u32 { ((self.0 >> 56) & 0xF) as u32 }
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && (self.0 >> 60) != 0xE }
    fn as_heap(self) -> Addr { self.0 as Addr }
    // THE PROBE TAGS ITS FIXNUMS so that a heap address is not mistaken for
    // one -- `rope_hash` asks `is_fixnum` of a slot that may hold either.
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Space { m: Vec<u8> }
impl Space {
    fn read_u8(&self, a: Addr) -> u8 { self.m[a as usize] }
    // THE HEADER WORD, where a flat string keeps its ascii bit.
    fn read_u32(&self, a: Addr) -> u32 {
        let i = a as usize;
        (self.m[i] as u32) | ((self.m[i+1] as u32) << 8)
            | ((self.m[i+2] as u32) << 16) | ((self.m[i+3] as u32) << 24)
    }
    fn write_u32(&mut self, a: Addr, w: u32) {
        let i = a as usize;
        for k in 0..4 { self.m[i + k] = ((w >> (8 * k)) & 0xFF) as u8; }
    }
}
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64,
            roots: Vec<Value> }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 32;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn leaf_len(&self, v: Value) -> u32 {
        if v.is_inline_str() { v.inline_len() } else if v.is_heap() { self.olen(v) } else { 0 }
    }
    fn leaf_byte(&self, v: Value, i: u32) -> u32 {
        if v.is_inline_str() { ((v.0 >> (8 * i)) & 0xFF) as u32 }
        else if v.is_heap() { self.gc.sp.read_u8(v.as_heap() + obj::STR_DATA + i as u64) as u32 }
        else { 0 }
    }
    fn is_rope(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_ROPE
    }
    fn rope_kids(&self, v: Value) -> u32 { self.olen(v) - obj::RP_KIDS }
    // A FLAT STRING puts its bytes at STR_DATA, not at HDR.
    // THE ALLOCATOR SETS THE ASCII BIT, as the runtime's does -- `s_ascii`
    // reads it rather than scanning, so a probe that never set it would be
    // testing the scan it is meant to avoid.
    fn flat(&mut self, bs: &[u8]) -> Value {
        let a = self.alloc(TY_STR, bs.len() as u32);
        for (i, b) in bs.iter().enumerate() { self.gc.sp.m[(a + obj::STR_DATA) as usize + i] = *b; }
        let w = self.gc.sp.read_u32(a);
        let asc = bs.iter().all(|b| *b < 0x80);
        self.gc.sp.write_u32(a, if asc { w | (1 << 18) } else { w & !(1 << 18) });
        Value::heap(a)
    }
    fn inline_of(&self, bs: &[u8]) -> Value {
        let mut v: u64 = (0xEu64 << 60) | ((bs.len() as u64) << 56);
        for (i, b) in bs.iter().enumerate() { v |= (*b as u64) << (8 * i); }
        Value(v)
    }
    fn node(&mut self, kids: &[Value]) -> Value {
        let a = self.alloc(TY_ROPE, obj::RP_KIDS + kids.len() as u32);
        self.set(Value::heap(a), obj::RP_FLAT, NIL);
        self.set(Value::heap(a), obj::RP_HASH, NIL);
        for (i, k) in kids.iter().enumerate() { self.set(Value::heap(a), obj::RP_KIDS + i as u32, *k); }
        let (mut nb, mut cps, mut asc) = (0u32, 0u32, 1u64);
        for k in kids { nb += self.s_bytes(*k); cps += self.s_count(*k);
                        if !self.s_ascii(*k) { asc = 0; } }
        self.set(Value::heap(a), obj::RP_BYTES, Value::fixnum(nb as i64));
        self.set(Value::heap(a), obj::RP_CPS, Value::fixnum(((cps << 1) as u64 | asc) as i64));
        Value::heap(a)
    }
    // The probe answers a FLAT STRING rather than interning one.
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new() };
    let mut o = String::new();
    let show = |rt: &Rt, v: Value| -> String {
        format!("{}/{}/{}", rt.s_bytes(v), rt.s_count(v), rt.s_ascii(v) as u32)
    };
    // ONE LEAF PER TIER, ascii and not: "ab" flat, "ab" inline, "aé" flat,
    // "é" inline. Bytes, code points and ascii-ness all differ.
    let fa = rt.flat(&[0x61, 0x62]);
    let ia = rt.inline_of(&[0x61, 0x62]);
    let fw = rt.flat(&[0x61, 0xC3, 0xA9]);
    let iw = rt.inline_of(&[0xC3, 0xA9]);
    o.push_str(&format!("flatascii={} inlineascii={} flatwide={} inlinewide={} ",
                        show(&rt, fa), show(&rt, ia), show(&rt, fw), show(&rt, iw)));
    // EMPTY, both tiers: zero bytes, zero code points, and ASCII by vacuity.
    let fe = rt.flat(&[]);
    let ie = rt.inline_of(&[]);
    o.push_str(&format!("emptyflat={} emptyinline={} ", show(&rt, fe), show(&rt, ie)));
    // A NODE ADDS UP, and its ascii flag is the AND of its children -- one
    // wide leaf anywhere makes the whole tree wide.
    let allascii = rt.node(&[fa, ia]);
    let mixed = rt.node(&[fa, iw, fw]);
    o.push_str(&format!("nodeascii={} nodemixed={} ", show(&rt, allascii), show(&rt, mixed)));
    // NESTED, so the counts come from the slots rather than a walk.
    let deep = rt.node(&[mixed, allascii]);
    o.push_str(&format!("deep={} ", show(&rt, deep)));
    // A FOUR-BYTE CODE POINT is still ONE code point.
    let emoji = rt.flat(&[0xF0, 0x9F, 0x92, 0xA9]);
    let withemoji = rt.node(&[fa, emoji]);
    o.push_str(&format!("wide4={} node4={} ", show(&rt, emoji), show(&rt, withemoji)));
    // IS-STRING: all three tiers yes, another heap tag and an immediate no.
    let notstr = Value::heap(rt.alloc(TY_VEC, 1));
    o.push_str(&format!("str?={}{}{}{}{}",
                        rt.is_string(ia) as u32, rt.is_string(fa) as u32,
                        rt.is_string(deep) as u32, rt.is_string(notstr) as u32,
                        rt.is_string(Value(1)) as u32));
    println!("{}", o);
}
