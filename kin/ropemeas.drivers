    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long fa = flat(rt, new int[]{0x61, 0x62});
        long ia = inlineOf(new int[]{0x61, 0x62});
        long fw = flat(rt, new int[]{0x61, 0xC3, 0xA9});
        long iw = inlineOf(new int[]{0xC3, 0xA9});
        o.append("flatascii=").append(meas(rt, fa))
         .append(" inlineascii=").append(meas(rt, ia))
         .append(" flatwide=").append(meas(rt, fw))
         .append(" inlinewide=").append(meas(rt, iw)).append(' ');
        o.append("emptyflat=").append(meas(rt, flat(rt, new int[]{})))
         .append(" emptyinline=").append(meas(rt, inlineOf(new int[]{}))).append(' ');
        long allascii = node(rt, new long[]{fa, ia});
        long mixed = node(rt, new long[]{fa, iw, fw});
        o.append("nodeascii=").append(meas(rt, allascii))
         .append(" nodemixed=").append(meas(rt, mixed)).append(' ');
        o.append("deep=").append(meas(rt, node(rt, new long[]{mixed, allascii}))).append(' ');
        long emoji = flat(rt, new int[]{0xF0, 0x9F, 0x92, 0xA9});
        o.append("wide4=").append(meas(rt, emoji))
         .append(" node4=").append(meas(rt, node(rt, new long[]{fa, emoji}))).append(' ');
        // IS-STRING: all three tiers yes, another heap tag and an immediate no.
        long rope = node(rt, new long[]{fa, ia});
        long notstr = Val.heap(rt.alloc(TY_VEC, 1));
        o.append("str?=").append(isString(rt, ia) ? 1 : 0).append(isString(rt, fa) ? 1 : 0)
         .append(isString(rt, rope) ? 1 : 0).append(isString(rt, notstr) ? 1 : 0)
         .append(isString(rt, 1L) ? 1 : 0);
        System.out.println(o.toString());
    }
