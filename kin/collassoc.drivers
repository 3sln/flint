    const long NIL = 0xFFFFL;
    const int CN_BASE = 2;
    static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsNil(long v) { return v == Nil; }
    }
    static int Mask(int h, int shift) { return (int)((uint) h >> shift) & 0x1f; }
    static int Bitpos(int h, int shift) { return 1 << Mask(h, shift); }
    internal sealed class Rt {
        internal long[] h = new long[400];
        internal long bump = 200;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal StringBuilder log = new StringBuilder();
        internal bool champAdded = false;
        internal bool starve = false;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Obj(string tag, long n) { long a = bump; bump += n + 1; log.Append(tag); return a; }
        internal bool IsNil(long v) { return v == NIL; }
    }
    internal static class Flint {
        internal static class Rt {
            internal static class Eq {
                internal static bool Equal(Probe.Rt rt, long a, long b) { return a == b; }
            }
        }
    }
    static int CnHash(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int CnCount(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long CnKey(Rt rt, long n, int i) { return rt.h[(int) n + 2 + 2 * i]; }
    static long CnVal(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    static void CnSet(Rt rt, long n, int i, long v) { rt.h[(int) n + i] = v; }
    static long CnNew(Rt rt, int hh, int npairs, long e) {
        if (rt.starve) { rt.log.Append("x"); return NIL; }
        long a = rt.Obj("C", npairs * 2 + 2);
        rt.h[(int) a] = hh; rt.h[(int) a + 1] = npairs;
        return a;
    }
    static long CnCopySetVal(Rt rt, long n, int i, long v, long e) { return rt.Obj("V", 8); }
    static long BnNew(Rt rt, int dm, int nm, long e) { return rt.Obj("B", 8); }
    static void BnSetNode(Rt rt, long n, int j, long v) { CnSet(rt, n, 7 - j, v); }
    static long NodeAssoc(Rt rt, long n, int s, int h, long k, long v, long e) { return rt.Obj("A", 8); }
