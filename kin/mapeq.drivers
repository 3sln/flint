--rust-head
// A MOCK CHAMP, small enough to write down and rich enough to reach every
// branch: shared subtrees, a distinct-but-equal subtree, a differing value, a
// differing bitmap, collision nodes in both insertion orders, and the
// array-map fallback.
//
// `visits` counts the nodes `node_eq` actually looked at, because the whole
// claim is that a SHARED subtree is not looked at. A pass that visits both
// children of a shared root would be the wrong kind of pass.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const HM_ROOT: u32 = 2;
const TY_HASHMAP: u8 = 2;
const TY_ARRAYMAP: u8 = 3;
impl Value {
    fn is_nil(self) -> bool { self.0 == 0xFFFF }
    // The mock's addresses ARE its values, so this is the identity -- but it
    // has to exist, because `ty` takes an address and not a value.
    fn as_heap(self) -> u64 { self.0 }
}
struct Sp { h: Vec<u64> }
struct Gc { sp: Sp }
struct Rt { gc: Gc, roots: Vec<Value>, visits: u32 }
fn ty(sp: &Sp, a: u64) -> u8 { sp.h[a as usize] as u8 }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn charge_work(&mut self, _n: u64) { self.visits += 1; }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.gc.sp.h[(v.0 + i as u64) as usize]) }
    fn val_eq(&mut self, a: Value, b: Value) -> bool { a == b }
    fn map_count(&self, m: Value) -> u32 { self.gc.sp.h[m.0 as usize + 1] as u32 }
    fn am_key(&self, m: Value, i: u32) -> Value { Value(self.gc.sp.h[m.0 as usize + 2 + 2 * i as usize]) }
    fn am_val(&self, m: Value, i: u32) -> Value { Value(self.gc.sp.h[m.0 as usize + 3 + 2 * i as usize]) }
    fn is_bmnode(&self, n: Value) -> bool { self.gc.sp.h[n.0 as usize] == 0 }
    fn bn_datamap(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 1] as u32 }
    fn bn_nodemap(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 2] as u32 }
    fn bn_key(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 3 + 2 * i as usize]) }
    fn bn_val(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 4 + 2 * i as usize]) }
    fn bn_node(&self, n: Value, j: u32) -> Value {
        let nd = self.bn_datamap(n).count_ones();
        Value(self.gc.sp.h[n.0 as usize + 3 + 2 * nd as usize + j as usize])
    }
    fn cn_hash(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 1] as u32 }
    fn cn_count(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 2] as u32 }
    fn cn_key(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 3 + 2 * i as usize]) }
    fn cn_val(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 4 + 2 * i as usize]) }
    // Enough of a lookup for the fallback: an array-map is a flat scan and a
    // hash map is its root node's inline entries, which is all the probe holds.
    fn map_get(&mut self, m: Value, k: Value, dflt: Value) -> Value {
        if ty(&self.gc.sp, m.as_heap()) == TY_ARRAYMAP {
            let n = self.map_count(m);
            for i in 0..n { if self.am_key(m, i) == k { return self.am_val(m, i); } }
            return dflt;
        }
        let root = self.slot(m, HM_ROOT);
        if root.is_nil() { return dflt; }
        let nd = self.bn_datamap(root).count_ones();
        for i in 0..nd { if self.bn_key(root, i) == k { return self.bn_val(root, i); } }
        dflt
    }
}
impl Rt {
--rust
}
fn fresh() -> Rt {
    let mut h = vec![0u64; 600];
    let m = |h: &mut Vec<u64>, at: usize, t: u64, c: u64, root: u64| {
        h[at] = t; h[at + 1] = c; h[at + 2] = root;
    };
    m(&mut h, 10, 2, 3, 100);   // A
    m(&mut h, 14, 2, 3, 200);   // B: root shares the child at 150
    m(&mut h, 18, 2, 3, 250);   // G: equal to A, its own copy of the child
    m(&mut h, 22, 2, 3, 300);   // V: one value differs
    m(&mut h, 26, 2, 3, 350);   // S: datamap differs
    m(&mut h, 30, 2, 9, 100);   // N: same root, wrong count
    m(&mut h, 40, 2, 2, 500);   // HM2: a CHAMP holding what the array-map holds
    m(&mut h, 44, 2, 0, 0xFFFF); // E1
    m(&mut h, 48, 2, 0, 0xFFFF); // E2
    m(&mut h, 52, 2, 2, 400);   // C1
    m(&mut h, 56, 2, 2, 420);   // C2: the same pairs, inserted the other way
    m(&mut h, 60, 2, 2, 440);   // C3: one value differs
    m(&mut h, 64, 2, 2, 460);   // C4: a different hash
    // The ARRAY-MAP: [ty, count, k0,v0, k1,v1]
    h[34] = 3; h[35] = 2; h[36] = 7000; h[37] = 7001; h[38] = 7002; h[39] = 7003;
    // Bitmap nodes: [0, datamap, nodemap, k,v..., child...]
    h[100] = 0; h[101] = 3; h[102] = 4;
    h[103] = 1000; h[104] = 1001; h[105] = 1002; h[106] = 1003; h[107] = 150;
    h[150] = 0; h[151] = 1; h[152] = 0; h[153] = 1004; h[154] = 1005;
    h[200] = 0; h[201] = 3; h[202] = 4;
    h[203] = 1000; h[204] = 1001; h[205] = 1002; h[206] = 1003; h[207] = 150;
    h[250] = 0; h[251] = 3; h[252] = 4;
    h[253] = 1000; h[254] = 1001; h[255] = 1002; h[256] = 1003; h[257] = 260;
    h[260] = 0; h[261] = 1; h[262] = 0; h[263] = 1004; h[264] = 1005;
    h[300] = 0; h[301] = 3; h[302] = 4;
    h[303] = 1000; h[304] = 1001; h[305] = 1002; h[306] = 9999; h[307] = 150;
    h[350] = 0; h[351] = 7; h[352] = 4;
    h[353] = 1000; h[354] = 1001; h[355] = 1002; h[356] = 1003; h[357] = 1006;
    h[358] = 1007; h[359] = 150;
    // Collision nodes: [1, hash, count, k,v...]
    h[400] = 1; h[401] = 0x55; h[402] = 2; h[403] = 7000; h[404] = 7001; h[405] = 7002; h[406] = 7003;
    h[420] = 1; h[421] = 0x55; h[422] = 2; h[423] = 7002; h[424] = 7003; h[425] = 7000; h[426] = 7001;
    h[440] = 1; h[441] = 0x55; h[442] = 2; h[443] = 7000; h[444] = 9999; h[445] = 7002; h[446] = 7003;
    h[460] = 1; h[461] = 0x66; h[462] = 2; h[463] = 7000; h[464] = 7001; h[465] = 7002; h[466] = 7003;
    h[500] = 0; h[501] = 3; h[502] = 0; h[503] = 7000; h[504] = 7001; h[505] = 7002; h[506] = 7003;
    Rt { gc: Gc { sp: Sp { h } }, roots: Vec::new(), visits: 0 }
}
fn one(rt: &mut Rt, o: &mut String, label: &str, a: u64, b: u64) {
    rt.visits = 0;
    let got = rt.map_eq(Value(a), Value(b));
    o.push_str(&format!("{}={}:{} ", label, got as u32, rt.visits));
}
fn main() {
    let mut rt = fresh();
    let mut o = String::new();
    one(&mut rt, &mut o, "self", 10, 10);
    one(&mut rt, &mut o, "shared", 10, 14);
    one(&mut rt, &mut o, "copied", 10, 18);
    one(&mut rt, &mut o, "val", 10, 22);
    one(&mut rt, &mut o, "shape", 10, 26);
    one(&mut rt, &mut o, "count", 10, 30);
    one(&mut rt, &mut o, "small", 34, 40);
    one(&mut rt, &mut o, "smallrev", 40, 34);
    one(&mut rt, &mut o, "empty", 44, 48);
    one(&mut rt, &mut o, "collswap", 52, 56);
    one(&mut rt, &mut o, "collval", 52, 60);
    one(&mut rt, &mut o, "collhash", 52, 64);
    o.push_str(&format!("roots={}", rt.roots.len()));
    println!("{}", o);
}
