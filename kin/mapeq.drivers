        One(rt, o, "count", 10, 30);
        One(rt, o, "small", 34, 40);
        One(rt, o, "smallrev", 40, 34);
        One(rt, o, "empty", 44, 48);
        One(rt, o, "collswap", 52, 56);
        One(rt, o, "collval", 52, 60);
        One(rt, o, "collhash", 52, 64);
        o.Append("roots=").Append(rt.roots.Count);
        System.Console.WriteLine(o.ToString());
    }
