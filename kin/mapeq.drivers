    static int ty(Sp sp, long a) { return (int) sp.h[(int) a]; }
    static final class Sp { long[] h = new long[600]; }
    static final class Gc { Sp sp = new Sp(); }
    static boolean valEq(Rt rt, long a, long b) { return a == b; }
    static int mapCount(Rt rt, long m) { return (int) rt.h[(int) m + 1]; }
