namespace Flint.Rt {
    internal static class Sets {
        internal const int S_MAP = 2, S_HASH = 3;
    }
}

--csharp-head
    const long NIL = 0xFFFFL;
    const int HM_ROOT = 2;
    const int TY_ARRAYMAP = 3, TY_HASHMAP = 2;
    internal static class Val {
        internal const long NIL = 0xFFFFL;
        internal const long Nil = 0xFFFFL;
        internal static bool IsNil(long v) { return v == NIL; }
        internal static long AsHeap(long v) { return v; }
    }
    internal sealed class Sp { internal long[] h = new long[900]; }
    internal sealed class Gc { internal Sp sp = new Sp(); }
    internal static class Obj {
        internal const int TyArraymap = 3, TyHashmap = 2;
        internal static int Ty(Sp sp, long a) { return (int) sp.h[(int) a]; }
    }
    internal static long EmptyVec(Rt rt) { long a = rt.bump++; rt.h[(int) a] = 0; return a; }
    internal static class Vec {
        internal static long Conj(Rt rt, long v, long x) { return VecConj(rt, v, x); }
        internal static long Empty(Rt rt) { return EmptyVec(rt); }
    }
    internal static long VecConj(Rt rt, long v, long x) {
        long n = rt.h[(int) v];
        long a = rt.bump; rt.bump += n + 2;
        rt.h[(int) a] = n + 1;
        for (long i = 0; i < n; i++) rt.h[(int) (a + 1 + i)] = rt.h[(int) (v + 1 + i)];
        rt.h[(int) (a + 1 + n)] = x;
        return a;
    }
    internal static long MapEntry(Rt rt, long k, long v) {
        long a = rt.bump; rt.bump += 2;
        rt.h[(int) a] = k; rt.h[(int) a + 1] = v;
        return a;
    }
    internal static int MapCount(Rt rt, long m) { return (int) rt.h[(int) m + 1]; }
    internal static int SetCount(Rt rt, long s) { return MapCount(rt, rt.Slot(s, global::Flint.Rt.Sets.S_MAP)); }
    internal static long AmKey(Rt rt, long m, int i) { return rt.h[(int) m + 4 + 2 * i]; }
    internal static long AmVal(Rt rt, long m, int i) { return rt.h[(int) m + 5 + 2 * i]; }
    internal static bool IsBmnode(Rt rt, long n) { return rt.h[(int) n] == 0; }
    internal static int BnDatamap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    internal static int BnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 2]; }
    internal static long BnKey(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    internal static long BnVal(Rt rt, long n, int i) { return rt.h[(int) n + 4 + 2 * i]; }
    internal static long BnNode(Rt rt, long n, int j) {
        int nd = System.Numerics.BitOperations.PopCount((uint) BnDatamap(rt, n));
        return rt.h[(int) n + 3 + 2 * nd + j];
    }
    internal static int CnCount(Rt rt, long n) { return (int) rt.h[(int) n + 2]; }
    internal static long CnKey(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    internal static long CnVal(Rt rt, long n, int i) { return rt.h[(int) n + 4 + 2 * i]; }
    internal sealed class Rt {
        internal Gc gc = new Gc();
        internal long[] h;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal long bump = 700;
        internal long gas = 0;
        internal bool ChargeChecked(long n, string why) { gas += n; return true; }
        internal void ChargeWork(long n) { gas += n; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
    }
