    static Rt Fresh() {
        Rt rt = new Rt();
        rt.h = rt.gc.sp.h;
        long[] h = rt.h;
        h[10] = 2; h[11] = 3; h[12] = 100;
        h[100] = 0; h[101] = 3; h[102] = 4;
        h[103] = 500; h[104] = 501; h[105] = 502; h[106] = 503; h[107] = 150;
        h[150] = 0; h[151] = 1; h[152] = 0; h[153] = 504; h[154] = 505;
        h[20] = 3; h[21] = 3;
        h[24] = 500; h[25] = 501; h[26] = 502; h[27] = 503; h[28] = 504; h[29] = 505;
        h[30] = 2; h[31] = 3; h[32] = 10;
        h[34] = 2; h[35] = 3; h[36] = 20;
        h[40] = 2; h[41] = 2; h[42] = 400;
        h[400] = 1; h[401] = 0x55; h[402] = 2; h[403] = 600; h[404] = 601; h[405] = 602; h[406] = 603;
        return rt;
    }
    static string Show(Rt rt, long v, bool pairs) {
        long n = rt.h[(int) v];
        var s = new System.Text.StringBuilder();
        for (long i = 0; i < n; i++) {
            long e = rt.h[(int) (v + 1 + i)];
            if (pairs) s.Append(rt.h[(int) e]).Append('=').Append(rt.h[(int) e + 1]).Append(',');
            else s.Append(e).Append(',');
        }
        return s.ToString();
    }
    public static void Main(string[] args) {
        Rt rt = Fresh();
        var o = new System.Text.StringBuilder();
        o.Append("champ=").Append(Show(rt, MapEntryVector(rt, 10), true)).Append(' ');
        o.Append("array=").Append(Show(rt, MapEntryVector(rt, 20), true)).Append(' ');
        o.Append("coll=").Append(Show(rt, MapEntryVector(rt, 40), true)).Append(' ');
        o.Append("set=").Append(Show(rt, SetElementVector(rt, 30), false)).Append(' ');
        o.Append("setam=").Append(Show(rt, SetElementVector(rt, 34), false)).Append(' ');
        o.Append("gas=").Append(rt.gas).Append(" roots=").Append(rt.roots.Count);
        System.Console.WriteLine(o.ToString());
    }
