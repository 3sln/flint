    // THE SAME TOY AGAIN, in this target's spelling.
    const long NIL = unchecked((long)0xFFFF000000000000UL);
    static class Val {
        public const long Nil = unchecked((long)0xFFFF000000000000UL);
        public static bool IsNil(long v) => v == Nil;
        public static long AsFixnum(long v) => v;
        public static long AsHeap(long v) => v;
        public static long Fixnum(long n) => n;
    }
    static class Conc {
        public const int SC_BRIDGES = 0, SC_PORTS = 1, PT_STATE = 0;
        public const long P_CLOSED = 2, P_ORPHANED = 5, EV_CLOSED = 3, EV_RELEASE = 5;
        public static long Sched(Rt rt) => rt.SchedV;
        public static long PortById(Rt rt, long id) {
            for (int i = 0; i < rt.PortIds.Count; i++)
                if (rt.PortIds[i] == id) return rt.PortVals[i];
            return Val.Nil;
        }
        public static void PushEvent(Rt rt, long k, long a, long b, long p) {
            rt.EvKind.Add(k); rt.EvId.Add(a);
        }
        public static void WakeOn(Rt rt, long p) { rt.Woken.Add(rt.Slot(p, 1)); }
        public static void FailWaitersOn(Rt rt, long p, string m) { rt.Failed.Add(rt.Slot(p, 1)); }
        public static long PeerIdOfDead(Rt rt, long id) {
            for (int i = 0; i < rt.DeadIds.Count; i++)
                if (rt.DeadIds[i] == id) return rt.PeerIds[i];
            return -1;
        }
    }
    static class Vec { public static long Empty(Rt rt) => rt.Empty; }
    static int VecCount(Rt rt, long v) => rt.Objs[(int)v].Length;
    static long VecNth(Rt rt, long v, int i, long d) {
        var row = rt.Objs[(int)v];
        return i < row.Length ? row[i] : d;
    }
    static long VecConj(Rt rt, long v, long x) {
        rt.Allocs++;
        var row = rt.Objs[(int)v];
        var next = new long[row.Length + 1];
        System.Array.Copy(row, next, row.Length);
        next[row.Length] = x;
        return rt.MakeObj(next);
    }
    public class Rt {
        public System.Collections.Generic.List<long[]> Objs = new System.Collections.Generic.List<long[]>();
        public System.Collections.Generic.List<long> Roots = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PortVals = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> DeadIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> PeerIds = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> EvKind = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> EvId = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> Failed = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> Woken = new System.Collections.Generic.List<long>();
        public int Allocs = 0;
        public long SchedV = unchecked((long)0xFFFF000000000000UL);
        // The shared empty vector -- see the Rust head.
        public long Empty = unchecked((long)0xFFFF000000000000UL);
        public long MakeObj(long[] slots) { Objs.Add(slots); return Objs.Count - 1; }
        public long Slot(long v, int i) => Objs[(int)v][i];
        public void SetSlot(long v, int i, long x) { Objs[(int)v][i] = x; }
        public int Mark() => Roots.Count;
        public int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        public long R(int i) => Roots[i];
        public void SetR(int i, long v) { Roots[i] = v; }
        public void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
    }
    static Rt Mk(long[] bridges, long[] ports, long[] dead, long peerState) {
        var rt = new Rt();
        rt.Empty = rt.MakeObj(new long[0]);
        long bv = rt.MakeObj((long[])bridges.Clone());
        long pv = rt.MakeObj((long[])ports.Clone());
        rt.SchedV = rt.MakeObj(new long[]{bv, pv});
        var all = new System.Collections.Generic.List<long>();
        all.AddRange(bridges); all.AddRange(ports);
        foreach (var id in all) {
            bool isDead = false;
            foreach (var d in dead) if (d == id) isDead = true;
            if (isDead) continue;
            bool isPort = false;
            foreach (var p in ports) if (p == id) isPort = true;
            long row = rt.MakeObj(new long[]{ isPort ? peerState : 1, id });
            rt.PortIds.Add(id); rt.PortVals.Add(row);
        }
        rt.Allocs = 0;
        return rt;
    }
