    public static void main(String[] args) {
        Rt a = mk(new long[]{10, 11}, new long[]{20, 21}, new long[]{}, 1);
        reapAll(a);
        long ab = a.slot(a.schedV, Conc.SC_BRIDGES), ap = a.slot(a.schedV, Conc.SC_PORTS);
        String r1 = a.allocs + " " + vecCount(a, ab) + " " + vecCount(a, ap) + " " + a.evKind.size();

        Rt b = mk(new long[]{10, 11}, new long[]{}, new long[]{11}, 1);
        reapAll(b);
        long bb = b.slot(b.schedV, Conc.SC_BRIDGES);
        String r2 = b.allocs + " " + vecCount(b, bb) + " " + vecNth(b, bb, 0, NIL)
                  + " " + b.evKind.get(0) + " " + b.evId.get(0)
                  + " " + b.evKind.get(1) + " " + b.evId.get(1);

        Rt c = mk(new long[]{}, new long[]{20, 21}, new long[]{21}, 1);
        c.deadIds.add(21L); c.peerIds.add(20L);
        reapAll(c);
        long cp = c.slot(c.schedV, Conc.SC_PORTS);
        long cpeer = Conc.portById(c, 20);
        String r3 = c.allocs + " " + vecCount(c, cp) + " " + c.slot(cpeer, Conc.PT_STATE)
                  + " " + c.failed.get(0) + " " + c.woken.get(0);

        Rt d = mk(new long[]{}, new long[]{20, 21}, new long[]{21}, Conc.P_CLOSED);
        d.deadIds.add(21L); d.peerIds.add(20L);
        reapAll(d);
        long dpeer = Conc.portById(d, 20);
        String r4 = d.slot(dpeer, Conc.PT_STATE) + " " + d.failed.get(0) + " " + d.woken.get(0);

        // 5. CLOSING EVERY BRIDGE -- see the Rust case for what each id is for.
        Rt e = mk(new long[0], new long[0], new long[0], 1);
        long p10 = e.obj(new long[]{1, 10, 1});
        long p11 = e.obj(new long[]{1, 11, 0});
        long p12 = e.obj(new long[]{Conc.P_CLOSED, 12, 1});
        e.portIds.add(10L); e.portVals.add(p10);
        e.portIds.add(11L); e.portVals.add(p11);
        e.portIds.add(12L); e.portVals.add(p12);
        long ids = e.obj(new long[]{10, 11, 12, 13});
        long none = e.obj(new long[0]);
        e.schedV = e.obj(new long[]{none, ids});
        closeBridges(e);
        StringBuilder fx = new StringBuilder();
        for (long id : e.closedFx) { if (fx.length() > 0) fx.append(','); fx.append(id); }
        String r5 = e.slot(p10, Conc.PT_STATE) + " " + e.slot(p11, Conc.PT_STATE)
                  + " " + e.slot(p12, Conc.PT_STATE)
                  + " " + (fx.length() == 0 ? "-" : fx.toString());

        // 6. NO SCHEDULER is not an error.
        Rt f = mk(new long[0], new long[0], new long[0], 1);
        f.schedV = NIL;
        closeBridges(f);
        String r6 = "1";

        // 7-10. WHAT FOLLOWS FROM ONE END CLOSING -- see the Rust cases.
        Rt g = mk(new long[]{30}, new long[0], new long[0], 1);
