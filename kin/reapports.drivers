--rust-head
// A TOY SCHEDULER, A PORT TABLE, AND AN ALLOCATION COUNTER.
//
// One object table serves for both roles: a scheduler row, a port row and a
// vector are all rows of `Value`, so `slot` and `vec-nth` index the same
// thing. A `Value` is therefore either an index into that table or a fixnum,
// and nothing here has to tell them apart -- which keeps the model small
// enough to read, and a driver is only evidence while it stays readable.
//
// `allocs` IS THE POINT of half this file. What is being asserted is that
// NOTHING is allocated when nothing was collected, and an allocation counter
// is the only instrument that can see it: a list rebuilt from survivors and a
// list left untouched hold the same ids in the same order, so every answer
// derived from the lists themselves is equal either way. Case 1 below would
// pass against the wasteful shape it replaced if `allocs` were not read.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
// `SC_*`, `PT_*`, `P_*` and `EV_*` are spelled `crate::conc::…` by the
// vocabulary, so the mock grows a module of that name.
mod conc {
    pub const SC_BRIDGES: u32 = 0;
    pub const SC_PORTS: u32 = 1;
    pub const PT_STATE: u32 = 0;
    // A TOY 2, beside the id at 1. `crosses_a_heap` is the whole of what
    // separates a bridge from a channel, so the mock needs a kind to test.
    pub const PT_KIND: u32 = 2;
    // The toy row is [state, id, kind], so the id IS slot 1 -- which `wake_on`
    // already read. `P_OPEN`/`P_HALF` are the real values.
    pub const PT_ID: u32 = 1;
    pub const P_OPEN: i64 = 1;
    pub const P_HALF: i64 = 4;
    pub fn crosses_a_heap(kind: i64) -> bool { kind == 1 }
    pub const P_CLOSED: i64 = 2;
    pub const P_ORPHANED: i64 = 5;
    pub const EV_CLOSED: i64 = 3;
    pub const EV_RELEASE: i64 = 5;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt {
    objs: Vec<Vec<Value>>,
    roots: Vec<Value>,
    ports: Vec<(i64, Value)>,
    pairs: Vec<(i64, i64)>,
    events: Vec<(i64, i64)>,
    failed: Vec<i64>,
    woken: Vec<i64>,
    // WHICH PORTS HAD SIDE EFFECTS FIRED, in order. A count would not do: the
    // question is whether an ALREADY-CLOSED bridge fires a second time, and
    // that is a question about which ids appear.
    closed_fx: Vec<i64>,
    allocs: u32,
    sched_v: Value,
    // `empty_vec` is `&self` in the real runtime -- the empty vector is a
    // SHARED SINGLETON and costs no allocation -- so the model holds one and
    // hands it back. Getting this wrong would have inflated every expected
    // count by one and hidden the thing being counted.
    empty: Value,
}
// A COLLECTION, from in here, is an id that is still in a list and no longer
// has a row: `dead` ids are simply never registered. That is exactly what the
// code under test can observe -- it asks `port-by-id` and gets nil -- so the
// fixture does not have to model a heap to model the event.
fn mk(bridges: &[i64], ports: &[i64], dead: &[i64], peer_state: i64) -> Rt {
    let mut rt = Rt { objs: vec![], roots: vec![], ports: vec![], pairs: vec![],
                      events: vec![], failed: vec![], woken: vec![], closed_fx: vec![],
                      allocs: 0, sched_v: NIL, empty: NIL };
    rt.empty = rt.obj(vec![]);
    let bs: Vec<Value> = bridges.iter().map(|i| Value::fixnum(*i)).collect();
    let ps: Vec<Value> = ports.iter().map(|i| Value::fixnum(*i)).collect();
    let bv = rt.obj(bs);
    let pv = rt.obj(ps);
    rt.sched_v = rt.obj(vec![bv, pv]);
    for id in bridges.iter().chain(ports.iter()) {
        if dead.contains(id) { continue; }
        let st = if ports.contains(id) { peer_state } else { 1 };
        // Slot 2 is the KIND: anything in `bridges` crosses a heap.
        let kind = if bridges.contains(id) { 1 } else { 0 };
        let row = rt.obj(vec![Value::fixnum(st), Value::fixnum(*id), Value::fixnum(kind)]);
        rt.ports.push((*id, row));
    }
    // Set-up allocations are not the subject. Zeroed here so the counter reads
    // only what `reap-all` did.
    rt.allocs = 0;
    rt
}
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn vec_count(&self, v: Value) -> u32 { self.objs[v.0 as usize].len() as u32 }
    fn vec_nth(&self, v: Value, i: u32, d: Value) -> Value {
        *self.objs[v.0 as usize].get(i as usize).unwrap_or(&d)
    }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        self.allocs += 1;
        let mut next = self.objs[v.0 as usize].clone();
        next.push(x);
        self.obj(next)
    }
    fn empty_vec(&self) -> Value { self.empty }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn sched(&self) -> Value { self.sched_v }
    fn port_by_id(&mut self, id: i64) -> Value {
        for (k, v) in &self.ports { if *k == id { return *v; } }
        NIL
    }
    fn push_event(&mut self, kind: i64, a: i64, _b: i64, _p: Value) { self.events.push((kind, a)); }
    // THE OTHER END, looked up SYMMETRICALLY: `pairs` records one direction
    // and a channel has two, so asking from either side must answer.
    fn peer_of(&mut self, p: Value) -> Value {
        let id = self.slot(p, conc::PT_ID).as_fixnum();
        for (a, b) in self.pairs.clone() {
            if a == id { return self.port_by_id(b); }
            if b == id { return self.port_by_id(a); }
        }
        NIL
    }
    fn forget_bridge(&mut self, id: i64) {
        let s = self.sched();
        let bv = self.slot(s, conc::SC_BRIDGES);
        let kept: Vec<Value> = self.objs[bv.0 as usize].clone().into_iter()
            .filter(|x| x.as_fixnum() != id).collect();
        let nv = self.obj(kept);
        self.set(s, conc::SC_BRIDGES, nv);
    }
    fn close_side_effects(&mut self, p: Value) {
        let id = self.slot(p, 1).as_fixnum();
        self.closed_fx.push(id);
    }
    fn wake_on(&mut self, p: Value) { let id = self.slot(p, 1).as_fixnum(); self.woken.push(id); }
    fn fail_waiters_on(&mut self, p: Value, _m: &str) {
        let id = self.slot(p, 1).as_fixnum();
        self.failed.push(id);
    }
    fn peer_id_of_dead(&self, id: i64) -> i64 {
        for (d, p) in &self.pairs { if *d == id { return *p; } }
        -1
    }
--rust
}
fn main() {
    // 1. NOTHING COLLECTED. Both lists stand, nothing is said, and -- the part
    //    only `allocs` can see -- NOTHING IS ALLOCATED.
    let mut a = mk(&[10, 11], &[20, 21], &[], 1);
    a.reap_all();
    let s = a.sched_v;
    let ab = a.slot(s, conc::SC_BRIDGES);
    let ap = a.slot(s, conc::SC_PORTS);
    let r1 = format!("{} {} {} {}", a.allocs, a.vec_count(ab), a.vec_count(ap), a.events.len());

    // 2. ONE BRIDGE COLLECTED. It leaves the list, the survivor keeps its
    //    place, and the host hears CLOSED then RELEASE for that id and no
    //    other. Two allocations: the fresh list, and the one survivor conj'd.
    let mut b = mk(&[10, 11], &[], &[11], 1);
    b.reap_all();
    let s = b.sched_v;
    let bb = b.slot(s, conc::SC_BRIDGES);
    let kept = b.vec_nth(bb, 0, NIL).as_fixnum();
    let r2 = format!("{} {} {} {} {} {} {}", b.allocs, b.vec_count(bb), kept,
                     b.events[0].0, b.events[0].1, b.events[1].0, b.events[1].1);

    // 3. A CHANNEL END COLLECTED, ITS PEER OPEN. The peer is ORPHANED -- not
    //    closed -- and whoever is parked on it is failed and woken.
    let mut c = mk(&[], &[20, 21], &[21], 1);
    c.pairs.push((21, 20));
    c.reap_all();
    let s = c.sched_v;
    let cp = c.slot(s, conc::SC_PORTS);
    let peer = c.port_by_id(20);
    let r3 = format!("{} {} {} {} {}", c.allocs, c.vec_count(cp),
                     c.slot(peer, conc::PT_STATE).as_fixnum(), c.failed[0], c.woken[0]);

    // 4. THE SAME, PEER ALREADY CLOSED. Its state must NOT be overwritten --
    //    a tidy close outranks an orphaning -- and it is still failed and
    //    woken, because a waiter on a closed port is still a waiter.
    let mut d = mk(&[], &[20, 21], &[21], conc::P_CLOSED);
    d.pairs.push((21, 20));
    d.reap_all();
    let peer = d.port_by_id(20);
    let r4 = format!("{} {} {}", d.slot(peer, conc::PT_STATE).as_fixnum(), d.failed[0], d.woken[0]);

    // 5. CLOSING EVERY BRIDGE. Four ports, and THREE OF THE FOUR FIELDS CAN
    //    FAIL -- which is the point, because "it closed the bridge" passes
    //    under any implementation including one that closes everything.
    //
    //      10  bridge, open        -> CLOSED, side effects ONCE
    //      11  CHANNEL, open       -> untouched. Catches closing everything
    //      12  bridge, ALREADY closed -> no second side effect. Catches a
    //                                 missing state test, which would tell the
    //                                 host a port was released twice
    //      13  DEAD, no row        -> skipped. Catches a missing nil check
    let mut e = mk(&[], &[], &[], 1);
    let p10 = e.obj(vec![Value::fixnum(1), Value::fixnum(10), Value::fixnum(1)]);
    let p11 = e.obj(vec![Value::fixnum(1), Value::fixnum(11), Value::fixnum(0)]);
    let p12 = e.obj(vec![Value::fixnum(conc::P_CLOSED), Value::fixnum(12), Value::fixnum(1)]);
    e.ports.push((10, p10));
    e.ports.push((11, p11));
    e.ports.push((12, p12));
    let ids = e.obj(vec![Value::fixnum(10), Value::fixnum(11),
                         Value::fixnum(12), Value::fixnum(13)]);
    let none = e.obj(vec![]);
    e.sched_v = e.obj(vec![none, ids]);
    e.close_bridges();
    let fx: Vec<String> = e.closed_fx.iter().map(|i| i.to_string()).collect();
    let r5 = format!("{} {} {} {}",
                     e.slot(p10, conc::PT_STATE).as_fixnum(),
                     e.slot(p11, conc::PT_STATE).as_fixnum(),
                     e.slot(p12, conc::PT_STATE).as_fixnum(),
                     if fx.is_empty() { "-".to_string() } else { fx.join(",") });

    // 6. NO SCHEDULER is not an error. Reaching the next line is the assertion.
    let mut f = mk(&[], &[], &[], 1);
    f.sched_v = NIL;
    f.close_bridges();
    let r6 = "1";

    // 7-10. WHAT FOLLOWS FROM ONE END CLOSING. Each case is a fresh fixture,
    //        and each field below moves under a DIFFERENT mistake.
    let fmt = |rt: &Rt, peer: Value| -> String {
        let ev: Vec<String> = rt.events.iter().map(|(k, a)| format!("{k}:{a}")).collect();
        let wk: Vec<String> = rt.woken.iter().map(|i| i.to_string()).collect();
        let s = rt.sched_v;
        let bn = rt.vec_count(rt.slot(s, conc::SC_BRIDGES));
        format!("{} {} {} {}",
                if ev.is_empty() { "-".to_string() } else { ev.join(",") },
                bn,
                if wk.is_empty() { "-".to_string() } else { wk.join(",") },
                if peer.is_nil() { "-".to_string() }
                else { rt.slot(peer, conc::PT_STATE).as_fixnum().to_string() })
    };
    // 7. A BRIDGE, peer OPEN. The host hears CLOSED then RELEASE, the id has
    //    LEFT the held list between them, both ends are woken, and the peer is
    //    HALF-closed.
    let mut g = mk(&[30], &[], &[], 1);
    let p31 = g.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(31), Value::fixnum(0)]);
    g.ports.push((31, p31));
    g.pairs.push((30, 31));
    let p30 = g.port_by_id(30);
    g.close_effects(p30);
    let r7 = fmt(&g, p31);

    // 8. A CHANNEL. Both ends are in this heap, so THE HOST HEARS NOTHING --
    //    the field that refuses an implementation which events unconditionally.
    let mut h = mk(&[], &[40], &[], conc::P_OPEN);
    let p41 = h.obj(vec![Value::fixnum(conc::P_OPEN), Value::fixnum(41), Value::fixnum(0)]);
    h.ports.push((41, p41));
    h.pairs.push((40, 41));
    let p40 = h.port_by_id(40);
    h.close_effects(p40);
    let r8 = fmt(&h, p41);

    // 9. THE PEER IS ALREADY CLOSED. It must NOT be moved to HALF -- a tidy
    //    close outranks a half -- and it must NOT be woken, because there is
    //    nothing new for it to learn. Both are the same `if`, and only the
    //    woken list can tell whether the test guards the wake too.
    let mut i = mk(&[50], &[], &[], 1);
    let p51 = i.obj(vec![Value::fixnum(conc::P_CLOSED), Value::fixnum(51), Value::fixnum(0)]);
    i.ports.push((51, p51));
    i.pairs.push((50, 51));
    let p50 = i.port_by_id(50);
    i.close_effects(p50);
    let r9 = fmt(&i, p51);

    // 10. NO PEER AT ALL. Reaching the line is the assertion.
    let mut j = mk(&[60], &[], &[], 1);
    let p60 = j.port_by_id(60);
    j.close_effects(p60);
    let r10 = fmt(&j, NIL);

    println!("{} {} {} {} {} {} {} {} {} {}", r1, r2, r3, r4, r5, r6, r7, r8, r9, r10);
}
--java-head
    // THE SAME TOY AS THE RUST HEAD, field for field and case for case. The
    // three fixtures agree with each other by construction, which is what
    // makes ONE expected line legitimate evidence for three targets rather
    // than three answers that happen to coincide.
    static final long NIL = 0xFFFF000000000000L;
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static boolean isNil(long v) { return v == NIL; }
        static long asFixnum(long v) { return v; }
        static long asHeap(long v) { return v; }
        static long fixnum(long n) { return n; }
    }
    static final class Conc {
        static final int SC_BRIDGES = 0, SC_PORTS = 1, PT_STATE = 0;
        // A TOY 2, beside the id at 1 -- see the Rust head.
        static final int PT_KIND = 2;
        // The toy row is [state, id, kind] -- see the Rust head.
        static final int PT_ID = 1;
        static final long P_OPEN = 1, P_HALF = 4;
        static long peerOf(Rt rt, long p) {
            long id = rt.slot(p, PT_ID);
            for (int i = 0; i < rt.deadIds.size(); i++) {
                if (rt.deadIds.get(i) == id) return portById(rt, rt.peerIds.get(i));
                if (rt.peerIds.get(i) == id) return portById(rt, rt.deadIds.get(i));
            }
            return NIL;
        }
        static void forgetBridge(Rt rt, long id) {
            long bv = rt.slot(rt.schedV, SC_BRIDGES);
            long[] row = rt.objs.get((int) bv);
            java.util.List<Long> kept = new java.util.ArrayList<>();
            for (long x : row) if (x != id) kept.add(x);
            long[] out = new long[kept.size()];
            for (int i = 0; i < out.length; i++) out[i] = kept.get(i);
            rt.setSlot(rt.schedV, SC_BRIDGES, rt.obj(out));
        }
        static boolean crossesAHeap(long kind) { return kind == 1; }
        static void closeSideEffects(Rt rt, long p) { rt.closedFx.add(rt.slot(p, 1)); }
        static final long P_CLOSED = 2, P_ORPHANED = 5, EV_CLOSED = 3, EV_RELEASE = 5;
        static long sched(Rt rt) { return rt.schedV; }
        static long portById(Rt rt, long id) {
            for (int i = 0; i < rt.portIds.size(); i++)
                if (rt.portIds.get(i) == id) return rt.portVals.get(i);
            return NIL;
        }
        static void pushEvent(Rt rt, long k, long a, long b, long p) {
            rt.evKind.add(k); rt.evId.add(a);
        }
        static void wakeOn(Rt rt, long p) { rt.woken.add(rt.slot(p, 1)); }
        static void failWaitersOn(Rt rt, long p, String m) { rt.failed.add(rt.slot(p, 1)); }
        static long peerIdOfDead(Rt rt, long id) {
            for (int i = 0; i < rt.deadIds.size(); i++)
                if (rt.deadIds.get(i) == id) return rt.peerIds.get(i);
            return -1;
        }
    }
    static final class Vec { static long empty(Rt rt) { return rt.empty; } }
    static int vecCount(Rt rt, long v) { return rt.objs.get((int) v).length; }
    static long vecNth(Rt rt, long v, int i, long d) {
        long[] row = rt.objs.get((int) v);
        return i < row.length ? row[i] : d;
    }
    static long vecConj(Rt rt, long v, long x) {
        rt.allocs++;
        long[] row = rt.objs.get((int) v);
        long[] next = new long[row.length + 1];
        System.arraycopy(row, 0, next, 0, row.length);
        next[row.length] = x;
        return rt.obj(next);
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<Long> roots = new java.util.ArrayList<>();
        java.util.List<Long> portIds = new java.util.ArrayList<>();
        java.util.List<Long> portVals = new java.util.ArrayList<>();
        java.util.List<Long> deadIds = new java.util.ArrayList<>();
        java.util.List<Long> peerIds = new java.util.ArrayList<>();
        java.util.List<Long> evKind = new java.util.ArrayList<>();
        java.util.List<Long> evId = new java.util.ArrayList<>();
        java.util.List<Long> failed = new java.util.ArrayList<>();
        java.util.List<Long> woken = new java.util.ArrayList<>();
        // WHICH PORTS HAD SIDE EFFECTS FIRED -- see the Rust head.
        java.util.List<Long> closedFx = new java.util.ArrayList<>();
        int allocs = 0;
        long schedV = NIL;
        // The shared empty vector -- see the Rust head.
        long empty = NIL;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
        void setSlot(long v, int i, long x) { objs.get((int) v)[i] = x; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
    }
    static Rt mk(long[] bridges, long[] ports, long[] dead, long peerState) {
        Rt rt = new Rt();
        rt.empty = rt.obj(new long[0]);
        long bv = rt.obj(bridges.clone()), pv = rt.obj(ports.clone());
        rt.schedV = rt.obj(new long[]{bv, pv});
        for (long id : concat(bridges, ports)) {
            boolean isDead = false;
            for (long d : dead) if (d == id) isDead = true;
            if (isDead) continue;
            boolean isPort = false;
            for (long p : ports) if (p == id) isPort = true;
            boolean isBridge = false;
            for (long b : bridges) if (b == id) isBridge = true;
            long row = rt.obj(new long[]{isPort ? peerState : 1, id, isBridge ? 1 : 0});
            rt.portIds.add(id); rt.portVals.add(row);
        }
        rt.allocs = 0;
        return rt;
    }
    static long[] concat(long[] a, long[] b) {
        long[] out = new long[a.length + b.length];
        System.arraycopy(a, 0, out, 0, a.length);
        System.arraycopy(b, 0, out, a.length, b.length);
        return out;
    }
