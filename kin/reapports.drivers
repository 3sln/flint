        g.portIds.add(31L); g.portVals.add(g31);
        g.deadIds.add(30L); g.peerIds.add(31L);
        closeEffects(g, Conc.portById(g, 30));
        String r7 = fmtClose(g, g31);

        Rt h = mk(new long[0], new long[]{40}, new long[0], Conc.P_OPEN);
        long h41 = h.obj(new long[]{Conc.P_OPEN, 41, 0});
        h.portIds.add(41L); h.portVals.add(h41);
