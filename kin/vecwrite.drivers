type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_NODE: u8 = 10; const TY_VEC: u8 = 6;
const BITS: u32 = 5; const WIDTH: u32 = 32; const MASK: u32 = 31;
const V_CNT: u32 = 0; const V_SHIFT: u32 = 1; const V_ROOT: u32 = 2; const V_TAIL: u32 = 3;
const V_META: u32 = 4; const V_HASH: u32 = 5;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        // NIL-FILLED, as the real allocator does (`gc.zero_body` fills value
        // slots with NIL). Leaving them at 0 makes "this slot is absent" read
        // as present, because NIL is 0xFFFF -- and every target agrees on the
        // wrong answer, which is the one failure a three-way comparison cannot
        // catch. It hid `vec_pop`'s level collapse entirely.
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.set_slot(v.as_heap(), i, x); }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, n: Value) -> u32 { self.lens[n.0 as usize] }
    // A vector's count, which the subject reaches as a SIBLING rather than a
    // template -- so the fixture has to supply it with the real signature.
    fn vec_count(&self, v: Value) -> u32 { self.slot(v, V_CNT).as_fixnum() as u32 }
    // `flint.rt.vecnode`, STUBBED. Each source is verified against stubs of
    // what it requires; `vecnode.drivers` verifies the real ones. The
    // signatures must match what kin generates for them, because that is the
    // only thing being asserted here.
    fn new_node(&mut self, n: u32, edit: Value) -> Value {
        let a = self.alloc(TY_NODE, n + 1);
        if a == 0 { return NIL; }
        self.set_slot(a, 0, edit);
        Value::heap(a)
    }
    fn node_len(&self, n: Value) -> u32 { self.olen(n) - 1 }
    fn node_get(&self, n: Value, i: u32) -> Value { self.slot(n, i + 1) }
    fn node_set(&mut self, n: Value, i: u32, v: Value) { self.set(n, i + 1, v); }
    // `flint.rt.vecread`, STUBBED -- `vecread.drivers` verifies the real ones.
    fn node_clone(&mut self, n: Value, newlen: u32, edit: Value) -> Value {
        let fresh = self.new_node(newlen, edit);
        if fresh.is_nil() { return NIL; }
        let have = self.node_len(n);
        let copy = if newlen < have { newlen } else { have };
        for i in 0..copy { let x = self.node_get(n, i); self.node_set(fresh, i, x); }
        fresh
    }
    fn vec_shift(&self, v: Value) -> u32 { self.slot(v, V_SHIFT).as_fixnum() as u32 }
    fn tail_off(&self, v: Value) -> u32 {
        let c = self.vec_count(v);
        if c < WIDTH { 0 } else { ((c - 1) >> BITS) << BITS }
    }
    fn array_for(&self, v: Value, i: u32) -> Value {
        if i >= self.tail_off(v) { return self.slot(v, V_TAIL); }
        let mut node = self.slot(v, V_ROOT);
        let mut level = self.vec_shift(v);
        while level > 0 { node = self.node_get(node, (i >> level) & MASK); level -= BITS; }
        node
    }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 900000], gc: Gc { sp: vec![0u8; 900000] }, lens: vec![0; 900000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    // An empty vector, built the way `newEmpty` builds one: a WIDTH root, a
    // zero-length tail, shift BITS.
    let root = rt.new_node(WIDTH, NIL);
    let tail = rt.new_node(0, NIL);
    let mut v = rt.new_vec(0, BITS, root, tail, NIL);
    let vi = rt.push(v);
    // Conj across every boundary the trie turns on: filling the first tail
    // (32), pushing it into the trie (33), the level change at 1025, and PAST
    // 2048 -- which is what reaches `push-tail`'s absent-child arm, where a
    // fresh subtree has to be built with `new-path`. Stopping at 1100, as this
    // driver first did, leaves every element under child 1 and never gets
    // there.
    for i in 0..2100u32 {
        let nv = rt.vec_conj(rt.r(vi), Value(0x1000 + i as u64));
        rt.set_r(vi, nv);
        if i == 0 || i == 31 || i == 32 || i == 1023 || i == 1024 || i == 2047 || i == 2048 {
            let w = rt.r(vi);
            o.push_str(&format!("{}:cnt={},sh={},toff={} ",
                i + 1, rt.vec_count(w), rt.vec_shift(w), rt.tail_off(w)));
        }
    }
    v = rt.r(vi);
    o.push_str(&format!("| final cnt={} shift={} ", rt.vec_count(v), rt.vec_shift(v)));
    // Every element readable, and at the right index.
    let mut bad = 0u32;
    for i in 0..2100u32 {
        let leaf = rt.array_for(v, i);
        if rt.node_get(leaf, i & MASK).0 != 0x1000 + i as u64 { bad += 1; }
    }
    o.push_str(&format!("wrong={} ", bad));
    // PERSISTENT: conjing onto an older vector does not disturb it.
    let older = rt.vec_conj(v, Value(0x9999));
    o.push_str(&format!("older={} v={} ", rt.vec_count(older), rt.vec_count(v)));
    println!("{}", o);
}
