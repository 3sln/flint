    public static void Main(string[] args) {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long root = NewNode(rt, WIDTH, NIL);
        long tail = NewNode(rt, 0, NIL);
        long v = NewVec(rt, 0, BITS, root, tail, NIL);
        int vi = rt.Push(v);
        for (int i = 0; i < 2100; i++) {
            rt.SetR(vi, VecConj(rt, rt.R(vi), 0x1000 + i));
            if (i == 0 || i == 31 || i == 32 || i == 1023 || i == 1024 || i == 2047 || i == 2048) {
                long w = rt.R(vi);
                o.Append(i + 1).Append(":cnt=").Append(VecCount(rt, w))
                 .Append(",sh=").Append(VecShift(rt, w))
                 .Append(",toff=").Append(TailOff(rt, w)).Append(' ');
            }
        }
        v = rt.R(vi);
        o.Append("| final cnt=").Append(VecCount(rt, v)).Append(" shift=").Append(VecShift(rt, v)).Append(' ');
        int bad = 0;
        for (int i = 0; i < 2100; i++) {
            long leaf = ArrayFor(rt, v, i);
            if (NodeGet(rt, leaf, i & MASK) != 0x1000 + i) bad++;
        }
        o.Append("wrong=").Append(bad).Append(' ');
        long older = VecConj(rt, v, 0x9999);
        o.Append("older=").Append(VecCount(rt, older)).Append(" v=").Append(VecCount(rt, v)).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
