    // THE SAME TOY, field for field.
    const long NIL = unchecked((long) 0xFFFF000000000000UL);
    public static class Val {
        public const long Nil = unchecked((long) 0xFFFF000000000000UL);
        public static bool IsNil(long v) { return v == Nil; }
        public static long AsFixnum(long v) { return v; }
    }
    public static class Conc {
        public const int SC_THREADS = 0, TH_STATUS = 0, TH_RESULT = 1;
        public const long ST_RUNNABLE = 1, ST_PARKED = 2, ST_DONE = 3, ST_FAILED = 4;
        public static long Sched(Rt rt) { return rt.sched; }
    }
    static long VecNth(Rt rt, long v, int i, long dflt) {
        var items = rt.vecs[(int)(v - 5000)];
        return i < items.Count ? items[i] : dflt;
    }
    public class Rt {
        public System.Collections.Generic.List<long[]> objs = new System.Collections.Generic.List<long[]>();
        public System.Collections.Generic.List<System.Collections.Generic.List<long>> vecs
            = new System.Collections.Generic.List<System.Collections.Generic.List<long>>();
        public long sched = NIL, thrown = NIL;
        public long Obj(long[] slots) { objs.Add(slots); return objs.Count - 1 + 1000; }
        public long Vec(System.Collections.Generic.List<long> items) { vecs.Add(items); return vecs.Count - 1 + 5000; }
        public long Slot(long v, int i) { return objs[(int)(v - 1000)][i]; }
    }
--csharp
    static Rt Fresh() { return new Rt(); }
    static string NameOf(long v, long r) {
        if (v == NIL) return "-";
        if (v == r) return "r";
        return "?";
    }
    static string CaseOf(bool hasSched, int thread0, long st) {
        Rt rt = Fresh();
        long r = rt.Obj(new long[]{});
        long th = thread0 == 3 ? rt.Obj(new long[]{st, r}) : NIL;
        var items = new System.Collections.Generic.List<long>();
        if (thread0 == 2) items.Add(NIL);
        if (thread0 == 3) items.Add(th);
        long ts = rt.Vec(items);
        if (hasSched) rt.sched = rt.Obj(new long[]{ts});
        long ans = MainAnswer(rt);
        return NameOf(ans, r) + ":" + NameOf(rt.thrown, r);
    }
    static void Main() {
        System.Console.WriteLine(
            CaseOf(false, 3, Conc.ST_DONE) + " | " +
            CaseOf(true, 1, Conc.ST_DONE) + " | " +
            CaseOf(true, 2, Conc.ST_DONE) + " | " +
            CaseOf(true, 3, Conc.ST_DONE) + " | " +
            CaseOf(true, 3, Conc.ST_FAILED) + " | " +
            CaseOf(true, 3, Conc.ST_RUNNABLE) + " | " +
            CaseOf(true, 3, Conc.ST_PARKED));
    }
--expect
-:- | -:- | -:- | r:- | -:r | r:- | r:-
--expect-why
DERIVED FROM THE CONTRACT. Seven rows as `<answer>:<thrown>`, and one of them
is the whole reason this function is being generated.

1-3  NO SCHEDULER, NO THREADS, A NIL HOLE -- all `-:-`. Nil, and nothing
     thrown. A program that never started a thread has no outcome to report,
     and inventing a failure for it would make an empty program look like a
     broken one. The three ways of having no thread 0 are kept apart on
     purpose: a missing scheduler, a vector too short, and a retired slot are
     three different states of the same table.

4    FINISHED -- `r:-`. The value, and `thrown` stays clear.

5    FAILED -- `-:r`. NIL BACK, AND THE ERROR ON `thrown`. THIS IS THE ROW
     BOTH PORTS GOT WRONG. Their `mainResult` returned `TH_RESULT`
     unconditionally, which for a failed thread is the error, so a host saw
     status 0 and a value that happened to be an exception. Measured with a
     two-line fixture: native said `ExceptionInfo: boom` and status 1, both
     ports said `an ex-info` and status 0.

     `TH_RESULT` HOLDS TWO DIFFERENT THINGS and the status says which. That
     is the trap: a copy that reads the slot without reading the status is
     correct on every row but this one, and this one is the failure path.

6-7  STILL GOING -- `r:-` both. Neither `ST_RUNNABLE` nor `ST_PARKED` is
     terminal, so nothing is a failure yet and whatever sits in `TH_RESULT`
     is reported as a value. Only `ST_FAILED` diverts to `thrown`; testing
     "not done" instead would report a running thread's empty result slot as
     a thrown value.
