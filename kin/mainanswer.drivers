--rust-head
// A TOY SCHEDULER WITH ONE THREAD VECTOR. Everything this function reads is
// a slot; the only thing it WRITES is `thrown`, so the toy models the field
// and nothing else.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
mod conc {
    pub const SC_THREADS: u32 = 0;
    pub const TH_STATUS: u32 = 0;
    pub const TH_RESULT: u32 = 1;
    // THE REAL VALUES, because the expected answers name them.
    pub const ST_RUNNABLE: i64 = 1;
    pub const ST_PARKED: i64 = 2;
    pub const ST_DONE: i64 = 3;
    pub const ST_FAILED: i64 = 4;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt {
    objs: Vec<Vec<Value>>,
    vecs: Vec<Vec<Value>>,
    sched: Value,
    thrown: Value,
}
impl Rt {
    // OBJECTS AT 1000, VECTORS AT 5000, so a handle cannot be read as a
    // status fixnum and the two tables cannot be confused for each other.
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64 + 1000)
    }
    fn vec(&mut self, items: Vec<Value>) -> Value {
        self.vecs.push(items);
        Value((self.vecs.len() - 1) as u64 + 5000)
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[(v.0 - 1000) as usize][i as usize] }
    fn sched(&self) -> Value { self.sched }
    fn vec_nth(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        let items = &self.vecs[(v.0 - 5000) as usize];
        if (i as usize) < items.len() { items[i as usize] } else { dflt }
    }
--rust
}
fn fresh() -> Rt {
    Rt { objs: vec![], vecs: vec![], sched: NIL, thrown: NIL }
}
// `<answer>:<thrown>`
fn case(has_sched: bool, thread0: i32, st: i64) -> String {
    let mut rt = fresh();
    let r = rt.obj(vec![]);
    // `thread0`: 0 none at all, 1 an empty vector, 2 a nil hole, 3 a thread.
    let th = if thread0 == 3 { rt.obj(vec![Value(st as u64), r]) } else { NIL };
    let items = match thread0 {
        1 => vec![],
        2 => vec![NIL],
        3 => vec![th],
        _ => vec![],
    };
    let ts = rt.vec(items);
    if has_sched {
        let s = rt.obj(vec![ts]);
        rt.sched = s;
    }
    let ans = rt.main_answer();
    let name = |v: Value| -> &'static str {
        if v.is_nil() { "-" } else if v == r { "r" } else { "?" }
    };
    format!("{}:{}", name(ans), name(rt.thrown))
}
fn main() {
    // 1. NO SCHEDULER. Nil, and nothing thrown: a program that never started
    //    a thread has no outcome, and inventing a failure for it would make
    //    an empty program look like a broken one.
    let r1 = case(false, 3, conc::ST_DONE);
    // 2. A SCHEDULER WITH NO THREADS. The same, by the out-of-range read.
    let r2 = case(true, 1, conc::ST_DONE);
    // 3. A NIL HOLE WHERE THREAD 0 WAS. The same again -- a retired slot is
    //    not a thread, and reading its slots would fault.
    let r3 = case(true, 2, conc::ST_DONE);
    // 4. FINISHED. The value, and `thrown` stays clear.
    let r4 = case(true, 3, conc::ST_DONE);
    // 5. FAILED. NIL BACK AND THE ERROR ON `thrown`. This is the row the two
    //    ports got wrong: they answered `r:-`, so a host saw a success whose
    //    value happened to be an exception.
    let r5 = case(true, 3, conc::ST_FAILED);
    // 6-7. STILL GOING. Neither terminal state, so `TH_RESULT` is whatever
    //      was last written there -- reported as a value, never as a failure.
    let r6 = case(true, 3, conc::ST_RUNNABLE);
    let r7 = case(true, 3, conc::ST_PARKED);
    println!("{} | {} | {} | {} | {} | {} | {}", r1, r2, r3, r4, r5, r6, r7);
}
--java-head
    // THE SAME TOY, field for field.
    static final long NIL = 0xFFFF000000000000L;
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static boolean isNil(long v) { return v == NIL; }
        static long asFixnum(long v) { return v; }
    }
    static final class Conc {
        static final int SC_THREADS = 0, TH_STATUS = 0, TH_RESULT = 1;
        static final long ST_RUNNABLE = 1, ST_PARKED = 2, ST_DONE = 3, ST_FAILED = 4;
        static long sched(Rt rt) { return rt.sched; }
    }
    // BARE, not on a class: cross-namespace kin calls land unqualified.
    static long vecNth(Rt rt, long v, int i, long dflt) {
        java.util.List<Long> items = rt.vecs.get((int) (v - 5000));
        return i < items.size() ? items.get(i) : dflt;
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<java.util.List<Long>> vecs = new java.util.ArrayList<>();
        long sched = NIL, thrown = NIL;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1 + 1000; }
        long vec(java.util.List<Long> items) { vecs.add(items); return vecs.size() - 1 + 5000; }
        long slot(long v, int i) { return objs.get((int) (v - 1000))[i]; }
    }
--java
    static Rt fresh() { return new Rt(); }
    static String caseOf(boolean hasSched, int thread0, long st) {
        Rt rt = fresh();
        long r = rt.obj(new long[]{});
        long th = thread0 == 3 ? rt.obj(new long[]{st, r}) : NIL;
        java.util.List<Long> items = new java.util.ArrayList<>();
        if (thread0 == 2) items.add(NIL);
        if (thread0 == 3) items.add(th);
        long ts = rt.vec(items);
        if (hasSched) rt.sched = rt.obj(new long[]{ts});
        long ans = mainAnswer(rt);
        return nameOf(ans, r) + ":" + nameOf(rt.thrown, r);
    }
    static String nameOf(long v, long r) {
        if (v == NIL) return "-";
        if (v == r) return "r";
        return "?";
    }
    public static void main(String[] args) {
        System.out.println(
            caseOf(false, 3, Conc.ST_DONE) + " | " +
            caseOf(true, 1, Conc.ST_DONE) + " | " +
            caseOf(true, 2, Conc.ST_DONE) + " | " +
            caseOf(true, 3, Conc.ST_DONE) + " | " +
            caseOf(true, 3, Conc.ST_FAILED) + " | " +
            caseOf(true, 3, Conc.ST_RUNNABLE) + " | " +
            caseOf(true, 3, Conc.ST_PARKED));
    }
