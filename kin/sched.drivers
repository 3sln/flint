        foreach (var c in cases) {
            long rth = rt.MakeObj(new long[]{ c[0], NIL, NIL, NIL, c[1], c[2] }, false);
            long rts = rt.MakeObj(new long[]{ 1, rth }, false);
            long sc = rt.MakeObj(new long[]{ rts, 0, evs, 0, NIL, -1 }, false);
            rt.SchedId = (int) sc;
