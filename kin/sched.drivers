        out.append(' ');
        {
            long pp = rt.obj(new long[]{1}, true);
            long t0 = rt.obj(new long[]{ Conc.ST_RUNNABLE, NIL, NIL, NIL, NIL, NIL, -1 }, false);
            long nts = rt.obj(new long[]{ 1, t0 }, false);
            long ws0 = rt.obj(new long[]{ 0 }, false);
            long sc = rt.obj(new long[]{ nts, 0, evs, 0, ws0, -1 }, false);
            rt.schedId = (int) sc;
            long a = newWaiter(rt, 7, pp);
            long b = newWaiter(rt, 7, pp);
