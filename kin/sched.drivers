        }
        long tsNone = rt.MakeObj(new long[]{ 1, NIL }, false);
        long scNone = rt.MakeObj(new long[]{ tsNone, 0, evs, 0, NIL, -1 }, false);
        rt.SchedId = (int) scNone;
        rt.trace = new System.Text.StringBuilder();
        SchedRunOne(rt, 0);
        outp.Append(rt.trace.Length == 0 ? "-" : "?");
        outp.Append(' ');
