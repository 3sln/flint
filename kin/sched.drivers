                                          NIL, -1, 777 }, false);
            long tsH = rt.obj(new long[]{ 2, tBridge, tOk }, false);
            long sh = rt.obj(new long[]{ tsH, 1, evs, 0, NIL, -1 }, false);
            rt.schedId = (int) sh;
            rt.status = 9; rt.closed = false; rt.thrown = NIL; rt.gasTrips = 2;
            long rOk = schedDrive(rt);
            out.append(rt.status).append(rt.closed ? 1 : 0)
               .append(rOk == 777 ? 1 : 0).append(' ');
            rt.schedId = (int) sg;
            rt.status = 9; rt.closed = false; rt.thrown = NIL; rt.gasTrips = 1;
            schedDrive(rt);
            out.append(rt.status).append(rt.closed ? 1 : 0);
        }
        out.append(' ');
        // 19. ABANDONING THE CURRENT THREAD, and THE WAITER IS THE POINT. The
        //     last field wakes the port afterwards: a waiter still naming this
        //     thread would put it back to RUNNABLE.
        {
            long ap = rt.obj(new long[]{ 1 }, true);
            // NINE SLOTS, so the toy TH_FRAMES at 8 exists to be cleared.
            long at = rt.obj(new long[]{ Conc.ST_RUNNABLE, NIL, NIL, NIL, NIL,
                                         NIL, -1, NIL, NIL }, false);
            long ats = rt.obj(new long[]{ 1, at }, false);
            long aws = rt.obj(new long[]{ 0 }, false);
            long asc = rt.obj(new long[]{ ats, 0, evs, 0, aws, -1 }, false);
            rt.schedId = (int) asc;
            rt.parkOn = NIL;
            rt.thrown = NIL;
            parkOnPort(rt, 1, ap);
            rt.setSlot(at, Conc.TH_STACK, 42);
            rt.setSlot(at, Conc.TH_FRAMES, 43);
            abandonCurrentThread(rt);
            out.append(rt.slot(at, Conc.TH_STATUS)).append(',')
               .append(rt.slot(at, Conc.TH_TOKEN)).append(',')
               .append(rt.slot(at, Conc.TH_STACK) == NIL ? 1 : 0).append(',')
               .append(rt.slot(at, Conc.TH_FRAMES) == NIL ? 1 : 0).append(',')
               .append(outstandingWaiters(rt));
            wakeOn(rt, ap);
            out.append(',').append(rt.slot(at, Conc.TH_STATUS));
            rt.schedId = -1;
            abandonCurrentThread(rt);
            out.append(",1");
        }
        System.out.println(out.toString());
    }
--csharp-head
    internal const long NIL = unchecked((long) 0xFFFF000000000000UL);
    internal const long NOT_FOUND = unchecked((long) 0xFFFF000000000002UL);
    internal static class Conc {
        internal const int SC_THREADS = 0, SC_CURRENT = 1, SC_EVENTS = 2, SC_EHEAD = 3;
        internal const int TH_STATUS = 0, TH_PARK_ON = 1, PT_KIND = 0;
        internal const long ST_NEW = 0, ST_RUNNABLE = 1, ST_PARKED = 2,
                            ST_DONE = 3, ST_FAILED = 4;
        internal static bool CrossesAHeap(long kind) => kind == 1;
        // WHAT `RunOne` CALLS -- see the note in the Rust head.
        internal const int TH_BINDINGS = 2, TH_ENTRY = 3, TH_STACK = 4, TH_FAIL = 5;
        // TH_FRAMES is a TOY 8, free beside the others.
        internal const int TH_FRAMES = 8;
        internal const int TH_TOKEN = 6;
        // A TOY INDEX, matching the other two harnesses rather than `Conc`.
        internal const int TH_RESULT = 7;
        internal const int W_KIND = 4, W_LEN = 5;
        internal static long CurrentThread(Rt rt) {
            long s = Sched(rt);
            if (s == NIL) return NIL;
            return VecNth(rt, rt.Slot(s, SC_THREADS), (int) rt.Slot(s, SC_CURRENT), NIL);
        }
        internal static long NewObj(Rt rt, int ty, int len) {
            var z = new long[len];
            System.Array.Fill(z, NIL);
            return rt.MakeObj(z, false);
        }
        internal static long RunEntry(Rt rt, long f) { rt.trace.Append('E'); return 7; }
        internal static void RestoreState(Rt rt, long th) { rt.trace.Append('T'); }
        internal static void Settle(Rt rt, long v) { rt.trace.Append('L'); }
        internal static void InstallBindings(Rt rt, long b) { rt.trace.Append('B'); }
        internal static void BeginSlice(Rt rt) { rt.trace.Append('S'); }
        internal static void ResetExecState(Rt rt) { rt.trace.Append('R'); }
        // THE WAITER TABLE, at the same toy indices as the other two.
        internal const int SC_WAITERS = 4, SC_WFREE = 5;
        internal const int W_GEN = 0, W_THREAD = 1, W_PORT = 2, W_NEXT = 3;
        // WHAT `Drive` CALLS -- see the note in the Java head.
        internal static void BootSystemThreadOnce(Rt rt) {}
        internal static void ReapPorts(Rt rt) {}
        internal static void CloseAllBridges(Rt rt) { rt.Closed = true; }
        internal static void RunOne(Rt rt, int i) {
            long ts = rt.Objs[rt.SchedId][0];
            long th = rt.Objs[(int) ts][i + 1];
            rt.Objs[(int) th][0] = ST_DONE;
        }
        internal static long SettledAnswer(Rt rt) => 999;
        internal static void ReportDeadlock(Rt rt) { rt.Deadlocked = true; }
        internal static long Sched(Rt rt) => rt.SchedId < 0 ? NIL : rt.SchedId;
        internal static bool IsPort(Rt rt, long v) =>
            v != NIL && v >= 0 && v < rt.Ports.Count && rt.Ports[(int) v];
    }
    internal static class Val {
        internal const long Nil = NIL;
        internal static bool IsNil(long v) => v == NIL;
        internal const long NotFound = NOT_FOUND;
        internal const long Park = unchecked((long) 0xFFFF000000000004UL);
        internal static long AsFixnum(long v) => v;
        internal static long Fixnum(long n) => n;
        // Identity: here a value IS its object id, and the generated code
        // inserts `AsHeap` at every slot write.
        internal static long AsHeap(long v) => v;
    }
    // BARE, as `vecread` exports them.
    static int VecCount(Rt rt, long v) => v == NIL ? 0 : (int) rt.Objs[(int) v][0];
    // `TY_NODE` is `Obj.TyNode` on this target, which is a class the toy has
    // to stand up even though it holds one constant.
    internal static class Obj { internal const int TyNode = 10; }
    static long VecConj(Rt rt, long v, long x) {
        int n = VecCount(rt, v);
        var items = new long[n + 2];
        items[0] = n + 1;
        for (int k = 0; k < n; k++) items[k + 1] = rt.Objs[(int) v][k + 1];
        items[n + 1] = x;
        return rt.MakeObj(items, false);
    }
    static long VecNth(Rt rt, long v, int i, long d) {
        int n = VecCount(rt, v);
        return i >= n ? d : rt.Objs[(int) v][i + 1];
    }
    internal sealed class Rt {
        internal System.Collections.Generic.List<System.Collections.Generic.List<long>> Objs = new();
        internal System.Collections.Generic.List<bool> Ports = new();
        internal int SchedId = -1;
        internal int status = 0;
        internal bool Closed = false, Deadlocked = false;
        internal System.Collections.Generic.List<long> Roots = new();
        internal System.Text.StringBuilder trace = new();
        internal long parkOn = NIL;
        internal long thrown = NIL;
        internal bool catches = true;
        // HOW MANY TIMES THE BUDGET BLEW; `> 1` is the gate having escaped.
        internal int gasTrips = 0;
        internal int Mark() => Roots.Count;
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) => Roots[i];
        internal void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
        internal long Run(int n) { trace.Append('V'); return 7; }
        internal bool Unwind() { trace.Append('U'); return catches; }
        internal long Slot(long v, int i) => Objs[(int) v][i];
        internal void SetSlot(long v, int i, long x) { Objs[(int) v][i] = x; }
        internal long MakeObj(long[] slots, bool isPort) {
            var s = new System.Collections.Generic.List<long>(slots);
            Objs.Add(s); Ports.Add(isPort);
            return Objs.Count - 1;
        }
    }
