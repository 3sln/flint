    public static void main(String[] args) {
        Rt rt = new Rt();
        long bridge = rt.obj(new long[]{1}, true);
        long channel = rt.obj(new long[]{0}, true);
        long tRun = rt.obj(new long[]{Conc.ST_RUNNABLE, NIL}, false);
        long tBridge = rt.obj(new long[]{Conc.ST_PARKED, bridge}, false);
        long tChan = rt.obj(new long[]{Conc.ST_PARKED, channel}, false);
        long tNew = rt.obj(new long[]{Conc.ST_NEW, NIL}, false);
        StringBuilder out = new StringBuilder();

        long ts = rt.obj(new long[]{2, tBridge, tChan}, false);
        long evs = rt.obj(new long[]{0}, false);
        long s = rt.obj(new long[]{ts, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s;
        out.append(schedPick(rt)).append(" ");
        out.append(schedNeedsHost(rt) ? 1 : 0).append(" ");

        long ts2 = rt.obj(new long[]{3, tBridge, tRun, tNew}, false);
        long s2 = rt.obj(new long[]{ts2, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s2;
        out.append(schedPick(rt)).append(" ");
        long s3 = rt.obj(new long[]{ts2, 1, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s3;
        out.append(schedPick(rt)).append(" ");

        long ts4 = rt.obj(new long[]{1, tChan}, false);
        long s4 = rt.obj(new long[]{ts4, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s4;
        out.append(schedNeedsHost(rt) ? 1 : 0).append(" ");

        long evs2 = rt.obj(new long[]{2}, false);
        long s5 = rt.obj(new long[]{ts4, 0, evs2, 0, NIL, -1}, false);
        rt.schedId = (int) s5;
        out.append(schedPendingEvents(rt) ? 1 : 0).append(" ");
        out.append(schedNeedsHost(rt) ? 1 : 0).append(" ");
        long s6 = rt.obj(new long[]{ts4, 0, evs2, 2, NIL, -1}, false);
        rt.schedId = (int) s6;
        out.append(schedPendingEvents(rt) ? 1 : 0).append(" ");

        rt.schedId = -1;
        out.append(schedPick(rt)).append(" ");
        out.append(schedPendingEvents(rt) ? 1 : 0).append(" ");
        out.append(schedNeedsHost(rt) ? 1 : 0).append(" ");
        out.append(schedAllSettled(rt) ? 1 : 0).append(" ");
        long tDone = rt.obj(new long[]{3, NIL}, false);
        long tsDone = rt.obj(new long[]{1, tDone}, false);
        long s7 = rt.obj(new long[]{tsDone, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s7;
        out.append(schedAllSettled(rt) ? 1 : 0).append(" ");
        long tsMixed = rt.obj(new long[]{2, tDone, tChan}, false);
        long s8 = rt.obj(new long[]{tsMixed, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s8;
        out.append(schedAllSettled(rt) ? 1 : 0).append(" ");

        long tsB = rt.obj(new long[]{1, tBridge}, false);
        long s9 = rt.obj(new long[]{tsB, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s9;
        rt.status = 0; rt.closed = false; rt.deadlocked = false;
        long r1 = schedDrive(rt);
        out.append(rt.status).append(rt.closed ? 1 : 0)
           .append(r1 == NIL ? 0 : 1).append(" ");

        long tDone2 = rt.obj(new long[]{3, NIL}, false);
        long tsD = rt.obj(new long[]{1, tDone2}, false);
        long s10 = rt.obj(new long[]{tsD, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s10;
        rt.status = 9; rt.closed = false; rt.deadlocked = false;
        long r2 = schedDrive(rt);
        out.append(rt.status).append(rt.closed ? 1 : 0)
           .append(r2 == 999 ? 1 : 0).append(" ");

        long tRun2 = rt.obj(new long[]{1, NIL}, false);
        long tsR = rt.obj(new long[]{1, tRun2}, false);
        long s11 = rt.obj(new long[]{tsR, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s11;
        rt.status = 9; rt.closed = false; rt.deadlocked = false;
        schedDrive(rt);
        out.append(rt.status).append(rt.closed ? 1 : 0).append(" ");

        long tsC = rt.obj(new long[]{1, tChan}, false);
        long s12 = rt.obj(new long[]{tsC, 0, evs, 0, NIL, -1}, false);
        rt.schedId = (int) s12;
        rt.status = 9; rt.closed = false; rt.deadlocked = false;
        schedDrive(rt);
        out.append(rt.status).append(rt.deadlocked ? 1 : 0).append(" ");

        long tDone3 = rt.obj(new long[]{3, NIL}, false);
        long tsMix = rt.obj(new long[]{2, tDone3, tBridge}, false);
