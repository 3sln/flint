            long pp = rt.MakeObj(new long[]{1}, true);
            long qq = rt.MakeObj(new long[]{1}, true);
            long t0 = rt.MakeObj(new long[]{ Conc.ST_PARKED, pp, NIL, NIL, NIL, NIL, 1 }, false);
            long t1 = rt.MakeObj(new long[]{ Conc.ST_PARKED, qq, NIL, NIL, NIL, NIL, 2 }, false);
            long ww0 = rt.MakeObj(new long[]{ 0, t0, pp, -1 }, false);
            long ww1 = rt.MakeObj(new long[]{ 0, t1, qq, -1 }, false);
            long wws = rt.MakeObj(new long[]{ 2, ww0, ww1 }, false);
            long wts = rt.MakeObj(new long[]{ 2, t0, t1 }, false);
            long sc = rt.MakeObj(new long[]{ wts, 0, evs, 0, wws, -1 }, false);
            rt.SchedId = (int) sc;
            WakeOn(rt, pp);
            outp.Append(rt.Slot(t0, Conc.TH_STATUS)).Append(',')
                .Append(rt.Slot(t0, Conc.TH_TOKEN)).Append(',')
                .Append(rt.Slot(sc, 5)).Append(',')
                .Append(rt.Slot(t1, Conc.TH_STATUS)).Append(',')
                .Append(Val.IsNil(WaiterAt(rt, 1)) ? 0 : 1).Append(' ');
            long rr = rt.MakeObj(new long[]{1}, true);
            long before = rt.Slot(sc, 5);
            WakeOn(rt, rr);
            outp.Append(rt.Slot(t1, Conc.TH_STATUS))
                .Append(rt.Slot(sc, 5) == before ? 1 : 0);
        }
        outp.Append(' ');
        {
            long pp = rt.MakeObj(new long[]{1}, true);
            long t0 = rt.MakeObj(new long[]{ Conc.ST_RUNNABLE, NIL, NIL, NIL, NIL, NIL, -1 }, false);
            long nts = rt.MakeObj(new long[]{ 1, t0 }, false);
            long ws0 = rt.MakeObj(new long[]{ 0 }, false);
            long sc = rt.MakeObj(new long[]{ nts, 0, evs, 0, ws0, -1 }, false);
            rt.SchedId = (int) sc;
            long a = NewWaiter(rt, 7, pp);
            long b = NewWaiter(rt, 7, pp);
            outp.Append(a).Append(',').Append(b).Append(',');
            FreeWaiter(rt, a);
            long c = NewWaiter(rt, 7, pp);
            long scv = Conc.Sched(rt);
            outp.Append(c).Append(',').Append(VecCount(rt, rt.Slot(scv, Conc.SC_WAITERS)));
        }
        outp.Append(' ');
        {
            long pp = rt.MakeObj(new long[]{1}, true);
            long t0 = rt.MakeObj(new long[]{ Conc.ST_RUNNABLE, NIL, NIL, NIL, NIL, NIL, -1 }, false);
            long pts = rt.MakeObj(new long[]{ 1, t0 }, false);
            long pws = rt.MakeObj(new long[]{ 0 }, false);
            long psc = rt.MakeObj(new long[]{ pts, 0, evs, 0, pws, -1 }, false);
            rt.SchedId = (int) psc;
            rt.parkOn = NIL; rt.thrown = NIL;
            long r = ParkOnPort(rt, 7, pp);
            long w = WaiterAt(rt, 1);
            outp.Append(rt.Slot(t0, Conc.TH_TOKEN)).Append(',')
                .Append(rt.parkOn == pp ? 1 : 0).Append(',')
                .Append(rt.thrown == Val.Park ? 1 : 0).Append(',')
                .Append(r == NIL ? 1 : 0).Append(',')
                .Append(!Val.IsNil(w) && rt.Slot(w, Conc.W_PORT) == pp ? 1 : 0);
            rt.SetSlot(t0, Conc.TH_STATUS, Conc.ST_PARKED);
            WakeOn(rt, pp);
            outp.Append(',').Append(rt.Slot(t0, Conc.TH_STATUS))
                .Append(',').Append(rt.Slot(t0, Conc.TH_TOKEN));
        }
        outp.Append(' ');
        // 18. THE GATE, and the ORDER it is asked in -- see the Rust driver.
        {
            long tFailed = rt.MakeObj(new long[]{ Conc.ST_FAILED, NIL, NIL, NIL,
                                                  NIL, NIL, -1, 555 }, false);
            long tsG = rt.MakeObj(new long[]{ 2, tFailed, tBridge }, false);
            long sg = rt.MakeObj(new long[]{ tsG, 0, evs, 0, NIL, -1 }, false);
            rt.SchedId = (int) sg;
            rt.status = 9; rt.Closed = false; rt.thrown = NIL; rt.gasTrips = 2;
            long rFail = SchedDrive(rt);
            outp.Append(rt.status).Append(rt.Closed ? 1 : 0)
                .Append(rt.thrown == 555 ? 1 : 0).Append(rFail == NIL ? 1 : 0).Append(' ');
            long tOk = rt.MakeObj(new long[]{ Conc.ST_DONE, NIL, NIL, NIL, NIL,
                                              NIL, -1, 777 }, false);
            long tsH = rt.MakeObj(new long[]{ 2, tBridge, tOk }, false);
            long sh = rt.MakeObj(new long[]{ tsH, 1, evs, 0, NIL, -1 }, false);
            rt.SchedId = (int) sh;
            rt.status = 9; rt.Closed = false; rt.thrown = NIL; rt.gasTrips = 2;
            long rOk = SchedDrive(rt);
            outp.Append(rt.status).Append(rt.Closed ? 1 : 0)
                .Append(rOk == 777 ? 1 : 0).Append(' ');
            rt.SchedId = (int) sg;
            rt.status = 9; rt.Closed = false; rt.thrown = NIL; rt.gasTrips = 1;
            SchedDrive(rt);
            outp.Append(rt.status).Append(rt.Closed ? 1 : 0);
        }
        outp.Append(' ');
        // 19. ABANDONING THE CURRENT THREAD, and THE WAITER IS THE POINT. The
        //     last field wakes the port afterwards: a waiter still naming this
        //     thread would put it back to RUNNABLE.
        {
            long ap = rt.MakeObj(new long[]{ 1 }, true);
            // NINE SLOTS, so the toy TH_FRAMES at 8 exists to be cleared.
            long at = rt.MakeObj(new long[]{ Conc.ST_RUNNABLE, NIL, NIL, NIL,
                                             NIL, NIL, -1, NIL, NIL }, false);
            long ats = rt.MakeObj(new long[]{ 1, at }, false);
            long aws = rt.MakeObj(new long[]{ 0 }, false);
            long asc = rt.MakeObj(new long[]{ ats, 0, evs, 0, aws, -1 }, false);
            rt.SchedId = (int) asc;
            rt.parkOn = NIL;
            rt.thrown = NIL;
            ParkOnPort(rt, 1, ap);
            rt.SetSlot(at, Conc.TH_STACK, 42);
            rt.SetSlot(at, Conc.TH_FRAMES, 43);
            AbandonCurrentThread(rt);
            outp.Append(rt.Slot(at, Conc.TH_STATUS)).Append(',')
                .Append(rt.Slot(at, Conc.TH_TOKEN)).Append(',')
                .Append(rt.Slot(at, Conc.TH_STACK) == NIL ? 1 : 0).Append(',')
                .Append(rt.Slot(at, Conc.TH_FRAMES) == NIL ? 1 : 0).Append(',')
                .Append(OutstandingWaiters(rt));
            WakeOn(rt, ap);
            outp.Append(',').Append(rt.Slot(at, Conc.TH_STATUS));
            rt.SchedId = -1;
            AbandonCurrentThread(rt);
            outp.Append(",1");
        }
        System.Console.WriteLine(outp.ToString());
