        long s7 = rt.MakeObj(new long[]{tsDone, 0, evs, 0, NIL, -1}, false);
        rt.SchedId = (int) s7;
        outp.Append(SchedAllSettled(rt) ? 1 : 0).Append(" ");
        long tsMixed = rt.MakeObj(new long[]{2, tDone, tChan}, false);
