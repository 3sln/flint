            long pts = rt.obj(new long[]{ 1, t0 }, false);
            long pws = rt.obj(new long[]{ 0 }, false);
            long psc = rt.obj(new long[]{ pts, 0, evs, 0, pws, -1 }, false);
            rt.schedId = (int) psc;
            rt.parkOn = NIL; rt.thrown = NIL;
            long r = parkOnPort(rt, 7, pp);
            long w = waiterAt(rt, 1);
            out.append(rt.slot(t0, Conc.TH_TOKEN)).append(',')
               .append(rt.parkOn == pp ? 1 : 0).append(',')
               .append(rt.thrown == Val.PARK ? 1 : 0).append(',')
               .append(r == NIL ? 1 : 0).append(',')
               .append(!Val.isNil(w) && rt.slot(w, Conc.W_PORT) == pp ? 1 : 0);
            rt.setSlot(t0, Conc.TH_STATUS, Conc.ST_PARKED);
            wakeOn(rt, pp);
            out.append(',').append(rt.slot(t0, Conc.TH_STATUS))
               .append(',').append(rt.slot(t0, Conc.TH_TOKEN));
        }
        out.append(' ');
        // 18. THE GATE, and the ORDER it is asked in -- see the Rust driver.
        {
            long tFailed = rt.obj(new long[]{ Conc.ST_FAILED, NIL, NIL, NIL, NIL,
                                              NIL, -1, 555 }, false);
            long tsG = rt.obj(new long[]{ 2, tFailed, tBridge }, false);
            long sg = rt.obj(new long[]{ tsG, 0, evs, 0, NIL, -1 }, false);
            rt.schedId = (int) sg;
