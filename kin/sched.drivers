        long w1 = rt.MakeObj(new long[]{3, NIL, NIL, -1}, false);
        long ws = rt.MakeObj(new long[]{2, w0, w1}, false);
        long sw = rt.MakeObj(new long[]{tsMix, 0, evs, 0, ws, -1}, false);
        rt.SchedId = (int) sw;
        outp.Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, 0)) ? 0 : 1).Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, -1)) ? 0 : 1).Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, 1)) ? 0 : 1).Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, 65537)) ? 0 : 1).Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, 196610)) ? 0 : 1).Append(" ");
        outp.Append(Val.IsNil(WaiterAt(rt, 9)) ? 0 : 1).Append(" ");
        outp.Append(OutstandingWaiters(rt)).Append(" ");
        int freed = Val.IsNil(FreeWaiter(rt, 1)) ? 0 : 1;
        int stale = Val.IsNil(WaiterAt(rt, 1)) ? 0 : 1;
        int left = OutstandingWaiters(rt);
        long head = Val.AsFixnum(rt.Slot(sw, Conc.SC_WFREE));
        outp.Append(freed).Append(stale).Append(left).Append(head).Append(" ");
        outp.Append(Val.IsNil(FreeWaiter(rt, 1)) ? 0 : 1).Append(" ");
        rt.SchedId = -1;
        outp.Append(OutstandingWaiters(rt));
        // 13. RUN-ONE: each field is the PATH TAKEN. See the Rust driver.
