--rust-head
// A TOY SCHEDULER, enough to drive the three predicates.
//
// Values are small integers: a scheduler, threads and ports are rows in side
// tables, and `slot` indexes them. What the predicates actually need is a
// thread list, a current index, an event count and an event head -- so that is
// all the model has.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
const NOT_FOUND: Value = Value(0xFFFF_0000_0000_0002);
const TY_NODE: u8 = 10;
mod value { pub const PARK: super::Value = super::Value(0xFFFF_0000_0000_0004); }
mod conc {
    // WHAT `drive` CALLS. `run_one` marks the thread DONE, which is what makes
    // the loop terminate in a harness with no interpreter under it.
    pub fn run_one(rt: &mut super::Rt, i: u32) {
        let ts = rt.objs[rt.sched_id.unwrap()][0];
        let th = super::Rt::vec_nth_raw(rt, ts, i);
        rt.objs[th.0 as usize][0] = super::Value(ST_DONE as u64);
    }
    pub fn settled_answer(rt: &mut super::Rt) -> super::Value { super::Value(999) }
    pub fn report_deadlock(rt: &mut super::Rt) { rt.deadlocked = true; }
    pub const SC_THREADS: u32 = 0;
    pub const SC_CURRENT: u32 = 1;
    pub const SC_EVENTS: u32 = 2;
    pub const SC_EHEAD: u32 = 3;
    pub const TH_STATUS: u32 = 0;
    pub const TH_PARK_ON: u32 = 1;
    pub const PT_KIND: u32 = 0;
    pub const ST_NEW: i64 = 0;
    pub const ST_RUNNABLE: i64 = 1;
    pub const ST_PARKED: i64 = 2;
    pub const ST_DONE: i64 = 3;
    pub const ST_FAILED: i64 = 4;
    // A BRIDGE crosses a heap; a channel does not. That distinction is the
    // whole of `needs-host`.
    pub fn crosses_a_heap(kind: i64) -> bool { kind == 1 }
    // WHAT `run-one` CALLS. Each records a LETTER on the trace, which is the
    // whole of what the expected answer asserts: not what a thread computed,
    // but WHICH PATH it took and in what order.
    pub fn run_entry(rt: &mut super::Rt, _f: super::Value) -> super::Value { rt.trace.push('E'); super::Value(7) }
    pub fn restore_state(rt: &mut super::Rt, _th: super::Value) { rt.trace.push('T'); }
    pub fn settle(rt: &mut super::Rt, _v: super::Value) { rt.trace.push('L'); }
    pub const TH_BINDINGS: u32 = 2;
    pub const TH_TOKEN: u32 = 6;
    // A TOY INDEX, and deliberately not the real `TH_RESULT` (2, which is
    // `TH_BINDINGS` here). What has to agree is the three harnesses, not this
    // and `Conc`.
    pub const TH_RESULT: u32 = 7;
    pub const TH_ENTRY: u32 = 3;
    pub const TH_STACK: u32 = 4;
    // TH_FRAMES is a TOY 8, free beside the others. What has to agree is
    // the three harnesses, not this and the real `Conc`.
    pub const TH_FRAMES: u32 = 8;
    pub const TH_FAIL: u32 = 5;
    // THE WAITER TABLE. Toy indices -- what matters is that all three
    // harnesses agree with each other, not with the real `Conc`.
    pub const SC_WAITERS: u32 = 4;
    pub const SC_WFREE: u32 = 5;
    pub const W_GEN: u32 = 0;
    pub const W_THREAD: u32 = 1;
    pub const W_PORT: u32 = 2;
    pub const W_NEXT: u32 = 3;
    pub const W_KIND: u32 = 4;
    pub const W_LEN: u32 = 5;
}
impl Value {
    fn is_nil(self) -> bool { self == NIL }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
}
struct Rt {
    // objects: rows of slots, each a Value
    objs: Vec<Vec<Value>>,
    // which object ids are ports
    ports: Vec<bool>,
    sched_id: Option<usize>,
    // WHAT `run-one` DID, in order. A trace rather than a result: what is
    // under test is the PATH, and two paths can reach the same value.
    roots: Vec<Value>,
    trace: String,
    park_on: Value,
    thrown: Value,
    catches: bool,
    // HOW MANY TIMES THE BUDGET BLEW. `> 1` is the gate having escaped every
    // handler, which is the one thing `drive` asks it.
    gas_trips: u32,
    // WHAT `drive` DID, so the order can be asserted rather than inferred.
    status: i32,
    closed: bool,
    deadlocked: bool,
}
impl Rt {
    fn obj(&mut self, slots: Vec<Value>, is_port: bool) -> Value {
        self.objs.push(slots);
        self.ports.push(is_port);
        Value((self.objs.len() - 1) as u64)
    }
    // THE ROOT STACK, which `run-one` brackets its work with.
    fn mark(&mut self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn install_bindings(&mut self, _b: Value) { self.trace.push('B'); }
    fn begin_slice(&mut self) { self.trace.push('S'); }
    fn reset_exec_state(&mut self) { self.trace.push('R'); }
    fn restore_state(&mut self, th: Value) { conc::restore_state(self, th); }
    fn run(&mut self, _n: u32) -> Value { self.trace.push('V'); Value(7) }
    // WHETHER A HANDLER CAUGHT IT is the harness's to choose, so both arms of
    // the failure path can be driven.
    fn unwind_from_resume(&mut self) -> bool { self.trace.push('U'); self.catches }
    fn boot_system_thread_once(&mut self) {}
    fn reap_ports(&mut self) {}
    fn close_all_bridges(&mut self) { self.closed = true; }
    // `&self`, NOT `&mut self`, and that matters: the real `Rt::slot` and
    // `Rt::sched` are both `&self`, so a harness that demands `&mut` is
    // STRICTER THAN THE RUNTIME -- it rejects `self.set(w, i, self.slot(..))`,
    // which native writes and the borrow checker accepts, and would push a
    // hoist into the kin source to satisfy the toy rather than the target.
    fn sched(&self) -> Value {
        match self.sched_id { Some(i) => Value(i as u64), None => NIL }
    }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn is_port(&self, v: Value) -> bool {
        !v.is_nil() && (v.0 as usize) < self.ports.len() && self.ports[v.0 as usize]
    }
    // A VECTOR is an object whose slot 0 is its count; the items follow.
    fn vec_count(&self, v: Value) -> u32 {
        if v.is_nil() { return 0; }
        self.objs[v.0 as usize][0].0 as u32
    }
    fn vec_nth_raw(rt: &mut Rt, v: Value, i: u32) -> Value {
        rt.objs[v.0 as usize][(i + 1) as usize]
    }
    // ALLOCATION, enough for `new-waiter`. A fresh object is a row of NIL;
    // `vec_conj` copies and appends, which is what makes the old vector's
    // survival observable if it is not rooted.
    fn new_obj(&mut self, _ty: u8, len: u32) -> Value {
        self.objs.push(vec![NIL; len as usize]);
        self.ports.push(false);
        Value((self.objs.len() - 1) as u64)
    }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let mut items: Vec<Value> = self.objs[v.0 as usize].clone();
        let n = items[0].0 as usize;
        items.truncate(n + 1);
        items.push(x);
        items[0] = Value((n + 1) as u64);
        self.objs.push(items);
        self.ports.push(false);
        Value((self.objs.len() - 1) as u64)
    }
    fn current_thread(&self) -> Value {
        let s = self.sched();
        if s.is_nil() { return NIL; }
        let ts = self.slot(s, conc::SC_THREADS);
        let i = self.slot(s, conc::SC_CURRENT).as_fixnum() as u32;
        self.vec_nth(ts, i, NIL)
    }
    fn vec_nth(&self, v: Value, i: u32, d: Value) -> Value {
        let n = self.vec_count(v);
        if i >= n { return d; }
        self.objs[v.0 as usize][(i + 1) as usize]
    }
--rust
}
fn fx(n: i64) -> Value { Value(n as u64) }
fn main() {
    // Threads: one RUNNABLE, one PARKED on a bridge, one PARKED on a channel.
    let mut rt = Rt { objs: Vec::new(), ports: Vec::new(), sched_id: None,
                      roots: Vec::new(), trace: String::new(), park_on: NIL,
                      thrown: NIL, catches: true, gas_trips: 0,
                      status: 0, closed: false, deadlocked: false };
    let bridge = rt.obj(vec![fx(1)], true);
    let channel = rt.obj(vec![fx(0)], true);
    let t_run = rt.obj(vec![fx(conc::ST_RUNNABLE), NIL], false);
    let t_bridge = rt.obj(vec![fx(conc::ST_PARKED), bridge], false);
    let t_chan = rt.obj(vec![fx(conc::ST_PARKED), channel], false);
    let t_new = rt.obj(vec![fx(conc::ST_NEW), NIL], false);

    let mut out = String::new();

    // 1. NOTHING RUNNABLE, and the answer is the COUNT, not a sentinel.
    let ts = rt.obj(vec![fx(2), t_bridge, t_chan], false);
    let evs = rt.obj(vec![fx(0)], false);
    let s = rt.obj(vec![ts, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s.0 as usize);
    out.push_str(&format!("{} ", rt.sched_pick()));
    out.push_str(&format!("{} ", rt.sched_needs_host() as u32));

    // 2. ROUND-ROBIN FROM JUST AFTER CURRENT. Threads [parked, runnable, new]
    //    with current = 0 must pick 1, and with current = 1 must pick 2.
    let ts2 = rt.obj(vec![fx(3), t_bridge, t_run, t_new], false);
    let s2 = rt.obj(vec![ts2, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s2.0 as usize);
    out.push_str(&format!("{} ", rt.sched_pick()));
    let s3 = rt.obj(vec![ts2, fx(1), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s3.0 as usize);
    out.push_str(&format!("{} ", rt.sched_pick()));

    // 3. A CHANNEL PARK IS NOT THE HOST'S PROBLEM.
    let ts4 = rt.obj(vec![fx(1), t_chan], false);
    let s4 = rt.obj(vec![ts4, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s4.0 as usize);
    out.push_str(&format!("{} ", rt.sched_needs_host() as u32));

    // 4. AN UNDRAINED EVENT IS, even with nothing parked at all.
    let evs2 = rt.obj(vec![fx(2)], false);
    let s5 = rt.obj(vec![ts4, fx(0), evs2, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s5.0 as usize);
    out.push_str(&format!("{} ", rt.sched_pending_events() as u32));
    out.push_str(&format!("{} ", rt.sched_needs_host() as u32));
    // ... and a head that has caught up is not.
    let s6 = rt.obj(vec![ts4, fx(0), evs2, fx(2), NIL, fx(-1)], false);
    rt.sched_id = Some(s6.0 as usize);
    out.push_str(&format!("{} ", rt.sched_pending_events() as u32));

    // 5. NO SCHEDULER AT ALL answers, rather than reaching into nil.
    rt.sched_id = None;
    out.push_str(&format!("{} ", rt.sched_pick()));
    out.push_str(&format!("{} ", rt.sched_pending_events() as u32));
    out.push_str(&format!("{} ", rt.sched_needs_host() as u32));
    // 6. SETTLED. A nil scheduler is settled -- no threads, none outstanding.
    out.push_str(&format!("{} ", rt.sched_all_settled() as u32));
    let t_done = rt.obj(vec![fx(3), NIL], false);
    let ts_done = rt.obj(vec![fx(1), t_done], false);
    let s7 = rt.obj(vec![ts_done, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s7.0 as usize);
    out.push_str(&format!("{} ", rt.sched_all_settled() as u32));
    // ... and ONE PARKED THREAD IS NOT SETTLED, even beside a finished one.
    let ts_mixed = rt.obj(vec![fx(2), t_done, t_chan], false);
    let s8 = rt.obj(vec![ts_mixed, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s8.0 as usize);
    out.push_str(&format!("{} ", rt.sched_all_settled() as u32));

    // --- `drive`, and what it is asked FIRST ------------------------------
    //
    // 7. A THREAD PARKED ON A BRIDGE. The host may still wake it, so drive
    //    must answer 2 and must NOT close the bridges -- that is the order
    //    that was wrong on both ports.
    let ts_b = rt.obj(vec![fx(1), t_bridge], false);
    let s9 = rt.obj(vec![ts_b, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s9.0 as usize);
    rt.status = 0; rt.closed = false; rt.deadlocked = false;
    let r1 = rt.sched_drive();
    out.push_str(&format!("{}{}{} ", rt.status, rt.closed as u32,
                          if r1 == NIL { 0 } else { 1 }));

    // 8. EVERYTHING SETTLED. Bridges close, status 0, and the answer comes
    //    from `settled-answer`.
    let t_done2 = rt.obj(vec![fx(3), NIL], false);
    let ts_d = rt.obj(vec![fx(1), t_done2], false);
    let s10 = rt.obj(vec![ts_d, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s10.0 as usize);
    rt.status = 9; rt.closed = false; rt.deadlocked = false;
    let r2 = rt.sched_drive();
    out.push_str(&format!("{}{}{} ", rt.status, rt.closed as u32,
                          if r2 == Value(999) { 1 } else { 0 }));

    // 9. A RUNNABLE THREAD runs first, and only then is the question asked.
    let t_run2 = rt.obj(vec![fx(1), NIL], false);
    let ts_r = rt.obj(vec![fx(1), t_run2], false);
    let s11 = rt.obj(vec![ts_r, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s11.0 as usize);
    rt.status = 9; rt.closed = false; rt.deadlocked = false;
    rt.sched_drive();
    out.push_str(&format!("{}{} ", rt.status, rt.closed as u32));

    // 10. PARKED ON A CHANNEL, which no host can help: named, not hung.
    let ts_c = rt.obj(vec![fx(1), t_chan], false);
    let s12 = rt.obj(vec![ts_c, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s12.0 as usize);
    rt.status = 9; rt.closed = false; rt.deadlocked = false;
    rt.sched_drive();
    out.push_str(&format!("{}{} ", rt.status, rt.deadlocked as u32));

    // 11. THE CASE THAT REPRODUCES THE BUG. A FINISHED thread beside one
    //     parked on a BRIDGE. Asking "has the entry finished?" first answers
    //     yes -- thread 0 IS done -- and closes the system port under a call
    //     that has just parked on an `open`. Asking the host first answers 2
    //     and leaves the bridges alone. No other case here separates them.
    let t_done3 = rt.obj(vec![fx(3), NIL], false);
    let ts_mix = rt.obj(vec![fx(2), t_done3, t_bridge], false);
    let s13 = rt.obj(vec![ts_mix, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(s13.0 as usize);
    rt.status = 9; rt.closed = false; rt.deadlocked = false;
    rt.sched_drive();
    out.push_str(&format!("{}{}", rt.status, rt.closed as u32));
    // 12. THE WAITER TABLE. One LIVE waiter and one FREED, and then every way
    //     a token can fail to name the live one. `t_run`'s status by now is
    //     whatever earlier cases left it -- irrelevant here, since a waiter is
    //     live if `W_THREAD` is non-nil and nothing else.
    let w0 = rt.obj(vec![fx(0), t_run, NIL, fx(-1)], false);
    let w1 = rt.obj(vec![fx(3), NIL, NIL, fx(-1)], false);
    let ws = rt.obj(vec![fx(2), w0, w1], false);
    let sw = rt.obj(vec![ts_mix, fx(0), evs, fx(0), ws, fx(-1)], false);
    rt.sched_id = Some(sw.0 as usize);
    out.push_str(" ");
    out.push_str(&format!("{} ", (!rt.waiter_at(0).is_nil()) as u32));
    out.push_str(&format!("{} ", (!rt.waiter_at(-1).is_nil()) as u32));
    out.push_str(&format!("{} ", (!rt.waiter_at(1).is_nil()) as u32));
    out.push_str(&format!("{} ", (!rt.waiter_at(65537).is_nil()) as u32));
    out.push_str(&format!("{} ", (!rt.waiter_at(196610).is_nil()) as u32));
    out.push_str(&format!("{} ", (!rt.waiter_at(9).is_nil()) as u32));
    out.push_str(&format!("{} ", rt.outstanding_waiters()));
    // FREEING: what it answers, that the token goes stale, that the count
    // drops, and that the slot reaches the free list.
    let freed = (!rt.free_waiter(1).is_nil()) as u32;
    let stale = (!rt.waiter_at(1).is_nil()) as u32;
    let left = rt.outstanding_waiters();
    let head = rt.slot(sw, conc::SC_WFREE).as_fixnum();
    out.push_str(&format!("{}{}{}{} ", freed, stale, left, head));
    out.push_str(&format!("{} ", (!rt.free_waiter(1).is_nil()) as u32));
    rt.sched_id = None;
    out.push_str(&format!("{}", rt.outstanding_waiters()));
    // 13. RUN-ONE, and each field is the PATH TAKEN rather than a value.
    //     A thread is [status, park_on, bindings, entry, stack, fail].
    let mut once = |rt: &mut Rt, st: i64, stack: Value, fail: Value, catches: bool| -> String {
        let th = rt.obj(vec![fx(st), NIL, NIL, NIL, stack, fail], false);
        let ts = rt.obj(vec![fx(1), th], false);
        let sc = rt.obj(vec![ts, fx(0), evs, fx(0), NIL, fx(-1)], false);
        rt.sched_id = Some(sc.0 as usize);
        rt.trace = String::new();
        rt.catches = catches;
        rt.sched_run_one(0);
        if rt.trace.is_empty() { "-".to_string() } else { rt.trace.clone() }
    };
    let stack = rt.obj(vec![fx(0)], false);
    out.push_str(" ");
    let t1 = once(&mut rt, conc::ST_NEW, NIL, NIL, true);
    out.push_str(&format!("{t1} "));
    let t2 = once(&mut rt, conc::ST_RUNNABLE, stack, NIL, true);
    out.push_str(&format!("{t2} "));
    let t3 = once(&mut rt, conc::ST_RUNNABLE, stack, fx(9), true);
    out.push_str(&format!("{t3} "));
    let t4 = once(&mut rt, conc::ST_RUNNABLE, stack, fx(9), false);
    out.push_str(&format!("{t4} "));
    // A THREAD THAT IS NOT THERE: nothing runs and nothing settles.
    let ts_none = rt.obj(vec![fx(1), NIL], false);
    let sc_none = rt.obj(vec![ts_none, fx(0), evs, fx(0), NIL, fx(-1)], false);
    rt.sched_id = Some(sc_none.0 as usize);
    rt.trace = String::new();
    rt.sched_run_one(0);
    out.push_str(if rt.trace.is_empty() { "-" } else { "?" });
    out.push(' ');
    // 14. WAKING. Two threads parked on two different ports, each with a
    //     waiter naming it. Waking one port must move exactly one of them.
    {
        let pp = rt.obj(vec![fx(1)], true);
        let qq = rt.obj(vec![fx(1)], true);
        // [status, park_on, bindings, entry, stack, fail, token]
        let t0 = rt.obj(vec![fx(conc::ST_PARKED), pp, NIL, NIL, NIL, NIL, fx(1)], false);
        let t1 = rt.obj(vec![fx(conc::ST_PARKED), qq, NIL, NIL, NIL, NIL, fx(2)], false);
        // [gen, thread, port, next]
        let w0 = rt.obj(vec![fx(0), t0, pp, fx(-1)], false);
        let w1 = rt.obj(vec![fx(0), t1, qq, fx(-1)], false);
        let ws = rt.obj(vec![fx(2), w0, w1], false);
        let ts = rt.obj(vec![fx(2), t0, t1], false);
        let sc = rt.obj(vec![ts, fx(0), evs, fx(0), ws, fx(-1)], false);
        rt.sched_id = Some(sc.0 as usize);
        rt.wake_on(pp);
        out.push_str(&format!("{},{},{},{},{} ",
            rt.slot(t0, conc::TH_STATUS).as_fixnum(),
            rt.slot(t0, conc::TH_TOKEN).as_fixnum(),
            rt.slot(sc, 5).as_fixnum(),
            rt.slot(t1, conc::TH_STATUS).as_fixnum(),
            (!rt.waiter_at(1).is_nil()) as u32));
        // 15. A PORT NOBODY WAITS ON. Nothing moves, and nothing is freed.
        let rr = rt.obj(vec![fx(1)], true);
        let before = rt.slot(sc, 5).as_fixnum();
        rt.wake_on(rr);
        out.push_str(&format!("{}{}", rt.slot(t1, conc::TH_STATUS).as_fixnum(),
                              (rt.slot(sc, 5).as_fixnum() == before) as u32));
    }
    out.push(' ');
    // 16. NEW-WAITER. A fresh table grows; a freed slot is REUSED, and the
    //     token that comes back says which happened.
    {
        let pp = rt.obj(vec![fx(1)], true);
        let t0 = rt.obj(vec![fx(conc::ST_RUNNABLE), NIL, NIL, NIL, NIL, NIL, fx(-1)], false);
        let ts = rt.obj(vec![fx(1), t0], false);
        let ws0 = rt.obj(vec![fx(0)], false);
        let sc = rt.obj(vec![ts, fx(0), evs, fx(0), ws0, fx(-1)], false);
        rt.sched_id = Some(sc.0 as usize);
        // Two fresh slots: tokens 1 and 2, generation 0 on both.
        let a = rt.new_waiter(7, pp);
        let b = rt.new_waiter(7, pp);
        out.push_str(&format!("{a},{b},"));
        // FREE THE FIRST, then ask again: the slot comes BACK, and its
        // generation has moved on -- so the token is 65537, not 1.
        rt.free_waiter(a);
        let c = rt.new_waiter(7, pp);
        let scv = rt.sched();
        let wsv = rt.slot(scv, conc::SC_WAITERS);
        let n = rt.vec_count(wsv);
        out.push_str(&format!("{c},{n}"));
    }
    out.push(' ');
    // 17. PARK-ON-PORT. The waiter is registered, the token lands on the
    //     THREAD, and the park records what is being waited for.
    {
        let pp = rt.obj(vec![fx(1)], true);
        let t0 = rt.obj(vec![fx(conc::ST_RUNNABLE), NIL, NIL, NIL, NIL, NIL, fx(-1)], false);
        let pts = rt.obj(vec![fx(1), t0], false);
        let pws = rt.obj(vec![fx(0)], false);
        let psc = rt.obj(vec![pts, fx(0), evs, fx(0), pws, fx(-1)], false);
        rt.sched_id = Some(psc.0 as usize);
        rt.park_on = NIL;
        rt.thrown = NIL;
        let r = rt.park_on_port(7, pp);
        let w = rt.waiter_at(1);
        out.push_str(&format!("{},{},{},{},{}",
            rt.slot(t0, conc::TH_TOKEN).as_fixnum(),
            (rt.park_on == pp) as u32,
            (rt.thrown == value::PARK) as u32,
            (r == NIL) as u32,
            (!w.is_nil() && rt.slot(w, conc::W_PORT) == pp) as u32));
        // AND THE TWO HALVES MEET: the park this made is wakeable by the wake
        // path, which is the only reason they are a pair.
        rt.set(t0, conc::TH_STATUS, fx(conc::ST_PARKED));
        rt.wake_on(pp);
        out.push_str(&format!(",{},{}",
            rt.slot(t0, conc::TH_STATUS).as_fixnum(),
            rt.slot(t0, conc::TH_TOKEN).as_fixnum()));
    }
    out.push(' ');
    // 18. THE GATE, and the ORDER it is asked in. Three cases, and only the
    //     first separates a right answer from the wrong one.
    {
        // (a) GATE ESCAPED, AND A THREAD PARKED ON A BRIDGE. `needs-host`
        //     would say 2 -- and would be lying, because the budget is still
        //     blown and nothing can run whatever the host sends. Asking the
        //     gate FIRST is the whole fix; asked second, this answers 2 and
        //     the host pumps for ever. No other case here separates them.
        let t_failed = rt.obj(vec![fx(conc::ST_FAILED), NIL, NIL, NIL, NIL, NIL,
                                   fx(-1), fx(555)], false);
        let ts_g = rt.obj(vec![fx(2), t_failed, t_bridge], false);
        let sg = rt.obj(vec![ts_g, fx(0), evs, fx(0), NIL, fx(-1)], false);
        rt.sched_id = Some(sg.0 as usize);
        rt.status = 9; rt.closed = false; rt.thrown = NIL; rt.gas_trips = 2;
        let r = rt.sched_drive();
        out.push_str(&format!("{}{}{}{} ", rt.status, rt.closed as u32,
                              (rt.thrown == Value(555)) as u32,
                              (r == NIL) as u32));
        // (b) THE ANSWER COMES FROM THE CURRENT THREAD, not from thread 0.
        //     A DONE thread hands its result back, and `999` is what
        //     `settled-answer` would have said -- so this field is what tells
        //     the two apart.
        let t_ok = rt.obj(vec![fx(conc::ST_DONE), NIL, NIL, NIL, NIL, NIL,
                               fx(-1), fx(777)], false);
        let ts_h = rt.obj(vec![fx(2), t_bridge, t_ok], false);
        let sh = rt.obj(vec![ts_h, fx(1), evs, fx(0), NIL, fx(-1)], false);
        rt.sched_id = Some(sh.0 as usize);
        rt.status = 9; rt.closed = false; rt.thrown = NIL; rt.gas_trips = 2;
        let r2 = rt.sched_drive();
        out.push_str(&format!("{}{}{} ", rt.status, rt.closed as u32,
                              if r2 == Value(777) { 1 } else { 0 }));
        // (c) THE CONTROL. Same shape, gate NOT escaped: the old answer must
        //     come back untouched, or the check fires when it should not.
        rt.sched_id = Some(sg.0 as usize);
        rt.status = 9; rt.closed = false; rt.thrown = NIL; rt.gas_trips = 1;
        rt.sched_drive();
        out.push_str(&format!("{}{}", rt.status, rt.closed as u32));
    }
    out.push(' ');
    // 19. ABANDONING THE CURRENT THREAD, and THE WAITER IS THE POINT.
    //
    //     Marking a thread DONE is the obvious half and the one that passes
    //     either way. The last field is the one that does not: it WAKES the
    //     port afterwards, and a waiter still naming this thread would put it
    //     straight back to RUNNABLE -- which is the failure exactly as it was
    //     observed, DONE at the end of one drive and RUNNABLE at the start of
    //     the next.
    {
        let ap = rt.obj(vec![fx(1)], true);
        // NINE SLOTS, so the toy `TH_FRAMES` at 8 exists to be cleared.
        let at = rt.obj(vec![fx(conc::ST_RUNNABLE), NIL, NIL, NIL, NIL, NIL,
                             fx(-1), NIL, NIL], false);
        let ats = rt.obj(vec![fx(1), at], false);
        let aws = rt.obj(vec![fx(0)], false);
        let asc = rt.obj(vec![ats, fx(0), evs, fx(0), aws, fx(-1)], false);
        rt.sched_id = Some(asc.0 as usize);
        rt.park_on = NIL;
        rt.thrown = NIL;
        rt.park_on_port(1, ap);
        // SOMETHING TO LOSE. Both saved halves start non-nil, or "cleared"
        // and "never set" are the same observation.
        rt.set(at, conc::TH_STACK, Value(42));
        rt.set(at, conc::TH_FRAMES, Value(43));
        rt.abandon_current_thread();
        out.push_str(&format!("{},{},{},{},{}",
            rt.slot(at, conc::TH_STATUS).as_fixnum(),
            rt.slot(at, conc::TH_TOKEN).as_fixnum(),
            rt.slot(at, conc::TH_STACK).is_nil() as u32,
            rt.slot(at, conc::TH_FRAMES).is_nil() as u32,
            rt.outstanding_waiters()));
        rt.wake_on(ap);
        out.push_str(&format!(",{}", rt.slot(at, conc::TH_STATUS).as_fixnum()));
        // AND A NIL SCHEDULER IS NOT AN ERROR. Reaching the next line is the
        // assertion; a runtime that indexed into nil would not.
        rt.sched_id = None;
        rt.abandon_current_thread();
        out.push_str(",1");
    }
    println!("{out}");
}
--java-head
    static final long NIL = 0xFFFF000000000000L;
    static final long NOT_FOUND = 0xFFFF000000000002L;
    static final class Conc {
        static final int SC_THREADS = 0, SC_CURRENT = 1, SC_EVENTS = 2, SC_EHEAD = 3;
        static final int TH_STATUS = 0, TH_PARK_ON = 1, PT_KIND = 0;
        static final long ST_NEW = 0, ST_RUNNABLE = 1, ST_PARKED = 2,
                          ST_DONE = 3, ST_FAILED = 4;
        static boolean crossesAHeap(long kind) { return kind == 1; }
        // WHAT `runOne` CALLS -- see the note in the Rust head. Each records a
        // LETTER, and the trace is what the expected answer asserts.
        static final int TH_BINDINGS = 2, TH_ENTRY = 3, TH_STACK = 4, TH_FAIL = 5;
        // TH_FRAMES is a TOY 8, free beside the others.
        static final int TH_FRAMES = 8;
        static final int TH_TOKEN = 6;
        // A TOY INDEX, matching the other two harnesses rather than `Conc`.
        static final int TH_RESULT = 7;
        static final int W_KIND = 4, W_LEN = 5;
        static long currentThread(Rt rt) {
            long s = sched(rt);
            if (s == NIL) return NIL;
            return vecNth(rt, rt.slot(s, SC_THREADS), (int) rt.slot(s, SC_CURRENT), NIL);
        }
        // ALLOCATION, enough for `newWaiter`.
        static long newObj(Rt rt, int ty, int len) {
            long[] z = new long[len];
            java.util.Arrays.fill(z, NIL);
            return rt.obj(z, false);
        }
        static long runEntry(Rt rt, long f) { rt.trace.append('E'); return 7; }
        static void restoreState(Rt rt, long th) { rt.trace.append('T'); }
        static void settle(Rt rt, long v) { rt.trace.append('L'); }
        static void installBindings(Rt rt, long b) { rt.trace.append('B'); }
        static void beginSlice(Rt rt) { rt.trace.append('S'); }
        static void resetExecState(Rt rt) { rt.trace.append('R'); }
        // THE WAITER TABLE, at toy indices: the three harnesses agree with
        // each other, which is what the expected answer is derived against.
        static final int SC_WAITERS = 4, SC_WFREE = 5;
        static final int W_GEN = 0, W_THREAD = 1, W_PORT = 2, W_NEXT = 3;
        // WHAT `drive` CALLS. `runOne` marks the thread DONE, which is what
        // makes the loop terminate with no interpreter under it.
        static void bootSystemThreadOnce(Rt rt) {}
        static void reapPorts(Rt rt) {}
        static void closeAllBridges(Rt rt) { rt.closed = true; }
        static void runOne(Rt rt, int i) {
            long ts = rt.objs.get(rt.schedId).get(0);
            long th = rt.objs.get((int) ts).get(i + 1);
            rt.objs.get((int) th).set(0, ST_DONE);
        }
        static long settledAnswer(Rt rt) { return 999; }
        static void reportDeadlock(Rt rt) { rt.deadlocked = true; }
        static long sched(Rt rt) { return rt.schedId < 0 ? NIL : rt.schedId; }
        static boolean isPort(Rt rt, long v) {
            return v != NIL && v >= 0 && v < rt.ports.size() && rt.ports.get((int) v);
        }
    }
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isNil(long v) { return v == Probe.NIL; }
        static final long NOT_FOUND = Probe.NOT_FOUND;
        static final long PARK = 0xFFFF000000000004L;
        static long asFixnum(long v) { return v; }
        static long fixnum(long n) { return n; }
        // The generated code inserts `asHeap` at every slot write. Here a
        // value IS its object id, so it is the identity.
        static long asHeap(long v) { return v; }
    }
    // BARE, not on a `Vec` class: `vecread` exports them as free functions and
    // the generated code static-imports them.
    static int vecCount(Rt rt, long v) {
        if (v == NIL) return 0;
        return (int) (long) rt.objs.get((int) v).get(0);
    }
    static final int TY_NODE = 10;
    static long vecConj(Rt rt, long v, long x) {
        int n = vecCount(rt, v);
        long[] items = new long[n + 2];
        items[0] = n + 1;
        for (int k = 0; k < n; k++) items[k + 1] = rt.objs.get((int) v).get(k + 1);
        items[n + 1] = x;
        return rt.obj(items, false);
    }
    static long vecNth(Rt rt, long v, int i, long d) {
        int n = vecCount(rt, v);
        return i >= n ? d : rt.objs.get((int) v).get(i + 1);
    }
    static final class Rt {
        java.util.ArrayList<java.util.ArrayList<Long>> objs = new java.util.ArrayList<>();
        java.util.ArrayList<Boolean> ports = new java.util.ArrayList<>();
        int schedId = -1;
        int status = 0;
        boolean closed = false, deadlocked = false;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        StringBuilder trace = new StringBuilder();
        long parkOn = NIL;
        long thrown = NIL;
        boolean catches = true;
        // HOW MANY TIMES THE BUDGET BLEW; `> 1` is the gate having escaped.
        int gasTrips = 0;
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
        long run(int n) { trace.append('V'); return 7; }
        boolean unwind() { trace.append('U'); return catches; }
        long slot(long v, int i) { return objs.get((int) v).get(i); }
        void setSlot(long v, int i, long x) { objs.get((int) v).set(i, x); }
        long obj(long[] slots, boolean isPort) {
            java.util.ArrayList<Long> s = new java.util.ArrayList<>();
            for (long x : slots) s.add(x);
            objs.add(s); ports.add(isPort);
            return objs.size() - 1;
        }
    }
