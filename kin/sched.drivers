        schedDrive(rt);
        out.append(rt.status).append(rt.closed ? 1 : 0);
        // 12. THE WAITER TABLE -- see the note in the Rust driver.
        long w0 = rt.obj(new long[]{0, tRun, NIL, -1}, false);
        long w1 = rt.obj(new long[]{3, NIL, NIL, -1}, false);
        long ws = rt.obj(new long[]{2, w0, w1}, false);
        long sw = rt.obj(new long[]{tsMix, 0, evs, 0, ws, -1}, false);
        rt.schedId = (int) sw;
        out.append(" ");
        out.append(Val.isNil(waiterAt(rt, 0)) ? 0 : 1).append(" ");
        out.append(Val.isNil(waiterAt(rt, -1)) ? 0 : 1).append(" ");
        out.append(Val.isNil(waiterAt(rt, 1)) ? 0 : 1).append(" ");
        out.append(Val.isNil(waiterAt(rt, 65537)) ? 0 : 1).append(" ");
        out.append(Val.isNil(waiterAt(rt, 196610)) ? 0 : 1).append(" ");
        out.append(Val.isNil(waiterAt(rt, 9)) ? 0 : 1).append(" ");
        out.append(outstandingWaiters(rt)).append(" ");
        int freed = Val.isNil(freeWaiter(rt, 1)) ? 0 : 1;
        int stale = Val.isNil(waiterAt(rt, 1)) ? 0 : 1;
        int left = outstandingWaiters(rt);
        long head = Val.asFixnum(rt.slot(sw, Conc.SC_WFREE));
        out.append(freed).append(stale).append(left).append(head).append(" ");
        out.append(Val.isNil(freeWaiter(rt, 1)) ? 0 : 1).append(" ");
        rt.schedId = -1;
        out.append(outstandingWaiters(rt));
        // 13. RUN-ONE: each field is the PATH TAKEN. See the Rust driver.
        long stack = rt.obj(new long[]{0}, false);
        out.append(" ");
        long[][] cases = {
            { Conc.ST_NEW,      NIL,   NIL, 1 },
            { Conc.ST_RUNNABLE, stack, NIL, 1 },
            { Conc.ST_RUNNABLE, stack, 9,   1 },
            { Conc.ST_RUNNABLE, stack, 9,   0 },
        };
        for (long[] c : cases) {
            long rth = rt.obj(new long[]{ c[0], NIL, NIL, NIL, c[1], c[2] }, false);
            long rts = rt.obj(new long[]{ 1, rth }, false);
            long sc = rt.obj(new long[]{ rts, 0, evs, 0, NIL, -1 }, false);
            rt.schedId = (int) sc;
            rt.trace = new StringBuilder();
            rt.catches = c[3] == 1;
            schedRunOne(rt, 0);
            out.append(rt.trace.length() == 0 ? "-" : rt.trace.toString()).append(" ");
        }
        long tsNone = rt.obj(new long[]{ 1, NIL }, false);
        long scNone = rt.obj(new long[]{ tsNone, 0, evs, 0, NIL, -1 }, false);
        rt.schedId = (int) scNone;
        rt.trace = new StringBuilder();
        schedRunOne(rt, 0);
        out.append(rt.trace.length() == 0 ? "-" : "?");
        out.append(' ');
        {
            long pp = rt.obj(new long[]{1}, true);
            long qq = rt.obj(new long[]{1}, true);
            long t0 = rt.obj(new long[]{ Conc.ST_PARKED, pp, NIL, NIL, NIL, NIL, 1 }, false);
            long t1 = rt.obj(new long[]{ Conc.ST_PARKED, qq, NIL, NIL, NIL, NIL, 2 }, false);
            long ww0 = rt.obj(new long[]{ 0, t0, pp, -1 }, false);
            long ww1 = rt.obj(new long[]{ 0, t1, qq, -1 }, false);
            long wws = rt.obj(new long[]{ 2, ww0, ww1 }, false);
            long wts = rt.obj(new long[]{ 2, t0, t1 }, false);
            long sc = rt.obj(new long[]{ wts, 0, evs, 0, wws, -1 }, false);
            rt.schedId = (int) sc;
            wakeOn(rt, pp);
            out.append(rt.slot(t0, Conc.TH_STATUS)).append(',')
               .append(rt.slot(t0, Conc.TH_TOKEN)).append(',')
               .append(rt.slot(sc, 5)).append(',')
               .append(rt.slot(t1, Conc.TH_STATUS)).append(',')
               .append(Val.isNil(waiterAt(rt, 1)) ? 0 : 1).append(' ');
            long rr = rt.obj(new long[]{1}, true);
            long before = rt.slot(sc, 5);
            wakeOn(rt, rr);
            out.append(rt.slot(t1, Conc.TH_STATUS))
               .append(rt.slot(sc, 5) == before ? 1 : 0);
