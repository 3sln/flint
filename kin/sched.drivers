    static void Main() {
        var rt = new Rt();
        long bridge = rt.MakeObj(new long[]{1}, true);
        long channel = rt.MakeObj(new long[]{0}, true);
        long tRun = rt.MakeObj(new long[]{Conc.ST_RUNNABLE, NIL}, false);
        long tBridge = rt.MakeObj(new long[]{Conc.ST_PARKED, bridge}, false);
        long tChan = rt.MakeObj(new long[]{Conc.ST_PARKED, channel}, false);
        long tNew = rt.MakeObj(new long[]{Conc.ST_NEW, NIL}, false);
        var outp = new System.Text.StringBuilder();

        long ts = rt.MakeObj(new long[]{2, tBridge, tChan}, false);
        long evs = rt.MakeObj(new long[]{0}, false);
        long s = rt.MakeObj(new long[]{ts, 0, evs, 0, NIL, -1}, false);
        rt.SchedId = (int) s;
        outp.Append(SchedPick(rt)).Append(" ");
        outp.Append(SchedNeedsHost(rt) ? 1 : 0).Append(" ");

        long ts2 = rt.MakeObj(new long[]{3, tBridge, tRun, tNew}, false);
        long s2 = rt.MakeObj(new long[]{ts2, 0, evs, 0, NIL, -1}, false);
