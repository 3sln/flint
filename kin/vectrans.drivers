--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 900000], gc: Gc { sp: vec![0u8; 900000] }, lens: vec![0; 900000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();

    // Two tokens are never equal, which is the whole of what a token is.
    let e1 = rt.new_edit_token();
    let e2 = rt.new_edit_token();
    o.push_str(&format!("tok={} ", (e1 != e2) as u32));

    // A 33-element vector, then a transient over it.
    let v = rt.build(33, BITS);
    let t = rt.vec_transient(v);
    o.push_str(&format!("istv={} isvec={} ", rt.is_transient_vector(t) as u32,
                        rt.is_transient_vector(v) as u32));
    o.push_str(&format!("cnt={} sh={} toff={} alive={} ",
        rt.tvec_count(t), rt.tvec_shift(t), rt.tvec_tail_off(t), rt.tvec_alive(t) as u32));

    // The TAIL is widened to a full 32 up front, which is the one copy
    // `transient` makes -- the source vector's tail held one element.
    o.push_str(&format!("tailwide={} srctail={} ",
        rt.node_len(rt.slot(t, T_TAIL)), rt.node_len(rt.slot(v, V_TAIL))));

    // The ROOT is SHARED with the source: nothing is copied until a write
    // reaches a node this transient does not own.
    o.push_str(&format!("rootshared={} ", (rt.slot(t, T_ROOT) == rt.slot(v, V_ROOT)) as u32));

    // `ensure_editable`: a node this transient owns comes back UNCHANGED; a
    // node it does not is copied once, and the copy is owned.
    let edit = rt.slot(t, T_EDIT);
    let mine = rt.new_node(WIDTH, edit);
    let theirs = rt.new_node(WIDTH, NIL);
    let same = rt.ensure_editable(mine, edit);
    let copy = rt.ensure_editable(theirs, edit);
    o.push_str(&format!("own={} copied={} nowowned={} ",
        (same == mine) as u32, (copy != theirs) as u32,
        (rt.node_edit(copy) == edit) as u32));

    // `t_array_for` reaches the trie and the tail on the same rule as a vector.
    let root = rt.slot(v, V_ROOT);
    let leaf0 = rt.node_get(root, 0);
    o.push_str(&format!("a0={} a32={} ",
        (rt.t_array_for(t, 0) == leaf0) as u32,
        (rt.t_array_for(t, 32) == rt.slot(t, T_TAIL)) as u32));

    // `tvec_nth` with a default: in the trie, in the tail, and past the end.
    o.push_str(&format!("t0={} t32={} tover={} ",
        rt.tvec_nth(t, 0, NIL).0, rt.tvec_nth(t, 32, NIL).0,
        rt.tvec_nth(t, 33, Value(0xDEAD)).0));

    // A dead transient: the token cleared is what `persistent!` does.
    rt.set_slot(t.as_heap(), T_EDIT, NIL);
    o.push_str(&format!("dead={} ", rt.tvec_alive(t) as u32));
    println!("{}", o);
}
