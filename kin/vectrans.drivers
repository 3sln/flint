type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_NODE: u8 = 10; const TY_VEC: u8 = 6;
const BITS: u32 = 5; const WIDTH: u32 = 32; const MASK: u32 = 31;
const V_CNT: u32 = 0; const V_SHIFT: u32 = 1; const V_ROOT: u32 = 2; const V_TAIL: u32 = 3;
const T_CNT: u32 = 0; const T_SHIFT: u32 = 1; const T_ROOT: u32 = 2; const T_TAIL: u32 = 3;
const T_EDIT: u32 = 4;
const TY_TVEC: u8 = 25; const TY_VOLATILE: u8 = 34;
const V_META: u32 = 4; const V_HASH: u32 = 5;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
