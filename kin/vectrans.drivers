    static int VecShift(Rt rt, long v) { return (int) Val.AsFixnum(rt.Slot(v, V_SHIFT)); }
    static int TailOff(Rt rt, long v) {
        int c = Vec.Count(rt, v);
        return c < WIDTH ? 0 : ((int)((uint)(c - 1) >> BITS)) << BITS;
    }
    // `flint.rt.vecwrite`, STUBBED -- see the Rust head.
    static long NewVec(Rt rt, int cnt, int shift, long root, long tail, long meta) {
        long a = rt.Alloc(TY_VEC, 6);
        if (a == 0) return NIL;
        rt.SetSlot(a, V_CNT, cnt); rt.SetSlot(a, V_SHIFT, shift);
        rt.SetSlot(a, V_ROOT, root); rt.SetSlot(a, V_TAIL, tail);
        rt.SetSlot(a, V_META, meta); rt.SetSlot(a, V_HASH, NIL);
        return Val.Heap(a);
    }
    static long EmptyVec(Rt rt) {
        return NewVec(rt, 0, BITS, NewNode(rt, WIDTH, NIL), NewNode(rt, 0, NIL), NIL);
    }
    // `VecConj` is STUBBED as a MARKER, not reimplemented -- see the Rust head.
    static long VecConj(Rt rt, long v, long x) { return 0xC0FFEE; }
    static long Build(Rt rt, int n, int shift) {
        int toff = n < WIDTH ? 0 : ((int)((uint)(n - 1) >> BITS)) << BITS;
        long root = NewNode(rt, WIDTH, NIL);
        int ri = rt.Push(root);
        for (int i = 0; i < toff; i += WIDTH) {
            long leaf = NewNode(rt, WIDTH, NIL);
            int li = rt.Push(leaf);
            for (int k = 0; k < WIDTH; k++) NodeSet(rt, rt.R(li), k, 0x1000 + i + k);
            if (shift == BITS) {
                NodeSet(rt, rt.R(ri), (int)((uint) i >> BITS), rt.R(li));
            } else {
                int outer = ((int)((uint) i >> 10)) & MASK;
                long mid = NodeGet(rt, rt.R(ri), outer);
                if (Val.IsNil(mid)) { mid = NewNode(rt, WIDTH, NIL); NodeSet(rt, rt.R(ri), outer, mid); }
                NodeSet(rt, mid, ((int)((uint) i >> BITS)) & MASK, rt.R(li));
            }
            rt.PopTo(li);
        }
        int tailn = n - toff;
        long tail = NewNode(rt, tailn, NIL);
        int ti = rt.Push(tail);
        for (int k = 0; k < tailn; k++) NodeSet(rt, rt.R(ti), k, 0x1000 + toff + k);
        long outv = NewVec(rt, n, shift, rt.R(ri), rt.R(ti), NIL);
        rt.PopTo(ri);
        return outv;
    }
    static long Get(Rt rt, long v, int i) { return NodeGet(rt, ArrayFor(rt, v, i), i & MASK); }
    static long ArrayFor(Rt rt, long v, int i) {
        if (i >= TailOff(rt, v)) return rt.Slot(v, V_TAIL);
        long node = rt.Slot(v, V_ROOT);
        int level = VecShift(rt, v);
        while (level > 0) { node = NodeGet(rt, node, ((int)((uint) i >> level)) & MASK); level -= BITS; }
        return node;
    }
    static long MkVec(Rt rt, int cnt, int shift, long root, long tail) {
        long a = rt.Alloc(6, 6);
        rt.SetSlot(a, V_CNT, cnt);
        rt.SetSlot(a, V_SHIFT, shift);
        rt.SetSlot(a, V_ROOT, root);
        rt.SetSlot(a, V_TAIL, tail);
        return Val.Heap(a);
    }
--csharp
    public static void Main(string[] args) {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long e1 = NewEditToken(rt), e2 = NewEditToken(rt);
        o.Append("tok=").Append(e1 != e2 ? 1 : 0).Append(' ');
        long v = Build(rt, 33, BITS);
        long t = VecTransient(rt, v);
        o.Append("istv=").Append(IsTransientVector(rt, t) ? 1 : 0)
         .Append(" isvec=").Append(IsTransientVector(rt, v) ? 1 : 0).Append(' ');
        o.Append("cnt=").Append(TvecCount(rt, t)).Append(" sh=").Append(TvecShift(rt, t))
         .Append(" toff=").Append(TvecTailOff(rt, t))
         .Append(" alive=").Append(TvecAlive(rt, t) ? 1 : 0).Append(' ');
        o.Append("tailwide=").Append(NodeLen(rt, rt.Slot(t, T_TAIL)))
         .Append(" srctail=").Append(NodeLen(rt, rt.Slot(v, V_TAIL))).Append(' ');
        o.Append("rootshared=").Append(rt.Slot(t, T_ROOT) == rt.Slot(v, V_ROOT) ? 1 : 0).Append(' ');
        long edit = rt.Slot(t, T_EDIT);
        long mine = NewNode(rt, WIDTH, edit);
        long theirs = NewNode(rt, WIDTH, NIL);
        long same = EnsureEditable(rt, mine, edit);
        long copy = EnsureEditable(rt, theirs, edit);
        o.Append("own=").Append(same == mine ? 1 : 0)
         .Append(" copied=").Append(copy != theirs ? 1 : 0)
         .Append(" nowowned=").Append(NodeEdit(rt, copy) == edit ? 1 : 0).Append(' ');
        long root = rt.Slot(v, V_ROOT);
        long leaf0 = NodeGet(rt, root, 0);
        o.Append("a0=").Append(TArrayFor(rt, t, 0) == leaf0 ? 1 : 0)
         .Append(" a32=").Append(TArrayFor(rt, t, 32) == rt.Slot(t, T_TAIL) ? 1 : 0).Append(' ');
        o.Append("t0=").Append(TvecNth(rt, t, 0, NIL))
         .Append(" t32=").Append(TvecNth(rt, t, 32, NIL))
         .Append(" tover=").Append(TvecNth(rt, t, 33, 0xDEAD)).Append(' ');
        rt.SetSlot(Val.AsHeap(t), T_EDIT, NIL);
        o.Append("dead=").Append(TvecAlive(rt, t) ? 1 : 0).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
