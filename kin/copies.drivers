    const long NIL = 0xFFFFL;
    static class Val { internal const long Nil = 0xFFFFL; internal static bool IsNil(long v) { return v == Nil; } }
    const int BN_EDIT = 18;
    static int IndexOf(int bitmap, int bit) {
        return System.Numerics.BitOperations.PopCount((uint)(bitmap & (bit - 1)));
    }
    internal sealed class Rt {
        internal long[] h = new long[200];
        internal long bump = 1;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    static long BnNew(Rt rt, int dm, int nm, long e) {
        long a = rt.bump; rt.bump += 20;
        rt.h[(int) a] = dm; rt.h[(int) a + 1] = nm; return a;
    }
    static int BnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int BnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long BnKey(Rt rt, long n, int i) { return rt.h[(int) n + 2 + 2 * i]; }
    static long BnVal(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    static void BnSetKey(Rt rt, long n, int i, long v) { rt.h[(int) n + 2 + 2 * i] = v; }
    static void BnSetVal(Rt rt, long n, int i, long v) { rt.h[(int) n + 3 + 2 * i] = v; }
    static long BnNode(Rt rt, long n, int j) { return rt.h[(int) n + 19 - j]; }
    static void BnSetNode(Rt rt, long n, int j, long v) { rt.h[(int) n + 19 - j] = v; }
