    static void Main() {
        var rt = new Rt();
        long n = BnNew(rt, 0b1001, 0b0100, NIL);
        BnSetKey(rt, n, 0, 10); BnSetVal(rt, n, 0, 11);
        BnSetKey(rt, n, 1, 80); BnSetVal(rt, n, 1, 81);
        BnSetNode(rt, n, 0, 44);
        long m = BnCopyInsertEntry(rt, n, 0b0010, 20, 21, NIL);
        var o = new StringBuilder();
        o.Append("dm=").Append(BnDatamap(rt, m)).Append(" nm=").Append(BnNodemap(rt, m)).Append(' ');
        for (int i = 0; i < 3; i++) o.Append(BnKey(rt, m, i)).Append(':').Append(BnVal(rt, m, i)).Append(' ');
        o.Append("sub=").Append(BnNode(rt, m, 0)).Append(" | ");
        long d = BnCopyRemoveEntry(rt, m, 0b0010, NIL);
        o.Append("dm=").Append(BnDatamap(rt, d)).Append(' ');
        for (int i = 0; i < 2; i++) o.Append(BnKey(rt, d, i)).Append(':').Append(BnVal(rt, d, i)).Append(' ');
        long s2 = BnCopySetValue(rt, d, 1, 99, NIL);
        o.Append("| copy ").Append(BnKey(rt, s2, 1)).Append(':').Append(BnVal(rt, s2, 1)).Append(' ');
        long tok = 7;
        long owned = BnNew(rt, 0b0001, 0, tok);
        rt.h[(int) owned + 18] = tok;
        BnSetKey(rt, owned, 0, 5); BnSetVal(rt, owned, 0, 6);
        long s3 = BnCopySetValue(rt, owned, 0, 66, tok);
        o.Append("| through ").Append(s3 == owned ? "true" : "false").Append(' ')
         .Append(BnKey(rt, s3, 0)).Append(':').Append(BnVal(rt, s3, 0))
         .Append(" roots=").Append(rt.roots.Count);
        Console.WriteLine(o.ToString());
    }
