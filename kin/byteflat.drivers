    internal static string Show(Rt rt, long v) {
        var s = new System.Text.StringBuilder();
        int n = Olen(rt, v);
        for (int i = 0; i < n; i++) {
            if (i > 0) s.Append('.');
            s.Append(rt.gc.sp.ReadU8(v + Obj.Hdr + i));
