    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long l1 = leaf(rt, new int[]{1,2,3});
        long l2 = leaf(rt, new int[]{4,5});
        long l3 = leaf(rt, new int[]{6});
        long inner = node(rt, new long[]{l2, l3});
        long tree = node(rt, new long[]{l1, inner});
        o.append("leaf=").append(show(rt, bToFlat(rt, l1)))
         .append(" inner=").append(show(rt, bToFlat(rt, inner)))
         .append(" tree=").append(show(rt, bToFlat(rt, tree))).append(' ');
        long other = Val.heap(rt.alloc(TY_VEC, 2));
        o.append("other=").append(olen(rt, bToFlat(rt, other))).append(' ');
        long lie = leaf(rt, new int[]{9,9,9,9,9,9});
        rt.setSlot(tree, Bytes.BB_FLAT, lie);
        o.append("cached=").append(show(rt, bToFlat(rt, tree))).append(' ');
        int a = rt.sinkOpen(), b = rt.sinkOpen();
        bAppend(rt, l1, a); bAppend(rt, l2, b);
        o.append("nested=").append(rt.sinkLen(a)).append(',').append(rt.sinkLen(b)).append(' ');
        rt.sinkClose(a);
        int c = rt.sinkOpen();
        o.append("reused=").append(c == a ? 1 : 0).append(" empty=").append(rt.sinkLen(c)).append(' ');
        System.out.println(o.toString());
    }
    static String show(Rt rt, long v) {
        StringBuilder s = new StringBuilder();
        int n = olen(rt, v);
        for (int i = 0; i < n; i++) {
            if (i > 0) s.append('.');
            s.append(rt.gc.sp.readU8(v + Obj.HDR + i));
        }
        return s.toString();
    }
--csharp-head
    internal static class Obj {
        internal const long Hdr = 8;
        internal const int TyBytes = 44, TyBrope = 45, TyVec = 9;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil; }
        internal static long AsHeap(long v) { return v; }
        internal static long AsFixnum(long v) { return v; }
        internal static long Fixnum(long n) { return n; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
    }
    internal sealed class Space {
        internal byte[] m = new byte[40000];
        internal int ReadU8(long a) { return m[(int) a]; }
    }
    internal sealed class Rt {
        internal System.Collections.Generic.List<System.IO.MemoryStream> sinks =
            new System.Collections.Generic.List<System.IO.MemoryStream>();
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal void Set(long n, int i, long v) { h[(int) n + i] = v; }
        internal int SinkOpen() { sinks.Add(new System.IO.MemoryStream()); return sinks.Count - 1; }
        internal void SinkClose(int s) { while (sinks.Count > s) sinks.RemoveAt(sinks.Count - 1); }
        internal int SinkLen(int s) { return (int) sinks[s].Length; }
        internal byte[] SinkArr(int s) { return sinks[s].ToArray(); }
        internal long SinkBytes(int s) {
            byte[] a = SinkArr(s);
            int[] bs = new int[a.Length];
            for (int i = 0; i < a.Length; i++) bs[i] = a[i];
            return Leaf(this, bs);
        }
        internal void SinkPutRun(int s, long addr, int len) {
            for (int i = 0; i < len; i++) sinks[s].WriteByte(gc.sp.m[(int) (addr + i)]);
        }
        internal long[] h = new long[40000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[40000];
        internal long bump = 100;
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    internal static int Olen(Rt rt, long v) { return rt.lens[(int) v]; }
    internal static int BCount(Rt rt, long v) {
        if (!Val.IsHeap(v)) return 0;
        int t = Obj.Ty(rt.gc.sp, v);
        if (t == Obj.TyBytes) return Olen(rt, v);
        if (t == Obj.TyBrope) return (int) rt.Slot(v, global::Flint.Rt.Bytes.BB_BYTES);
        return 0;
    }
    internal static long Leaf(Rt rt, int[] bs) {
        long a = rt.Alloc(Obj.TyBytes, bs.Length);
        for (int i = 0; i < bs.Length; i++) rt.gc.sp.m[(int) (a + Obj.Hdr) + i] = (byte) bs[i];
        return Val.Heap(a);
    }
    internal static long Node(Rt rt, long[] kids) {
        int total = 0;
        foreach (long k in kids) total += BCount(rt, k);
        long a = rt.Alloc(Obj.TyBrope, global::Flint.Rt.Bytes.BB_KIDS + kids.Length);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_BYTES, total);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_FLAT, Val.Nil);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_HASH, Val.Nil);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_DEPTH, 1);
        for (int i = 0; i < kids.Length; i++) rt.SetSlot(a, global::Flint.Rt.Bytes.BB_KIDS + i, kids[i]);
        return Val.Heap(a);
    }
