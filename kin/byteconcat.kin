;; Joining two byte strings, and the two ways a join avoids growing the tree.
;;
;; THE TIERS, in the order `b-concat` tries them:
;;
;;   1. either side empty      -- the other side, unchanged
;;   2. both fit in one leaf   -- copy them together, no tree at all
;;   3. `b` is small           -- MERGE it into the rightmost leaf
;;   4. `b` fits somewhere     -- ABSORB it down the right spine
;;   5. neither                -- a new level, both sides promoted to it
;;
;; Tiers 3 and 4 are not optimisations, they are what stops the structure
;; degenerating. Without the merge, appending a byte at a time makes one heap
;; object per byte and rebuilds the spine each time -- measured at 6.8
;; allocations and 450 bytes of churn per append, with the live set growing
;; linearly until it outgrows the nursery and every minor collection promotes.
;; Without the descent, absorbing at the top builds a LEFT SPINE: the top fills
;; after `FANOUT` joins, wraps, fills again, and twenty thousand joins is depth
;; 1 250 instead of four.
;;
;; NIL MEANS DECLINED in tiers 3 and 4, and cannot be confused with an answer:
;; both answer a node, and a node is never nil.
(ns flint.rt.byteconcat
  (:require [flint.impl.rt :refer [defn return if let do comment doc
                                   == != < <= >= + - not nil? is-heap as-heap ty
                                   for as-idx local set olen slot
                                   mark push r pop-to quot
                                   Rt Value RootIx I32 Ty NIL
                                   TY_BYTES TY_BROPE BB_KIDS FLAT_MAX FANOUT]]
            [flint.rt.byteflat :refer [b-copy-concat]]
            [flint.rt.bytecore :refer [b-count b-depth]]
            [flint.rt.bytenode :refer [b-node b-wrap-to]]))

(doc "Merge `b` into `a`'s RIGHTMOST LEAF if the two fit in one leaf."
     ""
     "NIL when they do not, or when there is no leaf to merge with. The copy is"
     "bounded by `FLAT_MAX`, which is what makes doing it at all worth while.")
(defn ^:pub ^:method ^Value b-merge-right [^:mut ^Rt rt ^Value a ^Value b]
  (if (not (is-heap a))
    (return NIL))
  (let [^Ty t (ty rt (as-heap a))]
    (if (== t TY_BYTES)
      (do
        (if (<= (+ (olen rt a) (b-count rt b)) FLAT_MAX)
          (return (b-copy-concat rt a b)))
        (return NIL)))
    (if (!= t TY_BROPE)
      (return NIL))
    (let [^I32 n (- (olen rt a) BB_KIDS)
          ^RootIx base (mark rt)]
      (push rt a)
      (push rt b)
      (let [^Value last (slot rt (r rt base) (+ BB_KIDS (- n 1)))
            ^Value merged (b-merge-right rt last (r rt (+ base 1)))]
        (if (nil? rt merged)
          (do (pop-to rt base)
              (return NIL)))
        (push rt merged)
        (comment "The kids the new node keeps: `a`'s first n-1, then the"
                 "merged tail. They go on the shadow stack because that is"
                 "what `b-node` takes now.")
        (let [^RootIx kbase (mark rt)]
          (for [^I32 i 0 (- n 1)]
            (push rt (slot rt (r rt base) (+ BB_KIDS i))))
          (push rt (r rt (+ base 2)))
          (let [^Value out (b-node rt kbase n)]
            (pop-to rt base)
            (return out)))))))

(doc "Put `b` in the deepest node on `a`'s right spine that has room."
     ""
     "NIL if there is none. Depth is UNCHANGED when this succeeds, which is the"
     "whole point: a join that deepens the tree every time is the left spine"
     "this exists to avoid.")
(defn ^:pub ^:method ^Value b-absorb [^:mut ^Rt rt ^Value a ^Value b]
  (if (not (is-heap a))
    (return NIL))
  (if (!= (ty rt (as-heap a)) TY_BROPE)
    (return NIL))
  (let [^I32 n (- (olen rt a) BB_KIDS)
        ^I32 da (b-depth rt a)]
    (comment "A node's children are all the same depth, so anything as deep as"
             "this node cannot go inside it.")
    (if (>= (b-depth rt b) da)
      (return NIL))
    (let [^RootIx base (mark rt)]
      (push rt a)
      (push rt b)
      (comment "DEEPEST FIRST. Only if the last child cannot take it does this"
               "node take it, and only if neither can does the caller wrap.")
      (let [^Value last (slot rt (r rt base) (+ BB_KIDS (- n 1)))
            ^Value down (b-absorb rt last (r rt (+ base 1)))]
        (if (not (nil? rt down))
          (do
            (push rt down)
            (let [^RootIx kbase (mark rt)]
              (for [^I32 i 0 (- n 1)]
                (push rt (slot rt (r rt base) (+ BB_KIDS i))))
              (push rt (r rt (+ base 2)))
              (let [^Value out (b-node rt kbase n)]
                (pop-to rt base)
                (return out)))))
        (if (< n FANOUT)
          (do
            (comment "Promoted to this node's CHILD depth, so every child"
                     "stays the same depth and the next append can descend.")
            (let [^Value bb (b-wrap-to rt (r rt (+ base 1)) (- da 1))]
              (push rt bb)
              (let [^RootIx kbase (mark rt)]
                (for [^I32 i 0 n]
                  (push rt (slot rt (r rt base) (+ BB_KIDS i))))
                (push rt (r rt (+ base 2)))
                (let [^Value out (b-node rt kbase (+ n 1))]
                  (pop-to rt base)
                  (return out))))))
        (pop-to rt base)
        (return NIL)))))

(doc "`a` followed by `b`, as a byte string.")
(defn ^:pub ^:method ^Value b-concat [^:mut ^Rt rt ^Value a ^Value b]
  (if (== (b-count rt a) 0)
    (return b))
  (if (== (b-count rt b) 0)
    (return a))
  (comment "Below the threshold a tree costs more in metadata than the copy"
           "saves. This is the tier that must NOT be skipped -- and it is also"
           "the tier that makes incremental building quadratic, which is what"
           "the transient is for.")
  (if (<= (+ (b-count rt a) (b-count rt b)) FLAT_MAX)
    (return (b-copy-concat rt a b)))
  (if (<= (b-count rt b) (quot FLAT_MAX 2))
    (let [^Value merged (b-merge-right rt a b)]
      (if (not (nil? rt merged))
        (return merged))))
  (let [^Value absorbed (b-absorb rt a b)]
    (if (not (nil? rt absorbed))
      (return absorbed)))
  (comment "Neither side had room, so a NEW LEVEL. Both sides are promoted to"
           "the same depth first: `b-node` reads the depth off child zero, so"
           "pairing a deep node with a bare leaf makes the node claim a depth"
           "one child does not have, and later appends descend into the wrong"
           "place. That is the invariant the absorb above depends on.")
  (let [^RootIx base (mark rt)]
    (push rt a)
    (push rt b)
    (let [^I32 d (b-depth rt (r rt base))]
      (local ^:mut ^I32 dd)
      (set dd d)
      (if (< dd (b-depth rt (r rt (+ base 1))))
        (set dd (b-depth rt (r rt (+ base 1)))))
      (let [^Value pa (b-wrap-to rt (r rt base) dd)]
        (push rt pa)
        (let [^Value pb (b-wrap-to rt (r rt (+ base 1)) dd)]
          (push rt pb)
          (let [^Value out (b-node rt (+ base 2) 2)]
            (pop-to rt base)
            (return out)))))))
