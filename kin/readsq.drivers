    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long st0 = rt.hNewState();
        int sti = rt.push(st0);

        // 1. `(a ~b ~@c)`
        {
            long a = rt.hSym("", "a");
            long b = rt.hSym("", "b");
            long unq = litSymbol(rt, "clojure.core", "unquote");
            long ub = rt.obj(TY_SEQ, new long[]{unq, b});
            long c = rt.hSym("", "c");
            long unqs = litSymbol(rt, "clojure.core", "unquote-splicing");
            long uc = rt.obj(TY_SEQ, new long[]{unqs, c});
            long form = rt.obj(TY_SEQ, new long[]{a, ub, uc});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t1[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 2. A VECTOR `[~a 1]`
        {
            long a = rt.hSym("", "a");
            long unq = litSymbol(rt, "clojure.core", "unquote");
            long va = rt.obj(TY_SEQ, new long[]{unq, a});
            long one = Val.fixnum(1);
            long form = rt.obj(TY_VEC, new long[]{va, one});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t2[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 3. A SET `#{:x}`
        {
            long kx = rt.hKw("", "x");
            long form = rt.obj(TY_SET, new long[]{kx});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t3[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 4. A MAP `{:b 1 :a 2 :c 3}` -- entries given out of order.
        {
            long kb = rt.hKw("", "b"), ka = rt.hKw("", "a"), kc = rt.hKw("", "c");
            long form = rt.obj(TY_MAP, new long[]{kb, Val.fixnum(1), ka, Val.fixnum(2), kc, Val.fixnum(3)});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t4[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 5. A SPECIAL FORM `(if a b)`
        {
            long iff = rt.hSym("", "if"), a = rt.hSym("", "a"), b = rt.hSym("", "b");
            long form = rt.obj(TY_SEQ, new long[]{iff, a, b});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t5[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 6. A `.method` symbol, standalone: `.foo`
        {
            long dotfoo = rt.hSym("", ".foo");
            int fi = rt.push(dotfoo);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t6[").append(st).append("]=").append(rt.hShow(out)).append(' ');
            rt.popTo(base - 1);
        }

        // 7. `x#` TWICE in one form, `y#` between: `(x# y# x#)`.
        {
            long em0 = rt.emptyMapObj();
            rdPut(rt, sti, RDS_GENSYMS, em0);
            rdSetInt(rt, sti, RDS_GENSYM_N, 10);
            long x1 = rt.hSym("", "x#"), y1 = rt.hSym("", "y#"), x2 = rt.hSym("", "x#");
            long form = rt.obj(TY_SEQ, new long[]{x1, y1, x2});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t7[").append(st).append("]=").append(rt.hShow(out))
             .append(" ctr=").append(rdInt(rt, sti, RDS_GENSYM_N)).append(' ');
            rt.popTo(base - 1);
        }

        // 8. A NESTED SYNTAX-QUOTED MARKER: `(flint.reader/syntax-quoted zz)`.
        {
            long zz = rt.hSym("", "zz");
            long sq = litSymbol(rt, "flint.reader", "syntax-quoted");
            long form = rt.obj(TY_SEQ, new long[]{sq, zz});
            int fi = rt.push(form);
            int base = rt.mark();
            int st = sqForm(rt, sti, fi);
            long out = rt.r(rt.mark() - 1);
            o.append("t8[").append(st).append("]=").append(rt.hShow(out));
            rt.popTo(base - 1);
        }

        System.out.println(o.toString().trim());
    }
