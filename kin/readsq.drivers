namespace Flint.Rt {
    // `symbol-of` reaches here as `global::Flint.Rt.Str`, which needs a
    // genuine top-level namespace -- see `exinfo.drivers`/`readcore.drivers`.
    internal static class Str {
        internal static long SymbolOf(Probe.Rt rt, long ns, long nm) { return rt.InternSym(ns, nm); }
    }
}
