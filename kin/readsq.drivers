--csharp
    static void Main() {
        var rt = new Rt();
        var o = new System.Text.StringBuilder();
        long st0 = rt.HNewState();
        int sti = rt.Push(st0);

        // 1. `(a ~b ~@c)`
        {
            long a = rt.HSym("", "a");
            long b = rt.HSym("", "b");
            long unq = LitSymbol(rt, "clojure.core", "unquote");
            long ub = rt.MakeObj(TySeq, new long[]{unq, b});
            long c = rt.HSym("", "c");
            long unqs = LitSymbol(rt, "clojure.core", "unquote-splicing");
            long uc = rt.MakeObj(TySeq, new long[]{unqs, c});
            long form = rt.MakeObj(TySeq, new long[]{a, ub, uc});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t1[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 2. A VECTOR `[~a 1]`
        {
            long a = rt.HSym("", "a");
            long unq = LitSymbol(rt, "clojure.core", "unquote");
            long va = rt.MakeObj(TySeq, new long[]{unq, a});
            long one = Val.Fixnum(1);
            long form = rt.MakeObj(TyVec, new long[]{va, one});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t2[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 3. A SET `#{:x}`
        {
            long kx = rt.HKw("", "x");
            long form = rt.MakeObj(TySet, new long[]{kx});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t3[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 4. A MAP `{:b 1 :a 2 :c 3}` -- entries given out of order.
        {
            long kb = rt.HKw("", "b"), ka = rt.HKw("", "a"), kc = rt.HKw("", "c");
            long form = rt.MakeObj(TyMap, new long[]{kb, Val.Fixnum(1), ka, Val.Fixnum(2), kc, Val.Fixnum(3)});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t4[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 5. A SPECIAL FORM `(if a b)`
        {
            long iff = rt.HSym("", "if"), a = rt.HSym("", "a"), b = rt.HSym("", "b");
            long form = rt.MakeObj(TySeq, new long[]{iff, a, b});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t5[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 6. A `.method` symbol, standalone: `.foo`
        {
            long dotfoo = rt.HSym("", ".foo");
            int fi = rt.Push(dotfoo);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t6[").Append(st).Append("]=").Append(rt.HShow(outv)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 7. `x#` TWICE in one form, `y#` between: `(x# y# x#)`.
        {
            long em0 = rt.EmptyMapObj();
            RdPut(rt, sti, RdsGensyms, em0);
            RdSetInt(rt, sti, RdsGensymN, 10);
            long x1 = rt.HSym("", "x#"), y1 = rt.HSym("", "y#"), x2 = rt.HSym("", "x#");
            long form = rt.MakeObj(TySeq, new long[]{x1, y1, x2});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t7[").Append(st).Append("]=").Append(rt.HShow(outv))
             .Append(" ctr=").Append(RdInt(rt, sti, RdsGensymN)).Append(' ');
            rt.PopTo(baseIx - 1);
        }

        // 8. A NESTED SYNTAX-QUOTED MARKER: `(flint.reader/syntax-quoted zz)`.
        {
            long zz = rt.HSym("", "zz");
            long sq = LitSymbol(rt, "flint.reader", "syntax-quoted");
            long form = rt.MakeObj(TySeq, new long[]{sq, zz});
            int fi = rt.Push(form);
            int baseIx = rt.Mark();
            int st = SqForm(rt, sti, fi);
            long outv = rt.R(rt.Mark() - 1);
            o.Append("t8[").Append(st).Append("]=").Append(rt.HShow(outv));
            rt.PopTo(baseIx - 1);
        }

        System.Console.WriteLine(o.ToString().Trim());
    }
--expect
t1[0]=(clojure.core/seq (clojure.core/concat (clojure.core/list (flint.reader/syntax-quoted a)) (clojure.core/list b) c)) t2[0]=(clojure.core/vec (clojure.core/concat (clojure.core/list a) (clojure.core/list 1))) t3[0]=(clojure.core/set (clojure.core/concat (clojure.core/list :x))) t4[0]=(clojure.core/apply clojure.core/hash-map (clojure.core/concat (clojure.core/list :a) (clojure.core/list 2) (clojure.core/list :b) (clojure.core/list 1) (clojure.core/list :c) (clojure.core/list 3))) t5[0]=(clojure.core/seq (clojure.core/concat (clojure.core/list (quote if)) (clojure.core/list (flint.reader/syntax-quoted a)) (clojure.core/list (flint.reader/syntax-quoted b)))) t6[0]=(quote .foo) t7[0]=(clojure.core/seq (clojure.core/concat (clojure.core/list (quote x__10)) (clojure.core/list (quote y__11)) (clojure.core/list (quote x__10)))) ctr=12 t8[0]=(clojure.core/seq (clojure.core/concat (clojure.core/list (quote quote)) (clojure.core/list (flint.reader/syntax-quoted zz))))
--expect-why
DERIVED BY HAND from `readsq.kin`'s algorithm, walking each of the 8 forms
through `sq-form` the way the source itself does. Every status is `0`
(`RS_OK`), so the leading `[0]` on each line is itself part of the check --
a status pushed in the error arm instead would still print SOME form (the
probe does not gate printing on it), and a wrong status would move only that
digit while the shape of the form happened to still look plausible.

t1 `(a ~b ~@c)`: not a symbol, not headed `clojure.core/unquote`, so the
`is-seq` branch: `push-seq` walks all 3 elements, `sq-expand` handles each:
  `a` -- an ordinary symbol, wrapped as `(clojure.core/list (flint.reader/
         syntax-quoted a))` -- compile-time-free symbols are LEFT for the
         analyzer (`DECISIONS.md#context-free-reader`, cited in the header).
  `~b` -- headed `unquote`: `(clojure.core/list b)`, `b` itself UNCHANGED
         (not syntax-quoted -- the whole point of `~`).
  `~@c` -- headed `unquote-splicing`: `c` alone, no `list` wrapper, because
         `concat` already expects a seq to splice rather than one to make.
A seq wraps the final `concat` in `(clojure.core/seq ...)`.

t2 `[~a 1]`: the VECTOR branch skips `push-seq`/`is-seq` entirely and calls
`push-vec` instead, so the elements reach `sq-expand` the same way; `1` is
self-quoting (sq-form's final fallthrough: `push fi` unchanged). Wrapped in
`clojure.core/vec` rather than `clojure.core/seq` -- the one difference a
vector's syntax quote makes from a list's.

t3 `#{:x}`: the SET branch calls `set-element-vector` then the same
`sq-expand`; `:x` is self-quoting (keywords fall through to the same
`push fi` fallthrough as the int did). Wrapped in `clojure.core/set`.

t4 `{:b 1 :a 2 :c 3}`: THE SORT is the point of this one. `map-entry-vector`
keeps array-map order (b, a, c -- `mapmake.kin`'s documented order), but
`ckey-put` keys each entry `53('5')` + namespace("")+'/'+name, so the three
keys are `5/a`, `5/b`, `5/c` in that UTF-16 order regardless of input order --
`sort-roots`' insertion sort reorders the (key,value) pairs by it before
flattening, so the output lists `:a 2 :b 1 :c 3` -- NOT the input order `:b 1
:a 2 :c 3`. Wrapped in `(clojure.core/apply clojure.core/hash-map ...)`. Had
the sort not run (or sorted on something else), this field alone would print
the untouched input order and nothing else here would move.

t5 `(if a b)`: `if` matches `is-special` (`sq-symbol`'s OR), so it is wrapped
`(quote if)` rather than `(flint.reader/syntax-quoted if)`; `a` and `b` are
ordinary symbols and get the syntax-quoted wrapper, same as in t1. Proves
`is-special` is actually consulted, not just the dotted check.

t6 `.foo`, alone (not inside a list): `sq-symbol`'s OTHER half of the OR --
no namespace AND the name starts with `.` -- wraps it `(quote .foo)` with no
`sq-expand`/`concat` machinery at all, since a bare symbol never reaches
`is-seq`.

t7 `(x# y# x#)`, with the gensym map seeded empty and the counter at 10:
first `x#` -- `map-get` on the fresh map misses, so a NEW name is minted:
strip the trailing `#`, append `__` and the CURRENT counter (10) -> `x__10`,
the map gains `x#` -> `x__10`, and the counter becomes 11. `y#` -- misses
too, mints `y__11`, counter becomes 12. Second `x#` -- HITS the memo (`x#` ->
`x__10` from the first), so it reuses that exact symbol and the counter does
NOT advance. `ctr=12` is the header's claim made checkable: two distinct
names were minted, not three, so the final `RDS_GENSYM_N` is 10+2=12. Had the
memo not been consulted, the third item would read `x__12` and `ctr` would
print 13.

t8 `(flint.reader/syntax-quoted zz)`: the one source a reader itself would
only ever hand to `sq-form` from a NESTED syntax quote slipping through, but
exercised directly here. Headed `flint.reader/syntax-quoted`, so it is
rewrapped `(quote zz)` and `sq-form` is called AGAIN on that two-element list:
`quote` is itself in `is-special`'s list, so IT gets `(quote quote)` rather
than a `syntax-quoted` wrapper, and `zz` gets the ordinary wrapper -- the two
calls nest rather than one shadowing the other, which this double-layer
syntax-quoted/quote distinction is designed to prove.
