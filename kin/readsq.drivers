    internal const long Nil = unchecked((long) 0xFFFF000000000000UL);
    internal const long True = unchecked((long) 0xFFFF000000000001UL);
    internal const long False = unchecked((long) 0xFFFF000000000002UL);
    internal const long NotFound = unchecked((long) 0xFFFF000000000003UL);
    internal const int TyStr = 1, TySym = 2, TyKw = 3, TyVec = 4, TySet = 5,
                       TyMap = 6, TySeq = 7, TyMapentry = 8, TyState = 9;
    internal const int RdsGensyms = 6, RdsGensymN = 16, RsOk = 0;
    internal const int StateLen = 17;

    internal static class Val {
        internal const long Nil = Probe.Nil, True = Probe.True, False = Probe.False,
                           NotFound = Probe.NotFound;
        internal static bool IsNil(long v) { return v == Nil; }
        internal static long Fixnum(long n) { return unchecked((long) ((0xDUL << 60) | ((ulong) n & 0x0000FFFFFFFFFFFFUL))); }
        internal static long AsFixnum(long v) { return (v << 16) >> 16; }
        internal static long Heap(long a) { return a; }
        internal static bool IsDouble(long v) { return false; }
    }

    internal sealed class Obj { internal int Ty; internal long[] Slots; }

    internal sealed class Rt {
        internal System.Collections.Generic.List<Obj> Objs = new();
        internal System.Collections.Generic.List<long> Roots = new();
        internal System.Collections.Generic.List<int[]> Cps = new();
        internal System.Collections.Generic.List<System.Collections.Generic.List<int>> Sinks = new();
        internal System.Collections.Generic.Dictionary<string, long> Syms = new();
        internal System.Collections.Generic.Dictionary<string, long> Kws = new();

        internal long MakeObj(int ty, long[] slots) {
            Objs.Add(new Obj { Ty = ty, Slots = slots });
            return Objs.Count - 1;
        }
        internal bool IsHeapTy(long v, int t) {
            if (v == Nil || v == True || v == False || v == NotFound) return false;
            if ((ulong) v >> 60 == 0xD) return false;
            return v >= 0 && v < Objs.Count && Objs[(int) v].Ty == t;
        }
        internal int Mark() { return Roots.Count; }
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) { return Roots[i]; }
        internal void SetR(int i, long v) { Roots[i] = v; }
        internal void PopTo(int n) { Roots.RemoveRange(n, Roots.Count - n); }
        internal long Slot(long v, int i) { return Objs[(int) v].Slots[i]; }

        internal int SinkOpen() { Sinks.Add(new System.Collections.Generic.List<int>()); return Sinks.Count - 1; }
        internal void SinkPut(int sk, int b) { Sinks[sk].Add(b); }
        internal void SinkClose(int sk) {}
        internal long SinkString(int sk) {
            var bytes = Sinks[sk];
            var slots = new long[bytes.Count];
            for (int i = 0; i < bytes.Count; i++) slots[i] = Val.Fixnum(bytes[i]);
            return MakeObj(TyStr, slots);
        }

        internal int CpsOpen() { Cps.Add(new int[0]); return Cps.Count - 1; }
        internal void CpsPut(int c, int v) {
            var a = Cps[c]; var b = new int[a.Length + 1];
            System.Array.Copy(a, b, a.Length); b[a.Length] = v;
            Cps[c] = b;
        }
        internal int CpsAt(int c, int i) { return Cps[c][i]; }
        internal int CpsLen(int c) { return Cps[c].Length; }
        internal void CpsClose(int c) {}

        internal string Text(long v) {
            var s = Objs[(int) v].Slots;
            var sb = new System.Text.StringBuilder();
            foreach (var cp in s) sb.Append(char.ConvertFromUtf32((int) Val.AsFixnum(cp)));
            return sb.ToString();
        }
        internal long Mkstr(string t) {
            var cps = new System.Collections.Generic.List<int>();
            for (int i = 0; i < t.Length; i++) {
                int cp = char.ConvertToUtf32(t, i);
                cps.Add(cp);
                if (char.IsHighSurrogate(t[i])) i++;
            }
            var slots = new long[cps.Count];
            for (int i = 0; i < cps.Count; i++) slots[i] = Val.Fixnum(cps[i]);
            return MakeObj(TyStr, slots);
        }
        internal string NsText(long ns) { return Val.IsNil(ns) ? "" : Text(ns); }
        internal long InternSym(long ns, long nm) {
            string key = NsText(ns) + "\u0000" + Text(nm);
            if (Syms.TryGetValue(key, out long v)) return v;
            long nsv = NsText(ns).Length == 0 ? Nil : Mkstr(NsText(ns));
            long nmv = Mkstr(Text(nm));
            long outv = MakeObj(TySym, new long[]{nsv, nmv});
            Syms[key] = outv;
            return outv;
        }
        internal long HKw(string ns, string nm) {
            string key = ns + "\u0000" + nm;
            if (Kws.TryGetValue(key, out long v)) return v;
            long nsv = ns.Length == 0 ? Nil : Mkstr(ns);
            long nmv = Mkstr(nm);
            long outv = MakeObj(TyKw, new long[]{nsv, nmv});
            Kws[key] = outv;
            return outv;
        }
        internal long HSym(string ns, string nm) {
            long nsv = ns.Length == 0 ? Nil : Mkstr(ns);
            long nmv = Mkstr(nm);
            return InternSym(nsv, nmv);
        }
        internal bool IsSymbol(long v) { return IsHeapTy(v, TySym); }
        internal bool IsKeyword(long v) { return IsHeapTy(v, TyKw); }
        internal bool IsString(long v) { return IsHeapTy(v, TyStr); }
        internal long NameOf(long v) { return (IsHeapTy(v, TySym) || IsHeapTy(v, TyKw)) ? Slot(v, 1) : v; }
        internal long NsOf(long v) { return (IsHeapTy(v, TySym) || IsHeapTy(v, TyKw)) ? Slot(v, 0) : Nil; }
        internal void SAppendImpl(long v, int sk) {
            var s = Objs[(int) v].Slots;
            foreach (var cp in s) SinkPutCpImpl(sk, (int) Val.AsFixnum(cp));
        }
        internal bool ValEqImpl(long a, long b) { return a == b; }
        internal int StrCmpImpl(long a, long b) {
            var sa = Objs[(int) a].Slots; var sb = Objs[(int) b].Slots;
            int n = System.Math.Min(sa.Length, sb.Length);
            for (int i = 0; i < n; i++) {
                long ca = Val.AsFixnum(sa[i]), cb = Val.AsFixnum(sb[i]);
                if (ca != cb) return ca < cb ? -1 : 1;
            }
            return sa.Length.CompareTo(sb.Length);
        }
        internal bool IsInt(long v) { return v != Nil && v != True && v != False && v != NotFound && (ulong) v >> 60 == 0xD; }
        internal long NumToStrImpl(long v) { return Mkstr(Val.AsFixnum(v).ToString()); }
        internal double NumF64(long v) { return 0.0; }

        internal bool IsVectorLike(long v) { return IsHeapTy(v, TyVec); }
        internal long VecCountImpl(long v) { return Objs[(int) v].Slots.Length; }
        internal long VecNthImpl(long v, int i, long d) {
            var s = Objs[(int) v].Slots;
            return (i >= 0 && i < s.Length) ? s[i] : d;
        }
        internal bool IsSet(long v) { return IsHeapTy(v, TySet); }
        internal long SetElementVectorImpl(long v) { return MakeObj(TyVec, (long[]) Objs[(int) v].Slots.Clone()); }
        internal bool IsMap(long v) { return IsHeapTy(v, TyMap); }
        internal long MapEntryVectorImpl(long m) {
            var s = Objs[(int) m].Slots;
            var entries = new System.Collections.Generic.List<long>();
            for (int i = 0; i < s.Length; i += 2) entries.Add(MakeObj(TyMapentry, new long[]{s[i], s[i + 1]}));
            return MakeObj(TyVec, entries.ToArray());
        }
        internal bool IsSeqImpl(long v) { return IsHeapTy(v, TySeq) && Objs[(int) v].Slots.Length > 0; }
        internal long SeqImpl(long v) { return IsSeqImpl(v) ? v : Nil; }
        internal long FirstImpl(long v) { return Objs[(int) v].Slots[0]; }
        internal long NextImpl(long v) {
            var s = Objs[(int) v].Slots;
            if (s.Length <= 1) return Nil;
            var tail = new long[s.Length - 1];
            System.Array.Copy(s, 1, tail, 0, s.Length - 1);
            return MakeObj(TySeq, tail);
        }
        internal long ListFromRootsImpl(int baseIx, int n) {
            var s = new long[n];
            for (int i = 0; i < n; i++) s[i] = Roots[baseIx + i];
            return MakeObj(TySeq, s);
        }

        internal long EmptyMapObj() { return MakeObj(TyMap, new long[0]); }
        internal long MapGetImpl(long m, long k, long dflt) {
            var s = Objs[(int) m].Slots;
            for (int i = 0; i < s.Length; i += 2) if (s[i] == k) return s[i + 1];
            return dflt;
        }
        internal long MapAssocImpl(long m, long k, long v) {
            var s = Objs[(int) m].Slots;
            var outv = (long[]) s.Clone();
            for (int i = 0; i < outv.Length; i += 2) {
                if (outv[i] == k) { outv[i + 1] = v; return MakeObj(TyMap, outv); }
            }
            var grown = new long[outv.Length + 2];
            System.Array.Copy(outv, grown, outv.Length);
            grown[outv.Length] = k; grown[outv.Length + 1] = v;
            return MakeObj(TyMap, grown);
        }

        internal long HNewState() {
            var slots = new long[StateLen];
            for (int i = 0; i < StateLen; i++) slots[i] = Nil;
            return MakeObj(TyState, slots);
        }
        internal long RdGetImpl(int sti, int s) { return Slot(R(sti), s); }
        internal void RdPutImpl(int sti, int s, long v) { Objs[(int) R(sti)].Slots[s] = v; }
        internal long RdIntImpl(int sti, int s) { return Val.AsFixnum(RdGetImpl(sti, s)); }
        internal void RdSetIntImpl(int sti, int s, long v) { RdPutImpl(sti, s, Val.Fixnum(v)); }
        internal int RdFailLitImpl(int sti, string t) { return 4; }

        internal long LitSymbolImpl(string ns, string nm) {
            int baseIx = Mark();
            long nsv = Mkstr(ns);
            int ni = Push(nsv);
            long nmv = Mkstr(nm);
            long outv = InternSym(R(ni), nmv);
            PopTo(baseIx);
            return outv;
        }
        internal long LitSymbol1Impl(string nm) { return InternSym(Nil, Mkstr(nm)); }
        internal bool IsSym1Impl(long v, string nm) {
            if (!IsSymbol(v)) return false;
            int baseIx = Mark();
            int vi = Push(v);
            long probe = LitSymbol1Impl(nm);
            bool same = ValEqImpl(R(vi), probe);
            PopTo(baseIx);
            return same;
        }
        internal bool IsSym2Impl(long v, string ns, string nm) {
            if (!IsSymbol(v)) return false;
            int baseIx = Mark();
            int vi = Push(v);
            long probe = LitSymbolImpl(ns, nm);
            bool same = ValEqImpl(R(vi), probe);
            PopTo(baseIx);
            return same;
        }
        internal void MsgLitImpl(int sk, string t) { SAppendImpl(Mkstr(t), sk); }
        internal void MsgIntImpl(int sk, long n) {
            if (n >= 10) MsgIntImpl(sk, n / 10);
            SinkPut(sk, (int) (48 + (n % 10)));
        }
        internal void SinkPutCpImpl(int sk, int c) {
            if (c < 128) { SinkPut(sk, c); return; }
            if (c < 2048) { SinkPut(sk, 192 | ((int)((uint) c >> 6))); SinkPut(sk, 128 | (c & 63)); return; }
            if (c < 65536) {
                SinkPut(sk, 224 | ((int)((uint) c >> 12))); SinkPut(sk, 128 | (((int)((uint) c >> 6)) & 63));
                SinkPut(sk, 128 | (c & 63)); return;
            }
            SinkPut(sk, 240 | ((int)((uint) c >> 18))); SinkPut(sk, 128 | (((int)((uint) c >> 12)) & 63));
            SinkPut(sk, 128 | (((int)((uint) c >> 6)) & 63)); SinkPut(sk, 128 | (c & 63));
        }

        internal string HShow(long v) {
            if (Val.IsNil(v)) return "nil";
            if (v == True) return "true";
            if (v == False) return "false";
            if ((ulong) v >> 60 == 0xD) return Val.AsFixnum(v).ToString();
            int a = (int) v;
            var o = Objs[a];
            switch (o.Ty) {
                case TyStr: return "\"" + Text(v) + "\"";
                case TySym:
                    return Val.IsNil(o.Slots[0]) ? Text(o.Slots[1]) : Text(o.Slots[0]) + "/" + Text(o.Slots[1]);
                case TyKw:
                    return Val.IsNil(o.Slots[0]) ? ":" + Text(o.Slots[1]) : ":" + Text(o.Slots[0]) + "/" + Text(o.Slots[1]);
                case TySeq: return ShowJoin(o.Slots, "(", ")");
                case TyVec: return ShowJoin(o.Slots, "[", "]");
                case TySet: return ShowJoin(o.Slots, "#{", "}");
                default: return "?";
            }
        }
        internal string ShowJoin(long[] xs, string open, string close) {
            var sb = new System.Text.StringBuilder(open);
            for (int i = 0; i < xs.Length; i++) { if (i > 0) sb.Append(' '); sb.Append(HShow(xs[i])); }
            return sb.Append(close).ToString();
        }
    }

    internal static int CodePoints(Rt rt, long s) {
        int c = rt.CpsOpen();
        var slots = rt.Objs[(int) s].Slots;
        foreach (var cp in slots) rt.CpsPut(c, (int) Val.AsFixnum(cp));
        return c;
    }
    internal static bool IsSymbol(Rt rt, long v) { return rt.IsSymbol(v); }
    internal static bool IsKeyword(Rt rt, long v) { return rt.IsKeyword(v); }
    internal static bool IsString(Rt rt, long v) { return rt.IsString(v); }
    internal static long NameOf(Rt rt, long v) { return rt.NameOf(v); }
    internal static long NsOf(Rt rt, long v) { return rt.NsOf(v); }
    internal static void SAppend(Rt rt, long v, int sk) { rt.SAppendImpl(v, sk); }
    internal static bool ValEq(Rt rt, long a, long b) { return rt.ValEqImpl(a, b); }
    internal static int StrCmp(Rt rt, long a, long b) { return rt.StrCmpImpl(a, b); }
    internal static bool IsInt(Rt rt, long v) { return rt.IsInt(v); }
    internal static long NumToStr(Rt rt, long v) { return rt.NumToStrImpl(v); }
    internal static bool IsVectorLike(Rt rt, long v) { return rt.IsVectorLike(v); }
    internal static int VecCount(Rt rt, long v) { return (int) rt.VecCountImpl(v); }
    internal static long VecNth(Rt rt, long v, int i, long d) { return rt.VecNthImpl(v, i, d); }
    internal static bool IsSet(Rt rt, long v) { return rt.IsSet(v); }
    internal static long SetElementVector(Rt rt, long v) { return rt.SetElementVectorImpl(v); }
    internal static bool IsMap(Rt rt, long v) { return rt.IsMap(v); }
    internal static long MapEntryVector(Rt rt, long m) { return rt.MapEntryVectorImpl(m); }
    internal static bool IsSeq(Rt rt, long v) { return rt.IsSeqImpl(v); }
    internal static long Seq(Rt rt, long v) { return rt.SeqImpl(v); }
    internal static long First(Rt rt, long v) { return rt.FirstImpl(v); }
    internal static long Next(Rt rt, long v) { return rt.NextImpl(v); }
    internal static long ListFromRoots(Rt rt, int baseIx, int n) { return rt.ListFromRootsImpl(baseIx, n); }
    internal static long MapGet(Rt rt, long m, long k, long dflt) { return rt.MapGetImpl(m, k, dflt); }
    internal static long MapAssoc(Rt rt, long m, long k, long v) { return rt.MapAssocImpl(m, k, v); }
    internal static long RdGet(Rt rt, int sti, int s) { return rt.RdGetImpl(sti, s); }
    internal static void RdPut(Rt rt, int sti, int s, long v) { rt.RdPutImpl(sti, s, v); }
    internal static long RdInt(Rt rt, int sti, int s) { return rt.RdIntImpl(sti, s); }
    internal static void RdSetInt(Rt rt, int sti, int s, long v) { rt.RdSetIntImpl(sti, s, v); }
    internal static int RdFailLit(Rt rt, int sti, string t) { return rt.RdFailLitImpl(sti, t); }
    internal static long LitSymbol(Rt rt, string ns, string nm) { return rt.LitSymbolImpl(ns, nm); }
    internal static long LitSymbol1(Rt rt, string nm) { return rt.LitSymbol1Impl(nm); }
    internal static bool IsSym1(Rt rt, long v, string nm) { return rt.IsSym1Impl(v, nm); }
    internal static bool IsSym2(Rt rt, long v, string ns, string nm) { return rt.IsSym2Impl(v, ns, nm); }
    internal static void MsgLit(Rt rt, int sk, string t) { rt.MsgLitImpl(sk, t); }
    internal static void MsgInt(Rt rt, int sk, long n) { rt.MsgIntImpl(sk, n); }
    internal static void SinkPutCp(Rt rt, int sk, int c) { rt.SinkPutCpImpl(sk, c); }

    internal static class Str {
        internal static long Of(Rt rt, string t) { return rt.Mkstr(t); }
    }
    internal static class Num {
        internal static double F64(Rt rt, long v) { return rt.NumF64(v); }
