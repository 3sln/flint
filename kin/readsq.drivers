    static boolean isSeq(Rt rt, long v) { return rt.isSeqImpl(v); }
    static long seq(Rt rt, long v) { return rt.seqImpl(v); }
    static long first(Rt rt, long v) { return rt.firstImpl(v); }
    static long next(Rt rt, long v) { return rt.nextImpl(v); }
    static long listFromRoots(Rt rt, int base, int n) { return rt.listFromRootsImpl(base, n); }
