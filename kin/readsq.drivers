--rust-head
use std::collections::HashMap;

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
const TRUE: Value = Value(0xFFFF_0000_0000_0001);
const FALSE: Value = Value(0xFFFF_0000_0000_0002);
const NOT_FOUND: Value = Value(0xFFFF_0000_0000_0003);
const I64_MIN: i64 = i64::MIN;

const TY_STR: u8 = 1;
const TY_SYM: u8 = 2;
const TY_KW: u8 = 3;
const TY_VEC: u8 = 4;
const TY_SET: u8 = 5;
const TY_MAP: u8 = 6;
const TY_SEQ: u8 = 7;
const TY_MAPENTRY: u8 = 8;
const TY_STATE: u8 = 9;

// readconst.kin's constants this driver needs, copied by hand -- it does not
// compile that module.
const RDS_GENSYMS: u32 = 6;
const RDS_GENSYM_N: u32 = 16;
const RS_OK: u32 = 0;
const STATE_LEN: usize = 17;

impl Value {
    fn is_nil(self) -> bool { self == NIL }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | ((n as u64) & 0x0000_FFFF_FFFF_FFFF)) }
    fn as_fixnum(self) -> i64 { ((self.0 << 16) as i64) >> 16 }
    fn heap(a: usize) -> Value { Value(a as u64) }
    fn as_heap(self) -> usize { self.0 as usize }
    fn is_double(self) -> bool { false } // this fixture never builds one
}

struct Obj { ty: u8, slots: Vec<Value> }

struct Rt {
    objs: Vec<Obj>,
    roots: Vec<Value>,
    cps: Vec<Vec<u32>>,
    sinks: Vec<Vec<u32>>,
    syms: HashMap<(String, String), Value>,
    kws: HashMap<(String, String), Value>,
}

impl Rt {
    fn new() -> Rt {
        Rt { objs: Vec::new(), roots: Vec::new(), cps: Vec::new(), sinks: Vec::new(),
             syms: HashMap::new(), kws: HashMap::new() }
    }
    fn obj(&mut self, ty: u8, slots: Vec<Value>) -> Value {
        self.objs.push(Obj { ty, slots });
        Value::heap(self.objs.len() - 1)
    }
    fn is_heap_ty(&self, v: Value, t: u8) -> bool {
        let a = v.as_heap();
        a < self.objs.len() && self.objs[a].ty == t
            && v != NIL && v != TRUE && v != FALSE && v != NOT_FOUND
            && (v.0 >> 60) != 0xD
    }
    // --- the shadow stack ----------------------------------------------------
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.as_heap()].slots[i as usize] }

    // --- the sink. EVERY ONE OF THESE THAT ONLY READS IS `&self`, NOT
    // `&mut self` -- the generated code nests calls like
    // `self.ckey_put(ek, self.vec_nth(...))`, and Rust's two-phase borrows
    // allow a `&mut self` receiver with a `&self` argument nested inside it,
    // but not two `&mut self` calls nested in one another. Matching the
    // real signatures (read vs. allocate) is what makes that compile. -------
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_put(&mut self, sk: u32, b: u32) { self.sinks[sk as usize].push(b); }
    fn sink_close(&mut self, _sk: u32) {}
    // ASCII-ONLY, as in `readcore.drivers` -- every call made to this reads
    // back a canonical key built only from digits, `/` and separator bytes.
    fn sink_string(&mut self, sk: u32) -> Value {
        let bytes = self.sinks[sk as usize].clone();
        let slots: Vec<Value> = bytes.iter().map(|&b| Value::fixnum(b as i64)).collect();
        self.obj(TY_STR, slots)
    }

    // --- the code-point buffer (vocabulary) and `code-points` (CROSS-MODULE
    // from `flint.rt.codepoints`, mocked: a string already holds code points,
    // so "decoding" is a copy). -------------------------------------------------
    fn cps_open(&mut self) -> u32 { self.cps.push(Vec::new()); (self.cps.len() - 1) as u32 }
    fn cps_put(&mut self, c: u32, v: u32) { self.cps[c as usize].push(v); }
    fn cps_at(&self, c: u32, i: u32) -> u32 { self.cps[c as usize][i as usize] }
    fn cps_len(&self, c: u32) -> u32 { self.cps[c as usize].len() as u32 }
    fn cps_close(&mut self, _c: u32) {}
    fn code_points(&mut self, s: Value) -> u32 {
        let c = self.cps_open();
        let n = self.objs[s.as_heap()].slots.len();
        for i in 0..n {
            let cp = self.objs[s.as_heap()].slots[i].as_fixnum() as u32;
            self.cps_put(c, cp);
        }
        c
    }

    // --- strings, symbols, keywords ---------------------------------------------
    fn h_text(&self, v: Value) -> String {
        self.objs[v.as_heap()].slots.iter().map(|s| char::from_u32(s.as_fixnum() as u32).unwrap()).collect()
    }
    fn h_mkstr(&mut self, t: &str) -> Value {
        let slots: Vec<Value> = t.chars().map(|c| Value::fixnum(c as i64)).collect();
        self.obj(TY_STR, slots)
    }
    fn string(&mut self, t: &'static str) -> Value { self.h_mkstr(t) }
    fn h_nstext(&self, ns: Value) -> String { if ns.is_nil() { String::new() } else { self.h_text(ns) } }
    // `symbol-of`: INTERNED by content -- see `readcore.drivers` for why
    // that makes `val-eq` a plain `==`.
    fn symbol_from_values(&mut self, ns: Value, nm: Value) -> Value {
        let key = (self.h_nstext(ns), self.h_text(nm));
        if let Some(v) = self.syms.get(&key) { return *v; }
        let nsv = if key.0.is_empty() { NIL } else { self.h_mkstr(&key.0) };
        let nmv = self.h_mkstr(&key.1);
        let v = self.obj(TY_SYM, vec![nsv, nmv]);
        self.syms.insert(key, v);
        v
    }
    // NOT in readsq's own vocabulary (no keyword literal is ever built by
    // this source), but the test harness needs keywords as INPUT forms.
    fn h_kw(&mut self, ns: &str, nm: &str) -> Value {
        let key = (ns.to_string(), nm.to_string());
        if let Some(v) = self.kws.get(&key) { return *v; }
        let nsv = if ns.is_empty() { NIL } else { self.h_mkstr(ns) };
        let nmv = self.h_mkstr(nm);
        let v = self.obj(TY_KW, vec![nsv, nmv]);
        self.kws.insert(key, v);
        v
    }
    fn h_sym(&mut self, ns: &str, nm: &str) -> Value {
        let nsv = if ns.is_empty() { NIL } else { self.h_mkstr(ns) };
        let nmv = self.h_mkstr(nm);
        self.symbol_from_values(nsv, nmv)
    }
    fn is_symbol(&self, v: Value) -> bool { self.is_heap_ty(v, TY_SYM) }
    fn is_keyword(&self, v: Value) -> bool { self.is_heap_ty(v, TY_KW) }
    fn is_string(&self, v: Value) -> bool { self.is_heap_ty(v, TY_STR) }
    fn name_of(&self, v: Value) -> Value {
        if self.is_heap_ty(v, TY_SYM) || self.is_heap_ty(v, TY_KW) { self.slot(v, 1) } else { v }
    }
    fn ns_of(&self, v: Value) -> Value {
        if self.is_heap_ty(v, TY_SYM) || self.is_heap_ty(v, TY_KW) { self.slot(v, 0) } else { NIL }
    }
    fn s_append(&mut self, v: Value, sk: u32) {
        let n = self.objs[v.as_heap()].slots.len();
        for i in 0..n {
            let cp = self.objs[v.as_heap()].slots[i].as_fixnum() as u32;
            self.sink_put_cp(sk, cp);
        }
    }
    fn val_eq(&self, a: Value, b: Value) -> bool { a == b }
    fn str_cmp(&self, a: Value, b: Value) -> i32 {
        let sa = &self.objs[a.as_heap()].slots;
        let sb = &self.objs[b.as_heap()].slots;
        let n = sa.len().min(sb.len());
        for i in 0..n {
            let (ca, cb) = (sa[i].as_fixnum(), sb[i].as_fixnum());
            if ca != cb { return if ca < cb { -1 } else { 1 }; }
        }
        if sa.len() == sb.len() { 0 } else if sa.len() < sb.len() { -1 } else { 1 }
    }
    fn is_int(&self, v: Value) -> bool { v != NIL && v != TRUE && v != FALSE && v != NOT_FOUND && (v.0 >> 60) == 0xD }
    fn num_to_str(&mut self, v: Value) -> Value {
        let n = v.as_fixnum();
        self.h_mkstr(&n.to_string())
    }
    fn num_f64(&self, _v: Value) -> f64 { 0.0 } // unreached: no double is ever built

    // --- vectors, sets, maps, lists ---------------------------------------------
    fn is_vector_like(&self, v: Value) -> bool { self.is_heap_ty(v, TY_VEC) }
    fn vec_count(&self, v: Value) -> u32 { self.objs[v.as_heap()].slots.len() as u32 }
    fn vec_nth(&self, v: Value, i: u32, d: Value) -> Value {
        let s = &self.objs[v.as_heap()].slots;
        if (i as usize) < s.len() { s[i as usize] } else { d }
    }
    fn is_set(&self, v: Value) -> bool { self.is_heap_ty(v, TY_SET) }
    fn set_element_vector(&mut self, v: Value) -> Value {
        let s = self.objs[v.as_heap()].slots.clone();
        self.obj(TY_VEC, s)
    }
    fn is_map(&self, v: Value) -> bool { self.is_heap_ty(v, TY_MAP) }
    fn map_entry_vector(&mut self, m: Value) -> Value {
        let s = self.objs[m.as_heap()].slots.clone();
        let mut entries = Vec::new();
        let mut i = 0;
        while i < s.len() { entries.push(self.obj(TY_MAPENTRY, vec![s[i], s[i + 1]])); i += 2; }
        self.obj(TY_VEC, entries)
    }
    fn is_seq(&self, v: Value) -> bool { self.is_heap_ty(v, TY_SEQ) && !self.objs[v.as_heap()].slots.is_empty() }
    fn seq(&self, v: Value) -> Value { if self.is_seq(v) { v } else { NIL } }
    fn first(&self, v: Value) -> Value { self.objs[v.as_heap()].slots[0] }
    fn next(&mut self, v: Value) -> Value {
        let s = &self.objs[v.as_heap()].slots;
        if s.len() <= 1 { NIL } else { let tail = s[1..].to_vec(); self.obj(TY_SEQ, tail) }
    }
    fn list_from_roots(&mut self, base: usize, n: u32) -> Value {
        let s: Vec<Value> = (0..n as usize).map(|i| self.roots[base + i]).collect();
        self.obj(TY_SEQ, s)
    }

    // --- maps the gensym memo lives in (CROSS-MODULE, mocked the same way
    // `readcore.drivers` mocks them) ---------------------------------------------
    fn empty_map(&mut self) -> Value { self.obj(TY_MAP, Vec::new()) }
    fn map_get(&self, m: Value, k: Value, default: Value) -> Value {
        let s = &self.objs[m.as_heap()].slots;
        let mut i = 0;
        while i < s.len() { if s[i] == k { return s[i + 1]; } i += 2; }
        default
    }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        let mut s = self.objs[m.as_heap()].slots.clone();
        let mut i = 0;
        let mut found = false;
        while i < s.len() { if s[i] == k { s[i + 1] = v; found = true; break; } i += 2; }
        if !found { s.push(k); s.push(v); }
        self.obj(TY_MAP, s)
    }

    // --- the reader's state, STANDING IN for `flint.rt.readcore`'s node:
    // this driver only ever touches `RDS_GENSYMS`/`RDS_GENSYM_N`, so there is
    // no need to reproduce `vecnode` underneath it. ------------------------------
    fn h_new_state(&mut self) -> Value { self.obj(TY_STATE, vec![NIL; STATE_LEN]) }
    fn rd_get(&self, sti: usize, s: u32) -> Value { self.slot(self.r(sti), s) }
    fn rd_put(&mut self, sti: usize, s: u32, v: Value) {
        let node = self.r(sti);
        self.objs[node.as_heap()].slots[s as usize] = v;
    }
    fn rd_int(&self, sti: usize, s: u32) -> i64 { self.rd_get(sti, s).as_fixnum() }
    fn rd_set_int(&mut self, sti: usize, s: u32, v: i64) { self.rd_put(sti, s, Value::fixnum(v)); }
    fn rd_fail_lit(&mut self, _sti: usize, _t: &'static str) -> u32 { 4 }

    // --- lit-symbol/lit-symbol1/is-sym1/is-sym2/msg-lit/msg-int/sink-put-cp:
    // readsq imports these FROM `flint.rt.readcore`, a module this driver
    // never compiles, so they are duplicated by hand exactly as
    // `readcore.drivers` implements them. -------------------------------------
    fn lit_symbol(&mut self, ns: &'static str, nm: &'static str) -> Value {
        let base = self.mark();
        let nsv = self.string(ns);
        let ni = self.push(nsv);
        let nmv = self.string(nm);
        let out = self.symbol_from_values(self.r(ni), nmv);
        self.pop_to(base);
        out
    }
    fn lit_symbol1(&mut self, nm: &'static str) -> Value {
        let nmv = self.string(nm);
        self.symbol_from_values(NIL, nmv)
    }
    fn is_sym1(&mut self, v: Value, nm: &'static str) -> bool {
        if !self.is_symbol(v) { return false; }
        let base = self.mark();
        let vi = self.push(v);
        let probe = self.lit_symbol1(nm);
        let same = self.val_eq(self.r(vi), probe);
        self.pop_to(base);
        same
    }
    fn is_sym2(&mut self, v: Value, ns: &'static str, nm: &'static str) -> bool {
        if !self.is_symbol(v) { return false; }
        let base = self.mark();
        let vi = self.push(v);
        let probe = self.lit_symbol(ns, nm);
        let same = self.val_eq(self.r(vi), probe);
        self.pop_to(base);
        same
    }
    fn msg_lit(&mut self, sk: u32, t: &'static str) {
        let v = self.string(t);
        self.s_append(v, sk);
    }
    fn msg_int(&mut self, sk: u32, n: i64) {
        if n >= 10 { self.msg_int(sk, n / 10); }
        self.sink_put(sk, (48 + (n % 10)) as u32);
    }
    fn sink_put_cp(&mut self, sk: u32, c: u32) {
        if c < 128 { self.sink_put(sk, c); return; }
        if c < 2048 {
            self.sink_put(sk, 192 | (c >> 6));
            self.sink_put(sk, 128 | (c & 63));
            return;
        }
        if c < 65536 {
            self.sink_put(sk, 224 | (c >> 12));
            self.sink_put(sk, 128 | ((c >> 6) & 63));
            self.sink_put(sk, 128 | (c & 63));
            return;
        }
        self.sink_put(sk, 240 | (c >> 18));
        self.sink_put(sk, 128 | ((c >> 12) & 63));
        self.sink_put(sk, 128 | ((c >> 6) & 63));
        self.sink_put(sk, 128 | (c & 63));
    }

    // --- a printer for whatever `sq-form` hands back ----------------------------
    fn h_show(&self, v: Value) -> String {
        if v.is_nil() { return "nil".to_string(); }
        if v == TRUE { return "true".to_string(); }
        if v == FALSE { return "false".to_string(); }
        if (v.0 >> 60) == 0xD { return v.as_fixnum().to_string(); }
        let a = v.as_heap();
        match self.objs[a].ty {
            TY_STR => format!("\"{}\"", self.h_text(v)),
            TY_SYM => {
                let s = &self.objs[a].slots;
                if s[0].is_nil() { self.h_text(s[1]) } else { format!("{}/{}", self.h_text(s[0]), self.h_text(s[1])) }
            }
            TY_KW => {
                let s = &self.objs[a].slots;
                if s[0].is_nil() { format!(":{}", self.h_text(s[1])) } else { format!(":{}/{}", self.h_text(s[0]), self.h_text(s[1])) }
            }
            TY_SEQ => {
                let parts: Vec<String> = self.objs[a].slots.iter().map(|&x| self.h_show(x)).collect();
                format!("({})", parts.join(" "))
            }
            TY_VEC => {
                let parts: Vec<String> = self.objs[a].slots.iter().map(|&x| self.h_show(x)).collect();
                format!("[{}]", parts.join(" "))
            }
            TY_SET => {
                let parts: Vec<String> = self.objs[a].slots.iter().map(|&x| self.h_show(x)).collect();
                format!("#{{{}}}", parts.join(" "))
            }
            _ => "?".to_string(),
        }
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt::new();
    let mut o = String::new();
    let st0 = rt.h_new_state();
    let sti = rt.push(st0);

    // 1. `(a ~b ~@c)`
    {
        let a = rt.h_sym("", "a");
        let ub = { let b = rt.h_sym("", "b"); let unq = rt.lit_symbol("clojure.core", "unquote");
                   rt.obj(TY_SEQ, vec![unq, b]) };
        let uc = { let c = rt.h_sym("", "c"); let unqs = rt.lit_symbol("clojure.core", "unquote-splicing");
                   rt.obj(TY_SEQ, vec![unqs, c]) };
        let form = rt.obj(TY_SEQ, vec![a, ub, uc]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t1[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1); // drop fi too
    }

    // 2. A VECTOR `[~a 1]`
    {
        let va = { let a = rt.h_sym("", "a"); let unq = rt.lit_symbol("clojure.core", "unquote");
                   rt.obj(TY_SEQ, vec![unq, a]) };
        let one = Value::fixnum(1);
        let form = rt.obj(TY_VEC, vec![va, one]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t2[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    // 3. A SET `#{:x}`
    {
        let kx = rt.h_kw("", "x");
        let form = rt.obj(TY_SET, vec![kx]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t3[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    // 4. A MAP `{:b 1 :a 2 :c 3}` -- entries given out of order, to catch
    // whether the canonical-key sort actually ran.
    {
        let kb = rt.h_kw("", "b"); let ka = rt.h_kw("", "a"); let kc = rt.h_kw("", "c");
        let form = rt.obj(TY_MAP, vec![kb, Value::fixnum(1), ka, Value::fixnum(2), kc, Value::fixnum(3)]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t4[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    // 5. A SPECIAL FORM `(if a b)`
    {
        let iff = rt.h_sym("", "if"); let a = rt.h_sym("", "a"); let b = rt.h_sym("", "b");
        let form = rt.obj(TY_SEQ, vec![iff, a, b]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t5[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    // 6. A `.method` symbol, standalone: `.foo`
    {
        let dotfoo = rt.h_sym("", ".foo");
        let fi = rt.push(dotfoo);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t6[{}]={} ", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    // 7. `x#` TWICE in one form, with `y#` between: `(x# y# x#)`. The
    // gensym map must start fresh and the counter at a known number.
    {
        let em0 = rt.empty_map();
        rt.rd_put(sti, RDS_GENSYMS, em0);
        rt.rd_set_int(sti, RDS_GENSYM_N, 10);
        let x1 = rt.h_sym("", "x#"); let y1 = rt.h_sym("", "y#"); let x2 = rt.h_sym("", "x#");
        let form = rt.obj(TY_SEQ, vec![x1, y1, x2]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t7[{}]={} ctr={} ", st, rt.h_show(out), rt.rd_int(sti, RDS_GENSYM_N)));
        rt.pop_to(base - 1);
    }

    // 8. A NESTED SYNTAX-QUOTED MARKER: `(flint.reader/syntax-quoted zz)`.
    {
        let zz = rt.h_sym("", "zz");
        let sq = rt.lit_symbol("flint.reader", "syntax-quoted");
        let form = rt.obj(TY_SEQ, vec![sq, zz]);
        let fi = rt.push(form);
        let base = rt.mark();
        let st = rt.sq_form(sti, fi);
        let out = rt.r(rt.mark() - 1);
        o.push_str(&format!("t8[{}]={}", st, rt.h_show(out)));
        rt.pop_to(base - 1);
    }

    println!("{}", o.trim());
}
--java-head
    static final long NIL = 0xFFFF_0000_0000_0000L;
    static final long TRUE = 0xFFFF_0000_0000_0001L;
    static final long FALSE = 0xFFFF_0000_0000_0002L;
    static final long NOT_FOUND = 0xFFFF_0000_0000_0003L;
    static final int TY_STR = 1, TY_SYM = 2, TY_KW = 3, TY_VEC = 4, TY_SET = 5,
                     TY_MAP = 6, TY_SEQ = 7, TY_MAPENTRY = 8, TY_STATE = 9;

    // readconst.kin's constants this driver needs, copied by hand.
    static final int RDS_GENSYMS = 6, RDS_GENSYM_N = 16, RS_OK = 0;
    static final int STATE_LEN = 17;

    static final class Val {
        static final long NIL = Probe.NIL, TRUE = Probe.TRUE, FALSE = Probe.FALSE,
                         NOT_FOUND = Probe.NOT_FOUND;
        static boolean isNil(long v) { return v == NIL; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0x0000FFFFFFFFFFFFL); }
        static long asFixnum(long v) { return (v << 16) >> 16; }
        static long heap(long a) { return a; }
        static boolean isDouble(long v) { return false; } // never built here
    }

    static final class Obj { int ty; long[] slots; }

    static final class Rt {
        java.util.ArrayList<Obj> objs = new java.util.ArrayList<>();
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        java.util.ArrayList<int[]> cps = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Integer>> sinks = new java.util.ArrayList<>();
        java.util.HashMap<String, Long> syms = new java.util.HashMap<>();
        java.util.HashMap<String, Long> kws = new java.util.HashMap<>();

        long obj(int ty, long[] slots) {
            Obj o = new Obj(); o.ty = ty; o.slots = slots; objs.add(o);
            return objs.size() - 1;
        }
        boolean isHeapTy(long v, int t) {
            if (v == NIL || v == TRUE || v == FALSE || v == NOT_FOUND) return false;
            if ((v >>> 60) == 0xDL) return false;
            return v >= 0 && v < objs.size() && objs.get((int) v).ty == t;
        }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long v, int i) { return objs.get((int) v).slots[i]; }

        int sinkOpen() { sinks.add(new java.util.ArrayList<>()); return sinks.size() - 1; }
        void sinkPut(int sk, int b) { sinks.get(sk).add(b); }
        void sinkClose(int sk) {}
        long sinkString(int sk) {
            java.util.ArrayList<Integer> bytes = sinks.get(sk);
            long[] slots = new long[bytes.size()];
            for (int i = 0; i < bytes.size(); i++) slots[i] = Val.fixnum(bytes.get(i));
            return obj(TY_STR, slots);
        }

        int cpsOpen() { cps.add(new int[0]); return cps.size() - 1; }
        void cpsPut(int c, int v) {
            int[] a = cps.get(c); int[] b = new int[a.length + 1];
            System.arraycopy(a, 0, b, 0, a.length); b[a.length] = v;
            cps.set(c, b);
        }
        int cpsAt(int c, int i) { return cps.get(c)[i]; }
        int cpsLen(int c) { return cps.get(c).length; }
        void cpsClose(int c) {}

        String text(long v) {
            long[] s = objs.get((int) v).slots;
            StringBuilder sb = new StringBuilder();
            for (long cp : s) sb.appendCodePoint((int) Val.asFixnum(cp));
            return sb.toString();
        }
        long mkstr(String t) {
            int[] cps = t.codePoints().toArray();
            long[] slots = new long[cps.length];
            for (int i = 0; i < cps.length; i++) slots[i] = Val.fixnum(cps[i]);
            return obj(TY_STR, slots);
        }
        String nsText(long ns) { return Val.isNil(ns) ? "" : text(ns); }
        long internSym(long ns, long nm) {
            String key = nsText(ns) + "\u0000" + text(nm);
            Long v = syms.get(key);
            if (v != null) return v;
            long nsv = nsText(ns).isEmpty() ? NIL : mkstr(nsText(ns));
            long nmv = mkstr(text(nm));
            long out = obj(TY_SYM, new long[]{nsv, nmv});
            syms.put(key, out);
            return out;
        }
        long hKw(String ns, String nm) {
            String key = ns + "\u0000" + nm;
            Long v = kws.get(key);
            if (v != null) return v;
            long nsv = ns.isEmpty() ? NIL : mkstr(ns);
            long nmv = mkstr(nm);
            long out = obj(TY_KW, new long[]{nsv, nmv});
            kws.put(key, out);
            return out;
        }
        long hSym(String ns, String nm) {
            long nsv = ns.isEmpty() ? NIL : mkstr(ns);
            long nmv = mkstr(nm);
            return internSym(nsv, nmv);
        }
        boolean isSymbol(long v) { return isHeapTy(v, TY_SYM); }
        boolean isKeyword(long v) { return isHeapTy(v, TY_KW); }
        boolean isString(long v) { return isHeapTy(v, TY_STR); }
        long nameOf(long v) { return (isHeapTy(v, TY_SYM) || isHeapTy(v, TY_KW)) ? slot(v, 1) : v; }
        long nsOf(long v) { return (isHeapTy(v, TY_SYM) || isHeapTy(v, TY_KW)) ? slot(v, 0) : NIL; }
        void sAppendImpl(long v, int sk) {
            long[] s = objs.get((int) v).slots;
            for (long cp : s) sinkPutCpImpl(sk, (int) Val.asFixnum(cp));
        }
        boolean valEqImpl(long a, long b) { return a == b; }
        int strCmpImpl(long a, long b) {
            long[] sa = objs.get((int) a).slots, sb = objs.get((int) b).slots;
            int n = Math.min(sa.length, sb.length);
            for (int i = 0; i < n; i++) {
                long ca = Val.asFixnum(sa[i]), cb = Val.asFixnum(sb[i]);
                if (ca != cb) return ca < cb ? -1 : 1;
            }
            return Integer.compare(sa.length, sb.length);
        }
        boolean isInt(long v) { return v != NIL && v != TRUE && v != FALSE && v != NOT_FOUND && (v >>> 60) == 0xDL; }
        long numToStrImpl(long v) { return mkstr(Long.toString(Val.asFixnum(v))); }
        double numF64(long v) { return 0.0; }

        boolean isVectorLike(long v) { return isHeapTy(v, TY_VEC); }
        long vecCountImpl(long v) { return objs.get((int) v).slots.length; }
        long vecNthImpl(long v, int i, long d) {
            long[] s = objs.get((int) v).slots;
            return (i >= 0 && i < s.length) ? s[i] : d;
        }
        boolean isSet(long v) { return isHeapTy(v, TY_SET); }
        long setElementVectorImpl(long v) { return obj(TY_VEC, objs.get((int) v).slots.clone()); }
        boolean isMap(long v) { return isHeapTy(v, TY_MAP); }
        long mapEntryVectorImpl(long m) {
            long[] s = objs.get((int) m).slots;
            java.util.ArrayList<Long> entries = new java.util.ArrayList<>();
            for (int i = 0; i < s.length; i += 2) entries.add(obj(TY_MAPENTRY, new long[]{s[i], s[i + 1]}));
            long[] out = new long[entries.size()];
            for (int i = 0; i < out.length; i++) out[i] = entries.get(i);
            return obj(TY_VEC, out);
        }
        boolean isSeqImpl(long v) { return isHeapTy(v, TY_SEQ) && objs.get((int) v).slots.length > 0; }
        long seqImpl(long v) { return isSeqImpl(v) ? v : NIL; }
        long firstImpl(long v) { return objs.get((int) v).slots[0]; }
        long nextImpl(long v) {
            long[] s = objs.get((int) v).slots;
            if (s.length <= 1) return NIL;
            long[] tail = java.util.Arrays.copyOfRange(s, 1, s.length);
            return obj(TY_SEQ, tail);
        }
        long listFromRootsImpl(int base, int n) {
            long[] s = new long[n];
            for (int i = 0; i < n; i++) s[i] = roots.get(base + i);
            return obj(TY_SEQ, s);
        }

        long emptyMapObj() { return obj(TY_MAP, new long[0]); }
        long mapGetImpl(long m, long k, long dflt) {
            long[] s = objs.get((int) m).slots;
            for (int i = 0; i < s.length; i += 2) if (s[i] == k) return s[i + 1];
            return dflt;
        }
        long mapAssocImpl(long m, long k, long v) {
            long[] s = objs.get((int) m).slots;
            long[] out = s.clone();
            for (int i = 0; i < out.length; i += 2) {
                if (out[i] == k) { out[i + 1] = v; return obj(TY_MAP, out); }
            }
            long[] grown = new long[out.length + 2];
            System.arraycopy(out, 0, grown, 0, out.length);
            grown[out.length] = k; grown[out.length + 1] = v;
            return obj(TY_MAP, grown);
        }

        long hNewState() {
            long[] slots = new long[STATE_LEN];
            java.util.Arrays.fill(slots, NIL);
            return obj(TY_STATE, slots);
        }
        long rdGetImpl(int sti, int s) { return slot(r(sti), s); }
        void rdPutImpl(int sti, int s, long v) { objs.get((int) r(sti)).slots[s] = v; }
        long rdIntImpl(int sti, int s) { return Val.asFixnum(rdGetImpl(sti, s)); }
        void rdSetIntImpl(int sti, int s, long v) { rdPutImpl(sti, s, Val.fixnum(v)); }
        int rdFailLitImpl(int sti, String t) { return 4; }

        long litSymbolImpl(String ns, String nm) {
            int base = mark();
            long nsv = mkstr(ns);
            int ni = push(nsv);
            long nmv = mkstr(nm);
            long out = internSym(r(ni), nmv);
            popTo(base);
            return out;
        }
        long litSymbol1Impl(String nm) { return internSym(NIL, mkstr(nm)); }
        boolean isSym1Impl(long v, String nm) {
            if (!isSymbol(v)) return false;
            int base = mark();
            int vi = push(v);
            long probe = litSymbol1Impl(nm);
            boolean same = valEqImpl(r(vi), probe);
            popTo(base);
            return same;
        }
        boolean isSym2Impl(long v, String ns, String nm) {
            if (!isSymbol(v)) return false;
            int base = mark();
            int vi = push(v);
            long probe = litSymbolImpl(ns, nm);
            boolean same = valEqImpl(r(vi), probe);
            popTo(base);
            return same;
        }
        void msgLitImpl(int sk, String t) { sAppendImpl(mkstr(t), sk); }
        void msgIntImpl(int sk, long n) {
            if (n >= 10) msgIntImpl(sk, n / 10);
            sinkPut(sk, (int) (48 + (n % 10)));
        }
        void sinkPutCpImpl(int sk, int c) {
            if (c < 128) { sinkPut(sk, c); return; }
            if (c < 2048) { sinkPut(sk, 192 | (c >>> 6)); sinkPut(sk, 128 | (c & 63)); return; }
            if (c < 65536) {
                sinkPut(sk, 224 | (c >>> 12)); sinkPut(sk, 128 | ((c >>> 6) & 63));
                sinkPut(sk, 128 | (c & 63)); return;
            }
            sinkPut(sk, 240 | (c >>> 18)); sinkPut(sk, 128 | ((c >>> 12) & 63));
            sinkPut(sk, 128 | ((c >>> 6) & 63)); sinkPut(sk, 128 | (c & 63));
        }

        String hShow(long v) {
            if (Val.isNil(v)) return "nil";
            if (v == TRUE) return "true";
            if (v == FALSE) return "false";
            if ((v >>> 60) == 0xDL) return Long.toString(Val.asFixnum(v));
            int a = (int) v;
            Obj o = objs.get(a);
            switch (o.ty) {
                case TY_STR: return "\"" + text(v) + "\"";
                case TY_SYM:
                    return Val.isNil(o.slots[0]) ? text(o.slots[1]) : text(o.slots[0]) + "/" + text(o.slots[1]);
                case TY_KW:
                    return Val.isNil(o.slots[0]) ? ":" + text(o.slots[1]) : ":" + text(o.slots[0]) + "/" + text(o.slots[1]);
                case TY_SEQ: return showJoin(o.slots, "(", ")");
                case TY_VEC: return showJoin(o.slots, "[", "]");
                case TY_SET: return showJoin(o.slots, "#{", "}");
                default: return "?";
            }
        }
        String showJoin(long[] xs, String open, String close) {
            StringBuilder sb = new StringBuilder(open);
            for (int i = 0; i < xs.length; i++) { if (i > 0) sb.append(' '); sb.append(hShow(xs[i])); }
            return sb.append(close).toString();
        }
    }

    // CROSS-MODULE free functions, exactly the ones `readcore.drivers`
    // duplicates for the same reason: this driver never compiles the module
    // that really defines them.
    static int codePoints(Rt rt, long s) {
        int c = rt.cpsOpen();
        long[] slots = rt.objs.get((int) s).slots;
        for (long cp : slots) rt.cpsPut(c, (int) Val.asFixnum(cp));
        return c;
    }
