        int sti = rt.Push(node);

        o.Append("init=L").Append(RdInt(rt, sti, RdsLine)).Append('C').Append(RdInt(rt, sti, RdsCol))
         .Append('P').Append(RdPos(rt, sti)).Append(' ');
