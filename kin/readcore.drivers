            bool has = MapContains(rt, tags, tk);
            long v = MapGet(rt, tags, tk, NotFound);
            bool matches = IsSym2(rt, v, "flint.table", "read-table");
            o.Append("tags1=").Append(B(has)).Append(B(matches)).Append(' ');
        }

