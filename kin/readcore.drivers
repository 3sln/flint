    static int b(boolean x) { return x ? 1 : 0; }
    static String bytesStr(int[] v) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < v.length; i++) { if (i > 0) sb.append(','); sb.append(v[i]); }
        return sb.toString();
    }
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();

        // THE TEXT -- see the Rust driver for the index-by-index layout.
        long src = rt.mkstr("#!x\nab,,; hi\ncde fgh\n");
        int srci = rt.push(src);
        long node = rdNew(rt, rt.r(srci), NIL, NIL, NIL, false, 0);
        int sti = rt.push(node);

        o.append("init=L").append(rdInt(rt, sti, RDS_LINE)).append('C').append(rdInt(rt, sti, RDS_COL))
         .append('P').append(rdPos(rt, sti)).append(' ');
        o.append("defer0=").append(b(rdFlag(rt, sti, RDS_DEFER))).append(" portable0=")
         .append(b(rdFlag(rt, sti, RDS_PORTABLE))).append(' ');
        {
            long tags = rdGet(rt, sti, RDS_TAGS);
            long tk = litSymbol(rt, "flint", "table");
            boolean has = mapContains(rt, tags, tk);
            long v = mapGet(rt, tags, tk, NOT_FOUND);
            boolean matches = isSym2(rt, v, "flint.table", "read-table");
            o.append("tags1=").append(b(has)).append(b(matches)).append(' ');
        }

        rdSkipWs(rt, sti);
        o.append("skip1=L").append(rdInt(rt, sti, RDS_LINE)).append('C').append(rdInt(rt, sti, RDS_COL))
         .append('P').append(rdPos(rt, sti)).append(' ');

        int from1 = rdToken(rt, sti);
        int to1 = rdPos(rt, sti);
        long t1 = rdString(rt, sti, from1, to1);
        o.append("tok1=").append(rt.text(t1)).append('@').append('P').append(to1).append('C')
         .append(rdInt(rt, sti, RDS_COL)).append(' ');

        rdSkipWs(rt, sti);
        o.append("skip2=L").append(rdInt(rt, sti, RDS_LINE)).append('C').append(rdInt(rt, sti, RDS_COL))
         .append('P').append(rdPos(rt, sti)).append(' ');

        int from2 = rdToken(rt, sti);
        int to2 = rdPos(rt, sti);
        long t2 = rdString(rt, sti, from2, to2);
        o.append("tok2=").append(rt.text(t2)).append('@').append('P').append(to2).append('C')
         .append(rdInt(rt, sti, RDS_COL)).append(' ');

        rdSkipWs(rt, sti);
        o.append("skip3=L").append(rdInt(rt, sti, RDS_LINE)).append('C').append(rdInt(rt, sti, RDS_COL))
         .append('P').append(rdPos(rt, sti)).append(' ');

        int from3 = rdToken(rt, sti);
        int to3 = rdPos(rt, sti);
        long t3 = rdString(rt, sti, from3, to3);
        o.append("tok3=").append(rt.text(t3)).append('@').append('P').append(to3).append('C')
         .append(rdInt(rt, sti, RDS_COL)).append(' ');

        rdSkipWs(rt, sti);
        boolean eof = rdPeek(rt, sti) == NO_CP;
        o.append("skip4=L").append(rdInt(rt, sti, RDS_LINE)).append('C').append(rdInt(rt, sti, RDS_COL))
         .append('P').append(rdPos(rt, sti)).append("EOF").append(b(eof)).append(' ');

        int st = rdFailLit(rt, sti, "unexpected eof");
        long msg = rdGet(rt, sti, RDS_ERRMSG);
        o.append("fail=st").append(st).append('|').append(rt.text(msg)).append('|')
         .append('L').append(rdInt(rt, sti, RDS_ERRLINE)).append('C').append(rdInt(rt, sti, RDS_ERRCOL))
         .append("|plain").append(b(rdFlag(rt, sti, RDS_ERRPLAIN))).append(' ');

        int sk1 = rt.sinkOpen(); sinkPutCp(rt, sk1, 65);
        int sk2 = rt.sinkOpen(); sinkPutCp(rt, sk2, 233);
        int sk3 = rt.sinkOpen(); sinkPutCp(rt, sk3, 8364);
        int sk4 = rt.sinkOpen(); sinkPutCp(rt, sk4, 0x10000);
        o.append("utf8=[").append(bytesStr(rt.sinkBytes(sk1))).append("][")
         .append(bytesStr(rt.sinkBytes(sk2))).append("][").append(bytesStr(rt.sinkBytes(sk3)))
         .append("][").append(bytesStr(rt.sinkBytes(sk4))).append("] ");

        long src2 = rt.mkstr("z");
        int src2i = rt.push(src2);
        long tk = litSymbol(rt, "flint", "table");
        int tki = rt.push(tk);
        long customv = litKeyword(rt, "custom", "foo");
        int cvi = rt.push(customv);
        long em = com.flint.rt.Maps.empty(rt);
        int emi = rt.push(em);
        long tags0 = mapAssoc(rt, rt.r(emi), rt.r(tki), rt.r(cvi));
        int tags0i = rt.push(tags0);
        long feat2 = Val.fixnum(1);
        long node2 = rdNew(rt, rt.r(src2i), NIL, feat2, rt.r(tags0i), true, 5);
        int sti2 = rt.push(node2);
        long tags2 = rdGet(rt, sti2, RDS_TAGS);
        long v2 = mapGet(rt, tags2, rt.r(tki), NOT_FOUND);
        o.append("rd2=defer").append(b(rdFlag(rt, sti2, RDS_DEFER))).append("portable")
         .append(b(rdFlag(rt, sti2, RDS_PORTABLE))).append("gensym").append(rdInt(rt, sti2, RDS_GENSYM_N))
         .append("same").append(b(valEq(rt, v2, rt.r(cvi)))).append("notdefault")
         .append(b(!isSym2(rt, v2, "flint.table", "read-table"))).append(' ');

        int mb = rt.mark();
        rt.refuse = true;
        long node3 = rdNew(rt, rt.r(src2i), NIL, NIL, NIL, false, 0);
        int ma = rt.mark();
        rt.refuse = false;
        o.append("refuse=nil").append(b(Val.isNil(node3))).append("roots").append(b(ma == mb));

        System.out.println(o.toString().trim());
    }
