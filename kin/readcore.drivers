    static int B(bool x) { return x ? 1 : 0; }
    static string BytesStr(int[] v) {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < v.Length; i++) { if (i > 0) sb.Append(','); sb.Append(v[i]); }
        return sb.ToString();
    }
    static void Main() {
        var rt = new Rt();
        var o = new System.Text.StringBuilder();

