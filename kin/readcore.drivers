         .Append('L').Append(RdInt(rt, sti, RdsErrline)).Append('C').Append(RdInt(rt, sti, RdsErrcol))
         .Append("|plain").Append(B(RdFlag(rt, sti, RdsErrplain))).Append(' ');

        int sk1 = rt.SinkOpen(); SinkPutCp(rt, sk1, 65);
        int sk2 = rt.SinkOpen(); SinkPutCp(rt, sk2, 233);
        int sk3 = rt.SinkOpen(); SinkPutCp(rt, sk3, 8364);
        int sk4 = rt.SinkOpen(); SinkPutCp(rt, sk4, 0x10000);
        o.Append("utf8=[").Append(BytesStr(rt.SinkBytes(sk1))).Append("][")
         .Append(BytesStr(rt.SinkBytes(sk2))).Append("][").Append(BytesStr(rt.SinkBytes(sk3)))
         .Append("][").Append(BytesStr(rt.SinkBytes(sk4))).Append("] ");

        long src2 = rt.Mkstr("z");
        int src2i = rt.Push(src2);
        long tk2 = LitSymbol(rt, "flint", "table");
        int tki = rt.Push(tk2);
        long customv = LitKeyword(rt, "custom", "foo");
        int cvi = rt.Push(customv);
        long em = global::Flint.Rt.Maps.Empty(rt);
        int emi = rt.Push(em);
        long tags0 = MapAssoc(rt, rt.R(emi), rt.R(tki), rt.R(cvi));
        int tags0i = rt.Push(tags0);
        long feat2 = Val.Fixnum(1);
        long node2 = RdNew(rt, rt.R(src2i), Nil, feat2, rt.R(tags0i), true, 5);
        int sti2 = rt.Push(node2);
        long tags2 = RdGet(rt, sti2, RdsTags);
        long v2 = MapGet(rt, tags2, rt.R(tki), NotFound);
        o.Append("rd2=defer").Append(B(RdFlag(rt, sti2, RdsDefer))).Append("portable")
         .Append(B(RdFlag(rt, sti2, RdsPortable))).Append("gensym").Append(RdInt(rt, sti2, RdsGensymN))
         .Append("same").Append(B(ValEq(rt, v2, rt.R(cvi)))).Append("notdefault")
         .Append(B(!IsSym2(rt, v2, "flint.table", "read-table"))).Append(' ');

        int mb = rt.Mark();
        rt.Refuse = true;
        long node3 = RdNew(rt, rt.R(src2i), Nil, Nil, Nil, false, 0);
        int ma = rt.Mark();
        rt.Refuse = false;
        o.Append("refuse=nil").Append(B(Val.IsNil(node3))).Append("roots").Append(B(ma == mb));

        System.Console.WriteLine(o.ToString().Trim());
    }
--expect
init=L1C1P3 defer0=1 portable0=0 tags1=11 skip1=L2C1P4 tok1=ab@P6C3 skip2=L3C1P13 tok2=cde@P16C4 skip3=L3C5P17 tok3=fgh@P20C8 skip4=L4C1P21EOF1 fail=st4|unexpected eof|L4C1|plain0 utf8=[65][195,169][226,130,172][240,144,128,128] rd2=defer0portable1gensym5same1notdefault1 refuse=nil1roots1
--expect-why
DERIVED BY HAND from `readcore.kin` against the fixture's text, laid out so
every index is checkable:

  0:'#' 1:'!' 2:'x' 3:'\n'                                  (a shebang line)
  4:'a' 5:'b' 6:',' 7:',' 8:';' 9:' ' 10:'h' 11:'i' 12:'\n'  (commas, a comment)
  13:'c' 14:'d' 15:'e' 16:' ' 17:'f' 18:'g' 19:'h' 20:'\n'

init=L1C1P3   `rd-new` sees `#!` at 0,1 and skips to the first `\n`, which is
              LEFT rather than consumed (`AGENTS.md`'s header: "every line
              number is the one an editor shows"): `start` stops AT index 3,
              not past it. Line/col are still 1,1 -- nothing has been read.

defer0=1 portable0=0   `features` is nil (a DEFERRED read) and `portable` is
              `false`, both threaded straight into their slots.

tags1=11      `flint/table` is absent from a nil tags map, so `rd-new` builds
              one, checks `map-contains` (0 -> the first digit would be 0),
              finds it missing, and `map-assoc`s `flint.table/read-table`
              under it (the second digit: `map-get` now answers that exact
              symbol). Both digits 1 is the only way the "unless the
              workspace binds it itself" default fires correctly.

skip1=L2C1P4  The first `rd-next` consumes the shebang's leftover `\n`: line
              2, column reset to 1, position 4 (`a`). This is the one call
              that proves the newline was left rather than eaten by `rd-new`
              itself -- if `rd-new` had already consumed it, this skip would
              stop at `L1C1P3` (nothing to skip) instead of moving at all.

tok1=ab@P6C3  `rd-token` runs `a`,`b` and stops at the first comma (`is-ws`
              includes 44, the comma) -- "ab", pos 6, col 3 (two `rd-next`s
              from col 1).

skip2=L3C1P13 Two commas (whitespace), then `;` opens a comment that "runs
              THROUGH its newline" -- the inner loop's own `rd-next` counts
              that `\n` (line 3, col 1) before the outer loop re-peeks and
              finds `c`, pos 13.

tok2=cde@P16C4   "cde", stopping at the space, pos 16, col 4.

skip3=L3C5P17    A single space, col 5, pos 17.

tok3=fgh@P20C8   "fgh", stopping at the trailing `\n` (`is-ws`, so the token
              loop breaks on it too without reading it) -- pos 20, col 8.

skip4=L4C1P21EOF1   This `\n` IS now consumed by `rd-skip-ws` (whitespace),
              landing on line 4, col 1, pos 21 = the text's length; the next
              `rd-peek` answers `NO_CP`, so EOF=1.

fail=st4|unexpected eof|L4C1|plain0   `rd-fail-lit` returns `RS_ERR` (4,
              `readconst.kin`), stores the literal message verbatim, and
              stamps the CURRENT line/col (4,1 -- exactly where `skip4` left
              the cursor) rather than some earlier position. `plain0`: this
              is the reader's OWN error, not `rd-fail-plain`'s unprefixed one.

utf8=[65][195,169][226,130,172][240,144,128,128]   `sink-put-cp` over one
              code point from each of its four branches:
                65     (<128)    ASCII, one byte:            65
                233 'é' (<2048)  two bytes:   192|(233>>6)=195, 128|(233&63)=169
                8364 '€' (<65536) three bytes: 224|2=226, 128|2=130, 128|44=172
                65536 (>=65536)  four bytes:  240|0=240, 128|16=144, 128|0=128, 128|0=128
              Each is the standard UTF-8 encoding of that code point (é is
              C3 A9, € is E2 82 AC, U+10000 is F0 90 80 80) -- this is the
              field a 16-bit truncation or an off-by-one in the shift amounts
              would move, and the four tiers are separate fields so a bug in
              one cannot hide behind the other three agreeing.

rd2=defer0portable1gensym5same1notdefault1   A second reader, over a
              one-character text, whose TAGS MAP ALREADY BINDS `flint/table`
              (to a keyword, `:custom/foo`) before the call: `defer0` (a
              non-nil `features`), `portable1` (`portable` true), `gensym5`
              (the `RDS_GENSYM_N` slot holds the given `gensym0` untouched),
              `same1` (the pre-existing binding under `flint/table` SURVIVES
              -- `map-contains` was true, so the default `assoc` never runs),
              `notdefault1` (and it is specifically NOT the
              `flint.table/read-table` default, so `same1` is not a vacuous
              pass against a value that happens to match both).

refuse=nil1roots1   A THIRD call, with the allocator switched to refuse:
              `rd-new` must answer nil (the node allocation failed) and leave
              the shadow stack exactly as it found it (`roots1` compares the
              mark before and after, not an absolute number) -- `rd-new`'s
              `(if (nil? rt node) (do (cps-close rt c) (pop-to rt base)
              (return NIL)))` arm, taken.
