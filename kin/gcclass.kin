;; WHICH FREE LIST A HOLE BELONGS TO.
;;
;; The old generation keeps `NCLASS` free lists, one per eight bytes of hole
;; size, and a hole too big for any of them goes on the last. So the class is
;; the size in eight-byte units, clamped.
;;
;; THE CLAMP IS THE WHOLE FUNCTION, and it is the half that a plausible
;; misreading gets wrong. `NCLASS` is 65 and the classes are 0..64, so the
;; boundary is `c >= NCLASS`, not `c > NCLASS`: a hole of 520 bytes is 65
;; eight-byte units, which is one PAST the last list, and belongs on it.
;; `.drivers` builds that case rather than a small one, because every size
;; below 512 lands on its own list whichever comparison is written.
;;
;; WRITTEN AS A SHIFT, not a division. `quot` is one of kin's `both-u32`
;; words -- correct for a 32-bit count and not for the `Addr` a hole size is
;; -- where `ushr64` is defined at the width the argument actually has. The
;; two agree for every size a heap can hold; the shift is the one that says
;; so in the source.
;;
;; THE COMPARISON IS INVERTED for the same reason. kin's `>=` is `both-u32`
;; too, so the 64-bit form is `ult64` and the branches swap: "below the last
;; class, use it; otherwise the last".
(ns flint.rt.gcclass
  (:require [flint.impl.rt :refer [defn return doc if ushr64 ult64 -
                                   NCLASS Addr I64]]))

(doc "The free list a hole of `size` bytes belongs on."
     ""
     "Answers `NCLASS - 1` for anything at or above `NCLASS * 8`, which is"
     "the list holding every hole too big to have one of its own.")
(defn ^:pub ^I64 gc-class-of [^Addr size]
  (if (ult64 (ushr64 size 3) NCLASS)
    (return (ushr64 size 3)))
  (return (- NCLASS 1)))
