    static final long NIL = 0xFFFFL;
    static final long TRUE = 0x2001L, FALSE = 0x2002L;
    static final int CAT_SCALAR = 0, CAT_SEQUENTIAL = 1;
    static final int TY_STR = 10, TY_KW = 11, TY_SYM = 12;
    static final int TY_VEC = 13, TY_CONS = 14, TY_OTHER = 15;
    static final class Val {
        static final long NIL = Probe.NIL;
        static final long TRUE = Probe.TRUE, FALSE = Probe.FALSE;
        static boolean isHeap(long v) { return v >= 100 && v < 0x100000000L && v != NIL; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
        static boolean isDouble(long v) { return (v >>> 32) == 2; }
        static boolean isBool(long v) { return v == TRUE || v == FALSE; }
    }
    static long num(long n) { return 0x100000000L | (n & 0xFFFFFFFFL); }
    static long dbl(long i) { return 0x200000000L | i; }
    static int sgn(int n) { return n < 0 ? -1 : n > 0 ? 1 : 0; }
    static final class Space { byte[] m = new byte[400]; }
    static final class Rt {
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        long bump = 100;
        long[][] slots = new long[400][2];
        int work = 0;
        String thrown = "";
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        void chargeWork(long n) { work += (int) n; }
        long slot_(long v, int i) { return slots[(int) v][i]; }
        long obj(int t) {
            long a = bump; bump += 1;
            gc.sp.m[(int) a] = (byte) t;
            slots[(int) a] = new long[]{ NIL, NIL };
            return a;
        }
        long throwStr(String cls, String msg) { thrown = cls + "/" + msg; return NIL; }
        long nameOf(long v) { return slot_(v, 1); }
        String describe(long v) {
            if (!Val.isHeap(v)) return "a scalar";
            return "a #" + ty(gc.sp, Val.asHeap(v));
        }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static String describe(Rt rt, long v) { return rt.describe(v); }
    static final class Num {
        static int cmp(Rt rt, long a, long b) {
            return sgn((int) (a & 0xFFFFFFFFL) - (int) (b & 0xFFFFFFFFL));
        }
    }
    static int strCmp(Rt rt, long a, long b) {
            return sgn((int) rt.slot_(a, 0) - (int) rt.slot_(b, 0));
        }
    static boolean isSymbol(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_SYM; }
    static long nsOf(Rt rt, long v) { return rt.slot_(v, 0); }
    static int category(Rt rt, long v) {
        if (Val.isHeap(v)) {
            int t = ty(rt.gc.sp, Val.asHeap(v));
            if (t == TY_VEC || t == TY_CONS) return CAT_SEQUENTIAL;
        }
        return CAT_SCALAR;
    }
    static long seq(Rt rt, long c) {
        int n = (int) rt.slot_(c, 0);
        return n == 0 ? NIL : 0xC000L + n;
    }
    static long first(Rt rt, long s) { return num(s - 0xC000L); }
    static long next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    static boolean isKeyword(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_KW; }
    static boolean isString(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_STR; }
    static boolean isNumber(Rt rt, long v) { return (v >>> 32) == 1 || Val.isDouble(v); }
