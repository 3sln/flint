    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();

        long d = dbl(1);
        o.append("id=").append(sgn(valCmp(rt, num(5), num(5))))
         .append(sgn(valCmp(rt, d, d))).append(' ');
        o.append("nil=").append(sgn(valCmp(rt, NIL, num(1))))
         .append(sgn(valCmp(rt, num(1), NIL))).append(sgn(valCmp(rt, NIL, NIL))).append(' ');
        o.append("num=").append(sgn(valCmp(rt, num(1), num(2))))
         .append(sgn(valCmp(rt, num(2), num(1)))).append(sgn(valCmp(rt, num(2), num(2)))).append(' ');
        o.append("bool=").append(sgn(valCmp(rt, FALSE, TRUE)))
         .append(sgn(valCmp(rt, TRUE, FALSE))).append(sgn(valCmp(rt, TRUE, TRUE)))
         .append(sgn(valCmp(rt, FALSE, FALSE))).append(' ');

        long s1 = rt.obj(TY_STR); rt.slots[(int) s1][0] = 5;
        long s2 = rt.obj(TY_STR); rt.slots[(int) s2][0] = 9;
        long s3 = rt.obj(TY_STR); rt.slots[(int) s3][0] = 5;
        o.append("str=").append(sgn(valCmp(rt, s1, s2)))
         .append(sgn(valCmp(rt, s2, s1))).append(sgn(valCmp(rt, s1, s3))).append(' ');

        long nsa = rt.obj(TY_STR); rt.slots[(int) nsa][0] = 1;
        long nsb = rt.obj(TY_STR); rt.slots[(int) nsb][0] = 2;
        long na = rt.obj(TY_STR); rt.slots[(int) na][0] = 3;
        long nb = rt.obj(TY_STR); rt.slots[(int) nb][0] = 4;
        long bare = rt.obj(TY_KW); rt.slots[(int) bare] = new long[]{ NIL, na };
        long bare2 = rt.obj(TY_KW); rt.slots[(int) bare2] = new long[]{ NIL, nb };
        long qual = rt.obj(TY_KW); rt.slots[(int) qual] = new long[]{ nsa, na };
        long qual2 = rt.obj(TY_KW); rt.slots[(int) qual2] = new long[]{ nsb, na };
        o.append("kw=").append(sgn(valCmp(rt, bare, qual)))
         .append(sgn(valCmp(rt, qual, bare))).append(sgn(valCmp(rt, bare, bare2)))
         .append(sgn(valCmp(rt, qual, qual2))).append(sgn(valCmp(rt, qual, qual))).append(' ');
        long sym = rt.obj(TY_SYM); rt.slots[(int) sym] = new long[]{ NIL, na };
        long sym2 = rt.obj(TY_SYM); rt.slots[(int) sym2] = new long[]{ NIL, nb };
        o.append("sym=").append(sgn(valCmp(rt, sym, sym2))).append(' ');

        long sa = rt.obj(TY_VEC);
        long sb = rt.obj(TY_VEC);
        rt.slots[(int) sa][0] = 3; rt.slots[(int) sb][0] = 3;
        rt.work = 0;
        o.append("seq=").append(sgn(valCmp(rt, sa, sb)))
         .append(" work=").append(rt.work).append(' ');
        rt.slots[(int) sa][0] = 2; rt.slots[(int) sb][0] = 3;
        o.append("short=").append(sgn(valCmp(rt, sa, sb))).append(' ');
        rt.slots[(int) sa][0] = 3; rt.slots[(int) sb][0] = 2;
        o.append("long=").append(sgn(valCmp(rt, sa, sb))).append(' ');
        rt.slots[(int) sa][0] = 0; rt.slots[(int) sb][0] = 0;
        o.append("empty=").append(sgn(valCmp(rt, sa, sb))).append(' ');

        rt.thrown = "";
        long k = rt.obj(TY_KW);
        long x = rt.obj(TY_OTHER);
        int c = valCmp(rt, k, x);
        o.append("bad=").append(c).append("|").append(rt.thrown).append("|");
        System.out.println(o.toString());
    }
