--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TRUE: Value = Value(0x2001); const FALSE: Value = Value(0x2002);
const CAT_SCALAR: u8 = 0; const CAT_SEQUENTIAL: u8 = 1;
const TY_STR: u8 = 10; const TY_KW: u8 = 11; const TY_SYM: u8 = 12;
const TY_VEC: u8 = 13; const TY_CONS: u8 = 14; const TY_OTHER: u8 = 15;
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { gc: Gc, bump: u64, roots: Vec<Value>, slots: Vec<[u64; 2]>,
            work: u32, thrown: String }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 < 0x1_0000_0000 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn is_double(self) -> bool { (self.0 >> 32) == 2 }
    fn is_bool(self) -> bool { self.0 == TRUE.0 || self.0 == FALSE.0 }
}
fn num(n: i64) -> Value { Value(0x1_0000_0000u64 | (n as u64 & 0xFFFF_FFFF)) }
fn dbl(i: u64) -> Value { Value(0x2_0000_0000u64 | i) }
fn sgn(n: i32) -> i32 { if n < 0 { -1 } else if n > 0 { 1 } else { 0 } }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn charge_work(&mut self, n: u64) { self.work += n as u32; }
    fn slot_(&self, v: Value, i: usize) -> Value { Value(self.slots[v.0 as usize][i]) }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 1;
        self.gc.sp.m[a as usize] = t;
        self.slots[a as usize] = [NIL.0, NIL.0];
        Value(a)
    }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn describe(&mut self, v: Value) -> alloc::string::String {
        if !v.is_heap() { return alloc::string::String::from("a scalar"); }
        alloc::format!("a #{}", ty(&self.gc.sp, v.as_heap()))
    }
    fn is_number(&mut self, v: Value) -> bool { (v.0 >> 32) == 1 || v.is_double() }
    // Ordered by the PAYLOAD, so the probe can assert a real order rather than
    // only that something was called.
    fn num_cmp(&mut self, a: Value, b: Value) -> i32 {
        sgn((a.0 & 0xFFFF_FFFF) as i64 as i32 - (b.0 & 0xFFFF_FFFF) as i64 as i32)
    }
    fn is_string(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_STR
    }
    // A STRING'S ORDER IS ITS SLOT, which is what lets the probe show that a
    // rope and a flat string of the same content compare equal -- the case
    // native got wrong by reading a rope's slots as UTF-8.
    fn str_cmp(&mut self, a: Value, b: Value) -> i32 {
        sgn(self.slot_(a, 0).0 as i32 - self.slot_(b, 0).0 as i32)
    }
    fn is_keyword(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_KW
    }
    fn is_symbol(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_SYM
    }
    // A named thing's ns is slot 0 and its name slot 1, each a STRING object.
    fn ns_of(&mut self, v: Value) -> Value { self.slot_(v, 0) }
    fn name_of(&mut self, v: Value) -> Value { self.slot_(v, 1) }
    fn category(&mut self, v: Value) -> u8 {
        if v.is_heap() {
            let t = ty(&self.gc.sp, v.as_heap());
            if t == TY_VEC || t == TY_CONS { return CAT_SEQUENTIAL; }
        }
        CAT_SCALAR
    }
    // Two seqs of settable length whose elements are NUMBERS, so a walk that
    // stops at the wrong place shows up as the wrong sign.
    fn seq(&mut self, c: Value) -> Value {
        let n = self.slot_(c, 0).0 as u32;
        if n == 0 { NIL } else { Value(0xC000 + n as u64) }
    }
    fn first(&mut self, s: Value) -> Value { num((s.0 - 0xC000) as i64) }
    fn next(&mut self, s: Value) -> Value {
        if s.0 == 0xC001 { NIL } else { Value(s.0 - 1) }
    }
}
impl Rt {
--rust
}
extern crate alloc;
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 400] } }, bump: 100,
                      roots: Vec::new(), slots: vec![[0u64; 2]; 400],
                      work: 0, thrown: String::new() };
    let mut o = String::new();

    // IDENTITY IS ZERO, EXCEPT FOR A DOUBLE: `compare` must agree with `=`
    // about NaN, which is not equal to itself.
    let d = dbl(1);
    o.push_str(&format!("id={}{} ", sgn(rt.val_cmp(num(5), num(5))),
                        sgn(rt.val_cmp(d, d))));
    // NIL SORTS FIRST.
    o.push_str(&format!("nil={}{}{} ", sgn(rt.val_cmp(NIL, num(1))),
                        sgn(rt.val_cmp(num(1), NIL)), sgn(rt.val_cmp(NIL, NIL))));
    // NUMBERS.
    o.push_str(&format!("num={}{}{} ", sgn(rt.val_cmp(num(1), num(2))),
                        sgn(rt.val_cmp(num(2), num(1))), sgn(rt.val_cmp(num(2), num(2)))));
    // BOOLEANS, and FALSE SORTS FIRST -- the arm that used to subtract two
    // unsigned bits and answer four billion for `false` against `true`.
    o.push_str(&format!("bool={}{}{}{} ", sgn(rt.val_cmp(FALSE, TRUE)),
                        sgn(rt.val_cmp(TRUE, FALSE)), sgn(rt.val_cmp(TRUE, TRUE)),
                        sgn(rt.val_cmp(FALSE, FALSE))));
    // STRINGS across tiers: equal content is 0 whichever objects they are.
    let s1 = rt.obj(TY_STR); rt.slots[s1.0 as usize][0] = 5;
    let s2 = rt.obj(TY_STR); rt.slots[s2.0 as usize][0] = 9;
    let s3 = rt.obj(TY_STR); rt.slots[s3.0 as usize][0] = 5;
    o.push_str(&format!("str={}{}{} ", sgn(rt.val_cmp(s1, s2)),
                        sgn(rt.val_cmp(s2, s1)), sgn(rt.val_cmp(s1, s3))));

    // NAMED THINGS: a BARE name sorts before a QUALIFIED one, then ns, then
    // name. The parts are strings, so this exercises the recursion.
    let nsa = rt.obj(TY_STR); rt.slots[nsa.0 as usize][0] = 1;
    let nsb = rt.obj(TY_STR); rt.slots[nsb.0 as usize][0] = 2;
    let na = rt.obj(TY_STR); rt.slots[na.0 as usize][0] = 3;
    let nb = rt.obj(TY_STR); rt.slots[nb.0 as usize][0] = 4;
    let bare = rt.obj(TY_KW); rt.slots[bare.0 as usize] = [NIL.0, na.0];
    let bare2 = rt.obj(TY_KW); rt.slots[bare2.0 as usize] = [NIL.0, nb.0];
    let qual = rt.obj(TY_KW); rt.slots[qual.0 as usize] = [nsa.0, na.0];
    let qual2 = rt.obj(TY_KW); rt.slots[qual2.0 as usize] = [nsb.0, na.0];
    o.push_str(&format!("kw={}{}{}{}{} ", sgn(rt.val_cmp(bare, qual)),
                        sgn(rt.val_cmp(qual, bare)), sgn(rt.val_cmp(bare, bare2)),
                        sgn(rt.val_cmp(qual, qual2)), sgn(rt.val_cmp(qual, qual))));
    let sym = rt.obj(TY_SYM); rt.slots[sym.0 as usize] = [NIL.0, na.0];
    let sym2 = rt.obj(TY_SYM); rt.slots[sym2.0 as usize] = [NIL.0, nb.0];
    o.push_str(&format!("sym={} ", sgn(rt.val_cmp(sym, sym2))));

    // SEQUENTIALS: element by element, and the SHORTER one first when one
    // runs out. Charged per element.
    // The LENGTH lives in the object, so `seq` reads it and two vectors can
    // differ in length without inventing addresses that are not objects.
    let sa = rt.obj(TY_VEC);
    let sb = rt.obj(TY_VEC);
    rt.slots[sa.0 as usize][0] = 3; rt.slots[sb.0 as usize][0] = 3;
    rt.work = 0;
    o.push_str(&format!("seq={} work={} ", sgn(rt.val_cmp(sa, sb)), rt.work));
    rt.slots[sa.0 as usize][0] = 2; rt.slots[sb.0 as usize][0] = 3;
    o.push_str(&format!("short={} ", sgn(rt.val_cmp(sa, sb))));
    rt.slots[sa.0 as usize][0] = 3; rt.slots[sb.0 as usize][0] = 2;
    o.push_str(&format!("long={} ", sgn(rt.val_cmp(sa, sb))));
    rt.slots[sa.0 as usize][0] = 0; rt.slots[sb.0 as usize][0] = 0;
    o.push_str(&format!("empty={} ", sgn(rt.val_cmp(sa, sb))));

    // ACROSS TYPES IT REFUSES, naming both sides, and answers 0 because there
    // is no failure value in an `int`.
    rt.thrown.clear();
    let k = rt.obj(TY_KW);
    let x = rt.obj(TY_OTHER);
    let c = rt.val_cmp(k, x);
    o.push_str(&format!("bad={}|{}|", c, rt.thrown));
    println!("{}", o);
}
