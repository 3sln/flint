    internal const long NIL = 0xFFFFL;
    internal const long TRUE = 0x2001L, FALSE = 0x2002L;
    internal const int CAT_SCALAR = 0, CAT_SEQUENTIAL = 1;
    internal static class Obj {
        internal const int TyStr = 10, TyKw = 11, TySym = 12;
        internal const int TyVec = 13, TyCons = 14, TyOther = 15;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal const long True = Probe.TRUE, False = Probe.FALSE;
        internal static bool IsHeap(long v) { return v >= 100 && v < 0x100000000L && v != NIL; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
        internal static bool IsDouble(long v) { return (v >> 32) == 2; }
        internal static bool IsBool(long v) { return v == TRUE || v == FALSE; }
    }
    internal static long Num_(long n) { return 0x100000000L | (n & 0xFFFFFFFFL); }
    internal static long Dbl(long i) { return 0x200000000L | i; }
    internal static int Sgn(int n) { return n < 0 ? -1 : n > 0 ? 1 : 0; }
    internal sealed class Space { internal byte[] m = new byte[400]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal long[,] slots = new long[400, 2];
        internal int work = 0;
        internal string thrown = "";
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal void ChargeWork(long n) { work += (int) n; }
        internal long Slot_(long v, int i) { return slots[(int) v, i]; }
        internal long Obj_(int t) {
            long a = bump; bump += 1;
            gc.sp.m[(int) a] = (byte) t;
            slots[(int) a, 0] = NIL; slots[(int) a, 1] = NIL;
            return a;
        }
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return NIL; }
        internal long NameOf(long v) { return Slot_(v, 1); }
        internal string Describe(long v) {
            if (!Val.IsHeap(v)) return "a scalar";
            return "a #" + Obj.Ty(gc.sp, Val.AsHeap(v));
        }
    }
    internal static string Describe(Rt rt, long v) { return rt.Describe(v); }
    internal static class Num {
        internal static int Cmp(Rt rt, long a, long b) {
            return Sgn((int) (a & 0xFFFFFFFFL) - (int) (b & 0xFFFFFFFFL));
        }
    }
    internal static int StrCmp(Rt rt, long a, long b) {
            return Sgn((int) rt.Slot_(a, 0) - (int) rt.Slot_(b, 0));
        }
    internal static bool IsSymbol(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TySym; }
    internal static long NsOf(Rt rt, long v) { return rt.Slot_(v, 0); }
    internal static int Category(Rt rt, long v) {
        if (Val.IsHeap(v)) {
            int t = Obj.Ty(rt.gc.sp, Val.AsHeap(v));
            if (t == Obj.TyVec || t == Obj.TyCons) return CAT_SEQUENTIAL;
        }
        return CAT_SCALAR;
    }
    internal static long Seq(Rt rt, long c) {
        int n = (int) rt.Slot_(c, 0);
        return n == 0 ? NIL : 0xC000L + n;
    }
    internal static long First(Rt rt, long s) { return Num_(s - 0xC000L); }
    internal static long Next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    internal static bool IsKeyword(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyKw; }
    internal static bool IsString(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyStr; }
    internal static bool IsNumber(Rt rt, long v) { return (v >> 32) == 1 || Val.IsDouble(v); }
