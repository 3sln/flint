--rust-head
// A TOY PORT, enough to drive its byte budget: a cap and a counter.
//
// `cas_slot` REALLY COMPARES, and it counts what it refused -- a stub that
// always succeeded would let every field here pass while hiding the only thing
// the loop is for. `steal` is how a single-threaded fixture models the race:
// set it, and the next compare-and-swap finds the counter already moved, as if
// another host thread had claimed in between.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
mod conc {
    pub const PT_CAP: u32 = 0;
    pub const PT_BYTES: u32 = 1;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
}
struct Rt { objs: Vec<Vec<Value>>, refused: u32, steal: i64 }
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn slot(&mut self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn slot_atomic(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn cas_slot(&mut self, v: Value, i: u32, want: Value, next: Value) -> bool {
        if self.steal != 0 {
            let cur = self.objs[v.0 as usize][i as usize].as_fixnum();
            self.objs[v.0 as usize][i as usize] = Value::fixnum(cur + self.steal);
            self.steal = 0;
        }
        if self.objs[v.0 as usize][i as usize] == want {
            self.objs[v.0 as usize][i as usize] = next;
            true
        } else {
            self.refused += 1;
            false
        }
    }
--rust
}
// `<result>:<bytes after>:<refusals>`, where result is 1/0 for a claim and
// `-` for a refund.
fn claim(cap: i64, start: i64, len: i64, steal: i64) -> String {
    let mut rt = Rt { objs: vec![], refused: 0, steal };
    let p = rt.obj(vec![Value::fixnum(cap), Value::fixnum(start)]);
    let ok = rt.claim_bytes(p, len);
    format!("{}:{}:{}", if ok { 1 } else { 0 },
            rt.slot_atomic(p, conc::PT_BYTES).as_fixnum(), rt.refused)
}
fn fits(queued: i64, len: i64, cap: i64) -> String {
    let mut rt = Rt { objs: vec![], refused: 0, steal: 0 };
    if rt.fits_in_budget(queued, len, cap) { "y".to_string() } else { "n".to_string() }
}
fn refund(start: i64, len: i64, steal: i64) -> String {
    let mut rt = Rt { objs: vec![], refused: 0, steal };
    let p = rt.obj(vec![Value::fixnum(1000), Value::fixnum(start)]);
    rt.give_back(p, len);
    format!("-:{}:{}", rt.slot_atomic(p, conc::PT_BYTES).as_fixnum(), rt.refused)
}
fn main() {
    let out = [
        claim(100, 0, 10, 0),
        claim(100, 10, 10, 0),
        claim(100, 95, 10, 0),
        claim(100, 0, 500, 0),
        claim(100, 90, 10, 0),
        claim(100, 0, 10, 7),
        refund(100, 30, 0),
        refund(10, 30, 0),
        refund(100, 30, 5),
        fits(0, 500, 100), fits(1, 500, 100), fits(90, 10, 100), fits(91, 10, 100),
    ];
    println!("{}", out.join(" "));
}
--java-head
    // THE SAME TOY, field for field.
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static long fixnum(long n) { return n; }
        static long asFixnum(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static final long NIL = 0xFFFF000000000000L;
    static final class Conc {
        static final int PT_CAP = 0, PT_BYTES = 1;
        static long slotAtomic(Rt rt, long v, int i) { return rt.objs.get((int) v)[i]; }
        static boolean casSlot(Rt rt, long v, int i, long want, long next) {
            long[] row = rt.objs.get((int) v);
            if (rt.steal != 0) { row[i] = row[i] + rt.steal; rt.steal = 0; }
            if (row[i] == want) { row[i] = next; return true; }
            rt.refused++;
            return false;
        }
    }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        int refused = 0;
        long steal = 0;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
    }
