;; The UNSIGNED comparison and division forms, and a standing check that they
;; still mean one thing in three languages.
;;
;; This source ships NOWHERE -- it has no `.targets` -- and exists only to be
;; verified. `kin/scripts/verify` compares the three outputs, so it is the natural
;; place to pin a claim about what a form MEANS rather than about what some
;; runtime function does.
;;
;; The claim: an `I32` is Rust's `u32` and the ports' signed `int`, so above
;; 2^31 the generic `<`, `>` and `quot` order and divide differently. Measured
;; with `0x80000001`:
;;
;;     (u< hi 5)     0 0 0     <- agrees, and is what Rust's `<` already meant
;;     (< hi 5)      0 1 1     <- DISAGREES: negative on the ports
;;
;; The second line is why these forms exist and is not in this file, because a
;; source that disagrees cannot pass. It is reproduced in
;; `doc/goals/kin-port.md`; what is pinned here is that the fix stays fixed.
(ns flint.rt.unsigned
  (:require [flint.impl.rt :refer [defn return < > <= >= quot rem
                                   Rt U32 Bool]]))

;; WRITTEN WITH THE PLAIN OPERATORS, and correct because the arguments carry
;; a `^U32` tag.
;;
;; This file used to say `u<`, `u>`, `u<=`, `u>=`, `uquot`, `urem` -- six
;; forms whose only job was to spell out what the generic operators could not
;; know. `flint.impl.rt` now reads its arguments' tags: two `U32`s get
;; `Integer.compareUnsigned` on the ports and a plain `<` in Rust, anything
;; else gets the plain operator on all three.
;;
;; The generated code is BYTE-IDENTICAL to what `u<` produced, and the three
;; runtimes still answer `0 1 1 0 715827883 0 | 1 14 2`. Retagging these
;; parameters `^I32` makes the ports disagree with Rust again, which is the
;; check that the tag is doing the work rather than the templates happening
;; to coincide.
(defn ^:method ^Bool ult [^Rt rt ^U32 a ^U32 b] (return (< a b)))
(defn ^:method ^Bool ugt [^Rt rt ^U32 a ^U32 b] (return (> a b)))
(defn ^:method ^Bool ule [^Rt rt ^U32 a ^U32 b] (return (<= a b)))
(defn ^:method ^Bool uge [^Rt rt ^U32 a ^U32 b] (return (>= a b)))
(defn ^:method ^U32 udiv [^Rt rt ^U32 a ^U32 b] (return (quot a b)))
(defn ^:method ^U32 umod [^Rt rt ^U32 a ^U32 b] (return (rem a b)))
