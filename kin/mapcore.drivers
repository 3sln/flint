--rust-head
type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const AM_BASE: u32 = 2; const AM_META: u32 = 0; const AM_HASH: u32 = 1;
const HM_CNT: u32 = 0; const HM_ROOT: u32 = 1; const HM_META: u32 = 2; const HM_HASH: u32 = 3;
const TY_ARRAYMAP: u8 = 14; const TY_HASHMAP: u8 = 15;
const TY_TABLEREF: u8 = 50;
mod table { pub const RF_SCHEMA: u32 = 0; } const TY_MAPENTRY: u8 = 20;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        // NIL-FILLED, as the real allocator does (`gc.zero_body` fills value
        // slots with NIL). Leaving them at 0 makes "this slot is absent" read
        // as present, because NIL is 0xFFFF -- and every target agrees on the
        // wrong answer, which is the one failure a three-way comparison cannot
        // catch. It hid `vec_pop`'s level collapse entirely.
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, n: Value) -> u32 { self.lens[n.0 as usize] }
    // A ref's schema is one slot away and its length is the column count.
    fn schema_len(&self, s: Value) -> u32 { self.h[s.0 as usize] as u32 }
}
// `ty` answers a u8 in the real runtime; the fixture says so too, because
// a driver that widens it compiles here and does not compile there.
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 400], gc: Gc { sp: vec![0u8; 400] }, lens: vec![0; 400],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    // An IMMEDIATE is not a map, and asking must not read the heap.
    o.push_str(&format!("{}{} ", rt.is_map(Value(5)) as u32, rt.is_array_map(Value(5)) as u32));
    let am = rt.new_array_map(3);
    let hm = rt.new_hash_map(7, Value(0xAAAA), Value(0xBBBB));
    let me = rt.map_entry(Value(0x11), Value(0x22));
    o.push_str(&format!("am={} hm={} me={} ", am.0, hm.0, me.0));
    // Each answers `is_map`; only the array map answers `is_array_map`.
    o.push_str(&format!("{}{}{} {}{}{} ",
        rt.is_map(am) as u32, rt.is_map(hm) as u32, rt.is_map(me) as u32,
        rt.is_array_map(am) as u32, rt.is_array_map(hm) as u32, rt.is_array_map(me) as u32));
    // A ROW REF answers `is_map` too, which is the whole point of the third tag.
    let refv = Value(300); rt.gc.sp[300] = TY_TABLEREF;
    rt.h[300] = 310; rt.h[310] = 4;          // ref -> schema -> 4 columns
    o.push_str(&format!("ref={} refcount={} ", rt.is_map(refv) as u32, rt.map_count(refv)));
    o.push_str(&format!("amcount={} hmcount={} ", rt.map_count(am), rt.map_count(hm)));
    // The constructors wrote what they should.
    o.push_str(&format!("ammeta={} amhash={} ", rt.slot(am, AM_META).0, rt.slot(am, AM_HASH).0));
    o.push_str(&format!("cnt={} root={} meta={} hash={} ",
        rt.slot(hm, HM_CNT).0, rt.slot(hm, HM_ROOT).0, rt.slot(hm, HM_META).0, rt.slot(hm, HM_HASH).0));
    o.push_str(&format!("k={} v={} ", rt.slot(me, 0).0, rt.slot(me, 1).0));
    // Indexed access into the array map's pairs.
    rt.set_slot(am.as_heap(), AM_BASE, Value(0x31));
    rt.set_slot(am.as_heap(), AM_BASE + 1, Value(0x32));
    rt.set_slot(am.as_heap(), AM_BASE + 2, Value(0x41));
    rt.set_slot(am.as_heap(), AM_BASE + 3, Value(0x42));
    o.push_str(&format!("k0={} v0={} k1={} v1={} ",
        rt.am_key(am, 0).0, rt.am_val(am, 0).0, rt.am_key(am, 1).0, rt.am_val(am, 1).0));
    // Out of heap: every constructor answers NIL and unwinds the stack.
    rt.starve = true;
    o.push_str(&format!("oom={},{},{} roots={}",
        rt.new_array_map(1).0, rt.new_hash_map(1, NIL, NIL).0, rt.map_entry(NIL, NIL).0,
        rt.roots.len()));
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFL;
    static final int AM_BASE = 2, AM_META = 0, AM_HASH = 1;
    static final int HM_CNT = 0, HM_ROOT = 1, HM_META = 2, HM_HASH = 3;
    static final int TY_ARRAYMAP = 14, TY_HASHMAP = 15, TY_TABLEREF = 50, TY_MAPENTRY = 20;
    static final class Val {
        static final long NIL = 0xFFFFL;
        static boolean isHeap(long v) { return v >= 100; }
        static long asHeap(long v) { return v; }
        static long fixnum(long n) { return n; }
        static long heap(long a) { return a; }
        static long asFixnum(long v) { return v; }
    }
    static final class Rt {
        long[] h = new long[400];
        static final class Gc { int[] sp = new int[400]; }
        Gc gc = new Gc();
        int[] lens = new int[400];
        long bump = 100;
        boolean starve = false;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;   // see the Rust head
            return a;
        }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int olen(Rt rt, long n) { return rt.lens[(int) n]; }
    static final class Table {
        static final int RF_SCHEMA = 0;
        static int schemaLen(Rt rt, long s) { return (int) rt.h[(int) s]; }
    }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        o.append(isMap(rt, 5) ? 1 : 0).append(isArrayMap(rt, 5) ? 1 : 0).append(' ');
        long am = newArrayMap(rt, 3);
        long hm = newHashMap(rt, 7, 0xAAAAL, 0xBBBBL);
        long me = mapEntry(rt, 0x11L, 0x22L);
        o.append("am=").append(am).append(" hm=").append(hm).append(" me=").append(me).append(' ');
        o.append(isMap(rt, am) ? 1 : 0).append(isMap(rt, hm) ? 1 : 0).append(isMap(rt, me) ? 1 : 0).append(' ');
        o.append(isArrayMap(rt, am) ? 1 : 0).append(isArrayMap(rt, hm) ? 1 : 0).append(isArrayMap(rt, me) ? 1 : 0).append(' ');
        rt.gc.sp[300] = TY_TABLEREF;
        rt.h[300] = 310; rt.h[310] = 4;
        o.append("ref=").append(isMap(rt, 300) ? 1 : 0).append(" refcount=").append(mapCount(rt, 300)).append(' ');
        o.append("amcount=").append(mapCount(rt, am)).append(" hmcount=").append(mapCount(rt, hm)).append(' ');
        o.append("ammeta=").append(rt.slot(am, AM_META)).append(" amhash=").append(rt.slot(am, AM_HASH)).append(' ');
        o.append("cnt=").append(rt.slot(hm, HM_CNT)).append(" root=").append(rt.slot(hm, HM_ROOT))
         .append(" meta=").append(rt.slot(hm, HM_META)).append(" hash=").append(rt.slot(hm, HM_HASH)).append(' ');
        o.append("k=").append(rt.slot(me, 0)).append(" v=").append(rt.slot(me, 1)).append(' ');
        rt.setSlot(Val.asHeap(am), AM_BASE, 0x31L);
        rt.setSlot(Val.asHeap(am), AM_BASE + 1, 0x32L);
        rt.setSlot(Val.asHeap(am), AM_BASE + 2, 0x41L);
        rt.setSlot(Val.asHeap(am), AM_BASE + 3, 0x42L);
        o.append("k0=").append(amKey(rt, am, 0)).append(" v0=").append(amVal(rt, am, 0))
         .append(" k1=").append(amKey(rt, am, 1)).append(" v1=").append(amVal(rt, am, 1)).append(' ');
        rt.starve = true;
        o.append("oom=").append(newArrayMap(rt, 1)).append(',').append(newHashMap(rt, 1, NIL, NIL))
         .append(',').append(mapEntry(rt, NIL, NIL)).append(" roots=").append(rt.roots.size());
        System.out.println(o);
    }
--csharp-head
    const long NIL = 0xFFFFL;
    const int AM_BASE = 2, AM_META = 0, AM_HASH = 1;
    const int HM_CNT = 0, HM_ROOT = 1, HM_META = 2, HM_HASH = 3;
    static class Obj {
        internal const int TyArraymap = 14, TyHashmap = 15, TyTableref = 50, TyMapentry = 20;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100; }
        internal static long AsHeap(long v) { return v; }
        internal static long Fixnum(long n) { return n; }
        internal static long Heap(long a) { return a; }
        internal static long AsFixnum(long v) { return v; }
    }
    internal sealed class Rt {
        internal long[] h = new long[400];
        internal sealed class GcT { internal int[] sp = new int[400]; }
        internal GcT gc = new GcT();
        internal int[] lens = new int[400];
        internal long bump = 100;
        internal bool starve = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;   // see the Rust head
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    static int Olen(Rt rt, long n) { return rt.lens[(int) n]; }
    // Nested to reproduce the port's FULLY QUALIFIED `Flint.Rt.Table`, which
    // the real C# needs because a `Table` member would shadow the class.
    internal static class Flint {
        internal static class Rt {
            internal static class Table {
                internal const int RF_SCHEMA = 0;
                internal static int schemaLen(Probe.Rt rt, long s) { return (int) rt.h[(int) s]; }
            }
        }
    }
--csharp
    static void Main() {
        var rt = new Rt();
        var o = new StringBuilder();
        o.Append(IsMap(rt, 5) ? 1 : 0).Append(IsArrayMap(rt, 5) ? 1 : 0).Append(' ');
        long am = NewArrayMap(rt, 3);
        long hm = NewHashMap(rt, 7, 0xAAAAL, 0xBBBBL);
        long me = MapEntry(rt, 0x11L, 0x22L);
        o.Append("am=").Append(am).Append(" hm=").Append(hm).Append(" me=").Append(me).Append(' ');
        o.Append(IsMap(rt, am) ? 1 : 0).Append(IsMap(rt, hm) ? 1 : 0).Append(IsMap(rt, me) ? 1 : 0).Append(' ');
        o.Append(IsArrayMap(rt, am) ? 1 : 0).Append(IsArrayMap(rt, hm) ? 1 : 0).Append(IsArrayMap(rt, me) ? 1 : 0).Append(' ');
        rt.gc.sp[300] = Obj.TyTableref;
        rt.h[300] = 310; rt.h[310] = 4;
        o.Append("ref=").Append(IsMap(rt, 300) ? 1 : 0).Append(" refcount=").Append(MapCount(rt, 300)).Append(' ');
        o.Append("amcount=").Append(MapCount(rt, am)).Append(" hmcount=").Append(MapCount(rt, hm)).Append(' ');
        o.Append("ammeta=").Append(rt.Slot(am, AM_META)).Append(" amhash=").Append(rt.Slot(am, AM_HASH)).Append(' ');
        o.Append("cnt=").Append(rt.Slot(hm, HM_CNT)).Append(" root=").Append(rt.Slot(hm, HM_ROOT))
         .Append(" meta=").Append(rt.Slot(hm, HM_META)).Append(" hash=").Append(rt.Slot(hm, HM_HASH)).Append(' ');
        o.Append("k=").Append(rt.Slot(me, 0)).Append(" v=").Append(rt.Slot(me, 1)).Append(' ');
        rt.SetSlot(Val.AsHeap(am), AM_BASE, 0x31L);
        rt.SetSlot(Val.AsHeap(am), AM_BASE + 1, 0x32L);
        rt.SetSlot(Val.AsHeap(am), AM_BASE + 2, 0x41L);
        rt.SetSlot(Val.AsHeap(am), AM_BASE + 3, 0x42L);
        o.Append("k0=").Append(AmKey(rt, am, 0)).Append(" v0=").Append(AmVal(rt, am, 0))
         .Append(" k1=").Append(AmKey(rt, am, 1)).Append(" v1=").Append(AmVal(rt, am, 1)).Append(' ');
        rt.starve = true;
        o.Append("oom=").Append(NewArrayMap(rt, 1)).Append(',').Append(NewHashMap(rt, 1, NIL, NIL))
         .Append(',').Append(MapEntry(rt, NIL, NIL)).Append(" roots=").Append(rt.roots.Count);
        Console.WriteLine(o.ToString());
    }
