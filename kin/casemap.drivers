    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        for (int cp : new int[]{0, 1, 97, 65, 223, 1000})
            o.append(caseMap(rt, cp, true)).append('/').append(caseMap(rt, cp, false)).append(' ');
        for (int cp : new int[]{0, 223, 1000})
            o.append(fullIndex(rt, cp, true)).append(',').append(fullIndex(rt, cp, false)).append(' ');
        System.out.println(o);
