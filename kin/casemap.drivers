--rust-head
struct Rt;
// the tables the generated code indexes. THE SIZE IS NOT FREE TO CHOOSE:
// `case-ranges-n` is a count accessor and inlines as a LITERAL, so the
// generated search carries the real table's length and a probe that supplied
// a shorter array would index past it.
static CASE_RANGES: [i32; 1528] = [0; 1528];
static CASE_FULL: [i32; 515] = [0; 515];
const CASE_UPPER_LEN: u32 = 200;
const CASE_FULL_UPPER_LEN: u32 = 102;
impl Rt {
--rust
}
fn main() {
    // WHAT THIS CHECKS is that three targets generated the SAME SEARCH, over
    // a table they all read the same way. It does not check the mapping is
    // right: the table here is zeros, so every answer below is a structural
    // one. Semantics are checked against real Clojure by the language suite,
    // which runs the actual table on all four runtimes.
    let rt = Rt;
    let mut o = String::new();
    for cp in [0u32, 1, 97, 65, 223, 1000] {
        o.push_str(&format!("{}/{} ", rt.case_map(cp, true), rt.case_map(cp, false)));
    }
    for cp in [0u32, 223, 1000] {
        o.push_str(&format!("{},{} ", rt.full_index(cp, true), rt.full_index(cp, false)));
    }
    println!("{}", o);
}
