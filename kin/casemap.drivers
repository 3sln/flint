--rust-head
struct Rt;
// the tables the generated code indexes. THE SIZE IS NOT FREE TO CHOOSE:
// `case-ranges-n`/`case-full-n` are count accessors and inline as LITERALS
// -- the real table's CURRENT row count, read from `kin/casetable.kin` at
// kin-generation time, not from anything this fixture declares -- so the
// generated search carries whatever that table says today, and a probe
// whose array is shorter indexes past it.
//
// THIS USED TO BE AN EXACT COPY of casetable's row count (1528 = 382 * 4,
// 515 = 103 * 5) -- a SECOND place that number lived, with nothing making
// the two agree. Pinning the Unicode version (`bin/casetable`'s own header)
// stopped the table moving on every host's JDK, but the table still grows
// when the PINNED version is deliberately bumped, so a copied exact size
// is still the wrong shape of fix. `kin/AGENTS.md` SS1: if two lists must
// exist, make one read the other -- here, instead, make the one list no
// longer need to be exact. 8192/2560 is headroom (5x the 1632/520 ints the
// real table needs at Unicode 18.0.0), not a tracked count: Unicode's entire
// cased-character budget would have to grow five-fold before this needs
// revisiting, which is a person's decision to make THEN, not a number to
// maintain NOW. CASE_UPPER_LEN/CASE_FULL_UPPER_LEN stay small, fixed,
// LOCAL fixture constants -- unlike the array sizes, kin does not inline
// `defconst`s, so these never see the real table's value at all, and the
// `--expect` answers below depend on exactly these two, not on the array
// capacity.
static CASE_RANGES: [i32; 8192] = [0; 8192];
static CASE_FULL: [i32; 2560] = [0; 2560];
const CASE_UPPER_LEN: u32 = 200;
const CASE_FULL_UPPER_LEN: u32 = 102;
impl Rt {
--rust
}
fn main() {
    // WHAT THIS CHECKS is that three targets generated the SAME SEARCH, over
    // a table they all read the same way. It does not check the mapping is
    // right: the table here is zeros, so every answer below is a structural
    // one. Semantics are checked against real Clojure by the language suite,
    // which runs the actual table on all four runtimes.
    let rt = Rt;
    let mut o = String::new();
    for cp in [0u32, 1, 97, 65, 223, 1000] {
        o.push_str(&format!("{}/{} ", rt.case_map(cp, true), rt.case_map(cp, false)));
    }
    for cp in [0u32, 223, 1000] {
        o.push_str(&format!("{},{} ", rt.full_index(cp, true), rt.full_index(cp, false)));
    }
    println!("{}", o);
}
