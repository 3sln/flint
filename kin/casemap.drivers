        var rt = new Rt();
        var o = new System.Text.StringBuilder();
        foreach (int cp in new int[]{0, 1, 97, 65, 223, 1000})
            o.Append(CaseMap(rt, cp, true)).Append('/').Append(CaseMap(rt, cp, false)).Append(' ');
