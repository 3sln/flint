    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long n = cnNew(rt, 0x80000001, 2, NIL);
        o.append(n).append(" hash=").append(cnHash(rt, n) & 0xFFFFFFFFL)
         .append(" count=").append(cnCount(rt, n)).append(' ');
        rt.setSlot(Val.asHeap(n), CN_BASE, 100);
        rt.setSlot(Val.asHeap(n), CN_BASE + 1, 101);
        rt.setSlot(Val.asHeap(n), CN_BASE + 2, 200);
        rt.setSlot(Val.asHeap(n), CN_BASE + 3, 201);
        o.append("k0=").append(cnKey(rt, n, 0)).append(" v0=").append(cnVal(rt, n, 0))
         .append(" k1=").append(cnKey(rt, n, 1)).append(" v1=").append(cnVal(rt, n, 1)).append(' ');
        rt.starve = true;
        o.append(" oom=").append(cnNew(rt, 1, 2, NIL)).append(" roots=").append(rt.roots.size());
        System.out.println(o);
    }
