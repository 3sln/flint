    static void Main() {
        var rt = new Rt();
        var o = new StringBuilder();
        long a0 = rt.Alloc(Obj.TyCollnode, 6);
        long n = Val.Heap(a0);
        o.Append("bm=").Append(IsBmnode(rt, n) ? 1 : 0)
         .Append(" sz=").Append(NodeSizeClass(rt, n)).Append(' ');
        long[][] maps = {new long[]{0, 0}, new long[]{2, 0}, new long[]{6, 0}, new long[]{0, 4}};
        foreach (long[] p in maps) {
            long a = rt.Alloc(Obj.TyBmnode, 8);
            rt.h[(int) a] = p[0]; rt.h[(int) a + 1] = p[1];
            o.Append(NodeSizeClass(rt, Val.Heap(a))).Append(',');
        }
        o.Append(" roots=").Append(rt.roots.Count);
        Console.WriteLine(o.ToString());
    }
