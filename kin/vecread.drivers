--rust-head
type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_NODE: u8 = 10; const TY_VEC: u8 = 11; const TY_MAPENTRY: u8 = 12;
const BITS: u32 = 5; const WIDTH: u32 = 32; const MASK: u32 = 31;
const V_CNT: u32 = 0; const V_SHIFT: u32 = 1; const V_ROOT: u32 = 2; const V_TAIL: u32 = 3;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        // NIL-FILLED, as the real allocator does (`gc.zero_body` fills value
        // slots with NIL). Leaving them at 0 makes "this slot is absent" read
        // as present, because NIL is 0xFFFF -- and every target agrees on the
        // wrong answer, which is the one failure a three-way comparison cannot
        // catch. It hid `vec_pop`'s level collapse entirely.
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.set_slot(v.as_heap(), i, x); }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, n: Value) -> u32 { self.lens[n.0 as usize] }
    // A vector's count, which the subject reaches as a SIBLING rather than a
    // template -- so the fixture has to supply it with the real signature.
    // `flint.rt.vecnode`, STUBBED. Each source is verified against stubs of
    // what it requires; `vecnode.drivers` verifies the real ones. The
    // signatures must match what kin generates for them, because that is the
    // only thing being asserted here.
    fn new_node(&mut self, n: u32, edit: Value) -> Value {
        let a = self.alloc(TY_NODE, n + 1);
        if a == 0 { return NIL; }
        self.set_slot(a, 0, edit);
        Value::heap(a)
    }
    fn node_len(&self, n: Value) -> u32 { self.olen(n) - 1 }
    fn node_get(&self, n: Value, i: u32) -> Value { self.slot(n, i + 1) }
    fn node_set(&mut self, n: Value, i: u32, v: Value) { self.set(n, i + 1, v); }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 4000], gc: Gc { sp: vec![0u8; 4000] }, lens: vec![0; 4000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();

    // --- node_clone: the three length relationships ------------------------
    let src = rt.new_node(4, NIL);
    for i in 0..4 { rt.node_set(src, i, Value(0x300 + i as u64)); }
    let same = rt.node_clone(src, 4, NIL);
    let wider = rt.node_clone(src, 6, NIL);
    let narrow = rt.node_clone(src, 2, NIL);
    o.push_str(&format!("same={},{},{},{} ", rt.node_get(same, 0).0, rt.node_get(same, 1).0,
                        rt.node_get(same, 2).0, rt.node_get(same, 3).0));
    o.push_str(&format!("wlen={} w4={} w5={} ", rt.node_len(wider), rt.node_get(wider, 3).0,
                        rt.node_get(wider, 5).0));
    o.push_str(&format!("nlen={} n0={} ", rt.node_len(narrow), rt.node_get(narrow, 0).0));
    // ZERO, which is the case both ports used to floor at one.
    let z = rt.node_clone(src, 0, NIL);
    o.push_str(&format!("zlen={} ", rt.node_len(z)));
    // The clone is a COPY: writing the original leaves it alone.
    rt.node_set(src, 0, Value(0x999));
    o.push_str(&format!("indep={} ", rt.node_get(same, 0).0));

    // --- tail_off, over the boundary --------------------------------------
    // A vector header built by hand: only cnt, shift, root and tail matter.
    let mkvec = |rt: &mut Rt, cnt: u32, shift: u32, root: Value, tail: Value| -> Value {
        let a = rt.alloc(6u8, 6);
        rt.set_slot(a, V_CNT, Value(cnt as u64));
        rt.set_slot(a, V_SHIFT, Value(shift as u64));
        rt.set_slot(a, V_ROOT, root);
        rt.set_slot(a, V_TAIL, tail);
        Value::heap(a)
    };
    let leaf = rt.new_node(WIDTH, NIL);
    for c in [0u32, 1, 31, 32, 33, 64, 1024, 1025] {
        let v = mkvec(&mut rt, c, BITS, leaf, leaf);
        o.push_str(&format!("{} ", rt.tail_off(v)));
    }
    o.push_str("| ");

    // --- array_for: inside the tail, and down one level --------------------
    // 33 elements: one full leaf in the trie, one element in the tail. A root
    // whose child 0 is the leaf, at shift BITS.
    let root = rt.new_node(WIDTH, NIL);
    rt.node_set(root, 0, leaf);
    let tail1 = rt.new_node(1, NIL);
    let v33 = mkvec(&mut rt, 33, BITS, root, tail1);
    o.push_str(&format!("toff33={} ", rt.tail_off(v33)));
    // Index 0 is under the trie; index 32 is the tail.
    o.push_str(&format!("a0={} a31={} a32={} ",
        (rt.array_for(v33, 0) == leaf) as u32,
        (rt.array_for(v33, 31) == leaf) as u32,
        (rt.array_for(v33, 32) == tail1) as u32));
    o.push_str(&format!("shift={} ", rt.vec_shift(v33)));
    // `nth` with a DEFAULT: in range, in the tail, and past the end.
    let leafv = Value(0x77);
    rt.node_set(leaf, 3, leafv);
    rt.node_set(tail1, 0, Value(0x88));
    o.push_str(&format!("n3={} n32={} nover={} ",
        rt.vec_nth(v33, 3, NIL).0, rt.vec_nth(v33, 32, NIL).0,
        rt.vec_nth(v33, 33, Value(0xDEAD)).0));
    // VECTOR-LIKE: a vector and a MAP ENTRY, and nothing else.
    let vecobj = Value::heap(rt.alloc(TY_VEC, 1));
    let entry = Value::heap(rt.alloc(TY_MAPENTRY, 1));
    let node = Value::heap(rt.alloc(TY_NODE, 1));
    o.push_str(&format!("veclike={}{}{}{} ",
        rt.is_vector_like(vecobj) as u32, rt.is_vector_like(entry) as u32,
        rt.is_vector_like(node) as u32, rt.is_vector_like(Value(1)) as u32));
    println!("{}", o);
}
