    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();

        long src = newNode(rt, 4, NIL);
        for (int i = 0; i < 4; i++) nodeSet(rt, src, i, 0x300 + i);
        long same = nodeClone(rt, src, 4, NIL);
        long wider = nodeClone(rt, src, 6, NIL);
        long narrow = nodeClone(rt, src, 2, NIL);
        o.append("same=").append(nodeGet(rt, same, 0)).append(',').append(nodeGet(rt, same, 1))
         .append(',').append(nodeGet(rt, same, 2)).append(',').append(nodeGet(rt, same, 3)).append(' ');
        o.append("wlen=").append(nodeLen(rt, wider)).append(" w4=").append(nodeGet(rt, wider, 3))
         .append(" w5=").append(nodeGet(rt, wider, 5)).append(' ');
        o.append("nlen=").append(nodeLen(rt, narrow)).append(" n0=").append(nodeGet(rt, narrow, 0)).append(' ');
        long z = nodeClone(rt, src, 0, NIL);
        o.append("zlen=").append(nodeLen(rt, z)).append(' ');
        nodeSet(rt, src, 0, 0x999);
        o.append("indep=").append(nodeGet(rt, same, 0)).append(' ');

        long leaf = newNode(rt, WIDTH, NIL);
        int[] counts = {0, 1, 31, 32, 33, 64, 1024, 1025};
        for (int c : counts) {
            long v = mkvec(rt, c, BITS, leaf, leaf);
            o.append(tailOff(rt, v)).append(' ');
        }
        o.append("| ");

        long root = newNode(rt, WIDTH, NIL);
        nodeSet(rt, root, 0, leaf);
        long tail1 = newNode(rt, 1, NIL);
        long v33 = mkvec(rt, 33, BITS, root, tail1);
        o.append("toff33=").append(tailOff(rt, v33)).append(' ');
        o.append("a0=").append(arrayFor(rt, v33, 0) == leaf ? 1 : 0)
         .append(" a31=").append(arrayFor(rt, v33, 31) == leaf ? 1 : 0)
         .append(" a32=").append(arrayFor(rt, v33, 32) == tail1 ? 1 : 0).append(' ');
        o.append("shift=").append(vecShift(rt, v33)).append(' ');
        nodeSet(rt, leaf, 3, 0x77);
        nodeSet(rt, tail1, 0, 0x88);
        o.append("n3=").append(vecNth(rt, v33, 3, NIL))
         .append(" n32=").append(vecNth(rt, v33, 32, NIL))
         .append(" nover=").append(vecNth(rt, v33, 33, 0xDEAD)).append(' ');
        // VECTOR-LIKE: a vector and a MAP ENTRY, and nothing else.
        long vecobj = Val.heap(rt.alloc(TY_VEC, 1));
        long entry = Val.heap(rt.alloc(TY_MAPENTRY, 1));
        long node = Val.heap(rt.alloc(TY_NODE, 1));
        o.append("veclike=").append(isVectorLike(rt, vecobj) ? 1 : 0)
         .append(isVectorLike(rt, entry) ? 1 : 0).append(isVectorLike(rt, node) ? 1 : 0)
         .append(isVectorLike(rt, 1L) ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
