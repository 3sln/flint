    static final class Rt {
        long[] h = new long[4000];
        static final class Gc { int[] sp = new int[4000]; }
        Gc gc = new Gc();
        int[] lens = new int[4000];
        long bump = 100;
        boolean starve = false;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;   // see the Rust head
            return a;
        }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int olen(Rt rt, long n) { return rt.lens[(int) n]; }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
    static final class Vec {
