    static boolean isInt(Rt rt, long v) { return tag(v) == 1; }
    static long integerValue(Rt rt, long v) { return rt.ints.get(idx(v)); }
    // The SAME spelling as Rust's `{:e}`, matching `strnum.drivers`'s own
    // `show`, so the formatting is not itself a source of disagreement.
    static String show(double d) {
        java.math.BigDecimal b = new java.math.BigDecimal(Double.toString(d));
        String digits = b.unscaledValue().abs().toString();
        while (digits.length() > 1 && digits.endsWith("0")) digits = digits.substring(0, digits.length() - 1);
        int exp = b.precision() - b.scale() - 1;
        if (b.unscaledValue().signum() == 0) { digits = "0"; exp = 0; }
        StringBuilder m = new StringBuilder();
        if (d < 0 || (d == 0.0 && 1 / d < 0)) m.append('-');
        m.append(digits.charAt(0));
        if (digits.length() > 1) m.append('.').append(digits, 1, digits.length());
        return m + "e" + exp;
    }
    static String showStatus(Rt rt, int sti, int st) {
        if (st == RS_OK) {
            long v = rt.roots.get(rt.roots.size() - 1);
            if (tag(v) == 1) return "i" + rt.ints.get(idx(v));
            return "d" + show(Double.longBitsToDouble(v));
        }
        if (st == RS_NONE) return "none";
        if (st == RS_ERR) return "err:" + rt.strs.get(idx(rt.readers.get(sti).errmsg));
        return "status" + st;
    }
