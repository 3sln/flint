    static void Main() {
        var rt = new Rt();
        var o = new System.Text.StringBuilder();
        string[] nums = { "42", "-42", "+5", "0", "0x1F", "-0x10", "1N", "7M",
                          "1.5", "-1.5", "1e3", "3.0", "99999999999999999999",
                          "1x", "0xZZ", "" };
        foreach (string t in nums) {
            int sti = rt.Mk(t);
            int len = rt.Readers[sti].Cps.Length;
            int st = ParseNumber(rt, sti, 0, len);
            o.Append(t).Append('=').Append(ShowStatus(rt, sti, st)).Append(' ');
        }

        int stiEmpty = rt.Mk("17");
        int stEmpty = ParseIntRadix(rt, stiEmpty, 0, 0, 10, false);
        o.Append("ir-empty=").Append(ShowStatus(rt, stiEmpty, stEmpty)).Append(' ');

        int stiOct = rt.Mk("17");
        int stOct = ParseIntRadix(rt, stiOct, 0, 2, 8, false);
        o.Append("ir-17-oct=").Append(ShowStatus(rt, stiOct, stOct)).Append(' ');

        int stiBad = rt.Mk("8");
        int stBad = ParseIntRadix(rt, stiBad, 0, 1, 8, false);
        o.Append("ir-8-oct=").Append(ShowStatus(rt, stiBad, stBad)).Append(' ');

        int stiMin = rt.Mk("9223372036854775808");
        int stMin = ParseIntRadix(rt, stiMin, 0, 19, 10, true);
        o.Append("ir-minneg=").Append(ShowStatus(rt, stiMin, stMin)).Append(' ');

        int stiOver = rt.Mk("9223372036854775808");
        int stOver = ParseIntRadix(rt, stiOver, 0, 19, 10, false);
        o.Append("ir-maxoverflow=").Append(ShowStatus(rt, stiOver, stOver));

        System.Console.WriteLine(o.ToString());
    }
--expect
42=i42 -42=i-42 +5=i5 0=i0 0x1F=i31 -0x10=i-16 1N=i1 7M=i7 1.5=d1.5e0 -1.5=d-1.5e0 1e3=d1e3 3.0=d3e0 99999999999999999999=err:integer overflow 1x=none 0xZZ=none =none ir-empty=none ir-17-oct=i15 ir-8-oct=none ir-minneg=i-9223372036854775808 ir-maxoverflow=err:integer overflow
--expect-why
DERIVED BY TRACING `readnum.kin`'s OWN TEXT against each input, not pasted
from a run.

`parse-number`:

  "42" "−42"      plain integers, decimal arm.                 i42 i-42
  "+5"            the integer arm consumes a leading `+` as well
                  as `-`; `neg` is only set for `-`.             i5
  "0"                                                            i0
  "0x1F"          hex, unsigned: `0x` with something after it
                  routes to `parse-int-radix ... 16 false`.      i31
  "-0x10"         HEX TAKES A SIGN, unlike `str->num` --
                  the header's whole point. `b` moves past the
                  `-` BEFORE the `0x` check, so the hex arm
                  still matches and runs with `neg = true`:
                  "10" in radix 16 is 16, negated is -16.        i-16
  "1N" "7M"       `N` and then `M` come off the end (each at
                  most once), leaving an all-digit body.         i1 i7
  "1.5"           not all-digit (has a `.`) -- falls to
                  `str->num`, which this probe's mock answers
                  1.5 for exactly this text.                     d1.5e0
  "-1.5"          same, with the sign STRIPPED by the integer
                  scan and then PUT BACK by the sink before the
                  digits -- so the mock sees "-1.5", not "1.5"
                  twice. Proves the resink is sign-correct.      d-1.5e0
  "1e3"           not all-digit (has `e`) -- str->num.          d1e3
  "3.0"           ALSO not all-digit -- str->num -- but this
                  probe's mock deliberately answers an INTEGER
                  (3) for this one text, a shape no real
                  `str->num` would give a token with a decimal
                  point. `parse-number` has a branch for exactly
                  this: "if is-int v, make it a double by
                  multiplying" -- `(integer-value v) as f64` is
                  3.0, printed the same as any other double.
                  Nothing else in this probe reaches that branch.  d3e0
  "99999999999999999999"
                  all-digit, decimal arm, and 20 digits is far
                  past 64 bits -- `parse-int-radix`'s own
                  overflow guard fires and the error is the
                  GUEST's, unprefixed: "integer overflow".
                  err:integer overflow
  "1x"            has a digit first but is not all-digit and
                  is not hex (no `0x`) -- falls to str->num,
                  whose mock answers nothing for "1x": none.      none
  "0xZZ"          hex-shaped, but 'Z' is not a hex digit, so
                  `parse-int-radix`'s OWN digit check answers
                  `RS_NONE` before ever reaching str->num --
                  not an error, a symbol.                         none
  ""              empty token, `from >= to` immediately.          none

`parse-int-radix`, direct calls reaching radixes and signs
`parse-number` never does on its own:

  ir-empty        `from == to == 0` -- `RS_NONE` regardless of
                  the radix or the text underneath.               none
  ir-17-oct       "17" read in radix 8: 1*8 + 7 = 15.             i15
  ir-8-oct        "8" read in radix 8: `hex-digit('8') = 8`,
                  which is `>= radix`, so `RS_NONE` -- not every
                  digit character is a digit of every radix.      none
  ir-minneg       "9223372036854775808" (2^63) in radix 10,
                  NEGATIVE: built downward one digit at a time
                  with `(i64::MIN + d) / radix` as the guard, it
                  lands exactly on `i64::MIN` without ever
                  overflowing -- the one value with no positive
                  counterpart, and the entire reason this
                  function accumulates on the negative side.
                  i-9223372036854775808
  ir-maxoverflow  the SAME text, POSITIVE this time: one past
                  `i64::MAX`, caught by the positive guard
                  `(i64::MAX - d) / radix` and reported the same
                  way as the all-nines case above.
                  err:integer overflow

Put in the exact order and with the exact separators the probe builds them,
the result is the line in `--expect`.
