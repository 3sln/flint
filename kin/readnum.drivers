--rust-head
// A TOY READER STATE: just the token's code points and an error slot, since
// `parse-int-radix` and `parse-number` only ever randomly-access the text
// through `rd-at` -- neither calls `rd-next`, so no cursor or line/column
// bookkeeping is needed to exercise them honestly.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_FFFF_FFFF_FFFF);
// NAN-BOXED, the same scheme `strnum.drivers` uses, so `of-double` (a bare
// bit-reinterpretation with no runtime) needs no case of its own.
const BOX: u64 = 0xFFF8_0000_0000_0000;
const RS_OK: u32 = 0;
const RS_NONE: u32 = 2;
const RS_ERR: u32 = 4;
struct Reader { cps: Vec<u32>, errmsg: Value }
struct Rt { ints: Vec<i64>, strs: Vec<String>, roots: Vec<Value>,
           readers: Vec<Reader>, sinks: Vec<Vec<u32>> }
impl Value {
    fn boxed(self) -> bool { (self.0 & BOX) == BOX }
    fn tag(self) -> u64 { if self.boxed() { (self.0 >> 32) & 0xFF } else { 9 } }
    fn idx(self) -> usize { (self.0 & 0xFFFF_FFFF) as usize }
    // `of-double` takes no runtime, so the generated Rust spells it as this
    // associated function rather than a method.
    fn from_f64(d: f64) -> Value { Value(d.to_bits()) }
}
fn is_digit(c: u32) -> bool { (c >= 48) && (c <= 57) }
fn hex_digit(c: u32) -> u32 {
    if (c >= 48) && (c <= 57) { return c - 48; }
    if (c >= 97) && (c <= 102) { return c - 87; }
    if (c >= 65) && (c <= 70) { return c - 55; }
    16
}
impl Rt {
    fn reader(&mut self, text: &str) -> usize {
        self.readers.push(Reader { cps: text.chars().map(|c| c as u32).collect(), errmsg: NIL });
        self.readers.len() - 1
    }
    fn rd_at(&self, sti: usize, i: u32) -> u32 { self.readers[sti].cps[i as usize] }
    fn string(&mut self, s: &str) -> Value { self.strs.push(String::from(s)); Value(BOX | (3u64 << 32) | (self.strs.len() - 1) as u64) }
    fn integer(&mut self, n: i64) -> Value { self.ints.push(n); Value(BOX | (1u64 << 32) | (self.ints.len() - 1) as u64) }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn rd_fail_plain(&mut self, sti: usize, msg: Value) -> u32 { self.readers[sti].errmsg = msg; RS_ERR }
    fn sink_open(&mut self) -> u32 { self.sinks.push(Vec::new()); (self.sinks.len() - 1) as u32 }
    fn sink_put(&mut self, sk: u32, c: u32) { self.sinks[sk as usize].push(c); }
    fn sink_put_cp(&mut self, sk: u32, c: u32) { self.sinks[sk as usize].push(c); }
    fn sink_string(&mut self, sk: u32) -> Value {
        let s: String = self.sinks[sk as usize].iter().map(|&c| char::from_u32(c).unwrap()).collect();
        self.string(&s)
    }
    fn sink_close(&mut self, sk: u32) { self.sinks.truncate(sk as usize); }
    // MOCKED MINIMALLY AND DETERMINISTICALLY: a fixed table over the exact
    // texts this probe builds, not a general parser -- so there is no risk
    // of the three hosts' float parsers disagreeing with EACH OTHER about
    // syntax `strnum.kin` was never asked to accept. "3.0" answers an
    // INTEGER on purpose: no real `str->num` would do that for a token with
    // a decimal point, but `parse-number` has a branch for exactly this
    // shape of answer (`if is-int v, make it a double by multiplying`) and
    // nothing else here reaches it.
    fn str_to_num(&mut self, v: Value) -> Value {
        let s = self.strs[v.idx()].clone();
        match s.as_str() {
            "1.5" => Value(1.5f64.to_bits()),
            "-1.5" => Value((-1.5f64).to_bits()),
            "1e3" => Value(1000.0f64.to_bits()),
            "3.0" => self.integer(3),
            _ => NIL,
        }
    }
    fn is_number(&self, v: Value) -> bool { (v != NIL) && ((v.tag() == 1) || (v.tag() == 9)) }
    fn is_int(&self, v: Value) -> bool { v.tag() == 1 }
    fn integer_value(&self, v: Value) -> i64 { self.ints[v.idx()] }
}
// `status` as text: the pushed value for `RS_OK`, `none` for `RS_NONE`, and
// the captured error message for `RS_ERR` -- so a wrong message is visible
// here exactly as it would be to a caller.
fn show_status(rt: &mut Rt, sti: usize, st: u32) -> String {
    if st == RS_OK {
        let v = rt.roots[rt.roots.len() - 1];
        if v.tag() == 1 { format!("i{}", rt.ints[v.idx()]) }
        else { format!("d{:e}", f64::from_bits(v.0)) }
    } else if st == RS_NONE {
        String::from("none")
    } else if st == RS_ERR {
        format!("err:{}", rt.strs[rt.readers[sti].errmsg.idx()])
    } else {
        format!("status{}", st)
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { ints: Vec::new(), strs: Vec::new(), roots: Vec::new(),
                      readers: Vec::new(), sinks: Vec::new() };
    let mut o = String::new();

    // `parse-number`, end to end, over the tokens the reader itself can
    // meet: signed and unsigned integers, signed hex, `N`/`M` dropped,
    // everything that falls to `str->num` (including the forced
    // int-to-double branch), the overflow error, and three non-numbers.
    let nums = ["42", "-42", "+5", "0", "0x1F", "-0x10", "1N", "7M",
               "1.5", "-1.5", "1e3", "3.0", "99999999999999999999",
               "1x", "0xZZ", ""];
    for t in nums {
        let sti = rt.reader(t);
        let len = rt.readers[sti].cps.len() as u32;
        let st = rt.parse_number(sti, 0, len);
        let shown = show_status(&mut rt, sti, st);
        o.push_str(&format!("{}={} ", t, shown));
    }

    // `parse-int-radix` DIRECTLY, for the radixes and signs `parse-number`
    // never reaches by itself (it only ever calls radix 10 or 16): an empty
    // range, an invalid digit of the radix, and -- the reason this function
    // builds downward at all -- the most negative `i64` on the negative
    // side, reachable, against one past the positive side, which is not.
    let sti_empty = rt.reader("17");
    let st_empty = rt.parse_int_radix(sti_empty, 0, 0, 10, false);
    o.push_str(&format!("ir-empty={} ", show_status(&mut rt, sti_empty, st_empty)));

    let sti_oct = rt.reader("17");
    let st_oct = rt.parse_int_radix(sti_oct, 0, 2, 8, false);
    o.push_str(&format!("ir-17-oct={} ", show_status(&mut rt, sti_oct, st_oct)));

    let sti_bad = rt.reader("8");
    let st_bad = rt.parse_int_radix(sti_bad, 0, 1, 8, false);
    o.push_str(&format!("ir-8-oct={} ", show_status(&mut rt, sti_bad, st_bad)));

    let sti_min = rt.reader("9223372036854775808");
    let st_min = rt.parse_int_radix(sti_min, 0, 19, 10, true);
    o.push_str(&format!("ir-minneg={} ", show_status(&mut rt, sti_min, st_min)));

    let sti_over = rt.reader("9223372036854775808");
    let st_over = rt.parse_int_radix(sti_over, 0, 19, 10, false);
    o.push_str(&format!("ir-maxoverflow={}", show_status(&mut rt, sti_over, st_over)));

    println!("{}", o);
}
