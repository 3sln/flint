    // MOCKED MINIMALLY AND DETERMINISTICALLY, over the exact texts this
    // probe builds -- see the Rust head for why "3.0" answers an integer.
    static long strToNum(Rt rt, long v) {
        String s = rt.strs.get(idx(v));
        switch (s) {
            case "1.5": return Double.doubleToRawLongBits(1.5);
            case "-1.5": return Double.doubleToRawLongBits(-1.5);
            case "1e3": return Double.doubleToRawLongBits(1000.0);
            case "3.0": return Num.integer(rt, 3);
            default: return NIL;
        }
    }
