    // drops the head. `first-foreign-key` walks one.
    fn entry(&mut self, k: Value, v: Value) -> Value {
        let a = self.alloc(TY_MAPENTRY, 2);
        self.h[a as usize] = k.0; self.h[a as usize + 1] = v.0;
        Value::heap(a)
