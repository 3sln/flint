            i += 2;
        }
        dflt
    }
    fn schema_width_of(&mut self, s: Value) -> u32 {
        self.slot(s, table::SC_WIDTH).as_fixnum() as u32
    }
    fn kw_name(&mut self, v: Value) -> alloc::string::String { self.kw_text_of(v) }
