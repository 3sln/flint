    static void collapse(Rt rt, long ch, int id) {
        long col = rt.slot(ch, Table.CH_BASE + id);
        int n = rt.lens[(int) col];
        if (n == 0) return;
        long first = rt.slot(col, 0);
        for (int k = 1; k < n; k++) if (rt.slot(col, k) != first) return;
        rt.set(ch, Table.CH_BASE + id, first);
        rt.set(rt.slot(ch, Table.CH_ENC), id, Val.fixnum(1));
    }
    static int schemaIdAt(Rt rt, long s, int c) {
        return (int) Val.asFixnum(Vec.nth(rt, rt.slot(s, Table.SC_IDS), c, NIL));
    }
    static boolean typeOk(Rt rt, long t, long v) {
        String s = Str.text(rt, rt.nameOf(t));
        if (s.equals("any")) return true;
        if (s.equals("int")) return Val.isFixnum(v);
        if (s.equals("string")) return Str.isString(rt, v);
        return false;
    }
    static String columnTypeError(Rt rt, long name, long want, long got, int row) {
        return "row " + row + ", column :" + kwTextOf(rt, name) + " holds :"
             + kwTextOf(rt, want) + " and was given a " + kwTextOf(rt, kindOf(rt, got));
    }
    static int chunkEnc(Rt rt, long ch, int id) {
        return (int) Val.asFixnum(rt.slot(rt.slot(ch, Table.CH_ENC), id));
    }
    static long cell(Rt rt, long ch, int id, int row) {
        long col = rt.slot(ch, Table.CH_BASE + id);
        return chunkEnc(rt, ch, id) == 1 ? col : rt.slot(col, row);
    }
    static String showTable(Rt rt, long t, int ncols) {
        long chunks = rt.slot(t, Table.TB_CHUNKS);
        StringBuilder out = new StringBuilder();
        for (int w = 0; w < vecCount(rt, chunks); w++) {
            if (w > 0) out.append(';');
            long ch = rt.slot(chunks, w);
            int rows = (int) Val.asFixnum(rt.slot(ch, Table.CH_ROWS));
            for (int id = 0; id < ncols; id++) {
                if (id > 0) out.append(',');
                out.append(chunkEnc(rt, ch, id)).append('[');
                for (int r = 0; r < rows; r++) {
                    if (r > 0) out.append('.');
                    long v = cell(rt, ch, id, r);
                    out.append(Val.isKw(v) ? kwTextOf(rt, v)
                             : Val.isName(v) ? Str.text(rt, v)
                             : String.valueOf(Val.asFixnum(v)));
                }
                out.append(']');
            }
        }
        return Val.asFixnum(rt.slot(t, Table.TB_COUNT)) + "|" + out;
    }
