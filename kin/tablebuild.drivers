        Value::kw(self.names.len() as u32 - 1)
    }
    fn name_of(&mut self, v: Value) -> Value {
        if v.is_kw() { Value::name(v.idx()) } else { NIL }
    }
    fn is_string(&self, v: Value) -> bool { v.is_name() }
    fn value_text(&mut self, v: Value) -> alloc::string::String {
