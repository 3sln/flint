    }
    fn show_vec(&mut self, v: Value) -> alloc::string::String {
        let n = self.vec_count(v);
        let mut out = alloc::vec::Vec::new();
        for i in 0..n {
            let x = self.slot(v, i);
            out.push(if x.is_kw() { self.kw_text_of(x) }
                     else { alloc::format!("{}", x.as_fixnum()) });
