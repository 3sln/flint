    static long newChunk(Rt rt, int width, int rows) {
        long ch = newObj(rt, TY_VEC, Table.CH_BASE + width);
        rt.set(ch, Table.CH_ROWS, Val.fixnum(rows));
        long enc = newObj(rt, TY_VEC, width < 1 ? 1 : width);
        for (int id = 0; id < width; id++) rt.set(enc, id, Val.fixnum(0));
        rt.set(ch, Table.CH_ENC, enc);
