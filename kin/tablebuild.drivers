        if n == 0 { return NIL; }
        let mut es = alloc::vec::Vec::new();
        let mut i = 0;
        while i < n {
            let (k, v) = (self.slot(m, i), self.slot(m, i + 1));
            let e = self.entry(k, v);
            es.push(e);
            i += 2;
        }
        self.vector(&es)
    }
    fn first(&mut self, q: Value) -> Value { self.vec_nth(q, 0, NIL) }
    fn next(&mut self, q: Value) -> Value {
        let n = self.vec_count(q);
        if n <= 1 { return NIL; }
        let rest: alloc::vec::Vec<Value> = (1..n).map(|i| self.slot(q, i)).collect();
        self.vector(&rest)
    }
    fn throw_str(&mut self, _kind: &str, msg: &alloc::string::String) -> Value {
        self.thrown = msg.clone();
        NIL
    }
    fn charge_work(&mut self, _n: u64) {}
    // The siblings from `tablemeta`, `tableref` and `tablecell`.
    fn schema_len(&self, s: Value) -> u32 { self.vec_count(self.slot(s, table::SC_NAMES)) }
    fn schema_width(&mut self, s: Value) -> u32 { self.slot(s, table::SC_WIDTH).as_fixnum() as u32 }
    fn schema_id(&mut self, s: Value, name: Value) -> u32 {
        let idx = self.slot(s, table::SC_INDEX);
        let n = self.lens[idx.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(idx, i).0 == name.0 { return self.slot(idx, i + 1).as_fixnum() as u32; }
            i += 2;
        }
        self.schema_width(s)
    }
    fn is_table_ref(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_TABLEREF
    }
    fn row_column(&mut self, s: Value, row: Value, c: u32) -> Value {
        let name = self.schema_name_at(s, c);
        let n = self.lens[row.0 as usize];
        let mut i = 0;
        while i < n {
