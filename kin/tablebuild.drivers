extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_SCHEMA: u8 = 48; const TY_TABLEREF: u8 = 50; const TY_TABLE: u8 = 49;
const TY_NODE: u8 = 12;
const TY_VEC: u8 = 9; const TY_MAP: u8 = 14; const TY_MAPENTRY: u8 = 15;
pub mod table {
    pub const CH_ROWS: u32 = 0; pub const CH_ENC: u32 = 1;
    pub const TB_SCHEMA: u32 = 0; pub const TB_CHUNKS: u32 = 1;
    pub const TB_COUNT: u32 = 2; pub const TB_OFFSET: u32 = 3;
    pub const TB_LEN: u32 = 4; pub const CH_BASE: u32 = 2;
    pub const CHUNK: u32 = 4;
    pub const SC_NAMES: u32 = 0; pub const SC_TYPES: u32 = 1; pub const SC_INDEX: u32 = 2;
    pub const SC_IDS: u32 = 3; pub const SC_WIDTH: u32 = 4; pub const SC_LEN: u32 = 5;
    pub const RF_SCHEMA: u32 = 0; pub const RF_LEN: u32 = 3;
}
// A KEYWORD IS A TAGGED INDEX into a host name table, and the "string" that is
// its name is the same index under a different tag. The probe never needs
// string BYTES -- `kw-name` asks a keyword for its name and a name for its
// text, and both are one lookup -- so modelling them as heap objects would be
// machinery the fixture does not exercise.
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != NOT_FOUND.0
                               && (self.0 >> 60) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn kw(i: u32) -> Value { Value((0xAu64 << 60) | i as u64) }
    fn is_kw(self) -> bool { (self.0 >> 60) == 0xA }
    fn name(i: u32) -> Value { Value((0xBu64 << 60) | i as u64) }
    fn is_name(self) -> bool { (self.0 >> 60) == 0xB }
    fn idx(self) -> u32 { (self.0 & 0xFFFF) as u32 }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>,
            names: Vec<alloc::string::String>, thrown: alloc::string::String,
            gas: u64 }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn obj(&mut self, t: u8, n: u32) -> Value { let a = self.alloc(t, n); Value::heap(a) }
