}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      names: Vec::new(), thrown: alloc::string::String::new(),
                      gas: 1000 };
    let mut o = String::new();
    let ka = rt.keyword("a"); let kb = rt.keyword("b");
    let tint = rt.keyword("int"); let tstr = rt.keyword("string");
    let s = rt.schema(&[ka, kb], &[tint, tstr]);
    // `CHUNK` IS 4 IN THE PROBE, so six rows cross a chunk boundary and the
    // per-chunk charge is exercised twice.
    let hi = Value::name(rt.names.len() as u32);
    rt.names.push(alloc::string::String::from("hi"));
    let mut rows = alloc::vec::Vec::new();
    for i in 0..6i64 {
        let mut m = rt.empty_map();
        m = rt.map_assoc(m, ka, Value::fixnum(10 + i));
        m = rt.map_assoc(m, kb, hi);
        rows.push(m);
    }
    let rv = rt.vector(&rows);
    let t = rt.new_table(s, rv);
    let shown = rt.show_table(t, 2);
    o.push_str(&format!("rows={} ", shown));
    // FROM COLUMNS, the same table. `tables` step 9: the decoder builds this way
    // rather than making a map per row only to take it apart again.
    let c0: alloc::vec::Vec<Value> = (0..6i64).map(|i| Value::fixnum(10 + i)).collect();
    let col0 = rt.vector(&c0);
    let c1: alloc::vec::Vec<Value> = (0..6).map(|_| hi).collect();
    let col1 = rt.vector(&c1);
    let cols = rt.vector(&[col0, col1]);
    let t2 = rt.table_from_columns(s, cols, 6);
    let shown2 = rt.show_table(t2, 2);
    o.push_str(&format!("cols={} same={} ", shown2, (shown == shown2) as u32));
    // AN EMPTY TABLE has no chunks and counts nothing.
    let none = rt.empty_vec();
    let t3 = rt.new_table(s, none);
    let shown3 = rt.show_table(t3, 2);
    o.push_str(&format!("empty={} ", shown3));
    // THE VALUES ARE CHECKED, both ways in, and the refusal names row and
    // column. A decoder that skipped this would be a way to make a table that
    // is not closed.
    let mut badrow = rt.empty_map();
    badrow = rt.map_assoc(badrow, ka, hi);
    badrow = rt.map_assoc(badrow, kb, hi);
    let br = rt.vector(&[badrow]);
    rt.new_table(s, br);
    let m1 = rt.thrown.clone();
    let bc0 = rt.vector(&[hi]);
    let bc1 = rt.vector(&[hi]);
    let bcols = rt.vector(&[bc0, bc1]);
    rt.table_from_columns(s, bcols, 1);
    let m2 = rt.thrown.clone();
    o.push_str(&format!("bad=[{}][{}] ", m1, m2));
    // AND THE BUDGET BOUNDS THE OVERSHOOT AT ONE CHUNK, not one row.
    rt.gas = 1;
    let starved = rt.new_table(s, rv);
    o.push_str(&format!("starved={}", starved.is_nil() as u32));
    println!("{}", o);
}
