    static int schemaId(Rt rt, long s, long name) {
        long p = mapGet(rt, rt.slot(s, Table.SC_INDEX), name, NIL);
        return Val.isFixnum(p) ? (int) Val.asFixnum(p) : schemaWidth(rt, s);
    }
    static long refGet(Rt rt, long rf, long name, long dflt) {
        long s = rt.slot(rf, Table.RF_SCHEMA);
        int id = schemaId(rt, s, name);
        if (id >= schemaWidth(rt, s)) return dflt;
        return chunkGet(rt, rt.slot(rf, Table.RF_CHUNK), id,
                        (int) Val.asFixnum(rt.slot(rf, Table.RF_ROW)));
