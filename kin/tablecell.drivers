        return Val.heap(a);
    }
    static long obj(Rt rt, int t, int n) { return Val.heap(rt.alloc(t, n)); }
    static final class Conc {
        static long newObj(Rt rt, int t, int n) { return obj(rt, t, n); }
    }
    // `empty-map` is spelled FULLY QUALIFIED on `Maps`, for the same reason
