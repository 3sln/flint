    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        var T = typeof(global::Flint.Rt.Table);
        long ch = NewChunk(rt, 3, 7);
        long enc = rt.Slot(ch, global::Flint.Rt.Table.CH_ENC);
        o.Append("fresh=").Append(rt.lens[(int) ch]).Append(" rows=")
         .Append(Val.AsFixnum(rt.Slot(ch, global::Flint.Rt.Table.CH_ROWS))).Append(" encs=")
         .Append(Val.AsFixnum(rt.Slot(enc, 0))).Append(Val.AsFixnum(rt.Slot(enc, 1)))
         .Append(Val.AsFixnum(rt.Slot(enc, 2))).Append(' ');
        long zero = NewChunk(rt, 0, 4);
        o.Append("zerowide=").Append(rt.lens[(int) zero])
         .Append(" zencs=").Append(rt.lens[(int) rt.Slot(zero, global::Flint.Rt.Table.CH_ENC)]).Append(' ');
        long same = Obj2(rt, Obj.TyNode, 4);
        for (int k = 0; k < 4; k++) rt.Set(same, k, Val.Fixnum(7));
        long diff = Obj2(rt, Obj.TyNode, 4);
        for (int k = 0; k < 4; k++) rt.Set(diff, k, Val.Fixnum(k == 3 ? 8 : 7));
        long none = Obj2(rt, Obj.TyNode, 0);
        rt.lens[(int) none] = 0;
        long c2 = NewChunk(rt, 3, 4);
        rt.Set(c2, global::Flint.Rt.Table.CH_BASE, same);
        rt.Set(c2, global::Flint.Rt.Table.CH_BASE + 1, diff);
        rt.Set(c2, global::Flint.Rt.Table.CH_BASE + 2, none);
        Collapse(rt, c2, 0); Collapse(rt, c2, 1); Collapse(rt, c2, 2);
        long e2 = rt.Slot(c2, global::Flint.Rt.Table.CH_ENC);
        o.Append("enc=").Append(Val.AsFixnum(rt.Slot(e2, 0))).Append(Val.AsFixnum(rt.Slot(e2, 1)))
         .Append(Val.AsFixnum(rt.Slot(e2, 2)))
         .Append(" const=").Append(Val.AsFixnum(rt.Slot(c2, global::Flint.Rt.Table.CH_BASE))).Append(' ');
        o.Append("read=");
        for (int k = 0; k < 4; k++) { if (k > 0) o.Append('.'); o.Append(Val.AsFixnum(ChunkGet(rt, c2, 0, k))); }
        o.Append('/');
        for (int k = 0; k < 4; k++) { if (k > 0) o.Append('.'); o.Append(Val.AsFixnum(ChunkGet(rt, c2, 1, k))); }
        o.Append(' ');
        long na = Val.Fixnum(101), nb = Val.Fixnum(102), missing = Val.Fixnum(199);
        long sch = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(sch, global::Flint.Rt.Table.SC_NAMES, Vector(rt, new long[]{na, nb}));
        rt.Set(sch, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(2));
        long idx = EmptyMap(rt);
        idx = MapAssoc(rt, idx, na, Val.Fixnum(0));
        idx = MapAssoc(rt, idx, nb, Val.Fixnum(1));
        rt.Set(sch, global::Flint.Rt.Table.SC_INDEX, idx);
        o.Append("pos=").Append(SchemaPosOf(rt, sch, na)).Append('.')
         .Append(SchemaPosOf(rt, sch, nb)).Append('.')
         .Append(SchemaPosOf(rt, sch, missing)).Append(' ');
        long row = EmptyMap(rt);
        row = MapAssoc(rt, row, na, Val.Fixnum(41));
        row = MapAssoc(rt, row, nb, Val.Fixnum(42));
        long rf = Obj2(rt, Obj.TyTableref, global::Flint.Rt.Table.RF_LEN);
        long rch = NewChunk(rt, 2, 1);
        long col0 = Obj2(rt, Obj.TyNode, 1); rt.Set(col0, 0, Val.Fixnum(41));
        long col1 = Obj2(rt, Obj.TyNode, 1); rt.Set(col1, 0, Val.Fixnum(42));
        rt.Set(rch, global::Flint.Rt.Table.CH_BASE, col0);
        rt.Set(rch, global::Flint.Rt.Table.CH_BASE + 1, col1);
        rt.Set(rf, global::Flint.Rt.Table.RF_SCHEMA, sch);
        rt.Set(rf, global::Flint.Rt.Table.RF_CHUNK, rch);
        rt.Set(rf, global::Flint.Rt.Table.RF_ROW, Val.Fixnum(0));
        o.Append("rowcol=").Append(Val.AsFixnum(RowColumn(rt, sch, row, 0))).Append('.')
         .Append(Val.AsFixnum(RowColumn(rt, sch, row, 1))).Append('/')
         .Append(Val.AsFixnum(RowColumn(rt, sch, rf, 0))).Append('.')
         .Append(Val.AsFixnum(RowColumn(rt, sch, rf, 1)))
         .Append(" absent=").Append(RowColumn(rt, sch, row, 5) == Val.NotFound ? 1 : 0).Append(' ');
        long[] chunks = new long[2];
        for (int c = 0; c < 2; c++) {
            long cc = NewChunk(rt, 1, global::Flint.Rt.Table.CHUNK);
            long col = Obj2(rt, Obj.TyNode, global::Flint.Rt.Table.CHUNK);
            for (int k = 0; k < global::Flint.Rt.Table.CHUNK; k++)
                rt.Set(col, k, Val.Fixnum(c * global::Flint.Rt.Table.CHUNK + k));
            rt.Set(cc, global::Flint.Rt.Table.CH_BASE, col);
            chunks[c] = cc;
        }
        long chv = Vector(rt, chunks);
        long tab = Obj2(rt, Obj.TyTable, global::Flint.Rt.Table.TB_LEN);
        rt.Set(tab, global::Flint.Rt.Table.TB_CHUNKS, chv);
        rt.Set(tab, global::Flint.Rt.Table.TB_OFFSET, Val.Fixnum(0));
        long sliced = Obj2(rt, Obj.TyTable, global::Flint.Rt.Table.TB_LEN);
        rt.Set(sliced, global::Flint.Rt.Table.TB_CHUNKS, chv);
        rt.Set(sliced, global::Flint.Rt.Table.TB_OFFSET, Val.Fixnum(300));
        o.Append("cell=").Append(Val.AsFixnum(TableCell(rt, tab, 0, 0))).Append('.')
         .Append(Val.AsFixnum(TableCell(rt, tab, 0, 255))).Append('.')
         .Append(Val.AsFixnum(TableCell(rt, tab, 0, 256))).Append('/')
         .Append(Val.AsFixnum(TableCell(rt, sliced, 0, 0))).Append('.')
         .Append(Val.AsFixnum(TableCell(rt, sliced, 0, 99))).Append(' ');
        long tt = Obj2(rt, Obj.TyTtable, 1);
        o.Append("ttable=").Append(IsTtable(rt, tt) ? 1 : 0).Append(IsTtable(rt, tab) ? 1 : 0)
         .Append(IsTtable(rt, Val.Nil) ? 1 : 0).Append(IsTtable(rt, Val.Fixnum(3)) ? 1 : 0)
         .Append(" steps=").Append(rt.steps);
        System.Console.WriteLine(o.ToString());
    }
