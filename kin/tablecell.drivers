    static final long NIL = 0xFFFFL;
    static final int TY_SCHEMA = 48, TY_TABLE = 49, TY_TABLEREF = 50,
                     TY_VEC = 9, TY_NODE = 12, TY_MAP = 14, TY_TTABLE = 51;
    static final class Table {
        static final int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                         SC_WIDTH = 4, SC_LEN = 5;
        static final int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, TB_OFFSET = 3, TB_LEN = 4;
        static final int CH_ROWS = 0, CH_ENC = 1, CH_BASE = 2;
        static final int ENC_FLAT = 0, ENC_CONST = 1;
        static final int RF_SCHEMA = 0, RF_CHUNK = 1, RF_ROW = 2, RF_LEN = 3;
        static final int CHUNK = 256, CHUNK_SHIFT = 8;
    }
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && (v >>> 60) != 0xDL; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v & 0xFFFFFFFFL; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
        static boolean isFixnum(long v) { return (v >>> 60) == 0xDL; }
        static final long NOT_FOUND = 0xFFFEL;
    }
    static final class Space { byte[] m = new byte[40000]; }
    static final class Rt {
        long[] h = new long[40000];
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        int[] lens = new int[40000];
        long bump = 100;
        long alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long steps = 0;
        void chargeWork(long n) { steps += n; }
        void set(long n, int i, long v) { h[(int) n + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static int olen(Rt rt, long v) { return rt.lens[(int) v]; }
    static final class Vec {
        static int count(Rt rt, long v) { return rt.lens[(int) v]; }
        static long nth(Rt rt, long v, int i, long dflt) {
            return i >= count(rt, v) ? dflt : rt.slot(v, i);
        }
    }
    // Nested to reproduce the port's FULLY QUALIFIED `com.flint.rt.Eq` --
    // the vocabulary spells it in full because a bare `Eq` inside the
    // generated package would resolve to the GENERATED one.
    static final class com { static final class flint { static final class rt {
    static final class Maps {
        static long empty(Rt rt) { return Val.heap(rt.alloc(TY_MAP, 0)); }
    }
    static final class Eq {
        static boolean eq(Rt rt, long a, long b) {
            if (a == b) return true;
            if (!Val.isHeap(a) || !Val.isHeap(b)) return false;
            if (ty(rt.gc.sp, a) != TY_VEC || ty(rt.gc.sp, b) != TY_VEC) return false;
            int n = Vec.count(rt, a);
            if (n != Vec.count(rt, b)) return false;
            for (int i = 0; i < n; i++) if (!eq(rt, rt.slot(a, i), rt.slot(b, i))) return false;
            return true;
        }
    }
    } } }
    static long vector(Rt rt, long[] xs) {
        long a = rt.alloc(TY_VEC, Math.max(1, xs.length));
        rt.lens[(int) a] = xs.length;
