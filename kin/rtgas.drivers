--rust-head
type Addr = u64;
// FOUR FIELDS AND NOTHING ELSE. `gas_trips` is narrower than the other three
// on every runtime, and the toy keeps it so -- a `u32` here, an `int` on both
// ports -- because the only write to it is the clear, and a toy that widened
// it would stop testing that the clear compiles at the real width.
struct Rt { gas_limit: Addr, slice_end: Addr, checkpoint: Addr, gas_trips: u32 }
impl Rt {
--rust
}
// PRINTS THE ROLE, NOT THE BITS. `NO_CHECKPOINT` is `u64::MAX` here and
// `Long.MAX_VALUE` on both ports, deliberately -- each runtime tests against
// its own -- so a toy that printed the number would make the three disagree
// over the one thing they are meant to differ on.
fn at(gas: Addr, slice: Addr) -> String {
    let mut rt = Rt { gas_limit: gas, slice_end: slice, checkpoint: 0, gas_trips: 0 };
    rt.rt_refresh_checkpoint();
    if rt.checkpoint == u64::MAX { "none".to_string() } else { format!("{}", rt.checkpoint) }
}
fn set(limit: Addr, slice: Addr) -> String {
    let mut rt = Rt { gas_limit: 0, slice_end: slice, checkpoint: 0, gas_trips: 7 };
    rt.rt_set_gas_limit(limit);
    format!("{}/{}", rt.checkpoint, rt.gas_trips)
}
fn main() {
    println!("{} {} {} {} {} | {} {}",
             at(0, 0), at(100, 0), at(0, 50), at(100, 50), at(50, 100),
             set(200, 50), set(10, 50));
}
