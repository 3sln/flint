        Rt rt = new Rt();
        rt.gasLimit = gas; rt.sliceEnd = slice;
        rtRefreshCheckpoint(rt);
        return rt.checkpoint == Long.MAX_VALUE ? "none" : Long.toString(rt.checkpoint);
    }
    static String set(long limit, long slice) {
        Rt rt = new Rt();
        rt.sliceEnd = slice; rt.gasTrips = 7;
        rtSetGasLimit(rt, limit);
        return rt.checkpoint + "/" + rt.gasTrips;
    }
    public static void main(String[] args) {
        System.out.println(at(0, 0) + " " + at(100, 0) + " " + at(0, 50) + " "
                           + at(100, 50) + " " + at(50, 100) + " | "
                           + set(200, 50) + " " + set(10, 50));
    }
