--rust-head
// A TOY CURSOR, enough to drive the walk and nothing more.
//
// The walk reaches the bytes only through `wire-left`, `wire-skip`,
// `wire-take-u8` and `wire-take-u32`, which belong to `wirecore` -- so they are
// stubbed here rather than generated, and the cursor is a plain index. What is
// under test is the WALK: which tags carry which payload shape, and which of
// them mint.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
const TRUE: Value = Value(0xFFFF_0000_0000_0001);
const NOT_FOUND: Value = Value(0xFFFF_0000_0000_0002);
const FALSE: Value = Value(0xFFFF_0000_0000_0003);
mod codec {
    pub const NO_NS: u32 = u32::MAX;
}
impl Value {
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt { b: Vec<u8>, pos: usize, roots: Vec<Value>, vecs: Vec<Vec<Value>>, minted: Vec<i64> }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn new_vec(&mut self) -> Value { self.vecs.push(Vec::new()); Value((self.vecs.len() - 1) as u64) }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let mut s = self.vecs[v.0 as usize].clone();
        s.push(x);
        self.vecs.push(s);
        Value((self.vecs.len() - 1) as u64)
    }
    fn wire_left(&mut self, _rd: Value) -> u32 { (self.b.len() - self.pos) as u32 }
    fn wire_skip(&mut self, _rd: Value, n: u32) -> bool {
        if self.pos + n as usize > self.b.len() { return false; }
        self.pos += n as usize;
        true
    }
    fn wire_take_u8(&mut self, _rd: Value, d: u32) -> u32 {
        if self.pos >= self.b.len() { return d; }
        let v = self.b[self.pos] as u32;
        self.pos += 1;
        v
    }
    fn wire_take_u32(&mut self, _rd: Value, d: u32) -> u32 {
        if self.pos + 4 > self.b.len() { return d; }
        let s = &self.b[self.pos..self.pos + 4];
        self.pos += 4;
        u32::from_le_bytes([s[0], s[1], s[2], s[3]])
    }
    // MINTING IS THE ONE RUNTIME-SPECIFIC STEP, and here it only records.
    fn mint_bridge_port(&mut self, id: i64) -> Value {
        // Id 0 stands for "this sandbox has no ports", so the refusal path is
        // reachable from a driver that has no sandbox at all.
        if id == 0 { return NIL; }
        self.minted.push(id);
        TRUE
    }
--rust
}
fn main() {
    let cases: Vec<(&str, Vec<u8>)> = vec![
        ("bind", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,4,0,0,0,98,105,110,100,6,255,255,255,255,4,0,0,0,112,111,114,116,15,7,0,0,0]),
        ("two", vec![8,2,0,0,0,15,3,0,0,0,15,4,0,0,0]),
        ("trunc", vec![3,1,2]),
        ("unknown", vec![99]),
        ("qualified", vec![6,2,0,0,0,110,115,1,0,0,0,97]),
        ("table", vec![18,1,0,0,0,6,255,255,255,255,2,0,0,0,105,100,6,255,255,255,255,3,0,0,0,105,110,116,1,0,0,0,15,9,0,0,0]),
    ];
    let mut out = String::new();
    for (_name, bytes) in cases {
        let mut rt = Rt { b: bytes, pos: 0, roots: Vec::new(), vecs: Vec::new(), minted: Vec::new() };
        let acc = rt.new_vec();
        let ai = rt.push(acc);
        let ok = rt.wire_scan_at(NIL, ai, 0);
        let left = rt.wire_left(NIL);
        out.push_str(&format!("{}{}:", if ok { 1 } else { 0 }, left));
        for (i, m) in rt.minted.iter().enumerate() {
            if i > 0 { out.push(','); }
            out.push_str(&format!("{m}"));
        }
        out.push(' ');
    }
    // THE CONTROL PLANE'S OWN READ, on hand-built messages -- see
    // `--expect-why`. Each is `op + 8 * (port-id + 1)`, derived from
    // `wire-control-op`'s doc, not from running it.
    out.push_str("|");
    let ctrl_cases: Vec<(&str, Vec<u8>)> = vec![
        ("bind", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,4,0,0,0,98,105,110,100,6,255,255,255,255,4,0,0,0,112,111,114,116,15,7,0,0,0]),
        ("bind-reorder", vec![10,2,0,0,0,6,255,255,255,255,4,0,0,0,112,111,114,116,15,7,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,4,0,0,0,98,105,110,100]),
        ("close", vec![10,1,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,5,0,0,0,99,108,111,115,101]),
        ("snapshot", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,8,0,0,0,115,110,97,112,115,104,111,116,6,255,255,255,255,4,0,0,0,112,111,114,116,15,2,0,0,0]),
        ("unbind", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,6,0,0,0,117,110,98,105,110,100,6,255,255,255,255,4,0,0,0,112,111,114,116,15,0,0,0,0]),
        ("qualified-op", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,1,0,0,0,120,8,0,0,0,115,110,97,112,115,104,111,116,6,255,255,255,255,4,0,0,0,112,111,114,116,15,2,0,0,0]),
        ("snapshot-extra", vec![10,3,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,8,0,0,0,115,110,97,112,115,104,111,116,6,255,255,255,255,4,0,0,0,112,111,114,116,15,2,0,0,0,6,255,255,255,255,5,0,0,0,101,120,116,114,97,8,2,0,0,0,3,1,0,0,0,0,0,0,0,3,2,0,0,0,0,0,0,0]),
        ("vector", vec![8,1,0,0,0,3,1,0,0,0,0,0,0,0]),
        ("string-op", vec![10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,5,4,0,0,0,98,105,110,100,6,255,255,255,255,4,0,0,0,112,111,114,116,15,7,0,0,0]),
    ];
    for (_name, bytes) in ctrl_cases {
        let mut rt = Rt { b: bytes, pos: 0, roots: Vec::new(), vecs: Vec::new(), minted: Vec::new() };
        let acc = rt.new_vec();
        let ai = rt.push(acc);
        let code = rt.wire_control_op(NIL, ai);
        out.push_str(&format!(" {code}"));
    }
    println!("{}", out.trim_end());
}
--java-head
    static final long NIL = 0xFFFF000000000000L;
    static final long TRUE = 0xFFFF000000000001L;
    static final long NOT_FOUND = 0xFFFF000000000002L;
    static final class Codec { static final int NO_NS = -1; }
    static final class Val {
        static boolean isNil(long v) { return v == NIL; }
    }
    static final class Rt {
        byte[] b; int pos;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        java.util.ArrayList<java.util.ArrayList<Long>> vecs = new java.util.ArrayList<>();
        java.util.ArrayList<Long> minted = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long newVec() { vecs.add(new java.util.ArrayList<>()); return vecs.size() - 1; }
    }
    static long vecConj(Rt rt, long v, long x) {
        java.util.ArrayList<Long> s = new java.util.ArrayList<>(rt.vecs.get((int) v));
        s.add(x);
        rt.vecs.add(s);
        return rt.vecs.size() - 1;
    }
    static int wireLeft(Rt rt, long rd) { return rt.b.length - rt.pos; }
    static boolean wireSkip(Rt rt, long rd, int n) {
        if (rt.pos + n > rt.b.length) return false;
        rt.pos += n;
        return true;
    }
    static int wireTakeU8(Rt rt, long rd, int d) {
        if (rt.pos >= rt.b.length) return d;
        return rt.b[rt.pos++] & 0xFF;
    }
    static int wireTakeU32(Rt rt, long rd, int d) {
        if (rt.pos + 4 > rt.b.length) return d;
        int v = (rt.b[rt.pos] & 0xFF) | ((rt.b[rt.pos+1] & 0xFF) << 8)
              | ((rt.b[rt.pos+2] & 0xFF) << 16) | ((rt.b[rt.pos+3] & 0xFF) << 24);
        rt.pos += 4;
        return v;
    }
    static final class Conc {
        static long mintBridgePort(Rt rt, long id) {
            if (id == 0) return NIL;
            rt.minted.add(id);
            return TRUE;
        }
    }
