    static void Main() {
        int[][] cases = {
            new[] {10,2,0,0,0,6,255,255,255,255,2,0,0,0,111,112,6,255,255,255,255,4,0,0,0,98,105,110,100,6,255,255,255,255,4,0,0,0,112,111,114,116,15,7,0,0,0},
            new[] {8,2,0,0,0,15,3,0,0,0,15,4,0,0,0},
            new[] {3,1,2},
            new[] {99},
            new[] {6,2,0,0,0,110,115,1,0,0,0,97},
            new[] {18,1,0,0,0,6,255,255,255,255,2,0,0,0,105,100,6,255,255,255,255,3,0,0,0,105,110,116,1,0,0,0,15,9,0,0,0},
        };
        var outp = new System.Text.StringBuilder();
        foreach (var c in cases) {
            var rt = new Rt();
            rt.B = new byte[c.Length];
            for (int i = 0; i < c.Length; i++) rt.B[i] = (byte) c[i];
            rt.Pos = 0;
            int ai = rt.Push(rt.NewVec());
            bool ok = WireScanAt(rt, NIL, ai, 0);
            outp.Append(ok ? 1 : 0).Append(WireLeft(rt, NIL)).Append(":");
            for (int i = 0; i < rt.Minted.Count; i++) {
                if (i > 0) outp.Append(",");
                outp.Append(rt.Minted[i]);
            }
            outp.Append(" ");
        }
        System.Console.WriteLine(outp.ToString().Trim());
    }
--expect
10:7 10:3,4 02: 00: 10: 10:9
--expect-why
DERIVED FROM THE FORMAT. Each field is `<ok><bytes-left>:<ports minted>`, so a
walk that stopped early is visible as leftover bytes rather than only as a
verdict -- a scan that returned true having read half the message would pass a
check that looked at `ok` alone.

  bind      `10:7`   {:op :bind :port 7}. Reads to the end (0 left) and mints
                     port 7 -- the message `Host::caller` actually sends, and
                     the reason this walk exists: the port must exist before
                     `Host::call` delivers on it.
  two       `10:3,4` [port 3, port 4]. TWO ports from one message, in order,
                     which is what a vector of capabilities looks like.
  trunc     `02:`    `K_INT` with three bytes where eight are due. Refused,
                     nothing minted, and TWO BYTES LEFT -- the tag is consumed
                     before its payload is checked, so the cursor sits after it
                     when the refusal happens. That `2` was derived as `0`
                     first and the three targets said otherwise together, which
                     is the case where an expected answer is worth more than a
                     cross-target comparison: three agreeing implementations
                     cannot tell you that your reasoning was wrong.
  unknown   `00:`    Tag 99. There is no length to skip by, so the walk cannot
                     go on and must not pretend to. Nothing is left because the
                     tag was the whole message.
  qualified `10:`    `:ns/a`. The NAMESPACE IS PRESENT here, where every other
                     keyword in these cases has `ffffffff` for absent. Both are
                     read to the end and mint nothing, which is the pair that
                     says `NO_NS` is not being treated as a length -- a walk
                     that did would try to skip 4 294 967 295 bytes and refuse
                     the message.
  table     `10:9`   One `:int` column and one row whose cell is port 9. The
                     ROW COUNT sits after values, so a walk that read the
                     table's parts in the wrong order lands on the wrong byte
                     and either refuses or mints nothing -- and a port inside a
                     table is exactly the case that would otherwise be missed.
