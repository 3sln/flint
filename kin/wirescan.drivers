    internal const long NIL = unchecked((long) 0xFFFF000000000000UL);
    internal const long TRUE = unchecked((long) 0xFFFF000000000001UL);
    internal const long NOT_FOUND = unchecked((long) 0xFFFF000000000002UL);
    internal static class Codec { internal const int NO_NS = -1; }
    internal static class Val {
        internal static bool IsNil(long v) => v == NIL;
    }
    internal sealed class Rt {
        internal byte[] B = System.Array.Empty<byte>();
        internal int Pos;
        internal System.Collections.Generic.List<long> Roots = new();
        internal System.Collections.Generic.List<System.Collections.Generic.List<long>> Vecs = new();
        internal System.Collections.Generic.List<long> Minted = new();
        internal int Mark() => Roots.Count;
        internal int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        internal long R(int i) => Roots[i];
        internal void SetR(int i, long v) { Roots[i] = v; }
        internal void PopTo(int n) { while (Roots.Count > n) Roots.RemoveAt(Roots.Count - 1); }
        internal long NewVec() { Vecs.Add(new System.Collections.Generic.List<long>()); return Vecs.Count - 1; }
    }
    static long VecConj(Rt rt, long v, long x) {
        var s = new System.Collections.Generic.List<long>(rt.Vecs[(int) v]);
        s.Add(x);
        rt.Vecs.Add(s);
        return rt.Vecs.Count - 1;
    }
    static int WireLeft(Rt rt, long rd) => rt.B.Length - rt.Pos;
    static bool WireSkip(Rt rt, long rd, int n) {
        if (rt.Pos + n > rt.B.Length) return false;
        rt.Pos += n;
        return true;
    }
    static int WireTakeU8(Rt rt, long rd, int d) {
        if (rt.Pos >= rt.B.Length) return d;
        return rt.B[rt.Pos++] & 0xFF;
    }
    static int WireTakeU32(Rt rt, long rd, int d) {
        if (rt.Pos + 4 > rt.B.Length) return d;
        int v = (rt.B[rt.Pos] & 0xFF) | ((rt.B[rt.Pos+1] & 0xFF) << 8)
              | ((rt.B[rt.Pos+2] & 0xFF) << 16) | ((rt.B[rt.Pos+3] & 0xFF) << 24);
        rt.Pos += 4;
        return v;
    }
    internal static class Conc {
        internal static long MintBridgePort(Rt rt, long id) {
            if (id == 0) return NIL;
            rt.Minted.Add(id);
            return TRUE;
        }
    }
