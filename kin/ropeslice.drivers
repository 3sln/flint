        static final int RP_BYTES = 0, RP_CPS = 1, RP_FLAT = 2, RP_HASH = 3, RP_KIDS = 4;
        static final int FANOUT = 3, FLAT_MAX = 8, SLICE_MIN = 4;
        static int sBytes(Rt rt, long v) {
            if (isRope(rt, v)) return (int) rt.slot(v, RP_BYTES);
            return rt.lens[(int) v];
        }
        static int sCount(Rt rt, long v) {
            if (isRope(rt, v)) return (int) (rt.slot(v, RP_CPS) >> 1);
            return rt.cps[(int) v];
        }
        static boolean sAscii(Rt rt, long v) {
            if (isRope(rt, v)) return (rt.slot(v, RP_CPS) & 1) != 0;
            return rt.asc[(int) v] != 0;
        }
        static long sEmpty(Rt rt) { return leaf(rt, 0, 0, true); }
        static long sCopyRange(Rt rt, long v, int from, int to) {
            return leaf(rt, to - from, to - from, sAscii(rt, v));
        }
        static long copyConcat(Rt rt, long a, long b) {
            return leaf(rt, sBytes(rt, a) + sBytes(rt, b),
                        sCount(rt, a) + sCount(rt, b),
                        sAscii(rt, a) && sAscii(rt, b));
        }
    }
