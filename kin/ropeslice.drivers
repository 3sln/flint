        o.append("small=").append(Str.sBytes(rt, small)).append(',')
         .append(small == b ? 1 : 0).append(' ');
        long mid = ropeSlice(rt, tree, 5, 15);
        o.append("mid=").append(Str.sBytes(rt, mid)).append(" shares=")
         .append(rt.slot(mid, Str.RP_KIDS) == b ? 1 : 0)
         .append(rt.slot(mid, Str.RP_KIDS + 1) == c ? 1 : 0).append(' ');
        o.append("clamp=").append(Str.sBytes(rt, ropeSlice(rt, tree, 16, 99)))
         .append(" rag=").append(Str.sBytes(rt, ropeSlice(rt, tree, 3, 17))).append(' ');
