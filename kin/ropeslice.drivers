        long c = leaf(rt, 5, 5, true), d = leaf(rt, 5, 5, true);
        int base = rt.mark();
        rt.push(a); rt.push(b); rt.push(c); rt.push(d);
        long tree = ropeNode(rt, base, 4);
        rt.popTo(base);
        o.append("whole=").append(ropeSlice(rt, tree, 0, 20) == tree ? 1 : 0).append(' ');
        o.append("empty=").append(Str.sBytes(rt, ropeSlice(rt, tree, 3, 3))).append(',')
         .append(Str.sBytes(rt, ropeSlice(rt, tree, 7, 2))).append(' ');
        long small = ropeSlice(rt, tree, 5, 8);
        o.append("small=").append(Str.sBytes(rt, small)).append(',')
         .append(small == b ? 1 : 0).append(' ');
        long mid = ropeSlice(rt, tree, 5, 15);
        o.append("mid=").append(Str.sBytes(rt, mid)).append(" shares=")
         .append(rt.slot(mid, Str.RP_KIDS) == b ? 1 : 0)
         .append(rt.slot(mid, Str.RP_KIDS + 1) == c ? 1 : 0).append(' ');
        o.append("clamp=").append(Str.sBytes(rt, ropeSlice(rt, tree, 16, 99)))
         .append(" rag=").append(Str.sBytes(rt, ropeSlice(rt, tree, 3, 17))).append(' ');
        System.out.println(o.toString());
