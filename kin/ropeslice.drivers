        int bytes = 0, cps = 0; boolean ascii = true;
        for (int i = 0; i < n; i++) {
            long k = rt.r(base + i);
            bytes += Str.sBytes(rt, k); cps += Str.sCount(rt, k); ascii = ascii && Str.sAscii(rt, k);
        }
