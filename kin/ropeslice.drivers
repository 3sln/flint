        if (a == 0) return NIL;
        rt.setSlot(a, Str.RP_BYTES, bytes);
        rt.setSlot(a, Str.RP_CPS, ((cps << 1) | (ascii ? 1 : 0)));
        rt.setSlot(a, Str.RP_FLAT, NIL);
        rt.setSlot(a, Str.RP_HASH, NIL);
