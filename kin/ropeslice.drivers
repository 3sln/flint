        int bas = rt.Mark();
        rt.Push(a); rt.Push(b); rt.Push(c); rt.Push(d);
        long tree = RopeNode(rt, bas, 4);
        rt.PopTo(bas);
        o.Append("whole=").Append(RopeSlice(rt, tree, 0, 20) == tree ? 1 : 0).Append(' ');
        o.Append("empty=").Append(SBytesOf(rt, RopeSlice(rt, tree, 3, 3))).Append(',')
         .Append(SBytesOf(rt, RopeSlice(rt, tree, 7, 2))).Append(' ');
        long small = RopeSlice(rt, tree, 5, 8);
        o.Append("small=").Append(SBytesOf(rt, small)).Append(',')
         .Append(small == b ? 1 : 0).Append(' ');
        long mid = RopeSlice(rt, tree, 5, 15);
        o.Append("mid=").Append(SBytesOf(rt, mid)).Append(" shares=")
         .Append(rt.Slot(mid, global::Flint.Rt.Str.RP_KIDS) == b ? 1 : 0)
         .Append(rt.Slot(mid, global::Flint.Rt.Str.RP_KIDS + 1) == c ? 1 : 0).Append(' ');
        o.Append("clamp=").Append(SBytesOf(rt, RopeSlice(rt, tree, 16, 99)))
         .Append(" rag=").Append(SBytesOf(rt, RopeSlice(rt, tree, 3, 17))).Append(' ');
        System.Console.WriteLine(o.ToString());
