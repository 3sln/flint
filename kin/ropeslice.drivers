--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_ROPE: u8 = 26; const TY_STR: u8 = 2;
pub mod obj {
    pub const RP_BYTES: u32 = 0; pub const RP_CPS: u32 = 1;
    pub const RP_FLAT: u32 = 2; pub const RP_HASH: u32 = 3; pub const RP_KIDS: u32 = 4;
}
pub mod rope { pub const FANOUT: u32 = 3; pub const FLAT_MAX: u32 = 8; pub const SLICE_MIN: u32 = 4; }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool,
            cps: Vec<u32>, asc: Vec<u8> }
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    // A LEAF carries its own byte length, code-point count and ASCII bit, so
    // the driver can build a non-ASCII leaf and watch the bit propagate.
    fn leaf(&mut self, bytes: u32, cps: u32, ascii: bool) -> Value {
        let a = self.alloc(TY_STR, bytes);
        self.cps[a as usize] = cps; self.asc[a as usize] = ascii as u8;
        Value::heap(a)
    }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn rope_from_roots(&mut self, base: usize, n: u32) -> Value {
        if n == 0 { return self.s_empty(); }
        if n == 1 { return self.r(base); }
        self.rope_node(base, n)
    }
    fn rope_kids(&self, v: Value) -> u32 { self.olen(v) - obj::RP_KIDS }
    fn is_rope(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_ROPE
    }
    // The sink half: a leaf is modelled by its measurements, so a range of it
    // is a leaf of that width. ASCII is inherited, which is what a real decode
    // would find for the fixtures below.
    fn s_copy_range(&mut self, v: Value, from: u32, to: u32) -> Value {
        let asc = self.s_ascii(v);
        self.leaf(to - from, to - from, asc)
    }
    fn rope_node(&mut self, base: usize, n: u32) -> Value {
        let (mut bytes, mut cps, mut ascii) = (0u32, 0u32, true);
        for i in 0..n {
            let k = self.r(base + i as usize);
            bytes += self.s_bytes(k); cps += self.s_count(k); ascii = ascii && self.s_ascii(k);
        }
        let a = self.alloc(TY_ROPE, obj::RP_KIDS + n);
        if a == 0 { return NIL; }
        self.set_slot(a, obj::RP_BYTES, Value::fixnum(bytes as i64));
        self.set_slot(a, obj::RP_CPS, Value::fixnum(((cps << 1) | (ascii as u32)) as i64));
        self.set_slot(a, obj::RP_FLAT, NIL);
        self.set_slot(a, obj::RP_HASH, NIL);
        for i in 0..n { let v = self.r(base + i as usize); self.set_slot(a, obj::RP_KIDS + i, v); }
        Value::heap(a)
    }
    fn rope_lift(&mut self, v: Value, h: u32) -> Value {
        let base = self.mark();
        let ci = self.push(v);
        for _ in 0..h {
            let w = self.rope_node(ci, 1);
            if w.is_nil() { self.pop_to(base); return NIL; }
            self.set_r(ci, w);
        }
        let out = self.r(ci);
        self.pop_to(base);
        out
    }
    fn s_bytes(&self, v: Value) -> u32 {
        if self.is_rope(v) { self.slot(v, obj::RP_BYTES).as_fixnum() as u32 }
        else { self.lens[v.0 as usize] }
    }
    fn s_count(&self, v: Value) -> u32 {
        if self.is_rope(v) { (self.slot(v, obj::RP_CPS).as_fixnum() as u32) >> 1 }
        else { self.cps[v.0 as usize] }
    }
    fn s_ascii(&self, v: Value) -> bool {
        if self.is_rope(v) { self.slot(v, obj::RP_CPS).as_fixnum() & 1 != 0 }
        else { self.asc[v.0 as usize] != 0 }
    }
    fn s_empty(&mut self) -> Value { self.leaf(0, 0, true) }
    // The hand-written sink half: two strings flattened into one leaf. A leaf
    // is modelled by its measurements here, so joining two adds them.
    fn copy_concat(&mut self, a: Value, b: Value) -> Value {
        let (nb, nc) = (self.s_bytes(a) + self.s_bytes(b), self.s_count(a) + self.s_count(b));
        let asc = self.s_ascii(a) && self.s_ascii(b);
        self.leaf(nb, nc, asc)
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: vec![0u8; 40000] },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(), starve: false,
                      cps: vec![0; 40000], asc: vec![0; 40000] };
    let mut o = String::new();
    // SLICE_MIN is 4 here, FANOUT 3. Four leaves of five bytes each.
    let a = rt.leaf(5, 5, true); let b = rt.leaf(5, 5, true);
    let c = rt.leaf(5, 5, true); let d = rt.leaf(5, 5, true);
    let base = rt.mark();
    rt.push(a); rt.push(b); rt.push(c); rt.push(d);
    let tree = rt.rope_node(base, 4);
    rt.pop_to(base);
    // Whole range: the value ITSELF.
    let whole = rt.rope_slice(tree, 0, 20);
    o.push_str(&format!("whole={} ", (whole.0 == tree.0) as u32));
    // Empty and inverted ranges.
    let e1 = rt.rope_slice(tree, 3, 3); let e2 = rt.rope_slice(tree, 7, 2);
    o.push_str(&format!("empty={},{} ", rt.s_bytes(e1), rt.s_bytes(e2)));
    // Below SLICE_MIN: copied, so NOT the child even when it aligns.
    let small = rt.rope_slice(tree, 5, 8);
    o.push_str(&format!("small={},{} ", rt.s_bytes(small), (small.0 == b.0) as u32));
    // At or above SLICE_MIN and covering whole children: they are SHARED.
    let mid = rt.rope_slice(tree, 5, 15);
    o.push_str(&format!("mid={} shares={}{} ", rt.s_bytes(mid),
        (rt.slot(mid, obj::RP_KIDS).0 == b.0) as u32,
        (rt.slot(mid, obj::RP_KIDS + 1).0 == c.0) as u32));
    // Clamped past the end, and a ragged range.
    let cl = rt.rope_slice(tree, 16, 99);
    let rag = rt.rope_slice(tree, 3, 17);
    o.push_str(&format!("clamp={} rag={} ", rt.s_bytes(cl), rt.s_bytes(rag)));
    println!("{}", o);
}
