--rust-head
// MURMUR3 FOR REAL, not a stub, and that is the whole difference between this
// fixture and `valhash.drivers` next door.
//
// A sibling is usually stubbed here: `valhash` wants to know which ARM ran, so
// its `string_hash` answers `0x5100 | v`, and the arithmetic is pinned
// elsewhere. This source is arithmetic all the way down -- `hash-bytes` ends
// in `hash-int`, and `hash-symbol` in `hash-combine` -- so a stub would make
// every number below a number about the stub. The `--expect` values come out
// of `clojure.lang.Murmur3`, and they can only mean that if what runs here is
// murmur3.
//
// These twelve lines are `kin/hash.kin` transcribed. That is duplication, and
// it is duplication of a DIFFERENT KIND from the one this port removes: a
// fixture is hand-written per language on purpose, and a fixture that
// disagreed with `hash.kin` would show up immediately as three targets
// agreeing on a number Clojure does not produce.
const C1: u32 = 0xcc9e2d51;
const C2: u32 = 0x1b873593;
const KW_SHIFT: u32 = 0x9e3779b9;
fn mix_k1(k1: u32) -> u32 { k1.wrapping_mul(C1).rotate_left(15).wrapping_mul(C2) }
fn mix_h1(h1: u32, k1: u32) -> u32 {
    (h1 ^ k1).rotate_left(13).wrapping_mul(5).wrapping_add(0xe6546b64)
}
fn fmix(mut h1: u32, len: u32) -> u32 {
    h1 ^= len;
    h1 ^= h1 >> 16;
    h1 = h1.wrapping_mul(0x85ebca6b);
    h1 ^= h1 >> 13;
    h1 = h1.wrapping_mul(0xc2b2ae35);
    h1 ^ (h1 >> 16)
}
fn hash_int(input: u32) -> u32 {
    if input == 0 { return 0; }
    fmix(mix_h1(0, mix_k1(input)), 4)
}
fn hash_combine(seed: u32, h: u32) -> u32 {
    seed ^ h.wrapping_add(0x9e3779b9)
             .wrapping_add(seed << 6)
             .wrapping_add(((seed as i32) >> 2) as u32)
}
--rust
fn main() {
    // THE EMOJI IS SPELLED TWICE ON PURPOSE: once as a character and once as
    // the four bytes it encodes to. Printing both, rather than printing
    // whether they are equal, is what makes a failure legible -- `true` and
    // `false` cannot say which side moved.
    let emoji = "\u{1F600}";
    let raw: [u8; 4] = [0xF0, 0x9F, 0x98, 0x80];
    println!("{} {} {} {} {} | {} {} {} {} {} | {} {} {} | {} {} {} | {} {} | {} {}",
        hash_double(0.0) as i32, hash_double(-0.0) as i32, hash_double(1.0) as i32,
        hash_double(1.5) as i32, hash_double(-2.75) as i32,
        hash_bytes(b"") as i32, hash_bytes(b"a") as i32, hash_bytes(b"abc") as i32,
        hash_bytes(b"hello, world") as i32, hash_bytes("日本語".as_bytes()) as i32,
        hash_symbol(b"", b"a") as i32, hash_symbol(b"", b"abc") as i32,
        hash_symbol(b"foo", b"bar") as i32,
        hash_keyword(b"", b"a") as i32, hash_keyword(b"", b"abc") as i32,
        hash_keyword(b"foo", b"bar") as i32,
        hash_bytes(emoji.as_bytes()) as i32, hash_bytes(&raw) as i32,
        hash_symbol(b"", b"bar") as i32, hash_combine(hash_bytes(b"bar"), 0) as i32);
}
--java-head
    static final int KW_SHIFT = 0x9e3779b9;
    static int mixK1(int k1) { return Integer.rotateLeft(k1 * 0xcc9e2d51, 15) * 0x1b873593; }
    static int mixH1(int h1, int k1) {
        return Integer.rotateLeft(h1 ^ k1, 13) * 5 + 0xe6546b64;
    }
    static int fmix(int h1, int len) {
        h1 ^= len;
        h1 ^= h1 >>> 16;
        h1 *= 0x85ebca6b;
        h1 ^= h1 >>> 13;
        h1 *= 0xc2b2ae35;
        return h1 ^ (h1 >>> 16);
    }
    static int hashInt(int input) {
        if (input == 0) return 0;
        return fmix(mixH1(0, mixK1(input)), 4);
    }
    static int hashCombine(int seed, int h) {
        return seed ^ (h + 0x9e3779b9 + (seed << 6) + (seed >> 2));
    }
    static byte[] b(String s) { return s.getBytes(StandardCharsets.UTF_8); }
--java
    public static void main(String[] args) {
        byte[] emoji = b("😀");
        byte[] raw = new byte[]{(byte) 0xF0, (byte) 0x9F, (byte) 0x98, (byte) 0x80};
        StringBuilder o = new StringBuilder();
        o.append(hashDouble(0.0)).append(' ').append(hashDouble(-0.0)).append(' ')
         .append(hashDouble(1.0)).append(' ').append(hashDouble(1.5)).append(' ')
         .append(hashDouble(-2.75)).append(" | ")
         .append(hashBytes(b(""))).append(' ').append(hashBytes(b("a"))).append(' ')
         .append(hashBytes(b("abc"))).append(' ').append(hashBytes(b("hello, world")))
         .append(' ').append(hashBytes(b("日本語"))).append(" | ")
         .append(hashSymbol(b(""), b("a"))).append(' ')
         .append(hashSymbol(b(""), b("abc"))).append(' ')
         .append(hashSymbol(b("foo"), b("bar"))).append(" | ")
         .append(hashKeyword(b(""), b("a"))).append(' ')
         .append(hashKeyword(b(""), b("abc"))).append(' ')
         .append(hashKeyword(b("foo"), b("bar"))).append(" | ")
         .append(hashBytes(emoji)).append(' ').append(hashBytes(raw)).append(" | ")
         .append(hashSymbol(b(""), b("bar"))).append(' ')
         .append(hashCombine(hashBytes(b("bar")), 0));
        System.out.println(o);
    }
--csharp-head
    const int KwShift = unchecked((int) 0x9e3779b9);
    static int MixK1(int k1) { unchecked {
        return (int) BitOperations.RotateLeft((uint)(k1 * (int) 0xcc9e2d51), 15)
               * (int) 0x1b873593; } }
    static int MixH1(int h1, int k1) { unchecked {
        return (int) BitOperations.RotateLeft((uint)(h1 ^ k1), 13) * 5 + (int) 0xe6546b64; } }
    static int Fmix(int h1, int len) { unchecked {
        h1 ^= len;
        h1 ^= (int)((uint) h1 >> 16);
        h1 *= (int) 0x85ebca6b;
        h1 ^= (int)((uint) h1 >> 13);
        h1 *= (int) 0xc2b2ae35;
        return h1 ^ (int)((uint) h1 >> 16); } }
    static int HashInt(int input) {
        if (input == 0) return 0;
        return Fmix(MixH1(0, MixK1(input)), 4);
    }
    static int HashCombine(int seed, int h) { unchecked {
        return seed ^ (h + (int) 0x9e3779b9 + (seed << 6) + (seed >> 2)); } }
    static byte[] B(string s) { return Encoding.UTF8.GetBytes(s); }
