;; Joining two strings, and the append that keeps the tree log-deep.
;;
;; THREE TIERS, in the order `s-concat` tries them:
;;
;;   1. either side empty  -- the other side, unchanged
;;   2. small enough       -- COPY into one leaf, no tree at all
;;   3. otherwise          -- append down the RIGHT SPINE, and only add a
;;                            level when every node on it is full
;;
;; Tier 3 is the one with history. It used to widen the root while it had room
;; and otherwise build `[old, new]`, which put the whole old tree back as child
;; zero and grew the depth by one every `FANOUT` appends -- so depth was O(n),
;; not O(log n), and `DECISIONS.md#strings-and-matching`'s "fanout 16-32, depth is what random
;; access pays for" described a tree this did not build. It never showed while
;; nothing indexed a rope, because every path flattened first; the moment
;; indexing descends instead, an O(n)-deep tree makes the walk quadratic in a
;; new place. `test/scaling.clj` measured 3.02x.
(ns flint.rt.ropecat
  (:require [flint.impl.rt :refer [defn return if let do comment doc == < <= > +
                                   - not nil? is-heap as-heap ty for local set
                                   olen slot mark push r set-r pop-to Rt Value
                                   RootIx I32 Bool NIL TY_ROPE FLAT_MAX
                                   MERGE_MAX FANOUT RP_KIDS]]
            [flint.rt.ropemeas :refer [is-rope s-bytes]]
            [flint.rt.strs :refer [s-concat-copy]]
            [flint.rt.ropenode :refer [rope-node rope-lift]]))


(doc "How many children this node has.")
(defn ^:pub ^:method ^I32 rope-kids [^Rt rt ^Value v]
  (return (- (olen rt v) RP_KIDS)))

(doc "How many levels of node stand above the leaves, 0 for a leaf itself."
     ""
     "Reads CHILD ZERO and recurses, which is exact because a node's children"
     "are all the same height -- the invariant `rope-lift` exists to keep.")
(defn ^:pub ^:method ^I32 rope-height [^Rt rt ^Value v]
  (if (not (is-rope rt v))
    (return 0))
  (return (+ 1 (rope-height rt (slot rt v RP_KIDS)))))

(doc "Graft `piece` onto the EDGE of `node`: the left edge when `front`, the"
     "right edge otherwise. NIL when it does not fit anywhere along that edge."
     ""
     "ONE FUNCTION FOR BOTH DIRECTIONS, because they are the same walk. The"
     "prepend side was first written as its own mirror of the append side and"
     "cost 2 090 bytes -- a second recursive descent, a second set of rebuilds"
     "and a second lift, to do the same three things at the other end. Shared,"
     "the second direction is a handful of branches: which child to descend,"
     "which way round the merge concatenates, and which end the new sibling"
     "goes."
     ""
     "THREE THINGS IN ORDER, deepest first. Room further down costs no depth;"
     "a leaf that can absorb `piece` costs no node either; and only when"
     "neither holds does it become a sibling, LIFTED to the height its"
     "siblings stand at or the tree goes ragged."
     ""
     "NIL when the edge is full at every level, which is the ONLY time"
     "`s-concat` adds one -- so depth grows O(log n) times over n joins"
     "rather than O(n/FANOUT) times.")
(defn ^:pub ^:method ^Value rope-graft
  [^:mut ^Rt rt ^Value node ^Value piece ^Bool front]
  (if (not (is-rope rt node))
    (return NIL))
  (let [^I32 n (rope-kids rt node)
        ^RootIx base (mark rt)
        ^RootIx ni (push rt node)
        ^RootIx pi (push rt piece)]
    (local ^:mut ^I32 edge)
    (set edge (- n 1))
    (if front
      (set edge 0))
    (let [^Value kid (slot rt (r rt ni) (+ RP_KIDS edge))
          ^RootIx ki (push rt kid)]
      (local ^:mut ^Value fixed)
      (set fixed NIL)
      (comment "DEEPEST FIRST: room further down costs no depth at all.")
      (if (is-rope rt (r rt ki))
        (set fixed (rope-graft rt (r rt ki) (r rt pi) front)))
      (comment "THEN MERGE BEFORE CREATE, which is the rule a CHAMP already"
               "follows and this did not. `s-concat`'s copy tier asks whether"
               "the WHOLE RESULT fits a leaf, so past FLAT_MAX every join,"
               "however small, became its own leaf. The question that matters"
               "is whether `piece` fits the leaf ALREADY THERE.")
      (if (nil? rt fixed)
        (if (not (is-rope rt (r rt ki)))
          (if (not (is-rope rt (r rt pi)))
            (if (<= (+ (s-bytes rt (r rt ki)) (s-bytes rt (r rt pi))) MERGE_MAX)
              (if front
                (set fixed (s-concat-copy rt (r rt pi) (r rt ki)))
                (set fixed (s-concat-copy rt (r rt ki) (r rt pi))))))))
      (if (not (nil? rt fixed))
        (do
          (let [^RootIx fi (push rt fixed)
                ^RootIx kbase (mark rt)]
            (for [^I32 i 0 n]
              (if (== i edge)
                (push rt (r rt fi))
                (push rt (slot rt (r rt ni) (+ RP_KIDS i)))))
            (let [^Value out (rope-node rt kbase n)]
              (pop-to rt base)
              (return out)))))
      (comment "THEN A SIBLING, if this node has room.")
      (if (< n FANOUT)
        (do
          (let [^I32 h (rope-height rt (r rt ki))
                ^Value lifted (rope-lift rt (r rt pi) h)]
            (if (nil? rt lifted)
              (do (pop-to rt base)
                  (return NIL)))
            (let [^RootIx li (push rt lifted)
                  ^RootIx kbase (mark rt)]
              (if front
                (push rt (r rt li)))
              (for [^I32 i 0 n]
                (push rt (slot rt (r rt ni) (+ RP_KIDS i))))
              (if (not front)
                (push rt (r rt li)))
              (let [^Value out (rope-node rt kbase (+ n 1))]
                (pop-to rt base)
                (return out))))))
      (pop-to rt base)
      (return NIL))))

(doc "Append `b` into the rightmost subtree of `a` that has room.")
(defn ^:pub ^:method ^Value rope-append [^:mut ^Rt rt ^Value a ^Value b]
  (return (rope-graft rt a b false)))

(doc "Prepend `a` into the leftmost subtree of `b` that has room."
     ""
     "NOTE THE ARGUMENT ORDER: `a` is the piece and `b` is the tree, which is"
     "the reverse of `rope-append` and follows `s-concat`'s `a` then `b`.")
(defn ^:pub ^:method ^Value rope-prepend [^:mut ^Rt rt ^Value a ^Value b]
  (return (rope-graft rt b a true)))

(doc "`a` followed by `b`, as a string.")
(defn ^:pub ^:method ^Value s-concat [^:mut ^Rt rt ^Value a ^Value b]
  (if (== (s-bytes rt a) 0)
    (return b))
  (if (== (s-bytes rt b) 0)
    (return a))
  (comment "Small enough that a tree would cost more in metadata than the copy"
           "saves. This is the tier that must NOT be skipped.")
  (if (<= (+ (s-bytes rt a) (s-bytes rt b)) FLAT_MAX)
    (return (s-concat-copy rt a b)))
  (let [^Value appended (rope-append rt a b)]
    (if (not (nil? rt appended))
      (return appended)))
  (comment "AND THE OTHER END, before a level is added. Sharing the walk with"
           "the append side is what made this affordable -- as its own mirror"
           "it cost 2 090 bytes and was removed for it.")
  (if (not (is-rope rt a))
    (let [^Value prepended (rope-prepend rt a b)]
      (if (not (nil? rt prepended))
        (return prepended))))
  (comment "A NEW LEVEL, with THE SHORTER SIDE LIFTED to meet the taller."
           ""
           "This used to lift `b` by `rope-height(a)` outright, which is only"
           "right when `b` is a LEAF -- the append case, where `b` is the new"
           "piece. Reverse the arguments and it is wrong twice over: a short"
           "`a` in front of a tall `b` lifts `b` by ZERO and builds"
           "`[leaf, deep-rope]`, which is RAGGED."
           ""
           "That is the exact shape this file's header says was fixed for"
           "append -- `[old, new]` with the whole old tree as a child, depth"
           "growing linearly -- still live at the other end. Measured in the"
           "probe: twelve appends of six bytes give height 3, twelve PREPENDS"
           "of six bytes gave height 1 over a right-leaning chain, and"
           "`rope-height` could not even report it because it reads child zero"
           "and trusts that children are the same height."
           ""
           "AND IT IS NOW REACHABLE. The header says the ragged tree `never"
           "showed while nothing indexed a rope, because every path flattened"
           "first; the moment indexing descends instead, an O(n)-deep tree"
           "makes the walk quadratic in a new place`. `str-index-of` descends"
           "now, so this stopped being latent.")
  (let [^RootIx base (mark rt)
        ^RootIx ai (push rt a)
        ^RootIx bi (push rt b)
        ^I32 ha (rope-height rt (r rt ai))
        ^I32 hb (rope-height rt (r rt bi))]
    (if (< ha hb)
      (do
        (let [^Value la (rope-lift rt (r rt ai) (- hb ha))]
          (if (nil? rt la)
            (do (pop-to rt base)
                (return NIL)))
          (set-r rt ai la))))
    (if (> ha hb)
      (do
        (let [^Value lb (rope-lift rt (r rt bi) (- ha hb))]
          (if (nil? rt lb)
            (do (pop-to rt base)
                (return NIL)))
          (set-r rt bi lb))))
    (let [^RootIx kbase (mark rt)]
      (push rt (r rt ai))
      (push rt (r rt bi))
      (let [^Value out (rope-node rt kbase 2)]
        (pop-to rt base)
        (return out)))))
