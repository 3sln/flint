    static final long NIL = 0xFFFFL;
    static final long NOT_FOUND = 0xFFFEL;
    static final int TY_ARRAYMAP = 10, TY_HASHMAP = 11, TY_VEC = 12;
    static final int TY_TAGGED = 13, TY_TABLE = 14, TY_TABLEREF = 15;
    static final int TY_MAPENTRY = 16, TY_STR = 17, TY_BYTES = 18;
    static final int TY_CONS = 19, TY_OTHER = 20, TY_SYM = 21;
    static final class Val {
        static final long NIL = Probe.NIL;
        static final long NOT_FOUND = Probe.NOT_FOUND;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >>> 40) == 0; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static long anInt(long n) { return 0x10000000000L | (n & 0xFFFFFFFFL); }
    static final class Space { byte[] m = new byte[4000]; }
    static final class Rt {
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        long bump = 100;
        String thrown = "";
        int vecn = 3, strn = 3, bytn = 3, seqn = 3;
        boolean sym = true;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long v, int i) { return 0x700L + i; }
        long throwStr(String cls, String msg) { thrown = cls + "/" + msg; return NIL; }
        long obj(int t) { long a = bump; bump += 8; gc.sp.m[(int) a] = (byte) t; return a; }
        long nameOf(long k) { return 0x8DL; }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static final class Str {
        static long keyword(Rt rt, String ns, String n) { return n.equals("tag") ? 0x8AL : 0x8BL; }
        static long nth(Rt rt, long s, int i, long d) { return i < rt.strn ? 0x920L + i : d; }
        static String text(Rt rt, long v) { return "zz"; }
    }
    static final class Num {
        static long i64Of(Rt rt, long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    static boolean isBytes(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_BYTES; }
    static boolean isSymbol(Rt rt, long v) { return rt.sym; }
    static long mapAssoc(Rt rt, long m, long k, long v) { return 0x901L; }
    static final class Vec {
        static long assoc(Rt rt, long v, int i, long x) { return 0x910L + i; }
        static int count(Rt rt, long v) { return rt.vecn; }
        static long nth(Rt rt, long v, int i, long d) { return i < rt.vecn ? 0x940L + i : d; }
        static long mapEntryAsVec(Rt rt, long e) { return rt.obj(TY_VEC); }
    }
    static long vecAssoc(Rt rt, long v, int i, long x) { return Vec.assoc(rt, v, i, x); }
    static long vecNth(Rt rt, long v, int i, long d) { return Vec.nth(rt, v, i, d); }
    static long seq(Rt rt, long c) { return rt.seqn == 0 ? NIL : 0xC000L + rt.seqn; }
    static long first(Rt rt, long s) { return 0x950L + (s - 0xC000L); }
    static long next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    static long newTagged(Rt rt, long t, long f) { return 0x902L; }
    static long tableAssoc(Rt rt, long t, long k, long v) { return 0x903L; }
    static long refAssoc(Rt rt, long r, long k, long v) { return 0x904L; }
    static long bAt(Rt rt, long b, int i, long d) { return i < rt.bytn ? 0x930L + i : d; }
