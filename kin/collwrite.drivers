    static final long NIL = 0xFFFFL;
    static final long NOT_FOUND = 0xFFFEL;
    static final int TY_ARRAYMAP = 10, TY_HASHMAP = 11, TY_VEC = 12;
    static final int TY_TAGGED = 13, TY_TABLE = 14, TY_TABLEREF = 15;
    static final int TY_MAPENTRY = 16, TY_STR = 17, TY_BYTES = 18;
    static final int TY_CONS = 19, TY_OTHER = 20, TY_SYM = 21;
    static final int TY_SET = 22;
    static final class Val {
        static final long NIL = Probe.NIL;
        static final long NOT_FOUND = Probe.NOT_FOUND;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >>> 40) == 0; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
