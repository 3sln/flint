--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_ARRAYMAP: u8 = 10; const TY_HASHMAP: u8 = 11; const TY_VEC: u8 = 12;
const TY_TAGGED: u8 = 13; const TY_TABLE: u8 = 14; const TY_TABLEREF: u8 = 15;
const TY_MAPENTRY: u8 = 16; const TY_STR: u8 = 17; const TY_BYTES: u8 = 18;
const TY_CONS: u8 = 19; const TY_OTHER: u8 = 20; const TY_SYM: u8 = 21;
// A SET, which `nth` must refuse alongside a map rather than walking it.
const TY_SET: u8 = 22;
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
// `seqn` is how long the walked seq is, and `strn`/`bytn`/`vecn` are the
// bounds the three indexed arms probe against. Each arm has to tell PAST THE
// END from "the element is nil", so each needs a length it can be past.
struct Rt { gc: Gc, bump: u64, roots: Vec<Value>, thrown: String,
            vecn: u32, strn: u32, bytn: u32, seqn: u32, sym: bool }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != NOT_FOUND.0 && (self.0 >> 40) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
fn int(n: i64) -> Value { Value(0x100_0000_0000u64 | (n as u64 & 0xFFFF_FFFF)) }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, _v: Value, i: u32) -> Value { Value(0x700 + i as u64) }
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg); NIL
    }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 8;
        self.gc.sp.m[a as usize] = t;
        Value(a)
    }
    fn is_string(&mut self, v: Value) -> bool { v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_STR }
    fn is_bytes(&mut self, v: Value) -> bool { v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_BYTES }
    fn is_symbol(&mut self, v: Value) -> bool { let _ = v; self.sym }
    fn is_int(&mut self, v: Value) -> bool { (v.0 >> 40) == 1 }
    fn i64_of(&mut self, v: Value) -> i64 { ((v.0 & 0xFFFF_FFFF) as u32) as i32 as i64 }
    fn keyword(&mut self, _ns: Option<&str>, n: &str) -> Value {
        if n == "tag" { Value(0x8A) } else { Value(0x8B) }
    }
    fn name_of(&mut self, _k: Value) -> Value { Value(0x8D) }
    fn value_text(&mut self, _v: Value) -> alloc::string::String { alloc::string::String::from("zz") }
    fn empty_map(&self) -> Value { Value(0x900) }
    fn map_assoc(&mut self, _m: Value, _k: Value, _v: Value) -> Value { Value(0x901) }
    fn vec_assoc(&mut self, _v: Value, i: u32, _x: Value) -> Value { Value(0x910 + i as u64) }
    fn vec_count(&mut self, _v: Value) -> u32 { self.vecn }
    fn new_tagged(&mut self, _t: Value, _f: Value) -> Value { Value(0x902) }
    fn table_assoc(&mut self, _t: Value, _k: Value, _v: Value) -> Value { Value(0x903) }
    fn ref_assoc(&mut self, _r: Value, _k: Value, _v: Value) -> Value { Value(0x904) }
    fn map_entry_as_vec(&mut self, _e: Value) -> Value { self.obj(TY_VEC) }
    fn char_at(&mut self, _s: Value, i: u32, d: Value) -> Value {
        if i < self.strn { Value(0x920 + i as u64) } else { d }
    }
    fn b_at(&mut self, _b: Value, i: u32, d: Value) -> Value {
        if i < self.bytn { Value(0x930 + i as u64) } else { d }
    }
    fn vec_nth(&mut self, _v: Value, i: u32, d: Value) -> Value {
        if i < self.vecn { Value(0x940 + i as u64) } else { d }
    }
    // The seq is modelled as a COUNTDOWN in the value itself, so `next` needs
    // no cells: `0xC000 + k` is a seq with `k` elements left.
    fn seq(&mut self, _c: Value) -> Value {
        if self.seqn == 0 { NIL } else { Value(0xC000 + self.seqn as u64) }
    }
    fn first(&mut self, s: Value) -> Value { Value(0x950 + (s.0 - 0xC000)) }
    fn next(&mut self, s: Value) -> Value {
        if s.0 == 0xC001 { NIL } else { Value(s.0 - 1) }
    }
}
impl Rt {
--rust
}
extern crate alloc;
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 4000] } }, bump: 100,
                      roots: Vec::new(), thrown: String::new(),
                      vecn: 3, strn: 3, bytn: 3, seqn: 3, sym: true };
    let mut o = String::new();
    let k = Value(0x8C);
    let v = Value(0x8E);

    // ASSOC. nil makes a map; every tag has its own arm; the rest refuse.
    o.push_str(&format!("nil={:x} ", rt.coll_assoc_gen(NIL, k, v).0));
    rt.thrown.clear();
    let fx = rt.coll_assoc_gen(Value(7), k, v);
    o.push_str(&format!("fix={:x}|{}| ", fx.0, rt.thrown));
    for t in [TY_ARRAYMAP, TY_HASHMAP, TY_TABLE, TY_TABLEREF, TY_MAPENTRY] {
        let c = rt.obj(t);
        o.push_str(&format!("{:x} ", rt.coll_assoc_gen(c, k, v).0));
    }
    rt.thrown.clear();
    let ot = rt.obj(TY_OTHER);
    let bad = rt.coll_assoc_gen(ot, k, v);
    o.push_str(&format!("oth={:x}|{}| ", bad.0, rt.thrown));

    // A VECTOR takes an index, and ONE PAST THE END APPENDS.
    let vc = rt.obj(TY_VEC);
    o.push_str(&format!("v={:x}/{:x} ", rt.coll_assoc_gen(vc, int(1), v).0,
                        rt.coll_assoc_gen(vc, int(3), v).0));
    rt.thrown.clear();
    let _ = rt.coll_assoc_gen(vc, int(4), v);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.thrown.clear();
    let _ = rt.coll_assoc_gen(vc, int(-1), v);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.thrown.clear();
    let _ = rt.coll_assoc_gen(vc, k, v);
    o.push_str(&format!("|{}| ", rt.thrown));

    // A MAP ENTRY becomes a VECTOR and recurses, so an INDEX lands in the
    // vector arm rather than being refused as a key.
    let me = rt.obj(TY_MAPENTRY);
    o.push_str(&format!("me={:x} ", rt.coll_assoc_gen(me, int(1), v).0));

    // A TAGGED literal takes :tag and :form and refuses by NAME otherwise.
    let tg = rt.obj(TY_TAGGED);
    o.push_str(&format!("t={:x}/{:x} ", rt.coll_assoc_gen(tg, Value(0x8A), v).0,
                        rt.coll_assoc_gen(tg, Value(0x8B), v).0));
    rt.sym = false;
    rt.thrown.clear();
    let _ = rt.coll_assoc_gen(tg, Value(0x8A), v);
    o.push_str(&format!("|{}| ", rt.thrown));
    rt.sym = true;
    rt.thrown.clear();
    let _ = rt.coll_assoc_gen(tg, k, v);
    o.push_str(&format!("|{}| ", rt.thrown));

    // NTH. NOT_FOUND for `dflt` means THERE IS NONE, and every arm raises.
    let d = Value(0x22);
    rt.thrown.clear();
    let _ = rt.coll_nth(vc, k, d);
    o.push_str(&format!("n|{}| ", rt.thrown));
    o.push_str(&format!("neg={:x} ", rt.coll_nth(vc, int(-1), d).0));
    rt.thrown.clear();
    let _ = rt.coll_nth(vc, int(-1), NOT_FOUND);
    o.push_str(&format!("|{}| ", rt.thrown));
    o.push_str(&format!("nil={:x}/{:x} ", rt.coll_nth(NIL, int(0), d).0,
                        rt.coll_nth(NIL, int(0), NOT_FOUND).0));
    let s = rt.obj(TY_STR);
    let b = rt.obj(TY_BYTES);
    let c = rt.obj(TY_CONS);
    o.push_str(&format!("in={:x}/{:x}/{:x}/{:x} ", rt.coll_nth(s, int(1), d).0,
                        rt.coll_nth(b, int(1), d).0, rt.coll_nth(vc, int(1), d).0,
                        rt.coll_nth(c, int(1), d).0));
    o.push_str(&format!("out={:x}/{:x}/{:x}/{:x} ", rt.coll_nth(s, int(9), d).0,
                        rt.coll_nth(b, int(9), d).0, rt.coll_nth(vc, int(9), d).0,
                        rt.coll_nth(c, int(9), d).0));
    for (label, coll) in [("s", s), ("b", b), ("v", vc), ("c", c)] {
        rt.thrown.clear();
        let _ = rt.coll_nth(coll, int(9), NOT_FOUND);
        o.push_str(&format!("{}|{}| ", label, rt.thrown));
    }
    // AN EMPTY SEQ, which is the walk that never enters its body.
    rt.seqn = 0;
    o.push_str(&format!("e={:x}", rt.coll_nth(c, int(0), d).0));
    println!("{}", o);
}
