#pragma warning disable CS8625
    internal const long NIL = 0xFFFFL;
    internal const long NOT_FOUND = 0xFFFEL;
    internal static class Obj {
        internal const int TyArraymap = 10, TyHashmap = 11, TyVec = 12;
        internal const int TyTagged = 13, TyTable = 14, TyTableref = 15;
        internal const int TyMapentry = 16, TyStr = 17, TyBytes = 18;
        internal const int TyCons = 19, TyOther = 20, TySym = 21;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal const long NotFound = Probe.NOT_FOUND;
        internal static bool IsHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >> 40) == 0; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
    }
    internal static long AnInt(long n) { return 0x10000000000L | (n & 0xFFFFFFFFL); }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal string thrown = "";
        internal int vecn = 3, strn = 3, bytn = 3, seqn = 3;
        internal bool sym = true;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Slot(long v, int i) { return 0x700L + i; }
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return NIL; }
        internal long Obj_(int t) { long a = bump; bump += 8; gc.sp.m[(int) a] = (byte) t; return a; }
        internal long NameOf(long k) { return 0x8DL; }
    }
    internal static class Str {
        internal static long Keyword(Rt rt, string ns, string n) { return n == "tag" ? 0x8AL : 0x8BL; }
        internal static long Nth(Rt rt, long s, int i, long d) { return i < rt.strn ? 0x920L + i : d; }
        internal static string Text(Rt rt, long v) { return "zz"; }
    }
    internal static class Num {
        internal static long I64Of(Rt rt, long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    internal static bool IsBytes(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyBytes; }
    internal static bool IsSymbol(Rt rt, long v) { return rt.sym; }
    internal static long MapAssoc(Rt rt, long m, long k, long v) { return 0x901L; }
    internal static class Vec {
        internal static long Assoc(Rt rt, long v, int i, long x) { return 0x910L + i; }
        internal static int Count(Rt rt, long v) { return rt.vecn; }
        internal static long Nth(Rt rt, long v, int i, long d) { return i < rt.vecn ? 0x940L + i : d; }
        internal static long MapEntryAsVec(Rt rt, long e) { return rt.Obj_(Obj.TyVec); }
    }
    internal static long VecAssoc(Rt rt, long v, int i, long x) { return Vec.Assoc(rt, v, i, x); }
    internal static long VecNth(Rt rt, long v, int i, long d) { return Vec.Nth(rt, v, i, d); }
    internal static long Seq(Rt rt, long c) { return rt.seqn == 0 ? NIL : 0xC000L + rt.seqn; }
    internal static long First(Rt rt, long s) { return 0x950L + (s - 0xC000L); }
    internal static long Next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    internal static long NewTagged(Rt rt, long t, long f) { return 0x902L; }
    internal static long BAt(Rt rt, long b, int i, long d) { return i < rt.bytn ? 0x930L + i : d; }
    internal static long TableAssoc(Rt rt, long t, long k, long v) { return 0x903L; }
    internal static long RefAssoc(Rt rt, long r, long k, long v) { return 0x904L; }
    internal static bool IsString(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyStr; }
    internal static bool IsInt(Rt rt, long v) { return (v >> 40) == 1; }
