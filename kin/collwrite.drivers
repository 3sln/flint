        static long nth(Rt rt, long s, int i, long d) { return i < rt.strn ? 0x920L + i : d; }
        static String text(Rt rt, long v) { return "zz"; }
    }
    static final class Num {
        static long i64Of(Rt rt, long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    static boolean isBytes(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_BYTES; }
    static boolean isSymbol(Rt rt, long v) { return rt.sym; }
    static long mapAssoc(Rt rt, long m, long k, long v) { return 0x901L; }
    static int vecCount(Rt rt, long v) { return rt.vecn; }
    static final class Vec {
        static long assoc(Rt rt, long v, int i, long x) { return 0x910L + i; }
        static long nth(Rt rt, long v, int i, long d) { return i < rt.vecn ? 0x940L + i : d; }
