--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long k = 0x8CL, v = 0x8EL;

        o.append("nil=").append(Long.toHexString(collAssocGen(rt, NIL, k, v))).append(' ');
        rt.thrown = "";
        long fx = collAssocGen(rt, 7L, k, v);
        o.append("fix=").append(Long.toHexString(fx)).append("|").append(rt.thrown).append("| ");
        int[] tags = { TY_ARRAYMAP, TY_HASHMAP, TY_TABLE, TY_TABLEREF, TY_MAPENTRY };
        for (int t : tags) o.append(Long.toHexString(collAssocGen(rt, rt.obj(t), k, v))).append(' ');
        rt.thrown = "";
        long ot = rt.obj(TY_OTHER);
        long bad = collAssocGen(rt, ot, k, v);
        o.append("oth=").append(Long.toHexString(bad)).append("|").append(rt.thrown).append("| ");

        long vc = rt.obj(TY_VEC);
        o.append("v=").append(Long.toHexString(collAssocGen(rt, vc, anInt(1), v))).append("/")
         .append(Long.toHexString(collAssocGen(rt, vc, anInt(3), v))).append(' ');
        rt.thrown = "";
        collAssocGen(rt, vc, anInt(4), v);
        o.append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        collAssocGen(rt, vc, anInt(-1), v);
        o.append("|").append(rt.thrown).append("| ");
        rt.thrown = "";
        collAssocGen(rt, vc, k, v);
        o.append("|").append(rt.thrown).append("| ");

        long me = rt.obj(TY_MAPENTRY);
        o.append("me=").append(Long.toHexString(collAssocGen(rt, me, anInt(1), v))).append(' ');

        long tg = rt.obj(TY_TAGGED);
        o.append("t=").append(Long.toHexString(collAssocGen(rt, tg, 0x8AL, v))).append("/")
         .append(Long.toHexString(collAssocGen(rt, tg, 0x8BL, v))).append(' ');
        rt.sym = false;
        rt.thrown = "";
        collAssocGen(rt, tg, 0x8AL, v);
        o.append("|").append(rt.thrown).append("| ");
        rt.sym = true;
        rt.thrown = "";
        collAssocGen(rt, tg, k, v);
        o.append("|").append(rt.thrown).append("| ");

        long d = 0x22L;
        rt.thrown = "";
        collNth(rt, vc, k, d);
        o.append("n|").append(rt.thrown).append("| ");
        o.append("neg=").append(Long.toHexString(collNth(rt, vc, anInt(-1), d))).append(' ');
        rt.thrown = "";
        collNth(rt, vc, anInt(-1), NOT_FOUND);
        o.append("|").append(rt.thrown).append("| ");
        o.append("nil=").append(Long.toHexString(collNth(rt, NIL, anInt(0), d))).append("/")
         .append(Long.toHexString(collNth(rt, NIL, anInt(0), NOT_FOUND))).append(' ');
        long s = rt.obj(TY_STR);
        long b = rt.obj(TY_BYTES);
        long c = rt.obj(TY_CONS);
        o.append("in=").append(Long.toHexString(collNth(rt, s, anInt(1), d))).append("/")
         .append(Long.toHexString(collNth(rt, b, anInt(1), d))).append("/")
         .append(Long.toHexString(collNth(rt, vc, anInt(1), d))).append("/")
         .append(Long.toHexString(collNth(rt, c, anInt(1), d))).append(' ');
        o.append("out=").append(Long.toHexString(collNth(rt, s, anInt(9), d))).append("/")
         .append(Long.toHexString(collNth(rt, b, anInt(9), d))).append("/")
         .append(Long.toHexString(collNth(rt, vc, anInt(9), d))).append("/")
         .append(Long.toHexString(collNth(rt, c, anInt(9), d))).append(' ');
        String[] labels = { "s", "b", "v", "c" };
        long[] colls = { s, b, vc, c };
        for (int j = 0; j < 4; j++) {
            rt.thrown = "";
            collNth(rt, colls[j], anInt(9), NOT_FOUND);
            o.append(labels[j]).append("|").append(rt.thrown).append("| ");
        }
        rt.seqn = 0;
        o.append("e=").append(Long.toHexString(collNth(rt, c, anInt(0), d)));
        System.out.println(o.toString());
    }
