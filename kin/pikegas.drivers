    internal sealed class Rt {
        internal long steps = 0;
        internal void ChargeWork(long n) { steps += n; }
        internal void ChargeBytes(int n) { ChargeWork((n / 8) + 1); }
    }
    static class Str {
        internal static int SBytes(Rt rt, long v) { return (int) v; }
    }
    internal static int SBytes(Rt rt, long v) { return Str.SBytes(rt, v); }
