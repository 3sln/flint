    public static void main(String[] args) {
        Rt rt = new Rt();
        int a = chargeCompile(rt, 7);
        int b = chargeSubject(rt, 64L);
        int c = chargeCompile(rt, 0);
        int d = chargeSubject(rt, 0L);
        System.out.println(a + " " + b + " " + c + " " + d + " " + rt.steps);
    }
