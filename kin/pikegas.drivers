--rust-head
#[derive(Clone, Copy)]
struct Value(u64);
struct Rt { steps: u64 }
impl Rt {
    fn charge_work(&mut self, n: u64) { self.steps += n; }
    fn charge_bytes(&mut self, n: u32) { self.charge_work((n as u64 / 8) + 1); }
    fn s_bytes(&mut self, v: Value) -> u32 { v.0 as u32 }
--rust
}
fn main() {
    let mut rt = Rt { steps: 0 };
    // A COMPILE charges per program word; a SUBJECT charges per byte. Both
    // answer what they charged, and `steps` is the running total.
    let a = rt.charge_compile(7);
    let b = rt.charge_subject(Value(64));
    let c = rt.charge_compile(0);
    let d = rt.charge_subject(Value(0));
    println!("{} {} {} {} {}", a, b, c, d, rt.steps);
}
--java-head
    static final class Rt {
        long steps = 0;
        void chargeWork(long n) { steps += n; }
        void chargeBytes(int n) { chargeWork((n / 8) + 1); }
    }
    static final class Str {
        static int sBytes(Rt rt, long v) { return (int) v; }
    }
    static int sBytes(Rt rt, long v) { return Str.sBytes(rt, v); }
