            for (int i = 0; i < rt.LeafLen(v); i++) if (rt.LeafByte(v, i) >= 0x80) return false;
            return true;
        }
        for (int i = 0; i < RopeKids(rt, v); i++)
            if (!SAscii(rt, rt.Slot(v, global::Flint.Rt.Str.RP_KIDS + i))) return false;
        return true;
