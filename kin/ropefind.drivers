    // tested every 64th tick, which is what bounds a starving loop's overshoot.
    fn charge_tick(&mut self, i: u64, n: u64, _w: &str) -> bool {
        self.gas += n;
        if (i & 63) != 0 { return true; }
        !(self.limit != 0 && self.gas >= self.limit)
