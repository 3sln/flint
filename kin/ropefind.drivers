    static String shown(Rt rt, long h, long n, int f) {
        long v = sIndexOf(rt, h, n, f);
        return Val.isNil(v) ? "-" : Long.toString(Val.asFixnum(v));
    }
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long hf = flat(rt, new int[]{97,98,99,97,98,99});
        long h3 = node(rt, new long[]{flat(rt, new int[]{97}), flat(rt, new int[]{98,99}),
                                      flat(rt, new int[]{97,98,99})});
