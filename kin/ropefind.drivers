    }
    internal static long Node(Rt rt, long[] kids) {
        long a = rt.Alloc(Obj.TyRope, global::Flint.Rt.Str.RP_KIDS + kids.Length);
        rt.Set(a, global::Flint.Rt.Str.RP_FLAT, Val.Nil);
        rt.Set(a, global::Flint.Rt.Str.RP_HASH, Val.Nil);
        for (int i = 0; i < kids.Length; i++) rt.Set(a, global::Flint.Rt.Str.RP_KIDS + i, kids[i]);
        return Val.Heap(a);
    }
    internal static string Show(Rt rt, long v) {
        var s = new System.Text.StringBuilder();
        for (int i = 0; i < Olen(rt, v); i++) {
            if (i > 0) s.Append('.');
            s.Append(rt.gc.sp.ReadU8(v + Obj.StrData + i));
        }
        return s.ToString();
    }
