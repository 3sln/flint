        o.append("empty=").append(shown(rt, h3, empty, 0)).append(",")
         .append(shown(rt, h3, empty, 2)).append(",")
         .append(shown(rt, h3, empty, 99)).append(" ");
        long long9 = flat(rt, new int[]{97,98,99,97,98,99,97,98,99});
        o.append("long=").append(shown(rt, h3, long9, 0)).append(" ");
        long hm = node(rt, new long[]{flat(rt, new int[]{97,0xCE}), flat(rt, new int[]{0xB2,99})});
        long c1 = flat(rt, new int[]{99});
        long beta = flat(rt, new int[]{0xCE,0xB2});
        o.append("utf8=").append(shown(rt, hm, c1, 0)).append(",")
         .append(shown(rt, hm, beta, 0)).append(" ");
        long ndrope = node(rt, new long[]{flat(rt, new int[]{97}), flat(rt, new int[]{98,99})});
        int before = rt.flattens;
        o.append("ropeneedle=").append(shown(rt, h3, ndrope, 0)).append(" ");
        o.append("needleflat=").append(rt.flattens - before).append(" ");
        o.append("flattens=").append(rt.flattens).append(" ");
