    }
    internal static long SFlatten(Rt rt, long v) {
        if (!IsRope(rt, v)) return v;
        rt.flattens++;
        var bs = new System.Collections.Generic.List<int>();
        int w = rt.WalkOpen(v);
        while (true) {
            long l = rt.WalkNext(w);
            if (Val.IsNil(l)) break;
            for (int i = 0; i < rt.LeafLen(l); i++) bs.Add(rt.LeafByte(l, i));
