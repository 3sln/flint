                if (self.leaf_byte(l, i) & 0xC0) != 0x80 { seen += 1; }
                bytes += 1;
            }
        }
        self.walk_close(w);
        if seen == k { bytes } else { bytes }
    }
    fn s_count(&self, v: Value) -> u32 {
        if !self.is_rope(v) {
            let mut c = 0;
            for i in 0..self.leaf_len(v) { if (self.leaf_byte(v, i) & 0xC0) != 0x80 { c += 1; } }
            return c;
        }
        let mut c = 0;
        for i in 0..self.rope_kids(v) { c += self.s_count(self.slot(v, obj::RP_KIDS + i)); }
        c
    }
