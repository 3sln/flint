            byte[] a = sinks.get(s).toByteArray();
            int[] bs = new int[a.length];
            for (int i = 0; i < a.length; i++) bs[i] = a[i] & 0xFF;
            return flat(this, bs);
        }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static int olen(Rt rt, long v) { return rt.lens[(int) v]; }
    static boolean isRope(Rt rt, long v) {
        return Val.isHeap(v) && ty(rt.gc.sp, v) == TY_ROPE;
    }
    static int ropeKids(Rt rt, long v) { return olen(rt, v) - Str.RP_KIDS; }
    static boolean sAscii(Rt rt, long v) {
        if (!isRope(rt, v)) {
            for (int i = 0; i < rt.leafLen(v); i++) if (rt.leafByte(v, i) >= 0x80) return false;
            return true;
        }
        for (int i = 0; i < ropeKids(rt, v); i++)
            if (!sAscii(rt, rt.slot(v, Str.RP_KIDS + i))) return false;
        return true;
    }
    static int ropeByteOfCp(Rt rt, long v, int k) {
        int seen = 0, bytes = 0;
        int w = rt.walkOpen(v);
        while (true) {
            long l = rt.walkNext(w);
            if (Val.isNil(l)) break;
            for (int i = 0; i < rt.leafLen(l); i++) {
                if (seen == k) { rt.walkClose(w); return bytes; }
                if ((rt.leafByte(l, i) & 0xC0) != 0x80) seen++;
                bytes++;
            }
        }
        rt.walkClose(w);
        return bytes;
    }
    static int sCount(Rt rt, long v) {
        if (!isRope(rt, v)) {
            int c = 0;
            for (int i = 0; i < rt.leafLen(v); i++)
                if ((rt.leafByte(v, i) & 0xC0) != 0x80) c++;
            return c;
        }
        int c = 0;
        for (int i = 0; i < ropeKids(rt, v); i++) c += sCount(rt, rt.slot(v, Str.RP_KIDS + i));
        return c;
    }
    static long sFlatten(Rt rt, long v) {
        if (!isRope(rt, v)) return v;
        rt.flattens++;
        java.util.ArrayList<Integer> bs = new java.util.ArrayList<>();
        int w = rt.walkOpen(v);
        while (true) {
            long l = rt.walkNext(w);
            if (Val.isNil(l)) break;
            for (int i = 0; i < rt.leafLen(l); i++) bs.add(rt.leafByte(l, i));
        }
        rt.walkClose(w);
        int[] out = new int[bs.size()];
        for (int i = 0; i < out.length; i++) out[i] = bs.get(i);
        return flat(rt, out);
    }
    static long flat(Rt rt, int[] bs) {
        long a = rt.alloc(TY_STR, bs.length);
        for (int i = 0; i < bs.length; i++) rt.gc.sp.m[(int) (a + Obj.STR_DATA) + i] = (byte) bs[i];
        return Val.heap(a);
    }
    static long inlineOf(int[] bs) {
        long v = (0xEL << 60) | ((long) bs.length << 56);
        for (int i = 0; i < bs.length; i++) v |= ((long) bs[i]) << (8 * i);
        return v;
    }
    static long node(Rt rt, long[] kids) {
        long a = rt.alloc(TY_ROPE, Str.RP_KIDS + kids.length);
        rt.set(a, Str.RP_FLAT, NIL);
        rt.set(a, Str.RP_HASH, NIL);
        for (int i = 0; i < kids.length; i++) rt.set(a, Str.RP_KIDS + i, kids[i]);
        return Val.heap(a);
    }
    static String show(Rt rt, long v) {
        StringBuilder s = new StringBuilder();
        for (int i = 0; i < olen(rt, v); i++) {
            if (i > 0) s.append('.');
            s.append(rt.gc.sp.readU8(v + Obj.STR_DATA + i));
        }
        return s.toString();
    }
