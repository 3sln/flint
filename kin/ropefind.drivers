fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
// The answer is a fixnum or NIL; print NIL as `-` so a missing match is
// visible rather than printed as whatever the sentinel happens to be.
fn shown(rt: &mut Rt, h: Value, n: Value, f: u32) -> alloc::string::String {
    let v = rt.s_index_of(h, n, f);
    if v.is_nil() { alloc::string::String::from("-") } else { alloc::format!("{}", v.as_fixnum()) }
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      sinks: Vec::new(), walks: Vec::new(), gas: 0, limit: 0, flattens: 0 };
    let mut o = String::new();
    // "abcabc" as one leaf, as three, and with an inline leaf in the middle.
    let hf = rt.flat(&[97,98,99,97,98,99]);
    let h3 = { let a = rt.flat(&[97]); let b = rt.flat(&[98,99]); let c = rt.flat(&[97,98,99]);
               rt.node(&[a,b,c]) };
    let hi = { let a = rt.flat(&[97]); let b = rt.inline_of(&[98,99,97]); let c = rt.flat(&[98,99]);
               rt.node(&[a,b,c]) };
    let abc = rt.flat(&[97,98,99]);
    let cab = rt.flat(&[99,97,98]);
    let zz  = rt.flat(&[122,122]);
    o.push_str(&format!("shape={},{},{} ", shown(&mut rt, hf, abc, 0),
                        shown(&mut rt, h3, abc, 0), shown(&mut rt, hi, abc, 0)));
    o.push_str(&format!("cab={},{},{} ", shown(&mut rt, hf, cab, 0),
                        shown(&mut rt, h3, cab, 0), shown(&mut rt, hi, cab, 0)));
    o.push_str(&format!("absent={},{} ", shown(&mut rt, hf, zz, 0), shown(&mut rt, h3, zz, 0)));
    // ACROSS A BOUNDARY: `cab` spans all three leaves of [ab][ca][bc].
    let hb = { let a = rt.flat(&[97,98]); let b = rt.flat(&[99,97]); let c = rt.flat(&[98,99]);
               rt.node(&[a,b,c]) };
    o.push_str(&format!("span={} ", shown(&mut rt, hb, cab, 0)));
    // A FAILED MATCH MUST RESUME AT THE NEXT BYTE. In "aab" the first `a`
    // starts a match of "ab" that fails on the second byte; the answer is 1,
    // and a walk that resumed after the failed run would say -1.
    let haa = { let a = rt.flat(&[97]); let b = rt.flat(&[97,98]); rt.node(&[a,b]) };
    let ab = rt.flat(&[97,98]);
    o.push_str(&format!("resume={} ", shown(&mut rt, haa, ab, 0)));
    // FROM: at, before and after the second occurrence, and out of range.
    o.push_str(&format!("from={},{},{},{} ", shown(&mut rt, h3, abc, 1),
                        shown(&mut rt, h3, abc, 3), shown(&mut rt, h3, abc, 4),
                        shown(&mut rt, h3, abc, 99)));
    // EMPTY NEEDLE: found where the search starts, and not found past the end.
    let empty = rt.flat(&[]);
    o.push_str(&format!("empty={},{},{} ", shown(&mut rt, h3, empty, 0),
                        shown(&mut rt, h3, empty, 2), shown(&mut rt, h3, empty, 99)));
    // LONGER THAN THE HAYSTACK, and running off the end mid-match.
    let long9 = rt.flat(&[97,98,99,97,98,99,97,98,99]);
    o.push_str(&format!("long={} ", shown(&mut rt, h3, long9, 0)));
    // MULTI-BYTE. "aβc" is 61 CE B2 63: the answer for "c" is code point 2,
    // not byte offset 3, and the two-byte character is split ACROSS leaves so
    // a continuation byte is the first thing in a leaf.
    let hm = { let a = rt.flat(&[97,0xCE]); let b = rt.flat(&[0xB2,99]); rt.node(&[a,b]) };
    let c1 = rt.flat(&[99]);
    let beta = rt.flat(&[0xCE,0xB2]);
    o.push_str(&format!("utf8={},{} ", shown(&mut rt, hm, c1, 0), shown(&mut rt, hm, beta, 0)));
    // A ROPE NEEDLE is the one thing that MAY be made contiguous, because it
    // is bounded by the pattern rather than the data.
    let ndrope = { let a = rt.flat(&[97]); let b = rt.flat(&[98,99]); rt.node(&[a,b]) };
    let before = rt.flattens;
    o.push_str(&format!("ropeneedle={} ", shown(&mut rt, h3, ndrope, 0)));
    o.push_str(&format!("needleflat={} ", rt.flattens - before));
    // THE CLAIM: no haystack was ever materialised. Every call above passed a
    // rope as the haystack and only the rope NEEDLE above should have counted.
    o.push_str(&format!("flattens={} ", rt.flattens));
    // GAS: billed, and the same for the same bytes in different shapes.
    rt.gas = 0; rt.s_index_of(hf, cab, 0); let g1 = rt.gas;
    rt.gas = 0; rt.s_index_of(h3, cab, 0); let g2 = rt.gas;
    o.push_str(&format!("gas={},{} ", g1, g2));
    // STARVED: a limit too small stops the scan and answers "not found".
    rt.gas = 0; rt.limit = 3;
    o.push_str(&format!("starved={} ", shown(&mut rt, hf, zz, 0)));
    rt.limit = 0;
    println!("{}", o);
}
