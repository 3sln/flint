    internal static int RopeByteOfCp(Rt rt, long v, int k) {
        int seen = 0, bytes = 0;
        int w = rt.WalkOpen(v);
        while (true) {
            long l = rt.WalkNext(w);
            if (Val.IsNil(l)) break;
            for (int i = 0; i < rt.LeafLen(l); i++) {
                if (seen == k) { rt.WalkClose(w); return bytes; }
                if ((rt.LeafByte(l, i) & 0xC0) != 0x80) seen++;
                bytes++;
