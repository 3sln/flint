        self.flattens += 1;
        let mut bs: alloc::vec::Vec<u8> = alloc::vec::Vec::new();
        let w = self.walk_open(v);
        loop {
            let l = self.walk_next(w);
            if l.is_nil() { break; }
            for i in 0..self.leaf_len(l) { bs.push(self.leaf_byte(l, i) as u8); }
        }
        self.walk_close(w);
        self.flat(&bs)
    }
