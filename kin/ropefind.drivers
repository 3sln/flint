        o.append("shape=").append(shown(rt, hf, abc, 0)).append(",")
         .append(shown(rt, h3, abc, 0)).append(",")
         .append(shown(rt, hi, abc, 0)).append(" ");
        o.append("cab=").append(shown(rt, hf, cab, 0)).append(",")
         .append(shown(rt, h3, cab, 0)).append(",")
         .append(shown(rt, hi, cab, 0)).append(" ");
        o.append("absent=").append(shown(rt, hf, zz, 0)).append(",")
         .append(shown(rt, h3, zz, 0)).append(" ");
        long hb = node(rt, new long[]{flat(rt, new int[]{97,98}), flat(rt, new int[]{99,97}),
                                      flat(rt, new int[]{98,99})});
        o.append("span=").append(shown(rt, hb, cab, 0)).append(" ");
        long haa = node(rt, new long[]{flat(rt, new int[]{97}), flat(rt, new int[]{97,98})});
        long ab = flat(rt, new int[]{97,98});
        o.append("resume=").append(shown(rt, haa, ab, 0)).append(" ");
        o.append("from=").append(shown(rt, h3, abc, 1)).append(",")
         .append(shown(rt, h3, abc, 3)).append(",")
         .append(shown(rt, h3, abc, 4)).append(",")
         .append(shown(rt, h3, abc, 99)).append(" ");
