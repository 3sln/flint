            for i in 0..self.leaf_len(v) { if self.leaf_byte(v, i) >= 0x80 { return false; } }
            return true;
        }
        for i in 0..self.rope_kids(v) {
            if !self.s_ascii(self.slot(v, obj::RP_KIDS + i)) { return false; }
        }
        true
