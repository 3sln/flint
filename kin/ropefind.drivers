    fn rope_byte_of_cp(&mut self, v: Value, k: u32) -> u32 {
        let mut seen = 0u32;
        let mut bytes = 0u32;
        let w = self.walk_open(v);
        loop {
            let l = self.walk_next(w);
            if l.is_nil() { break; }
            for i in 0..self.leaf_len(l) {
