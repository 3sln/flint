--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_SCHEMA: u8 = 48; const TY_TABLEREF: u8 = 50; const TY_TABLE: u8 = 49;
const TY_NODE: u8 = 12;
const TY_VEC: u8 = 9; const TY_MAP: u8 = 14; const TY_MAPENTRY: u8 = 15;
pub mod table {
    pub const CH_ROWS: u32 = 0; pub const CH_ENC: u32 = 1;
    pub const TB_SCHEMA: u32 = 0; pub const TB_CHUNKS: u32 = 1;
    pub const TB_COUNT: u32 = 2; pub const TB_OFFSET: u32 = 3;
    pub const TB_LEN: u32 = 4; pub const CH_BASE: u32 = 2;
    pub const CHUNK: u32 = 4; pub const CHUNK_SHIFT: u32 = 2;
    pub const ENC_CONST: u32 = 1;
    pub const SC_NAMES: u32 = 0; pub const SC_TYPES: u32 = 1; pub const SC_INDEX: u32 = 2;
    pub const SC_IDS: u32 = 3; pub const SC_WIDTH: u32 = 4; pub const SC_LEN: u32 = 5;
    pub const RF_SCHEMA: u32 = 0; pub const RF_LEN: u32 = 3;
}
// A KEYWORD IS A TAGGED INDEX into a host name table, and the "string" that is
// its name is the same index under a different tag. The probe never needs
// string BYTES -- `kw-name` asks a keyword for its name and a name for its
// text, and both are one lookup -- so modelling them as heap objects would be
// machinery the fixture does not exercise.
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != NOT_FOUND.0
                               && (self.0 >> 60) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
    fn as_fixnum(self) -> i64 {
        let raw = (self.0 & 0xFFFF_FFFF) as i64;
        if raw >= 0x8000_0000 { raw - 0x1_0000_0000 } else { raw }
    }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn kw(i: u32) -> Value { Value((0xAu64 << 60) | i as u64) }
    fn is_kw(self) -> bool { (self.0 >> 60) == 0xA }
    fn name(i: u32) -> Value { Value((0xBu64 << 60) | i as u64) }
    fn is_name(self) -> bool { (self.0 >> 60) == 0xB }
    fn idx(self) -> u32 { (self.0 & 0xFFFF) as u32 }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>,
            names: Vec<alloc::string::String>, msg: alloc::string::String, thrown: Value,
            gas: u64, calls: u32 }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn obj(&mut self, t: u8, n: u32) -> Value { let a = self.alloc(t, n); Value::heap(a) }
    fn vec_count(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn vec_nth(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        if i >= self.vec_count(v) { dflt } else { self.slot(v, i) }
    }
    fn vector(&mut self, xs: &[Value]) -> Value {
        let a = self.alloc(TY_VEC, xs.len().max(1) as u32);
        self.lens[a as usize] = xs.len() as u32;
        for (i, x) in xs.iter().enumerate() { self.h[a as usize + i] = x.0; }
        Value::heap(a)
    }
    fn keyword(&mut self, t: &str) -> Value {
        self.names.push(alloc::string::String::from(t));
        Value::kw(self.names.len() as u32 - 1)
    }
    fn name_of(&mut self, v: Value) -> Value {
        if v.is_kw() { Value::name(v.idx()) } else { NIL }
    }
    fn is_string(&self, v: Value) -> bool { v.is_name() }
    fn value_text(&mut self, v: Value) -> alloc::string::String {
        self.names[v.idx() as usize].clone()
    }
    // THE PROBE'S CLOSED SET, small enough to see: the words a message uses.
    fn kind_of(&mut self, v: Value) -> Value {
        if v.is_fixnum() { return self.keyword("number"); }
        if v.is_kw() { return self.keyword("keyword"); }
        if v.is_name() { return self.keyword("string"); }
        if !v.is_heap() { return self.keyword("other"); }
        match ty(&self.gc.sp, v.as_heap()) {
            TY_VEC => self.keyword("vector"),
            TY_MAP => self.keyword("map"),
            _ => self.keyword("other"),
        }
    }
    fn slot_or_nth_pub(&mut self, v: Value, i: u32) -> Value {
        if ty(&self.gc.sp, v.as_heap()) == TY_MAPENTRY { self.slot(v, i) }
        else { self.vec_nth(v, i, NIL) }
    }
    fn empty_map(&mut self) -> Value { let a = self.alloc(TY_MAP, 1); self.lens[a as usize] = 0; Value::heap(a) }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let a = self.alloc(TY_MAP, n + 2);
        self.lens[a as usize] = n + 2;
        for i in 0..n { self.h[a as usize + i as usize] = self.h[m.0 as usize + i as usize]; }
        self.h[a as usize + n as usize] = k.0;
        self.h[a as usize + n as usize + 1] = v.0;
        Value::heap(a)
    }
    fn is_map(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_MAP
    }
    fn map_count(&self, m: Value) -> u32 { self.lens[m.0 as usize] / 2 }
    // A MAP AS A SEQ of entries: a vector of `[k v]` MAP ENTRIES, and `next`
    // drops the head. `first-foreign-key` walks one.
    fn entry(&mut self, k: Value, v: Value) -> Value {
        let a = self.alloc(TY_MAPENTRY, 2);
        self.h[a as usize] = k.0; self.h[a as usize + 1] = v.0;
        Value::heap(a)
    }
    fn seq(&mut self, m: Value) -> Value {
        let n = self.lens[m.0 as usize];
        if n == 0 { return NIL; }
        let mut es = alloc::vec::Vec::new();
        let mut i = 0;
        while i < n {
            let (k, v) = (self.slot(m, i), self.slot(m, i + 1));
            let e = self.entry(k, v);
            es.push(e);
            i += 2;
        }
        self.vector(&es)
    }
    fn first(&mut self, q: Value) -> Value { self.vec_nth(q, 0, NIL) }
    fn next(&mut self, q: Value) -> Value {
        let n = self.vec_count(q);
        if n <= 1 { return NIL; }
        let rest: alloc::vec::Vec<Value> = (1..n).map(|i| self.slot(q, i)).collect();
        self.vector(&rest)
    }
    fn throw_str(&mut self, _kind: &str, msg: &alloc::string::String) -> Value {
        self.msg = msg.clone();
        NIL
    }
    fn charge_work(&mut self, _n: u64) {}
    // The siblings from `tablemeta`, `tableref` and `tablecell`.
    fn schema_len(&self, s: Value) -> u32 { self.vec_count(self.slot(s, table::SC_NAMES)) }
    fn schema_width(&mut self, s: Value) -> u32 { self.slot(s, table::SC_WIDTH).as_fixnum() as u32 }
    fn schema_id(&mut self, s: Value, name: Value) -> u32 {
        let idx = self.slot(s, table::SC_INDEX);
        let n = self.lens[idx.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(idx, i).0 == name.0 { return self.slot(idx, i + 1).as_fixnum() as u32; }
            i += 2;
        }
        self.schema_width(s)
    }
    fn is_table_ref(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_TABLEREF
    }
    fn row_column(&mut self, s: Value, row: Value, c: u32) -> Value {
        let name = self.schema_name_at(s, c);
        let n = self.lens[row.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(row, i).0 == name.0 { return self.slot(row, i + 1); }
            i += 2;
        }
        NOT_FOUND
    }
    fn schema(&mut self, names: &[Value], types: &[Value]) -> Value {
        let s = self.obj(TY_SCHEMA, table::SC_LEN);
        let nv = self.vector(names);
        self.set(s, table::SC_NAMES, nv);
        let tv = self.vector(types);
        self.set(s, table::SC_TYPES, tv);
        let ids: alloc::vec::Vec<Value> =
            (0..names.len()).map(|i| Value::fixnum(i as i64)).collect();
        let iv = self.vector(&ids);
        self.set(s, table::SC_IDS, iv);
        self.set(s, table::SC_WIDTH, Value::fixnum(names.len() as i64));
        let mut idx = self.empty_map();
        for (i, n) in names.iter().enumerate() { idx = self.map_assoc(idx, *n, Value::fixnum(i as i64)); }
        self.set(s, table::SC_INDEX, idx);
        s
    }
}
impl Rt {
    fn empty_vec(&mut self) -> Value { self.vector(&[]) }
    fn is_int(&self, v: Value) -> bool { v.is_fixnum() }
    // THE PROBE'S CLOSURE is a SUM: `f(acc, v) = acc + v`. What the fixture is
    // about is that the two arguments arrive in the right ORDER and from the
    // right ROOTS, which a sum shows and a commutative-blind one would not --
    // so the cell is doubled before adding.
    fn invoke_roots(&mut self, _f: Value, base: usize, n: u32) -> Value {
        self.calls += 1;
        let acc = self.r(base).as_fixnum();
        let v = if n > 1 { self.r(base + 1).as_fixnum() } else { 0 };
        Value::fixnum(acc + 2 * v)
    }
    fn charge_tick(&mut self, _i: u64, n: u64, _where: &str) -> bool {
        self.gas = self.gas.saturating_sub(n);
        self.gas > 0
    }

    fn table_offset(&mut self, t: Value) -> u32 {
        self.slot(t, table::TB_OFFSET).as_fixnum() as u32
    }
    fn i64_of(&self, v: Value) -> i64 { if v.is_fixnum() { v.as_fixnum() } else { 0 } }
    fn vec_assoc(&mut self, v: Value, i: u32, x: Value) -> Value {
        let n = self.vec_count(v);
        let mut xs: alloc::vec::Vec<Value> = (0..n).map(|k| self.slot(v, k)).collect();
        xs[i as usize] = x;
        self.vector(&xs)
    }
    // `check-row` and the FILL half are generated elsewhere; the probe brings
    // its own. The check accepts every row: this fixture is about where a row
    // GOES, not whether it is well-typed.
    fn check_row(&mut self, _s: Value, _row: Value, _rowno: u32) -> bool { true }
    fn write_row(&mut self, s: Value, ch: Value, k: u32, row: Value) {
        let n = self.schema_len(s);
        for c in 0..n {
            let id = self.schema_id_at(s, c);
            let name = self.schema_name_at(s, c);
            let v = self.map_get(row, name, NIL);
            let col = self.slot(ch, table::CH_BASE + id);
            self.set(col, k, v);
        }
    }
    fn chunk_with_row(&mut self, s: Value, ch: Value, k: u32, row: Value, grow: bool) -> Value {
        let old = self.chunk_rows(ch);
        let take = if grow { old + 1 } else { old };
        let carry = if old > take { take } else { old };
        let w = self.schema_width(s);
        let nch = self.new_chunk(w, take);
        let ncols = self.schema_len(s);
        for c in 0..ncols {
            let id = self.schema_id_at(s, c);
            let name = self.schema_name_at(s, c);
            let newv = self.map_get(row, name, NIL);
            let col = self.new_obj(TY_NODE, if take < 1 { 1 } else { take });
            for j in 0..carry {
                let v = self.cell(ch, id, j);
                self.set(col, j, v);
            }
            self.set(col, k, newv);
            self.set(nch, table::CH_BASE + id, col);
            self.collapse(nch, id);
        }
        nch
    }
    fn show_rows(&mut self, t: Value, ncols: u32) -> alloc::string::String {
        let n = self.slot(t, table::TB_COUNT).as_fixnum() as u32;
        let off = self.slot(t, table::TB_OFFSET).as_fixnum() as u32;
        let chunks = self.slot(t, table::TB_CHUNKS);
        let s = self.slot(t, table::TB_SCHEMA);
        let mut out = alloc::vec::Vec::new();
        for i in 0..n {
            let phys = i + off;
            let ch = self.vec_nth(chunks, phys >> table::CHUNK_SHIFT, NIL);
            let mut cells = alloc::vec::Vec::new();
            for c in 0..ncols {
                let id = self.schema_id_at(s, c);
                let v = self.cell(ch, id, phys & (table::CHUNK - 1));
                cells.push(if v.is_name() { self.value_text(v) }
                           else { alloc::format!("{}", v.as_fixnum()) });
            }
            out.push(cells.join("/"));
        }
        out.join(".")
    }

    fn new_table(&mut self, schema: Value, rows: Value) -> Value {
        let ncols = self.schema_len(schema);
        let width = self.schema_width(schema);
        let nrows = self.vec_count(rows);
        let mut chunks = alloc::vec::Vec::new();
        let mut row = 0u32;
        while row < nrows {
            let take = if nrows - row > table::CHUNK { table::CHUNK } else { nrows - row };
            let ch = self.new_chunk(width, take);
            for c in 0..ncols {
                let id = self.schema_id_at(schema, c);
                let name = self.schema_name_at(schema, c);
                let col = self.new_obj(TY_NODE, take);
                for k in 0..take {
                    let rv = self.vec_nth(rows, row + k, NIL);
                    let v = self.map_get(rv, name, NIL);
                    self.set(col, k, v);
                }
                self.set(ch, table::CH_BASE + id, col);
                self.collapse(ch, id);
            }
            chunks.push(ch);
            row += take;
        }
        let cv = self.vector(&chunks);
        let t = self.obj(TY_TABLE, table::TB_LEN);
        self.set(t, table::TB_SCHEMA, schema);
        self.set(t, table::TB_CHUNKS, cv);
        self.set(t, table::TB_COUNT, Value::fixnum(nrows as i64));
        self.set(t, table::TB_OFFSET, Value::fixnum(0));
        t
    }
    fn schema_type_at(&mut self, s: Value, c: u32) -> Value {
        let types = self.slot(s, table::SC_TYPES);
        self.vec_nth(types, c, NIL)
    }
    fn schema_pos_of(&mut self, s: Value, name: Value) -> u32 {
        let n = self.schema_len(s);
        for c in 0..n {
            let nm = self.schema_name_at(s, c);
            if nm.0 == name.0 { return c; }
        }
        0
    }
    fn val_eq(&mut self, a: Value, b: Value) -> bool { a.0 == b.0 }
    fn chunk_rows(&mut self, ch: Value) -> u32 { self.slot(ch, table::CH_ROWS).as_fixnum() as u32 }
    // A SCHEMA WITH EXPLICIT IDS, which is what a migrated one has: the ids
    // are not the positions any more.
    fn schema_ids(&mut self, names: &[Value], types: &[Value], ids: &[Value], width: u32) -> Value {
        let s = self.obj(TY_SCHEMA, table::SC_LEN);
        let nv = self.vector(names);
        self.set(s, table::SC_NAMES, nv);
        let tv = self.vector(types);
        self.set(s, table::SC_TYPES, tv);
        let iv = self.vector(ids);
        self.set(s, table::SC_IDS, iv);
        self.set(s, table::SC_WIDTH, Value::fixnum(width as i64));
        let mut idx = self.empty_map();
        for (i, n) in names.iter().enumerate() {
            let idv = ids[i];
            idx = self.map_assoc(idx, *n, idv);
        }
        self.set(s, table::SC_INDEX, idx);
        s
    }
    fn show_schema(&mut self, s: Value) -> alloc::string::String {
        let n = self.schema_len(s);
        let mut out = alloc::vec::Vec::new();
        for c in 0..n {
            let nm = self.schema_name_at(s, c);
            let id = self.schema_id_at(s, c);
            let t = self.kw_text_of(nm);
            out.push(alloc::format!("{}@{}", t, id));
        }
        alloc::format!("{}/w{}", out.join("."), self.schema_width(s))
    }

    // CHUNKS, minimally: a vector of `[rows, enc, col0 …]` with the encoding
    // vector at `CH_ENC`. Enough for `collapse` to have somewhere to record.
    fn new_obj(&mut self, t: u8, n: u32) -> Value {
        let a = self.alloc(t, n);
        self.lens[a as usize] = n;
        Value::heap(a)
    }
    fn new_chunk(&mut self, width: u32, rows: u32) -> Value {
        let ch = self.new_obj(TY_VEC, table::CH_BASE + width);
        self.set(ch, table::CH_ROWS, Value::fixnum(rows as i64));
        let enc = self.new_obj(TY_VEC, if width < 1 { 1 } else { width });
        for id in 0..width { self.set(enc, id, Value::fixnum(0)); }
        self.set(ch, table::CH_ENC, enc);
        ch
    }
    fn collapse(&mut self, ch: Value, id: u32) {
        let col = self.slot(ch, table::CH_BASE + id);
        let n = self.lens[col.0 as usize];
        if n == 0 { return; }
        let first = self.slot(col, 0);
        for k in 1..n { if self.slot(col, k).0 != first.0 { return; } }
        self.set(ch, table::CH_BASE + id, first);
        let e = self.slot(ch, table::CH_ENC);
        self.set(e, id, Value::fixnum(1));
    }
    fn schema_id_at(&mut self, s: Value, c: u32) -> u32 {
        let ids = self.slot(s, table::SC_IDS);
        self.vec_nth(ids, c, NIL).as_fixnum() as u32
    }
    fn schema_name_at(&mut self, s: Value, c: u32) -> Value {
        let names = self.slot(s, table::SC_NAMES);
        self.vec_nth(names, c, NIL)
    }
    fn type_ok(&mut self, t: Value, v: Value) -> bool {
        let nm = self.name_of(t);
        let s = self.value_text(nm);
        match s.as_str() {
            "any" => true,
            "int" => v.is_fixnum(),
            "string" => self.is_string(v),
            _ => false,
        }
    }
    fn column_type_error(&mut self, name: Value, want: Value, got: Value, row: u32)
        -> alloc::string::String {
        let nm = self.kw_text_of(name);
        let wt = self.kw_text_of(want);
        let gk = self.kind_of(got);
        let gt = self.kw_text_of(gk);
        alloc::format!("row {}, column :{} holds :{} and was given a {}", row, nm, wt, gt)
    }
    // A CHUNK'S ENCODING and its cells, for the fixture to show.
    fn chunk_enc(&mut self, ch: Value, id: u32) -> u32 {
        let e = self.slot(ch, table::CH_ENC);
        self.slot(e, id).as_fixnum() as u32
    }
    fn cell(&mut self, ch: Value, id: u32, row: u32) -> Value {
        let col = self.slot(ch, table::CH_BASE + id);
        if self.chunk_enc(ch, id) == 1 { col } else { self.slot(col, row) }
    }
    fn show_table(&mut self, t: Value, ncols: u32) -> alloc::string::String {
        let chunks = self.slot(t, table::TB_CHUNKS);
        let nch = self.vec_count(chunks);
        let mut out = alloc::vec::Vec::new();
        for w in 0..nch {
            let ch = self.slot(chunks, w);
            let rows = self.slot(ch, table::CH_ROWS).as_fixnum() as u32;
            let mut cols = alloc::vec::Vec::new();
            for id in 0..ncols {
                let e = self.chunk_enc(ch, id);
                let mut cells = alloc::vec::Vec::new();
                for r in 0..rows {
                    let v = self.cell(ch, id, r);
                    cells.push(if v.is_kw() { self.kw_text_of(v) }
                               else if v.is_name() { self.value_text(v) }
                               else { alloc::format!("{}", v.as_fixnum()) });
                }
                cols.push(alloc::format!("{}[{}]", e, cells.join(".")));
            }
            out.push(cols.join(","));
        }
        alloc::format!("{}|{}", self.slot(t, table::TB_COUNT).as_fixnum(), out.join(";"))
    }

    fn is_keyword(&self, v: Value) -> bool { v.is_kw() }
    fn map_get(&mut self, m: Value, k: Value, dflt: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(m, i).0 == k.0 { return self.slot(m, i + 1); }
            i += 2;
        }
        dflt
    }
    fn schema_width_of(&mut self, s: Value) -> u32 {
        self.slot(s, table::SC_WIDTH).as_fixnum() as u32
    }
    fn kw_name(&mut self, v: Value) -> alloc::string::String { self.kw_text_of(v) }
    fn column_list(&mut self, s: Value) -> alloc::string::String {
        let names = self.slot(s, table::SC_NAMES);
        let n = self.vec_count(names);
        let mut out = alloc::vec::Vec::new();
        for c in 0..n {
            let nm = self.slot(names, c);
            out.push(alloc::format!(":{}", self.kw_text_of(nm)));
        }
        out.join(" ")
    }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let n = self.vec_count(v);
        let mut xs: alloc::vec::Vec<Value> = (0..n).map(|i| self.slot(v, i)).collect();
        xs.push(x);
        self.vector(&xs)
    }
    fn is_vector_like(&self, v: Value) -> bool {
        v.is_heap() && (ty(&self.gc.sp, v.as_heap()) == TY_VEC
                        || ty(&self.gc.sp, v.as_heap()) == TY_MAPENTRY)
    }
    fn charge_checked(&mut self, n: u64, _where: &str) -> bool {
        self.gas = self.gas.saturating_sub(n);
        self.gas > 0
    }
    fn known_type(&mut self, t: Value) -> bool {
        let s = self.value_text(self.name_of_pure(t));
        s == "int" || s == "double" || s == "string" || s == "bool"
            || s == "keyword" || s == "any"
    }
    fn name_of_pure(&self, t: Value) -> Value {
