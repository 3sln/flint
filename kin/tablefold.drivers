            int id = schemaIdAt(rt, s, c);
            rt.set(rt.slot(ch, Table.CH_BASE + id), k,
                   mapGet(rt, row, schemaNameAt(rt, s, c), NIL));
        }
    }
    static long chunkWithRow(Rt rt, long s, long ch, int k, long row, boolean grow) {
        int old = chunkRows(rt, ch);
        int take = grow ? old + 1 : old;
        int carry = Math.min(old, take);
        long nch = newChunk(rt, schemaWidth(rt, s), take);
        for (int c = 0; c < schemaLen(rt, s); c++) {
            int id = schemaIdAt(rt, s, c);
            long newv = mapGet(rt, row, schemaNameAt(rt, s, c), NIL);
            long col = newObj(rt, TY_NODE, take < 1 ? 1 : take);
            for (int j = 0; j < carry; j++) rt.set(col, j, cell(rt, ch, id, j));
            rt.set(col, k, newv);
            rt.set(nch, Table.CH_BASE + id, col);
            collapse(rt, nch, id);
        }
        return nch;
    }
    static String showRows(Rt rt, long t, int ncols) {
        int n = (int) Val.asFixnum(rt.slot(t, Table.TB_COUNT));
        int off = (int) Val.asFixnum(rt.slot(t, Table.TB_OFFSET));
        long chunks = rt.slot(t, Table.TB_CHUNKS), s = rt.slot(t, Table.TB_SCHEMA);
        StringBuilder o = new StringBuilder();
        for (int i = 0; i < n; i++) {
            if (i > 0) o.append('.');
            int phys = i + off;
            long ch = Vec.nth(rt, chunks, phys >>> Table.CHUNK_SHIFT, NIL);
            for (int c = 0; c < ncols; c++) {
                if (c > 0) o.append('/');
                long v = cell(rt, ch, schemaIdAt(rt, s, c), phys & (Table.CHUNK - 1));
                o.append(Val.isName(v) ? Str.text(rt, v) : String.valueOf(Val.asFixnum(v)));
            }
        }
        return o.toString();
    }
    static long mkrow(Rt rt, long ka, long kb, long hi, long a) {
        return mapAssoc(rt, mapAssoc(rt, emptyMap(rt), ka, Val.fixnum(a)), kb, hi);
    }
    static int CALLS = 0;
