    // `val-eq` IS `valeq`'s OWN now, so it is called BARE.
    internal static bool ValEq(Rt rt, long a, long b) { return global::Flint.Rt.Eq.Equal(rt, a, b); }
    internal static class Obj {
        internal const int TySchema = 48, TyTableref = 50, TyTable = 49,
                           TyNode = 12, TyVec = 9, TyMap = 14, TyMapentry = 15;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL, NotFound = 0xFFFEL;
        internal static bool IsHeap(long v) {
            return v >= 100 && v != Nil && v != NotFound && (long)((ulong) v >> 60) == 0;
        }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsFixnum(long v) { return (long)((ulong) v >> 60) == 0xDL; }
        internal static long AsFixnum(long v) {
            long raw = v & 0xFFFFFFFFL;
            return raw >= 0x80000000L ? raw - 0x100000000L : raw;
        }
        internal static long Fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static long Kw(int i) { return (0xAL << 60) | (long) i; }
        internal static bool IsKw(long v) { return (long)((ulong) v >> 60) == 0xAL; }
        internal static long Name(int i) { return (0xBL << 60) | (long) i; }
        internal static bool IsName(long v) { return (long)((ulong) v >> 60) == 0xBL; }
        internal static int Idx(long v) { return (int) (v & 0xFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[40000]; }
    internal sealed class Rt {
        internal long[] h = new long[40000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[40000];
        internal long bump = 100;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal System.Collections.Generic.List<string> names = new System.Collections.Generic.List<string>();
        internal string msg = "";
        internal long thrown = Val.Nil;
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void Set(long n, int i, long v) { h[(int) n + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
        internal long NameOf(long v) { return Val.IsKw(v) ? Val.Name(Val.Idx(v)) : Val.Nil; }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long SlotOrNth(long v, int i) {
            return Obj.Ty(gc.sp, v) == Obj.TyMapentry ? Slot(v, i) : Vec.Nth(this, v, i, Val.Nil);
        }
        internal void ChargeWork(long n) { }
        internal long gas = 1000;
        internal bool ChargeChecked(long n, string where) {
            gas = System.Math.Max(0, gas - n);
            return gas > 0;
        }
        internal long KindOf(long v) { return Probe.KindOf(this, v); }
        internal long ThrowStr(string kind, string m) { msg = m; return Val.Nil; }
        internal long InvokeRoots(long f, int bas, int n) {
            CALLS++;
            long acc = Val.AsFixnum(R(bas));
            long v = n > 1 ? Val.AsFixnum(R(bas + 1)) : 0;
            return Val.Fixnum(acc + 2 * v);
        }
        internal bool ChargeTick(long i, long n, string where) {
            gas = System.Math.Max(0, gas - n);
            return gas > 0;
        }
    }
    internal static class Vec {
        internal static long Empty(Rt rt) { return Vector(rt, new long[]{}); }
        internal static long Conj(Rt rt, long v, long x) { return VecConj(rt, v, x); }
        internal static long Assoc(Rt rt, long v, int i, long x) { return VecAssoc(rt, v, i, x); }
        internal static bool IsVectorLike(Rt rt, long v) { return Probe.IsVectorLike(rt, v); }
        internal static int Count(Rt rt, long v) { return rt.lens[(int) v]; }
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            return i >= Count(rt, v) ? dflt : rt.Slot(v, i);
        }
    }
    internal static class Str {
        internal static bool IsKeyword(Rt rt, long v) { return Val.IsKw(v); }
        internal static bool IsString(Rt rt, long v) { return Val.IsName(v); }
        internal static string Text(Rt rt, long v) { return rt.names[Val.Idx(v)]; }
    }
    internal static long Obj2(Rt rt, int t, int n) { return Val.Heap(rt.Alloc(t, n)); }
    internal static long Vector(Rt rt, long[] xs) {
        long a = rt.Alloc(Obj.TyVec, System.Math.Max(1, xs.Length));
        rt.lens[(int) a] = xs.Length;
        for (int i = 0; i < xs.Length; i++) rt.h[(int) a + i] = xs[i];
        return Val.Heap(a);
    }
    internal static long Keyword(Rt rt, string t) { rt.names.Add(t); return Val.Kw(rt.names.Count - 1); }
    internal static long KindOf(Rt rt, long v) {
        if (Val.IsFixnum(v)) return Keyword(rt, "number");
        if (Val.IsKw(v)) return Keyword(rt, "keyword");
        if (Val.IsName(v)) return Keyword(rt, "string");
        if (!Val.IsHeap(v)) return Keyword(rt, "other");
        switch (Obj.Ty(rt.gc.sp, v)) {
            case Obj.TyVec: return Keyword(rt, "vector");
            case Obj.TyMap: return Keyword(rt, "map");
            default: return Keyword(rt, "other");
        }
    }
    internal static long EmptyMap(Rt rt) { long a = rt.Alloc(Obj.TyMap, 1); rt.lens[(int) a] = 0; return Val.Heap(a); }
    internal static long MapAssoc(Rt rt, long m, long k, long v) {
        int n = rt.lens[(int) m];
        long a = rt.Alloc(Obj.TyMap, n + 2);
        rt.lens[(int) a] = n + 2;
        for (int i = 0; i < n; i++) rt.h[(int) a + i] = rt.h[(int) m + i];
        rt.h[(int) a + n] = k; rt.h[(int) a + n + 1] = v;
        return Val.Heap(a);
    }
    internal static bool IsMap(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyMap; }
    internal static int MapCount(Rt rt, long m) { return rt.lens[(int) m] / 2; }
    internal static long Entry(Rt rt, long k, long v) {
        long a = rt.Alloc(Obj.TyMapentry, 2);
        rt.h[(int) a] = k; rt.h[(int) a + 1] = v;
        return Val.Heap(a);
    }
    internal static long SeqOf(Rt rt, long m) {
        int n = rt.lens[(int) m];
        if (n == 0) return Val.Nil;
        long[] es = new long[n / 2];
        for (int i = 0; i < n; i += 2) es[i / 2] = Entry(rt, rt.Slot(m, i), rt.Slot(m, i + 1));
        return Vector(rt, es);
    }
    internal static long NextOf(Rt rt, long q) {
        int n = Vec.Count(rt, q);
        if (n <= 1) return Val.Nil;
        long[] rest = new long[n - 1];
        for (int i = 1; i < n; i++) rest[i - 1] = rt.Slot(q, i);
        return Vector(rt, rest);
    }
    internal static int SchemaLen(Rt rt, long s) { return Vec.Count(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES)); }
    internal static int SchemaWidth(Rt rt, long s) { return (int) Val.AsFixnum(rt.Slot(s, global::Flint.Rt.Table.SC_WIDTH)); }
    internal static long SchemaNameAt(Rt rt, long s, int c) {
        return Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES), c, Val.Nil);
    }
    internal static int SchemaId(Rt rt, long s, long name) {
        long idx = rt.Slot(s, global::Flint.Rt.Table.SC_INDEX);
        int n = rt.lens[(int) idx];
        for (int i = 0; i < n; i += 2)
            if (rt.Slot(idx, i) == name) return (int) Val.AsFixnum(rt.Slot(idx, i + 1));
        return SchemaWidth(rt, s);
    }
    internal static bool IsTableRef(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyTableref;
    }
    internal static long RowColumn(Rt rt, long s, long row, int c) {
        long name = SchemaNameAt(rt, s, c);
        int n = rt.lens[(int) row];
        for (int i = 0; i < n; i += 2) if (rt.Slot(row, i) == name) return rt.Slot(row, i + 1);
        return Val.NotFound;
    }
    internal static long Schema(Rt rt, long[] names, long[] types) {
        long s = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(s, global::Flint.Rt.Table.SC_NAMES, Vector(rt, names));
        rt.Set(s, global::Flint.Rt.Table.SC_TYPES, Vector(rt, types));
        long[] ids = new long[names.Length];
        for (int i = 0; i < names.Length; i++) ids[i] = Val.Fixnum(i);
        rt.Set(s, global::Flint.Rt.Table.SC_IDS, Vector(rt, ids));
        rt.Set(s, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(names.Length));
        long idx = EmptyMap(rt);
        for (int i = 0; i < names.Length; i++) idx = MapAssoc(rt, idx, names[i], Val.Fixnum(i));
        rt.Set(s, global::Flint.Rt.Table.SC_INDEX, idx);
        return s;
    }
    internal static long EmptyVec(Rt rt) { return Vector(rt, new long[]{}); }
    internal static long VecConj(Rt rt, long v, long x) {
        int n = Vec.Count(rt, v);
        long[] xs = new long[n + 1];
        for (int i = 0; i < n; i++) xs[i] = rt.Slot(v, i);
        xs[n] = x;
        return Vector(rt, xs);
    }
    internal static bool IsVectorLike(Rt rt, long v) {
        if (!Val.IsHeap(v)) return false;
        int t = Obj.Ty(rt.gc.sp, v);
        return t == Obj.TyVec || t == Obj.TyMapentry;
    }
    internal static bool KnownType(Rt rt, long t) {
        string s = Str.Text(rt, rt.NameOf(t));
        return s == "int" || s == "double" || s == "string" || s == "bool"
            || s == "keyword" || s == "any";
    }
    internal static int TableCount(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_COUNT)); }
    internal static long TableCell(Rt rt, long t, int id, int i) {
        int phys = i + TableOffset(rt, t);
        long ch = Vec.Nth(rt, rt.Slot(t, global::Flint.Rt.Table.TB_CHUNKS),
                          phys >> global::Flint.Rt.Table.CHUNK_SHIFT, Val.Nil);
        return Cell(rt, ch, id, phys & (global::Flint.Rt.Table.CHUNK - 1));
    }
    internal static long RefToMap(Rt rt, long rf) { return rt.Slot(rf, global::Flint.Rt.Table.RF_SCHEMA); }
    internal static string KwTextOf(Rt rt, long v) {
        long n = rt.NameOf(v);
        return n == Val.Nil ? "?" : Str.Text(rt, n);
    }
    internal static string ShowVec(Rt rt, long v) {
        var o = new System.Text.StringBuilder();
        for (int i = 0; i < Vec.Count(rt, v); i++) {
            if (i > 0) o.Append('.');
            long x = rt.Slot(v, i);
            o.Append(Val.IsKw(x) ? KwTextOf(rt, x) : Val.AsFixnum(x).ToString());
        }
        return o.ToString();
    }
    internal static long Pair(Rt rt, long a, long b) { return Vector(rt, new long[]{a, b}); }
    internal static string KwName(Rt rt, long v) { return KwTextOf(rt, v); }
    internal static string ColumnList(Rt rt, long s) {
        var o = new System.Text.StringBuilder();
        long names = rt.Slot(s, global::Flint.Rt.Table.SC_NAMES);
        for (int c = 0; c < Vec.Count(rt, names); c++) {
            if (c > 0) o.Append(' ');
            o.Append(':').Append(KwTextOf(rt, rt.Slot(names, c)));
        }
        return o.ToString();
    }
    internal static long MapGet(Rt rt, long m, long k, long dflt) {
        int n = rt.lens[(int) m];
        for (int i = 0; i < n; i += 2) if (rt.Slot(m, i) == k) return rt.Slot(m, i + 1);
        return dflt;
    }

    internal static long NewObj(Rt rt, int t, int n) {
        long a = rt.Alloc(t, n);
        rt.lens[(int) a] = n;
        return Val.Heap(a);
    }
    internal static class Conc {
        internal static long NewObj(Rt rt, int t, int n) { return Probe.NewObj(rt, t, n); }
    }
    internal static long NewChunk(Rt rt, int width, int rows) {
        long ch = NewObj(rt, Obj.TyVec, global::Flint.Rt.Table.CH_BASE + width);
        rt.Set(ch, global::Flint.Rt.Table.CH_ROWS, Val.Fixnum(rows));
        long enc = NewObj(rt, Obj.TyVec, width < 1 ? 1 : width);
        for (int id = 0; id < width; id++) rt.Set(enc, id, Val.Fixnum(0));
        rt.Set(ch, global::Flint.Rt.Table.CH_ENC, enc);
        return ch;
    }
    internal static void Collapse(Rt rt, long ch, int id) {
        long col = rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id);
        int n = rt.lens[(int) col];
        if (n == 0) return;
        long first = rt.Slot(col, 0);
        for (int k = 1; k < n; k++) if (rt.Slot(col, k) != first) return;
        rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, first);
        rt.Set(rt.Slot(ch, global::Flint.Rt.Table.CH_ENC), id, Val.Fixnum(1));
    }
    internal static int SchemaIdAt(Rt rt, long s, int c) {
        return (int) Val.AsFixnum(Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_IDS), c, Val.Nil));
    }
    internal static bool TypeOk(Rt rt, long t, long v) {
        string s = Str.Text(rt, rt.NameOf(t));
        if (s == "any") return true;
        if (s == "int") return Val.IsFixnum(v);
        if (s == "string") return Str.IsString(rt, v);
        return false;
    }
    internal static string ColumnTypeError(Rt rt, long name, long want, long got, int row) {
        return "row " + row + ", column :" + KwTextOf(rt, name) + " holds :"
             + KwTextOf(rt, want) + " and was given a " + KwTextOf(rt, KindOf(rt, got));
    }
    internal static int ChunkEnc(Rt rt, long ch, int id) {
        return (int) Val.AsFixnum(rt.Slot(rt.Slot(ch, global::Flint.Rt.Table.CH_ENC), id));
    }
    internal static long Cell(Rt rt, long ch, int id, int row) {
        long col = rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id);
        return ChunkEnc(rt, ch, id) == 1 ? col : rt.Slot(col, row);
    }
    internal static string ShowTable(Rt rt, long t, int ncols) {
        long chunks = rt.Slot(t, global::Flint.Rt.Table.TB_CHUNKS);
        var outb = new System.Text.StringBuilder();
        for (int w = 0; w < Vec.Count(rt, chunks); w++) {
            if (w > 0) outb.Append(';');
            long ch = rt.Slot(chunks, w);
            int rows = (int) Val.AsFixnum(rt.Slot(ch, global::Flint.Rt.Table.CH_ROWS));
            for (int id = 0; id < ncols; id++) {
                if (id > 0) outb.Append(',');
                outb.Append(ChunkEnc(rt, ch, id)).Append('[');
                for (int r = 0; r < rows; r++) {
                    if (r > 0) outb.Append('.');
                    long v = Cell(rt, ch, id, r);
                    outb.Append(Val.IsKw(v) ? KwTextOf(rt, v)
                              : Val.IsName(v) ? Str.Text(rt, v)
                              : Val.AsFixnum(v).ToString());
                }
                outb.Append(']');
            }
        }
        return Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_COUNT)) + "|" + outb;
    }
    internal static long NewTable(Rt rt, long schema, long rows) {
        int ncols = SchemaLen(rt, schema), width = SchemaWidth(rt, schema);
        int nrows = Vec.Count(rt, rows);
        var chunks = new System.Collections.Generic.List<long>();
        int row = 0;
        while (row < nrows) {
            int take = System.Math.Min(global::Flint.Rt.Table.CHUNK, nrows - row);
            long ch = NewChunk(rt, width, take);
            for (int c = 0; c < ncols; c++) {
                int id = SchemaIdAt(rt, schema, c);
                long name = SchemaNameAt(rt, schema, c);
                long col = NewObj(rt, Obj.TyNode, take);
                for (int k = 0; k < take; k++)
                    rt.Set(col, k, MapGet(rt, Vec.Nth(rt, rows, row + k, Val.Nil), name, Val.Nil));
                rt.Set(ch, global::Flint.Rt.Table.CH_BASE + id, col);
                Collapse(rt, ch, id);
            }
            chunks.Add(ch);
            row += take;
        }
        long t = Obj2(rt, Obj.TyTable, global::Flint.Rt.Table.TB_LEN);
        rt.Set(t, global::Flint.Rt.Table.TB_SCHEMA, schema);
        rt.Set(t, global::Flint.Rt.Table.TB_CHUNKS, Vector(rt, chunks.ToArray()));
        rt.Set(t, global::Flint.Rt.Table.TB_COUNT, Val.Fixnum(nrows));
        rt.Set(t, global::Flint.Rt.Table.TB_OFFSET, Val.Fixnum(0));
        return t;
    }
    internal static long SchemaTypeAt(Rt rt, long s, int c) {
        return Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_TYPES), c, Val.Nil);
    }
    internal static int SchemaPosOf(Rt rt, long s, long name) {
        for (int c = 0; c < SchemaLen(rt, s); c++)
            if (SchemaNameAt(rt, s, c) == name) return c;
        return 0;
    }
    internal static int ChunkRows(Rt rt, long ch) { return (int) Val.AsFixnum(rt.Slot(ch, global::Flint.Rt.Table.CH_ROWS)); }
    internal static string ShowSchema(Rt rt, long s) {
        var o = new System.Text.StringBuilder();
        for (int c = 0; c < SchemaLen(rt, s); c++) {
            if (c > 0) o.Append('.');
            o.Append(KwTextOf(rt, SchemaNameAt(rt, s, c))).Append('@').Append(SchemaIdAt(rt, s, c));
        }
        return o + "/w" + SchemaWidth(rt, s);
    }
    internal static bool IsInt(Rt rt, long v) { return Val.IsFixnum(v); }
    internal static int TableOffset(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_OFFSET)); }
    internal static class Num {
        internal static long I64Of(Rt rt, long v) { return Val.IsFixnum(v) ? Val.AsFixnum(v) : 0L; }
        internal static bool IsInt(Rt rt, long v) { return Val.IsFixnum(v); }
    }
    internal static long VecAssoc(Rt rt, long v, int i, long x) {
        int n = Vec.Count(rt, v);
        long[] xs = new long[n];
        for (int k = 0; k < n; k++) xs[k] = rt.Slot(v, k);
        xs[i] = x;
        return Vector(rt, xs);
    }
    internal static void WriteRow(Rt rt, long s, long ch, int k, long row) {
        for (int c = 0; c < SchemaLen(rt, s); c++) {
            int id = SchemaIdAt(rt, s, c);
            rt.Set(rt.Slot(ch, global::Flint.Rt.Table.CH_BASE + id), k,
                   MapGet(rt, row, SchemaNameAt(rt, s, c), Val.Nil));
        }
    }
    internal static long ChunkWithRow(Rt rt, long s, long ch, int k, long row, bool grow) {
        int old = ChunkRows(rt, ch);
        int take = grow ? old + 1 : old;
        int carry = System.Math.Min(old, take);
        long nch = NewChunk(rt, SchemaWidth(rt, s), take);
        for (int c = 0; c < SchemaLen(rt, s); c++) {
            int id = SchemaIdAt(rt, s, c);
            long newv = MapGet(rt, row, SchemaNameAt(rt, s, c), Val.Nil);
            long col = NewObj(rt, Obj.TyNode, take < 1 ? 1 : take);
            for (int j = 0; j < carry; j++) rt.Set(col, j, Cell(rt, ch, id, j));
            rt.Set(col, k, newv);
            rt.Set(nch, global::Flint.Rt.Table.CH_BASE + id, col);
            Collapse(rt, nch, id);
        }
        return nch;
    }
    internal static string ShowRows(Rt rt, long t, int ncols) {
        int n = (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_COUNT));
        int off = (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_OFFSET));
        long chunks = rt.Slot(t, global::Flint.Rt.Table.TB_CHUNKS);
        long s = rt.Slot(t, global::Flint.Rt.Table.TB_SCHEMA);
        var o = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++) {
            if (i > 0) o.Append('.');
            int phys = i + off;
            long ch = Vec.Nth(rt, chunks, phys >> global::Flint.Rt.Table.CHUNK_SHIFT, Val.Nil);
            for (int c = 0; c < ncols; c++) {
                if (c > 0) o.Append('/');
                long v = Cell(rt, ch, SchemaIdAt(rt, s, c),
                              phys & (global::Flint.Rt.Table.CHUNK - 1));
                o.Append(Val.IsName(v) ? Str.Text(rt, v) : Val.AsFixnum(v).ToString());
            }
        }
        return o.ToString();
    }
    internal static long Mkrow(Rt rt, long ka, long kb, long hi, long a) {
        return MapAssoc(rt, MapAssoc(rt, EmptyMap(rt), ka, Val.Fixnum(a)), kb, hi);
    }
    internal static int CALLS = 0;
--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long ka = Keyword(rt, "a"), kb = Keyword(rt, "b");
        long tint = Keyword(rt, "int"), tstr = Keyword(rt, "string");
        long s = Schema(rt, new long[]{ka, kb}, new long[]{tint, tstr});
        rt.names.Add("hi");
        long hi = Val.Name(rt.names.Count - 1);
        long[] rowsArr = new long[6];
        for (int i = 0; i < 6; i++) rowsArr[i] = Mkrow(rt, ka, kb, hi, 10 + i);
        long t = NewTable(rt, s, Vector(rt, rowsArr));
        long f = Val.Fixnum(0);
        o.Append("fold=").Append(Val.AsFixnum(TableReduceColumn(rt, t, ka, f, Val.Fixnum(100))))
         .Append(" calls=").Append(CALLS).Append(' ');
        TableReduceColumn(rt, t, Keyword(rt, "z"), f, Val.Fixnum(0));
        o.Append("nocol=[").Append(rt.msg).Append("] ");
        rt.thrown = Val.Fixnum(1);
        o.Append("threw=").Append(TableReduceColumn(rt, t, ka, f, Val.Fixnum(0)) == Val.Nil ? 1 : 0)
         .Append(' ');
        rt.thrown = Val.Nil;
        rt.gas = 3;
        o.Append("starved=").Append(TableReduceColumn(rt, t, ka, f, Val.Fixnum(0)) == Val.Nil ? 1 : 0);
        System.Console.WriteLine(o.ToString());
    }
