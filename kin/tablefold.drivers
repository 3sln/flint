fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      names: Vec::new(), msg: alloc::string::String::new(),
                      thrown: NIL, gas: 1000, calls: 0 };
    let mut o = String::new();
    let ka = rt.keyword("a"); let kb = rt.keyword("b");
    let tint = rt.keyword("int"); let tstr = rt.keyword("string");
    let s = rt.schema(&[ka, kb], &[tint, tstr]);
    let hi = Value::name(rt.names.len() as u32);
    rt.names.push(alloc::string::String::from("hi"));
    let mut rows = alloc::vec::Vec::new();
    for i in 0..6i64 {
        let mut m = rt.empty_map();
        m = rt.map_assoc(m, ka, Value::fixnum(10 + i));
        m = rt.map_assoc(m, kb, hi);
        rows.push(m);
    }
    let rv = rt.vector(&rows);
    let t = rt.new_table(s, rv);
    // THE FOLD. `f(acc, v) = acc + 2v` over 10..15 from 100 is
    // 100 + 2*(10+11+12+13+14+15) = 250 -- and it is only that number if the
    // accumulator and the cell arrive in that order.
    let f = Value::fixnum(0);
    let sum = rt.table_reduce_column(t, ka, f, Value::fixnum(100));
    o.push_str(&format!("fold={} calls={} ", sum.as_fixnum(), rt.calls));
    // A COLUMN THAT IS NOT ONE refuses by name.
    let kz = rt.keyword("z");
    rt.table_reduce_column(t, kz, f, Value::fixnum(0));
    let m1 = rt.msg.clone();
    o.push_str(&format!("nocol=[{}] ", m1));
    // A THROW FROM THE CALLBACK STOPS THE FOLD. The throw does not unwind the
    // host stack, so a fold that did not ask would run on inside it.
    rt.thrown = Value::fixnum(1);
    let stopped = rt.table_reduce_column(t, ka, f, Value::fixnum(0));
    rt.thrown = NIL;
    o.push_str(&format!("threw={} ", stopped.is_nil() as u32));
    // AND THE BUDGET STOPS IT TOO, per row.
    rt.gas = 3;
    let starved = rt.table_reduce_column(t, ka, f, Value::fixnum(0));
    o.push_str(&format!("starved={}", starved.is_nil() as u32));
    println!("{}", o);
}
