    static long refToMap(Rt rt, long rf) { return rt.slot(rf, Table.RF_SCHEMA); }
    static String kwTextOf(Rt rt, long v) {
        long n = rt.nameOf(v);
        return n == NIL ? "?" : Str.text(rt, n);
    }
    static String showVec(Rt rt, long v) {
        StringBuilder o = new StringBuilder();
        for (int i = 0; i < Vec.count(rt, v); i++) {
            if (i > 0) o.append('.');
            long x = rt.slot(v, i);
            o.append(Val.isKw(x) ? kwTextOf(rt, x) : String.valueOf(Val.asFixnum(x)));
