    static long mapAssoc(Rt rt, long m, long k, long v) {
        int n = rt.lens[(int) m];
        long a = rt.alloc(TY_MAP, n + 2);
        rt.lens[(int) a] = n + 2;
        for (int i = 0; i < n; i++) rt.h[(int) a + i] = rt.h[(int) m + i];
        rt.h[(int) a + n] = k; rt.h[(int) a + n + 1] = v;
        return Val.heap(a);
    }
    static boolean isMap(Rt rt, long v) { return Val.isHeap(v) && ty(rt.gc.sp, v) == TY_MAP; }
    static int mapCount(Rt rt, long m) { return rt.lens[(int) m] / 2; }
    static long entry(Rt rt, long k, long v) {
        long a = rt.alloc(TY_MAPENTRY, 2);
        rt.h[(int) a] = k; rt.h[(int) a + 1] = v;
        return Val.heap(a);
    }
    static long seqOf(Rt rt, long m) {
        int n = rt.lens[(int) m];
        if (n == 0) return NIL;
        long[] es = new long[n / 2];
        for (int i = 0; i < n; i += 2) es[i / 2] = entry(rt, rt.slot(m, i), rt.slot(m, i + 1));
        return vector(rt, es);
    }
    static long nextOf(Rt rt, long q) {
        int n = Vec.count(rt, q);
        if (n <= 1) return NIL;
        long[] rest = new long[n - 1];
        for (int i = 1; i < n; i++) rest[i - 1] = rt.slot(q, i);
        return vector(rt, rest);
    }
    static int schemaLen(Rt rt, long s) { return Vec.count(rt, rt.slot(s, Table.SC_NAMES)); }
    static int schemaWidth(Rt rt, long s) { return (int) Val.asFixnum(rt.slot(s, Table.SC_WIDTH)); }
    static long schemaNameAt(Rt rt, long s, int c) {
        return Vec.nth(rt, rt.slot(s, Table.SC_NAMES), c, NIL);
    }
    static int schemaId(Rt rt, long s, long name) {
        long idx = rt.slot(s, Table.SC_INDEX);
        int n = rt.lens[(int) idx];
        for (int i = 0; i < n; i += 2)
            if (rt.slot(idx, i) == name) return (int) Val.asFixnum(rt.slot(idx, i + 1));
        return schemaWidth(rt, s);
    }
    static boolean isTableRef(Rt rt, long v) {
        return Val.isHeap(v) && ty(rt.gc.sp, v) == TY_TABLEREF;
    }
    static long rowColumn(Rt rt, long s, long row, int c) {
        long name = schemaNameAt(rt, s, c);
        int n = rt.lens[(int) row];
        for (int i = 0; i < n; i += 2) if (rt.slot(row, i) == name) return rt.slot(row, i + 1);
        return NOT_FOUND;
    }
    static long schema(Rt rt, long[] names, long[] types) {
        long s = obj(rt, TY_SCHEMA, Table.SC_LEN);
        rt.set(s, Table.SC_NAMES, vector(rt, names));
        rt.set(s, Table.SC_TYPES, vector(rt, types));
        rt.set(s, Table.SC_WIDTH, Val.fixnum(names.length));
        long idx = emptyMap(rt);
        for (int i = 0; i < names.length; i++) idx = mapAssoc(rt, idx, names[i], Val.fixnum(i));
        rt.set(s, Table.SC_INDEX, idx);
        return s;
    }
    static long emptyVec(Rt rt) { return vector(rt, new long[]{}); }
    static long vecConj(Rt rt, long v, long x) {
        int n = Vec.count(rt, v);
        long[] xs = new long[n + 1];
        for (int i = 0; i < n; i++) xs[i] = rt.slot(v, i);
        xs[n] = x;
        return vector(rt, xs);
    }
    static boolean isVectorLike(Rt rt, long v) {
        if (!Val.isHeap(v)) return false;
