namespace Flint.Rt {
    internal static class Table {
        internal const int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                           SC_WIDTH = 4, SC_LEN = 5;
        internal const int RF_SCHEMA = 0, RF_LEN = 3;
        internal const int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, CH_BASE = 2;
        internal static bool typeOk(Probe.Rt rt, long t, long v) { return Probe.TypeOk(rt, t, v); }
    }
    internal static class Maps {
        internal static long Empty(Probe.Rt rt) { return Probe.EmptyMap(rt); }
    }
    internal static class Seqs {
        internal static long Seq(Probe.Rt rt, long m) { return Probe.SeqOf(rt, m); }
        internal static long First(Probe.Rt rt, long q) { return Probe.Vec.Nth(rt, q, 0, Probe.Val.Nil); }
        internal static long Next(Probe.Rt rt, long q) { return Probe.NextOf(rt, q); }
    }
}
--csharp-head
    internal static class Obj {
        internal const int TySchema = 48, TyTableref = 50, TyVec = 9, TyMap = 14,
                           TyMapentry = 15;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL, NotFound = 0xFFFEL;
        internal static bool IsHeap(long v) {
            return v >= 100 && v != Nil && v != NotFound && (long)((ulong) v >> 60) == 0;
        }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsFixnum(long v) { return (long)((ulong) v >> 60) == 0xDL; }
        internal static long AsFixnum(long v) { return v & 0xFFFFFFFFL; }
        internal static long Fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static long Kw(int i) { return (0xAL << 60) | (long) i; }
        internal static bool IsKw(long v) { return (long)((ulong) v >> 60) == 0xAL; }
        internal static long Name(int i) { return (0xBL << 60) | (long) i; }
        internal static bool IsName(long v) { return (long)((ulong) v >> 60) == 0xBL; }
        internal static int Idx(long v) { return (int) (v & 0xFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[40000]; }
    internal sealed class Rt {
        internal long[] h = new long[40000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[40000];
        internal long bump = 100;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal System.Collections.Generic.List<string> names = new System.Collections.Generic.List<string>();
        internal string thrown = "";
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void Set(long n, int i, long v) { h[(int) n + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
        internal long NameOf(long v) { return Val.IsKw(v) ? Val.Name(Val.Idx(v)) : Val.Nil; }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long SlotOrNth(long v, int i) {
            return Obj.Ty(gc.sp, v) == Obj.TyMapentry ? Slot(v, i) : Vec.Nth(this, v, i, Val.Nil);
        }
        internal void ChargeWork(long n) { }
        internal long gas = 1000;
        internal bool ChargeChecked(long n, string where) {
            gas = System.Math.Max(0, gas - n);
            return gas > 0;
        }
        internal long KindOf(long v) { return Probe.KindOf(this, v); }
        internal long ThrowStr(string kind, string msg) { thrown = msg; return Val.Nil; }
    }
    internal static class Vec {
        internal static long Empty(Rt rt) { return Vector(rt, new long[]{}); }
        internal static long Conj(Rt rt, long v, long x) { return VecConj(rt, v, x); }
        internal static bool IsVectorLike(Rt rt, long v) { return Probe.IsVectorLike(rt, v); }
        internal static int Count(Rt rt, long v) { return rt.lens[(int) v]; }
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            return i >= Count(rt, v) ? dflt : rt.Slot(v, i);
        }
    }
    internal static long VecNth(Rt rt, long v, int i, long dflt) { return Vec.Nth(rt, v, i, dflt); }
    internal static class Str {
        internal static bool IsString(Rt rt, long v) { return Val.IsName(v); }
        internal static string Text(Rt rt, long v) { return rt.names[Val.Idx(v)]; }
    }
    internal static long Obj2(Rt rt, int t, int n) { return Val.Heap(rt.Alloc(t, n)); }
    internal static long Vector(Rt rt, long[] xs) {
        long a = rt.Alloc(Obj.TyVec, System.Math.Max(1, xs.Length));
        rt.lens[(int) a] = xs.Length;
        for (int i = 0; i < xs.Length; i++) rt.h[(int) a + i] = xs[i];
        return Val.Heap(a);
    }
    internal static long Keyword(Rt rt, string t) { rt.names.Add(t); return Val.Kw(rt.names.Count - 1); }
    internal static long KindOf(Rt rt, long v) {
        if (Val.IsFixnum(v)) return Keyword(rt, "number");
        if (Val.IsKw(v)) return Keyword(rt, "keyword");
        if (Val.IsName(v)) return Keyword(rt, "string");
        if (!Val.IsHeap(v)) return Keyword(rt, "other");
        switch (Obj.Ty(rt.gc.sp, v)) {
            case Obj.TyVec: return Keyword(rt, "vector");
            case Obj.TyMap: return Keyword(rt, "map");
            default: return Keyword(rt, "other");
        }
    }
    internal static bool TypeOk(Rt rt, long t, long v) {
        string s = Str.Text(rt, rt.NameOf(t));
        if (s == "any") return true;
        if (s == "int") return Val.IsFixnum(v);
        if (s == "string") return Str.IsString(rt, v);
        return false;
    }
    internal static long EmptyMap(Rt rt) { long a = rt.Alloc(Obj.TyMap, 1); rt.lens[(int) a] = 0; return Val.Heap(a); }
    internal static long MapAssoc(Rt rt, long m, long k, long v) {
        int n = rt.lens[(int) m];
        long a = rt.Alloc(Obj.TyMap, n + 2);
        rt.lens[(int) a] = n + 2;
        for (int i = 0; i < n; i++) rt.h[(int) a + i] = rt.h[(int) m + i];
        rt.h[(int) a + n] = k; rt.h[(int) a + n + 1] = v;
        return Val.Heap(a);
    }
    internal static bool IsMap(Rt rt, long v) { return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyMap; }
    internal static int MapCount(Rt rt, long m) { return rt.lens[(int) m] / 2; }
    internal static long Entry(Rt rt, long k, long v) {
        long a = rt.Alloc(Obj.TyMapentry, 2);
        rt.h[(int) a] = k; rt.h[(int) a + 1] = v;
        return Val.Heap(a);
    }
    internal static long SeqOf(Rt rt, long m) {
        int n = rt.lens[(int) m];
        if (n == 0) return Val.Nil;
        long[] es = new long[n / 2];
        for (int i = 0; i < n; i += 2) es[i / 2] = Entry(rt, rt.Slot(m, i), rt.Slot(m, i + 1));
        return Vector(rt, es);
    }
    internal static long NextOf(Rt rt, long q) {
        int n = Vec.Count(rt, q);
        if (n <= 1) return Val.Nil;
        long[] rest = new long[n - 1];
        for (int i = 1; i < n; i++) rest[i - 1] = rt.Slot(q, i);
        return Vector(rt, rest);
    }
    internal static int SchemaLen(Rt rt, long s) { return Vec.Count(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES)); }
    internal static int SchemaWidth(Rt rt, long s) { return (int) Val.AsFixnum(rt.Slot(s, global::Flint.Rt.Table.SC_WIDTH)); }
    internal static long SchemaNameAt(Rt rt, long s, int c) {
        return Vec.Nth(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES), c, Val.Nil);
    }
    internal static int SchemaId(Rt rt, long s, long name) {
        long idx = rt.Slot(s, global::Flint.Rt.Table.SC_INDEX);
        int n = rt.lens[(int) idx];
        for (int i = 0; i < n; i += 2)
            if (rt.Slot(idx, i) == name) return (int) Val.AsFixnum(rt.Slot(idx, i + 1));
        return SchemaWidth(rt, s);
    }
    internal static bool IsTableRef(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyTableref;
    }
    internal static long RowColumn(Rt rt, long s, long row, int c) {
        long name = SchemaNameAt(rt, s, c);
        int n = rt.lens[(int) row];
        for (int i = 0; i < n; i += 2) if (rt.Slot(row, i) == name) return rt.Slot(row, i + 1);
        return Val.NotFound;
    }
    internal static long Schema(Rt rt, long[] names, long[] types) {
        long s = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(s, global::Flint.Rt.Table.SC_NAMES, Vector(rt, names));
        rt.Set(s, global::Flint.Rt.Table.SC_TYPES, Vector(rt, types));
        rt.Set(s, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(names.Length));
        long idx = EmptyMap(rt);
        for (int i = 0; i < names.Length; i++) idx = MapAssoc(rt, idx, names[i], Val.Fixnum(i));
        rt.Set(s, global::Flint.Rt.Table.SC_INDEX, idx);
        return s;
    }
    internal static long EmptyVec(Rt rt) { return Vector(rt, new long[]{}); }
    internal static long VecConj(Rt rt, long v, long x) {
        int n = Vec.Count(rt, v);
        long[] xs = new long[n + 1];
        for (int i = 0; i < n; i++) xs[i] = rt.Slot(v, i);
        xs[n] = x;
        return Vector(rt, xs);
    }
    internal static bool IsVectorLike(Rt rt, long v) {
        if (!Val.IsHeap(v)) return false;
        int t = Obj.Ty(rt.gc.sp, v);
        return t == Obj.TyVec || t == Obj.TyMapentry;
    }
    internal static bool KnownType(Rt rt, long t) {
        string s = Str.Text(rt, rt.NameOf(t));
        return s == "int" || s == "double" || s == "string" || s == "bool"
            || s == "keyword" || s == "any";
    }
    internal static int TableCount(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, global::Flint.Rt.Table.TB_COUNT)); }
    internal static long TableCell(Rt rt, long t, int id, int i) {
        return rt.Slot(rt.Slot(rt.Slot(t, global::Flint.Rt.Table.TB_CHUNKS),
                               global::Flint.Rt.Table.CH_BASE + id), i);
    }
    internal static long RefToMap(Rt rt, long rf) { return rt.Slot(rf, global::Flint.Rt.Table.RF_SCHEMA); }
    internal static string KwTextOf(Rt rt, long v) {
        long n = rt.NameOf(v);
        return n == Val.Nil ? "?" : Str.Text(rt, n);
    }
    internal static string ShowVec(Rt rt, long v) {
        var o = new System.Text.StringBuilder();
        for (int i = 0; i < Vec.Count(rt, v); i++) {
            if (i > 0) o.Append('.');
            long x = rt.Slot(v, i);
            o.Append(Val.IsKw(x) ? KwTextOf(rt, x) : Val.AsFixnum(x).ToString());
        }
        return o.ToString();
    }
    internal static long Pair(Rt rt, long a, long b) { return Vector(rt, new long[]{a, b}); }
    internal static string KwName(Rt rt, long v) { return KwTextOf(rt, v); }
    internal static string ColumnList(Rt rt, long s) {
        var o = new System.Text.StringBuilder();
        long names = rt.Slot(s, global::Flint.Rt.Table.SC_NAMES);
        for (int c = 0; c < Vec.Count(rt, names); c++) {
            if (c > 0) o.Append(' ');
            o.Append(':').Append(KwTextOf(rt, rt.Slot(names, c)));
        }
        return o.ToString();
    }
    internal static long MapGet(Rt rt, long m, long k, long dflt) {
        int n = rt.lens[(int) m];
        for (int i = 0; i < n; i += 2) if (rt.Slot(m, i) == k) return rt.Slot(m, i + 1);
        return dflt;
    }

    internal static bool IsKeyword(Rt rt, long v) { return Val.IsKw(v); }
