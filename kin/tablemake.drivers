        static long conj(Rt rt, long v, long x) { return vecConj(rt, v, x); }
        static boolean isVectorLike(Rt rt, long v) { return Probe.isVectorLike(rt, v); }
        static int count(Rt rt, long v) { return rt.lens[(int) v]; }
        static long nth(Rt rt, long v, int i, long dflt) {
            return i >= count(rt, v) ? dflt : rt.slot(v, i);
        }
    }
    static long vecNth(Rt rt, long v, int i, long dflt) { return Vec.nth(rt, v, i, dflt); }
    static final class Str {
        static boolean isString(Rt rt, long v) { return Val.isName(v); }
        static String text(Rt rt, long v) { return rt.names.get(Val.idx(v)); }
    }
    static final class com { static final class flint { static final class rt {
        static final class Maps {
            static long empty(Rt rt) { return emptyMap(rt); }
        }
        static final class Seqs {
            static long seq(Rt rt, long m) { return Probe.seqOf(rt, m); }
            static long first(Rt rt, long q) { return Vec.nth(rt, q, 0, NIL); }
            static long next(Rt rt, long q) { return Probe.nextOf(rt, q); }
        }
    } } }
    static long obj(Rt rt, int t, int n) { return Val.heap(rt.alloc(t, n)); }
    static long vector(Rt rt, long[] xs) {
        long a = rt.alloc(TY_VEC, Math.max(1, xs.length));
        rt.lens[(int) a] = xs.length;
        for (int i = 0; i < xs.length; i++) rt.h[(int) a + i] = xs[i];
        return Val.heap(a);
    }
    static long keyword(Rt rt, String t) { rt.names.add(t); return Val.kw(rt.names.size() - 1); }
    static long kindOf(Rt rt, long v) {
