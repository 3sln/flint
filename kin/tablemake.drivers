    static final long NIL = 0xFFFFL, NOT_FOUND = 0xFFFEL;
    static final int TY_SCHEMA = 48, TY_TABLEREF = 50, TY_VEC = 9, TY_MAP = 14,
                     TY_MAPENTRY = 15;
    static final class Table {
        static final int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                         SC_WIDTH = 4, SC_LEN = 5;
        static final int RF_SCHEMA = 0, RF_LEN = 3;
        static final int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, CH_BASE = 2;
        static boolean typeOk(Rt rt, long t, long v) { return Probe.typeOk(rt, t, v); }
    }
    static final class Val {
        static final long NIL = Probe.NIL, NOT_FOUND = Probe.NOT_FOUND;
        static boolean isHeap(long v) {
            return v >= 100 && v != NIL && v != NOT_FOUND && (v >>> 60) == 0;
        }
        static long asHeap(long v) { return v; }
        static boolean isFixnum(long v) { return (v >>> 60) == 0xDL; }
        static long asFixnum(long v) { return v & 0xFFFFFFFFL; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
        static long kw(int i) { return (0xAL << 60) | i; }
        static boolean isKw(long v) { return (v >>> 60) == 0xAL; }
        static long name(int i) { return (0xBL << 60) | i; }
        static boolean isName(long v) { return (v >>> 60) == 0xBL; }
        static int idx(long v) { return (int) (v & 0xFFFFL); }
    }
    static final class Space { byte[] m = new byte[40000]; }
    static final class Rt {
        long[] h = new long[40000];
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        int[] lens = new int[40000];
        long bump = 100;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        java.util.ArrayList<String> names = new java.util.ArrayList<>();
        String thrown = "";
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long alloc(int t, int n) {
            long a = bump; bump += n + 16;
