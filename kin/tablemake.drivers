    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long ka = Keyword(rt, "a"), kb = Keyword(rt, "b");
        long tint = Keyword(rt, "int"), tstr = Keyword(rt, "string"), tbad = Keyword(rt, "table");
        long ps = Vector(rt, new long[]{Pair(rt, ka, tint), Pair(rt, kb, tstr)});
        long s = NewSchema(rt, ps);
        o.Append("schema=").Append(ShowVec(rt, rt.Slot(s, global::Flint.Rt.Table.SC_NAMES))).Append('/')
         .Append(ShowVec(rt, rt.Slot(s, global::Flint.Rt.Table.SC_IDS))).Append('/')
         .Append(Val.AsFixnum(rt.Slot(s, global::Flint.Rt.Table.SC_WIDTH))).Append(' ');
        long es = Vector(rt, new long[]{Entry(rt, ka, tint), Entry(rt, kb, tstr)});
        o.Append("entrypairs=").Append(NewSchema(rt, es) != Val.Nil ? 1 : 0).Append(' ');
        NewSchema(rt, Vector(rt, new long[]{Vector(rt, new long[]{ka})}));
        string m1 = rt.thrown;
        NewSchema(rt, Vector(rt, new long[]{Pair(rt, Val.Fixnum(1), tint)}));
        string m2 = rt.thrown;
        NewSchema(rt, Vector(rt, new long[]{Pair(rt, ka, tbad)}));
        string m3 = rt.thrown;
        NewSchema(rt, Vector(rt, new long[]{Pair(rt, ka, tint), Pair(rt, ka, tstr)}));
        string m4 = rt.thrown;
        o.Append("bad=[").Append(m1).Append("][").Append(m2).Append("][").Append(m3)
         .Append("][").Append(m4).Append("] ");
        long col0 = Vector(rt, new long[]{Val.Fixnum(10), Val.Fixnum(11), Val.Fixnum(12)});
        long ch = Obj2(rt, Obj.TyVec, global::Flint.Rt.Table.CH_BASE + 2);
        rt.Set(ch, global::Flint.Rt.Table.CH_BASE, col0);
        long t = Obj2(rt, Obj.TyVec, 4);
        rt.Set(t, global::Flint.Rt.Table.TB_SCHEMA, s);
        rt.Set(t, global::Flint.Rt.Table.TB_CHUNKS, ch);
        rt.Set(t, global::Flint.Rt.Table.TB_COUNT, Val.Fixnum(3));
        o.Append("col=").Append(ShowVec(rt, TableColumn(rt, t, ka))).Append(' ');
        TableColumn(rt, t, Keyword(rt, "z"));
        o.Append("nocol=[").Append(rt.thrown).Append("] ");
        rt.gas = 2;
        o.Append("starved=").Append(TableColumn(rt, t, ka) == Val.Nil ? 1 : 0);
        System.Console.WriteLine(o.ToString());
    }
