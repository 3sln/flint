    static long pair(Rt rt, long a, long b) { return vector(rt, new long[]{a, b}); }
    static String kwName(Rt rt, long v) { return kwTextOf(rt, v); }
    static String columnList(Rt rt, long s) {
        StringBuilder o = new StringBuilder();
        long names = rt.slot(s, Table.SC_NAMES);
        for (int c = 0; c < Vec.count(rt, names); c++) {
            if (c > 0) o.append(' ');
            o.append(':').append(kwTextOf(rt, rt.slot(names, c)));
        }
        return o.toString();
    }
    static long mapGet(Rt rt, long m, long k, long dflt) {
        int n = rt.lens[(int) m];
        for (int i = 0; i < n; i += 2) if (rt.slot(m, i) == k) return rt.slot(m, i + 1);
        return dflt;
    }

    static boolean isKeyword(Rt rt, long v) { return Val.isKw(v); }
