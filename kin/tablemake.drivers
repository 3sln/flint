        let n = self.name_of(v);
        if n.is_nil() { alloc::string::String::from("?") } else { self.value_text(n) }
    }
    fn show_vec(&mut self, v: Value) -> alloc::string::String {
        let n = self.vec_count(v);
        let mut out = alloc::vec::Vec::new();
        for i in 0..n {
            let x = self.slot(v, i);
            out.push(if x.is_kw() { self.kw_text_of(x) }
                     else { alloc::format!("{}", x.as_fixnum()) });
        }
        out.join(".")
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      names: Vec::new(), thrown: alloc::string::String::new(),
                      gas: 1000 };
    let mut o = String::new();
    let ka = rt.keyword("a"); let kb = rt.keyword("b");
    let tint = rt.keyword("int"); let tstr = rt.keyword("string");
    let tbad = rt.keyword("table");
    let pair = |rt: &mut Rt, a: Value, b: Value| -> Value { rt.vector(&[a, b]) };
    // A GOOD SCHEMA.
    let p1 = pair(&mut rt, ka, tint);
    let p2 = pair(&mut rt, kb, tstr);
    let ps = rt.vector(&[p1, p2]);
    let s = rt.new_schema(ps);
    let names = rt.slot(s, table::SC_NAMES);
    let ids = rt.slot(s, table::SC_IDS);
    let nshow = rt.show_vec(names);
    let ishow = rt.show_vec(ids);
    let w = rt.slot(s, table::SC_WIDTH).as_fixnum();
    o.push_str(&format!("schema={}/{}/{} ", nshow, ishow, w));
    // A MAP ENTRY IS A PAIR. Rust refused this and both ports took it.
    let e1 = rt.entry(ka, tint);
    let e2 = rt.entry(kb, tstr);
    let es = rt.vector(&[e1, e2]);
    let s2 = rt.new_schema(es);
    o.push_str(&format!("entrypairs={} ", (!s2.is_nil()) as u32));
    // THE FOUR REFUSALS, each by name.
    let notpair = rt.vector(&[ka]);
    let bad1 = rt.vector(&[notpair]);
    rt.new_schema(bad1);
    let m1 = rt.thrown.clone();
    let np2 = pair(&mut rt, Value::fixnum(1), tint);
    let bad2 = rt.vector(&[np2]);
    rt.new_schema(bad2);
    let m2 = rt.thrown.clone();
    let np3 = pair(&mut rt, ka, tbad);
    let bad3 = rt.vector(&[np3]);
    rt.new_schema(bad3);
    let m3 = rt.thrown.clone();
    let np4a = pair(&mut rt, ka, tint);
    let np4b = pair(&mut rt, ka, tstr);
    let bad4 = rt.vector(&[np4a, np4b]);
    rt.new_schema(bad4);
    let m4 = rt.thrown.clone();
    o.push_str(&format!("bad=[{}][{}][{}][{}] ", m1, m2, m3, m4));
    // A TABLE of one chunk, and reading a column out of it.
    let col0 = rt.vector(&[Value::fixnum(10), Value::fixnum(11), Value::fixnum(12)]);
    let ch = rt.obj(TY_VEC, table::CH_BASE + 2);
    rt.set(ch, table::CH_BASE, col0);
    let t = rt.obj(TY_VEC, 4);
    rt.set(t, table::TB_SCHEMA, s);
    rt.set(t, table::TB_CHUNKS, ch);
    rt.set(t, table::TB_COUNT, Value::fixnum(3));
    let cv = rt.table_column(t, ka);
    let cshow = rt.show_vec(cv);
    o.push_str(&format!("col={} ", cshow));
    // A COLUMN THAT IS NOT ONE refuses by name, and lists the columns.
    let kz = rt.keyword("z");
    rt.table_column(t, kz);
    let m5 = rt.thrown.clone();
    o.push_str(&format!("nocol=[{}] ", m5));
    // AND THE GAS RUNS OUT: a column of a table longer than the budget
    // answers NIL rather than scanning past it.
    rt.gas = 2;
    let starved = rt.table_column(t, ka);
    o.push_str(&format!("starved={}", starved.is_nil() as u32));
    println!("{}", o);
}
