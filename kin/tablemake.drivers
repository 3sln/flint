        else { self.vec_nth(v, i, NIL) }
    }
    fn empty_map(&mut self) -> Value { let a = self.alloc(TY_MAP, 1); self.lens[a as usize] = 0; Value::heap(a) }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        let n = self.lens[m.0 as usize];
        let a = self.alloc(TY_MAP, n + 2);
        self.lens[a as usize] = n + 2;
        for i in 0..n { self.h[a as usize + i as usize] = self.h[m.0 as usize + i as usize]; }
        self.h[a as usize + n as usize] = k.0;
        self.h[a as usize + n as usize + 1] = v.0;
        Value::heap(a)
    }
    fn is_map(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_MAP
    }
    fn map_count(&self, m: Value) -> u32 { self.lens[m.0 as usize] / 2 }
    // A MAP AS A SEQ of entries: a vector of `[k v]` MAP ENTRIES, and `next`
    // drops the head. `first-foreign-key` walks one.
    fn entry(&mut self, k: Value, v: Value) -> Value {
        let a = self.alloc(TY_MAPENTRY, 2);
        self.h[a as usize] = k.0; self.h[a as usize + 1] = v.0;
        Value::heap(a)
    }
    fn seq(&mut self, m: Value) -> Value {
        let n = self.lens[m.0 as usize];
        if n == 0 { return NIL; }
        let mut es = alloc::vec::Vec::new();
        let mut i = 0;
        while i < n {
            let (k, v) = (self.slot(m, i), self.slot(m, i + 1));
            let e = self.entry(k, v);
            es.push(e);
            i += 2;
        }
        self.vector(&es)
    }
    fn first(&mut self, q: Value) -> Value { self.vec_nth(q, 0, NIL) }
    fn next(&mut self, q: Value) -> Value {
        let n = self.vec_count(q);
        if n <= 1 { return NIL; }
        let rest: alloc::vec::Vec<Value> = (1..n).map(|i| self.slot(q, i)).collect();
        self.vector(&rest)
    }
    fn throw_str(&mut self, _kind: &str, msg: &alloc::string::String) -> Value {
        self.thrown = msg.clone();
        NIL
    }
    fn charge_work(&mut self, _n: u64) {}
    // The siblings from `tablemeta`, `tableref` and `tablecell`.
    fn schema_len(&self, s: Value) -> u32 { self.vec_count(self.slot(s, table::SC_NAMES)) }
    fn schema_width(&mut self, s: Value) -> u32 { self.slot(s, table::SC_WIDTH).as_fixnum() as u32 }
    fn schema_name_at(&mut self, s: Value, c: u32) -> Value {
        let names = self.slot(s, table::SC_NAMES);
        self.vec_nth(names, c, NIL)
    }
    fn schema_id(&mut self, s: Value, name: Value) -> u32 {
        let idx = self.slot(s, table::SC_INDEX);
        let n = self.lens[idx.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(idx, i).0 == name.0 { return self.slot(idx, i + 1).as_fixnum() as u32; }
            i += 2;
        }
        self.schema_width(s)
    }
    fn is_table_ref(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_TABLEREF
    }
    fn row_column(&mut self, s: Value, row: Value, c: u32) -> Value {
        let name = self.schema_name_at(s, c);
        let n = self.lens[row.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(row, i).0 == name.0 { return self.slot(row, i + 1); }
            i += 2;
        }
        NOT_FOUND
    }
    fn schema(&mut self, names: &[Value], types: &[Value]) -> Value {
        let s = self.obj(TY_SCHEMA, table::SC_LEN);
        let nv = self.vector(names);
        self.set(s, table::SC_NAMES, nv);
        let tv = self.vector(types);
        self.set(s, table::SC_TYPES, tv);
        self.set(s, table::SC_WIDTH, Value::fixnum(names.len() as i64));
        let mut idx = self.empty_map();
        for (i, n) in names.iter().enumerate() { idx = self.map_assoc(idx, *n, Value::fixnum(i as i64)); }
        self.set(s, table::SC_INDEX, idx);
