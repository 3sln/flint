        long kindOf(long v) { return Probe.kindOf(this, v); }
        long throwStr(String kind, String msg) { thrown = msg; return NIL; }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static final class Vec {
