--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
impl Value {
    fn is_heap(self) -> bool { self.0 >= 0x100 }
    fn as_heap(self) -> u32 { (self.0 & 0xff) as u32 }
    fn is_nil(self) -> bool { self.0 == 0 }
    fn is_bool(self) -> bool { self.0 == 1 || self.0 == 2 }
    fn is_double(self) -> bool { self.0 == 4 }
}
struct Sp;
struct Gc { sp: Sp }
struct Rt { gc: Gc }
fn ty(_sp: &Sp, h: u32) -> u8 { h as u8 }
const TY_CONS: u8 = 1; const TY_EMPTY_LIST: u8 = 2; const TY_LAZYSEQ: u8 = 3;
const TY_VECSEQ: u8 = 4; const TY_STRSEQ: u8 = 5; const TY_RANGE: u8 = 6;
const TY_VEC: u8 = 7; const TY_MAPENTRY: u8 = 8; const TY_ARRAYMAP: u8 = 9;
const TY_HASHMAP: u8 = 10; const TY_TABLEREF: u8 = 11; const TY_SET: u8 = 12;
const TY_SYM: u8 = 13; const TY_CLOSURE: u8 = 14; const TY_NATIVEFN: u8 = 15;
const TY_MULTIFN: u8 = 16;
const CAT_SEQUENTIAL: u8 = 1;
impl Rt {
    fn is_int(&self, v: Value) -> bool { v.0 == 3 || v.0 == 5 }
    fn is_number(&self, v: Value) -> bool { v.0 == 3 || v.0 == 4 || v.0 == 5 }
    fn is_string(&self, v: Value) -> bool { v.0 == 6 }
    fn is_keyword(&self, v: Value) -> bool { v.0 == 7 }
    fn tag(&self, v: Value) -> u8 { ty(&self.gc.sp, v.as_heap()) }
    fn is_vector_like(&self, v: Value) -> bool {
        v.is_heap() && (self.tag(v) == TY_VEC || self.tag(v) == TY_MAPENTRY)
    }
    fn category(&self, v: Value) -> u8 {
        if !v.is_heap() { return 0; }
        match self.tag(v) {
            TY_CONS | TY_EMPTY_LIST | TY_LAZYSEQ | TY_VECSEQ | TY_STRSEQ
            | TY_RANGE | TY_VEC | TY_MAPENTRY => CAT_SEQUENTIAL,
            _ => 0,
        }
    }
    fn is_seq(&self, v: Value) -> bool {
        v.is_heap() && self.tag(v) >= TY_CONS && self.tag(v) <= TY_RANGE
    }
    fn is_symbol(&self, v: Value) -> bool { v.is_heap() && self.tag(v) == TY_SYM }
    fn is_map(&self, v: Value) -> bool {
        v.is_heap() && self.tag(v) >= TY_ARRAYMAP && self.tag(v) <= TY_TABLEREF
    }
    fn is_set(&self, v: Value) -> bool { v.is_heap() && self.tag(v) == TY_SET }
--rust
}
fn main() {
    let rt = Rt { gc: Gc { sp: Sp } };
    let mut o = String::new();
    for code in 1..=15u32 {
        for imm in 0..8u64 { o.push_str(if rt.type_p(code, Value(imm)) { "1" } else { "0" }); }
        for h in 1..=16u64 { o.push_str(if rt.type_p(code, Value(0x100 | h)) { "1" } else { "0" }); }
        o.push(' ');
    }
    o.push_str(&format!("{}{}", rt.is_fn(Value(0x100 | 16)) as u8, rt.is_sequential(Value(0x100 | 8)) as u8));
    println!("{}", o);
}
