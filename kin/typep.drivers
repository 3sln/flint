    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        for (int code = 1; code <= 15; code++) {
            for (long imm = 0; imm < 8; imm++) o.append(typeP(rt, code, imm) ? "1" : "0");
            for (long h = 1; h <= 16; h++) o.append(typeP(rt, code, 0x100 | h) ? "1" : "0");
            o.append(' ');
        }
        o.append(isFn(rt, 0x100 | 16) ? 1 : 0).append(isSequential(rt, 0x100 | 8) ? 1 : 0);
        System.out.println(o);
    }
