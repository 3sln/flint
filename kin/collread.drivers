    static final int TY_VEC = 13, TY_MAPENTRY = 14, TY_TABLE = 15;
    static final int TY_TABLEREF = 16, TY_TAGGED = 17, TY_BYTES = 18;
    static final int TY_BROPE = 19, TY_TVEC = 20, TY_TMAP = 21;
    static final int TY_TSET = 22, TY_STR = 23, TY_OTHER = 24;
    static final int TY_CONS = 25, TY_EMPTY_LIST = 26, TY_LAZYSEQ = 27;
    static final int TY_VECSEQ = 28, TY_STRSEQ = 29;
    static final class Val {
        static final long NIL = Probe.NIL;
        static final long NOT_FOUND = Probe.NOT_FOUND;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >>> 40) == 0; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static long anInt(long n) { return 0x10000000000L | (n & 0xFFFFFFFFL); }
    static final class Space { byte[] m = new byte[4000]; }
    static final class Rt {
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        long bump = 100;
        int vn = 3;
        boolean rowmiss = false;
        String thrown = "";
