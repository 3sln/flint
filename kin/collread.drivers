--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long d = 0x11L, kw = 0x8CL;
        long two = anInt(2), neg = anInt(-1);

        long s = rt.obj(TY_STR);
        o.append("s=").append(Long.toHexString(collGet(rt, s, two, d))).append("/")
         .append(Long.toHexString(collGet(rt, s, neg, d))).append("/")
         .append(Long.toHexString(collGet(rt, s, kw, d))).append(' ');
        int[] tags = { TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_VEC, TY_MAPENTRY, TY_TABLE,
                       TY_TABLEREF, TY_BYTES, TY_BROPE, TY_TVEC, TY_TMAP, TY_TSET, TY_OTHER };
        for (int t : tags) {
            long v = rt.obj(t);
            o.append(Long.toHexString(collGet(rt, v, two, d))).append("/")
             .append(Long.toHexString(collGet(rt, v, neg, d))).append("/")
             .append(Long.toHexString(collGet(rt, v, kw, d))).append(' ');
        }
        long me = rt.obj(TY_MAPENTRY);
        o.append("me=").append(Long.toHexString(collGet(rt, me, anInt(0), d))).append("/")
         .append(Long.toHexString(collGet(rt, me, anInt(1), d))).append("/")
         .append(Long.toHexString(collGet(rt, me, anInt(2), d))).append(' ');
        long tg = rt.obj(TY_TAGGED);
        o.append("tag=").append(Long.toHexString(collGet(rt, tg, 0x8AL, d))).append("/")
         .append(Long.toHexString(collGet(rt, tg, 0x8BL, d))).append("/")
         .append(Long.toHexString(collGet(rt, tg, kw, d))).append(' ');
        rt.rowmiss = true;
        long tb = rt.obj(TY_TABLE);
        o.append("row=").append(Long.toHexString(collGet(rt, tb, two, d))).append(' ');
        rt.rowmiss = false;
        o.append("n=").append(Long.toHexString(collGet(rt, NIL, two, d))).append("/")
         .append(Long.toHexString(collGet(rt, 7L, two, d))).append(' ');

        long am = rt.obj(TY_ARRAYMAP);
        long st = rt.obj(TY_SET);
        long vc = rt.obj(TY_VEC);
        o.append("c=").append(collContains(rt, am, kw) ? 1 : 0)
         .append(collContains(rt, st, kw) ? 1 : 0)
         .append(collContains(rt, vc, two) ? 1 : 0)
         .append(collContains(rt, vc, anInt(3)) ? 1 : 0)
         .append(collContains(rt, vc, neg) ? 1 : 0)
         .append(collContains(rt, vc, kw) ? 1 : 0).append(' ');
        long tm = rt.obj(TY_TMAP);
        long ot = rt.obj(TY_OTHER);
        o.append("c2=").append(collContains(rt, NIL, kw) ? 1 : 0)
         .append(collContains(rt, tm, kw) ? 1 : 0)
         .append(collContains(rt, ot, kw) ? 1 : 0);
        System.out.println(o.toString());
    }
--csharp-pre
// `table-ref` resolves to a BARE `Table` and `ref-get` to a fully qualified
// `global::Flint.Rt.Table`, so the probe needs one of each. That the two are
// spelled differently in the vocabulary is a wart, not a rule.
namespace Flint.Rt {
    internal static class Table {
        internal static long refGet(Probe.Rt rt, long r, long k, long d) { return 0x923L; }
    }
}
