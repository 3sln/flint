    static long bAt(Rt rt, long b, int i, long d) { return 0x950L + i; }
    static long tvecNth(Rt rt, long t, int i, long d) { return 0x960L + i; }
    static long tmapGet(Rt rt, long t, long k, long d) { return 0x924L; }
    static long tsetGet(Rt rt, long t, long k, long d) { return 0x925L; }
