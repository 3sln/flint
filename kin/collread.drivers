    internal const long NIL = 0xFFFFL;
    internal const long NOT_FOUND = 0xFFFEL;
    internal static class Obj {
        internal const int TyArraymap = 10, TyHashmap = 11, TySet = 12;
        internal const int TyVec = 13, TyMapentry = 14, TyTable = 15;
        internal const int TyTableref = 16, TyTagged = 17, TyBytes = 18;
        internal const int TyBrope = 19, TyTvec = 20, TyTmap = 21;
        internal const int TyTset = 22, TyStr = 23, TyOther = 24;
        internal const int TyCons = 25, TyEmptyList = 26, TyLazyseq = 27;
        internal const int TyVecseq = 28, TyStrseq = 29;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal const long NotFound = Probe.NOT_FOUND;
        internal static bool IsHeap(long v) { return v >= 100 && v != NIL && v != NOT_FOUND && (v >> 40) == 0; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
    }
    internal static long AnInt(long n) { return 0x10000000000L | (n & 0xFFFFFFFFL); }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal int vn = 3;
        internal bool rowmiss = false;
        internal string thrown = "";
        internal long ThrowStr(string cls, string msg) { thrown = cls + "/" + msg; return Val.Nil; }
        internal long Slot(long v, int i) { return 0x700L + i; }
        internal long Obj_(int t) { long a = bump; bump += 8; gc.sp.m[(int) a] = (byte) t; return a; }
    }
    internal static class Str {
        internal static long Keyword(Rt rt, string ns, string n) { return n == "tag" ? 0x8AL : 0x8BL; }
        internal static long Nth(Rt rt, long s, int i, long d) { return 0x910L + i; }
    }
    internal static class Num {
        internal static long I64Of(Rt rt, long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    internal static long MapGet(Rt rt, long m, long k, long d) { return 0x921L; }
    internal static long SetGet(Rt rt, long s, long k, long d) { return 0x922L; }
    internal static class Vec {
        internal static long Nth(Rt rt, long v, int i, long d) { return 0x930L + i; }
        internal static int Count(Rt rt, long v) { return rt.vn; }
    }
    internal static long VecNth(Rt rt, long v, int i, long d) { return Vec.Nth(rt, v, i, d); }
    // `table-ref` and `ref-get` resolve to a BARE `Table`, so the probe puts
    // one inside itself rather than in the runtime's namespace.
    internal static class Table {
        internal static long tableRef(Rt rt, long t, int i) { return rt.rowmiss ? NIL : 0x940L + i; }
    }
    internal static long TableRef(Rt rt, long t, int i) { return Table.tableRef(rt, t, i); }
    internal static long BAt(Rt rt, long b, int i, long d) { return 0x950L + i; }
    internal static long TvecNth(Rt rt, long t, int i, long d) { return 0x960L + i; }
    internal static long TmapGet(Rt rt, long t, long k, long d) { return 0x924L; }
    internal static long TsetGet(Rt rt, long t, long k, long d) { return 0x925L; }
    internal static bool MapContains(Rt rt, long m, long k) { return true; }
    internal static bool SetContains(Rt rt, long s, long k) { return true; }
    internal static bool IsString(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyStr;
    }
