    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long d = 0x11L, kw = 0x8CL;
        long two = AnInt(2), neg = AnInt(-1);

        long s = rt.Obj_(Obj.TyStr);
        o.Append("s=").Append(CollGet(rt, s, two, d).ToString("x")).Append("/")
         .Append(CollGet(rt, s, neg, d).ToString("x")).Append("/")
         .Append(CollGet(rt, s, kw, d).ToString("x")).Append(' ');
        int[] tags = { Obj.TyArraymap, Obj.TyHashmap, Obj.TySet, Obj.TyVec, Obj.TyMapentry,
                       Obj.TyTable, Obj.TyTableref, Obj.TyBytes, Obj.TyBrope, Obj.TyTvec,
                       Obj.TyTmap, Obj.TyTset, Obj.TyOther };
        foreach (int t in tags) {
            long v = rt.Obj_(t);
            o.Append(CollGet(rt, v, two, d).ToString("x")).Append("/")
             .Append(CollGet(rt, v, neg, d).ToString("x")).Append("/")
             .Append(CollGet(rt, v, kw, d).ToString("x")).Append(' ');
        }
        long me = rt.Obj_(Obj.TyMapentry);
        o.Append("me=").Append(CollGet(rt, me, AnInt(0), d).ToString("x")).Append("/")
         .Append(CollGet(rt, me, AnInt(1), d).ToString("x")).Append("/")
         .Append(CollGet(rt, me, AnInt(2), d).ToString("x")).Append(' ');
        long tg = rt.Obj_(Obj.TyTagged);
        o.Append("tag=").Append(CollGet(rt, tg, 0x8AL, d).ToString("x")).Append("/")
         .Append(CollGet(rt, tg, 0x8BL, d).ToString("x")).Append("/")
         .Append(CollGet(rt, tg, kw, d).ToString("x")).Append(' ');
        rt.rowmiss = true;
        long tb = rt.Obj_(Obj.TyTable);
        o.Append("row=").Append(CollGet(rt, tb, two, d).ToString("x")).Append(' ');
        rt.rowmiss = false;
        o.Append("n=").Append(CollGet(rt, NIL, two, d).ToString("x")).Append("/")
         .Append(CollGet(rt, 7L, two, d).ToString("x")).Append(' ');

        long am = rt.Obj_(Obj.TyArraymap);
        long st = rt.Obj_(Obj.TySet);
        long vc = rt.Obj_(Obj.TyVec);
        o.Append("c=").Append(CollContains(rt, am, kw) ? 1 : 0)
         .Append(CollContains(rt, st, kw) ? 1 : 0)
         .Append(CollContains(rt, vc, two) ? 1 : 0)
         .Append(CollContains(rt, vc, AnInt(3)) ? 1 : 0)
         .Append(CollContains(rt, vc, neg) ? 1 : 0)
         .Append(CollContains(rt, vc, kw) ? 1 : 0).Append(' ');
        long tm = rt.Obj_(Obj.TyTmap);
        long ot = rt.Obj_(Obj.TyOther);
        o.Append("c2=").Append(CollContains(rt, NIL, kw) ? 1 : 0)
         .Append(CollContains(rt, tm, kw) ? 1 : 0)
         .Append(CollContains(rt, ot, kw) ? 1 : 0);
        System.Console.WriteLine(o.ToString());
    }
