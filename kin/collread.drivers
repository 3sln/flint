        static long i64Of(Rt rt, long v) { return (int) (v & 0xFFFFFFFFL); }
    }
    static long mapGet(Rt rt, long m, long k, long d) { return 0x921L; }
    static long setGet(Rt rt, long s, long k, long d) { return 0x922L; }
    static final class Vec {
