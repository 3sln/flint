--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const NOT_FOUND: Value = Value(0xFFFE);
const TY_ARRAYMAP: u8 = 10; const TY_HASHMAP: u8 = 11; const TY_SET: u8 = 12;
const TY_VEC: u8 = 13; const TY_MAPENTRY: u8 = 14; const TY_TABLE: u8 = 15;
const TY_TABLEREF: u8 = 16; const TY_TAGGED: u8 = 17; const TY_BYTES: u8 = 18;
const TY_BROPE: u8 = 19; const TY_TVEC: u8 = 20; const TY_TMAP: u8 = 21;
const TY_TSET: u8 = 22; const TY_STR: u8 = 23; const TY_OTHER: u8 = 24;
// The seq tags, which `contains?` must REFUSE rather than answer `false` for.
const TY_CONS: u8 = 25; const TY_EMPTY_LIST: u8 = 26; const TY_LAZYSEQ: u8 = 27;
const TY_VECSEQ: u8 = 28; const TY_STRSEQ: u8 = 29;
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { gc: Gc, bump: u64, vn: u32, rowmiss: bool, thrown: String }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
// A KEY IS AN INTEGER WHEN ITS TOP BITS SAY SO, and the payload sign-extends.
// An index of -1 that does not sign-extend prints as four billion, and every
// `>= 0` guard below is exactly what that would walk past.
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != NOT_FOUND.0 && (self.0 >> 40) == 0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
fn int(n: i64) -> Value { Value(0x100_0000_0000u64 | (n as u64 & 0xFFFF_FFFF)) }
impl Rt {
    // Recorded rather than raised: the probe compares the CLASS and MESSAGE
    // across three targets, and a refusal that is not printed is a refusal
    // nobody checked.
    fn throw_str(&mut self, class: &str, msg: &str) -> Value {
        self.thrown = format!("{}/{}", class, msg);
        NIL
    }
    fn slot(&self, _v: Value, i: u32) -> Value { Value(0x700 + i as u64) }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 8;
        self.gc.sp.m[a as usize] = t;
        Value(a)
    }
    fn is_string(&mut self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_STR
    }
    fn is_int(&mut self, v: Value) -> bool { (v.0 >> 40) == 1 }
    fn i64_of(&mut self, v: Value) -> i64 { ((v.0 & 0xFFFF_FFFF) as u32) as i32 as i64 }
    fn keyword(&mut self, _ns: Option<&str>, n: &str) -> Value {
        if n == "tag" { Value(0x8A) } else { Value(0x8B) }
    }
    fn char_at(&mut self, _s: Value, i: u32, _d: Value) -> Value { Value(0x910 + i as u64) }
    fn map_get(&mut self, _m: Value, _k: Value, _d: Value) -> Value { Value(0x921) }
    fn set_get(&mut self, _s: Value, _k: Value, _d: Value) -> Value { Value(0x922) }
    fn vec_nth(&mut self, _v: Value, i: u32, _d: Value) -> Value { Value(0x930 + i as u64) }
    fn table_ref(&mut self, _t: Value, i: u32) -> Value {
        if self.rowmiss { NIL } else { Value(0x940 + i as u64) }
    }
    fn ref_get(&mut self, _r: Value, _k: Value, _d: Value) -> Value { Value(0x923) }
    fn b_at(&mut self, _b: Value, i: u32, _d: Value) -> Value { Value(0x950 + i as u64) }
    fn tvec_nth(&mut self, _t: Value, i: u32, _d: Value) -> Value { Value(0x960 + i as u64) }
    fn tmap_get(&mut self, _t: Value, _k: Value, _d: Value) -> Value { Value(0x924) }
    fn tset_get(&mut self, _t: Value, _k: Value, _d: Value) -> Value { Value(0x925) }
    fn map_contains(&mut self, _m: Value, _k: Value) -> bool { true }
    fn set_contains(&mut self, _s: Value, _k: Value) -> bool { true }
    fn vec_count(&mut self, _v: Value) -> u32 { self.vn }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 4000] } }, bump: 100, vn: 3,
                      rowmiss: false, thrown: String::new() };
    let mut o = String::new();
    let d = Value(0x11);
    let kw = Value(0x8C);
    let two = int(2);
    let neg = int(-1);

    // A STRING is indexed by code point, and only by an index.
    let s = rt.obj(TY_STR);
    o.push_str(&format!("s={:x}/{:x}/{:x} ", rt.coll_get(s, two, d).0,
                        rt.coll_get(s, neg, d).0, rt.coll_get(s, kw, d).0));
    // Every tag, with an INTEGER key and then with one that is not.
    for t in [TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_VEC, TY_MAPENTRY, TY_TABLE,
              TY_TABLEREF, TY_BYTES, TY_BROPE, TY_TVEC, TY_TMAP, TY_TSET, TY_OTHER] {
        let v = rt.obj(t);
        o.push_str(&format!("{:x}/{:x}/{:x} ", rt.coll_get(v, two, d).0,
                            rt.coll_get(v, neg, d).0, rt.coll_get(v, kw, d).0));
    }
    // A MAP ENTRY is 0 and 1 and nothing else.
    let me = rt.obj(TY_MAPENTRY);
    o.push_str(&format!("me={:x}/{:x}/{:x} ", rt.coll_get(me, int(0), d).0,
                        rt.coll_get(me, int(1), d).0, rt.coll_get(me, int(2), d).0));
    // A TAGGED literal answers two keywords and nothing else.
    let tg = rt.obj(TY_TAGGED);
    o.push_str(&format!("tag={:x}/{:x}/{:x} ", rt.coll_get(tg, Value(0x8A), d).0,
                        rt.coll_get(tg, Value(0x8B), d).0, rt.coll_get(tg, kw, d).0));
    // A ROW PAST THE END is a miss, not a nil row.
    rt.rowmiss = true;
    let tb = rt.obj(TY_TABLE);
    o.push_str(&format!("row={:x} ", rt.coll_get(tb, two, d).0));
    rt.rowmiss = false;
    // NIL and a fixnum are both misses.
    o.push_str(&format!("n={:x}/{:x} ", rt.coll_get(NIL, two, d).0,
                        rt.coll_get(Value(7), two, d).0));

    // CONTAINS. The map and set arms delegate; the vector arm asks about the
    // INDEX; everything else is `get` against NOT_FOUND.
    let am = rt.obj(TY_ARRAYMAP);
    let st = rt.obj(TY_SET);
    let vc = rt.obj(TY_VEC);
    o.push_str(&format!("c={}{}{}{}{}{} ", rt.coll_contains(am, kw) as u32,
                        rt.coll_contains(st, kw) as u32,
                        rt.coll_contains(vc, two) as u32,
                        rt.coll_contains(vc, int(3)) as u32,
                        rt.coll_contains(vc, neg) as u32,
                        rt.coll_contains(vc, kw) as u32));
    let tm = rt.obj(TY_TMAP);
    let ot = rt.obj(TY_OTHER);
    let (c1, c2, c3) = (rt.coll_contains(NIL, kw), rt.coll_contains(tm, kw),
                        rt.coll_contains(ot, kw));
    o.push_str(&format!("c2={}{}{}", c1 as u32, c2 as u32, c3 as u32));
    println!("{}", o);
}
