    static Rt Fresh(long nextId) {
        var rt = new Rt();
        rt.Empty = rt.MakeObj(new long[0]);
        rt.EmptyMapV = rt.MakeObj(new long[0]);
        long pairs = rt.MakeObj(new long[0]);
        long threads = rt.MakeObj(new long[0]);
        rt.SchedV = rt.MakeObj(new long[]{ nextId, pairs, threads });
        return rt;
    }
    static string Made(Rt rt, long p) {
        long inbox = rt.Slot(p, Conc.PT_INBOX);
        int n = VecCount(rt, inbox);
        bool allEmpty = true;
        for (int i = 0; i < n; i++) if (rt.Slot(inbox, i) != EMPTY) allEmpty = false;
        var reg = new System.Collections.Generic.List<string>();
        foreach (long id in rt.Registered) reg.Add(id.ToString());
        return rt.Slot(p, Conc.PT_ID) + " " + rt.Slot(rt.SchedV, Conc.SC_NEXTID)
             + " " + rt.Slot(p, Conc.PT_RING) + " " + n + " " + (allEmpty ? 1 : 0)
             + " " + rt.Slot(p, Conc.PT_READ) + " " + rt.Slot(p, Conc.PT_WRITE)
             + " " + rt.Slot(p, Conc.PT_BYTES) + " " + rt.Slot(p, Conc.PT_PEER)
             + " " + rt.Slot(p, Conc.PT_KIND)
             + " " + (reg.Count == 0 ? "-" : string.Join(",", reg));
    }
    static void Main() {
        var a = Fresh(7);
        long pa = NewPortAt(a, 4, a.MakeObj(new long[0]), Conc.K_CHANNEL, 1, -1);
