    static Rt fresh(long nextId) {
        Rt rt = new Rt();
        rt.empty = rt.obj(new long[0]);
        rt.emptyMapV = rt.obj(new long[0]);
        long pairs = rt.obj(new long[0]);
        long threads = rt.obj(new long[0]);
        rt.schedV = rt.obj(new long[]{nextId, pairs, threads});
        return rt;
    }
    static String made(Rt rt, long p) {
        long inbox = rt.slot(p, Conc.PT_INBOX);
        int n = vecCount(rt, inbox);
        boolean allEmpty = true;
        for (int i = 0; i < n; i++) if (rt.slot(inbox, i) != EMPTY) allEmpty = false;
        StringBuilder reg = new StringBuilder();
        for (long id : rt.registered) { if (reg.length() > 0) reg.append(','); reg.append(id); }
        return rt.slot(p, Conc.PT_ID) + " " + rt.slot(rt.schedV, Conc.SC_NEXTID)
             + " " + rt.slot(p, Conc.PT_RING) + " " + n + " " + (allEmpty ? 1 : 0)
             + " " + rt.slot(p, Conc.PT_READ) + " " + rt.slot(p, Conc.PT_WRITE)
             + " " + rt.slot(p, Conc.PT_BYTES) + " " + rt.slot(p, Conc.PT_PEER)
             + " " + rt.slot(p, Conc.PT_KIND)
             + " " + (reg.length() == 0 ? "-" : reg.toString());
    }
    public static void main(String[] args) {
        Rt a = fresh(7);
        long pa = newPortAt(a, 4, a.obj(new long[0]), Conc.K_CHANNEL, 1, -1);
        String r1 = made(a, pa);

        Rt b = fresh(7);
        long pb = newPortAt(b, 0, b.obj(new long[0]), Conc.K_CHANNEL, 1, -1);
        String r2 = rt2(b, pb);

        Rt c = fresh(7);
        long pc = newPortAt(c, 65536, c.obj(new long[0]), 1, 1, 99);
        String r3 = c.slot(pc, Conc.PT_ID) + " " + c.slot(c.schedV, Conc.SC_NEXTID)
                  + " " + c.slot(pc, Conc.PT_RING) + " "
                  + vecCount(c, c.slot(pc, Conc.PT_INBOX));

        Rt d = fresh(1);
        long p1 = newPortAt(d, 1, d.obj(new long[0]), Conc.K_CHANNEL, 1, -1);
        long p2 = newPortAt(d, 1, d.obj(new long[0]), Conc.K_CHANNEL, 1, -1);
        linkPeersAt(d, p1, p2);
        long pairs = d.slot(d.schedV, Conc.SC_PAIRS);
        StringBuilder rend = new StringBuilder();
        for (int i = 0; i < vecCount(d, pairs); i++) {
            long e = d.slot(pairs, i);
            if (rend.length() > 0) rend.append(',');
            rend.append(d.slot(e, 0)).append(':').append(d.slot(e, 1));
        }
        String r4 = d.slot(p1, Conc.PT_PEER) + " " + d.slot(p2, Conc.PT_PEER)
                  + " " + rend;
        Rt ch = fresh(5);
        long clbl = ch.obj(new long[0]);
        long pair = channelAt(ch, 4, clbl);
        long ca = ch.slot(pair, 0), cb = ch.slot(pair, 1);
        String r5 = vecCount(ch, pair) + " " + ch.slot(ca, Conc.PT_ID) + " " + ch.slot(cb, Conc.PT_ID)
                  + " " + ch.slot(ca, Conc.PT_CAP) + " " + ch.slot(cb, Conc.PT_CAP)
                  + " " + ch.slot(ca, Conc.PT_PEER) + " " + ch.slot(cb, Conc.PT_PEER)
                  + " " + (ch.slot(ca, Conc.PT_LABEL) == ch.slot(cb, Conc.PT_LABEL) ? 1 : 0);

        Rt sp1 = fresh(5);
        long entry = sp1.obj(new long[0]);
        long th = spawnAt(sp1, entry);
        String r6 = sp1.slot(th, Conc.TH_STATUS) + " " + sp1.slot(th, Conc.TH_ID)
                  + " " + sp1.slot(th, Conc.TH_TOKEN)
                  + " " + (sp1.slot(th, Conc.TH_ENTRY) == entry ? 1 : 0)
                  + " " + (sp1.slot(th, Conc.TH_BINDINGS) == NIL ? 1 : 0)
                  + " " + vecCount(sp1, sp1.slot(sp1.schedV, Conc.SC_THREADS));

        Rt sp2 = fresh(5);
        long m = sp2.obj(new long[0]);
        sp2.binds = m;
        long th2 = spawnAt(sp2, sp2.obj(new long[0]));
        String r7 = sp2.slot(th2, Conc.TH_BINDINGS) == m ? "1" : "0";

        System.out.println(r1 + " | " + r2 + " | " + r3 + " | " + r4
                           + " | " + r5 + " | " + r6 + " | " + r7);
    }
    static String rt2(Rt rt, long p) {
        return rt.slot(p, Conc.PT_RING) + " " + vecCount(rt, rt.slot(p, Conc.PT_INBOX));
    }
