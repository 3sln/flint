    // THE SAME TOY, field for field.
    static final long NIL = 0xFFFF000000000000L;
    static final long EMPTY = 0xFFFF000000000006L;
    static final int TY_PORT = 30, TY_NODE = 10, TY_THREAD = 31;
    static final class Val {
        static final long NIL = 0xFFFF000000000000L;
        static final long EMPTY = 0xFFFF000000000006L;
        static boolean isNil(long v) { return v == NIL; }
        static long fixnum(long n) { return n; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
    }
    static long fx(long v) { return v; }
    static final class Conc {
        static final int PT_ID = 0, PT_STATE = 1, PT_CAP = 2, PT_INBOX = 3,
                         PT_RING = 4, PT_READ = 5, PT_WRITE = 6, PT_BYTES = 7,
                         PT_PEER = 8, PT_LABEL = 9, PT_KIND = 10, PT_LEN = 11;
        static final int SC_NEXTID = 0, SC_PAIRS = 1, SC_THREADS = 2;
        // A TOY THREAD, five slots -- see the Rust head.
        static final int TH_STATUS = 0, TH_ID = 1, TH_TOKEN = 2,
                         TH_ENTRY = 3, TH_BINDINGS = 4, TH_LEN = 5;
        static final long ST_NEW = 0, P_OPEN = 1;
        static long currentBindings(Rt rt) { return rt.binds; }
        static long ensureSched(Rt rt) { return rt.schedV; }
        static final long K_CHANNEL = 0, RING_MESSAGES = 64;
        static void registerPort(Rt rt, long p) { rt.registered.add(rt.slot(p, PT_ID)); }
        static long newObj(Rt rt, int ty, int len) { return rt.newObj(ty, len); }
        static long sched(Rt rt) { return rt.schedV; }
    }
    static final class Maps { static long empty(Rt rt) { return rt.emptyMapV; } }
    static final class Rt {
        java.util.List<long[]> objs = new java.util.ArrayList<>();
        java.util.List<Long> roots = new java.util.ArrayList<>();
        java.util.List<Long> registered = new java.util.ArrayList<>();
        long schedV = NIL, empty = NIL, binds = NIL, emptyMapV = NIL;
        long obj(long[] slots) { objs.add(slots); return objs.size() - 1; }
        long newObj(int ty, int len) {
            long[] row = new long[len];
            java.util.Arrays.fill(row, NIL);
            return obj(row);
        }
        long slot(long v, int i) { return objs.get((int) v)[i]; }
        void setSlot(long v, int i, long x) { objs.get((int) v)[i] = x; }
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int i) { while (roots.size() > i) roots.remove(roots.size() - 1); }
    }
    static final class Vec { static long empty(Rt rt) { return rt.empty; } }
    static long vecConj(Rt rt, long v, long x) {
        long[] cur = rt.objs.get((int) v);
        long[] next = java.util.Arrays.copyOf(cur, cur.length + 1);
        next[cur.length] = x;
        return rt.obj(next);
    }
    static int vecCount(Rt rt, long v) { return rt.objs.get((int) v).length; }
