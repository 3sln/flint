        string r2 = b.Slot(pb, Conc.PT_RING) + " " + VecCount(b, b.Slot(pb, Conc.PT_INBOX));

        var c = Fresh(7);
        long pc = NewPortAt(c, 65536, c.MakeObj(new long[0]), 1, 1, 99);
        string r3 = c.Slot(pc, Conc.PT_ID) + " " + c.Slot(c.SchedV, Conc.SC_NEXTID)
                  + " " + c.Slot(pc, Conc.PT_RING) + " "
                  + VecCount(c, c.Slot(pc, Conc.PT_INBOX));

        var d = Fresh(1);
        long p1 = NewPortAt(d, 1, d.MakeObj(new long[0]), Conc.K_CHANNEL, 1, -1);
        long p2 = NewPortAt(d, 1, d.MakeObj(new long[0]), Conc.K_CHANNEL, 1, -1);
        LinkPeersAt(d, p1, p2);
        long pairs = d.Slot(d.SchedV, Conc.SC_PAIRS);
        var rend = new System.Collections.Generic.List<string>();
        for (int i = 0; i < VecCount(d, pairs); i++) {
            long e = d.Slot(pairs, i);
            rend.Add(d.Slot(e, 0) + ":" + d.Slot(e, 1));
        }
        string r4 = d.Slot(p1, Conc.PT_PEER) + " " + d.Slot(p2, Conc.PT_PEER)
                  + " " + string.Join(",", rend);
        var ch = Fresh(5);
        long clbl = ch.MakeObj(new long[0]);
        long pair = ChannelAt(ch, 4, clbl);
        long ca = ch.Slot(pair, 0), cb = ch.Slot(pair, 1);
        string r5 = VecCount(ch, pair) + " " + ch.Slot(ca, Conc.PT_ID) + " " + ch.Slot(cb, Conc.PT_ID)
                  + " " + ch.Slot(ca, Conc.PT_CAP) + " " + ch.Slot(cb, Conc.PT_CAP)
                  + " " + ch.Slot(ca, Conc.PT_PEER) + " " + ch.Slot(cb, Conc.PT_PEER)
                  + " " + (ch.Slot(ca, Conc.PT_LABEL) == ch.Slot(cb, Conc.PT_LABEL) ? 1 : 0);

        var sp1 = Fresh(5);
        long entry = sp1.MakeObj(new long[0]);
        long th = SpawnAt(sp1, entry);
        string r6 = sp1.Slot(th, Conc.TH_STATUS) + " " + sp1.Slot(th, Conc.TH_ID)
                  + " " + sp1.Slot(th, Conc.TH_TOKEN)
                  + " " + (sp1.Slot(th, Conc.TH_ENTRY) == entry ? 1 : 0)
                  + " " + (sp1.Slot(th, Conc.TH_BINDINGS) == NIL ? 1 : 0)
                  + " " + VecCount(sp1, sp1.Slot(sp1.SchedV, Conc.SC_THREADS));

        var sp2 = Fresh(5);
        long m = sp2.MakeObj(new long[0]);
        sp2.Binds = m;
        long th2 = SpawnAt(sp2, sp2.MakeObj(new long[0]));
        string r7 = sp2.Slot(th2, Conc.TH_BINDINGS) == m ? "1" : "0";

        System.Console.WriteLine(r1 + " | " + r2 + " | " + r3 + " | " + r4
                                 + " | " + r5 + " | " + r6 + " | " + r7);
    }
--expect
7 8 4 4 1 0 0 0 -1 0 7 | 1 1 | 99 7 64 64 | 2 1 1:2,2:1 | 2 5 6 4 4 6 5 1 | 0 5 -1 1 0 1 | 1
--expect-why
DERIVED FROM WHAT MAKING A PORT PROMISES.

  Case 1, a CHANNEL of capacity 4 with the id left to the runtime. Fields are
  `<id> <nextid after> <ring> <inbox len> <all EMPTY> <read> <write> <bytes>
  <peer> <kind> <registered>`:

    `7`   THE COUNTER'S VALUE became this port's id.
    `8`   ... and the counter was CONSUMED. Case 3 is the other half of this.
    `4`   the ring is the channel's cap.
    `4`   and the inbox array is actually that long -- `PT_RING` saying 4 while
          the array is 64 would be a ring that wraps inside a larger buffer,
          which reads correct until the day something walks the array.
    `1`   EVERY SLOT IS `EMPTY`, not nil. A vacant slot's own word is what says
          it is vacant, so a ring left full of nil has no vacancies at all --
          and nil is a value a guest can legitimately send.
    `0 0 0`  the cursors and the byte count start at zero.
    `-1`  NO PEER, as an ID rather than an object.
    `0`   the kind it was asked for.
    `7`   and it was REGISTERED, under that id. A port the registry never heard
          of cannot be found by any later lookup.

  Case 2, a channel asking for capacity 0. `1 1`: THE RING IS FLOORED AT ONE,
  in `PT_RING` and in the array. `channel` is allowed to ask for nothing, and
  a zero-length ring can never accept anything -- every send on it would find
  no vacancy for ever. Without the floor this reads `0 0`.

  Case 3, a BRIDGE with a byte budget of 65536 and an id given from outside.
  `99 7 64 64`:

    `99`  the given id is USED as given.
    `7`   **AND THE COUNTER IS NOT TOUCHED.** A host id is the host's own to
          choose; consuming a counter value for one hands the same number out
          twice later. Case 1's `8` and this `7` are the pair -- neither field
          alone says the rule, because an implementation that always bumped
          passes case 1 and one that never bumped passes case 3.
    `64`  **THE RING IS `RING_MESSAGES`, NOT THE CAP.** A bridge's cap is a
          budget in BYTES and its ring is a count of MESSAGES; sizing one from
          the other would allocate 65 536 slots for a port allowed 65 536
          bytes. The two are different questions and this is the field that
          says so -- it reads `65536` if they are confused.
    `64`  and the array is that long too.

  Case 4, linking two ends. `2 1 1:2,2:1`:

    `2 1` each end learns the OTHER's id.
    `1:2,2:1`  **AND THE SCHEDULER LEARNS IT TWICE, BOTH WAYS ROUND.** The
          lookup walks this list comparing the FIRST element, so a pairing
          recorded one way only answers one way -- and the end that was second
          would find no peer at all, which is indistinguishable from an
          orphaned port and is how it would actually present. Recording only
          `1:2` still passes both of the fields before it.

  --- case 5, a CHANNEL: `<len> <a id> <b id> <a cap> <b cap> <a peer> <b peer>
      <labels equal>` ---

  chan `2`      TWO ENDS, returned as a vector the caller destructures.
  chan `5 6`    THE ENDS ARE IN THE ORDER THEY WERE MADE. Nothing else
                distinguishes them -- they are symmetric -- so the order has to
                be fixed here rather than discovered, and the ids are what show
                it: reversed, this reads `6 5`.
  chan `4 4`    **BOTH ENDS GET THE CAP.** A channel is one queue seen from two
                sides; a bound that differed by direction would accept more one
                way than the other, and only the second field says the second
                end got it. Reads `4 0` if the cap reaches one end only.
  chan `6 5`    AND THEY ARE WIRED, each naming the other. `-1 -1` if
                `link-peers-at` is not called -- which is a channel whose two
                ends have never heard of each other and which presents as two
                orphaned ports.
  chan `1`      BOTH ENDS CARRY THE SAME LABEL. It names the CHANNEL; an end
                reporting a different name from its peer makes a diagnostic
                read as though two conversations were involved.

  --- cases 6-7, a SPAWN: `<status> <id> <token> <entry kept> <bindings nil>
      <threads>` then `<bindings inherited>` ---

  spawn `0`     **`ST_NEW`, NOT `ST_RUNNABLE`.** That is what `run-one` reads to
                choose between STARTING this thread at its entry and RESUMING
                one that parked. Marked runnable before it has ever run, it is
                restored from a `TH_STACK` of nil and continues off the end of
                an empty value stack. Reads `1` if the state is wrong.
  spawn `5`     THE ID CAME FROM `SC_NEXTID` -- the sandbox's counter, the same
                one a port's id comes from, so a thread and a port never share
                a number and neither is an index into anything.
  spawn `-1`    NO WAITER YET.
  spawn `1`     THE ENTRY IS KEPT, and it is the value that was passed rather
                than anything derived from it.
  spawn `0`     **THE BINDINGS ARE NOT NIL**, even though nothing had bound:
                the empty map is used. A thread carrying nil there would have
                every later binding push onto nothing.
  spawn `1`     AND IT IS ENROLLED. A thread the scheduler does not hold is a
                thread nothing will ever pick; reads `0` if the append is
                missing, and every field before it still passes.
  spawn `1`     **BINDINGS LIVE AT THE SPAWN ARE INHERITED**, which is the
                whole of what makes a dynamic binding dynamic across a spawn.
                This case is the previous one's fixture with one thing changed
                -- a map is bound first -- and it reads `0` if the new thread
                is given the empty map regardless. Case 6's `0` cannot see
                that: both a correct inherit and a blanket empty-map are
                non-nil there.

