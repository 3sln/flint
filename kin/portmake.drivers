    // THE SAME TOY AGAIN, in this target's spelling.
    const long NIL = unchecked((long)0xFFFF000000000000UL);
    const long EMPTY = unchecked((long)0xFFFF000000000006UL);
    static class Obj { public const int TyPort = 30, TyNode = 10, TyThread = 31; }
    static class Maps { public static long Empty(Rt rt) => rt.EmptyMapV; }
    static class Val {
        public const long Nil = unchecked((long)0xFFFF000000000000UL);
        public const long Empty = unchecked((long)0xFFFF000000000006UL);
        public static bool IsNil(long v) => v == Nil;
        public static long Fixnum(long n) => n;
        public static long AsHeap(long v) => v;
        public static long AsFixnum(long v) => v;
    }
    static long Fx(long v) => v;
    static class Conc {
        public const int PT_ID = 0, PT_STATE = 1, PT_CAP = 2, PT_INBOX = 3,
                         PT_RING = 4, PT_READ = 5, PT_WRITE = 6, PT_BYTES = 7,
                         PT_PEER = 8, PT_LABEL = 9, PT_KIND = 10, PT_LEN = 11;
        public const int SC_NEXTID = 0, SC_PAIRS = 1, SC_THREADS = 2;
        // A TOY THREAD, five slots -- see the Rust head.
        public const int TH_STATUS = 0, TH_ID = 1, TH_TOKEN = 2,
                         TH_ENTRY = 3, TH_BINDINGS = 4, TH_LEN = 5;
        public const long ST_NEW = 0, P_OPEN = 1;
        public static long CurrentBindings(Rt rt) => rt.Binds;
        public static long EnsureSched(Rt rt) => rt.SchedV;
        public const long K_CHANNEL = 0, RingMessages = 64;
        public static void RegisterPort(Rt rt, long p) { rt.Registered.Add(rt.Slot(p, PT_ID)); }
        public static long NewObj(Rt rt, int ty, int len) => rt.NewObj(ty, len);
        public static long Sched(Rt rt) => rt.SchedV;
        public static long EmptyMap(Rt rt) => rt.EmptyMapV;
    }
    public class Rt {
        public System.Collections.Generic.List<long[]> Objs = new System.Collections.Generic.List<long[]>();
        public System.Collections.Generic.List<long> Roots = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> Registered = new System.Collections.Generic.List<long>();
        public long SchedV = NIL, Empty = NIL, Binds = NIL, EmptyMapV = NIL;
        public long MakeObj(long[] slots) { Objs.Add(slots); return Objs.Count - 1; }
        public long NewObj(int ty, int len) {
            var row = new long[len];
            for (int i = 0; i < len; i++) row[i] = NIL;
            return MakeObj(row);
        }
        public long Slot(long v, int i) => Objs[(int) v][i];
        public void SetSlot(long v, int i, long x) { Objs[(int) v][i] = x; }
        public int Mark() => Roots.Count;
        public int Push(long v) { Roots.Add(v); return Roots.Count - 1; }
        public long R(int i) => Roots[i];
        public void SetR(int i, long v) { Roots[i] = v; }
        public void PopTo(int i) { while (Roots.Count > i) Roots.RemoveAt(Roots.Count - 1); }
    }
    static class Vec { public static long Empty(Rt rt) => rt.Empty; }
    static long VecConj(Rt rt, long v, long x) {
        var cur = rt.Objs[(int) v];
        var next = new long[cur.Length + 1];
        System.Array.Copy(cur, next, cur.Length);
        next[cur.Length] = x;
        return rt.MakeObj(next);
    }
    static int VecCount(Rt rt, long v) => rt.Objs[(int) v].Length;
