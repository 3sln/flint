--rust-head
// A TOY HEAP. A port is a row of slots, a vector is a row of items, and the
// scheduler is a row of two. Nothing models the interns table: `register-port`
// is a word, so what the fixture has to observe is only THAT it was called and
// with which id.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF_0000_0000_0000);
mod value { pub const EMPTY: super::Value = super::Value(0xFFFF_0000_0000_0006); }
const EMPTY: Value = Value(0xFFFF_0000_0000_0006);
const TY_PORT: u8 = 30;
const TY_THREAD: u8 = 31;
const TY_NODE: u8 = 10;
mod conc {
    // TOY INDICES, dense and small. What has to agree is the three fixtures,
    // not these and the real `Conc`.
    pub const PT_ID: u32 = 0;
    pub const PT_STATE: u32 = 1;
    pub const PT_CAP: u32 = 2;
    pub const PT_INBOX: u32 = 3;
    pub const PT_RING: u32 = 4;
    pub const PT_READ: u32 = 5;
    pub const PT_WRITE: u32 = 6;
    pub const PT_BYTES: u32 = 7;
    pub const PT_PEER: u32 = 8;
    pub const PT_LABEL: u32 = 9;
    pub const PT_KIND: u32 = 10;
    pub const PT_LEN: u32 = 11;
    pub const SC_NEXTID: u32 = 0;
    pub const SC_PAIRS: u32 = 1;
    pub const SC_THREADS: u32 = 2;
    // A TOY THREAD, five slots.
    pub const TH_STATUS: u32 = 0;
    pub const TH_ID: u32 = 1;
    pub const TH_TOKEN: u32 = 2;
    pub const TH_ENTRY: u32 = 3;
    pub const TH_BINDINGS: u32 = 4;
    pub const TH_LEN: u32 = 5;
    // THE REAL VALUES, because the expected answers name them.
    pub const ST_NEW: i64 = 0;
    pub const P_OPEN: i64 = 1;
    pub const K_CHANNEL: i64 = 0;
    // THE REAL VALUE, because the expected answers name it.
    pub const RING_MESSAGES: i64 = 64;
}
impl Value {
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn is_nil(self) -> bool { self == NIL }
}
struct Rt { objs: Vec<Vec<Value>>, roots: Vec<Value>, sched_v: Value,
            empty: Value, registered: Vec<i64>,
            // The live dynamic bindings, which a spawn INHERITS. Nil until
            // something has bound, which is the case the empty-map default is
            // for.
            binds: Value, empty_map_v: Value }
impl Rt {
    fn obj(&mut self, slots: Vec<Value>) -> Value {
        self.objs.push(slots);
        Value((self.objs.len() - 1) as u64)
    }
    fn new_obj(&mut self, _ty: u8, len: u32) -> Value { self.obj(vec![NIL; len as usize]) }
    fn slot(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.objs[v.0 as usize][i as usize] = x; }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, i: usize) { self.roots.truncate(i); }
    fn sched(&self) -> Value { self.sched_v }
    fn empty_vec(&self) -> Value { self.empty }
    fn vec_conj(&mut self, v: Value, x: Value) -> Value {
        let mut next = self.objs[v.0 as usize].clone();
        next.push(x);
        self.obj(next)
    }
    fn vec_count(&self, v: Value) -> u32 { self.objs[v.0 as usize].len() as u32 }
    fn vec_nth_raw(&self, v: Value, i: u32) -> Value { self.objs[v.0 as usize][i as usize] }
    fn empty_map(&self) -> Value { self.empty_map_v }
    // The fixture always has one, so this is the no-op branch of the real thing.
    fn ensure_sched(&mut self) -> Value { self.sched_v }
    fn current_bindings(&self) -> Value { self.binds }
    fn register_port(&mut self, p: Value) {
        let id = self.slot(p, conc::PT_ID).as_fixnum();
        self.registered.push(id);
    }
--rust
}
fn fresh(next_id: i64) -> Rt {
    let mut rt = Rt { objs: vec![], roots: vec![], sched_v: NIL, empty: NIL,
                      registered: vec![], binds: NIL, empty_map_v: NIL };
    rt.empty = rt.obj(vec![]);
    rt.empty_map_v = rt.obj(vec![]);
    let pairs = rt.obj(vec![]);
    let threads = rt.obj(vec![]);
    rt.sched_v = rt.obj(vec![Value::fixnum(next_id), pairs, threads]);
    rt
}
// `<id> <nextid after> <ring> <inbox len> <all EMPTY> <read> <write> <bytes>
//  <peer> <kind> <registered>`
fn made(rt: &Rt, p: Value) -> String {
    let inbox = rt.slot(p, conc::PT_INBOX);
    let n = rt.vec_count(inbox);
    let all_empty = (0..n).all(|i| rt.slot(inbox, i) == EMPTY);
    let reg: Vec<String> = rt.registered.iter().map(|i| i.to_string()).collect();
    format!("{} {} {} {} {} {} {} {} {} {} {}",
            rt.slot(p, conc::PT_ID).as_fixnum(),
            rt.slot(rt.sched_v, conc::SC_NEXTID).as_fixnum(),
            rt.slot(p, conc::PT_RING).as_fixnum(),
            n,
            if all_empty { 1 } else { 0 },
            rt.slot(p, conc::PT_READ).as_fixnum(),
            rt.slot(p, conc::PT_WRITE).as_fixnum(),
            rt.slot(p, conc::PT_BYTES).as_fixnum(),
            rt.slot(p, conc::PT_PEER).as_fixnum(),
            rt.slot(p, conc::PT_KIND).as_fixnum(),
            if reg.is_empty() { "-".to_string() } else { reg.join(",") })
}
fn main() {
    // 1. A CHANNEL, id CHOSEN. Every slot set, the counter consumed.
    let mut a = fresh(7);
    let lbl = a.obj(vec![]);
    let pa = a.new_port_at(4, lbl, conc::K_CHANNEL, 1, -1);
    let r1 = made(&a, pa);

    // 2. A CHANNEL ASKING FOR NOTHING. The ring is floored at one.
    let mut b = fresh(7);
    let lbl = b.obj(vec![]);
    let pb = b.new_port_at(0, lbl, conc::K_CHANNEL, 1, -1);
    let r2 = format!("{} {}", b.slot(pb, conc::PT_RING).as_fixnum(),
                     b.vec_count(b.slot(pb, conc::PT_INBOX)));

    // 3. A BRIDGE WITH A BYTE BUDGET AND A GIVEN ID. The ring is
    //    RING_MESSAGES and NOT the cap, and the counter is untouched.
    let mut c = fresh(7);
    let lbl = c.obj(vec![]);
    let pc = c.new_port_at(65536, lbl, 1, 1, 99);
    let r3 = format!("{} {} {} {}",
                     c.slot(pc, conc::PT_ID).as_fixnum(),
                     c.slot(c.sched_v, conc::SC_NEXTID).as_fixnum(),
                     c.slot(pc, conc::PT_RING).as_fixnum(),
                     c.vec_count(c.slot(pc, conc::PT_INBOX)));

    // 4. LINKING TWO ENDS, both directions in both places.
    let mut d = fresh(1);
    let l1 = d.obj(vec![]);
    let p1 = d.new_port_at(1, l1, conc::K_CHANNEL, 1, -1);
    let l2 = d.obj(vec![]);
    let p2 = d.new_port_at(1, l2, conc::K_CHANNEL, 1, -1);
    d.link_peers_at(p1, p2);
    let pairs = d.slot(d.sched_v, conc::SC_PAIRS);
    let np = d.vec_count(pairs);
    let mut rendered: Vec<String> = vec![];
    for i in 0..np {
        let e = d.slot(pairs, i);
        rendered.push(format!("{}:{}", d.slot(e, 0).as_fixnum(), d.slot(e, 1).as_fixnum()));
    }
    let r4 = format!("{} {} {}",
                     d.slot(p1, conc::PT_PEER).as_fixnum(),
                     d.slot(p2, conc::PT_PEER).as_fixnum(),
                     rendered.join(","));

    // 5. A CHANNEL: two ends, same cap, same label, wired, returned in order.
    let mut ch = fresh(5);
    let clbl = ch.obj(vec![]);
    let pair = ch.channel_at(4, clbl);
    let ca = ch.vec_nth_raw(pair, 0);
    let cb = ch.vec_nth_raw(pair, 1);
    let r5 = format!("{} {} {} {} {} {} {} {}",
        ch.vec_count(pair),
        ch.slot(ca, conc::PT_ID).as_fixnum(), ch.slot(cb, conc::PT_ID).as_fixnum(),
        ch.slot(ca, conc::PT_CAP).as_fixnum(), ch.slot(cb, conc::PT_CAP).as_fixnum(),
        ch.slot(ca, conc::PT_PEER).as_fixnum(), ch.slot(cb, conc::PT_PEER).as_fixnum(),
        if ch.slot(ca, conc::PT_LABEL) == ch.slot(cb, conc::PT_LABEL) { 1 } else { 0 });

    // 6. A SPAWN WITH NO BINDINGS LIVE. The empty map is used, not nil.
    let mut sp1 = fresh(5);
    let entry = sp1.obj(vec![]);
    let th = sp1.spawn_at(entry);
    let gs = sp1.sched_v;
    let r6 = format!("{} {} {} {} {} {}",
        sp1.slot(th, conc::TH_STATUS).as_fixnum(),
        sp1.slot(th, conc::TH_ID).as_fixnum(),
        sp1.slot(th, conc::TH_TOKEN).as_fixnum(),
        if sp1.slot(th, conc::TH_ENTRY) == entry { 1 } else { 0 },
        if sp1.slot(th, conc::TH_BINDINGS).is_nil() { 1 } else { 0 },
        sp1.vec_count(sp1.slot(gs, conc::SC_THREADS)));

    // 7. A SPAWN WITH BINDINGS LIVE. They are INHERITED, not replaced.
    let mut sp2 = fresh(5);
    let m = sp2.obj(vec![]);
    sp2.binds = m;
    let entry2 = sp2.obj(vec![]);
    let th2 = sp2.spawn_at(entry2);
    let r7 = if sp2.slot(th2, conc::TH_BINDINGS) == m { "1" } else { "0" };

    println!("{} | {} | {} | {} | {} | {} | {}", r1, r2, r3, r4, r5, r6, r7);
}
