--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NOT_FOUND: Value = Value(0xFFFE);
const HASH_BITS: u32 = 5;
fn mask(h: u32, shift: u32) -> u32 { (h >> shift) & 0x1f }
fn bitpos(h: u32, shift: u32) -> u32 { 1 << mask(h, shift) }
fn index_of(bm: u32, bit: u32) -> u32 { (bm & (bit - 1)).count_ones() }
struct Rt { h: Vec<u64>, kind: Vec<u8>, roots: Vec<Value>, eqs: u32, gas: u64, maxroots: usize }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize {
        self.roots.push(v);
        if self.roots.len() > self.maxroots { self.maxroots = self.roots.len(); }
        self.roots.len() - 1
    }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn is_bmnode(&self, n: Value) -> bool { self.kind[n.0 as usize] == 1 }
    fn bn_datamap(&self, n: Value) -> u32 { self.h[n.0 as usize] as u32 }
    fn bn_nodemap(&self, n: Value) -> u32 { self.h[n.0 as usize + 1] as u32 }
    fn bn_key(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 2 + 2 * at as usize]) }
    fn bn_val(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 3 + 2 * at as usize]) }
    fn bn_node(&self, n: Value, at: u32) -> Value { Value(self.h[n.0 as usize + 20 + at as usize]) }
    fn cn_hash(&self, n: Value) -> u32 { self.h[n.0 as usize] as u32 }
    fn cn_count(&self, n: Value) -> u32 { self.h[n.0 as usize + 1] as u32 }
    fn cn_key(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + 2 + 2 * i as usize]) }
    fn cn_val(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + 3 + 2 * i as usize]) }
    // Counted, so the driver can show that the two walks do the SAME
    // comparisons -- the fast path must be an optimisation, not a shortcut.
    fn val_eq(&mut self, a: Value, b: Value) -> bool { self.eqs += 1; a == b }
    // GAS, counted so the driver can show a collision scan is BILLED for what
    // it walks. `gas` tracking `eqs` on the collision arm is the whole point
    // of the charge; a probe that stubbed this to a no-op would pass while
    // the metering hole stayed open.
    fn charge_work(&mut self, n: u64) { self.gas += n; }
    // A key of 900 or more is "compound", so `node_find` takes the rooted walk.
    fn eq_may_alloc(&self, v: Value) -> bool { v.0 >= 900 }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 400], kind: vec![0; 400], roots: Vec::new(), eqs: 0, gas: 0, maxroots: 0 };
    // Root at 1: one entry (bit for mask(0x01,0)) and one sub-node.
    rt.kind[1] = 1; rt.h[1] = 2; rt.h[2] = 4;
    rt.h[3] = 100; rt.h[4] = 101;
    rt.h[21] = 40;
    // The sub-node at 40, reached at shift 5: one entry for mask(0x02,5)=0.
    rt.kind[40] = 1; rt.h[40] = 1; rt.h[41] = 0;
    rt.h[42] = 900; rt.h[43] = 901;
    // A collision node at 80, hash 0x77, two pairs.
    rt.kind[80] = 0; rt.h[80] = 0x77; rt.h[81] = 2;
    rt.h[82] = 200; rt.h[83] = 201; rt.h[84] = 300; rt.h[85] = 301;
    let mut o = String::new();
    // Scalar key, found in the datamap.
    o.push_str(&format!("{},", rt.node_find(Value(1), 0, 0x01, Value(100)).0));
    // Scalar key, the slot holds a different key.
    o.push_str(&format!("{},", rt.node_find(Value(1), 0, 0x01, Value(999)).0));
    // Scalar key, the bit is in neither map.
    o.push_str(&format!("{},", rt.node_find(Value(1), 0, 0x03, Value(100)).0));
    // COMPOUND key (>= 900), so the rooted walk, recursing into the sub-node.
    o.push_str(&format!("{},", rt.node_find(Value(1), 0, 0x02, Value(900)).0));
    // Collision node, key present and absent.
    o.push_str(&format!("{},", rt.node_find(Value(80), 0, 0x77, Value(300)).0));
    o.push_str(&format!("{},", rt.node_find(Value(80), 0, 0x77, Value(500)).0));
    // Collision node whose hash does not match at this depth.
    o.push_str(&format!("{},", rt.node_find(Value(80), 0, 0x11, Value(300)).0));
    // The SAME lookups through the scalar walk directly, which must agree.
    o.push_str(&format!("| {},", rt.node_find_scalar(Value(1), 0, 0x01, Value(100)).0));
    o.push_str(&format!("{},", rt.node_find_scalar(Value(1), 0, 0x02, Value(900)).0));
    o.push_str(&format!("{},", rt.node_find_scalar(Value(80), 0, 0x77, Value(300)).0));
    o.push_str(&format!(" eqs={} gas={} maxroots={} roots={}", rt.eqs, rt.gas, rt.maxroots, rt.roots.len()));
    println!("{}", o);
}
--java-head
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.eq` below stays for `hash-value`'s sake and this
    // forwards to it, which keeps whatever counting each probe does.
    static boolean valEq(Rt rt, long a, long b) { return com.flint.rt.Eq.eq(rt, a, b); }
    static final long NOT_FOUND = 0xFFFEL;
    static final int HASH_BITS = 5;
    static final class Val { static final long NOT_FOUND = 0xFFFEL; }
    static int mask(int h, int shift) { return (h >>> shift) & 0x1f; }
    static int bitpos(int h, int shift) { return 1 << mask(h, shift); }
    static int indexOf(int bm, int bit) { return Integer.bitCount(bm & (bit - 1)); }
    static final class Rt {
        long[] h = new long[400];
        int[] kind = new int[400];
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int eqs = 0, maxroots = 0;
        long gas = 0;
        // Counted, not stubbed to a no-op: a probe that ignored the charge
        // would pass while the metering hole stayed open.
        void chargeWork(long n) { gas += n; }
        int mark() { return roots.size(); }
        int push(long v) {
            roots.add(v);
            if (roots.size() > maxroots) maxroots = roots.size();
            return roots.size() - 1;
        }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
    }
    // Nested to reproduce the port's FULLY QUALIFIED `com.flint.rt.Eq`.
    // The vocabulary spells it in full because `eq.kin` generates a
    // class called `Eq` into package `flint.rt`, and inside a file of
    // that package a bare `Eq` is the generated one. The C# side below
    // nests `Flint.Rt.Eq` for its own version of the same shadowing.
    // `eqMayAlloc` is generated by `eqalloc.kin`, so it is called BARE and
    // mocked here rather than inside the `com.flint.rt.Eq` chain below.
    static boolean eqMayAlloc(Rt rt, long v) { return v >= 900; }
    static final class com { static final class flint { static final class rt {
        static final class Eq {
            static boolean eq(Rt rt, long a, long b) { rt.eqs++; return a == b; }
        }
    } } }
    static boolean isBmnode(Rt rt, long n) { return rt.kind[(int) n] == 1; }
    static int bnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int bnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long bnKey(Rt rt, long n, int at) { return rt.h[(int) n + 2 + 2 * at]; }
    static long bnVal(Rt rt, long n, int at) { return rt.h[(int) n + 3 + 2 * at]; }
    static long bnNode(Rt rt, long n, int at) { return rt.h[(int) n + 20 + at]; }
    static int cnHash(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int cnCount(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long cnKey(Rt rt, long n, int i) { return rt.h[(int) n + 2 + 2 * i]; }
    static long cnVal(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
