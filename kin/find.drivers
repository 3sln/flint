    public static void main(String[] args) {
        Rt rt = new Rt();
        rt.kind[1] = 1; rt.h[1] = 2; rt.h[2] = 4;
        rt.h[3] = 100; rt.h[4] = 101; rt.h[21] = 40;
        rt.kind[40] = 1; rt.h[40] = 1; rt.h[41] = 0;
        rt.h[42] = 900; rt.h[43] = 901;
        rt.kind[80] = 0; rt.h[80] = 0x77; rt.h[81] = 2;
        rt.h[82] = 200; rt.h[83] = 201; rt.h[84] = 300; rt.h[85] = 301;
        StringBuilder o = new StringBuilder();
        o.append(nodeFind(rt, 1, 0, 0x01, 100)).append(',');
        o.append(nodeFind(rt, 1, 0, 0x01, 999)).append(',');
        o.append(nodeFind(rt, 1, 0, 0x03, 100)).append(',');
        o.append(nodeFind(rt, 1, 0, 0x02, 900)).append(',');
        o.append(nodeFind(rt, 80, 0, 0x77, 300)).append(',');
        o.append(nodeFind(rt, 80, 0, 0x77, 500)).append(',');
        o.append(nodeFind(rt, 80, 0, 0x11, 300)).append(',');
        o.append("| ").append(nodeFindScalar(rt, 1, 0, 0x01, 100)).append(',');
        o.append(nodeFindScalar(rt, 1, 0, 0x02, 900)).append(',');
        o.append(nodeFindScalar(rt, 80, 0, 0x77, 300)).append(',');
        o.append(" eqs=").append(rt.eqs).append(" maxroots=").append(rt.maxroots)
         .append(" roots=").append(rt.roots.size());
        System.out.println(o);
    }
