    // `val-eq` IS `valeq`'s OWN now, so it is called BARE.
    internal static bool ValEq(Rt rt, long a, long b) { return global::Flint.Rt.Eq.Equal(rt, a, b); }
    const long NOT_FOUND = 0xFFFEL;
    const int HASH_BITS = 5;
    static class Val { internal const long NotFound = 0xFFFEL; }
    static int Mask(int h, int shift) { return (int)((uint) h >> shift) & 0x1f; }
    static int Bitpos(int h, int shift) { return 1 << Mask(h, shift); }
    static int IndexOf(int bm, int bit) { return BitOperations.PopCount((uint)(bm & (bit - 1))); }
    internal sealed class Rt {
        internal long[] h = new long[400];
        internal int[] kind = new int[400];
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int eqs = 0, maxroots = 0;
        internal long gas = 0;
        internal void ChargeWork(long n) { gas += n; }
        internal int Mark() { return roots.Count; }
        internal int Push(long v) {
            roots.Add(v);
            if (roots.Count > maxroots) maxroots = roots.Count;
            return roots.Count - 1;
        }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
    }
    static bool EqMayAlloc(Rt rt, long v) { return v >= 900; }
    static bool IsBmnode(Rt rt, long n) { return rt.kind[(int) n] == 1; }
    static int BnDatamap(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int BnNodemap(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long BnKey(Rt rt, long n, int at) { return rt.h[(int) n + 2 + 2 * at]; }
    static long BnVal(Rt rt, long n, int at) { return rt.h[(int) n + 3 + 2 * at]; }
