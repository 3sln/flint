namespace Flint.Rt {
    internal static class Sets {
        internal const int S_MAP = 0, S_META = 1, S_HASH = 2;
    }
}
--csharp-head
    internal const long NIL = 0xFFFFL;
    internal static class Obj {
        internal const int TySet = 18, TyMap = 14;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil; }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
    }
    internal sealed class Space { internal byte[] m = new byte[9000]; }
    internal sealed class Rt {
        internal long[] h = new long[9000];
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal int[] lens = new int[9000];
        internal long bump = 100;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Alloc(int t, int n) {
            long a = bump; bump += n + 8;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long v, int i) { return h[(int) v + i]; }
    }
    internal static long NewMap(Rt rt, long[] pairs) {
        long a = rt.Alloc(Obj.TyMap, System.Math.Max(1, pairs.Length));
        rt.lens[(int) a] = pairs.Length;
        for (int i = 0; i < pairs.Length; i++) rt.h[(int) a + i] = pairs[i];
        return Val.Heap(a);
    }
    internal static int MapFind(Rt rt, long m, long k) {
        int n = rt.lens[(int) m];
        for (int i = 0; i < n; i += 2) if (rt.Slot(m, i) == k) return i;
        return -1;
    }
        internal static int MapCount(Rt rt, long m) { return rt.lens[(int) m] / 2; }
        internal static bool MapEq(Rt rt, long a, long b) { return a == b; }
        internal static bool MapContains(Rt rt, long m, long k) { return MapFind(rt, m, k) >= 0; }
        internal static long MapGet(Rt rt, long m, long k, long dflt) {
            int at = MapFind(rt, m, k);
            return at < 0 ? dflt : rt.Slot(m, at + 1);
        }
        internal static long MapAssoc(Rt rt, long m, long k, long v) {
            if (MapFind(rt, m, k) >= 0) return m;
            int n = rt.lens[(int) m];
            long[] pairs = new long[n + 2];
            for (int i = 0; i < n; i++) pairs[i] = rt.Slot(m, i);
            pairs[n] = k; pairs[n + 1] = v;
            return NewMap(rt, pairs);
        }
        internal static long MapDissoc(Rt rt, long m, long k) {
            int at = MapFind(rt, m, k);
            if (at < 0) return m;
            int n = rt.lens[(int) m];
            long[] pairs = new long[n - 2];
            int j = 0;
            for (int i = 0; i < n; i++) if (i != at && i != at + 1) pairs[j++] = rt.Slot(m, i);
            return NewMap(rt, pairs);
        }
