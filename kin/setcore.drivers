--rust
}
extern crate alloc;
fn main() {
    let mut rt = Rt { h: vec![0; 9000], gc: Gc { sp: Space { m: vec![0u8; 9000] } },
                      lens: vec![0; 9000], bump: 100, roots: Vec::new() };
    let mut o = String::new();
    let empty = rt.new_map(&[]);
    let meta = Value(0x77);
    let s0 = rt.new_set(empty, meta);
    o.push_str(&format!("set?={}{} count0={} ", rt.is_set(s0) as u32,
                        rt.is_set(empty) as u32, rt.set_count(s0)));
    // CONJ, and the ELEMENT IS ITS OWN VALUE -- which is what makes `get`
    // answer the stored one.
    let a = Value(0xA1); let b = Value(0xB2); let c = Value(0xC3);
    let s1 = rt.set_conj(s0, a);
    let s2 = rt.set_conj(s1, b);
    o.push_str(&format!("count2={} has={}{}{} ", rt.set_count(s2),
                        rt.set_contains(s2, a) as u32, rt.set_contains(s2, b) as u32,
                        rt.set_contains(s2, c) as u32));
    o.push_str(&format!("get={}/{} ", rt.set_get(s2, a, NIL).0,
                        rt.set_get(s2, c, Value(0xDD)).0));
    // CONJ OF SOMETHING ALREADY THERE IS THE SET ITSELF, not a copy. The map
    // answers the same map, and the identity test saves the allocation.
    let again = rt.set_conj(s2, a);
    o.push_str(&format!("same={} ", (again.0 == s2.0) as u32));
    // DISJ, and DISJ OF SOMETHING ABSENT is likewise the set itself.
    let s3 = rt.set_disj(s2, a);
    let nodisj = rt.set_disj(s2, c);
    o.push_str(&format!("disj={}/{} disjsame={} ", rt.set_count(s3),
                        rt.set_contains(s3, a) as u32, (nodisj.0 == s2.0) as u32));
    // THE METADATA RIDES ALONG, and the hash slot starts empty on every new
    // set -- a set that inherited a stale hash would answer the old one.
    // SET-EQ, both arms. Unequal COUNTS must be refused without consulting the
    // maps at all -- that is the cheap half and the one a delegation could
    // skip by accident -- and equal counts must reach `map-eq`, which the stub
    // answers by identity.
    o.push_str(&format!("eq={}{} ", rt.set_eq(s2, s2) as u32,
                        rt.set_eq(s2, s3) as u32));
    o.push_str(&format!("meta={} hash={}",
                        (rt.slot(s3, set::S_META).0 == meta.0) as u32,
                        rt.slot(s3, set::S_HASH).is_nil() as u32));
    println!("{}", o);
}
