--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_SET: u8 = 18; const TY_MAP: u8 = 14;
pub mod set { pub const S_MAP: u32 = 0; pub const S_META: u32 = 1; pub const S_HASH: u32 = 2; }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value> }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 8;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.h[v.0 as usize + i as usize]) }
    // A MAP AS A SORTED RUN OF KEY/VALUE PAIRS, and the one property the set
    // relies on: `assoc` of a key already present answers THE SAME MAP, and
    // `dissoc` of one absent does too. Without that the identity tests below
    // would be testing nothing.
    fn new_map(&mut self, pairs: &[Value]) -> Value {
        let a = self.alloc(TY_MAP, pairs.len().max(1) as u32);
        self.lens[a as usize] = pairs.len() as u32;
        for (i, p) in pairs.iter().enumerate() { self.h[a as usize + i] = p.0; }
        Value::heap(a)
    }
    fn map_count(&mut self, m: Value) -> u32 { self.lens[m.0 as usize] / 2 }
    // `set-eq` delegates to it; the stub compares the toy maps by identity,
    // which is enough to tell the delegation happened and reached the right
    // slot. Whether `map-eq` itself is right is `mapeq.kin`'s probe to answer.
    fn map_eq(&mut self, a: Value, b: Value) -> bool { a.0 == b.0 }
    fn map_find(&mut self, m: Value, k: Value) -> i32 {
        let n = self.lens[m.0 as usize];
        let mut i = 0;
        while i < n {
            if self.slot(m, i).0 == k.0 { return i as i32; }
            i += 2;
        }
        -1
    }
    fn map_contains(&mut self, m: Value, k: Value) -> bool { self.map_find(m, k) >= 0 }
    fn map_get(&mut self, m: Value, k: Value, dflt: Value) -> Value {
        let at = self.map_find(m, k);
        if at < 0 { dflt } else { self.slot(m, at as u32 + 1) }
    }
    fn map_assoc(&mut self, m: Value, k: Value, v: Value) -> Value {
        if self.map_find(m, k) >= 0 { return m; }
        let n = self.lens[m.0 as usize];
        let mut pairs: alloc::vec::Vec<Value> = (0..n).map(|i| self.slot(m, i)).collect();
        pairs.push(k); pairs.push(v);
        self.new_map(&pairs)
    }
    fn map_dissoc(&mut self, m: Value, k: Value) -> Value {
        let at = self.map_find(m, k);
        if at < 0 { return m; }
        let n = self.lens[m.0 as usize];
        let mut pairs = alloc::vec::Vec::new();
        for i in 0..n {
            if i != at as u32 && i != at as u32 + 1 { pairs.push(self.slot(m, i)); }
        }
        self.new_map(&pairs)
    }
}
