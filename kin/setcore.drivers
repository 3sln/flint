    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long empty = newMap(rt, new long[]{});
        long meta = 0x77;
        long s0 = newSet(rt, empty, meta);
        o.append("set?=").append(isSet(rt, s0) ? 1 : 0).append(isSet(rt, empty) ? 1 : 0)
         .append(" count0=").append(setCount(rt, s0)).append(' ');
        long a = 0xA1, b = 0xB2, c = 0xC3;
        long s2 = setConj(rt, setConj(rt, s0, a), b);
        o.append("count2=").append(setCount(rt, s2))
         .append(" has=").append(setContains(rt, s2, a) ? 1 : 0)
         .append(setContains(rt, s2, b) ? 1 : 0).append(setContains(rt, s2, c) ? 1 : 0)
         .append(' ');
        o.append("get=").append(setGet(rt, s2, a, NIL)).append('/')
         .append(setGet(rt, s2, c, 0xDD)).append(' ');
        o.append("same=").append(setConj(rt, s2, a) == s2 ? 1 : 0).append(' ');
        long s3 = setDisj(rt, s2, a);
        o.append("disj=").append(setCount(rt, s3)).append('/')
         .append(setContains(rt, s3, a) ? 1 : 0)
         .append(" disjsame=").append(setDisj(rt, s2, c) == s2 ? 1 : 0).append(' ');
        o.append("eq=").append(setEq(rt, s2, s2) ? 1 : 0)
         .append(setEq(rt, s2, s3) ? 1 : 0).append(' ');
        o.append("meta=").append(rt.slot(s3, Sets.S_META) == meta ? 1 : 0)
         .append(" hash=").append(Val.isNil(rt.slot(s3, Sets.S_HASH)) ? 1 : 0);
        System.out.println(o.toString());
    }
