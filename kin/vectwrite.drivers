}
fn main() {
    let mut rt = Rt { h: vec![0; 900000], gc: Gc { sp: vec![0u8; 900000] }, lens: vec![0; 900000],
                      bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    let tget = |rt: &Rt, t: Value, i: u32| -> u64 {
        let leaf = rt.t_array_for(t, i); rt.node_get(leaf, i & MASK).0
    };

    // conj! from empty, past every boundary the trie turns on.
    let v0 = rt.build(0, BITS);
    let t = rt.transient(v0);
    let ti = rt.push(t);
    for i in 0..2100u32 {
        let nt = rt.tvec_conj(rt.r(ti), Value(0x1000 + i as u64));
        rt.set_r(ti, nt);
    }
    let t = rt.r(ti);
    o.push_str(&format!("cnt={} sh={} ", rt.tvec_count(t), rt.tvec_shift(t)));
    let mut bad = 0u32;
    for i in 0..2100u32 { if tget(&rt, t, i) != 0x1000 + i as u64 { bad += 1; } }
    o.push_str(&format!("wrong={} ", bad));

    // conj! REUSES the handle rather than answering a new one, which is what
    // makes it cheap: on the common path it allocates nothing at all.
    let before = rt.r(ti);
    let after = rt.tvec_conj(before, Value(0xDDD));
    o.push_str(&format!("inplace={} ", (before == after) as u32));

    // assoc! in the tail and in the trie, and at the count (which appends).
    let a1 = rt.tvec_assoc(rt.r(ti), 5, Value(0xAAA));
    o.push_str(&format!("as5={} keep6={} ", tget(&rt, a1, 5), tget(&rt, a1, 6)));
    let n = rt.tvec_count(rt.r(ti));
    let a2 = rt.tvec_assoc(rt.r(ti), n - 1, Value(0xBBB));
    o.push_str(&format!("astail={} ", tget(&rt, a2, n - 1)));
    let a3 = rt.tvec_assoc(rt.r(ti), rt.tvec_count(rt.r(ti)), Value(0xCCC));
    o.push_str(&format!("append={} ", rt.tvec_count(a3)));

    // pop! down across the leaf boundary and the level boundary.
    let mut counts = String::new();
    while rt.tvec_count(rt.r(ti)) > 1020 {
        let np = rt.tvec_pop(rt.r(ti));
        rt.set_r(ti, np);
    }
    counts.push_str(&format!("{}:{} ", rt.tvec_count(rt.r(ti)), rt.tvec_shift(rt.r(ti))));
    while rt.tvec_count(rt.r(ti)) > 30 {
        let np = rt.tvec_pop(rt.r(ti));
        rt.set_r(ti, np);
    }
    counts.push_str(&format!("{}:{} ", rt.tvec_count(rt.r(ti)), rt.tvec_shift(rt.r(ti))));
    o.push_str(&format!("pops={}", counts));
    // From 6, because index 5 was deliberately overwritten by `assoc!` above.
    let mut bad2 = 0u32;
    for i in 6..30u32 { if tget(&rt, rt.r(ti), i) != 0x1000 + i as u64 { bad2 += 1; } }
    o.push_str(&format!("popwrong={} ", bad2));

    // persistent!: the tail is TRIMMED and the handle is invalidated.
    let p = rt.tvec_persistent(rt.r(ti));
    o.push_str(&format!("pcnt={} ptail={} dead={} ",
        rt.vec_count(p), rt.node_len(rt.slot(p, V_TAIL)),
        rt.slot(rt.r(ti), T_EDIT).is_nil() as u32));

    // The empty edges.
    let e0 = rt.build(0, BITS);
    let te = rt.transient(e0);
    o.push_str(&format!("pop0nil={} ", rt.tvec_pop(te).is_nil() as u32));
    let e1v = rt.build(1, BITS);
    let t1 = rt.transient(e1v);
    let p1 = rt.tvec_pop(t1);
    o.push_str(&format!("pop1={} ", rt.tvec_count(p1)));
    println!("{}", o);
}
