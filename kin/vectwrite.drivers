--csharp-head
    const long NIL = 0xFFFFL;
    const int BITS = 5, WIDTH = 32, MASK = 31;
    const int V_CNT = 0, V_SHIFT = 1, V_ROOT = 2, V_TAIL = 3, V_META = 4, V_HASH = 5;
    const int T_CNT = 0, T_SHIFT = 1, T_ROOT = 2, T_TAIL = 3, T_EDIT = 4;
    const int TY_TVEC = 25, TY_VOLATILE = 34;
    const int TY_VEC = 6;
    static class Obj {
        internal const int TyNode = 10; internal const int TyVec = 6;
        internal const int TyTvec = 25; internal const int TyVolatile = 34;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100; }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static long Fixnum(long n) { return n; }
        internal static long AsFixnum(long v) { return v; }
    }
    internal sealed class Rt {
        internal long[] h = new long[200000];
        internal sealed class GcT { internal int[] sp = new int[200000]; }
        internal GcT gc = new GcT();
        internal int[] lens = new int[200000];
        internal long bump = 100;
        internal bool starve = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            // NIL-filled, as the real allocator does -- see the Rust head.
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    static int Olen(Rt rt, long n) { return rt.lens[(int) n]; }
    internal static int VecCount(Rt rt, long v) { return (int) Val.AsFixnum(rt.Slot(v, V_CNT)); }
    internal static class Vec {
        internal static long Empty(Rt rt) { return EmptyVec(rt); }
    }
    // `flint.rt.vecnode`, STUBBED -- see the note in the Rust head.
    static long NewNode(Rt rt, int n, long edit) {
        long a = rt.Alloc(Obj.TyNode, n + 1);
        if (a == 0) return NIL;
        rt.SetSlot(a, 0, edit);
        return Val.Heap(a);
    }
    static int NodeLen(Rt rt, long n) { return Olen(rt, n) - 1; }
    static long NodeGet(Rt rt, long n, int i) { return rt.Slot(n, i + 1); }
    static void NodeSet(Rt rt, long n, int i, long v) { rt.SetSlot(Val.AsHeap(n), i + 1, v); }
    static long NodeEdit(Rt rt, long n) { return rt.Slot(n, 0); }
    // `flint.rt.vecread`, STUBBED -- `vecread.drivers` verifies the real ones.
    static long NodeClone(Rt rt, long n, int newlen, long edit) {
        long fresh = NewNode(rt, newlen, edit);
        if (Val.IsNil(fresh)) return NIL;
        int have = NodeLen(rt, n);
        int copy = System.Math.Min(newlen, have);
        for (int i = 0; i < copy; i++) NodeSet(rt, fresh, i, NodeGet(rt, n, i));
        return fresh;
    }
    static int VecShift(Rt rt, long v) { return (int) Val.AsFixnum(rt.Slot(v, V_SHIFT)); }
    static int TailOff(Rt rt, long v) {
        int c = VecCount(rt, v);
        return c < WIDTH ? 0 : ((int)((uint)(c - 1) >> BITS)) << BITS;
    }
    // `flint.rt.vecwrite`, STUBBED -- see the Rust head.
    static long NewVec(Rt rt, int cnt, int shift, long root, long tail, long meta) {
        long a = rt.Alloc(TY_VEC, 6);
        if (a == 0) return NIL;
        rt.SetSlot(a, V_CNT, cnt); rt.SetSlot(a, V_SHIFT, shift);
        rt.SetSlot(a, V_ROOT, root); rt.SetSlot(a, V_TAIL, tail);
        rt.SetSlot(a, V_META, meta); rt.SetSlot(a, V_HASH, NIL);
        return Val.Heap(a);
    }
    static long EmptyVec(Rt rt) {
        return NewVec(rt, 0, BITS, NewNode(rt, WIDTH, NIL), NewNode(rt, 0, NIL), NIL);
    }
    // `VecConj` is STUBBED as a MARKER, not reimplemented -- see the Rust head.
    static long VecConj(Rt rt, long v, long x) { return 0xC0FFEE; }
    static long Build(Rt rt, int n, int shift) {
        int toff = n < WIDTH ? 0 : ((int)((uint)(n - 1) >> BITS)) << BITS;
        long root = NewNode(rt, WIDTH, NIL);
        int ri = rt.Push(root);
        for (int i = 0; i < toff; i += WIDTH) {
            long leaf = NewNode(rt, WIDTH, NIL);
            int li = rt.Push(leaf);
            for (int k = 0; k < WIDTH; k++) NodeSet(rt, rt.R(li), k, 0x1000 + i + k);
            if (shift == BITS) {
                NodeSet(rt, rt.R(ri), (int)((uint) i >> BITS), rt.R(li));
            } else {
                int outer = ((int)((uint) i >> 10)) & MASK;
                long mid = NodeGet(rt, rt.R(ri), outer);
                if (Val.IsNil(mid)) { mid = NewNode(rt, WIDTH, NIL); NodeSet(rt, rt.R(ri), outer, mid); }
                NodeSet(rt, mid, ((int)((uint) i >> BITS)) & MASK, rt.R(li));
            }
            rt.PopTo(li);
        }
        int tailn = n - toff;
        long tail = NewNode(rt, tailn, NIL);
        int ti = rt.Push(tail);
        for (int k = 0; k < tailn; k++) NodeSet(rt, rt.R(ti), k, 0x1000 + toff + k);
        long outv = NewVec(rt, n, shift, rt.R(ri), rt.R(ti), NIL);
        rt.PopTo(ri);
        return outv;
    }
    static long Get(Rt rt, long v, int i) { return NodeGet(rt, ArrayFor(rt, v, i), i & MASK); }
    // STUBBED -- see the Rust head.
    static int TvecCount(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, T_CNT)); }
    static int TvecShift(Rt rt, long t) { return (int) Val.AsFixnum(rt.Slot(t, T_SHIFT)); }
    static int TvecTailOff(Rt rt, long t) {
        int c = TvecCount(rt, t);
        return c < WIDTH ? 0 : ((c - 1) >> BITS) << BITS;
    }
    static long EnsureEditable(Rt rt, long node, long edit) {
        return NodeEdit(rt, node) == edit ? node : NodeClone(rt, node, WIDTH, edit);
    }
    static long TArrayFor(Rt rt, long t, int i) {
        if (i >= TvecTailOff(rt, t)) return rt.Slot(t, T_TAIL);
        long node = rt.Slot(t, T_ROOT);
        int level = TvecShift(rt, t);
        while (level > 0) { node = NodeGet(rt, node, (i >> level) & MASK); level -= BITS; }
        return node;
    }
    static long NewPath(Rt rt, int level, long node, long edit) {
        if (level == 0) return node;
        long child = NewPath(rt, level - BITS, node, edit);
        long parent = NewNode(rt, WIDTH, edit);
        if (Val.IsNil(parent)) return NIL;
        NodeSet(rt, parent, 0, child);
        return parent;
    }
    static long PopTail(Rt rt, int level, long node, int cnt) {
        int subidx = ((cnt - 2) >> level) & MASK;
        if (level > BITS) {
            long child = NodeGet(rt, node, subidx);
            long newchild = PopTail(rt, level - BITS, child, cnt);
            if (Val.IsNil(newchild) && subidx == 0) return NIL;
            // `deep` and `flat`, not `ret` twice: C# refuses a local whose name
            // is reused in an enclosing scope (CS0136).
            long deep = NodeClone(rt, node, WIDTH, NIL);
            NodeSet(rt, deep, subidx, newchild);
            return deep;
        }
        if (subidx == 0) return NIL;
        long flat = NodeClone(rt, node, WIDTH, NIL);
        NodeSet(rt, flat, subidx, NIL);
        return flat;
    }
    static long NewEditToken(Rt rt) { return Val.Heap(rt.Alloc(TY_VOLATILE, 1)); }
    static long Transient_(Rt rt, long v) {
        long edit = NewEditToken(rt);
        long tail = NodeClone(rt, rt.Slot(v, V_TAIL), WIDTH, edit);
        long root = rt.Slot(v, V_ROOT);
        long a = rt.Alloc(TY_TVEC, 5);
        rt.SetSlot(a, T_CNT, VecCount(rt, v)); rt.SetSlot(a, T_SHIFT, VecShift(rt, v));
        rt.SetSlot(a, T_ROOT, root); rt.SetSlot(a, T_TAIL, tail); rt.SetSlot(a, T_EDIT, edit);
        return Val.Heap(a);
    }
    static long TGet(Rt rt, long t, int i) { return NodeGet(rt, TArrayFor(rt, t, i), i & MASK); }
    static long ArrayFor(Rt rt, long v, int i) {
        if (i >= TailOff(rt, v)) return rt.Slot(v, V_TAIL);
        long node = rt.Slot(v, V_ROOT);
        int level = VecShift(rt, v);
        while (level > 0) { node = NodeGet(rt, node, ((int)((uint) i >> level)) & MASK); level -= BITS; }
        return node;
    }
    static long MkVec(Rt rt, int cnt, int shift, long root, long tail) {
        long a = rt.Alloc(6, 6);
        rt.SetSlot(a, V_CNT, cnt);
        rt.SetSlot(a, V_SHIFT, shift);
        rt.SetSlot(a, V_ROOT, root);
        rt.SetSlot(a, V_TAIL, tail);
        return Val.Heap(a);
    }
