        long a3 = TvecAssoc(rt, rt.R(ti), TvecCount(rt, rt.R(ti)), 0xCCC);
        o.Append("append=").Append(TvecCount(rt, a3)).Append(' ');
        var counts = new System.Text.StringBuilder();
        while (TvecCount(rt, rt.R(ti)) > 1020) rt.SetR(ti, TvecPop(rt, rt.R(ti)));
        counts.Append(TvecCount(rt, rt.R(ti))).Append(':').Append(TvecShift(rt, rt.R(ti))).Append(' ');
        while (TvecCount(rt, rt.R(ti)) > 30) rt.SetR(ti, TvecPop(rt, rt.R(ti)));
        counts.Append(TvecCount(rt, rt.R(ti))).Append(':').Append(TvecShift(rt, rt.R(ti))).Append(' ');
        o.Append("pops=").Append(counts);
