        return node(rt, kids);
    }
    static int bAtProbe(Rt rt, long v, int i) {
        if (ty(rt.gc.sp, v) == TY_BYTES) return rt.gc.sp.readU8(v + Obj.HDR + i);
        int kids = olen(rt, v) - Bytes.BB_KIDS;
        int idx = i;
        for (int k = 0; k < kids; k++) {
            long kid = rt.slot(v, Bytes.BB_KIDS + k);
            int w = bCount(rt, kid);
            if (idx < w) return bAtProbe(rt, kid, idx);
            idx -= w;
        }
        return 0;
    }
    static boolean isBrope(Rt rt, long v) {
        return Val.isHeap(v) && ty(rt.gc.sp, v) == TY_BROPE;
    }
    static long node(Rt rt, long[] kids) {
        int total = 0;
        for (long k : kids) total += bCount(rt, k);
        long a = rt.alloc(TY_BROPE, Bytes.BB_KIDS + kids.length);
        rt.setSlot(a, Bytes.BB_BYTES, total);
        rt.setSlot(a, Bytes.BB_FLAT, NIL);
        rt.setSlot(a, Bytes.BB_HASH, NIL);
        rt.setSlot(a, Bytes.BB_DEPTH, 1);
