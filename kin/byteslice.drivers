--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long a = Leaf(rt, new int[]{0,1,2,3,4});
        long b = Leaf(rt, new int[]{10,11,12,13,14});
        long c = Leaf(rt, new int[]{20,21,22,23,24});
        long d = Leaf(rt, new int[]{30,31,32,33,34});
        long tree = Node(rt, new long[]{a, b, c, d});
        o.Append("whole=").Append(BSlice(rt, tree, 0, 20) == tree ? 1 : 0).Append(' ');
        o.Append("clamp=").Append(BytesOf(rt, BSlice(rt, tree, 15, 99)))
         .Append(" empty=").Append(BCount(rt, BSlice(rt, tree, 3, 3))).Append(' ');
        long small = BSlice(rt, tree, 5, 8);
        o.Append("small=").Append(BytesOf(rt, small)).Append(',')
         .Append(small == b ? 1 : 0).Append(' ');
        long mid = BSlice(rt, tree, 5, 15);
        o.Append("mid=").Append(BytesOf(rt, mid)).Append(" shares=")
         .Append(rt.Slot(mid, global::Flint.Rt.Bytes.BB_KIDS) == b ? 1 : 0)
         .Append(rt.Slot(mid, global::Flint.Rt.Bytes.BB_KIDS + 1) == c ? 1 : 0).Append(' ');
        long rag = BSlice(rt, tree, 3, 17);
        o.Append("rag=").Append(BytesOf(rt, rag)).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
    internal static string BytesOf(Rt rt, long v) {
        var s = new System.Text.StringBuilder();
        for (int i = 0; i < BCount(rt, v); i++) {
            if (i > 0) s.Append('.');
            s.Append(BAtProbe(rt, v, i));
        }
        return s.ToString();
    }
