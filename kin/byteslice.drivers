--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_BYTES: u8 = 44; const TY_BROPE: u8 = 45; const TY_VEC: u8 = 9;
pub mod obj { pub const HDR: u64 = 8; }
pub mod rope { pub const SLICE_MIN: u32 = 4; }
pub mod bytes {
    pub const BB_BYTES: u32 = 0; pub const BB_FLAT: u32 = 1;
    pub const BB_DEPTH: u32 = 2; pub const BB_HASH: u32 = 3; pub const BB_KIDS: u32 = 4;
}
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
// A BYTE-ADDRESSABLE space, which the earlier byte fixtures did not need: they
// modelled a leaf by its LENGTH alone. `b-at` reads the bytes themselves, so
// this one stores them -- at `addr + HDR`, where the runtime puts them.
struct Space { m: Vec<u8> }
impl Space {
    fn read_u8(&self, a: Addr) -> u8 { self.m[a as usize] }
}
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value> }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    // SPACED so a leaf's bytes cannot land on the next object's type tag:
    // objects are `n + 16` apart and the bytes occupy `HDR .. HDR + n`.
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn leaf(&mut self, bs: &[u8]) -> Value {
        let a = self.alloc(TY_BYTES, bs.len() as u32);
        for (i, b) in bs.iter().enumerate() { self.gc.sp.m[(a + obj::HDR) as usize + i] = *b; }
        Value::heap(a)
    }
    fn b_count(&self, v: Value) -> u32 {
        if !v.is_heap() { return 0; }
        match ty(&self.gc.sp, v.as_heap()) {
            TY_BYTES => self.olen(v),
            TY_BROPE => self.slot(v, bytes::BB_BYTES).as_fixnum() as u32,
            _ => 0,
        }
    }
    // `bytefold`'s and the hand-written sink half's, reproduced faithfully.
    fn b_from_roots(&mut self, base: usize, n: u32) -> Value {
        if n == 0 { return self.leaf(&[]); }
        if n == 1 { return self.r(base); }
        let kids: Vec<Value> = (0..n).map(|i| self.r(base + i as usize)).collect();
        self.node(&kids)
    }
    fn b_copy_range(&mut self, v: Value, from: u32, to: u32) -> Value {
        let mut out: Vec<u8> = Vec::new();
        for i in from..to {
            let x = self.b_at_probe(v, i);
            out.push(x);
        }
        self.leaf(&out)
    }
    fn b_at_probe(&self, v: Value, i: u32) -> u8 {
        match ty(&self.gc.sp, v.as_heap()) {
            TY_BYTES => self.gc.sp.read_u8(v.as_heap() + obj::HDR + i as u64),
            _ => {
                let kids = self.olen(v) - bytes::BB_KIDS;
                let mut idx = i;
                for k in 0..kids {
                    let kid = self.slot(v, bytes::BB_KIDS + k);
                    let w = self.b_count(kid);
                    if idx < w { return self.b_at_probe(kid, idx); }
                    idx -= w;
                }
                0
            }
        }
    }
    fn is_brope(&self, v: Value) -> bool {
        v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_BROPE
    }
    fn node(&mut self, kids: &[Value]) -> Value {
        let mut total = 0u32;
        for k in kids { total += self.b_count(*k); }
        let a = self.alloc(TY_BROPE, bytes::BB_KIDS + kids.len() as u32);
        self.set_slot(a, bytes::BB_BYTES, Value::fixnum(total as i64));
        self.set_slot(a, bytes::BB_FLAT, NIL);
        self.set_slot(a, bytes::BB_HASH, NIL);
        self.set_slot(a, bytes::BB_DEPTH, Value::fixnum(1));
        for (i, k) in kids.iter().enumerate() { self.set_slot(a, bytes::BB_KIDS + i as u32, *k); }
        Value::heap(a)
    }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new() };
    let mut o = String::new();
    // Four leaves of five bytes: 0..4, 10..14, 20..24, 30..34.
    let mk = |rt: &mut Rt, base: u8| rt.leaf(&[base, base+1, base+2, base+3, base+4]);
    let a = mk(&mut rt, 0); let b = mk(&mut rt, 10);
    let c = mk(&mut rt, 20); let d = mk(&mut rt, 30);
    let tree = rt.node(&[a, b, c, d]);
    fn bytes_of(rt: &Rt, v: Value) -> String {
        (0..rt.b_count(v)).map(|i| rt.b_at_probe(v, i).to_string())
                          .collect::<Vec<_>>().join(".")
    }
    // EVERY SLICE HOISTED: `b_slice` takes `&mut self` and printing borrows
    // `&self`, so nesting them is two borrows at once -- the same rule the
    // generated sources hit, showing up in the probe that drives them.
    let whole = rt.b_slice(tree, 0, 20);
    o.push_str(&format!("whole={} ", (whole.0 == tree.0) as u32));
    let clamped = rt.b_slice(tree, 15, 99);
    let cl = bytes_of(&rt, clamped);
    let emptied = rt.b_slice(tree, 3, 3);
    o.push_str(&format!("clamp={} empty={} ", cl, rt.b_count(emptied)));
    // BELOW SLICE_MIN (4 here): copied, so NOT the child even when aligned.
    let small = rt.b_slice(tree, 5, 8);
    let sm = bytes_of(&rt, small);
    o.push_str(&format!("small={},{} ", sm, (small.0 == b.0) as u32));
    // AT OR ABOVE SLICE_MIN and covering a whole child: that child is SHARED.
    let mid = rt.b_slice(tree, 5, 15);
    let md = bytes_of(&rt, mid);
    o.push_str(&format!("mid={} shares={}{} ", md,
        (rt.slot(mid, bytes::BB_KIDS).0 == b.0) as u32,
        (rt.slot(mid, bytes::BB_KIDS + 1).0 == c.0) as u32));
    // A RAGGED range: the end children are cut, the middle one is shared.
    let rag = rt.b_slice(tree, 3, 17);
    let rg = bytes_of(&rt, rag);
    o.push_str(&format!("rag={} ", rg));
    println!("{}", o);
}
