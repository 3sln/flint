    internal static int BAtProbe(Rt rt, long v, int i) {
        if (Obj.Ty(rt.gc.sp, v) == Obj.TyBytes) return rt.gc.sp.ReadU8(v + Obj.Hdr + i);
        int kids = Olen(rt, v) - global::Flint.Rt.Bytes.BB_KIDS;
        int idx = i;
        for (int k = 0; k < kids; k++) {
            long kid = rt.Slot(v, global::Flint.Rt.Bytes.BB_KIDS + k);
            int w = BCount(rt, kid);
            if (idx < w) return BAtProbe(rt, kid, idx);
            idx -= w;
        }
        return 0;
    }
    internal static bool IsBrope(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyBrope;
    }
    internal static long Node(Rt rt, long[] kids) {
        int total = 0;
        foreach (long k in kids) total += BCount(rt, k);
        long a = rt.Alloc(Obj.TyBrope, global::Flint.Rt.Bytes.BB_KIDS + kids.Length);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_BYTES, total);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_FLAT, Val.Nil);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_HASH, Val.Nil);
        rt.SetSlot(a, global::Flint.Rt.Bytes.BB_DEPTH, 1);
        for (int i = 0; i < kids.Length; i++) rt.SetSlot(a, global::Flint.Rt.Bytes.BB_KIDS + i, kids[i]);
        return Val.Heap(a);
    }
