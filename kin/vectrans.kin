;; The TRANSIENT vector's plumbing: what one is, how one is made, and how a
;; node becomes owned.
;;
;; A transient is the same trie with an OWNERSHIP TOKEN. Every node carries the
;; token of the transient that owns it in slot 0, and a node whose token
;; matches is written in place rather than copied. That is the whole of what a
;; transient buys: the persistent path copies a 32-slot node per `conj`, which
;; is 32 copies to fill one leaf.
;;
;;     TY_TVEC  [cnt, shift, root, tail, edit]
;;
;; `transient` itself is O(1) -- nothing is copied until the first write that
;; reaches a node this transient does not already own. The one exception is the
;; TAIL, which is widened to a full 32 up front precisely so that `conj!` can
;; write into it without copying it one longer every time.
;;
;; `tvec-nth` is here, and takes a `dflt` for the same reason `vec-nth` does:
;; Rust answered `Option<Value>` and the ports a fixed sentinel, and the count
;; of what the call sites actually wanted settled it. One decision covered
;; both, which is why they landed together.
(ns flint.rt.vectrans
  (:require [flint.impl.rt :refer [defn return if let local set do comment doc
                                   not == != < > >= - + bit-and shl ushr while
                                   mark push r pop-to alloc set-at slot heap
                                   fixnum nil? as-fixnum to-i32 is-heap
                                   as-heap ty Rt Value Addr RootIx I32 Bool
                                   NIL BITS WIDTH MASK TY_TVEC TY_VOLATILE
                                   V_ROOT V_TAIL T_CNT T_SHIFT T_ROOT T_TAIL
                                   T_EDIT]]
            [flint.rt.vector :refer [vec-count]]
            [flint.rt.vecnode :refer [node-get node-edit node-len]]
            [flint.rt.vecread :refer [node-clone vec-shift tail-off
                                      array-for vec-nth]]))

(doc "A fresh ownership token: an object whose IDENTITY is the whole of it."
     ""
     "`TY_VOLATILE` with one slot, and the slot is never read. What matters is"
     "that no two transients can be handed the same address, which is what"
     "makes `node-edit node == edit` a safe test for `this is mine`.")
(defn ^:pub ^:method ^Value new-edit-token [^:mut ^Rt rt]
  (let [^Addr a (alloc rt TY_VOLATILE 1)]
    (if (== a 0)
      (return NIL))
    (return (heap a))))

(defn ^:pub ^:method ^Bool is-transient-vector [^Rt rt ^Value v]
  (if (not (is-heap v))
    (return false))
  (return (== (ty rt (as-heap v)) TY_TVEC)))

(doc "THE FOUR READERS BELOW ARE THE VECTOR'S, AND THAT IS DELIBERATE."
     ""
     "A TRANSIENT'S HEADER IS A VECTOR'S HEADER, PREFIX-WISE:"
     ""
     "    TY_VEC   [cnt, shift, root, tail, meta, hash]"
     "    TY_TVEC  [cnt, shift, root, tail, edit]"
     ""
     "`T_CNT`, `T_SHIFT`, `T_ROOT` and `T_TAIL` are 0, 1, 2 and 3 -- the same"
     "numbers as `V_CNT`, `V_SHIFT`, `V_ROOT` and `V_TAIL`. The layouts part"
     "company only at slot 4, where a vector keeps its metadata and a"
     "transient its edit token, and no reader below looks that far."
     ""
     "SO THE BODIES WERE IDENTICAL, four of them, differing only in whether"
     "the parameter was called `v` or `t` -- `tvec-shift` was a byte-for-byte"
     "copy of `vec-shift` in a file that ALREADY IMPORTED `vec-shift` and used"
     "it eleven lines further down. The names stay, because `(tvec-count rt t)`"
     "says what `(vec-count rt t)` would only imply, and `^:inline` means"
     "saying it costs nothing."
     ""
     "THE PREFIX IS NOW LOAD-BEARING, and it was not written down anywhere"
     "before this comment. `runtime/src/vector.rs` asserts it at COMPILE TIME"
     "rather than trusting the reader: put `T_EDIT` in front of `T_TAIL` one"
     "day and the build stops, instead of four readers quietly returning the"
     "wrong slot.")
(defn ^:pub ^:inline ^:method ^I32 tvec-count [^Rt rt ^Value t]
  (return (vec-count rt t)))

(defn ^:pub ^:inline ^:method ^I32 tvec-shift [^Rt rt ^Value t]
  (return (vec-shift rt t)))

(doc "Where the transient's tail starts, on the same rule as a vector's --"
     "which is now the same CODE as a vector's.")
(defn ^:pub ^:inline ^:method ^I32 tvec-tail-off [^Rt rt ^Value t]
  (return (tail-off rt t)))

(doc "Is this transient still usable? `persistent!` clears the token, and a"
     "transient without one has been handed over and must not be written.")
(defn ^:pub ^:inline ^:method ^Bool tvec-alive [^Rt rt ^Value t]
  (return (not (nil? rt (slot rt t T_EDIT)))))

(doc "`transient`: O(1), because nothing is copied until the first write that"
     "reaches a node this transient does not already own."
     ""
     "The TAIL is the exception and is widened to a full 32 here, so that"
     "`conj!` can write into it in place rather than copying it one longer on"
     "every append -- which is the copy transients exist to avoid.")
(defn ^:pub ^:method ^Value vec-transient [^:mut ^Rt rt ^Value v]
  (let [^RootIx base (mark rt)
        ^RootIx vi (push rt v)
        ^Value edit (new-edit-token rt)
        ^RootIx ei (push rt edit)
        ^Value tail (node-clone rt (slot rt (r rt vi) V_TAIL) WIDTH (r rt ei))
        ^RootIx ti (push rt tail)
        ^RootIx ri (push rt (slot rt (r rt vi) V_ROOT))
        ^Addr a (alloc rt TY_TVEC 5)]
    (if (== a 0)
      (do (pop-to rt base)
          (return NIL)))
    (let [^Value vv (r rt vi)
          ^I32 cnt (vec-count rt vv)
          ^I32 shift (vec-shift rt vv)]
      (set-at rt a T_CNT (fixnum cnt))
      (set-at rt a T_SHIFT (fixnum shift))
      (set-at rt a T_ROOT (r rt ri))
      (set-at rt a T_TAIL (r rt ti))
      (set-at rt a T_EDIT (r rt ei))
      (pop-to rt base)
      (return (heap a)))))

(doc "`node` if this transient already owns it, else an owned copy."
     ""
     "The one test the whole transient design rests on. A node whose token is"
     "this transient's was made by it and nobody else can see it, so writing"
     "in place is safe; any other node may be shared with a persistent vector"
     "and is copied ONCE, after which the copy is owned.")
(defn ^:pub ^:method ^Value ensure-editable [^:mut ^Rt rt ^Value node ^Value edit]
  (if (== (node-edit rt node) edit)
    (return node))
  (return (node-clone rt node WIDTH edit)))

(doc "The leaf holding index `i` of a transient -- the vector's descent, for"
     "the reason at the top of this file.")
(defn ^:pub ^:method ^Value t-array-for [^Rt rt ^Value t ^I32 i]
  (return (array-for rt t i)))

(doc "Element `i` of a transient, or `dflt`. Same convergence as `vec-nth`.")
(defn ^:pub ^:method ^Value tvec-nth [^Rt rt ^Value t ^I32 i ^Value dflt]
  (return (vec-nth rt t i dflt)))
