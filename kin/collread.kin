;; `get` AND `contains?`: the two generics that read by key.
;;
;; Every collection answers `get`, and the ones that are indexed answer it for
;; an integer key -- so this is one dispatch with a second, smaller one inside
;; it for whether the key is an index at all. A key that is not an integer on
;; an indexed collection is not an error; it is a MISS, and the default comes
;; back. That is Clojure's rule and it is what makes `(get v :nope)` safe.
;;
;; THE INDEX IS TAKEN AS A SIGNED 64-BIT VALUE. `is-int` is true of a bigint
;; too, and `i64-of` reads the real number out of one -- reading it with the
;; fixnum accessor instead is what made `assoc` on a table compare garbage
;; against its row count on both ports.
;;
;; `contains?` ON AN INDEXED COLLECTION ASKS ABOUT THE INDEX, not the value.
;; `(contains? [:a :b] :a)` is false and `(contains? [:a :b] 1)` is true, which
;; surprises everyone once and is the only reading that makes it agree with the
;; map case.
(ns flint.rt.collread
  (:require [flint.impl.rt :refer [defn return if let do comment doc == != >=
                                   < or not nil? is-heap as-heap ty slot
                                   to-i32 u< i64-of bare-kw static-text
                                   throw-str
                                   ref-get Rt Value I32 I64 Ty Bool NIL
                                   NOT_FOUND TY_ARRAYMAP TY_HASHMAP TY_SET
                                   TY_VEC TY_MAPENTRY TY_TABLE TY_TABLEREF
                                   TY_TAGGED TY_BYTES TY_BROPE TY_TVEC TY_TMAP
                                   TY_TSET TY_CONS TY_EMPTY_LIST
                                   TY_LAZYSEQ TY_VECSEQ TY_STRSEQ]]
            [flint.rt.vecread :refer [vec-nth vec-count]]
            [flint.rt.tableref :refer [table-ref]]
            [flint.rt.strs :refer [char-at]]
            [flint.rt.mapread :refer [map-get map-contains]]
            [flint.rt.setcore :refer [set-get set-contains]]
            [flint.rt.byteat :refer [b-at]]
            [flint.rt.vectrans :refer [tvec-nth]]
            [flint.rt.maptrans :refer [tmap-get tset-get]]
            [flint.rt.ropemeas :refer [is-string]]
            [flint.rt.numkind :refer [is-int]]))

(doc "The value `k` maps to, or `dflt`."
     ""
     "A STRING IS INDEXED BY CODE POINT, so `(get \"abc\" 1)` is `\\b`. It is"
     "checked before the tag dispatch because a string is not always a heap"
     "value: a short one lives INLINE in the value's bits.")
(defn ^:pub ^:method ^Value coll-get [^:mut ^Rt rt ^Value coll ^Value k ^Value dflt]
  (if (is-string rt coll)
    (do (if (is-int rt k)
          (let [^I64 i (i64-of rt k)]
            (if (>= i 0)
              (return (char-at rt coll (to-i32 i) dflt)))))
        (return dflt)))
  (if (not (is-heap coll))
    (return dflt))
  (let [^Ty t (ty rt (as-heap coll))]
    (if (or (== t TY_ARRAYMAP) (== t TY_HASHMAP))
      (return (map-get rt coll k dflt)))
    (if (== t TY_SET)
      (return (set-get rt coll k dflt)))
    (if (== t TY_VEC)
      (do (if (is-int rt k)
            (let [^I64 i (i64-of rt k)]
              (if (>= i 0)
                (return (vec-nth rt coll (to-i32 i) dflt)))))
          (return dflt)))
    (comment "A MAP ENTRY IS INDEXED 0 AND 1, and nothing else -- it is a"
             "pair, not a vector that happens to be two long.")
    (if (== t TY_MAPENTRY)
      (do (if (is-int rt k)
            (let [^I64 i (i64-of rt k)]
              (if (== i 0)
                (return (slot rt coll 0)))
              (if (== i 1)
                (return (slot rt coll 1)))))
          (return dflt)))
    (comment "A TABLE INDEXES BY ROW and hands back a REF, which materialises"
             "nothing (`tables`).")
    (if (== t TY_TABLE)
      (do (if (is-int rt k)
            (let [^I64 i (i64-of rt k)]
              (if (>= i 0)
                (let [^Value row (table-ref rt coll (to-i32 i))]
                  (if (nil? rt row)
                    (return dflt))
                  (return row)))))
          (return dflt)))
    (if (== t TY_TABLEREF)
      (return (ref-get rt coll k dflt)))
    (comment "A TAGGED LITERAL READS LIKE A TWO-KEY MAP, so `(:tag x)` and"
             "`(get x :form)` work and nothing treating one as a map has to"
             "learn a different way in (`tagged-literals`).")
    (if (== t TY_TAGGED)
      (do (if (== k (bare-kw rt (static-text "tag")))
            (return (slot rt coll 0)))
          (if (== k (bare-kw rt (static-text "form")))
            (return (slot rt coll 1)))
          (return dflt)))
    (if (or (== t TY_BYTES) (== t TY_BROPE))
      (do (if (is-int rt k)
            (let [^I64 i (i64-of rt k)]
              (if (>= i 0)
                (return (b-at rt coll (to-i32 i) dflt)))))
          (return dflt)))
    (if (== t TY_TVEC)
      (do (if (is-int rt k)
            (let [^I64 i (i64-of rt k)]
              (if (>= i 0)
                (return (tvec-nth rt coll (to-i32 i) dflt)))))
          (return dflt)))
    (if (== t TY_TMAP)
      (return (tmap-get rt coll k dflt)))
    (if (== t TY_TSET)
      (return (tset-get rt coll k dflt))))
  (return dflt))

(doc "Is there something under `k`?"
     ""
     "ASKS ABOUT THE KEY, and on an indexed collection the key is the INDEX."
     "`(contains? [:a :b] :a)` is false."
     ""
     "The general case is `get` against `NOT_FOUND`, which is the one value a"
     "collection cannot be holding -- so a stored nil is still `contains?`.")
(defn ^:pub ^:method ^Bool coll-contains [^:mut ^Rt rt ^Value coll ^Value k]
  (if (nil? rt coll)
    (return false))
  (if (is-heap coll)
    (let [^Ty t (ty rt (as-heap coll))]
      (if (or (== t TY_ARRAYMAP) (== t TY_HASHMAP))
        (return (map-contains rt coll k)))
      (if (== t TY_SET)
        (return (set-contains rt coll k)))
      (if (== t TY_VEC)
        (do (if (is-int rt k)
              (let [^I64 i (i64-of rt k)]
                (if (< i 0)
                  (return false))
                (return (u< (to-i32 i) (vec-count rt coll)))))
            (return false)))
      (comment "A LIST AND A SEQ REFUSE, which Clojure says with"
               "`IllegalArgumentException: contains? not supported on type`."
               "Answering `false` -- which is what falling through to"
               "`coll-get` did -- is the wrong kind of wrong: `(contains?"
               "'(1 2) 0)` reads as `this list has no key 0` when the truth is"
               "`a list has no keys`, and the caller who wrote it meant"
               "`(some #{0} '(1 2))` and got a plausible answer instead of a"
               "correction."
               ""
               "STRINGS AND BYTE STRINGS STILL ANSWER, because they ARE"
               "indexed: `(contains? \"ab\" 0)` is true in Clojure. So the"
               "refusal names the seq tags rather than everything that is not"
               "a map, a set or a vector.")
      (if (or (or (== t TY_CONS) (== t TY_EMPTY_LIST))
              (or (== t TY_LAZYSEQ) (or (== t TY_VECSEQ) (== t TY_STRSEQ))))
        (do
          (comment "THROWN AS A STATEMENT, then a value, because this answers"
                   "`Bool` and `throw-str` answers `Value` -- the same shape"
                   "`ttable-live` uses. The `false` is never read: the caller"
                   "checks the thrown flag first.")
          (throw-str rt "IllegalArgumentException"
                     (static-text "contains? is not supported on a list or a seq"))
          (return false)))))
  (return (!= (coll-get rt coll k NOT_FOUND) NOT_FOUND)))
