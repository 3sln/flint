extern crate alloc;
type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_CONS: u8 = 6; const TY_VECSEQ: u8 = 11; const TY_STRSEQ: u8 = 12;
const TY_RANGE: u8 = 13; const TY_MAPENTRY: u8 = 20; const TY_TABLE: u8 = 49;
const TY_LAZYSEQ: u8 = 3; const TY_EMPTY_LIST: u8 = 7;
const LS_THUNK: u32 = 0; const LS_SEQ: u32 = 1;
const TY_VEC: u8 = 9; const TY_STR: u8 = 2;
// THE TYPES `seq` DISPATCHES OVER beyond the walk's own. Each has to exist for
// the fixture to hand `seq` one of it, which is the whole point: an arm that
// nothing is ever built for is an arm nothing checks.
const TY_ARRAYMAP: u8 = 16; const TY_HASHMAP: u8 = 17; const TY_SET: u8 = 18;
const TY_TABLEREF: u8 = 50; const TY_ATOM: u8 = 32;
const C_FIRST: u32 = 0; const C_REST: u32 = 1; const C_COUNT: u32 = 3;
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    // A FIXNUM here is anything below the heap floor and not NIL, which is
    // all `count-hint`'s answer needs to be discriminated by.
    fn is_fixnum(self) -> bool { self.0 < 100 && self.0 != NIL.0 }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool,
           thrown: alloc::string::String }
impl Rt {
    // `seq`'s COLLABORATORS. `map-entry-vector` and `set-element-vector` are
    // still hand-written -- they walk a CHAMP with a host callback, which is
    // the closure hole -- so the probe answers a plain vector.
    fn is_string(&self, v: Value) -> bool {
        v.is_heap() && self.ty_of(v) == TY_STR
    }
    fn char_len(&mut self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn range_empty(&mut self, v: Value) -> bool {
        self.slot(v, 0).0 >= self.slot(v, 1).0
    }
    fn map_entry_vector(&mut self, m: Value) -> Value { self.slot(m, 0) }
    fn set_element_vector(&mut self, m: Value) -> Value { self.slot(m, 0) }
    fn ref_to_map(&mut self, r: Value) -> Value { self.slot(r, 0) }
    fn describe(&mut self, v: Value) -> alloc::string::String {
        if v.is_nil() { return alloc::string::String::from("nil"); }
        if !v.is_heap() { return alloc::string::String::from("a number"); }
        alloc::string::String::from(match self.ty_of(v) {
            TY_ATOM => "an atom",
            _ => "something else",
        })
    }
    fn throw_str(&mut self, _kind: &str, msg: &alloc::string::String) -> Value {
        self.thrown = msg.clone();
        NIL
    }
    fn ty_of(&self, v: Value) -> u8 { self.gc.sp[v.0 as usize] }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    // `count-hint` lives in `seqcore` and is reached across units. The probe
    // answers it the way the real one does for the shapes this driver builds:
    // a cons carries its count in C_COUNT (nil when unknown), a vector knows
    // its own, and everything else declines.
    fn count_hint(&mut self, v: Value) -> Value {
        if !v.is_heap() { return NIL; }
        let t = ty(&self.gc.sp, v.as_heap());
        if t == TY_CONS { return self.slot(v, C_COUNT); }
        if t == TY_VEC { return Value::fixnum(self.vec_count(v) as i64); }
        NIL
    }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.set_slot(v.as_heap(), i, x); }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }

    // --- the stubs the source reaches -----------------------------------
    //
    // A "vector" here is slot 0 = count, then elements; a "string" is the
    // same shape. Enough for `first` and `next` to be exercised over every
    // seq tag without pulling in the real collections.
    fn vec_count(&self, v: Value) -> u32 { self.slot(v, 0).0 as u32 }
    fn vec_nth(&self, v: Value, i: u32, dflt: Value) -> Value {
        if i >= self.vec_count(v) { dflt } else { self.slot(v, i + 1) }
    }
    fn s_count(&self, v: Value) -> u32 { self.slot(v, 0).0 as u32 }
    fn char_at(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        if i >= self.s_count(v) { dflt } else { self.slot(v, i + 1) }
    }
    fn table_count(&mut self, t: Value) -> u32 { self.slot(t, 0).0 as u32 }
    fn table_ref(&mut self, t: Value, i: u32) -> Value { Value(0x7000 + i as u64) }
    fn num_add(&mut self, a: Value, b: Value) -> Value { Value(a.0 + b.0) }
    fn empty_list(&mut self) -> Value {
        let a = self.alloc(TY_EMPTY_LIST, 1); Value::heap(a)
    }
    // A THUNK, stubbed: slot 0 says what it answers, so a chain can be built
    // by hand and `force` walked over it. The real one calls back into guest
    // code; what `force` needs from it is only that it returns a value.
    fn invoke(&mut self, f: Value, _args: &[Value]) -> Value { self.slot(f, 0) }
    // `seq` is the IDENTITY on a seq and nil on anything else, which is what
    // the real one narrows to once a collection has been converted.
    fn vecseq(&mut self, v: Value, i: u32) -> Value {
        let a = self.alloc(TY_VECSEQ, 3);
        self.set_slot(a, 0, v); self.set_slot(a, 1, Value::fixnum(i as i64));
        Value::heap(a)
    }
    fn strseq(&mut self, v: Value, i: u32) -> Value {
        let a = self.alloc(TY_STRSEQ, 3);
        self.set_slot(a, 0, v); self.set_slot(a, 1, Value::fixnum(i as i64));
        Value::heap(a)
    }
    fn range(&mut self, start: Value, end: Value, step: Value) -> Value {
        let a = self.alloc(TY_RANGE, 3);
        self.set_slot(a, 0, start); self.set_slot(a, 1, end); self.set_slot(a, 2, step);
        Value::heap(a)
    }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 4000], gc: Gc { sp: vec![0u8; 4000] }, lens: vec![0; 4000],
                      bump: 100, roots: Vec::new(), starve: false,
                      thrown: alloc::string::String::new() };
    let mut o = String::new();
    let mk = |rt: &mut Rt, t: u8, vals: &[u64]| -> Value {
        let a = rt.alloc(t, vals.len() as u32 + 1);
        for (k, v) in vals.iter().enumerate() { rt.set_slot(a, k as u32, Value(*v)); }
        Value::heap(a)
    };
    // Every step HOISTED. `first` and `next` both take `&mut self`, so
    // `rt.first(rt.next(x))` is two mutable borrows at once -- the same rule
    // the generated sources hit, showing up in the probe that drives them.

    // CONS: first is slot 0, next seqs slot 1.
    let tailc = mk(&mut rt, TY_CONS, &[0x22, NIL.0]);
    let cons = mk(&mut rt, TY_CONS, &[0x11, tailc.0]);
    let c0 = rt.first(cons);
    let cn = rt.next(cons); let c1 = rt.first(cn);
    let ce = rt.next(tailc);
    o.push_str(&format!("cons={} next1={} next2={} ", c0.0, c1.0, ce.is_nil() as u32));

    // VECSEQ over a "vector": count in slot 0, elements after.
    let vec = mk(&mut rt, TY_VEC, &[2, 0xA1, 0xA2]);
    let vs = rt.vecseq(vec, 0);
    let v0 = rt.first(vs);
    let vn = rt.next(vs); let v1 = rt.first(vn);
    let ve = rt.next(vn);
    o.push_str(&format!("vec={} vecn={} vecend={} ", v0.0, v1.0, ve.is_nil() as u32));

    // VECSEQ over a MAP ENTRY: read directly, and exactly two long.
    let ent = mk(&mut rt, TY_MAPENTRY, &[0xE1, 0xE2]);
    let es = rt.vecseq(ent, 0);
    let e0 = rt.first(es);
    let en = rt.next(es); let e1 = rt.first(en);
    let ee = rt.next(en);
    o.push_str(&format!("ent={} entn={} entend={} ", e0.0, e1.0, ee.is_nil() as u32));

    // VECSEQ over a TABLE: answers a ROW REF, not the raw slot.
    let tab = mk(&mut rt, TY_TABLE, &[2]);
    let ts = rt.vecseq(tab, 0);
    let t0 = rt.first(ts);
    let tn = rt.next(ts); let t1 = rt.first(tn);
    let te = rt.next(tn);
    o.push_str(&format!("tab={} tabn={} tabend={} ", t0.0, t1.0, te.is_nil() as u32));

    // STRSEQ, by CODE POINT.
    let st = mk(&mut rt, TY_STR, &[3, 0xC1, 0xC2, 0xC3]);
    let ss = rt.strseq(st, 0);
    let s0 = rt.first(ss);
    let sn = rt.next(ss); let s1 = rt.first(sn);
    let sn2 = rt.next(sn); let s2 = rt.first(sn2);
    let se = rt.next(sn2);
    o.push_str(&format!("str={} strn={} strlast={} strend={} ",
        s0.0, s1.0, s2.0, se.is_nil() as u32));

    // RANGE: first is `start`, next is a FRESH range.
    let rg = rt.range(Value(5), Value(9), Value(2));
    let r0 = rt.first(rg);
    let rn = rt.next(rg); let r1 = rt.first(rn);
    let rn2 = rt.next(rn); let r2 = rt.first(rn2);
    o.push_str(&format!("rng={} rngn={} rngn2={} ", r0.0, r1.0, r2.0));
    // The original is UNDISTURBED, which is what makes a range a value.
    let again = rt.first(rg);
    o.push_str(&format!("rngsame={} ", again.0));


    // --- rest: never nil, and the empty list when exhausted ---------------
    let r1 = rt.rest(cons);
    let r1f = rt.first(r1);
    let onec = mk(&mut rt, TY_CONS, &[0x33, NIL.0]);
    let r2 = rt.rest(onec);
    o.push_str(&format!("rest={} restend={} ", r1f.0,
        (ty(&rt.gc.sp, r2.as_heap()) == TY_EMPTY_LIST) as u32));

    // --- force: a thunk, a CHAIN of them, and the cache -------------------
    // A thunk here answers whatever sits in its slot 0.
    let answer = mk(&mut rt, TY_CONS, &[0x44, NIL.0]);
    let th = mk(&mut rt, TY_CONS, &[answer.0]);
    let lz = mk(&mut rt, TY_LAZYSEQ, &[th.0, NIL.0]);
    let f1 = rt.force(lz);
    o.push_str(&format!("force={} ", rt.first(f1).0));
    // CACHED: the thunk slot is cleared and the answer kept, so forcing again
    // runs nothing -- which is what makes a lazy seq a value.
    o.push_str(&format!("cached={} thunkcleared={} ",
        (rt.force(lz).0 == f1.0) as u32, rt.slot(lz, LS_THUNK).is_nil() as u32));
    // A CHAIN: a thunk answering a lazy seq answering a lazy seq.
    let inner = mk(&mut rt, TY_LAZYSEQ, &[th.0, NIL.0]);
    let midt = mk(&mut rt, TY_CONS, &[inner.0]);
    let outer = mk(&mut rt, TY_LAZYSEQ, &[midt.0, NIL.0]);
    let fc = rt.force(outer);
    o.push_str(&format!("chain={} ", rt.first(fc).0));

    // Nothing at all.
    let fn0 = rt.first(NIL); let nn0 = rt.next(NIL);
    o.push_str(&format!("nils={}{} ", fn0.is_nil() as u32, nn0.is_nil() as u32));

    // SEQ-COUNT, both paths, and the counted chain LIES. It is two cells long
    // and says nine, so `cnt_hint=9` proves the hint was read and `2` would
    // prove it was walked instead. With a truthful count both paths answer the
    // same number and the probe cannot tell the fast path from its absence --
    // which is the failure this file exists to not have.
    let ct2 = mk(&mut rt, TY_CONS, &[0x22, NIL.0, NIL.0, 8]);
    let ct1 = mk(&mut rt, TY_CONS, &[0x11, ct2.0, NIL.0, 9]);
    let un2 = mk(&mut rt, TY_CONS, &[0x44, NIL.0, NIL.0, NIL.0]);
    let un1 = mk(&mut rt, TY_CONS, &[0x33, un2.0, NIL.0, NIL.0]);
    o.push_str(&format!("cnt_hint={} cnt_walk={} cnt_vec={} cnt_nil={} ",
                        rt.seq_count(ct1), rt.seq_count(un1),
                        rt.seq_count(vec), rt.seq_count(NIL)));

    // SEQ ITSELF, over everything it dispatches on. `1` means "a seq came
    // back", `0` means NIL -- and the EMPTY cases must answer NIL, because
    // `(seq [])` being a truthy empty seq is the bug that makes every `when
    // (seq ...)` in a program wrong.
    let empty_vec = mk(&mut rt, TY_VEC, &[0]);
    let empty_str = mk(&mut rt, TY_STR, &[0]);
    let el = rt.empty_list();
    let inner_v = mk(&mut rt, TY_VEC, &[2, 0xA1, 0xA2]);
    let amap = mk(&mut rt, TY_ARRAYMAP, &[inner_v.0]);
    let hmap = mk(&mut rt, TY_HASHMAP, &[inner_v.0]);
    let set = mk(&mut rt, TY_SET, &[inner_v.0]);
    let empty_map = mk(&mut rt, TY_ARRAYMAP, &[empty_vec.0]);
    let tref = mk(&mut rt, TY_TABLEREF, &[amap.0]);
    let ment = mk(&mut rt, TY_MAPENTRY, &[2, 0xB1, 0xB2]);
    let some = |rt: &mut Rt, v: Value| -> u32 { (!rt.seq(v).is_nil()) as u32 };
    o.push_str(&format!("seq={}{}{}{}{}{}{}{}{}{}{} ",
                        some(&mut rt, NIL), some(&mut rt, el),
                        some(&mut rt, st), some(&mut rt, empty_str),
                        some(&mut rt, vec), some(&mut rt, empty_vec),
                        some(&mut rt, amap), some(&mut rt, hmap),
                        some(&mut rt, empty_map), some(&mut rt, set),
                        some(&mut rt, ment)));
    // A TABLE, A REF and a LAZY SEQ all come back as seqs; a ref goes through
    // its map, which is the one place a row materialises.
    o.push_str(&format!("seq2={}{}{} ", some(&mut rt, tab), some(&mut rt, tref),
                        some(&mut rt, outer)));
    // AND THE REFUSAL. This answered NIL here and threw on both ports, so
    // `(seq (atom 1))` was nil in one runtime and an exception in two.
    let atom = mk(&mut rt, TY_ATOM, &[0]);
    let bad = rt.seq(atom);
    o.push_str(&format!("refused={}|{}", bad.is_nil() as u32, rt.thrown));
    println!("{}", o);
}
--java-head
