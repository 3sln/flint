    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long tailc = mk(rt, TY_CONS, new long[]{0x22, NIL});
        long cons = mk(rt, TY_CONS, new long[]{0x11, tailc});
        o.append("cons=").append(first(rt, cons)).append(" next1=").append(first(rt, next(rt, cons)))
         .append(" next2=").append(Val.isNil(next(rt, tailc)) ? 1 : 0).append(' ');
        long vec = mk(rt, TY_VEC, new long[]{2, 0xA1, 0xA2});
        long vs = vecseq(rt, vec, 0);
        o.append("vec=").append(first(rt, vs)).append(" vecn=").append(first(rt, next(rt, vs)))
         .append(" vecend=").append(Val.isNil(next(rt, next(rt, vs))) ? 1 : 0).append(' ');
        long ent = mk(rt, TY_MAPENTRY, new long[]{0xE1, 0xE2});
        long es = vecseq(rt, ent, 0);
        o.append("ent=").append(first(rt, es)).append(" entn=").append(first(rt, next(rt, es)))
         .append(" entend=").append(Val.isNil(next(rt, next(rt, es))) ? 1 : 0).append(' ');
        long tab = mk(rt, TY_TABLE, new long[]{2});
        long ts = vecseq(rt, tab, 0);
        o.append("tab=").append(first(rt, ts)).append(" tabn=").append(first(rt, next(rt, ts)))
         .append(" tabend=").append(Val.isNil(next(rt, next(rt, ts))) ? 1 : 0).append(' ');
        long st = mk(rt, TY_STR, new long[]{3, 0xC1, 0xC2, 0xC3});
        long ss = strseq(rt, st, 0);
        o.append("str=").append(first(rt, ss)).append(" strn=").append(first(rt, next(rt, ss)))
         .append(" strlast=").append(first(rt, next(rt, next(rt, ss))))
         .append(" strend=").append(Val.isNil(next(rt, next(rt, next(rt, ss)))) ? 1 : 0).append(' ');
        long rg = range(rt, 5, 9, 2);
        o.append("rng=").append(first(rt, rg)).append(" rngn=").append(first(rt, next(rt, rg)))
         .append(" rngn2=").append(first(rt, next(rt, next(rt, rg)))).append(' ');
        o.append("rngsame=").append(first(rt, rg)).append(' ');

        long r1 = rest(rt, cons);
        long onec = mk(rt, TY_CONS, new long[]{0x33, NIL});
        long r2 = rest(rt, onec);
        o.append("rest=").append(first(rt, r1))
         .append(" restend=").append(ty(rt.gc.sp, Val.asHeap(r2)) == TY_EMPTY_LIST ? 1 : 0).append(' ');
        long answer = mk(rt, TY_CONS, new long[]{0x44, NIL});
        long th = mk(rt, TY_CONS, new long[]{answer});
        long lz = mk(rt, TY_LAZYSEQ, new long[]{th, NIL});
        long f1 = force(rt, lz);
        o.append("force=").append(first(rt, f1)).append(' ');
        o.append("cached=").append(force(rt, lz) == f1 ? 1 : 0)
         .append(" thunkcleared=").append(Val.isNil(rt.slot(lz, LS_THUNK)) ? 1 : 0).append(' ');
        long inner = mk(rt, TY_LAZYSEQ, new long[]{th, NIL});
        long midt = mk(rt, TY_CONS, new long[]{inner});
        long outer = mk(rt, TY_LAZYSEQ, new long[]{midt, NIL});
        o.append("chain=").append(first(rt, force(rt, outer))).append(' ');
        o.append("nils=").append(Val.isNil(first(rt, NIL)) ? 1 : 0)
         .append(Val.isNil(next(rt, NIL)) ? 1 : 0).append(' ');
        long ct2 = mk(rt, TY_CONS, new long[]{0x22, NIL, NIL, 8});
        long ct1 = mk(rt, TY_CONS, new long[]{0x11, ct2, NIL, 9});
        long un2 = mk(rt, TY_CONS, new long[]{0x44, NIL, NIL, NIL});
        long un1 = mk(rt, TY_CONS, new long[]{0x33, un2, NIL, NIL});
        o.append("cnt_hint=").append(seqCount(rt, ct1))
         .append(" cnt_walk=").append(seqCount(rt, un1))
         .append(" cnt_vec=").append(seqCount(rt, vec))
         .append(" cnt_nil=").append(seqCount(rt, NIL));
        long emptyVec = mk(rt, TY_VEC, new long[]{0});
        long emptyStr = mk(rt, TY_STR, new long[]{0});
        long el = emptyListOf(rt);
        long innerV = mk(rt, TY_VEC, new long[]{2, 0xA1, 0xA2});
        long amap = mk(rt, TY_ARRAYMAP, new long[]{innerV});
        long hmap = mk(rt, TY_HASHMAP, new long[]{innerV});
        long set = mk(rt, TY_SET, new long[]{innerV});
        long emptyMap = mk(rt, TY_ARRAYMAP, new long[]{emptyVec});
        long tref = mk(rt, TY_TABLEREF, new long[]{amap});
        long ment = mk(rt, TY_MAPENTRY, new long[]{2, 0xB1, 0xB2});
        o.append(" seq=").append(some(rt, NIL)).append(some(rt, el))
         .append(some(rt, st)).append(some(rt, emptyStr))
         .append(some(rt, vec)).append(some(rt, emptyVec))
         .append(some(rt, amap)).append(some(rt, hmap))
         .append(some(rt, emptyMap)).append(some(rt, set))
         .append(some(rt, ment)).append(' ');
        o.append("seq2=").append(some(rt, tab)).append(some(rt, tref))
         .append(some(rt, outer)).append(' ');
        long atom = mk(rt, TY_ATOM, new long[]{0});
        o.append("refused=").append(Val.isNil(seq(rt, atom)) ? 1 : 0)
         .append('|').append(rt.thrown);
        System.out.println(o.toString());
    }
--csharp-pre
// The hand-written runtime, as a REAL top-level namespace.
//
// The generated C# reaches it as `global::Flint.Rt.X`, because its own
// namespace ends in `Rt` and a bare `Flint.Rt` would resolve against that
// instead. `global::` needs a genuine root namespace, which a shim nested
// inside `class Probe` cannot be -- so these live out here now.
// `seq-of` NOW NAMES THE GENERATED CLASS. `seq` is generated into this very
// module, so the shim routes straight back into it rather than carrying a
// second copy that the fixture would then be testing against itself.
namespace _3sln.Flint.Kgen.Rt {
    internal static class Seqwalk {
        internal static long Seq(Probe.Rt rt, long v) { return Probe.Seq(rt, v); }
    }
}
namespace Flint.Rt {
    internal static class Seqs {
        internal static long EmptyList(Probe.Rt rt) { return Probe.EmptyListOf(rt); }
    }
    internal static class Table {
        internal static long refToMap(Probe.Rt rt, long r) { return rt.Slot(r, 0); }
    }
}

--csharp-head
    const long NIL = 0xFFFFL;
    const int C_FIRST = 0, C_REST = 1, C_COUNT = 3;
    const int LS_THUNK = 0, LS_SEQ = 1;
    internal static class Obj {
        internal const int TyCons = 6, TyVecseq = 11, TyStrseq = 12, TyRange = 13;
        internal const int TyMapentry = 20, TyTable = 49, TyVec = 9, TyStr = 2;
        internal const int TyLazyseq = 3, TyEmptyList = 7;
        internal const int TyArraymap = 16, TyHashmap = 17, TySet = 18,
                           TyTableref = 50, TyAtom = 32;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil; }
        internal static long AsHeap(long v) { return v; }
        internal static long Heap(long a) { return a; }
        internal static bool IsNil(long v) { return v == Nil; }
        internal static long AsFixnum(long v) { return v; }
        internal static long Fixnum(long n) { return n; }
        internal static bool IsFixnum(long v) { return v < 100 && v != Nil; }
    }
    internal sealed class Rt {
        internal long[] h = new long[4000];
        internal sealed class GcT { internal int[] sp = new int[4000]; }
        internal GcT gc = new GcT();
        internal int[] lens = new int[4000];
        internal long bump = 100;
        internal bool starve = false;
        internal string thrown = "";
        internal long ThrowStr(string kind, string msg) { thrown = msg; return Val.Nil; }
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
        // A THUNK, stubbed -- see the Rust head.
        internal long Call(long f, long[] args) { return Slot(f, 0); }
    }
    // The stubs -- see the Rust head for what each stands in for.
    internal static int VecCount(Rt rt, long v) { return (int) rt.Slot(v, 0); }
    internal static class Vec {
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            return i >= VecCount(rt, v) ? dflt : rt.Slot(v, i + 1);
        }
    }
    internal static long VecNth(Rt rt, long v, int i, long dflt) { return Vec.Nth(rt, v, i, dflt); }
    internal static class Str {
        internal static int SCount(Rt rt, long v) { return (int) rt.Slot(v, 0); }
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            return i >= SCount(rt, v) ? dflt : rt.Slot(v, i + 1);
        }
    }
    internal static int SCount(Rt rt, long v) { return Str.SCount(rt, v); }
    internal static class Table {
        internal static int tableCount(Rt rt, long t) { return (int) rt.Slot(t, 0); }
        internal static long tableRef(Rt rt, long t, int i) { return 0x7000 + i; }
    }
    internal static int TableCount(Rt rt, long t) { return Table.tableCount(rt, t); }
    internal static long TableRef(Rt rt, long t, int i) { return Table.tableRef(rt, t, i); }
    internal static class Num { internal static long Add(Rt rt, long a, long b) { return a + b; } }
    internal static long NumAdd(Rt rt, long a, long b) { return Num.Add(rt, a, b); }
    // `seq`'s collaborators -- see the Java copy.
    internal static class Maps { internal static long EntryVector(Rt rt, long m) { return rt.Slot(m, 0); } }
    internal static class Sets { internal static long ElementVector(Rt rt, long m) { return rt.Slot(m, 0); } }
    internal static long MapEntryVector(Rt rt, long m) { return Maps.EntryVector(rt, m); }
    internal static long SetElementVector(Rt rt, long m) { return Sets.ElementVector(rt, m); }
    internal static bool RangeEmpty(Rt rt, long v) { return rt.Slot(v, 0) >= rt.Slot(v, 1); }
    internal static string Describe(Rt rt, long v) {
        if (Val.IsNil(v)) return "nil";
        if (!Val.IsHeap(v)) return "a number";
        return Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyAtom ? "an atom" : "something else";
    }
    internal static long CountHint(Rt rt, long v) {
        if (!Val.IsHeap(v)) return Val.Nil;
        int t = Obj.Ty(rt.gc.sp, Val.AsHeap(v));
        if (t == Obj.TyCons) return rt.Slot(v, C_COUNT);
        if (t == Obj.TyVec) return Val.Fixnum(VecCount(rt, v));
        return Val.Nil;
    }
    internal static long EmptyListOf(Rt rt) { return Val.Heap(rt.Alloc(Obj.TyEmptyList, 1)); }
    static long Vecseq(Rt rt, long v, int i) {
        long a = rt.Alloc(Obj.TyVecseq, 3);
        rt.SetSlot(a, 0, v); rt.SetSlot(a, 1, i);
        return Val.Heap(a);
    }
    static long Strseq(Rt rt, long v, int i) {
        long a = rt.Alloc(Obj.TyStrseq, 3);
        rt.SetSlot(a, 0, v); rt.SetSlot(a, 1, i);
        return Val.Heap(a);
    }
    static long Range(Rt rt, long s, long e, long st) {
        long a = rt.Alloc(Obj.TyRange, 3);
        rt.SetSlot(a, 0, s); rt.SetSlot(a, 1, e); rt.SetSlot(a, 2, st);
        return Val.Heap(a);
    }
    static int Some(Rt rt, long v) { return Val.IsNil(Seq(rt, v)) ? 0 : 1; }
    static long Mk(Rt rt, int t, long[] vals) {
        long a = rt.Alloc(t, vals.Length + 1);
        for (int k = 0; k < vals.Length; k++) rt.SetSlot(a, k, vals[k]);
        return Val.Heap(a);
    }
    internal static bool IsString(Rt rt, long v) {
        return Val.IsHeap(v) && Obj.Ty(rt.gc.sp, Val.AsHeap(v)) == Obj.TyStr;
    }
--csharp
    public static void Main(string[] args) {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long tailc = Mk(rt, Obj.TyCons, new long[]{0x22, NIL});
        long cons = Mk(rt, Obj.TyCons, new long[]{0x11, tailc});
        o.Append("cons=").Append(First(rt, cons)).Append(" next1=").Append(First(rt, Next(rt, cons)))
         .Append(" next2=").Append(Val.IsNil(Next(rt, tailc)) ? 1 : 0).Append(' ');
        long vec = Mk(rt, Obj.TyVec, new long[]{2, 0xA1, 0xA2});
        long vs = Vecseq(rt, vec, 0);
        o.Append("vec=").Append(First(rt, vs)).Append(" vecn=").Append(First(rt, Next(rt, vs)))
         .Append(" vecend=").Append(Val.IsNil(Next(rt, Next(rt, vs))) ? 1 : 0).Append(' ');
        long ent = Mk(rt, Obj.TyMapentry, new long[]{0xE1, 0xE2});
        long es = Vecseq(rt, ent, 0);
        o.Append("ent=").Append(First(rt, es)).Append(" entn=").Append(First(rt, Next(rt, es)))
         .Append(" entend=").Append(Val.IsNil(Next(rt, Next(rt, es))) ? 1 : 0).Append(' ');
        long tab = Mk(rt, Obj.TyTable, new long[]{2});
        long ts = Vecseq(rt, tab, 0);
        o.Append("tab=").Append(First(rt, ts)).Append(" tabn=").Append(First(rt, Next(rt, ts)))
         .Append(" tabend=").Append(Val.IsNil(Next(rt, Next(rt, ts))) ? 1 : 0).Append(' ');
        long st = Mk(rt, Obj.TyStr, new long[]{3, 0xC1, 0xC2, 0xC3});
        long ss = Strseq(rt, st, 0);
        o.Append("str=").Append(First(rt, ss)).Append(" strn=").Append(First(rt, Next(rt, ss)))
         .Append(" strlast=").Append(First(rt, Next(rt, Next(rt, ss))))
         .Append(" strend=").Append(Val.IsNil(Next(rt, Next(rt, Next(rt, ss)))) ? 1 : 0).Append(' ');
        long rg = Range(rt, 5, 9, 2);
        o.Append("rng=").Append(First(rt, rg)).Append(" rngn=").Append(First(rt, Next(rt, rg)))
         .Append(" rngn2=").Append(First(rt, Next(rt, Next(rt, rg)))).Append(' ');
        o.Append("rngsame=").Append(First(rt, rg)).Append(' ');

        long r1 = Rest(rt, cons);
        long onec = Mk(rt, Obj.TyCons, new long[]{0x33, NIL});
        long r2 = Rest(rt, onec);
        o.Append("rest=").Append(First(rt, r1))
         .Append(" restend=").Append(Obj.Ty(rt.gc.sp, Val.AsHeap(r2)) == Obj.TyEmptyList ? 1 : 0).Append(' ');
        long answer = Mk(rt, Obj.TyCons, new long[]{0x44, NIL});
        long th = Mk(rt, Obj.TyCons, new long[]{answer});
        long lz = Mk(rt, Obj.TyLazyseq, new long[]{th, NIL});
        long f1 = Force(rt, lz);
        o.Append("force=").Append(First(rt, f1)).Append(' ');
        o.Append("cached=").Append(Force(rt, lz) == f1 ? 1 : 0)
         .Append(" thunkcleared=").Append(Val.IsNil(rt.Slot(lz, LS_THUNK)) ? 1 : 0).Append(' ');
        long inner = Mk(rt, Obj.TyLazyseq, new long[]{th, NIL});
        long midt = Mk(rt, Obj.TyCons, new long[]{inner});
        long outer = Mk(rt, Obj.TyLazyseq, new long[]{midt, NIL});
        o.Append("chain=").Append(First(rt, Force(rt, outer))).Append(' ');
        o.Append("nils=").Append(Val.IsNil(First(rt, NIL)) ? 1 : 0)
         .Append(Val.IsNil(Next(rt, NIL)) ? 1 : 0).Append(' ');
        long ct2 = Mk(rt, Obj.TyCons, new long[]{0x22, NIL, NIL, 8});
        long ct1 = Mk(rt, Obj.TyCons, new long[]{0x11, ct2, NIL, 9});
        long un2 = Mk(rt, Obj.TyCons, new long[]{0x44, NIL, NIL, NIL});
        long un1 = Mk(rt, Obj.TyCons, new long[]{0x33, un2, NIL, NIL});
        o.Append("cnt_hint=").Append(SeqCount(rt, ct1))
         .Append(" cnt_walk=").Append(SeqCount(rt, un1))
         .Append(" cnt_vec=").Append(SeqCount(rt, vec))
         .Append(" cnt_nil=").Append(SeqCount(rt, NIL));
        long emptyVec = Mk(rt, Obj.TyVec, new long[]{0});
        long emptyStr = Mk(rt, Obj.TyStr, new long[]{0});
        long el = EmptyListOf(rt);
        long innerV = Mk(rt, Obj.TyVec, new long[]{2, 0xA1, 0xA2});
        long amap = Mk(rt, Obj.TyArraymap, new long[]{innerV});
        long hmap = Mk(rt, Obj.TyHashmap, new long[]{innerV});
        long set = Mk(rt, Obj.TySet, new long[]{innerV});
        long emptyMap = Mk(rt, Obj.TyArraymap, new long[]{emptyVec});
        long tref = Mk(rt, Obj.TyTableref, new long[]{amap});
        long ment = Mk(rt, Obj.TyMapentry, new long[]{2, 0xB1, 0xB2});
        o.Append(" seq=").Append(Some(rt, Val.Nil)).Append(Some(rt, el))
         .Append(Some(rt, st)).Append(Some(rt, emptyStr))
         .Append(Some(rt, vec)).Append(Some(rt, emptyVec))
         .Append(Some(rt, amap)).Append(Some(rt, hmap))
         .Append(Some(rt, emptyMap)).Append(Some(rt, set))
         .Append(Some(rt, ment)).Append(' ');
        o.Append("seq2=").Append(Some(rt, tab)).Append(Some(rt, tref))
         .Append(Some(rt, outer)).Append(' ');
        long atom = Mk(rt, Obj.TyAtom, new long[]{0});
        o.Append("refused=").Append(Val.IsNil(Seq(rt, atom)) ? 1 : 0)
         .Append('|').Append(rt.thrown);
        System.Console.WriteLine(o.ToString());
    }
--expect
cons=17 next1=34 next2=1 vec=161 vecn=162 vecend=1 ent=225 entn=226 entend=1 tab=28672 tabn=28673 tabend=1 str=193 strn=194 strlast=195 strend=1 rng=5 rngn=7 rngn2=65535 rngsame=5 rest=34 restend=1 force=68 cached=1 thunkcleared=1 chain=68 nils=11 cnt_hint=9 cnt_walk=2 cnt_vec=2 cnt_nil=0 seq=00101011011 seq2=111 refused=1|seq over an atom needs more of the data structures
--expect-why
DERIVED BY HAND from `seqwalk.kin` against the hand-laid objects the probe
builds. Nothing was read off a run. The fixture's payloads are hex and the
output is decimal, so each conversion is written out below; NIL is 0xFFFF =
65535.

THE FOUR SEQ SHAPES, walked to exhaustion. Each row is first, the first of
next, and whether the walk ENDS -- and the ending is the half a walk that
runs one past the end would get wrong while every earlier field still agreed.

  cons=17 next1=34 next2=1
      A cell holding 0x11 = 17 whose rest is a cell holding 0x22 = 34, whose
      rest is NIL. `next` of the last cell is nil, so the `1`.

  vec=161 vecn=162 vecend=1
      A "vector" of 0xA1 = 161 and 0xA2 = 162 (the fixture keeps the count in
      slot 0 and the elements after it, so element i is slot i+1). `next`
      stops when i + 1 >= count: at i = 1 with count 2, which is the `1`.

  ent=225 entn=226 entend=1
      A MAP ENTRY, 0xE1 = 225 and 0xE2 = 226, read DIRECTLY off the entry
      rather than through a copied vector -- kin's header measures that at
      13.9% of a map walk. Its length is the constant 2, so `next` stops
      after the value; an entry routed through `vec-count` would read slot 0,
      which here holds the KEY (225) and not a count, and the walk would run
      225 elements long.

  tab=28672 tabn=28673 tabend=1
      A TABLE rides the same vecseq, and `first` answers a ROW REF:
      0x7000 = 28672 and 0x7001 = 28673 from the fixture's `table-ref`. The
      two differ, so the index really reaches it. Its length comes from
      `table-count`, not `vec-count`.

  str=193 strn=194 strlast=195 strend=1
      A string of three "code points" 0xC1, 0xC2, 0xC3 = 193, 194, 195. The
      index is CODE POINTS, which is what the strseq holds; kin's header
      records that the byte version read a rope's header as text.

  rng=5 rngn=7 rngn2=65535
      A range start 5, end 9, step 2: 5, 7, then 9 which is NOT below the end,
      so `seq` of it is nil and `first` of nil is NIL = 65535. Exclusive end,
      so 9 is absent -- an inclusive one would print 9 here.

  rngsame=5
      THE ORIGINAL RANGE IS UNDISTURBED after being walked twice. `next` builds
      a FRESH range rather than advancing a cursor, because a range IS a value;
      a mutated cursor prints 9 here and silently corrupts anything else
      holding the same range.

`rest=34 restend=1` -- `rest` is `next` except when exhausted, and then it is
the EMPTY LIST rather than nil. That is Clojure's rule and the whole
difference between the two: `(rest (rest [1]))` stays seqable. The second
digit checks the tag of what came back, so returning nil (or the original)
shows.

`force=68 cached=1 thunkcleared=1 chain=68` -- forcing a lazy seq.

  68 is 0x44, the value inside the cell the thunk answers.
  `cached=1`   forcing again returns the SAME value, by identity.
  `thunkcleared=1`  and LS_THUNK is NIL afterwards, which is what makes the
                    second force run nothing. A cache written into LS_SEQ but
                    with the thunk left in place would print `1 0` and re-run
                    the thunk every time -- a lazy seq behaving as a
                    generator, which is the bug kin's doc names.
  `chain=68`   a thunk answering a lazy seq answering a lazy seq collapses to
               the same 68. The loop is what does that; without it the caller
               gets a LAZYSEQ back where a seq was promised.

`nils=11` -- `first` and `next` of nil are both nil, not a crash: both start
by calling `seq`, which answers nil, and both check it.

`cnt_hint=9 cnt_walk=2 cnt_vec=2 cnt_nil=0` -- THE ASK, WHICH BOTH PORTS WERE
MISSING. The counted chain in the fixture is TWO CELLS LONG AND CLAIMS NINE.
That is deliberate and it is the only way this field can tell the fast path
from its absence: `9` proves `count-hint` was read, and `2` would prove the
list was walked instead. Kin's doc records that Rust had the O(1) path and the
JVM and CLR did not -- the same function in a different complexity class,
which no conformance diff can see because both answers are right.

  cnt_walk=2   an UNcounted chain (C_COUNT nil in both cells) really is
               walked, and really is two long
  cnt_vec=2    a vector answers from `vec-count`
  cnt_nil=0    `(count nil)` is 0

`seq=00101011011` -- `seq` over eleven inputs in the probe's order. `1` means
a seq came back and `0` means NIL:

  nil          0    nothing to walk
  empty list   0    NOT itself: `(seq ())` is nil
  "abc"        1    three code points
  ""           0
  [a b]        1
  []           0    `(seq [])` MUST be nil
  array map    1
  hash map     1
  {}           0
  set          1
  map entry    1    always -- an entry is two long by definition, so there is
                    no empty case and no count to consult

THE FIVE ZEROES IN THE MIDDLE ARE THE POINT. An empty collection answering a
truthy empty seq makes every `(when (seq coll) ...)` in a program wrong, and
each empty case here goes through a different length test -- `s-count`,
`vec-count`, and the entry vector's own count for the map.

`seq2=111` -- a TABLE, a ROW REF and a LAZY SEQ all come back as seqs. The ref
goes through `ref-to-map` and then through `seq` again, which is the one place
kin says a row materialises. The lazy seq here is the one already forced
above, so this also says a forced lazy seq is still seqable through its cache.

`refused=1|seq over an atom needs more of the data structures` -- AND THE
REFUSAL. `seq` of something with no arm THROWS rather than answering nil: kin
records that native answered NIL and both ports threw, so `(seq (atom 1))` was
nil in one runtime and an exception in two, and Clojure is the one that
refuses. The message is checked in full because it is assembled from three
pieces -- a static prefix, `describe`'s answer, and a static suffix -- and a
concatenation that dropped or reordered one is exactly the kind of thing that
differs per target. The `1` beside it is the sentinel the fixture's
`throw-str` returns.
