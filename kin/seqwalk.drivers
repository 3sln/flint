    static int ty(int[] sp, long a) { return sp[(int) a]; }
    // The stubs -- see the Rust head for what each stands in for.
    static final class Vec {
        static int count(Rt rt, long v) { return (int) rt.slot(v, 0); }
        static long nth(Rt rt, long v, int i, long dflt) {
            return i >= count(rt, v) ? dflt : rt.slot(v, i + 1);
        }
    }
    static final class Str {
        static boolean isString(Rt rt, long v) {
            return Val.isHeap(v) && ty(rt.gc.sp, Val.asHeap(v)) == TY_STR;
        }
        static int charLen(Rt rt, long v) { return (int) rt.slot(v, 0); }
        static long nth(Rt rt, long v, int i, long dflt) {
            return i >= charLen(rt, v) ? dflt : rt.slot(v, i + 1);
        }
    }
    static final class Table {
        static long refToMap(Rt rt, long r) { return rt.slot(r, 0); }
        static int tableCount(Rt rt, long t) { return (int) rt.slot(t, 0); }
        static long tableRef(Rt rt, long t, int i) { return 0x7000 + i; }
    }
    static final class Num { static long add(Rt rt, long a, long b) { return a + b; } }
    // `seq`'s COLLABORATORS. `entryVector` and `elementVector` are still
    // hand-written -- the closure hole -- so the probe answers a plain vector.
    static final class Maps { static long entryVector(Rt rt, long m) { return rt.slot(m, 0); } }
    static final class Sets { static long elementVector(Rt rt, long m) { return rt.slot(m, 0); } }
    static boolean rangeEmpty(Rt rt, long v) { return rt.slot(v, 0) >= rt.slot(v, 1); }
    static String THROWN = "";
    static String describe(Rt rt, long v) {
        if (Val.isNil(v)) return "nil";
        if (!Val.isHeap(v)) return "a number";
        return ty(rt.gc.sp, Val.asHeap(v)) == TY_ATOM ? "an atom" : "something else";
    }
