    static final int TY_MAPENTRY = 20, TY_TABLE = 49, TY_VEC = 9, TY_STR = 2;
    static final int TY_ARRAYMAP = 16, TY_HASHMAP = 17, TY_SET = 18,
                     TY_TABLEREF = 50, TY_ATOM = 32;
    static final int TY_LAZYSEQ = 3, TY_EMPTY_LIST = 7;
