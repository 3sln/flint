;; A PORT'S INBOX, written once.
;;
;; Every message a sandbox receives passes through these four functions, and a
;; divergence in any of them is a message lost, delivered twice, or delivered
;; to a reader that should have seen an empty queue. That is the worst class of
;; bug this runtime can have and the hardest to see: the three copies agreed on
;; every test because no test ran them concurrently against each other.
;;
;; A SINGLE-PRODUCER RING IT IS NOT. Two host threads may deliver into one end
;; at once, so the cursors move by compare-and-swap and the slot is claimed by
;; a second one. Both halves are necessary and neither is sufficient: winning
;; the cursor reserves the INDEX, and winning the slot publishes the VALUE.
;;
;; `EMPTY` IS THE HANDSHAKE between them. A slot holds `EMPTY` exactly when it
;; is unpublished, so a reader that has won the read cursor and finds `EMPTY`
;; has caught a writer mid-publish and reports an empty queue rather than
;; waiting -- the message is not lost, it is not there YET, and the next
;; receive will find it.
(ns flint.rt.portring
  (:require [flint.impl.rt :refer [defn return if let do comment doc while
                                   == != < > >= <= not and or + - rem
                                   local set continue forever
                                   slot slot-atomic cas-slot cas-slot-barriered
                                   spin-hint as-fixnum fixnum64 to-i32 as-idx
                                   Rt Value I32 I64 Bool NIL EMPTY
                                   PT_RING PT_INBOX PT_WRITE PT_READ]]))

(doc "One cursor, read atomically. Which one is the slot index."
     ""
     "SIGNED and 64-bit: the cursors only ever grow, and the difference"
     "between them is the depth. They are not wrapped -- the INDEX wraps, by"
     "`rem`, and the cursor does not -- so a queue that has carried four"
     "billion messages still reports its depth correctly.")
(defn ^:pub ^:method ^I64 ring-cursor [^Rt rt ^Value p ^I32 which]
  (return (as-fixnum (slot-atomic rt p which))))

(doc "How many messages are waiting."
     ""
     "CLAMPED AT ZERO, and that is not defensive tidiness. The two cursors are"
     "read one after the other without a lock, so a writer advancing between"
     "the two reads can make `write` look SMALLER than `read` for an instant."
     "Negative depth is not a state the queue can be in; it is an artefact of"
     "having looked twice, and the honest answer is zero."
     ""
     "Native said `saturating_sub` and the ports said `max(0, w - r)`, which"
     "are the same reading spelled two ways -- and one of them is a subtraction"
     "that would have wrapped to four billion had the type been unsigned.")
(defn ^:pub ^:method ^I32 ring-inbox-count [^Rt rt ^Value p]
  (let [^I64 w (ring-cursor rt p PT_WRITE)
        ^I64 r (ring-cursor rt p PT_READ)]
    (if (> w r)
      (return (to-i32 (- w r))))
    (return 0)))

(doc "PUT a message in, or answer false because the queue is full."
     ""
     "FULL IS NOT AN ERROR. It is back-pressure, and the caller parks on the"
     "port and tries again when a receive frees a slot."
     ""
     "TRY, THEN PARK -- never ask whether it is full and then put. The"
     "reservation IS the question, answered in one atomic step, so nothing can"
     "change between asking and acting."
     ""
     "THE LOOP RETRIES ON A LOST CURSOR AND SPINS ON A LOST SLOT, and they are"
     "different failures. Losing the cursor means another writer took this"
     "index, so the depth must be re-read and the whole thing re-tried. Losing"
     "the SLOT cannot happen to a writer that won the cursor -- the index is"
     "its own -- except while a reader is still clearing it, so that one is"
     "genuinely a spin.")
(defn ^:pub ^:method ^Bool ring-enqueue [^:mut ^Rt rt ^Value p ^Value v]
  (let [^I64 ring (as-fixnum (slot rt p PT_RING))]
    (if (== ring 0)
      (return false))
    (let [^Value inbox (slot rt p PT_INBOX)]
      (forever
        (let [^I64 w (ring-cursor rt p PT_WRITE)
              ^I64 r (ring-cursor rt p PT_READ)]
          (if (>= (- w r) ring)
            (return false))
          (let [^I32 idx (to-i32 (rem w ring))]
            (if (not (cas-slot rt p PT_WRITE (fixnum64 w) (fixnum64 (+ w 1))))
              (continue))
            (if (cas-slot-barriered rt inbox idx EMPTY v)
              (return true))
            (spin-hint rt)))))))

(doc "TAKE a message out, or NIL because there is nothing readable."
     ""
     "NIL FOR TWO DIFFERENT REASONS, and the caller cannot tell them apart on"
     "purpose: the queue is empty, or a writer has reserved the slot and not"
     "published it yet. Both mean `nothing for you right now`, and both are"
     "answered by trying again rather than by waiting here -- waiting would"
     "hold the scheduler on a slot another thread is one instruction from"
     "filling.")
(defn ^:pub ^:method ^Value ring-dequeue [^:mut ^Rt rt ^Value p]
  (let [^I64 ring (as-fixnum (slot rt p PT_RING))]
    (if (== ring 0)
      (return NIL))
    (let [^Value inbox (slot rt p PT_INBOX)]
      (forever
        (let [^I64 r (ring-cursor rt p PT_READ)]
          (if (>= r (ring-cursor rt p PT_WRITE))
            (return NIL))
          (let [^I32 idx (to-i32 (rem r ring))
                ^Value v (slot-atomic rt inbox idx)]
            (if (== v EMPTY)
              (return NIL))
            (if (not (cas-slot rt p PT_READ (fixnum64 r) (fixnum64 (+ r 1))))
              (continue))
            (if (cas-slot-barriered rt inbox idx v EMPTY)
              (return v))
            (spin-hint rt)))))))
