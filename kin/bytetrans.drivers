--rust-head
extern crate alloc;
type Addr = u32;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TRUE: Value = Value(0xFFFE);
const TY_BYTES: u8 = 44; const TY_BROPE: u8 = 45; const TY_TBYTES: u8 = 46;
const TY_VEC: u8 = 9;
// The generated Rust reaches these as `crate::bytes::BB_BYTES`, because in the
// real runtime they live on that module. A probe is its own crate, so it needs
// a module of that name for the same path to resolve.
pub mod bytes {
    pub const BB_BYTES: u32 = 0; pub const BB_DEPTH: u32 = 2;
    pub const TB_TREE: u32 = 0; pub const TB_TAIL: u32 = 1;
    pub const TB_FILL: u32 = 2; pub const TB_LIVE: u32 = 3;
    pub const TAIL_CAP: u32 = 8;
}
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && self.0 != TRUE.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
}
struct Gc { sp: Vec<u8> }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64, roots: Vec<Value>, starve: bool }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        if self.starve { return 0; }
        let a = self.bump; self.bump += n as u64 + 1;
        self.gc.sp[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set_slot(&mut self, a: Addr, i: u32, v: Value) { self.h[a as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    fn olen(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
}
fn ty(sp: &Vec<u8>, a: Addr) -> u8 { sp[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 4000], gc: Gc { sp: vec![0u8; 4000] },
                      lens: vec![0; 4000], bump: 100, roots: Vec::new(), starve: false };
    let mut o = String::new();
    let leaf = Value::heap(rt.alloc(TY_BYTES, 7));
    let t = rt.b_transient(leaf);
    o.push_str(&format!("ty={} tree={} tailty={} taillen={} fill={} live={} ",
                        ty(&rt.gc.sp, t.as_heap()),
                        (rt.slot(t, bytes::TB_TREE) == leaf) as u32,
                        ty(&rt.gc.sp, rt.slot(t, bytes::TB_TAIL).as_heap()),
                        rt.olen(rt.slot(t, bytes::TB_TAIL)),
                        rt.slot(t, bytes::TB_FILL).as_fixnum(),
                        (rt.slot(t, bytes::TB_LIVE) == TRUE) as u32));
    // A SECOND one over the first, to prove nothing is shared by accident.
    let t2 = rt.b_transient(t);
    o.push_str(&format!("distinct={} tail2={} ",
                        (t2.0 != t.0) as u32,
                        (rt.slot(t2, bytes::TB_TAIL).0 != rt.slot(t, bytes::TB_TAIL).0) as u32));
    // STARVED: both allocations refused, and the shadow stack must come back
    // to where it started -- a refusal that left roots pushed would leak them.
    let before = rt.mark();
    rt.starve = true;
    let n = rt.b_transient(leaf);
    o.push_str(&format!("starved={} roots={} ",
                        (n.0 == NIL.0) as u32, (rt.mark() == before) as u32));
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFL, TRUE = 0xFFFEL;
    static final int TY_BYTES = 44, TY_BROPE = 45, TY_TBYTES = 46, TY_VEC = 9;
    // Reached as `Bytes.BB_BYTES`, as in the real runtime.
    static final class Bytes {
        static final int BB_BYTES = 0, BB_DEPTH = 2;
        static final int TB_TREE = 0, TB_TAIL = 1, TB_FILL = 2, TB_LIVE = 3;
        static final int TAIL_CAP = 8;
    }
    static final class Val {
        static boolean isHeap(long v) { return v >= 100 && v != NIL && v != TRUE; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
        static long fixnum(long n) { return n; }
        static long heap(long a) { return a; }
        static final long TRUE = Probe.TRUE, NIL = Probe.NIL;
    }
    static final class Rt {
        long[] h = new long[4000];
        static final class GcT { int[] sp = new int[4000]; }
        GcT gc = new GcT();
        int[] lens = new int[4000];
        long bump = 100;
        boolean starve = false;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int ty(int[] sp, long a) { return sp[(int) a]; }
    static int olen(Rt rt, long v) { return rt.lens[(int) v]; }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long leaf = Val.heap(rt.alloc(TY_BYTES, 7));
        long t = bTransient(rt, leaf);
        o.append("ty=").append(ty(rt.gc.sp, t))
         .append(" tree=").append(rt.slot(t, Bytes.TB_TREE) == leaf ? 1 : 0)
         .append(" tailty=").append(ty(rt.gc.sp, rt.slot(t, Bytes.TB_TAIL)))
         .append(" taillen=").append(olen(rt, rt.slot(t, Bytes.TB_TAIL)))
         .append(" fill=").append(rt.slot(t, Bytes.TB_FILL))
         .append(" live=").append(rt.slot(t, Bytes.TB_LIVE) == TRUE ? 1 : 0).append(' ');
        long t2 = bTransient(rt, t);
        o.append("distinct=").append(t2 != t ? 1 : 0)
         .append(" tail2=").append(rt.slot(t2, Bytes.TB_TAIL) != rt.slot(t, Bytes.TB_TAIL) ? 1 : 0)
         .append(' ');
        int before = rt.mark();
        rt.starve = true;
        long n = bTransient(rt, leaf);
        o.append("starved=").append(n == NIL ? 1 : 0)
         .append(" roots=").append(rt.mark() == before ? 1 : 0).append(' ');
        System.out.println(o.toString());
    }
--csharp-pre
// `BB_BYTES` and friends are reached as `global::Flint.Rt.Bytes.X`, which needs
// a REAL top-level namespace -- a shim nested in `class Probe` cannot be one.
namespace Flint.Rt {
    internal static class Bytes {
        internal const int BB_BYTES = 0, BB_DEPTH = 2;
        internal const int TB_TREE = 0, TB_TAIL = 1, TB_FILL = 2, TB_LIVE = 3;
        internal const int TAIL_CAP = 8;
    }
}
--csharp-head
    internal static class Obj {
        internal const int TyBytes = 44, TyBrope = 45, TyTbytes = 46, TyVec = 9;
        internal static int Ty(int[] sp, long a) { return sp[(int) a]; }
    }
    internal static class Val {
        internal const long Nil = 0xFFFFL, True = 0xFFFEL;
        internal static bool IsHeap(long v) { return v >= 100 && v != Nil && v != True; }
        internal static long AsHeap(long v) { return v; }
        internal static long AsFixnum(long v) { return v; }
        internal static long Fixnum(long n) { return n; }
        internal static long Heap(long a) { return a; }
    }
    internal sealed class Rt {
        internal long[] h = new long[4000];
        internal sealed class GcT { internal int[] sp = new int[4000]; }
        internal GcT gc = new GcT();
        internal int[] lens = new int[4000];
        internal long bump = 100;
        internal bool starve = false;
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void PopTo(int n) { roots.RemoveRange(n, roots.Count - n); }
        internal long Alloc(int t, int n) {
            if (starve) return 0;
            long a = bump; bump += n + 1;
            gc.sp[(int) a] = t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = Val.Nil;
            return a;
        }
        internal void SetSlot(long a, int i, long v) { h[(int) a + i] = v; }
        internal long Slot(long n, int i) { return h[(int) n + i]; }
    }
    internal static int Olen(Rt rt, long v) { return rt.lens[(int) v]; }
--csharp
    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long leaf = Val.Heap(rt.Alloc(Obj.TyBytes, 7));
        long t = BTransient(rt, leaf);
        o.Append("ty=").Append(Obj.Ty(rt.gc.sp, t))
         .Append(" tree=").Append(rt.Slot(t, global::Flint.Rt.Bytes.TB_TREE) == leaf ? 1 : 0)
         .Append(" tailty=").Append(Obj.Ty(rt.gc.sp, rt.Slot(t, global::Flint.Rt.Bytes.TB_TAIL)))
         .Append(" taillen=").Append(Olen(rt, rt.Slot(t, global::Flint.Rt.Bytes.TB_TAIL)))
         .Append(" fill=").Append(rt.Slot(t, global::Flint.Rt.Bytes.TB_FILL))
         .Append(" live=").Append(rt.Slot(t, global::Flint.Rt.Bytes.TB_LIVE) == Val.True ? 1 : 0)
         .Append(' ');
        long t2 = BTransient(rt, t);
        o.Append("distinct=").Append(t2 != t ? 1 : 0)
         .Append(" tail2=").Append(rt.Slot(t2, global::Flint.Rt.Bytes.TB_TAIL) != rt.Slot(t, global::Flint.Rt.Bytes.TB_TAIL) ? 1 : 0)
         .Append(' ');
        int before = rt.Mark();
        rt.starve = true;
        long n = BTransient(rt, leaf);
        o.Append("starved=").Append(n == Val.Nil ? 1 : 0)
         .Append(" roots=").Append(rt.Mark() == before ? 1 : 0).Append(' ');
        System.Console.WriteLine(o.ToString());
    }
--expect
ty=46 tree=1 tailty=44 taillen=8 fill=0 live=1 distinct=1 tail2=1 starved=1 roots=1
--expect-why
DERIVED BY HAND from `bytetrans.kin` and the `-head` constants: TY_BYTES 44,
TY_TBYTES 46, TAIL_CAP 8. `b-transient` writes four slots and every one of
them is named in the source, so each field below is read off the code rather
than off a run.

THE HEADER. `b-transient leaf`, where `leaf` is a 7-byte TY_BYTES:

  ty      = 46 = TY_TBYTES. The header is a NEW object of the transient type,
            not the leaf handed back and not a TY_BROPE.
  tree    = 1: TB_TREE holds the argument itself, by identity. A transient
            over `v` starts as `v` plus nothing -- so 0 here would mean it
            copied or wrapped what the caller passed.
  tailty  = 44 = TY_BYTES. The tail is an ordinary flat leaf, which is the
            header's point: "a full tail is already the largest leaf the tree
            wants", so it can be handed over whole rather than copied.
  taillen = 8 = TAIL_CAP, allocated at full capacity up front. Not 0 and not
            7 (the tree's length): the tail's size has nothing to do with what
            is already in the transient, and an implementation that sized it
            from `v` would print 7.
  fill    = 0. The tail is allocated 8 long but EMPTY -- `TB_FILL` is how much
            of it is live, and it must start at zero however many bytes the
            allocator left behind in those 8. A non-zero fill here would make
            the transient claim garbage bytes it never wrote.
  live    = 1: TB_LIVE is TRUE, so the transient is usable before anything is
            done to it. `persistent!` is what clears this; construction sets
            it.

`distinct=1 tail2=1`. A second transient is opened OVER THE FIRST. The two
header Values must differ (1), and so must their tails (1) -- each call
allocates its own `TAIL_CAP` leaf. `tail2=0` would mean two transients writing
into the same open buffer, where appending to one would silently corrupt the
other. Both are 1, and both are needed: two distinct headers sharing one tail
would still print `distinct=1`.

`starved=1 roots=1` -- THE REFUSAL, and the reason the doc paragraph on
`DECISIONS.md#a-vec-of-values-is-not-a-root` is there. With `starve` set the
fixture's `alloc` returns 0, so the FIRST allocation (the tail) fails:
  starved = 1: `tail == 0` is caught and NIL is returned, rather than a header
            pointing at address 0.
  roots   = 1: the shadow stack is back to exactly where it was. `b-transient`
            pushed `v` before allocating, and its failure path runs `pop-to
            base` before answering -- so the mark afterwards equals the mark
            before. 0 would mean a refused call left a root pushed, which
            leaks it into whatever runs next and, worse, shifts every later
            RootIx by one.
