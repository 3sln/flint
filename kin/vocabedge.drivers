--rust-head
// NO RUNTIME AT ALL. Every function here is arithmetic over a 32-bit word, so
// the toy is an empty `Rt` -- these take one only because `^:method` does.
extern crate alloc;
struct Rt;
impl Rt {
--rust
}
fn main() {
    let rt = Rt;
    // 0x8000_0001: the high bit set and the low bit set, so a shift that
    // brings in the wrong thing shows in the top digit and a shift that
    // drops the wrong end shows in the bottom.
    let hi: u32 = 0x8000_0001;
    // THE f64 FAMILY. The NaN carries a payload of 1, which is the only thing
    // separating a preserving read from a canonicalising one.
    let nan = f64::from_bits(0x7FF8_0000_0000_0001);
    println!("{} {} {} {} {} {} {} {} {} {} | {} {} {} {} | {} {} | {} {}",
             rt.ushr_high(hi, 1) as i32, rt.ushr_high(hi, 31) as i32,
             rt.sar_high(hi, 1) as i32,  rt.sar_high(hi, 31) as i32,
             rt.shl_into_sign(1, 31) as i32, rt.shl_into_sign(3, 30) as i32,
             rt.narrow(0x1_2345_6789u64 as i64) as i32,
             rt.narrow(-1i64) as i32,
             rt.bits_and(hi, 0xFFFF) as i32,
             rt.bits_xor(hi, 0xFFFF_FFFF) as i32,
             rt.bits_of(nan), rt.bits_round_trip(nan),
             rt.bits_of(1.5), rt.as_double_bits(1),
             // WRAPPING, which must not trap on any of the three.
             rt.wrap_mul(0x7FFF_FFFF, 3) as i32, rt.wrap_add(0x7FFF_FFFF, 1) as i32,
             // UNSIGNED DIVISION against a literal, which is the only way to
             // ask for it -- `quot` needs BOTH sides tagged and a literal
             // carries no tag.
             rt.udiv_lit(hi) as i32, rt.umod_lit(hi) as i32);
}
--java-head
    // AN EMPTY `Rt`, because these are `^:method` and take one. There is no
    // runtime here to stand in for -- every function is arithmetic over a
    // 32-bit word.
    static final class Rt { }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        int hi = 0x80000001;
        double nan = Double.longBitsToDouble(0x7FF8000000000001L);
        System.out.println(
            ushrHigh(rt, hi, 1) + " " + ushrHigh(rt, hi, 31) + " "
            + sarHigh(rt, hi, 1) + " " + sarHigh(rt, hi, 31) + " "
            + shlIntoSign(rt, 1, 31) + " " + shlIntoSign(rt, 3, 30) + " "
            + narrow(rt, 0x123456789L) + " " + narrow(rt, -1L) + " "
            + bitsAnd(rt, hi, 0xFFFF) + " " + bitsXor(rt, hi, 0xFFFFFFFF)
            + " | " + bitsOf(rt, nan) + " " + bitsRoundTrip(rt, nan)
            + " " + bitsOf(rt, 1.5) + " " + asDoubleBits(rt, 1)
            + " | " + wrapMul(rt, 0x7FFFFFFF, 3) + " " + wrapAdd(rt, 0x7FFFFFFF, 1)
            + " | " + udivLit(rt, hi) + " " + umodLit(rt, hi));
    }
--csharp-head
    internal sealed class Rt { }
--csharp
    static void Main() {
        var rt = new Rt();
        int hi = unchecked((int) 0x80000001u);
        double nan = System.BitConverter.Int64BitsToDouble(0x7FF8000000000001L);
        System.Console.WriteLine(
            UshrHigh(rt, hi, 1) + " " + UshrHigh(rt, hi, 31) + " "
            + SarHigh(rt, hi, 1) + " " + SarHigh(rt, hi, 31) + " "
            + ShlIntoSign(rt, 1, 31) + " " + ShlIntoSign(rt, 3, 30) + " "
            + Narrow(rt, 0x123456789L) + " " + Narrow(rt, -1L) + " "
            + BitsAnd(rt, hi, 0xFFFF) + " " + BitsXor(rt, hi, unchecked((int) 0xFFFFFFFFu))
            + " | " + BitsOf(rt, nan) + " " + BitsRoundTrip(rt, nan)
            + " " + BitsOf(rt, 1.5) + " " + AsDoubleBits(rt, 1)
            + " | " + WrapMul(rt, 0x7FFFFFFF, 3) + " " + WrapAdd(rt, 0x7FFFFFFF, 1)
            + " | " + UdivLit(rt, hi) + " " + UmodLit(rt, hi));
    }
--expect
1073741824 1 -1073741824 -1 -2147483648 -1073741824 591751049 -1 1 2147483646 | 9221120237041090561 9221120237041090561 4609434218613702656 4607182418800017408 | 2147483645 -2147483648 | 715827883 0
--expect-why
DERIVED FROM THE BIT PATTERNS. The input is `0x80000001` throughout: the high
bit set and the low bit set, so a shift bringing in the wrong thing shows in
the top digit and one dropping the wrong end shows in the bottom.

 1. `ushr(0x80000001, 1)` = `0x40000000` = 1073741824. LOGICAL: zeros come in
    at the top. A `>>` that sign-extended on either port answers -1073741823.
 2. `ushr(0x80000001, 31)` = 1. All but the sign bit shifted out.
 3. `sar(0x80000001, 1)` = `0xC0000000` = -1073741824. ARITHMETIC: the sign
    propagates. This is the case that needs Rust's `as i32` round trip -- the
    value is a `u32` there, and `>>` on it would bring in zeros and answer
    case 1's number instead.
 4. `sar(0x80000001, 31)` = -1. Every bit becomes the sign.
 5. `shl(1, 31)` = `0x80000000` = -2147483648 read as a signed `int`, which is
    what both ports call it and Rust calls 2147483648. THE BITS ARE THE SAME;
    the fixture prints the signed reading on all three so they can be
    compared at all.
 6. `shl(3, 30)` = `0xC0000000` = -1073741824. Two bits land in the top two,
    one of them the sign.
 7. `narrow(0x123456789)` = `0x23456789` = 591751049. TRUNCATION, not
    saturation: a language that clamped would answer 2147483647.
 8. `narrow(-1)` = -1. All ones stay all ones; a widening-then-narrowing that
    went through an unsigned reading would answer the same, which is why case
    7 carries the weight.
 9. `bit-and(0x80000001, 0xFFFF)` = 1.
10. `bit-xor(0x80000001, 0xFFFFFFFF)` = `0x7FFFFFFE` = 2147483646.

THE f64 FAMILY, after the bar. The NaN is `0x7FF8000000000001` -- canonical
except for a payload of 1, which is the only thing separating a preserving
read from a canonicalising one.

11. `f64-bits(nan)` = 9221120237041090561 = `0x7FF8000000000001`. THE PAYLOAD
    SURVIVES. This is the case `f64-bits` failed until 2026-09-22: java's
    `doubleToLongBits` collapses every NaN to `0x7FF8000000000000` and would
    answer 9221120237041090560 here, one less, while `to_bits()` and
    `DoubleToInt64Bits` preserve. `hash-double` is generated from one source
    into three runtimes and answered differently because of it.
12. The round trip through `f64-of-bits` gives the same number back, which is
    what makes it a reinterpretation rather than a conversion.
13. `f64-bits(1.5)` = 4609434218613702656 = `0x3FF8000000000000`, an ordinary
    double for contrast: it agrees under BOTH spellings, which is why no
    fixture of ordinary values could ever have caught case 11.
14. `f64-bits(to-f64(1))` = 4607182418800017408 = the bits of 1.0. `to-f64`
    CONVERTS where `f64-of-bits` REINTERPRETS -- the same input 1 gives 1.0
    through one and 5e-324 through the other, and the names do not say
    which.

THE WRAPPING PAIR, after the second bar. Overflow must WRAP on all three and
trap on none.

15. `wmul(0x7FFFFFFF, 3)` = 6442450941 mod 2^32 = 2147483645. Rust would
    PANIC here in a debug build without `wrapping_mul` -- which is the build
    the tests run under, so a plain `*` would be right in release and a crash
    in the only place anyone would see it.
16. `wadd(0x7FFFFFFF, 1)` = `0x80000000`, printed through the signed reading
    as -2147483648 so the three can be compared at all; Rust calls the same
    bits 2147483648.

C# IS THE REASON THESE ARE HERE. It is unchecked by DEFAULT, so the word
would appear to work with no `unchecked` in the template at all -- until a
project-level `CheckForOverflowUnderflow` turned overflow into an exception on
one runtime and nowhere else. The template says `unchecked` explicitly and
this asserts that it still does.

THE UNSIGNED PAIR, after the third bar, and these two had NEVER RUN. A survey
of the 167 vocabulary words on 2026-09-22 found exactly two that no kin source
mentions: `uquot` and `urem`. Three hand-written templates each, in three
languages, never once executed.

17. `uquot(0x80000001, 3)` = 715827883. Signed division would answer
    -715827882: `0x80000001` is 2147483649 unsigned and -2147483647 signed.
18. `urem(0x80000001, 3)` = 0. Signed would answer -1.

THE LITERAL IS WHY THEY EXIST. `quot` and `rem` are `both-u32` -- they emit
the unsigned spelling only when BOTH arguments are tagged, and a literal
carries no tag, so `(quot h 3)` silently gets the signed operator.
`kin/unsigned.kin` reads as though it covers this and does not: it was
rewritten to use the tag-driven generic operators, which is the case a tag CAN
answer.
