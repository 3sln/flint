        var o = new System.Text.StringBuilder();
        long inbox = rt.MakeObj(new long[]{ Val.Empty, Val.Empty });
        long p = rt.MakeObj(new long[]{ 2, inbox, 0, 0 });

        o.Append(RingInboxCount(rt, p)).Append(RingDequeue(rt, p) == NIL ? "-" : "?").Append(' ');
        int a = RingEnqueue(rt, p, 100) ? 1 : 0;
        int b = RingEnqueue(rt, p, 200) ? 1 : 0;
        int c = RingEnqueue(rt, p, 300) ? 1 : 0;
        o.Append(a).Append(b).Append(c).Append(RingInboxCount(rt, p)).Append(' ');
        long x = RingDequeue(rt, p), y = RingDequeue(rt, p);
        o.Append(x).Append(',').Append(y).Append(',').Append(RingInboxCount(rt, p)).Append(' ');
        o.Append(RingDequeue(rt, p) == NIL ? "-" : "?").Append(rt.Slot(p, Conc.PT_WRITE)).Append(' ');
        int d = RingEnqueue(rt, p, 400) ? 1 : 0;
        int e = RingEnqueue(rt, p, 500) ? 1 : 0;
        o.Append(d).Append(e).Append(RingDequeue(rt, p)).Append(' ');
        long inbox2 = rt.MakeObj(new long[]{ Val.Empty, Val.Empty });
        long q = rt.MakeObj(new long[]{ 2, inbox2, 1, 0 });
        o.Append(RingDequeue(rt, q) == NIL ? "-" : "?").Append(rt.Slot(q, Conc.PT_READ));
        long z = rt.MakeObj(new long[]{ 0, inbox2, 0, 0 });
        o.Append(' ').Append(RingEnqueue(rt, z, 1) ? 1 : 0)
         .Append(RingDequeue(rt, z) == NIL ? "-" : "?");
        System.Console.WriteLine(o.ToString());
    }
--expect
0- 1102 100,200,0 -2 11400 -0 0-
--expect-why
DERIVED FROM WHAT A QUEUE PROMISES, field by field.

  empty    `0-`    A FRESH RING. Depth zero, and a take answers nothing. The
                   weakest field here and the one the rest assume.
  fill     `1102`  Two puts succeed, THE THIRD IS REFUSED, and the depth is 2.
                   `0` is the whole field: a ring of two holds two, and back-
                   pressure is the caller's signal to park. An implementation
                   that compared the INDEX rather than the depth would wrap
                   silently and answer `1` here, overwriting an unread
                   message -- which is the failure this whole file exists to
                   make impossible.
  fifo  `100,200,0` FIRST IN, FIRST OUT, and the depth falls to zero. Order is
                   the promise; a stack would answer `200,100` and pass every
                   other field in this file.
  drain    `-2`    Drained, and THE WRITE CURSOR IS AT 2 -- past the ring
                   size, not wrapped back to 0. The index wraps, the cursor
                   does not, and that is what keeps the depth arithmetic
                   correct after four billion messages. A cursor reset to 0 on
                   wrap answers `0` here and computes a negative depth the
                   moment the reader is behind.
  reuse  `11400`   A drained ring TAKES MORE. The slots went back to `EMPTY`
                   when they were read, which is the other half of the
                   handshake -- a dequeue that returned the value without
                   clearing the slot answers `1` then `0` here, because the
                   second put finds the slot occupied.
  mid      `-0`    A WRITER MID-PUBLISH, and this is the field that cannot be
                   got right by accident. The write cursor is at 1 and the
                   read cursor at 0, so the queue LOOKS non-empty -- and the
                   slot still holds `EMPTY`, meaning a writer reserved the
                   index and has not published. The answer is nothing, and
                   THE READ CURSOR MUST NOT MOVE (`0`): consuming the slot
                   would drop a message that was one instruction from
                   arriving. Every other field in this file passes against an
                   implementation that ignores `EMPTY` entirely.
  zero     `0-`    A RING OF ZERO takes nothing and gives nothing, rather than
                   dividing by it.
