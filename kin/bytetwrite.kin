;; Writing into a transient byte string: the tail, the flush, and sealing it.
;;
;; A transient is a sealed TREE plus an OPEN TAIL and how full that tail is.
;; Appending writes into the tail in place, which is the whole point -- no
;; allocation and no copy until it fills. When it does fill, the tail is handed
;; to the tree WHOLE rather than copied, which is why `TAIL_CAP` is exactly
;; `FLAT_MAX`: a full tail is already the largest leaf the tree wants.
;;
;; This is the half of `Bytes` that hole 5 was blocking last. A PARTIAL tail
;; has to be copied out to its real length before it can join the tree, and
;; copying bytes out is what there was nowhere to put until the sink existed.
(ns flint.rt.bytetwrite
  (:require [flint.impl.rt :refer [defn return if let do comment doc
                                   == != < > >= not nil? is-heap as-heap
                                   + - local set forever while continue to-addr
                                   mark push r pop-to alloc slot set-slot heap
                                   fixnum as-fixnum to-i32 write-u8 throw-str text
                                   sink-open sink-close sink-len sink-copy-out
                                   Rt Value Addr RootIx I32 Bool Sink NIL FALSE HDR
                                   TY_BYTES TB_TREE TB_TAIL TB_FILL TB_LIVE TAIL_CAP]]
            [flint.rt.bytecore :refer [tb-live]]
            [flint.rt.byteconcat :refer [b-concat]]
            [flint.rt.byteflat :refer [b-copy-range]]
            [flint.rt.bytefold :refer [b-empty]]
            [flint.rt.byteflat :refer [b-append]]))

(doc "Fold the full tail into the tree and start a fresh one."
     ""
     "A FULL tail is handed over WHOLE -- it is exactly the leaf the tree"
     "wants, so there is nothing to copy. A partial one is copied out to its"
     "real length first, because a leaf's length IS its byte count and handing"
     "over a half-filled buffer would say it holds `TAIL_CAP` bytes."
     ""
     "False when the fresh tail cannot be allocated, and the shadow stack is"
     "unwound before answering it.")
(defn ^:pub ^:method ^Bool tb-flush [^:mut ^Rt rt ^Value t ^I32 fill]
  (let [^RootIx base (mark rt)
        ^RootIx ti (push rt t)
        ^Value tail (slot rt (r rt ti) TB_TAIL)
        ^RootIx tli (push rt tail)]
    (local ^:mut ^Value piece)
    (if (== fill TAIL_CAP)
      (set piece (r rt tli))
      (set piece (b-copy-range rt (r rt tli) 0 fill)))
    (let [^RootIx pi (push rt piece)
          ^Value tree (slot rt (r rt ti) TB_TREE)
          ^RootIx tri (push rt tree)
          ^Value joined (b-concat rt (r rt tri) (r rt pi))
          ^RootIx ji (push rt joined)
          ^Addr fresh (alloc rt TY_BYTES TAIL_CAP)]
      (if (== fresh 0)
        (do (pop-to rt base)
            (return false)))
      (comment "READ BACK OUT OF THE ROOTS: `b-concat` and `alloc` both"
               "allocate, and a copying collector moves the transient out from"
               "under anything held in a host local across them.")
      (set-slot rt (r rt ti) TB_TREE (r rt ji))
      (set-slot rt (r rt ti) TB_TAIL (heap fresh))
      (set-slot rt (r rt ti) TB_FILL (fixnum 0))
      (pop-to rt base)
      (return true))))

(doc "Append one byte. No allocation and no copy until the tail fills."
     ""
     "The parameter is `bv` and not `byte` because `byte` is a JAVA KEYWORD"
     "and Java has no verbatim identifier to escape one with -- Rust would"
     "take `r#byte` and C# `@byte`, and the refusal is the right answer rather"
     "than two targets spelling it one way and one another."
     ""
     "`t` is ROOTED across the flush, and that is not caution: `tb-flush`"
     "allocates, allocating can collect, and the nursery is a copying"
     "collector -- so the transient moves and a host local pointing at it is"
     "reading where it used to be.")
(defn ^:pub ^:method ^Value b-conj [^:mut ^Rt rt ^Value t ^I32 bv]
  (if (not (tb-live rt t))
    (return (throw-str rt "IllegalStateException"
                       (text "this transient byte string is no longer usable"))))
  (let [^I32 fill (to-i32 (as-fixnum (slot rt t TB_FILL)))]
    (if (== fill TAIL_CAP)
      (do
        (let [^RootIx base (mark rt)
              ^RootIx ti (push rt t)
              ^Bool ok (tb-flush rt (r rt ti) fill)
              ^Value t2 (r rt ti)]
          (pop-to rt base)
          (if (not ok)
            (return NIL))
          (return (b-conj rt t2 bv)))))
    (let [^Value tail (slot rt t TB_TAIL)]
      (write-u8 rt (+ (+ (as-heap tail) HDR) (to-addr fill)) bv)
      (set-slot rt t TB_FILL (fixnum (+ fill 1)))
      (return t))))

(doc "Seal the transient and answer the byte string it built."
     ""
     "The transient is INVALIDATED rather than freed -- `TB_LIVE` goes false --"
     "so a program that keeps using one is told so rather than reading a"
     "structure somebody else now owns.")
(defn ^:pub ^:method ^Value b-persistent [^:mut ^Rt rt ^Value t]
  (if (not (tb-live rt t))
    (return (throw-str rt "IllegalStateException"
                       (text "this transient byte string is no longer usable"))))
  (let [^I32 fill (to-i32 (as-fixnum (slot rt t TB_FILL)))
        ^RootIx base (mark rt)
        ^RootIx ti (push rt t)]
    (if (> fill 0)
      (if (not (tb-flush rt (r rt ti) fill))
        (do (pop-to rt base)
            (return NIL))))
    (set-slot rt (r rt ti) TB_LIVE FALSE)
    (let [^Value out (slot rt (r rt ti) TB_TREE)]
      (pop-to rt base)
      (comment "NOTHING WAS EVER APPENDED, so the tree slot is still nil and"
               "the answer is the empty byte string rather than nil.")
      (if (nil? rt out)
        (return (b-empty rt)))
      (return out))))

(doc "Append a whole byte string into the transient."
     ""
     "BULK, because appending a 1 KB piece one byte at a time is the thing"
     "this type exists to stop doing. The source is copied into a sink FIRST"
     "and then moved into the tail in runs -- so nothing holds a position in"
     "the source's heap while the loop below allocates, and a flush in the"
     "middle cannot invalidate what is left to copy."
     ""
     "The sink is closed on EVERY exit, including the refusal: a caller that"
     "opened one and answered nil without closing it would leak the buffer"
     "into whatever ran next.")
(defn ^:pub ^:method ^Value b-append-bytes [^:mut ^Rt rt ^Value t ^Value v]
  (if (not (tb-live rt t))
    (return (throw-str rt "IllegalStateException"
                       (text "this transient byte string is no longer usable"))))
  (let [^Sink s (sink-open rt)]
    (b-append rt v s)
    (let [^I32 total (sink-len rt s)
          ^RootIx base (mark rt)
          ^RootIx ti (push rt t)]
      (local ^:mut ^I32 i)
      (set i 0)
      (while (< i total)
        (let [^I32 fill (to-i32 (as-fixnum (slot rt (r rt ti) TB_FILL)))]
          (if (== fill TAIL_CAP)
            (do
              (if (not (tb-flush rt (r rt ti) fill))
                (do (pop-to rt base)
                    (sink-close rt s)
                    (return NIL)))
              (continue)))
          (comment "As much as the tail has room for, or as much as is left.")
          (local ^:mut ^I32 n)
          (set n (- TAIL_CAP fill))
          (if (> n (- total i))
            (set n (- total i)))
          (let [^Value tail (slot rt (r rt ti) TB_TAIL)]
            (sink-copy-out rt s i n (+ (+ (as-heap tail) HDR) (to-addr fill)))
            (set-slot rt (r rt ti) TB_FILL (fixnum (+ fill n)))
            (set i (+ i n)))))
      (let [^Value out (r rt ti)]
        (pop-to rt base)
        (sink-close rt s)
        (return out)))))
