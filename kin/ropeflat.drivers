    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isInlineStr(long v) { return (v >>> 60) == 0xEL; }
        static int inlineLen(long v) { return (int) ((v >>> 56) & 0xF); }
        static boolean isHeap(long v) { return v >= 100 && v != NIL && (v >>> 60) != 0xEL; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v; }
        static long fixnum(long n) { return n; }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static final class Space {
        byte[] m = new byte[40000];
        int readU8(long a) { return m[(int) a] & 0xFF; }
    }
    static final class Rt {
        long[] h = new long[40000];
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        int[] lens = new int[40000];
        long bump = 100;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        java.util.ArrayList<java.io.ByteArrayOutputStream> sinks = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        void set(long n, int i, long v) { h[(int) n + i] = v; }
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        long alloc(int t, int n) {
            long a = bump; bump += n + 32;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        long slot(long n, int i) { return h[(int) n + i]; }
        int sinkOpen() { sinks.add(new java.io.ByteArrayOutputStream()); return sinks.size() - 1; }
        void sinkClose(int s) { while (sinks.size() > s) sinks.remove(sinks.size() - 1); }
        void sinkPutRun(int s, long addr, int len) {
            for (int i = 0; i < len; i++) sinks.get(s).write(gc.sp.m[(int) (addr + i)] & 0xFF);
        }
        void sinkPutInline(int s, long v) {
            int n = Val.inlineLen(v);
            for (int i = 0; i < n; i++) sinks.get(s).write((int) ((v >>> (8 * i)) & 0xFF));
        }
        long sinkContiguous(int s) {
            byte[] a = sinks.get(s).toByteArray();
            int[] bs = new int[a.length];
            for (int i = 0; i < a.length; i++) bs[i] = a[i] & 0xFF;
            return flat(this, bs);
        }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static int olen(Rt rt, long v) { return rt.lens[(int) v]; }
    static boolean isRope(Rt rt, long v) {
        return Val.isHeap(v) && ty(rt.gc.sp, v) == TY_ROPE;
    }
    static int ropeKids(Rt rt, long v) { return olen(rt, v) - Str.RP_KIDS; }
    static long flat(Rt rt, int[] bs) {
        long a = rt.alloc(TY_STR, bs.length);
        for (int i = 0; i < bs.length; i++) rt.gc.sp.m[(int) (a + Obj.STR_DATA) + i] = (byte) bs[i];
        return Val.heap(a);
    }
    static long inlineOf(int[] bs) {
        long v = (0xEL << 60) | ((long) bs.length << 56);
        for (int i = 0; i < bs.length; i++) v |= ((long) bs[i]) << (8 * i);
        return v;
    }
    static long node(Rt rt, long[] kids) {
        long a = rt.alloc(TY_ROPE, Str.RP_KIDS + kids.length);
        rt.set(a, Str.RP_FLAT, NIL);
        rt.set(a, Str.RP_HASH, NIL);
        for (int i = 0; i < kids.length; i++) rt.set(a, Str.RP_KIDS + i, kids[i]);
        return Val.heap(a);
    }
    static String show(Rt rt, long v) {
        StringBuilder s = new StringBuilder();
        for (int i = 0; i < olen(rt, v); i++) {
            if (i > 0) s.append('.');
            s.append(rt.gc.sp.readU8(v + Obj.STR_DATA + i));
        }
        return s.toString();
    }
