--rust-head
#[derive(Clone, Copy)]
struct Value(u64);
impl Value {
    fn is_heap(self) -> bool { self.0 >= 0x100 }
    fn as_heap(self) -> u32 { (self.0 & 0xff) as u32 }
}
struct Sp;
struct Gc { sp: Sp }
struct Rt { gc: Gc }
fn ty(_sp: &Sp, h: u32) -> u32 { h }
const TY_CONS: u32 = 1; const TY_EMPTY_LIST: u32 = 2; const TY_LAZYSEQ: u32 = 3;
const TY_VECSEQ: u32 = 4; const TY_STRSEQ: u32 = 5; const TY_RANGE: u32 = 6;
const TY_VEC: u32 = 7; const TY_MAPENTRY: u32 = 8; const TY_ARRAYMAP: u32 = 9;
const TY_HASHMAP: u32 = 10; const TY_TABLEREF: u32 = 11; const TY_SET: u32 = 12;
const CAT_SCALAR: u8 = 0; const CAT_SEQUENTIAL: u8 = 1;
const CAT_MAP: u8 = 2; const CAT_SET: u8 = 3;
impl Rt {
--rust
}
fn main() {
    let rt = Rt { gc: Gc { sp: Sp } };
    let mut o = String::new();
    o.push_str(&format!("{} ", rt.category(Value(7))));
    for h in 1..=13u64 { o.push_str(&format!("{}", rt.category(Value(0x100 | h)))); }
    println!("{}", o);
}
