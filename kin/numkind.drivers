    static void Main() {
        var rt = new Rt();
        var o = new StringBuilder();
        long[] vs = { 1L, 2L, 0x100 | 5, 0x100 | 6, 3L };
        foreach (long v in vs) {
            o.Append(IsInt(rt, v) ? 1 : 0).Append(IsNumber(rt, v) ? 1 : 0);
