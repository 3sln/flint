    static final class Val {
        static boolean isHeap(long v) { return v >= 0x100; }
        static int asHeap(long v) { return (int)(v & 0xff); }
        static boolean isFixnum(long v) { return v == 1; }
        static boolean isDouble(long v) { return v == 2; }
    }
    static final class Sp {}
    static final class Gc { final Sp sp = new Sp(); }
    static final class Rt { final Gc gc = new Gc(); }
    static int ty(Sp sp, int h) { return h; }
