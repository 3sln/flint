    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long[] vs = { 1L, 2L, 0x100 | 5, 0x100 | 6, 3L };
        for (long v : vs) {
            o.append(isInt(rt, v) ? 1 : 0).append(isNumber(rt, v) ? 1 : 0);
        }
        System.out.println(o);
