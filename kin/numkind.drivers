--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
impl Value {
    fn is_heap(self) -> bool { self.0 >= 0x100 }
    fn as_heap(self) -> u32 { (self.0 & 0xff) as u32 }
    fn is_fixnum(self) -> bool { self.0 == 1 }
    fn is_double(self) -> bool { self.0 == 2 }
}
struct Sp;
struct Gc { sp: Sp }
struct Rt { gc: Gc }
fn ty(_sp: &Sp, h: u32) -> u8 { h as u8 }
const TY_BIGINT: u8 = 5; const TY_STR: u8 = 6;
impl Rt {
--rust
}
fn main() {
    let rt = Rt { gc: Gc { sp: Sp } };
    let mut o = String::new();
    // fixnum, double, bigint, another heap tag, and an immediate that is none.
    for v in [Value(1), Value(2), Value(0x100 | 5), Value(0x100 | 6), Value(3)] {
        o.push_str(&format!("{}{}", rt.is_int(v) as u32, rt.is_number(v) as u32));
    }
    println!("{}", o);
}
