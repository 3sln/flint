        o.append("d=").append(Integer.toHexString(hashValue(rt, 0x200000000L))).append("/")
         .append(Integer.toHexString(hashValue(rt, 0x200000001L))).append(' ');
        o.append("n=").append(Integer.toHexString(hashValue(rt, NIL)))
         .append(" t=").append(Integer.toHexString(hashValue(rt, Val.TRUE)))
         .append(" f=").append(Integer.toHexString(hashValue(rt, Val.FALSE))).append(' ');
        o.append("fx=").append(Integer.toHexString(hashValue(rt, Val.fixnum(7)))).append(' ');
        o.append("is=").append(Integer.toHexString(hashValue(rt, 0x300000041L)))
         .append(" ik=").append(Integer.toHexString(hashValue(rt, 0x400000042L))).append(' ');
        o.append("other=").append(Integer.toHexString(hashValue(rt, 0x900000000L))).append(' ');

        int[] htags = { TY_STR, TY_ROPE, TY_BYTES, TY_BROPE, TY_KW, TY_SYM, TY_BIGINT,
                        TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_OTHER };
        StringBuilder tags = new StringBuilder();
        for (int t : htags) tags.append(Integer.toHexString(hashValue(rt, rt.obj(t)))).append(',');
        o.append("tags=").append(tags).append(' ');

        int[] stags = { TY_VEC, TY_MAPENTRY, TY_CONS, TY_EMPTY_LIST, TY_LAZYSEQ,
                        TY_VECSEQ, TY_STRSEQ, TY_RANGE };
        StringBuilder seqs = new StringBuilder();
        for (int t : stags) {
