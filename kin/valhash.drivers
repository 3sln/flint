    internal const long NIL = 0xFFFFL;
    internal static class Obj {
        internal const int TyVec = 10, TyCons = 11, TyOther = 12;
        internal const int TyStr = 13, TyRope = 14, TyKw = 15, TySym = 16;
        internal const int TyBigint = 17, TyMapentry = 18, TyEmptyList = 19;
        internal const int TyLazyseq = 20, TyVecseq = 21, TyStrseq = 22;
        internal const int TyRange = 23, TyArraymap = 24, TyHashmap = 25;
        internal const int TySet = 26, TyBytes = 27, TyBrope = 28;
        internal const int TyOpaque = 29, TyTable = 30, TyTableref = 31;
        internal const int TyTagged = 32;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal const int V_HASH = 0;
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal static bool IsHeap(long v) { return v >= 100 && v < 0x10000000L && v != NIL; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
        internal const long True = 0x2001L, False = 0x2002L;
        internal static bool IsFixnum(long v) { return (v >> 32) == 1; }
        internal static bool IsDouble(long v) { return (v >> 32) == 2; }
        internal static bool IsInlineStr(long v) { return (v >> 32) == 3; }
        internal static bool IsInlineKw(long v) { return (v >> 32) == 4; }
        internal static long AsFixnum(long v) { return v & 0xFFFFFFFFL; }
        internal static long Fixnum(long n) { return 0x100000000L | (n & 0xFFFFFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[400]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal long[,] slots = new long[400, 2];
        internal int budget = 1000, ticks = 0, seqn = 3;
        internal double[] doubles = { 1.5, double.NaN, 0.0 };
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Slot(long v, int i) { return slots[(int) v, i]; }
        internal void SetSlot(long a, int i, long x) { slots[(int) a, i] = x; }
        internal long Obj_(int t) {
            long a = bump; bump += 1;
            gc.sp.m[(int) a] = (byte) t;
            slots[(int) a, 0] = 0; slots[(int) a, 1] = 0;
            return a;
        }
        internal bool ChargeTick(long n, long c, string why) {
            ticks++; budget--; return budget >= 0;
        }
    }
    internal static int OrderedStep(int acc, int h) { return acc * 31 + h; }
    internal static int MixCollHash(int acc, int n) { return acc ^ unchecked(n * (int) 0x9E3779B9); }
    internal static string HEX(int h) { return h.ToString("x"); }
    internal static int HashLong(long n) { return (int) (n ^ (long) ((ulong) n >> 32)); }
    internal static int HashInt(int h) { return h ^ (int) ((uint) h >> 16); }
    internal const int HashTrue = 1231, HashFalse = 1237;
    internal static class Str {
        internal static int StringHash(Rt rt, long v) { return 0x5100 | (int) (v & 0xFF); }
        internal static int KeywordHash(Rt rt, long v) { return 0x5200 | (int) (v & 0xFF); }
    }
    internal static int SymbolHash(Rt rt, long v) { return 0x5300 | (int) (v & 0xFF); }
    internal static int RopeHash(Rt rt, long v) { return 0x5400 | (int) (v & 0xFF); }
    internal static int BHash(Rt rt, long v) { return 0x5500 | (int) (v & 0xFF); }
    internal static class Maps { internal static int Hash(Rt rt, long v) { return 0x5600 | (int) (v & 0xFF); } }
    internal static class Sets { internal static int Hash(Rt rt, long v) { return 0x5700 | (int) (v & 0xFF); } }
    internal static class Num {
        internal static double F64(Rt rt, long v) { return rt.doubles[(int) (v & 0xFF)]; }
        internal static long I64Of(Rt rt, long v) { return v & 0xFFFF; }
    }
    internal static class Table {
        internal static int tableCount(Rt rt, long t) { return 2; }
        internal static long tableRef(Rt rt, long t, int i) {
            rt.bump += 1;
            return Val.Fixnum(rt.slots[(int) t, 1] * 100 + i);
        }
    }
    internal static long Seq(Rt rt, long c) {
        int n = (Val.IsHeap(c) && Obj.Ty(rt.gc.sp, Val.AsHeap(c)) == Obj.TyVec)
                ? (int) rt.slots[(int) c, 1] : rt.seqn;
        return n == 0 ? NIL : 0xC000L + n;
    }
    internal static long First(Rt rt, long s) { return Val.Fixnum(s - 0xC000L); }
    internal static long Next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
--csharp
    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();

        long v = rt.Obj_(Obj.TyVec);
        rt.slots[(int) v, 1] = 3;
        rt.ticks = 0;
        int h1 = HashOrdered(rt, v);
        o.Append("v=").Append(h1.ToString("x")).Append(" ticks=").Append(rt.ticks).Append(' ');
        rt.ticks = 0;
        int h2 = HashOrdered(rt, v);
        o.Append("again=").Append(h2.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" cached=").Append(Val.IsFixnum(rt.Slot(v, V_HASH)) ? 1 : 0).Append(' ');

        long c = rt.Obj_(Obj.TyCons);
        rt.ticks = 0;
        int h3 = HashOrdered(rt, c);
        o.Append("c=").Append(h3.ToString("x")).Append(" ticks=").Append(rt.ticks).Append(' ');
        rt.ticks = 0;
        int h4 = HashOrdered(rt, c);
        o.Append("cagain=").Append(h4.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" nocache=").Append(Val.IsFixnum(rt.Slot(c, V_HASH)) ? 1 : 0).Append(' ');

        long e = rt.Obj_(Obj.TyVec);
        rt.slots[(int) e, 1] = 0;
        rt.ticks = 0;
        o.Append("e=").Append(HashOrdered(rt, e).ToString("x"))
         .Append(" ticks=").Append(rt.ticks).Append(' ');

        long s = rt.Obj_(Obj.TyVec);
        rt.slots[(int) s, 1] = 5;
        rt.budget = 2;
        rt.ticks = 0;
        int hs = HashOrdered(rt, s);
        o.Append("starve=").Append(hs.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" uncached=").Append(Val.IsFixnum(rt.Slot(s, V_HASH)) ? 1 : 0).Append(' ');
        rt.budget = 1000;

        rt.seqn = 0;
        o.Append("nil=").Append(HashOrdered(rt, NIL).ToString("x")).Append(' ');
        rt.seqn = 3;

        long big = rt.Obj_(Obj.TyVec);
        rt.slots[(int) big, 1] = 0;
        rt.SetSlot(big, V_HASH, Val.Fixnum(0xFFFFFFFFL));
        o.Append("hi=").Append(HashOrdered(rt, big).ToString("x"));
        o.Append(' ');
        // --- `value-hash`: every arm, and each stub names itself. ---------
        o.Append("d=").Append(HEX(HashValue(rt, 0x200000000L))).Append("/")
         .Append(HEX(HashValue(rt, 0x200000001L))).Append(' ');
        o.Append("n=").Append(HEX(HashValue(rt, NIL)))
         .Append(" t=").Append(HEX(HashValue(rt, Val.True)))
         .Append(" f=").Append(HEX(HashValue(rt, Val.False))).Append(' ');
        o.Append("fx=").Append(HEX(HashValue(rt, Val.Fixnum(7)))).Append(' ');
        o.Append("is=").Append(HEX(HashValue(rt, 0x300000041L)))
         .Append(" ik=").Append(HEX(HashValue(rt, 0x400000042L))).Append(' ');
        o.Append("other=").Append(HEX(HashValue(rt, 0x900000000L))).Append(' ');

        int[] htags = { Obj.TyStr, Obj.TyRope, Obj.TyBytes, Obj.TyBrope, Obj.TyKw, Obj.TySym, Obj.TyBigint,
                        Obj.TyArraymap, Obj.TyHashmap, Obj.TySet, Obj.TyOther };
        var tags = new System.Text.StringBuilder();
        foreach (int t in htags) tags.Append(HEX(HashValue(rt, rt.Obj_(t)))).Append(',');
        o.Append("tags=").Append(tags).Append(' ');

        int[] stags = { Obj.TyVec, Obj.TyMapentry, Obj.TyCons, Obj.TyEmptyList, Obj.TyLazyseq,
                        Obj.TyVecseq, Obj.TyStrseq, Obj.TyRange };
        var seqs = new System.Text.StringBuilder();
        foreach (int t in stags) {
            long x = rt.Obj_(t);
            rt.slots[(int) x, 1] = 2;
            seqs.Append(HEX(HashValue(rt, x))).Append(',');
        }
        o.Append("seqs=").Append(seqs).Append(' ');

        long op = rt.Obj_(Obj.TyOpaque);
        rt.slots[(int) op, 1] = Val.Fixnum(99);
        long op2 = rt.Obj_(Obj.TyOpaque);
        rt.slots[(int) op2, 1] = NIL;
        o.Append("op=").Append(HEX(HashValue(rt, op))).Append("/")
         .Append(HEX(HashValue(rt, op2))).Append(' ');

        long tb = rt.Obj_(Obj.TyTable);
        rt.slots[(int) tb, 1] = 1;
        long tb2 = rt.Obj_(Obj.TyTable);
        rt.slots[(int) tb2, 1] = 2;
        o.Append("tb=").Append(HEX(HashValue(rt, tb))).Append("/")
         .Append(HEX(HashValue(rt, tb2))).Append(' ');
        long rf = rt.Obj_(Obj.TyTableref);
        rt.slots[(int) rf, 1] = 7;
        o.Append("rf=").Append(HEX(HashValue(rt, rf))).Append(' ');

        long tg = rt.Obj_(Obj.TyTagged);
        rt.slots[(int) tg, 0] = Val.Fixnum(3);
        rt.slots[(int) tg, 1] = Val.Fixnum(4);
        o.Append("tg=").Append(HEX(HashValue(rt, tg)));
        System.Console.WriteLine(o.ToString());
    }
