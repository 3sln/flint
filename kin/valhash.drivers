    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();

        long v = rt.obj(TY_VEC);
        rt.slots[(int) v][1] = 3;
        rt.ticks = 0;
        int h1 = hashOrdered(rt, v);
        o.append("v=").append(Integer.toHexString(h1)).append(" ticks=").append(rt.ticks).append(' ');
        rt.ticks = 0;
        int h2 = hashOrdered(rt, v);
        o.append("again=").append(Integer.toHexString(h2)).append(" ticks=").append(rt.ticks)
         .append(" cached=").append(Val.isFixnum(rt.slot(v, V_HASH)) ? 1 : 0).append(' ');

        long c = rt.obj(TY_CONS);
        rt.ticks = 0;
        int h3 = hashOrdered(rt, c);
        o.append("c=").append(Integer.toHexString(h3)).append(" ticks=").append(rt.ticks).append(' ');
        rt.ticks = 0;
        int h4 = hashOrdered(rt, c);
        o.append("cagain=").append(Integer.toHexString(h4)).append(" ticks=").append(rt.ticks)
         .append(" nocache=").append(Val.isFixnum(rt.slot(c, V_HASH)) ? 1 : 0).append(' ');

        long e = rt.obj(TY_VEC);
        rt.slots[(int) e][1] = 0;
        rt.ticks = 0;
        o.append("e=").append(Integer.toHexString(hashOrdered(rt, e)))
         .append(" ticks=").append(rt.ticks).append(' ');

        long s = rt.obj(TY_VEC);
        rt.slots[(int) s][1] = 5;
        rt.budget = 2;
        rt.ticks = 0;
        int hs = hashOrdered(rt, s);
        o.append("starve=").append(Integer.toHexString(hs)).append(" ticks=").append(rt.ticks)
         .append(" uncached=").append(Val.isFixnum(rt.slot(s, V_HASH)) ? 1 : 0).append(' ');
        rt.budget = 1000;

        rt.seqn = 0;
        o.append("nil=").append(Integer.toHexString(hashOrdered(rt, NIL))).append(' ');
        rt.seqn = 3;

        long big = rt.obj(TY_VEC);
        rt.slots[(int) big][1] = 0;
        rt.setSlot(big, V_HASH, Val.fixnum(0xFFFFFFFFL));
        o.append("hi=").append(Integer.toHexString(hashOrdered(rt, big)));
        o.append(' ');
        // --- `value-hash`: every arm, and each stub names itself. ---------
        o.append("d=").append(Integer.toHexString(hashValue(rt, 0x200000000L))).append("/")
         .append(Integer.toHexString(hashValue(rt, 0x200000001L))).append(' ');
        o.append("n=").append(Integer.toHexString(hashValue(rt, NIL)))
         .append(" t=").append(Integer.toHexString(hashValue(rt, Val.TRUE)))
         .append(" f=").append(Integer.toHexString(hashValue(rt, Val.FALSE))).append(' ');
        o.append("fx=").append(Integer.toHexString(hashValue(rt, Val.fixnum(7)))).append(' ');
        o.append("is=").append(Integer.toHexString(hashValue(rt, 0x300000041L)))
         .append(" ik=").append(Integer.toHexString(hashValue(rt, 0x400000042L))).append(' ');
        o.append("other=").append(Integer.toHexString(hashValue(rt, 0x900000000L))).append(' ');

        int[] htags = { TY_STR, TY_ROPE, TY_BYTES, TY_BROPE, TY_KW, TY_SYM, TY_BIGINT,
                        TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_OTHER };
        StringBuilder tags = new StringBuilder();
        for (int t : htags) tags.append(Integer.toHexString(hashValue(rt, rt.obj(t)))).append(',');
        o.append("tags=").append(tags).append(' ');
        // Every rope takes rope-hash, and the finaliser: see the rust arm.
        long ar = rt.obj(TY_ROPE);
        long nr = rt.obj(TY_ROPE);
        o.append("ropea=").append(Integer.toHexString(hashValue(rt, ar)))
         .append(" ropeb=").append(Integer.toHexString(hashValue(rt, nr))).append(' ');
        long fr = rt.obj(TY_ROPE);
        rt.bigh[(int) fr] = 1;
        o.append("ropefold=").append(Integer.toHexString(hashValue(rt, fr))).append(' ');

        int[] stags = { TY_VEC, TY_MAPENTRY, TY_CONS, TY_EMPTY_LIST, TY_LAZYSEQ,
                        TY_VECSEQ, TY_STRSEQ, TY_RANGE };
        StringBuilder seqs = new StringBuilder();
        for (int t : stags) {
            long x = rt.obj(t);
            rt.slots[(int) x][1] = 2;
            seqs.append(Integer.toHexString(hashValue(rt, x))).append(',');
        }
        o.append("seqs=").append(seqs).append(' ');

        long op = rt.obj(TY_OPAQUE);
        rt.slots[(int) op][1] = Val.fixnum(99);
        long op2 = rt.obj(TY_OPAQUE);
        rt.slots[(int) op2][1] = NIL;
        o.append("op=").append(Integer.toHexString(hashValue(rt, op))).append("/")
         .append(Integer.toHexString(hashValue(rt, op2))).append(' ');

        long tb = rt.obj(TY_TABLE);
        rt.slots[(int) tb][1] = 1;
        long tb2 = rt.obj(TY_TABLE);
        rt.slots[(int) tb2][1] = 2;
        o.append("tb=").append(Integer.toHexString(hashValue(rt, tb))).append("/")
         .append(Integer.toHexString(hashValue(rt, tb2))).append(' ');
        long rf = rt.obj(TY_TABLEREF);
        rt.slots[(int) rf][1] = 7;
        o.append("rf=").append(Integer.toHexString(hashValue(rt, rf))).append(' ');

        long tg = rt.obj(TY_TAGGED);
        rt.slots[(int) tg][0] = Val.fixnum(3);
        rt.slots[(int) tg][1] = Val.fixnum(4);
        o.append("tg=").append(Integer.toHexString(hashValue(rt, tg)));
        System.out.println(o.toString());
    }
--csharp-pre
namespace Flint.Rt {
    // `ref-to-map` is fully qualified in the vocabulary; `table-ref` and
    // `table-count` are bare siblings, so the probe needs a `Table` in each.
    internal static class Table {
        internal static long refToMap(Probe.Rt rt, long r) {
            long m = rt.Obj_(Probe.Obj.TyArraymap);
            rt.slots[(int) m, 1] = rt.slots[(int) r, 1];
            return m;
        }
    }
}
--csharp-head
    // `hash-double` was an `internal static class Hash` in the `--csharp-pre`
    // section, because the vocabulary named `global::Flint.Rt.Hash` and a
    // class nested in `Probe` cannot answer to that. It is a bare sibling
    // now, so it is an ordinary method here.
    internal static int HashDouble(double d) { return double.IsNaN(d) ? 7 : (int) (long) d; }
    internal const long NIL = 0xFFFFL;
    internal static class Obj {
        internal const int TyVec = 10, TyCons = 11, TyOther = 12;
        internal const int TyStr = 13, TyRope = 14, TyKw = 15, TySym = 16;
        internal const int TyBigint = 17, TyMapentry = 18, TyEmptyList = 19;
        internal const int TyLazyseq = 20, TyVecseq = 21, TyStrseq = 22;
        internal const int TyRange = 23, TyArraymap = 24, TyHashmap = 25;
        internal const int TySet = 26, TyBytes = 27, TyBrope = 28;
        internal const int TyOpaque = 29, TyTable = 30, TyTableref = 31;
        internal const int TyTagged = 32;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal const int V_HASH = 0;
    internal static class Val {
        internal const long Nil = Probe.NIL;
        internal static bool IsHeap(long v) { return v >= 100 && v < 0x10000000L && v != NIL; }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
        internal const long True = 0x2001L, False = 0x2002L;
        internal static bool IsFixnum(long v) { return (v >> 32) == 1; }
        internal static bool IsDouble(long v) { return (v >> 32) == 2; }
        internal static bool IsInlineStr(long v) { return (v >> 32) == 3; }
        internal static bool IsInlineKw(long v) { return (v >> 32) == 4; }
        internal static long AsFixnum(long v) { return v & 0xFFFFFFFFL; }
        internal static long Fixnum(long n) { return 0x100000000L | (n & 0xFFFFFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[400]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal long[,] slots = new long[400, 2];
        internal int[] bigh = new int[400];
        internal int budget = 1000, ticks = 0, seqn = 3;
        internal double[] doubles = { 1.5, double.NaN, 0.0 };
        internal System.Collections.Generic.List<long> roots = new System.Collections.Generic.List<long>();
        internal int Mark() { return roots.Count; }
        internal int Push(long v) { roots.Add(v); return roots.Count - 1; }
        internal long R(int i) { return roots[i]; }
        internal void SetR(int i, long v) { roots[i] = v; }
        internal void PopTo(int n) { while (roots.Count > n) roots.RemoveAt(roots.Count - 1); }
        internal long Slot(long v, int i) { return slots[(int) v, i]; }
        internal void SetSlot(long a, int i, long x) { slots[(int) a, i] = x; }
        internal long Obj_(int t) {
            long a = bump; bump += 1;
            gc.sp.m[(int) a] = (byte) t;
            slots[(int) a, 0] = 0; slots[(int) a, 1] = 0;
            return a;
        }
        internal bool ChargeTick(long n, long c, string why) {
            ticks++; budget--; return budget >= 0;
        }
    }
    internal static int OrderedStep(int acc, int h) { return acc * 31 + h; }
    internal static int MixCollHash(int acc, int n) { return acc ^ unchecked(n * (int) 0x9E3779B9); }
    internal static string HEX(int h) { return h.ToString("x"); }
    internal static int HashLong(long n) { return (int) (n ^ (long) ((ulong) n >> 32)); }
    internal static int HashInt(int h) { return h ^ (int) ((uint) h >> 16); }
    internal const int HashTrue = 1231, HashFalse = 1237;
    internal static class Str {
        internal static int StringHash(Rt rt, long v) { return 0x5100 | (int) (v & 0xFF); }
        internal static int KeywordHash(Rt rt, long v) { return 0x5200 | (int) (v & 0xFF); }
    }
    internal static int SymbolHash(Rt rt, long v) { return 0x5300 | (int) (v & 0xFF); }
    // A raw hash wider than 16 bits for a marked rope: see the rust arm.
    internal static int RopeHash(Rt rt, long v) {
        return rt.bigh[(int) v] != 0 ? (0x54000000 | (int) (v & 0xFF))
                                     : (0x5400 | (int) (v & 0xFF));
    }
    internal static int JavaStringHash(Rt rt, long v) { return 0x7700 | (int) (v & 0xFF); }
    internal static int BHash(Rt rt, long v) { return 0x5500 | (int) (v & 0xFF); }
    internal static class Maps { internal static int Hash(Rt rt, long v) { return 0x5600 | (int) (v & 0xFF); } }
    internal static int HashMap(Rt rt, long v) { return Maps.Hash(rt, v); }
    internal static class Sets { internal static int Hash(Rt rt, long v) { return 0x5700 | (int) (v & 0xFF); } }
    internal static int HashSet(Rt rt, long v) { return Sets.Hash(rt, v); }
    internal static class Num {
        internal static double F64(Rt rt, long v) { return rt.doubles[(int) (v & 0xFF)]; }
        internal static long I64Of(Rt rt, long v) { return v & 0xFFFF; }
    }
    internal static class Table {
        internal static int tableCount(Rt rt, long t) { return 2; }
        internal static long tableRef(Rt rt, long t, int i) {
            rt.bump += 1;
            return Val.Fixnum(rt.slots[(int) t, 1] * 100 + i);
        }
    }
    internal static long TableRef(Rt rt, long t, int i) { return Table.tableRef(rt, t, i); }
    internal static int TableCount(Rt rt, long t) { return Table.tableCount(rt, t); }
    internal static long Seq(Rt rt, long c) {
        int n = (Val.IsHeap(c) && Obj.Ty(rt.gc.sp, Val.AsHeap(c)) == Obj.TyVec)
                ? (int) rt.slots[(int) c, 1] : rt.seqn;
        return n == 0 ? NIL : 0xC000L + n;
    }
    internal static long First(Rt rt, long s) { return Val.Fixnum(s - 0xC000L); }
    internal static long Next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
    internal static int VecCount(Rt rt, long v) { return (int) rt.slots[(int) v, 1]; }
    internal static class Vec {
        internal static long Nth(Rt rt, long v, int i, long dflt) {
            int n = VecCount(rt, v);
            return i >= n ? dflt : Val.Fixnum(n - i);
        }
    }
    internal static long VecNth(Rt rt, long v, int i, long dflt) { return Vec.Nth(rt, v, i, dflt); }
--csharp
    public static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();

        long v = rt.Obj_(Obj.TyVec);
        rt.slots[(int) v, 1] = 3;
        rt.ticks = 0;
        int h1 = HashOrdered(rt, v);
        o.Append("v=").Append(h1.ToString("x")).Append(" ticks=").Append(rt.ticks).Append(' ');
        rt.ticks = 0;
        int h2 = HashOrdered(rt, v);
        o.Append("again=").Append(h2.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" cached=").Append(Val.IsFixnum(rt.Slot(v, V_HASH)) ? 1 : 0).Append(' ');

        long c = rt.Obj_(Obj.TyCons);
        rt.ticks = 0;
        int h3 = HashOrdered(rt, c);
        o.Append("c=").Append(h3.ToString("x")).Append(" ticks=").Append(rt.ticks).Append(' ');
        rt.ticks = 0;
        int h4 = HashOrdered(rt, c);
        o.Append("cagain=").Append(h4.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" nocache=").Append(Val.IsFixnum(rt.Slot(c, V_HASH)) ? 1 : 0).Append(' ');

        long e = rt.Obj_(Obj.TyVec);
        rt.slots[(int) e, 1] = 0;
        rt.ticks = 0;
        o.Append("e=").Append(HashOrdered(rt, e).ToString("x"))
         .Append(" ticks=").Append(rt.ticks).Append(' ');

        long s = rt.Obj_(Obj.TyVec);
        rt.slots[(int) s, 1] = 5;
        rt.budget = 2;
        rt.ticks = 0;
        int hs = HashOrdered(rt, s);
        o.Append("starve=").Append(hs.ToString("x")).Append(" ticks=").Append(rt.ticks)
         .Append(" uncached=").Append(Val.IsFixnum(rt.Slot(s, V_HASH)) ? 1 : 0).Append(' ');
        rt.budget = 1000;

        rt.seqn = 0;
        o.Append("nil=").Append(HashOrdered(rt, NIL).ToString("x")).Append(' ');
        rt.seqn = 3;

        long big = rt.Obj_(Obj.TyVec);
        rt.slots[(int) big, 1] = 0;
        rt.SetSlot(big, V_HASH, Val.Fixnum(0xFFFFFFFFL));
        o.Append("hi=").Append(HashOrdered(rt, big).ToString("x"));
        o.Append(' ');
        // --- `value-hash`: every arm, and each stub names itself. ---------
        o.Append("d=").Append(HEX(HashValue(rt, 0x200000000L))).Append("/")
         .Append(HEX(HashValue(rt, 0x200000001L))).Append(' ');
        o.Append("n=").Append(HEX(HashValue(rt, NIL)))
         .Append(" t=").Append(HEX(HashValue(rt, Val.True)))
         .Append(" f=").Append(HEX(HashValue(rt, Val.False))).Append(' ');
        o.Append("fx=").Append(HEX(HashValue(rt, Val.Fixnum(7)))).Append(' ');
        o.Append("is=").Append(HEX(HashValue(rt, 0x300000041L)))
         .Append(" ik=").Append(HEX(HashValue(rt, 0x400000042L))).Append(' ');
        o.Append("other=").Append(HEX(HashValue(rt, 0x900000000L))).Append(' ');

        int[] htags = { Obj.TyStr, Obj.TyRope, Obj.TyBytes, Obj.TyBrope, Obj.TyKw, Obj.TySym, Obj.TyBigint,
                        Obj.TyArraymap, Obj.TyHashmap, Obj.TySet, Obj.TyOther };
        var tags = new System.Text.StringBuilder();
        foreach (int t in htags) tags.Append(HEX(HashValue(rt, rt.Obj_(t)))).Append(',');
        o.Append("tags=").Append(tags).Append(' ');
        // Every rope takes rope-hash, and the finaliser: see the rust arm.
        long ar = rt.Obj_(Obj.TyRope);
        long nr = rt.Obj_(Obj.TyRope);
        o.Append("ropea=").Append(HashValue(rt, ar).ToString("x"))
         .Append(" ropeb=").Append(HashValue(rt, nr).ToString("x")).Append(' ');
        long fr = rt.Obj_(Obj.TyRope);
        rt.bigh[(int) fr] = 1;
        o.Append("ropefold=").Append(HashValue(rt, fr).ToString("x")).Append(' ');

        int[] stags = { Obj.TyVec, Obj.TyMapentry, Obj.TyCons, Obj.TyEmptyList, Obj.TyLazyseq,
                        Obj.TyVecseq, Obj.TyStrseq, Obj.TyRange };
        var seqs = new System.Text.StringBuilder();
        foreach (int t in stags) {
            long x = rt.Obj_(t);
            rt.slots[(int) x, 1] = 2;
            seqs.Append(HEX(HashValue(rt, x))).Append(',');
        }
        o.Append("seqs=").Append(seqs).Append(' ');

        long op = rt.Obj_(Obj.TyOpaque);
        rt.slots[(int) op, 1] = Val.Fixnum(99);
        long op2 = rt.Obj_(Obj.TyOpaque);
        rt.slots[(int) op2, 1] = NIL;
        o.Append("op=").Append(HEX(HashValue(rt, op))).Append("/")
         .Append(HEX(HashValue(rt, op2))).Append(' ');

        long tb = rt.Obj_(Obj.TyTable);
        rt.slots[(int) tb, 1] = 1;
        long tb2 = rt.Obj_(Obj.TyTable);
        rt.slots[(int) tb2, 1] = 2;
        o.Append("tb=").Append(HEX(HashValue(rt, tb))).Append("/")
         .Append(HEX(HashValue(rt, tb2))).Append(' ');
        long rf = rt.Obj_(Obj.TyTableref);
        rt.slots[(int) rf, 1] = 7;
        o.Append("rf=").Append(HEX(HashValue(rt, rf))).Append(' ');

        long tg = rt.Obj_(Obj.TyTagged);
        rt.slots[(int) tg, 0] = Val.Fixnum(3);
        rt.slots[(int) tg, 1] = Val.Fixnum(4);
        o.Append("tg=").Append(HEX(HashValue(rt, tg)));
        System.Console.WriteLine(o.ToString());
    }
--expect
v=daa612ca ticks=3 again=daa612ca ticks=0 cached=1 c=daa612ca ticks=3 cagain=daa612ca ticks=3 nocache=0 e=1 ticks=0 starve=0 ticks=3 uncached=0 nil=1 hi=ffffffff d=1/7 n=0 t=4cf f=4d5 fx=7 is=5141 ik=5242 other=0 tags=5169,546a,556b,556c,526d,536e,6f,5670,5671,5772,51ed51e1, ropea=5474 ropeb=5475 ropefold=54005476 seqs=3c6ef772,daa612ca,daa612ca,daa612ca,daa612ca,daa612ca,daa612ca,daa612ca, op=63/0 tb=1040/1cc0 rf=5688 tg=61
--expect-why
DERIVED BY TRANSCRIBING `valhash.kin` INTO PYTHON and running it against this
file's fixture -- a FOURTH implementation, in a language none of the three
targets is, so an error shared by all three generated copies has nowhere to
hide. The model is `scratchpad/valhash_model.py` in the session that wrote
this; every number below was also checked by hand.

THE TWO WALKS AGREE, which is the file's whole claim. `v` is a plain vector
and takes the INDEXED loop; `c` is a cons and takes the SEQ walk. The fixture
makes both see fixnum(3), fixnum(2), fixnum(1) on purpose, so:

  acc = ((1*31 + 3)*31 + 2)*31 + 1 = 32737
  mix-coll-hash(32737, 3) = 32737 ^ (3 * 0x9E3779B9) = 0xDAA612CA

and `v`, `c`, `cagain` and seven of the eight `seqs` are all that number. Two
walks that disagreed would show here as two different hashes for the same
content -- which is exactly what "both ports had TWO" means, and what no
cross-target comparison could report.

TICKS ARE THE OTHER HALF, and the half the ports were missing:

  ticks=3   the first hash of a 3-element vector charges ONCE PER ELEMENT
  ticks=0   the second reads the cache and charges NOTHING; cached=1
  ticks=3   a cons charges again every time, because nocache=0 -- a seq has
            nowhere to put the answer
  e=1 ticks=0    an empty vector never enters the loop: mix-coll-hash(1, 0)
                 is 1 ^ 0 = 1, and n=0 elements is 0 ticks. Not n+1: the loop
                 checks the END FIRST and charges after.
  starve=0 ticks=3 uncached=0
                 budget 2 over 5 elements. The third tick is REFUSED, the
                 answer is 0, and NOTHING is written to the cache -- a
                 half-computed hash must never be cached, and `uncached=0`
                 is the field that says so.

  nil=1     a non-heap value has no slot and no seq; it must not index the
            type array with something that is not an address.
  hi=ffffffff  THE CACHE ROUND-TRIPS BIT 31. Stored and read back as the same
            32 bits, whichever way the target spells a signed int.

EVERY ARM OF `hash-value`, each stub naming itself in its high bits:

  d=1/7        a double by its NUMBER: doubles[0]=1.5 hashes as (long)1.5 = 1,
               and NaN as the stub's 7 -- NOT by its bits, which is what makes
               `hash` agree with `=` about NaN
  n=0          nil
  t=4cf f=4d5  1231 and 1237, Boolean.hashCode
  fx=7         hash-long(7)
  is=5141      inline string  -> string-hash  0x5100|0x41
  ik=5242      inline keyword -> keyword-hash 0x5200|0x42
  other=0      a value that is neither immediate nor on the heap

  tags=        STR 0x5169, ROPE 0x546a, BYTES 0x556b, BROPE 0x556c,
               KW 0x526d, SYM 0x536e, BIGINT 0x6f, ARRAYMAP 0x5670,
               HASHMAP 0x5671, SET 0x5772, OTHER 0x51ed51e1

  BYTES AND BROPE BOTH SHOW 0x55xx -- one walk for both tiers, where native
  had an inline byte walk for the flat case and `b-hash` for the tree.
  ARRAYMAP and HASHMAP both show 0x56xx: two map tiers, one hash.
  BIGINT is 0x6f = 111, its own address through `hash-long`, so it is the
  NUMBER tier and not a per-type constant.
  OTHER is `hash-int(0x51ed0000 | 12)`: the per-type fallback for functions,
  atoms and vars, which are only ever `=` to themselves.

  op=63/0      an opaque value hashes its STORED id: 99 = 0x63. One without
               falls back to 0 and NOT to the per-type constant, because the
               point of the type is a distinct key per value.
  tb=1040/1cc0 a table is COLUMNAR: rows 100,101 fold to 4162, xor 2 = 4160;
               rows 200,201 fold to 7362, xor 2 = 7360. Two tables differing
               only in content must differ here.
  rf=5688      a REF hashes AS THE MAP IT IS -- 0x56xx, the arraymap stub --
               or a map keyed by a row would not find it. The low byte is the
               REF's ADDRESS: it was 0x87 and became 0x88 when `ropefold` added
               one allocation above it. Every 0x..xx field here carries an
               address in its low byte, so inserting a row shifts the ones after
               it -- derivable, but worth knowing before reading a diff.
  tg=61        a tagged literal hashes BOTH HALVES through the final mix:
               hash-int(3*31 + 4) = 97. That mix is the one both ports
               dropped, which made a tagged literal hash differently on wasm
               than on the JVM and the CLR. Without it this field is 97 too --
               so what the field really pins is 3*31+4 and not 4*31+3 or
               3+4.

  ropea=5474 ropeb=5475
               TWO ROPES, BOTH THROUGH `rope-hash`, which is the whole claim.
               These were `ropeascii` and `ropewide`, labelled "an ASCII rope
               must take `rope-hash` (0x54xx) and a non-ASCII one
               `java-string-hash` (0x77xx)" -- a two-walk arrangement the
               source's own "ONE WALK FOR EVERY TIER" block says was REMOVED.
               Both printed 0x54xx, and the pair tested nothing about routing:
               `valhash.kin` routes TY_ROPE unconditionally, and `s-ascii` was
               imported and never called. THE IMPORT IS GONE as of 2026-09-26,
               so routing cannot come back without the ns changing, and the
               names no longer claim a distinction the code does not make. The
               two differ only by address; 0x77xx in either is still the signal.
  ropefold=54005476
               THE FINALISER ON THE ROPE ARM, which no field could see. The
               source is `(hash-int (to-i32 (to-i64 (rope-hash rt v))))` and
               `hash-int` is `h ^ (h >> 16)` -- the IDENTITY for anything under
               0x10000, which is every other stub in this probe. So dropping
               `hash-int` here changed nothing observable, on the one arm whose
               own comment says it must not be dropped: without it a rope and an
               equal flat string hash differently, and two values that are `=`
               must hash alike or a map keyed by one is not found by the other.
               `rope-hash` now answers 0x54000000 | addr for a rope the fixture
               marks in `bigh`, so the fold is visible: 0x54000076 ^ 0x00005400
               = 0x54005476. Without the finaliser the field reads 54000076.
