--rust-head
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_VEC: u8 = 10; const TY_CONS: u8 = 11; const TY_OTHER: u8 = 12;
const TY_STR: u8 = 13; const TY_ROPE: u8 = 14; const TY_KW: u8 = 15;
const TY_SYM: u8 = 16; const TY_BIGINT: u8 = 17; const TY_MAPENTRY: u8 = 18;
const TY_EMPTY_LIST: u8 = 19; const TY_LAZYSEQ: u8 = 20; const TY_VECSEQ: u8 = 21;
const TY_STRSEQ: u8 = 22; const TY_RANGE: u8 = 23; const TY_ARRAYMAP: u8 = 24;
const TY_HASHMAP: u8 = 25; const TY_SET: u8 = 26; const TY_BYTES: u8 = 27;
const TY_BROPE: u8 = 28; const TY_OPAQUE: u8 = 29; const TY_TABLE: u8 = 30;
const TY_TABLEREF: u8 = 31; const TY_TAGGED: u8 = 32;
const TRUE: Value = Value(0x2001); const FALSE: Value = Value(0x2002);
const HASH_TRUE: u32 = 1231; const HASH_FALSE: u32 = 1237;
const V_HASH: u32 = 0;
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
// `budget` is how many ticks the walk may take before it starves, which is
// the half both ports were missing for a vector: they charged nothing there.
struct Rt { gc: Gc, bump: u64, roots: Vec<Value>, slots: Vec<[u64; 2]>,
            budget: i32, ticks: u32, seqn: u32, doubles: Vec<f64>,
            bigh: Vec<u8>, jsh: u32 }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 < 0x1000_0000 && self.0 != NIL.0 }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn is_fixnum(self) -> bool { (self.0 >> 32) == 1 }
    fn is_double(self) -> bool { (self.0 >> 32) == 2 }
    fn is_inline_str(self) -> bool { (self.0 >> 32) == 3 }
    fn is_inline_kw(self) -> bool { (self.0 >> 32) == 4 }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value(0x1_0000_0000u64 | (n as u64 & 0xFFFF_FFFF)) }
}
fn ordered_step(acc: u32, h: u32) -> u32 { acc.wrapping_mul(31).wrapping_add(h) }
fn mix_coll_hash(acc: u32, n: u32) -> u32 { acc ^ (n.wrapping_mul(0x9E37_79B9)) }
fn hash_long(n: i64) -> u32 { (n as u64 ^ ((n as u64) >> 32)) as u32 }
fn hash_int(h: u32) -> u32 { h ^ (h >> 16) }
// `hash-double` IS A SIBLING NOW, from `kin/hashtext.kin`, so it is called
// bare and the `pub mod hash { }` wrapper the probe used to need is gone.
fn hash_double(d: f64) -> u32 { if d.is_nan() { 7 } else { (d as i64) as u32 } }
impl Rt {
    // A NON-ASCII TREE takes the UTF-16 walk; the probe answers both by
    // inspection so the ROUTING is what is under test, not the arithmetic
    // (which `kin/strhash.drivers` pins against canonical Clojure).
    fn java_string_hash(&mut self, v: Value) -> u32 { 0x7700 | (v.0 as u32 & 0xFF) }
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn set_r(&mut self, i: usize, v: Value) { self.roots[i] = v; }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.slots[v.0 as usize][i as usize]) }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.slots[v.0 as usize][i as usize] = x.0; }
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 1;
        self.gc.sp.m[a as usize] = t;
        self.slots[a as usize] = [0u64; 2];
        Value(a)
    }
    fn charge_tick(&mut self, _n: u64, _c: u64, _why: &str) -> bool {
        self.ticks += 1;
        self.budget -= 1;
        self.budget >= 0
    }
    // Each element hashes to its own position, so a walk that stops early or
    // charges differently shows up in the answer rather than only the count.
    // Each stub NAMES ITSELF in the high bits, so which arm ran is visible in
    // the answer rather than only in whether it was right.
    fn num_f64(&mut self, v: Value) -> f64 { self.doubles[(v.0 & 0xFF) as usize] }
    fn string_hash(&mut self, v: Value) -> u32 { 0x5100 | (v.0 & 0xFF) as u32 }
    fn keyword_hash(&mut self, v: Value) -> u32 { 0x5200 | (v.0 & 0xFF) as u32 }
    fn symbol_hash(&mut self, v: Value) -> u32 { 0x5300 | (v.0 & 0xFF) as u32 }
    // A RAW HASH WIDER THAN 16 BITS for a rope the fixture marks, so the
    // `hash-int` finaliser on the TY_ROPE arm has something to fold. Every
    // other stub answers under 0x10000, where `h ^ (h >> 16)` is the identity
    // and the finaliser is invisible.
    fn rope_hash(&mut self, v: Value) -> u32 {
        if self.bigh[v.0 as usize] != 0 { 0x5400_0000 | (v.0 & 0xFF) as u32 }
        else { 0x5400 | (v.0 & 0xFF) as u32 }
    }
    fn b_hash(&mut self, v: Value) -> u32 { 0x5500 | (v.0 & 0xFF) as u32 }
    fn hash_map(&mut self, v: Value) -> u32 { 0x5600 | (v.0 & 0xFF) as u32 }
    fn hash_set(&mut self, v: Value) -> u32 { 0x5700 | (v.0 & 0xFF) as u32 }
    fn i64_of(&mut self, v: Value) -> i64 { (v.0 & 0xFFFF) as i64 }
    fn table_count(&mut self, _t: Value) -> u32 { 2 }
    fn table_ref(&mut self, t: Value, i: u32) -> Value {
        self.bump += 1;
        Value::fixnum((self.slots[t.0 as usize][1] * 100 + i as u64) as i64)
    }
    fn ref_to_map(&mut self, r: Value) -> Value {
        let m = self.obj(TY_ARRAYMAP);
        self.slots[m.0 as usize][1] = self.slots[r.0 as usize][1];
        m
    }
    fn seq(&mut self, c: Value) -> Value {
        let n = if c.is_heap() && ty(&self.gc.sp, c.as_heap()) == TY_VEC {
            self.slots[c.0 as usize][1] as u32
        } else { self.seqn };
        if n == 0 { NIL } else { Value(0xC000 + n as u64) }
    }
    fn vec_count(&mut self, v: Value) -> u32 { self.slots[v.0 as usize][1] as u32 }
    // AGREEING WITH `first` BY CONSTRUCTION: the seq walk sees fixnum(n - i)
    // at index `i`, so the indexed read gives the same. Spelling it otherwise
    // would hash different data down the two paths and prove nothing about
    // them agreeing.
    fn vec_nth(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        let n = self.vec_count(v);
        if i >= n { dflt } else { Value::fixnum((n - i) as i64) }
    }
    fn first(&mut self, s: Value) -> Value { Value::fixnum((s.0 - 0xC000) as i64) }
    fn next(&mut self, s: Value) -> Value {
        if s.0 == 0xC001 { NIL } else { Value(s.0 - 1) }
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 400] } }, bump: 100,
                      roots: Vec::new(), slots: vec![[0u64; 2]; 400],
                      budget: 1000, ticks: 0, seqn: 3,
                      doubles: vec![1.5, f64::NAN, 0.0] , bigh: vec![0; 400], jsh: 0 };
    let mut o = String::new();

    // A VECTOR IS WALKED, CHARGED and CACHED. The charge is the half both
    // ports were missing for this shape.
    let v = rt.obj(TY_VEC);
    rt.slots[v.0 as usize][1] = 3;
    rt.ticks = 0;
    let h1 = rt.hash_ordered(v);
    o.push_str(&format!("v={:x} ticks={} ", h1, rt.ticks));
    // ... and the SECOND call reads the cache: no ticks at all.
    rt.ticks = 0;
    let h2 = rt.hash_ordered(v);
    o.push_str(&format!("again={:x} ticks={} cached={} ", h2, rt.ticks,
                        rt.slot(v, V_HASH).is_fixnum() as u32));

    // A SEQ has nowhere to cache, so it walks and charges every time.
    let c = rt.obj(TY_CONS);
    rt.ticks = 0;
    let h3 = rt.hash_ordered(c);
    o.push_str(&format!("c={:x} ticks={} ", h3, rt.ticks));
    rt.ticks = 0;
    let h4 = rt.hash_ordered(c);
    o.push_str(&format!("cagain={:x} ticks={} nocache={} ", h4, rt.ticks,
                        rt.slot(c, V_HASH).is_fixnum() as u32));

    // AN EMPTY ONE is the walk that never enters its body.
    let e = rt.obj(TY_VEC);
    rt.slots[e.0 as usize][1] = 0;
    rt.ticks = 0;
    o.push_str(&format!("e={:x} ticks={} ", rt.hash_ordered(e), rt.ticks));

    // STARVED: the tick refuses and the answer is 0, with nothing cached.
    let s = rt.obj(TY_VEC);
    rt.slots[s.0 as usize][1] = 5;
    rt.budget = 2;
    rt.ticks = 0;
    let hs = rt.hash_ordered(s);
    o.push_str(&format!("starve={:x} ticks={} uncached={} ", hs, rt.ticks,
                        rt.slot(s, V_HASH).is_fixnum() as u32));
    rt.budget = 1000;

    // A NON-HEAP value has no slot to ask about and no seq: it must not index
    // the type array with something that is not an address.
    rt.seqn = 0;
    o.push_str(&format!("nil={:x} ", rt.hash_ordered(NIL)));
    rt.seqn = 3;

    // THE CACHE ROUND-TRIPS A HIGH BIT. A hash with bit 31 set is stored and
    // read back as the same 32 bits, whichever way the target spells it.
    let big = rt.obj(TY_VEC);
    rt.slots[big.0 as usize][1] = 0;
    rt.set(big, V_HASH, Value::fixnum(0xFFFF_FFFFu32 as i64));
    o.push_str(&format!("hi={:x} ", rt.hash_ordered(big)));

    // --- `value-hash`: every arm, and each stub names itself. -------------
    // The IMMEDIATES first: a double by its NUMBER (so NaN is not its bits),
    // nil, the two booleans, a fixnum, and the two inline tiers.
    o.push_str(&format!("d={:x}/{:x} ", rt.hash_value(Value(0x2_0000_0000)),
                        rt.hash_value(Value(0x2_0000_0001))));
    o.push_str(&format!("n={:x} t={:x} f={:x} ", rt.hash_value(NIL),
                        rt.hash_value(TRUE), rt.hash_value(FALSE)));
    o.push_str(&format!("fx={:x} ", rt.hash_value(Value::fixnum(7))));
    o.push_str(&format!("is={:x} ik={:x} ", rt.hash_value(Value(0x3_0000_0041)),
                        rt.hash_value(Value(0x4_0000_0042))));
    o.push_str(&format!("other={:x} ", rt.hash_value(Value(0x9_0000_0000))));

    // The HEAP tags, each to its own stub.
    let mut tags = String::new();
    for t in [TY_STR, TY_ROPE, TY_BYTES, TY_BROPE, TY_KW, TY_SYM, TY_BIGINT,
              TY_ARRAYMAP, TY_HASHMAP, TY_SET, TY_OTHER] {
        let x = rt.obj(t);
        tags.push_str(&format!("{:x},", rt.hash_value(x)));
    }
    o.push_str(&format!("tags={} ", tags));

    // EVERY ROPE TAKES `rope-hash`, AND THAT IS THE WHOLE CLAIM. These two
    // fields were labelled "an ASCII rope must take `rope-hash` (0x54xx) and a
    // non-ASCII one `java-string-hash` (0x77xx)", which described a two-walk
    // arrangement the source's own "ONE WALK FOR EVERY TIER" block says was
    // REMOVED -- so both printed 0x54xx and the pair tested nothing about
    // routing. `s-ascii` was imported by `valhash.kin` and never called; the
    // import is gone now, so routing cannot come back without the ns changing.
    // Two ropes remain because 0x77xx appearing in either would still be the
    // signal, and they differ only by address.
    let ar = rt.obj(TY_ROPE);
    let nr = rt.obj(TY_ROPE);
    o.push_str(&format!("ropea={:x} ropeb={:x} ",
                        rt.hash_value(ar), rt.hash_value(nr)));
    // THE FINALISER ON THE ROPE ARM. `(hash-int (to-i32 (to-i64 (rope-hash ..))))`
    // -- and every other stub in this probe answers under 0x10000, where
    // `h ^ (h >> 16)` is the IDENTITY. So no field could tell the finaliser from
    // its absence, and the source says that is the one thing on this arm that
    // must not be dropped: without it a rope and an equal flat string hash
    // differently, which breaks the rule that two `=` values hash alike.
    let fr = rt.obj(TY_ROPE);
    rt.bigh[fr.0 as usize] = 1;
    o.push_str(&format!("ropefold={:x} ", rt.hash_value(fr)));

    // EVERY SEQUENTIAL TAG goes to the ordered walk, which is the agreement
    // `val-eq` needs: `=` treats them as one category, so `hash` must too.
    let mut seqs = String::new();
    for t in [TY_VEC, TY_MAPENTRY, TY_CONS, TY_EMPTY_LIST, TY_LAZYSEQ,
              TY_VECSEQ, TY_STRSEQ, TY_RANGE] {
        let x = rt.obj(t);
        rt.slots[x.0 as usize][1] = 2;
        seqs.push_str(&format!("{:x},", rt.hash_value(x)));
    }
    o.push_str(&format!("seqs={} ", seqs));

    // AN OPAQUE VALUE hashes its stored id, and one without falls back to 0
    // rather than to the per-type constant -- the whole point is a distinct
    // key per value.
    let op = rt.obj(TY_OPAQUE);
    rt.slots[op.0 as usize][1] = Value::fixnum(99).0;
    let op2 = rt.obj(TY_OPAQUE);
    rt.slots[op2.0 as usize][1] = NIL.0;
    o.push_str(&format!("op={:x}/{:x} ", rt.hash_value(op), rt.hash_value(op2)));

    // A TABLE is columnar and a REF hashes as the map it is.
    let tb = rt.obj(TY_TABLE);
    rt.slots[tb.0 as usize][1] = 1;
    let tb2 = rt.obj(TY_TABLE);
    rt.slots[tb2.0 as usize][1] = 2;
    o.push_str(&format!("tb={:x}/{:x} ", rt.hash_value(tb), rt.hash_value(tb2)));
    let rf = rt.obj(TY_TABLEREF);
    rt.slots[rf.0 as usize][1] = 7;
    o.push_str(&format!("rf={:x} ", rt.hash_value(rf)));

    // A TAGGED literal hashes BOTH HALVES through the final mix -- the mix
    // both ports dropped.
    let tg = rt.obj(TY_TAGGED);
    rt.slots[tg.0 as usize][0] = Value::fixnum(3).0;
    rt.slots[tg.0 as usize][1] = Value::fixnum(4).0;
    o.push_str(&format!("tg={:x}", rt.hash_value(tg)));
    println!("{}", o);
}
--java-head
    static final long NIL = 0xFFFFL;
    static final int TY_VEC = 10, TY_CONS = 11, TY_OTHER = 12;
    static final int TY_STR = 13, TY_ROPE = 14, TY_KW = 15, TY_SYM = 16;
    static final int TY_BIGINT = 17, TY_MAPENTRY = 18, TY_EMPTY_LIST = 19;
    static final int TY_LAZYSEQ = 20, TY_VECSEQ = 21, TY_STRSEQ = 22;
    static final int TY_RANGE = 23, TY_ARRAYMAP = 24, TY_HASHMAP = 25;
    static final int TY_SET = 26, TY_BYTES = 27, TY_BROPE = 28;
    static final int TY_OPAQUE = 29, TY_TABLE = 30, TY_TABLEREF = 31;
    static final int TY_TAGGED = 32;
    static final int HASH_TRUE = 1231, HASH_FALSE = 1237;
    static final int V_HASH = 0;
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v < 0x10000000L && v != NIL; }
        static long asHeap(long v) { return v; }
        static boolean isNil(long v) { return v == NIL; }
        static final long TRUE = 0x2001L, FALSE = 0x2002L;
        static boolean isFixnum(long v) { return (v >>> 32) == 1; }
        static boolean isDouble(long v) { return (v >>> 32) == 2; }
        static boolean isInlineStr(long v) { return (v >>> 32) == 3; }
        static boolean isInlineKw(long v) { return (v >>> 32) == 4; }
        static long asFixnum(long v) { return v & 0xFFFFFFFFL; }
        static long fixnum(long n) { return 0x100000000L | (n & 0xFFFFFFFFL); }
    }
    static final class Space { byte[] m = new byte[400]; }
    static final class Rt {
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        long bump = 100;
        long[][] slots = new long[400][2];
        int[] bigh = new int[400];
        int budget = 1000, ticks = 0, seqn = 3;
        double[] doubles = { 1.5, Double.NaN, 0.0 };
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void setR(int i, long v) { roots.set(i, v); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long slot(long v, int i) { return slots[(int) v][i]; }
        void setSlot(long a, int i, long x) { slots[(int) a][i] = x; }
        long obj(int t) {
            long a = bump; bump += 1;
            gc.sp.m[(int) a] = (byte) t;
            slots[(int) a] = new long[2];
            return a;
        }
        boolean chargeTick(long n, long c, String why) {
            ticks++; budget--; return budget >= 0;
        }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static int orderedStep(int acc, int h) { return acc * 31 + h; }
    static int mixCollHash(int acc, int n) { return acc ^ (n * 0x9E3779B9); }
    static int hashLong(long n) { return (int) (n ^ (n >>> 32)); }
    static int hashInt(int h) { return h ^ (h >>> 16); }
    // `hash-double` was reached through a nested `com.flint.rt.Hash` here,
    // spelled out class by class, because the vocabulary named it fully
    // qualified. It is a bare sibling now.
    static int hashDouble(double d) { return Double.isNaN(d) ? 7 : (int) (long) d; }
    static final class Str {
        static int stringHash(Rt rt, long v) { return 0x5100 | (int) (v & 0xFF); }
        static int keywordHash(Rt rt, long v) { return 0x5200 | (int) (v & 0xFF); }
    }
    static int symbolHash(Rt rt, long v) { return 0x5300 | (int) (v & 0xFF); }
    // A raw hash wider than 16 bits for a marked rope: see the rust arm.
    static int ropeHash(Rt rt, long v) {
        return rt.bigh[(int) v] != 0 ? (0x54000000 | (int) (v & 0xFF))
                                     : (0x5400 | (int) (v & 0xFF));
    }
    // The ROUTING is what this file tests; `kin/strhash.drivers` pins the
    // arithmetic against canonical Clojure. Distinct constants so the two
    // branches are told apart in the output.
    static int javaStringHash(Rt rt, long v) { return 0x7700 | (int) (v & 0xFF); }
    static int bHash(Rt rt, long v) { return 0x5500 | (int) (v & 0xFF); }
    static final class Maps { static int hash(Rt rt, long v) { return 0x5600 | (int) (v & 0xFF); } }
    static int hashMap(Rt rt, long v) { return Maps.hash(rt, v); }
    static final class Sets { static int hash(Rt rt, long v) { return 0x5700 | (int) (v & 0xFF); } }
    static int hashSet(Rt rt, long v) { return Sets.hash(rt, v); }
    static final class Num {
        static double f64(Rt rt, long v) { return rt.doubles[(int) (v & 0xFF)]; }
        static long i64Of(Rt rt, long v) { return v & 0xFFFF; }
    }
    static final class Table {
        static int tableCount(Rt rt, long t) { return 2; }
        static long tableRef(Rt rt, long t, int i) {
            rt.bump += 1;
            return Val.fixnum(rt.slots[(int) t][1] * 100 + i);
        }
        static long refToMap(Rt rt, long r) {
            long m = rt.obj(TY_ARRAYMAP);
            rt.slots[(int) m][1] = rt.slots[(int) r][1];
            return m;
        }
    }
    static int tableCount(Rt rt, long t) { return Table.tableCount(rt, t); }
    static long tableRef(Rt rt, long t, int i) { return Table.tableRef(rt, t, i); }
    static long seq(Rt rt, long c) {
        int n = (Val.isHeap(c) && ty(rt.gc.sp, Val.asHeap(c)) == TY_VEC)
                ? (int) rt.slots[(int) c][1] : rt.seqn;
        return n == 0 ? NIL : 0xC000L + n;
    }
    static int vecCount(Rt rt, long v) { return (int) rt.slots[(int) v][1]; }
    static final class Vec {
        static long nth(Rt rt, long v, int i, long dflt) {
            int n = vecCount(rt, v);
            return i >= n ? dflt : Val.fixnum(n - i);
        }
    }
    static long vecNth(Rt rt, long v, int i, long dflt) { return Vec.nth(rt, v, i, dflt); }
    static long first(Rt rt, long s) { return Val.fixnum(s - 0xC000L); }
    static long next(Rt rt, long s) { return s == 0xC001L ? NIL : s - 1; }
