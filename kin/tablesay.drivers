    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long ka = keyword(rt, "a"), kb = keyword(rt, "b"), kz = keyword(rt, "z");
        long tint = keyword(rt, "int"), tstr = keyword(rt, "string");
        long sch = schema(rt, new long[]{ka, kb}, new long[]{tint, tstr});
        o.append("kw=").append(kwName(rt, ka)).append('/').append(kwName(rt, Val.fixnum(3)))
         .append(' ');
        o.append("cols=[").append(columnList(rt, sch)).append("] ");
        rt.names.add("hi");
        long hello = Val.name(rt.names.size() - 1);
        long good = mapAssoc(rt, mapAssoc(rt, emptyMap(rt), ka, Val.fixnum(1)), kb, hello);
        o.append("good=").append(checkRow(rt, sch, good, 0) ? 1 : 0).append(' ');
        o.append("notmap=").append(checkRow(rt, sch, Val.fixnum(7), 3) ? 1 : 0)
         .append('|').append(rt.thrown).append(' ');
        long shortr = mapAssoc(rt, emptyMap(rt), ka, Val.fixnum(1));
        o.append("missing=").append(checkRow(rt, sch, shortr, 4) ? 1 : 0)
         .append('|').append(rt.thrown).append(' ');
        long wrong = mapAssoc(rt, mapAssoc(rt, emptyMap(rt), ka, hello), kb, hello);
        o.append("type=").append(checkRow(rt, sch, wrong, 5) ? 1 : 0)
         .append('|').append(rt.thrown).append(' ');
        long wide = mapAssoc(rt, mapAssoc(rt, mapAssoc(rt, emptyMap(rt), ka, Val.fixnum(1)),
                                          kb, hello), kz, Val.fixnum(9));
        o.append("extra=").append(checkRow(rt, sch, wide, 6) ? 1 : 0)
         .append('|').append(rt.thrown).append(' ');
        o.append("foreign=").append(kwName(rt, firstForeignKey(rt, sch, wide)))
         .append(" none=").append(firstForeignKey(rt, sch, good) == NIL ? 1 : 0);
        System.out.println(o.toString());
    }
