--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100, roots: Vec::new(),
                      names: Vec::new(), thrown: alloc::string::String::new() };
    let mut o = String::new();
    let ka = rt.keyword("a"); let kb = rt.keyword("b"); let kz = rt.keyword("z");
    let tint = rt.keyword("int"); let tstr = rt.keyword("string");
    let sch = rt.schema(&[ka, kb], &[tint, tstr]);
    let n1 = rt.kw_name(ka);
    let n2 = rt.kw_name(Value::fixnum(3));
    o.push_str(&format!("kw={}/{} ", n1, n2));
    let cl = rt.column_list(sch);
    o.push_str(&format!("cols=[{}] ", cl));
    let hello = Value::name(rt.names.len() as u32);
    rt.names.push(alloc::string::String::from("hi"));
    let mut good = rt.empty_map();
    good = rt.map_assoc(good, ka, Value::fixnum(1));
    good = rt.map_assoc(good, kb, hello);
    let ok = rt.check_row(sch, good, 0);
    o.push_str(&format!("good={} ", ok as u32));
    // NOT A MAP AT ALL.
    let notmap = rt.check_row(sch, Value::fixnum(7), 3);
    let m1 = rt.thrown.clone();
    o.push_str(&format!("notmap={}|{} ", notmap as u32, m1));
    // A MISSING COLUMN, and the message lists what the columns ARE.
    let mut short = rt.empty_map();
    short = rt.map_assoc(short, ka, Value::fixnum(1));
    let miss = rt.check_row(sch, short, 4);
    let m2 = rt.thrown.clone();
    o.push_str(&format!("missing={}|{} ", miss as u32, m2));
    // THE WRONG TYPE, and the message says what ARRIVED.
    let mut wrong = rt.empty_map();
    wrong = rt.map_assoc(wrong, ka, hello);
    wrong = rt.map_assoc(wrong, kb, hello);
    let bad = rt.check_row(sch, wrong, 5);
    let m3 = rt.thrown.clone();
    o.push_str(&format!("type={}|{} ", bad as u32, m3));
    // A KEY THAT IS NOT A COLUMN.
    let mut wide = rt.empty_map();
    wide = rt.map_assoc(wide, ka, Value::fixnum(1));
    wide = rt.map_assoc(wide, kb, hello);
    wide = rt.map_assoc(wide, kz, Value::fixnum(9));
    let ex = rt.check_row(sch, wide, 6);
    let m4 = rt.thrown.clone();
    o.push_str(&format!("extra={}|{} ", ex as u32, m4));
    // AND THE HUNT, which is only reached when the count disagrees.
    let foreign = rt.first_foreign_key(sch, wide);
    let fname = rt.kw_name(foreign);
    let none = rt.first_foreign_key(sch, good).is_nil() as u32;
    o.push_str(&format!("foreign={} none={}", fname, none));
    println!("{}", o);
}
