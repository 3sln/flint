--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TY_SCHEMA: u8 = 48; const TY_TABLE: u8 = 49; const TY_TABLEREF: u8 = 50;
const TY_VEC: u8 = 9; const TY_NODE: u8 = 12;
pub mod table {
    pub const SC_NAMES: u32 = 0; pub const SC_TYPES: u32 = 1; pub const SC_INDEX: u32 = 2;
    pub const SC_IDS: u32 = 3; pub const SC_WIDTH: u32 = 4; pub const SC_LEN: u32 = 5;
    pub const TB_SCHEMA: u32 = 0; pub const TB_CHUNKS: u32 = 1; pub const TB_COUNT: u32 = 2;
    pub const TB_OFFSET: u32 = 3; pub const TB_LEN: u32 = 4;
    pub const CH_ROWS: u32 = 0; pub const CH_ENC: u32 = 1; pub const CH_BASE: u32 = 2;
    pub const ENC_FLAT: u32 = 0; pub const ENC_CONST: u32 = 1;
    pub const RF_SCHEMA: u32 = 0; pub const RF_CHUNK: u32 = 1; pub const RF_ROW: u32 = 2;
    pub const RF_LEN: u32 = 3;
    pub const CHUNK: u32 = 256; pub const CHUNK_SHIFT: u32 = 8;
}
impl Value {
    fn is_heap(self) -> bool { self.0 >= 100 && self.0 != NIL.0 && (self.0 >> 60) != 0xD }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn as_fixnum(self) -> i64 { (self.0 & 0xFFFF_FFFF) as i64 }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF_FFFF)) }
    fn heap(a: Addr) -> Value { Value(a as u64) }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { h: Vec<u64>, gc: Gc, lens: Vec<u32>, bump: u64 }
impl Rt {
    fn alloc(&mut self, t: u8, n: u32) -> Addr {
        let a = self.bump; self.bump += n as u64 + 16;
        self.gc.sp.m[a as usize] = t; self.lens[a as usize] = n;
        for i in 0..n { self.h[a as usize + i as usize] = NIL.0; }
        a as Addr
    }
    fn set(&mut self, n: Value, i: u32, v: Value) { self.h[n.0 as usize + i as usize] = v.0; }
    fn slot(&self, n: Value, i: u32) -> Value { Value(self.h[n.0 as usize + i as usize]) }
    // A VECTOR flat enough for a schema: the probe never builds one big enough
    // to need a trie, and `vec_count`/`vec_nth` are what the source asks for.
    fn vec_count(&self, v: Value) -> u32 { self.lens[v.0 as usize] }
    fn vec_nth(&mut self, v: Value, i: u32, dflt: Value) -> Value {
        if i >= self.vec_count(v) { dflt } else { self.slot(v, i) }
    }
    // STRUCTURAL equality over the probe's vectors, because `schema-eq` is
    // about what two schemas SAY and not about which objects they are.
    fn val_eq(&mut self, a: Value, b: Value) -> bool {
        if a.0 == b.0 { return true; }
        if !a.is_heap() || !b.is_heap() { return false; }
        if ty(&self.gc.sp, a.as_heap()) != TY_VEC || ty(&self.gc.sp, b.as_heap()) != TY_VEC {
            return false;
        }
        let n = self.vec_count(a);
        if n != self.vec_count(b) { return false; }
        for i in 0..n {
            let (x, y) = (self.slot(a, i), self.slot(b, i));
            if !self.val_eq(x, y) { return false; }
        }
        true
    }
    fn vector(&mut self, xs: &[Value]) -> Value {
        let a = self.alloc(TY_VEC, xs.len().max(1) as u32);
        self.lens[a as usize] = xs.len() as u32;
        for (i, x) in xs.iter().enumerate() { self.h[a as usize + i] = x.0; }
        Value::heap(a)
    }
    fn obj(&mut self, t: u8, n: u32) -> Value { let a = self.alloc(t, n); Value::heap(a) }
}
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { h: vec![0; 40000], gc: Gc { sp: Space { m: vec![0u8; 40000] } },
                      lens: vec![0; 40000], bump: 100 };
    let mut o = String::new();
    // THE THREE KINDS, and everything that is none of them. `77` is a fixnum,
    // NIL is not heap at all, and a plain vector is heap but tagged otherwise.
    let sch = rt.obj(TY_SCHEMA, table::SC_LEN);
    let tab = rt.obj(TY_TABLE, table::TB_LEN);
    let rf = rt.obj(TY_TABLEREF, table::RF_LEN);
    let vecv = rt.vector(&[]);
    let kinds = |rt: &Rt, v: Value| -> String {
        format!("{}{}{}", rt.is_schema(v) as u32, rt.is_table(v) as u32,
                rt.is_table_ref(v) as u32)
    };
    o.push_str(&format!("kinds={}.{}.{}.{}.{}.{} ",
                        kinds(&rt, sch), kinds(&rt, tab), kinds(&rt, rf),
                        kinds(&rt, vecv), kinds(&rt, NIL), kinds(&rt, Value::fixnum(77))));
    // A SCHEMA of two columns, ids 0 and 1, width 3 -- wider than it is long,
    // which is what a migration that dropped a column leaves behind.
    let na = Value::fixnum(101); let nb = Value::fixnum(102);
    let ta = Value::fixnum(201); let tb = Value::fixnum(202);
    let names = rt.vector(&[na, nb]);
    let types = rt.vector(&[ta, tb]);
    let ids = rt.vector(&[Value::fixnum(0), Value::fixnum(1)]);
    rt.set(sch, table::SC_NAMES, names);
    rt.set(sch, table::SC_TYPES, types);
    rt.set(sch, table::SC_IDS, ids);
    rt.set(sch, table::SC_WIDTH, Value::fixnum(3));
    o.push_str(&format!("len={} width={} idat={}.{} nameat={}.{} typeat={}.{} ",
                        rt.schema_len(sch), rt.schema_width(sch),
                        rt.schema_id_at(sch, 0), rt.schema_id_at(sch, 1),
                        rt.schema_name_at(sch, 0).as_fixnum(),
                        rt.schema_name_at(sch, 1).as_fixnum(),
                        rt.schema_type_at(sch, 0).as_fixnum(),
                        rt.schema_type_at(sch, 1).as_fixnum()));
    // SCHEMA EQUALITY is structural and ORDERED: the same pairs in the other
    // order is a different schema, because the rows would read differently.
    let same = rt.obj(TY_SCHEMA, table::SC_LEN);
    let n2 = rt.vector(&[na, nb]); let t2 = rt.vector(&[ta, tb]);
    rt.set(same, table::SC_NAMES, n2); rt.set(same, table::SC_TYPES, t2);
    let swapped = rt.obj(TY_SCHEMA, table::SC_LEN);
    let n3 = rt.vector(&[nb, na]); let t3 = rt.vector(&[tb, ta]);
    rt.set(swapped, table::SC_NAMES, n3); rt.set(swapped, table::SC_TYPES, t3);
    let retyped = rt.obj(TY_SCHEMA, table::SC_LEN);
    let n4 = rt.vector(&[na, nb]); let t4 = rt.vector(&[ta, ta]);
    rt.set(retyped, table::SC_NAMES, n4); rt.set(retyped, table::SC_TYPES, t4);
    o.push_str(&format!("eq={}{}{}{} ", rt.schema_eq(sch, same) as u32,
                        rt.schema_eq(sch, swapped) as u32, rt.schema_eq(sch, retyped) as u32,
                        rt.schema_eq(sch, sch) as u32));
    // A CHUNK of three rows: column 0 flat, column 1 COLLAPSED. The collapsed
    // one answers the same value for every row, and there is nothing to index.
    let ch = rt.obj(TY_NODE, table::CH_BASE + 3);
    let enc = rt.obj(TY_NODE, 3);
    rt.set(enc, 0, Value::fixnum(table::ENC_FLAT as i64));
    rt.set(enc, 1, Value::fixnum(table::ENC_CONST as i64));
    rt.set(enc, 2, Value::fixnum(table::ENC_FLAT as i64));
    rt.set(ch, table::CH_ENC, enc);
    rt.set(ch, table::CH_ROWS, Value::fixnum(3));
    let col0 = rt.obj(TY_NODE, 3);
    for r in 0..3 { rt.set(col0, r, Value::fixnum(10 + r as i64)); }
    rt.set(ch, table::CH_BASE, col0);
    rt.set(ch, table::CH_BASE + 1, Value::fixnum(99));
    o.push_str(&format!("rows={} enc={}{} flat={}.{}.{} const={}.{}.{} ",
                        rt.chunk_rows(ch), rt.chunk_enc(ch, 0), rt.chunk_enc(ch, 1),
                        rt.chunk_get(ch, 0, 0).as_fixnum(), rt.chunk_get(ch, 0, 1).as_fixnum(),
                        rt.chunk_get(ch, 0, 2).as_fixnum(),
                        rt.chunk_get(ch, 1, 0).as_fixnum(), rt.chunk_get(ch, 1, 1).as_fixnum(),
                        rt.chunk_get(ch, 1, 2).as_fixnum()));
    // A SLICED TABLE keeps its offset; an unsliced one is at zero.
    rt.set(tab, table::TB_COUNT, Value::fixnum(7));
    rt.set(tab, table::TB_OFFSET, Value::fixnum(2));
    o.push_str(&format!("count={} offset={}", rt.table_count(tab), rt.table_offset(tab)));
    println!("{}", o);
}
--java-head
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.eq` below stays for `hash-value`'s sake and this
    // forwards to it, which keeps whatever counting each probe does.
    static boolean valEq(Rt rt, long a, long b) { return com.flint.rt.Eq.eq(rt, a, b); }
    static final long NIL = 0xFFFFL;
    static final int TY_SCHEMA = 48, TY_TABLE = 49, TY_TABLEREF = 50,
                     TY_VEC = 9, TY_NODE = 12;
    static final class Table {
        static final int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                         SC_WIDTH = 4, SC_LEN = 5;
        static final int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, TB_OFFSET = 3, TB_LEN = 4;
        static final int CH_ROWS = 0, CH_ENC = 1, CH_BASE = 2;
        static final int ENC_FLAT = 0, ENC_CONST = 1;
        static final int RF_SCHEMA = 0, RF_CHUNK = 1, RF_ROW = 2, RF_LEN = 3;
        static final int CHUNK = 256, CHUNK_SHIFT = 8;
    }
    static final class Val {
        static final long NIL = Probe.NIL;
        static boolean isHeap(long v) { return v >= 100 && v != NIL && (v >>> 60) != 0xDL; }
        static long asHeap(long v) { return v; }
        static long asFixnum(long v) { return v & 0xFFFFFFFFL; }
        static long fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFFFFFL); }
        static long heap(long a) { return a; }
        static boolean isNil(long v) { return v == NIL; }
    }
    static final class Space { byte[] m = new byte[40000]; }
    static final class Rt {
        long[] h = new long[40000];
        static final class GcT { Space sp = new Space(); }
        GcT gc = new GcT();
        int[] lens = new int[40000];
        long bump = 100;
        long alloc(int t, int n) {
            long a = bump; bump += n + 16;
            gc.sp.m[(int) a] = (byte) t; lens[(int) a] = n;
            for (int i = 0; i < n; i++) h[(int) a + i] = NIL;
            return a;
        }
        void set(long n, int i, long v) { h[(int) n + i] = v; }
        long slot(long n, int i) { return h[(int) n + i]; }
    }
    static int ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    static final class Vec {
        static int count(Rt rt, long v) { return rt.lens[(int) v]; }
        static long nth(Rt rt, long v, int i, long dflt) {
            return i >= count(rt, v) ? dflt : rt.slot(v, i);
        }
    }
    // Nested to reproduce the port's FULLY QUALIFIED `com.flint.rt.Eq` --
    // the vocabulary spells it in full because a bare `Eq` inside the
    // generated package would resolve to the GENERATED one.
    static final class com { static final class flint { static final class rt {
    static final class Eq {
        static boolean eq(Rt rt, long a, long b) {
            if (a == b) return true;
            if (!Val.isHeap(a) || !Val.isHeap(b)) return false;
            if (ty(rt.gc.sp, a) != TY_VEC || ty(rt.gc.sp, b) != TY_VEC) return false;
            int n = Vec.count(rt, a);
            if (n != Vec.count(rt, b)) return false;
            for (int i = 0; i < n; i++) if (!valEq(rt, rt.slot(a, i), rt.slot(b, i))) return false;
            return true;
        }
    }
    } } }
    static long vector(Rt rt, long[] xs) {
        long a = rt.alloc(TY_VEC, Math.max(1, xs.length));
        rt.lens[(int) a] = xs.length;
        for (int i = 0; i < xs.length; i++) rt.h[(int) a + i] = xs[i];
        return Val.heap(a);
    }
    static long obj(Rt rt, int t, int n) { return Val.heap(rt.alloc(t, n)); }
    static String kinds(Rt rt, long v) {
        return (isSchema(rt, v) ? 1 : 0) + "" + (isTable(rt, v) ? 1 : 0)
             + (isTableRef(rt, v) ? 1 : 0);
    }
--java
    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        long sch = obj(rt, TY_SCHEMA, Table.SC_LEN);
        long tab = obj(rt, TY_TABLE, Table.TB_LEN);
        long rf = obj(rt, TY_TABLEREF, Table.RF_LEN);
        long vecv = vector(rt, new long[]{});
        o.append("kinds=").append(kinds(rt, sch)).append('.').append(kinds(rt, tab))
         .append('.').append(kinds(rt, rf)).append('.').append(kinds(rt, vecv))
         .append('.').append(kinds(rt, NIL)).append('.').append(kinds(rt, Val.fixnum(77)))
         .append(' ');
        long na = Val.fixnum(101), nb = Val.fixnum(102);
        long ta = Val.fixnum(201), tb = Val.fixnum(202);
        rt.set(sch, Table.SC_NAMES, vector(rt, new long[]{na, nb}));
        rt.set(sch, Table.SC_TYPES, vector(rt, new long[]{ta, tb}));
        rt.set(sch, Table.SC_IDS, vector(rt, new long[]{Val.fixnum(0), Val.fixnum(1)}));
        rt.set(sch, Table.SC_WIDTH, Val.fixnum(3));
        o.append("len=").append(schemaLen(rt, sch)).append(" width=").append(schemaWidth(rt, sch))
         .append(" idat=").append(schemaIdAt(rt, sch, 0)).append('.').append(schemaIdAt(rt, sch, 1))
         .append(" nameat=").append(Val.asFixnum(schemaNameAt(rt, sch, 0))).append('.')
         .append(Val.asFixnum(schemaNameAt(rt, sch, 1)))
         .append(" typeat=").append(Val.asFixnum(schemaTypeAt(rt, sch, 0))).append('.')
         .append(Val.asFixnum(schemaTypeAt(rt, sch, 1))).append(' ');
        long same = obj(rt, TY_SCHEMA, Table.SC_LEN);
        rt.set(same, Table.SC_NAMES, vector(rt, new long[]{na, nb}));
        rt.set(same, Table.SC_TYPES, vector(rt, new long[]{ta, tb}));
        long swapped = obj(rt, TY_SCHEMA, Table.SC_LEN);
        rt.set(swapped, Table.SC_NAMES, vector(rt, new long[]{nb, na}));
        rt.set(swapped, Table.SC_TYPES, vector(rt, new long[]{tb, ta}));
        long retyped = obj(rt, TY_SCHEMA, Table.SC_LEN);
        rt.set(retyped, Table.SC_NAMES, vector(rt, new long[]{na, nb}));
        rt.set(retyped, Table.SC_TYPES, vector(rt, new long[]{ta, ta}));
        o.append("eq=").append(schemaEq(rt, sch, same) ? 1 : 0)
         .append(schemaEq(rt, sch, swapped) ? 1 : 0).append(schemaEq(rt, sch, retyped) ? 1 : 0)
         .append(schemaEq(rt, sch, sch) ? 1 : 0).append(' ');
        long ch = obj(rt, TY_NODE, Table.CH_BASE + 3);
        long enc = obj(rt, TY_NODE, 3);
        rt.set(enc, 0, Val.fixnum(Table.ENC_FLAT));
        rt.set(enc, 1, Val.fixnum(Table.ENC_CONST));
        rt.set(enc, 2, Val.fixnum(Table.ENC_FLAT));
        rt.set(ch, Table.CH_ENC, enc);
        rt.set(ch, Table.CH_ROWS, Val.fixnum(3));
        long col0 = obj(rt, TY_NODE, 3);
        for (int r = 0; r < 3; r++) rt.set(col0, r, Val.fixnum(10 + r));
        rt.set(ch, Table.CH_BASE, col0);
        rt.set(ch, Table.CH_BASE + 1, Val.fixnum(99));
        o.append("rows=").append(chunkRows(rt, ch))
         .append(" enc=").append(chunkEnc(rt, ch, 0)).append(chunkEnc(rt, ch, 1))
         .append(" flat=").append(Val.asFixnum(chunkGet(rt, ch, 0, 0))).append('.')
         .append(Val.asFixnum(chunkGet(rt, ch, 0, 1))).append('.')
         .append(Val.asFixnum(chunkGet(rt, ch, 0, 2)))
         .append(" const=").append(Val.asFixnum(chunkGet(rt, ch, 1, 0))).append('.')
         .append(Val.asFixnum(chunkGet(rt, ch, 1, 1))).append('.')
         .append(Val.asFixnum(chunkGet(rt, ch, 1, 2))).append(' ');
        rt.set(tab, Table.TB_COUNT, Val.fixnum(7));
        rt.set(tab, Table.TB_OFFSET, Val.fixnum(2));
        o.append("count=").append(tableCount(rt, tab)).append(" offset=").append(tableOffset(rt, tab));
        System.out.println(o.toString());
    }
--csharp-pre
namespace Flint.Rt {
    internal static class Table {
        internal const int SC_NAMES = 0, SC_TYPES = 1, SC_INDEX = 2, SC_IDS = 3,
                           SC_WIDTH = 4, SC_LEN = 5;
        internal const int TB_SCHEMA = 0, TB_CHUNKS = 1, TB_COUNT = 2, TB_OFFSET = 3, TB_LEN = 4;
        internal const int CH_ROWS = 0, CH_ENC = 1, CH_BASE = 2;
        internal const int ENC_FLAT = 0, ENC_CONST = 1;
        internal const int RF_SCHEMA = 0, RF_CHUNK = 1, RF_ROW = 2, RF_LEN = 3;
        internal const int CHUNK = 256, CHUNK_SHIFT = 8;
    }
    // A REAL top-level namespace: the generated C# reaches this as
    // `global::Flint.Rt.Eq`, and `global::` needs a genuine root.
    internal static class Eq {
        internal static bool Equal(Probe.Rt rt, long a, long b) {
            if (a == b) return true;
            if (!Probe.Val.IsHeap(a) || !Probe.Val.IsHeap(b)) return false;
            if (Probe.Obj.Ty(rt.gc.sp, a) != Probe.Obj.TyVec
                || Probe.Obj.Ty(rt.gc.sp, b) != Probe.Obj.TyVec) return false;
            int n = Probe.Vec.Count(rt, a);
            if (n != Probe.Vec.Count(rt, b)) return false;
            for (int i = 0; i < n; i++) if (!Equal(rt, rt.Slot(a, i), rt.Slot(b, i))) return false;
            return true;
        }
    }
}
