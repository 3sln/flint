    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        long sch = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        long tab = Obj2(rt, Obj.TyTable, global::Flint.Rt.Table.TB_LEN);
        long rf = Obj2(rt, Obj.TyTableref, global::Flint.Rt.Table.RF_LEN);
        long vecv = Vector(rt, new long[]{});
        o.Append("kinds=").Append(Kinds(rt, sch)).Append('.').Append(Kinds(rt, tab))
         .Append('.').Append(Kinds(rt, rf)).Append('.').Append(Kinds(rt, vecv))
         .Append('.').Append(Kinds(rt, Val.Nil)).Append('.').Append(Kinds(rt, Val.Fixnum(77)))
         .Append(' ');
        long na = Val.Fixnum(101), nb = Val.Fixnum(102);
        long ta = Val.Fixnum(201), tb = Val.Fixnum(202);
        rt.Set(sch, global::Flint.Rt.Table.SC_NAMES, Vector(rt, new long[]{na, nb}));
        rt.Set(sch, global::Flint.Rt.Table.SC_TYPES, Vector(rt, new long[]{ta, tb}));
        rt.Set(sch, global::Flint.Rt.Table.SC_IDS, Vector(rt, new long[]{Val.Fixnum(0), Val.Fixnum(1)}));
        rt.Set(sch, global::Flint.Rt.Table.SC_WIDTH, Val.Fixnum(3));
        o.Append("len=").Append(SchemaLen(rt, sch)).Append(" width=").Append(SchemaWidth(rt, sch))
         .Append(" idat=").Append(SchemaIdAt(rt, sch, 0)).Append('.').Append(SchemaIdAt(rt, sch, 1))
         .Append(" nameat=").Append(Val.AsFixnum(SchemaNameAt(rt, sch, 0))).Append('.')
         .Append(Val.AsFixnum(SchemaNameAt(rt, sch, 1)))
         .Append(" typeat=").Append(Val.AsFixnum(SchemaTypeAt(rt, sch, 0))).Append('.')
         .Append(Val.AsFixnum(SchemaTypeAt(rt, sch, 1))).Append(' ');
        long same = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(same, global::Flint.Rt.Table.SC_NAMES, Vector(rt, new long[]{na, nb}));
        rt.Set(same, global::Flint.Rt.Table.SC_TYPES, Vector(rt, new long[]{ta, tb}));
        long swapped = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(swapped, global::Flint.Rt.Table.SC_NAMES, Vector(rt, new long[]{nb, na}));
        rt.Set(swapped, global::Flint.Rt.Table.SC_TYPES, Vector(rt, new long[]{tb, ta}));
        long retyped = Obj2(rt, Obj.TySchema, global::Flint.Rt.Table.SC_LEN);
        rt.Set(retyped, global::Flint.Rt.Table.SC_NAMES, Vector(rt, new long[]{na, nb}));
        rt.Set(retyped, global::Flint.Rt.Table.SC_TYPES, Vector(rt, new long[]{ta, ta}));
        o.Append("eq=").Append(SchemaEq(rt, sch, same) ? 1 : 0)
         .Append(SchemaEq(rt, sch, swapped) ? 1 : 0).Append(SchemaEq(rt, sch, retyped) ? 1 : 0)
         .Append(SchemaEq(rt, sch, sch) ? 1 : 0).Append(' ');
        long ch = Obj2(rt, Obj.TyNode, global::Flint.Rt.Table.CH_BASE + 3);
        long enc = Obj2(rt, Obj.TyNode, 3);
        rt.Set(enc, 0, Val.Fixnum(global::Flint.Rt.Table.ENC_FLAT));
        rt.Set(enc, 1, Val.Fixnum(global::Flint.Rt.Table.ENC_CONST));
        rt.Set(enc, 2, Val.Fixnum(global::Flint.Rt.Table.ENC_FLAT));
        rt.Set(ch, global::Flint.Rt.Table.CH_ENC, enc);
        rt.Set(ch, global::Flint.Rt.Table.CH_ROWS, Val.Fixnum(3));
        long col0 = Obj2(rt, Obj.TyNode, 3);
        for (int r = 0; r < 3; r++) rt.Set(col0, r, Val.Fixnum(10 + r));
        rt.Set(ch, global::Flint.Rt.Table.CH_BASE, col0);
        rt.Set(ch, global::Flint.Rt.Table.CH_BASE + 1, Val.Fixnum(99));
        o.Append("rows=").Append(ChunkRows(rt, ch))
         .Append(" enc=").Append(ChunkEnc(rt, ch, 0)).Append(ChunkEnc(rt, ch, 1))
         .Append(" flat=").Append(Val.AsFixnum(ChunkGet(rt, ch, 0, 0))).Append('.')
         .Append(Val.AsFixnum(ChunkGet(rt, ch, 0, 1))).Append('.')
         .Append(Val.AsFixnum(ChunkGet(rt, ch, 0, 2)))
         .Append(" const=").Append(Val.AsFixnum(ChunkGet(rt, ch, 1, 0))).Append('.')
         .Append(Val.AsFixnum(ChunkGet(rt, ch, 1, 1))).Append('.')
         .Append(Val.AsFixnum(ChunkGet(rt, ch, 1, 2))).Append(' ');
        rt.Set(tab, global::Flint.Rt.Table.TB_COUNT, Val.Fixnum(7));
        rt.Set(tab, global::Flint.Rt.Table.TB_OFFSET, Val.Fixnum(2));
        o.Append("count=").Append(TableCount(rt, tab)).Append(" offset=").Append(TableOffset(rt, tab));
        System.Console.WriteLine(o.ToString());
    }
