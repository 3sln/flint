        h[24] = 500; h[25] = 501; h[26] = 502; h[27] = 503; h[28] = 504; h[29] = 505;
        h[30] = 2; h[31] = 3; h[32] = 10; h[33] = NIL;
        h[40] = 2; h[41] = 2; h[42] = 400; h[43] = NIL;
