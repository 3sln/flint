        Rt rt = new Rt();
        rt.h = rt.gc.sp.h;
        long[] h = rt.h;
        h[10] = 2; h[11] = 3; h[12] = 100; h[13] = NIL;
        h[100] = 0; h[101] = 3; h[102] = 4;
        h[103] = 500; h[104] = 501; h[105] = 502; h[106] = 503; h[107] = 150;
        h[150] = 0; h[151] = 1; h[152] = 0; h[153] = 504; h[154] = 505;
        h[20] = 3; h[21] = 3; h[22] = 0; h[23] = NIL;
        h[24] = 500; h[25] = 501; h[26] = 502; h[27] = 503; h[28] = 504; h[29] = 505;
        h[30] = 2; h[31] = 3; h[32] = 10; h[33] = NIL;
        h[40] = 2; h[41] = 2; h[42] = 400; h[43] = NIL;
        h[44] = 2; h[45] = 2; h[46] = 420; h[47] = NIL;
