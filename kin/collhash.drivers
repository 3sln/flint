--rust-head
// The same mock CHAMP as `mapeq.drivers`, plus an ARRAY-MAP tier and a SET
// wrapper, because a hash has to cover both tiers and a set is its backing
// map. `ordered_step` and `mix_coll_hash` are stubbed arithmetic: the probe
// checks that three targets AGREE on a walk, not that murmur is murmur.
//
// The interesting property is in the last two probes: the same entries
// arranged as a flat array-map and as a trie must hash the SAME, and a
// collision node must not care which order its pairs sit in.
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const HM_ROOT: u32 = 2;
const HM_HASH: u32 = 3;
const AM_HASH: u32 = 3;
const S_MAP: u32 = 2;
const S_HASH: u32 = 3;
const TY_ARRAYMAP: u8 = 3;
const TY_HASHMAP: u8 = 2;
impl Value {
    fn is_nil(self) -> bool { self.0 == 0xFFFF }
    fn as_heap(self) -> u64 { self.0 }
    fn fixnum(n: i64) -> Value { Value(n as u64) }
    // `is-fixnum` and `as-fixnum` are Value METHODS in Rust and static calls
    // on `Val` in both ports, so the mock has to be both shapes.
    fn is_fixnum(self) -> bool { self.0 != 0xFFFF && self.0 >= 1000 }
    fn as_fixnum(self) -> i64 { self.0 as i64 }
}
// `S_MAP` and `S_HASH` are spelled `crate::set::…` by the vocabulary, unlike
// the map's slots which are bare, so the mock grows a module of that name.
mod set { pub const S_MAP: u32 = 2; pub const S_HASH: u32 = 3; }
struct Sp { h: Vec<u64> }
struct Gc { sp: Sp }
struct Rt { gc: Gc, roots: Vec<Value>, hashes: u32 }
fn ty(sp: &Sp, a: u64) -> u8 { sp.h[a as usize] as u8 }
fn ordered_step(acc: u32, h: u32) -> u32 { acc.wrapping_mul(31).wrapping_add(h) }
fn mix_coll_hash(h: u32, n: u32) -> u32 { h ^ (n.wrapping_mul(0x9e3779b9)) }
impl Rt {
    fn mark(&self) -> usize { self.roots.len() }
    fn push(&mut self, v: Value) -> usize { self.roots.push(v); self.roots.len() - 1 }
    fn r(&self, i: usize) -> Value { self.roots[i] }
    fn pop_to(&mut self, n: usize) { self.roots.truncate(n); }
    fn slot(&self, v: Value, i: u32) -> Value { Value(self.gc.sp.h[(v.0 + i as u64) as usize]) }
    fn set(&mut self, v: Value, i: u32, x: Value) { self.gc.sp.h[(v.0 + i as u64) as usize] = x.0; }
    // COUNTED, so a probe can tell a memoised answer from a recomputed one.
    fn hash_value(&mut self, v: Value) -> u32 { self.hashes += 1; (v.0 as u32).wrapping_mul(2654435761) }
    fn map_count(&self, m: Value) -> u32 { self.gc.sp.h[m.0 as usize + 1] as u32 }
    fn set_count(&self, s: Value) -> u32 { self.map_count(self.slot(s, S_MAP)) }
    fn am_key(&self, m: Value, i: u32) -> Value { Value(self.gc.sp.h[m.0 as usize + 4 + 2 * i as usize]) }
    fn am_val(&self, m: Value, i: u32) -> Value { Value(self.gc.sp.h[m.0 as usize + 5 + 2 * i as usize]) }
    fn is_bmnode(&self, n: Value) -> bool { self.gc.sp.h[n.0 as usize] == 0 }
    fn bn_datamap(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 1] as u32 }
    fn bn_nodemap(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 2] as u32 }
    fn bn_key(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 3 + 2 * i as usize]) }
    fn bn_val(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 4 + 2 * i as usize]) }
    fn bn_node(&self, n: Value, j: u32) -> Value {
        let nd = self.bn_datamap(n).count_ones();
        Value(self.gc.sp.h[n.0 as usize + 3 + 2 * nd as usize + j as usize])
    }
    fn cn_count(&self, n: Value) -> u32 { self.gc.sp.h[n.0 as usize + 2] as u32 }
    fn cn_key(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 3 + 2 * i as usize]) }
    fn cn_val(&self, n: Value, i: u32) -> Value { Value(self.gc.sp.h[n.0 as usize + 4 + 2 * i as usize]) }
}
impl Rt {
--rust
}
fn fresh() -> Rt {
    let mut h = vec![0u64; 700];
    // A CHAMP map: [ty, count, root, hash]
    h[10] = 2; h[11] = 3; h[12] = 100; h[13] = NIL.0;
    // its trie: two inline entries and one child holding the third
    h[100] = 0; h[101] = 3; h[102] = 4;
    h[103] = 500; h[104] = 501; h[105] = 502; h[106] = 503; h[107] = 150;
    h[150] = 0; h[151] = 1; h[152] = 0; h[153] = 504; h[154] = 505;
    // AN ARRAY-MAP with the SAME three pairs: [ty, count, unused, hash, k,v...]
    h[20] = 3; h[21] = 3; h[22] = 0; h[23] = NIL.0;
    h[24] = 500; h[25] = 501; h[26] = 502; h[27] = 503; h[28] = 504; h[29] = 505;
    // A SET over the CHAMP map: [ty, count, map, hash]
    h[30] = 2; h[31] = 3; h[32] = 10; h[33] = NIL.0;
    // A COLLISION node under a map, and the same pairs the other way round
    h[40] = 2; h[41] = 2; h[42] = 400; h[43] = NIL.0;
    h[44] = 2; h[45] = 2; h[46] = 420; h[47] = NIL.0;
    h[400] = 1; h[401] = 0x55; h[402] = 2; h[403] = 600; h[404] = 601; h[405] = 602; h[406] = 603;
    h[420] = 1; h[421] = 0x55; h[422] = 2; h[423] = 602; h[424] = 603; h[425] = 600; h[426] = 601;
    Rt { gc: Gc { sp: Sp { h } }, roots: Vec::new(), hashes: 0 }
}
fn main() {
    let mut rt = fresh();
    let mut o = String::new();
    let champ = rt.hash_map(Value(10));
    let arraymap = rt.hash_map(Value(20));
    // AS i32, because both ports print a signed int and the bits are the same.
    o.push_str(&format!("champ={} array={} same={} ",
        champ as i32, arraymap as i32, (champ == arraymap) as u32));
    // MEMOISED: the second call must not hash anything again.
    let before = rt.hashes;
    let again = rt.hash_map(Value(10));
    o.push_str(&format!("again={} rehashed={} ", (again == champ) as u32, rt.hashes - before));
    let s = rt.hash_set(Value(30));
    o.push_str(&format!("set={} ", s as i32));
    let c1 = rt.hash_map(Value(40));
    let c2 = rt.hash_map(Value(44));
    o.push_str(&format!("coll={} roots={}", (c1 == c2) as u32, rt.roots.len()));
    println!("{}", o);
}
