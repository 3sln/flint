    public static void main(String[] args) {
        Rt rt = fresh();
        StringBuilder o = new StringBuilder();
        int champ = hashMap(rt, 10);
        int arraymap = hashMap(rt, 20);
        o.append("champ=").append(champ).append(" array=").append(arraymap)
         .append(" same=").append(champ == arraymap ? 1 : 0).append(' ');
        int before = rt.hashes;
        int again = hashMap(rt, 10);
        o.append("again=").append(again == champ ? 1 : 0)
         .append(" rehashed=").append(rt.hashes - before).append(' ');
        o.append("set=").append(hashSet(rt, 30)).append(' ');
        int c1 = hashMap(rt, 40), c2 = hashMap(rt, 44);
        o.append("coll=").append(c1 == c2 ? 1 : 0).append(" roots=").append(rt.roots.size());
        System.out.println(o.toString());
