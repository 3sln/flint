    internal const long NIL = 0xFFFFL, TRUE = 0xFFFDL, FALSE = 0xFFFCL;
    internal const int TY_UNKNOWN = 99;
    internal static class Obj {
        internal const int TyStr = 2, TyRope = 26, TyKw = 7, TySym = 8,
            TyBigint = 3, TyVec = 9, TyMapentry = 15, TyArraymap = 16,
            TyHashmap = 17, TySet = 18, TyCons = 19, TyEmptyList = 20,
            TyLazyseq = 21, TyVecseq = 22, TyStrseq = 23, TyRange = 24,
            TyIterseq = 52, TyChunkseq = 53, TyClosure = 27, TyNativefn = 28,
            TyMultifn = 29, TyPort = 30, TyThread = 31, TyAtom = 32,
            TyVar = 33, TyRegex = 34, TyExinfo = 35, TyTagged = 36,
            TyOpaque = 37, TyBytes = 44, TyBrope = 45, TyTbytes = 46,
            TyDelay = 38, TyVolatile = 39, TySchema = 48, TyTable = 49,
            TyTableref = 50;
        internal static int Ty(Space sp, long a) { return sp.m[(int) a] & 0xFF; }
    }
    internal static class Val {
        internal static bool IsHeap(long v) {
            return v >= 100 && (long)((ulong) v >> 60) == 0 && v != NIL && v != TRUE && v != FALSE;
        }
        internal static long AsHeap(long v) { return v; }
        internal static bool IsNil(long v) { return v == NIL; }
        internal static bool IsBool(long v) { return v == TRUE || v == FALSE; }
        internal static bool IsFixnum(long v) { return (long)((ulong) v >> 60) == 0xDL; }
        internal static bool IsDouble(long v) { return (long)((ulong) v >> 60) == 0xCL; }
        internal static bool IsInlineStr(long v) { return (long)((ulong) v >> 60) == 0xEL; }
        internal static bool IsInlineKw(long v) { return (long)((ulong) v >> 60) == 0xAL; }
        internal static long Fixnum(long n) { return (0xDL << 60) | (n & 0xFFFFL); }
    }
    internal sealed class Space { internal byte[] m = new byte[4000]; }
    internal sealed class Rt {
        internal sealed class GcT { internal Space sp = new Space(); }
        internal GcT gc = new GcT();
        internal long bump = 100;
        internal System.Collections.Generic.List<string> kws = new System.Collections.Generic.List<string>();
        internal bool IsInt(long v) { return Num.IsInt(this, v); }
    }
    internal static long Obj2(Rt rt, int t) {
        long a = rt.bump; rt.bump += 8;
        rt.gc.sp.m[(int) a] = (byte) t;
        return a;
    }
    internal static class Str {
        internal static long Keyword(Rt rt, string? ns, string name) {
            for (int i = 0; i < rt.kws.Count; i++)
                if (rt.kws[i] == name) return (0xAL << 60) | (long) i;
            rt.kws.Add(name);
            return (0xAL << 60) | (long) (rt.kws.Count - 1);
        }
        internal static bool IsString(Rt rt, long v) {
            return Val.IsInlineStr(v)
                || (Val.IsHeap(v) && (Obj.Ty(rt.gc.sp, v) == Obj.TyStr
                                      || Obj.Ty(rt.gc.sp, v) == Obj.TyRope));
        }
    }
    internal static class Num {
        internal static bool IsInt(Rt rt, long v) {
            return Val.IsFixnum(v) || (Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyBigint);
        }
    }
    internal static string KwText(Rt rt, long v) { return rt.kws[(int) (v & 0xFFFFL)]; }
    internal static bool IsKeyword(Rt rt, long v) {
        return Val.IsInlineKw(v) || (Val.IsHeap(v) && Obj.Ty(rt.gc.sp, v) == Obj.TyKw);
    }
