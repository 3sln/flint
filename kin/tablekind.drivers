--rust-head
extern crate alloc;
type Addr = u64;
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
const NIL: Value = Value(0xFFFF);
const TRUE: Value = Value(0xFFFD);
const FALSE: Value = Value(0xFFFC);
// EVERY TAG THE CLOSED SET NAMES. The point of the fixture is that no value a
// guest can hold falls through to `:other`, so the probe has to be able to
// build one of each.
const TY_STR: u8 = 2; const TY_ROPE: u8 = 26; const TY_KW: u8 = 7;
const TY_SYM: u8 = 8; const TY_BIGINT: u8 = 3; const TY_VEC: u8 = 9;
const TY_MAPENTRY: u8 = 15; const TY_ARRAYMAP: u8 = 16; const TY_HASHMAP: u8 = 17;
const TY_SET: u8 = 18; const TY_CONS: u8 = 19; const TY_EMPTY_LIST: u8 = 20;
const TY_LAZYSEQ: u8 = 21; const TY_VECSEQ: u8 = 22; const TY_STRSEQ: u8 = 23;
const TY_RANGE: u8 = 24; const TY_ITERSEQ: u8 = 52; const TY_CHUNKSEQ: u8 = 53;
const TY_CLOSURE: u8 = 27; const TY_NATIVEFN: u8 = 28; const TY_MULTIFN: u8 = 29;
const TY_PORT: u8 = 30; const TY_THREAD: u8 = 31; const TY_ATOM: u8 = 32;
const TY_VAR: u8 = 33; const TY_REGEX: u8 = 34; const TY_EXINFO: u8 = 35;
const TY_TAGGED: u8 = 36; const TY_OPAQUE: u8 = 37; const TY_BYTES: u8 = 44;
const TY_BROPE: u8 = 45; const TY_TBYTES: u8 = 46; const TY_DELAY: u8 = 38;
const TY_VOLATILE: u8 = 39; const TY_SCHEMA: u8 = 48; const TY_TABLE: u8 = 49;
const TY_TABLEREF: u8 = 50; const TY_UNKNOWN: u8 = 99;
impl Value {
    fn is_heap(self) -> bool {
        self.0 >= 100 && (self.0 >> 60) == 0
            && self.0 != NIL.0 && self.0 != TRUE.0 && self.0 != FALSE.0
    }
    fn as_heap(self) -> Addr { self.0 as Addr }
    fn is_nil(self) -> bool { self.0 == NIL.0 }
    fn is_bool(self) -> bool { self.0 == TRUE.0 || self.0 == FALSE.0 }
    fn is_fixnum(self) -> bool { (self.0 >> 60) == 0xD }
    fn is_double(self) -> bool { (self.0 >> 60) == 0xC }
    fn is_inline_str(self) -> bool { (self.0 >> 60) == 0xE }
    fn is_inline_kw(self) -> bool { (self.0 >> 60) == 0xA }
    fn fixnum(n: i64) -> Value { Value((0xDu64 << 60) | (n as u64 & 0xFFFF)) }
}
struct Space { m: Vec<u8> }
struct Gc { sp: Space }
struct Rt { gc: Gc, bump: u64, kws: Vec<alloc::string::String> }
fn ty(sp: &Space, a: Addr) -> u8 { sp.m[a as usize] }
impl Rt {
    fn obj(&mut self, t: u8) -> Value {
        let a = self.bump; self.bump += 8;
        self.gc.sp.m[a as usize] = t;
        Value(a)
    }
    // A KEYWORD IS ITS NAME, interned: two keywords of one name are one value,
    // which is what `type-ok`'s `==` comparisons depend on.
    fn keyword(&mut self, _ns: Option<&str>, name: &str) -> Value {
        for (i, k) in self.kws.iter().enumerate() {
            if k == name { return Value((0xAu64 << 60) | i as u64); }
        }
        self.kws.push(alloc::string::String::from(name));
        Value((0xAu64 << 60) | (self.kws.len() as u64 - 1))
    }
    fn kw_text(&self, v: Value) -> alloc::string::String {
        self.kws[(v.0 & 0xFFFF) as usize].clone()
    }
    fn is_keyword(&self, v: Value) -> bool {
        v.is_inline_kw() || (v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_KW)
    }
    fn is_string(&self, v: Value) -> bool {
        v.is_inline_str()
            || (v.is_heap() && (ty(&self.gc.sp, v.as_heap()) == TY_STR
                                || ty(&self.gc.sp, v.as_heap()) == TY_ROPE))
    }
    // `is-int` AND NOT `is-fixnum`: a bigint is an integer too.
    fn is_int(&self, v: Value) -> bool {
        v.is_fixnum() || (v.is_heap() && ty(&self.gc.sp, v.as_heap()) == TY_BIGINT)
    }
}
impl Rt {
--rust
}
fn main() {
    let mut rt = Rt { gc: Gc { sp: Space { m: vec![0u8; 4000] } }, bump: 100, kws: Vec::new() };
    let mut o = String::new();
    // EVERY TAG, IN ORDER, and none of them may answer `other`.
    let tags: alloc::vec::Vec<u8> = alloc::vec![
        TY_STR, TY_ROPE, TY_KW, TY_SYM, TY_BIGINT, TY_VEC, TY_MAPENTRY,
        TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_CONS, TY_EMPTY_LIST,
        TY_LAZYSEQ, TY_VECSEQ, TY_STRSEQ, TY_RANGE, TY_ITERSEQ, TY_CHUNKSEQ,
        TY_CLOSURE, TY_NATIVEFN, TY_MULTIFN, TY_PORT, TY_THREAD, TY_ATOM,
        TY_VAR, TY_REGEX, TY_EXINFO, TY_TAGGED, TY_OPAQUE, TY_BYTES, TY_BROPE,
        TY_TBYTES, TY_DELAY, TY_VOLATILE, TY_SCHEMA, TY_TABLE];
    let mut words = alloc::vec::Vec::new();
    for t in &tags {
        let v = rt.obj(*t);
        let k = rt.kind_of(v);
        words.push(rt.kw_text(k));
    }
    o.push_str(&format!("heap={} ", words.join(".")));
    // THE NON-HEAP TIERS, and the one value that legitimately has no kind.
    let inl_s = Value((0xEu64 << 60) | 1);
    let inl_k = Value((0xAu64 << 60) | 0);
    let dbl = Value((0xCu64 << 60) | 7);
    let unknown = rt.obj(TY_UNKNOWN);
    let mut flat = alloc::vec::Vec::new();
    for v in [NIL, TRUE, FALSE, dbl, Value::fixnum(3), inl_s, inl_k, unknown] {
        let k = rt.kind_of(v);
        flat.push(rt.kw_text(k));
    }
    o.push_str(&format!("flat={} ", flat.join(".")));
    // NOTHING FALLS THROUGH: `:other` appears exactly once, for the tag no
    // kind is claimed for. `0005` says a value a guest can hold needs a kind
    // of its own or it cannot be dispatched on at all.
    let others = words.iter().chain(flat.iter()).filter(|w| *w == "other").count();
    o.push_str(&format!("others={} ", others));
    // THE TYPES A SCHEMA MAY DECLARE, and one it may not.
    let mut known = alloc::string::String::new();
    for n in ["int", "double", "string", "bool", "keyword", "any", "table"] {
        let k = rt.keyword(None, n);
        known.push(if rt.known_type(k) { '1' } else { '0' });
    }
    o.push_str(&format!("known={} ", known));
    // AND WHAT EACH TYPE ACCEPTS. `:any` takes everything; `:int` takes a
    // BIGINT as well as a fixnum, which `is-fixnum` would have refused.
    let big = rt.obj(TY_BIGINT);
    let strv = rt.obj(TY_STR);
    let vals: alloc::vec::Vec<Value> = alloc::vec![
        Value::fixnum(1), big, dbl, strv, inl_s, TRUE, inl_k, NIL];
    let mut grid = alloc::vec::Vec::new();
    for tn in ["any", "int", "double", "string", "bool", "keyword"] {
        let t = rt.keyword(None, tn);
        let mut row = alloc::string::String::new();
        for v in &vals {
            row.push(if rt.type_ok(t, *v) { '1' } else { '0' });
        }
        grid.push(row);
    }
    o.push_str(&format!("ok={}", grid.join(".")));
    println!("{}", o);
}
