    public static void main(String[] args) {
        Rt rt = new Rt();
        StringBuilder o = new StringBuilder();
        int[] tags = { TY_STR, TY_ROPE, TY_KW, TY_SYM, TY_BIGINT, TY_VEC, TY_MAPENTRY,
            TY_ARRAYMAP, TY_HASHMAP, TY_TABLEREF, TY_SET, TY_CONS, TY_EMPTY_LIST,
            TY_LAZYSEQ, TY_VECSEQ, TY_STRSEQ, TY_RANGE, TY_ITERSEQ, TY_CHUNKSEQ,
            TY_CLOSURE, TY_NATIVEFN, TY_MULTIFN, TY_PORT, TY_THREAD, TY_ATOM,
            TY_VAR, TY_REGEX, TY_EXINFO, TY_TAGGED, TY_OPAQUE, TY_BYTES, TY_BROPE,
            TY_TBYTES, TY_DELAY, TY_VOLATILE, TY_SCHEMA, TY_TABLE };
        java.util.ArrayList<String> words = new java.util.ArrayList<>();
        for (int t : tags) words.add(kwText(rt, kindOf(rt, obj(rt, t))));
        o.append("heap=").append(String.join(".", words)).append(' ');
        long inlS = (0xEL << 60) | 1, inlK = (0xAL << 60), dbl = (0xCL << 60) | 7;
        long unknown = obj(rt, TY_UNKNOWN);
        long[] flatv = { NIL, TRUE, FALSE, dbl, Val.fixnum(3), inlS, inlK, unknown };
        java.util.ArrayList<String> flat = new java.util.ArrayList<>();
        for (long v : flatv) flat.add(kwText(rt, kindOf(rt, v)));
        o.append("flat=").append(String.join(".", flat)).append(' ');
        int others = 0;
        for (String w : words) if (w.equals("other")) others++;
        for (String w : flat) if (w.equals("other")) others++;
        o.append("others=").append(others).append(' ');
        StringBuilder known = new StringBuilder();
        for (String n : new String[]{"int", "double", "string", "bool", "keyword", "any", "table"})
            known.append(knownType(rt, Str.keyword(rt, null, n)) ? '1' : '0');
        o.append("known=").append(known).append(' ');
        long big = obj(rt, TY_BIGINT), strv = obj(rt, TY_STR);
        long[] vals = { Val.fixnum(1), big, dbl, strv, inlS, TRUE, inlK, NIL };
        java.util.ArrayList<String> grid = new java.util.ArrayList<>();
        for (String tn : new String[]{"any", "int", "double", "string", "bool", "keyword"}) {
            long t = Str.keyword(rt, null, tn);
            StringBuilder row = new StringBuilder();
            for (long v : vals) row.append(typeOk(rt, t, v) ? '1' : '0');
            grid.add(row.toString());
        }
        o.append("ok=").append(String.join(".", grid));
        System.out.println(o.toString());
    }
