    internal static void Main() {
        Rt rt = new Rt();
        var o = new System.Text.StringBuilder();
        int[] tags = { Obj.TyStr, Obj.TyRope, Obj.TyKw, Obj.TySym, Obj.TyBigint,
            Obj.TyVec, Obj.TyMapentry, Obj.TyArraymap, Obj.TyHashmap, Obj.TyTableref,
            Obj.TySet, Obj.TyCons, Obj.TyEmptyList, Obj.TyLazyseq, Obj.TyVecseq,
            Obj.TyStrseq, Obj.TyRange, Obj.TyIterseq, Obj.TyChunkseq, Obj.TyClosure,
            Obj.TyNativefn, Obj.TyMultifn, Obj.TyPort, Obj.TyThread, Obj.TyAtom,
            Obj.TyVar, Obj.TyRegex, Obj.TyExinfo, Obj.TyTagged, Obj.TyOpaque,
            Obj.TyBytes, Obj.TyBrope, Obj.TyTbytes, Obj.TyDelay, Obj.TyVolatile,
            Obj.TySchema, Obj.TyTable };
        var words = new System.Collections.Generic.List<string>();
        foreach (int t in tags) words.Add(KwText(rt, KindOf(rt, Obj2(rt, t))));
        o.Append("heap=").Append(string.Join(".", words)).Append(' ');
        long inlS = (0xEL << 60) | 1, inlK = (0xAL << 60), dbl = (0xCL << 60) | 7;
        long unknown = Obj2(rt, TY_UNKNOWN);
        long[] flatv = { NIL, TRUE, FALSE, dbl, Val.Fixnum(3), inlS, inlK, unknown };
        var flat = new System.Collections.Generic.List<string>();
        foreach (long v in flatv) flat.Add(KwText(rt, KindOf(rt, v)));
        o.Append("flat=").Append(string.Join(".", flat)).Append(' ');
        int others = 0;
        foreach (string w in words) if (w == "other") others++;
        foreach (string w in flat) if (w == "other") others++;
        o.Append("others=").Append(others).Append(' ');
        var known = new System.Text.StringBuilder();
        foreach (string n in new string[]{"int", "double", "string", "bool", "keyword", "any", "table"})
            known.Append(KnownType(rt, Str.Keyword(rt, null, n)) ? '1' : '0');
        o.Append("known=").Append(known).Append(' ');
        long big = Obj2(rt, Obj.TyBigint), strv = Obj2(rt, Obj.TyStr);
        long[] vals = { Val.Fixnum(1), big, dbl, strv, inlS, TRUE, inlK, NIL };
        var grid = new System.Collections.Generic.List<string>();
        foreach (string tn in new string[]{"any", "int", "double", "string", "bool", "keyword"}) {
            long t = Str.Keyword(rt, null, tn);
            var row = new System.Text.StringBuilder();
            foreach (long v in vals) row.Append(TypeOk(rt, t, v) ? '1' : '0');
            grid.Add(row.ToString());
        }
        o.Append("ok=").Append(string.Join(".", grid));
        System.Console.WriteLine(o.ToString());
    }
