    // THE SAME TOY, field for field.
    public class Node {
        public bool bm; public int dm; public int nm;
        public System.Collections.Generic.List<long> ents = new System.Collections.Generic.List<long>();
        public System.Collections.Generic.List<long> kids = new System.Collections.Generic.List<long>();
    }
    public class Rt {
        public System.Collections.Generic.List<Node> objs = new System.Collections.Generic.List<Node>();
        public System.Collections.Generic.List<long> rootv = new System.Collections.Generic.List<long>();
        public long Node_(Node n) { objs.Add(n); return objs.Count - 1 + 1000; }
        public Node At(long v) { return objs[(int)(v - 1000)]; }
        public int Push(long v) { rootv.Add(v); return rootv.Count - 1; }
    }
    static bool IsBmnode(Rt rt, long v) { return rt.At(v).bm; }
    static int CnCount(Rt rt, long v) { return rt.At(v).ents.Count / 2; }
    static long CnKey(Rt rt, long v, int i) { return rt.At(v).ents[i * 2]; }
    static long CnVal(Rt rt, long v, int i) { return rt.At(v).ents[i * 2 + 1]; }
    static int BnDatamap(Rt rt, long v) { return rt.At(v).dm; }
    static int BnNodemap(Rt rt, long v) { return rt.At(v).nm; }
    static long BnKey(Rt rt, long v, int i) { return rt.At(v).ents[i * 2]; }
    static long BnVal(Rt rt, long v, int i) { return rt.At(v).ents[i * 2 + 1]; }
    static long BnNode(Rt rt, long v, int i) { return rt.At(v).kids[i]; }
--csharp
    static Rt Fresh() { return new Rt(); }
    static string Walked(Rt rt, long root) {
        int n = PushNodeEntries(rt, root);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < rt.rootv.Count; i++) {
            if (i > 0) sb.Append(',');
            sb.Append(rt.rootv[i]);
        }
        return n + ":" + (rt.rootv.Count == 0 ? "-" : sb.ToString());
    }
    static long Coll(Rt rt, long[] ns) {
        var nd = new Node(); nd.bm = false;
        foreach (long n in ns) { nd.ents.Add(n * 10); nd.ents.Add(n * 10 + 1); }
        return rt.Node_(nd);
    }
    static long Bm(Rt rt, long[] ns, long[] kids) {
        var nd = new Node(); nd.bm = true;
        foreach (long n in ns) { nd.ents.Add(n * 10); nd.ents.Add(n * 10 + 1); }
        nd.ents.Add(999L); nd.ents.Add(998L);
        foreach (long k in kids) nd.kids.Add(k);
        nd.dm = ns.Length == 0 ? 0 : (1 << ns.Length) - 1;
        nd.nm = kids.Length == 0 ? 0 : (1 << kids.Length) - 1;
        return rt.Node_(nd);
    }
    static void Main() {
        Rt a = Fresh(); string r1 = Walked(a, Coll(a, new long[]{1, 2}));
        Rt b = Fresh(); string r2 = Walked(b, Coll(b, new long[]{}));
        Rt c = Fresh(); string r3 = Walked(c, Bm(c, new long[]{1, 2}, new long[]{}));
        Rt d = Fresh();
        long dk = Coll(d, new long[]{7, 8});
        string r4 = Walked(d, Bm(d, new long[]{1}, new long[]{dk}));
        Rt e = Fresh();
        long e1 = Coll(e, new long[]{3}), e2 = Coll(e, new long[]{4, 5});
        string r5 = Walked(e, Bm(e, new long[]{}, new long[]{e1, e2}));
        Rt f = Fresh();
        long fl = Coll(f, new long[]{9});
        long fm = Bm(f, new long[]{6}, new long[]{fl});
        string r6 = Walked(f, Bm(f, new long[]{1}, new long[]{fm}));
        System.Console.WriteLine(r1 + " | " + r2 + " | " + r3 + " | " + r4 + " | " + r5 + " | " + r6);
    }
--expect
2:10,11,20,21 | 0:- | 2:10,11,20,21 | 3:10,11,70,71,80,81 | 3:30,31,40,41,50,51 | 3:10,11,60,61,90,91
--expect-why
DERIVED FROM THE CONTRACT. Six rows as `<answered>:<roots, in order>`. A pair
numbered `n` is key `n*10` and value `n*10 + 1`, so `10,11` is one entry and
the sequence shows both WHAT was pushed and IN WHICH ORDER.

EVERY BITMAP NODE IN THIS TOY CARRIES ONE PAIR OF PADDING -- `999,998` -- that
its datamap does not count. A walk that took the entry array's LENGTH instead
of `popcount` of the datamap would push it, and there is no other way to tell
those two apart: on a node whose array is exactly as long as its bitmap
claims, both readings agree. Rows 3, 4, 5 and 6 all carry it and none of them
shows a `999`.

1  A COLLISION NODE, two entries -- `2:10,11,20,21`. The base case: flat,
   terminal, nothing below it. TWO claims at once -- two pushes per entry, and
   the answer counting PAIRS rather than pushes. A caller popping `2 * n`
   where this answered `n` is the mistake the name guards against, so the
   count and the root list are reported side by side.

2  AN EMPTY COLLISION NODE -- `0:-`. Nothing pushed and nothing counted. It is
   not an error and not a special case: `cn-count` is zero and the loop does
   not run.

3  A BITMAP NODE, TWO INLINE, NO CHILDREN -- `2:10,11,20,21`, identical to row
   1 and reached down the other branch. The array holds THREE pairs and the
   datamap names two. Read the length and this row is `3:10,11,20,21,999,998`.

4  ONE INLINE ENTRY, ONE CHILD -- `3:10,11,70,71,80,81`. THE ORDER ROW. This
   node's pair comes first and the child's two follow, which is what keeps one
   node's entries contiguous on the root stack. Descend before pushing and it
   reads `3:70,71,80,81,10,11` -- the same count, the same values, a different
   layout, and a caller slicing per node gets the wrong pairs.

5  NO INLINE, TWO CHILDREN -- `3:30,31,40,41,50,51`. The count is the sum of
   the children's and nothing of its own: one pair from the first, two from
   the second. Counting the node itself as an entry reads `4` or `5`.

6  THREE DEEP -- `3:10,11,60,61,90,91`. A bitmap under a bitmap, so the
   recursion carries a count up through more than one level rather than one.
   Returning the child's count instead of ADDING it reads `1`; adding but
   dropping the deepest level reads `2`.

`popcount` OF THE NODEMAP BOUNDS THE CHILD LOOP, for the same reason it bounds
the entry loop: both runs live in one node and only the bitmaps say where each
ends. Rows 5 and 6 would descend into a child that does not exist if the
children were counted any other way.
