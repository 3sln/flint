--rust-head
#[derive(Clone, Copy, PartialEq)]
struct Value(u64);
struct InternTable { hashes: Vec<u32>, values: Vec<u64>, count: usize }
impl InternTable {
--rust
}
fn main() {
    let mut t = InternTable { hashes: vec![0; 8], values: vec![0; 8], count: 0 };
    let mut o = String::new();
    o.push_str(&format!("{} ", t.mask()));
    o.push_str(if t.needs_grow() { "1 " } else { "0 " });
    t.insert_at(3, 0xAA, Value(77));
    // Three hashes that collide mod 8, so the probe has to walk.
    t.raw_insert(1, 101); t.raw_insert(9, 109); t.raw_insert(17, 117);
    for i in 0..8 { o.push_str(&format!("{}:{} ", t.hashes[i], t.values[i])); }
    o.push_str(&format!("n={} ", t.count));
    o.push_str(if t.needs_grow() { "1" } else { "0" });
    println!("{}", o);
}
--java-head
    // The table is a plain data holder now: the arithmetic is a STATIC that
    // takes it, so the class closes here rather than around the generated
    // block.
    //
    // NESTED to reproduce the port's FULLY QUALIFIED `com.flint.rt.Interns`.
    // The tag names the type in full because `interns.kin` generates a class
    // called `Interns` into package `flint.rt`, and inside a file of that
    // package a bare `Interns` is the generated one rather than the table.
    static final class com { static final class flint { static final class rt {
        static final class Interns {
            int[] hashes = new int[8];
            long[] values = new long[8];
            int count = 0;
        }
    } } }
--java
    public static void main(String[] args) {
        com.flint.rt.Interns t = new com.flint.rt.Interns();
        StringBuilder o = new StringBuilder();
        o.append(mask(t)).append(' ');
        o.append(needsGrow(t) ? "1 " : "0 ");
        insertAt(t, 3, 0xAA, 77L);
        rawInsert(t, 1, 101L); rawInsert(t, 9, 109L); rawInsert(t, 17, 117L);
        for (int i = 0; i < 8; i++) o.append(t.hashes[i]).append(':').append(t.values[i]).append(' ');
        o.append("n=").append(t.count).append(' ');
        o.append(needsGrow(t) ? "1" : "0");
        System.out.println(o);
    }
--csharp-pre
// The hand-written runtime, as a REAL top-level namespace.
//
// The generated C# reaches it as `global::Flint.Rt.X`, because its own
// namespace ends in `Rt` and a bare `Flint.Rt` would resolve against that
// instead. `global::` needs a genuine root namespace, which a shim nested
// inside `class Probe` cannot be -- so these live out here now.
namespace Flint.Rt {
    internal sealed class Interns {
        internal int[] hashes = new int[8];
        internal long[] values = new long[8];
        internal int count = 0;
    }
}

--csharp-head
--csharp
    static void Main() {
        var t = new Flint.Rt.Interns();
        var o = new StringBuilder();
        o.Append(Mask(t)).Append(' ');
        o.Append(NeedsGrow(t) ? "1 " : "0 ");
        InsertAt(t, 3, 0xAA, 77L);
        RawInsert(t, 1, 101L); RawInsert(t, 9, 109L); RawInsert(t, 17, 117L);
        for (int i = 0; i < 8; i++) o.Append(t.hashes[i]).Append(':').Append(t.values[i]).Append(' ');
        o.Append("n=").Append(t.count).Append(' ');
        o.Append(NeedsGrow(t) ? "1" : "0");
        Console.WriteLine(o.ToString());
    }
--expect
7 0 0:0 1:101 9:109 170:77 17:117 0:0 0:0 0:0 n=4 0
--expect-why
DERIVED by running `interns.kin`'s four functions against the driver's table
by hand. The table is eight slots of zero, so every probe's landing slot is
determined.

  mask t        = alen(values) - 1        = 8 - 1 = 7
  needs-grow t  = count*4 >= alen(values)*3

FIELD 1, `mask` = 7. A power-of-two mask, not a modulus: `raw-insert` uses it
as `hash & m`, so a mask of 8 (length, not length-1) would put a probe one slot
past the array on every hash with bit 3 set.

FIELD 2, `needs-grow` on the empty table = 0. 0*4 = 0, 8*3 = 24, and 0 >= 24 is
false. A predicate that read `<=`, or compared against `alen` rather than
`alen*3`, would say 1 here and the table would grow before holding anything.

THE EIGHT SLOTS ARE THE LINEAR PROBE, and the fixture is laid so the walk has
to step over an entry it did not place. `insert-at 3` writes DIRECTLY at index
3 with no probe -- hashes[3] = 0xAA = 170, values[3] = 77 -- and then three
`raw-insert`s arrive on hashes 1, 9, 17, which are all 1 mod 8:

  raw-insert 1  101: i = 1 & 7 = 1, values[1] = 0        -> lands at 1
  raw-insert 9  109: i = 9 & 7 = 1, taken -> 2, free     -> lands at 2
  raw-insert 17 117: i = 17 & 7 = 1, taken -> 2, taken
                     -> 3, HOLDS 77 from insert-at, taken
                     -> 4, free                          -> lands at 4

so slot 3 keeps `170:77` and the third collider is pushed past it to 4. That
skip is the whole point of the fixture: a probe that tested the HASH array for
emptiness rather than the VALUE array would see hashes[3] = 170 and still skip,
but one that walked `i + 1` without re-masking, or that stopped on the first
slot whose hash differed, would overwrite 77 and print `17:117` at index 3.
The three hashes are deliberately congruent mod 8 and the values deliberately
distinct, so a mis-stepped probe moves a number rather than merely reordering
equal ones.

Empty slots print `0:0`, which is also what `raw-insert`'s loop tests -- the
sentinel for "free" is a zero VALUE, so slot 0 and slots 5..7 are untouched.

  n=4: three `raw-insert`s plus one `insert-at`, each bumping `count` once.

FIELD LAST, `needs-grow` again = 0: 4*4 = 16, still under 24. Four of eight is
half full and the threshold is three quarters, so the table does not grow until
the sixth entry. The two `needs-grow` readings are both 0 for arithmetic that
differs by 16, not because the predicate is stuck -- 6*4 = 24 >= 24 is where it
turns over, and this fixture stops two entries short of it.
