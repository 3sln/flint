;; Flattening a string tree into a sink, and remembering the result.
;;
;; The text mirror of `byteflat`, and it waited on one thing the byte side
;; never needed: a rope's leaf can be an INLINE STRING, whose bytes live in the
;; value rather than the heap. There is no address to copy from, so
;; `sink-put-run` cannot reach it and `sink-put-inline` is what does.
;;
;; That is the whole difference between the two trees. Everything else here --
;; the cached flattening, the descent, the one-pass copy -- is what `byteflat`
;; already does.
(ns flint.rt.ropeflat
  (:require [flint.impl.rt :refer [defn return if let do comment doc == != not
                                   nil? is-heap as-heap ty is-inline-str + -
                                   for local set olen slot set-slot mark push
                                   r pop-to leaf-len leaf-byte wmul wadd
                                   is-fixnum as-fixnum fixnum to-i32 sink-put
                                   to-addr and >= <= > < * == sink-open
                                   sink-close sink-put-run sink-put-inline
                                   sink-contiguous Rt Value Ty I32 RootIx Sink
                                   HDR STR_DATA TY_STR TY_ROPE RP_FLAT RP_HASH
                                   RP_KIDS]]
            [flint.rt.ropemeas :refer [is-rope s-bytes]]
            [flint.rt.ropecat :refer [rope-kids]]
            [flint.rt.bytehash :refer [pow31]]))

(doc "Append every byte of the string `v` to the sink `s`."
     ""
     "THREE TIERS AND ONE OF THEM HAS NO ADDRESS. An inline string keeps its"
     "bytes in the value; a flat string keeps them at `STR_DATA`, which is not"
     "`HDR` -- a `TY_STR` carries a header of its own first; and a rope holds"
     "children. Anything else appends nothing, because every caller has already"
     "decided what `v` is.")
(defn ^:pub ^:method s-append [^:mut ^Rt rt ^Value v ^Sink s]
  (if (is-inline-str rt v)
    (do (sink-put-inline rt s v)
        (return)))
  (if (not (is-heap v))
    (return))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_STR)
      (do (sink-put-run rt s (+ (as-heap v) STR_DATA) (olen rt v))
          (return)))
    (if (!= t TY_ROPE)
      (return))
    (comment "ALREADY FLATTENED: one run rather than a descent, which is what"
             "makes repeated reads of one rope cheap.")
    (let [^Value cached (slot rt v RP_FLAT)]
      (if (not (nil? rt cached))
        (do (s-append rt cached s)
            (return))))
    (let [^I32 n (rope-kids rt v)]
      (for [^I32 i 0 n]
        (s-append rt (slot rt v (+ RP_KIDS i)) s)))))

(doc "`v` as one contiguous string, CACHED in the node."
     ""
     "Identity for a leaf, which is why this is safe to call at the door of"
     "every operation that wants bytes. The cache is what stopped `subs`,"
     "`str-index-of` and `str-bytes` each walking the whole rope before their"
     "own charge got a say -- they were paying at the door of a room they had"
     "already been through.")
(defn ^:pub ^:method ^Value s-flatten [^:mut ^Rt rt ^Value v]
  (if (not (is-rope rt v))
    (return v))
  (let [^Value cached (slot rt v RP_FLAT)]
    (if (not (nil? rt cached))
      (return cached)))
  (comment "`v` LIVES IN THE ROOT across the allocation: `sink-contiguous` interns"
           "a string, and the node this is about to write into would be stale"
           "if it had been read into a host local before that.")
  (let [^RootIx base (mark rt)
        ^RootIx vi (push rt v)
        ^Sink s (sink-open rt)]
    (s-append rt (r rt vi) s)
    (let [^Value flat (sink-contiguous rt s)]
      (sink-close rt s)
      (if (is-heap flat)
        (set-slot rt (r rt vi) RP_FLAT flat))
      (pop-to rt base)
      (return flat))))

(doc "The content hash of a string tree, cached per node."
     ""
     "TWO ROPES OVER THE SAME BYTES MUST HASH ALIKE, whatever shape they are"
     "in, or a string stops working as a map key the moment `str` nests or"
     "`subs` shares. So a node's hash is what the flat string would have had:"
     "`h(A then B) = h(A) * 31^|B| + h(B)`."
     ""
     "THE BYTES, NOT THE CODE POINTS. This has to agree with the flat hash,"
     "which steps per byte -- so a two-byte character counts twice here as it"
     "does there, and `pow31` is raised to the BYTE length.")
(defn ^:pub ^:method ^I32 rope-hash [^:mut ^Rt rt ^Value v]
  (if (not (is-rope rt v))
    (do
      (local ^:mut ^I32 lh)
      (set lh 0)
      (let [^I32 n (leaf-len rt v)]
        (for [^I32 i 0 n]
          (set lh (wadd (wmul lh 31) (leaf-byte rt v i)))))
      (return lh)))
  (let [^Value cached (slot rt v RP_HASH)]
    (if (is-fixnum rt cached)
      (return (to-i32 (as-fixnum cached)))))
  (let [^RootIx base (mark rt)
        ^RootIx vi (push rt v)
        ^I32 kids (rope-kids rt (r rt vi))]
    (local ^:mut ^I32 h)
    (set h 0)
    (for [^I32 i 0 kids]
      (let [^Value k (slot rt (r rt vi) (+ RP_KIDS i))
            ^RootIx ki (push rt k)
            ^I32 kh (rope-hash rt (r rt ki))
            ^I32 kb (s-bytes rt (r rt ki))]
        (set h (wadd (wmul h (pow31 rt kb)) kh))
        (pop-to rt ki)))
    (set-slot rt (r rt vi) RP_HASH (fixnum h))
    (pop-to rt base)
    (return h)))

(doc "Append the byte range [from, to) of the string `v` to the sink `s`."
     ""
     "THE `at < to` HALF OF THE TEST IS WHAT MAKES A SLICE CHEAP. A child"
     "wholly before the range is skipped, and once the walk has passed `to` it"
     "returns rather than finishing the row -- so taking three bytes from the"
     "front of a megabyte does not walk the megabyte."
     ""
     "The inline tier goes a byte at a time. It has no address for a run copy,"
     "and it is at most seven bytes long, so the loop is the cheaper answer"
     "rather than a second primitive.")
(defn ^:pub ^:method s-append-range [^:mut ^Rt rt ^Value v ^I32 from ^I32 to ^Sink s]
  (if (>= from to)
    (return))
  (if (is-inline-str rt v)
    (do
      (local ^:mut ^I32 ihi)
      (local ^:mut ^I32 ilo)
      (set ihi to)
      (let [^I32 iln (leaf-len rt v)]
        (if (> ihi iln) (set ihi iln)))
      (set ilo from)
      (if (> ilo ihi) (set ilo ihi))
      (for [^I32 i ilo ihi]
        (sink-put rt s (leaf-byte rt v i)))
      (return)))
  (if (not (is-heap v))
    (return))
  (let [^Ty t (ty rt (as-heap v))]
    (if (== t TY_STR)
      (do
        (let [^I32 leafn (olen rt v)]
          (local ^:mut ^I32 hi)
          (local ^:mut ^I32 lo)
          (set hi to)
          (if (> hi leafn) (set hi leafn))
          (set lo from)
          (if (> lo hi) (set lo hi))
          (sink-put-run rt s (+ (+ (as-heap v) STR_DATA) (to-addr lo)) (- hi lo))
          (return))))
    (if (!= t TY_ROPE)
      (return))
    (let [^I32 n (rope-kids rt v)]
      (local ^:mut ^I32 at)
      (set at 0)
      (for [^I32 i 0 n]
        (let [^Value k (slot rt v (+ RP_KIDS i))
              ^I32 w (s-bytes rt k)]
          (if (and (> (+ at w) from) (< at to))
            (do
              (comment "GUARDED, not clamped after the fact. `I32` is `u32` in"
                       "Rust, where `(- from at)` wraps to a huge number and a"
                       "later `(< klo 0)` is dead code, and `int` in the ports,"
                       "where it does not. Subtract only when the result is"
                       "known non-negative -- the same shape `b-append-range`"
                       "and `s-slice` already use.")
              (local ^:mut ^I32 klo)
              (set klo 0)
              (if (> from at) (set klo (- from at)))
              (s-append-range rt k klo (- to at) s)))
          (set at (+ at w))
          (if (>= at to)
            (return)))))))
