    // `hash-value` IS `valhash`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.hashValue` below stays where other entries reach it,
    // and this forwards to it.
    static int hashValue(Rt rt, long v) { return com.flint.rt.Eq.hashValue(rt, v); }
    // `val-eq` IS `valeq`'s OWN now, so it is called BARE. The nested
    // `com.flint.rt.Eq.eq` below stays for `hash-value`'s sake and this
    // forwards to it, which keeps whatever counting each probe does.
    static boolean valEq(Rt rt, long a, long b) { return com.flint.rt.Eq.eq(rt, a, b); }
    static final long NIL = 0xFFFFL;
    static final int CN_BASE = 2, HASH_BITS = 5;
    static final class Val {
        static long asHeap(long v) { return v; }
        static final long NIL = 0xFFFFL;
        static boolean isNil(long v) { return v == NIL; }
    }
    static int mask(int h, int shift) { return (h >>> shift) & 0x1f; }
    static int bitpos(int h, int shift) { return 1 << mask(h, shift); }
    static int indexOf(int bm, int bit) { return Integer.bitCount(bm & (bit - 1)); }
    static final class Rt {
        long[] h = new long[1600];
        void setSlot(long a, int i, long v) { h[(int) a + i] = v; }
        int[] kind = new int[1600];
        long bump = 300;
        java.util.ArrayList<Long> roots = new java.util.ArrayList<>();
        StringBuilder log = new StringBuilder();
        long gas = 0;
        void chargeWork(long n) { gas += n; }
        boolean champAdded = false;
        boolean starve = false;
        int mark() { return roots.size(); }
        int push(long v) { roots.add(v); return roots.size() - 1; }
        long r(int i) { return roots.get(i); }
        void popTo(int n) { while (roots.size() > n) roots.remove(roots.size() - 1); }
        long obj(String tag, boolean bm) {
            long a = bump; bump += 40; kind[(int) a] = bm ? 1 : 0; log.append(tag); return a;
        }
