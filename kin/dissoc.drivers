    static long BnNode(Rt rt, long n, int at) { return rt.h[(int) n + 20 + at]; }
    static void BnSetKey(Rt rt, long n, int at, long v) { rt.h[(int) n + 2 + 2 * at] = v; }
    static void BnSetVal(Rt rt, long n, int at, long v) { rt.h[(int) n + 3 + 2 * at] = v; }
    static int NodeSizeClass(Rt rt, long n) {
        if (IsBmnode(rt, n)) return BitOperations.PopCount((uint) BnDatamap(rt, n))
                                  + BitOperations.PopCount((uint) BnNodemap(rt, n));
        return CnCount(rt, n);
    }
    static int CnHash(Rt rt, long n) { return (int) rt.h[(int) n]; }
    static int CnCount(Rt rt, long n) { return (int) rt.h[(int) n + 1]; }
    static long CnKey(Rt rt, long n, int i) { return rt.h[(int) n + 2 + 2 * i]; }
    static int CnIndexOf(Rt rt, int sni, int ski) {
        int cnt = CnCount(rt, rt.R(sni));
        int at = cnt;
        for (int i = 0; i < cnt; i++) {
            rt.ChargeWork(1);
            if (ValEq(rt, CnKey(rt, rt.R(sni), i), rt.R(ski))) { at = i; break; }
        }
        return at;
    }
    static long CnVal(Rt rt, long n, int i) { return rt.h[(int) n + 3 + 2 * i]; }
    static void CnSet(Rt rt, long n, int i, long v) { rt.h[(int) n + i] = v; }
    static long BnNew(Rt rt, int dm, int nm, long e) {
        if (rt.starve) { rt.log.Append("x"); return NIL; }
        long a = rt.Obj("B", true);
        rt.h[(int) a] = dm; rt.h[(int) a + 1] = nm;
        return a;
    }
    static long CnNew(Rt rt, int hh, int npairs, long e) {
        if (rt.starve) { rt.log.Append("x"); return NIL; }
        long a = rt.Obj("C", false);
        rt.h[(int) a] = hh; rt.h[(int) a + 1] = npairs;
        return a;
    }
    static long BnCopyRemoveEntry(Rt rt, long n, int bit, long e) { return rt.Obj("R", true); }
    static long BnCopySetNode(Rt rt, long n, int at, long s, long e) { return rt.Obj("N", true); }
    static long BnNodeToInline(Rt rt, long n, int bit, long k, long v, long e) { return rt.Obj("I", true); }
--csharp
