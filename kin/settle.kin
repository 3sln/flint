;; WHAT A THREAD LEAVES BEHIND, written once.
;;
;; `settle` runs at the end of every turn a thread takes, and it is the ONE
;; place that decides which of three things just happened: the thread parked,
;; it failed, or it finished. Every later question -- can this wake, is the
;; program over, what does a joiner get -- reads the slots this writes.
;;
;; IT WAS WRITTEN THREE TIMES, and the copies had already drifted on the park
;; branch: both ports clear the PARK sentinel here and native does not,
;; because native's `parked` in the VM had already cleared it. The clear is
;; kept -- it is free where it is redundant and load-bearing where it is not,
;; and the comment both ports carry names the bug that put it there.
;;
;; THE ORDER OF THE TWO PARK WRITES IS THE ROOTING RULE. `park_on` is not a
;; root on any runtime, and `save-current-state` allocates; so `park_on` is
;; read into a local, cleared, and only then pushed. Reversing those two lines
;; leaves a heap value in a field nothing scans across a collection, and the
;; assertion added for exactly this now says so.
(ns flint.rt.settle
  (:require [flint.impl.rt :refer [defn return if let do comment doc
                                   == not nil? bits fixnum64
                                   mark push r pop-to slot set-slot
                                   current-thread current-bindings
                                   is-parked park-on set-park-on
                                   is-thrown thrown set-thrown
                                   save-current-state cut-stacks wake-on
                                   PARK_YIELD
                                   Rt Value Bool RootIx NIL
                                   TH_BINDINGS TH_STATUS TH_PARK_ON
                                   TH_RESULT TH_STACK
                                   ST_RUNNABLE ST_PARKED ST_DONE ST_FAILED]]))

(doc "Record the outcome of the thread that was running, and take it off."
     ""
     "NO SCHEDULER MEANS NOTHING TO SETTLE. A program with no threads still"
     "runs its entry to completion, and calling this from there is not an"
     "error -- it is the ordinary case, and answering silently is what lets"
     "the same tail run either way."
     ""
     "BINDINGS TRAVEL WITH THE THREAD, and they are saved first, before the"
     "branch: a thread that parked, one that failed and one that finished all"
     "had bindings, and only the parked one will read them back. Saving them"
     "on every path is cheaper than deciding which path wants them."
     ""
     "PARKED, FAILED, FINISHED -- in that order, and the order matters. A park"
     "travels as `thrown = PARK`, so a parked thread is ALSO a thrown one;"
     "asking about the throw first would record every park as a failure."
     ""
     "A COURTESY YIELD IS STILL RUNNABLE, and it still saves a continuation."
     "Both park branches save one -- the thread was interrupted mid-execution"
     "either way. What differs is the STATUS and `TH_PARK_ON`: a yielder is"
     "left runnable and waiting for nothing, so `pick` can choose it again"
     "with no wake at all, and the `yield` call itself is not rewound,"
     "because re-executing it would yield again, for ever."
     ""
     "A THREAD THAT IS OFF IS EMPTIED: no frames, no handlers, nothing rooted"
     "on the value stack. A parked thread is NOT emptied -- its continuation"
     "is the thing that was just saved.")
(defn ^:pub ^:method settle-thread [^:mut ^Rt rt ^Value result]
  (let [^Value th (current-thread rt)]
    (if (nil? rt th)
      (return))
    (let [^RootIx base (mark rt)
          ^RootIx ti (push rt th)]
      (set-slot rt (r rt ti) TH_BINDINGS (current-bindings rt))
      (comment "PARKED. `park-on` is read out and cleared BEFORE anything"
               "allocates, because it is not a root.")
      (if (is-parked rt)
        (do
          (let [^Value on (park-on rt)]
            (set-park-on rt NIL)
            (comment "AND THE SENTINEL. A park travels as `thrown = PARK` so"
                     "that every frame between the builtin and here unwinds;"
                     "this is where it stops being in flight. Leaving it set"
                     "made the NEXT thread's clean finish read as a failure --"
                     "it ran fine, returned a value, and `settle` recorded the"
                     "sentinel as its result.")
            (set-thrown rt NIL)
            (comment "WAITING FOR NOTHING is what a yield is, and it is the"
                     "whole difference between the two: same saved"
                     "continuation, different status and no wake key.")
            (let [^Bool yielded (== (bits on) (bits PARK_YIELD))]
              (if yielded
                (do
                  (set-slot rt (r rt ti) TH_STATUS (fixnum64 ST_RUNNABLE))
                  (set-slot rt (r rt ti) TH_PARK_ON NIL)))
              (if (not yielded)
                (let [^RootIx oi (push rt on)]
                  (set-slot rt (r rt ti) TH_STATUS (fixnum64 ST_PARKED))
                  (set-slot rt (r rt ti) TH_PARK_ON (r rt oi)))))
            (save-current-state rt (r rt ti))
            (pop-to rt base)
            (return))))
      (comment "FAILED. The error is pushed BEFORE `thrown` is cleared, so it"
               "is rooted at every instant -- `thrown` is not a root either.")
      (if (is-thrown rt)
        (do
          (let [^RootIx ei (push rt (thrown rt))]
            (set-thrown rt NIL)
            (set-slot rt (r rt ti) TH_STATUS (fixnum64 ST_FAILED))
            (set-slot rt (r rt ti) TH_RESULT (r rt ei))
            (wake-on rt (r rt ti))
            (cut-stacks rt)
            (pop-to rt base)
            (return))))
      (comment "FINISHED. The stack slot is cleared as well as the status:"
               "a done thread's continuation is the one thing certain never"
               "to be resumed, and holding it holds its whole heap.")
      (let [^RootIx ri (push rt result)]
        (set-slot rt (r rt ti) TH_STATUS (fixnum64 ST_DONE))
        (set-slot rt (r rt ti) TH_RESULT (r rt ri))
        (set-slot rt (r rt ti) TH_STACK NIL)
        (wake-on rt (r rt ti))
        (cut-stacks rt))
      (pop-to rt base))))
