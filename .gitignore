.agent.log
target/
out/
*.wasm.tmp
Cargo.lock

# Built by bin/build-units and bin/build-test-unit; regenerate rather than track.
units/
test/fixtures/wasm-path/demo/shout.o
test/fixtures/wasm-path/demo/shout.unit.edn
test/fixtures/wasm-path-bad/

# The deck: node_modules and the generated static site.
deck/node_modules/
deck/out/
deck/bun.lock
bench/workerd/*.wasm
bench/workerd/*.image
out/chicory/

# The wasm distributable is GENERATED by bin/build-dist, from the source beside
# it. A tracked binary is a binary nobody checks against that source; the
# release workflow builds it from the tag it is publishing.
dist/flintc.wasm
dist/flint-loader.wasm
dist/flint-runtime.wasm
dist/slots.json
