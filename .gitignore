.agent.log
target/
out/
*.wasm.tmp
Cargo.lock

# Built by bin/build-units and bin/build-test-unit; regenerate rather than track.
units/
test/fixtures/wasm-path/demo/shout.o
test/fixtures/wasm-path/demo/shout.unit.edn
test/fixtures/wasm-path-bad/

# The deck: node_modules and the generated static site.
deck/node_modules/
deck/out/
deck/bun.lock
bench/workerd/*.wasm
bench/workerd/*.image
out/chicory/

# `flint :src ... :fn ...` writes here when no `:out` is given, so this is
# whatever the last person compiled -- it was tracked by accident and rode
# along in 99 commits as pure binary churn. Nothing reads it.
out.wasm

# The wasm distributable is GENERATED by bin/build-dist, from the source beside
# it. A tracked binary is a binary nobody checks against that source; the
# release workflow builds it from the tag it is publishing.
dist/flintc.wasm
dist/flint-loader.wasm
dist/flint-runtime.wasm
dist/flint-runtime-aot.wasm
dist/slots.json
dist/slots-aot.json
dist/flintc.bytecode

# The single binary is built, not tracked.
target/

# SDK build output and its generated inputs.
sdks/*/dist/
sdks/esm/gen/
sdks/*/node_modules/
runtimes/jvm/classes/
runtimes/clr/*/bin/
runtimes/clr/*/obj/

# Agent worktrees, created inside the repo by the Agent tool. Untracked and
# large -- a `git add -A` would otherwise stage a whole second checkout.
.claude/worktrees/
