;; The wire codec's primitive writers, written once.
;;
;; Phase 1 of `doc/goals/splint-port.md`. These three are the self-contained
;; bottom of the codec: no heap, no allocation subtleties, and the format is
;; specified in `runtime/src/codec.rs` already.
(ns runtime.codec
  (:require [flint.impl.codec :refer [defn let do u32 write-byte write-bytes
                                      byte-count ushr to-i32 utf8
                                      I32 I64 Text Bytes Sink]]))

(defn u32 [^Sink o ^I32 n]
  (write-byte o n)
  (write-byte o (ushr n 8))
  (write-byte o (ushr n 16))
  (write-byte o (ushr n 24)))

(defn u64 [^Sink o ^I64 n]
  (u32 o (to-i32 n))
  (u32 o (to-i32 (ushr n 32))))

(defn str [^Sink o ^Text s]
  (let [^Bytes b (utf8 s)]
    (u32 o (byte-count b))
    (write-bytes o b)))
