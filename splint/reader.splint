;; The wire codec's reader primitives, written once.
;;
;; The first splint source with a MUTABLE STRUCT: a reader is a byte slice and
;; a position, and reading advances it.
(ns runtime.codec-reader
  (:require [flint.impl.codec :refer [defstruct defn let do if set return .
                                      byte-at len shl bit-or refuse + >
                                      try-u32 mask32 shl64 I64
                                      I32 Bytes Reader]]))

(defstruct reader [^Bytes b ^I32 i])

(defn ^:throws ^I32 u8 [^Reader r]
  (if (> (+ (. r i) 1) (len (. r b)))
    (refuse "the encoding ends mid-value"))
  (let [^I32 v (byte-at (. r b) (. r i))]
    (set (. r i) (+ (. r i) 1))
    (return v)))

(defn ^:throws ^I32 u32 [^Reader r]
  (if (> (+ (. r i) 4) (len (. r b)))
    (refuse "the encoding ends mid-value"))
  (let [^I32 n (bit-or (bit-or (byte-at (. r b) (. r i))
                               (shl (byte-at (. r b) (+ (. r i) 1)) 8))
                       (bit-or (shl (byte-at (. r b) (+ (. r i) 2)) 16)
                               (shl (byte-at (. r b) (+ (. r i) 3)) 24)))]
    (set (. r i) (+ (. r i) 4))
    (return n)))

(defn ^:throws ^I64 u64 [^Reader r]
  (let [^I64 lo (mask32 (try-u32 r))
        ^I64 hi (mask32 (try-u32 r))]
    (return (bit-or lo (shl64 hi 32)))))
