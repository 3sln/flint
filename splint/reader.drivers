--rust
fn main() {
    let bytes: Vec<u8> = vec![0x04,0x03,0x02,0x01, 0xff, 0x11,0x22,0x33,0x44];
    let mut r = Reader { b: bytes, i: 0 };
    let a = u32(&mut r).unwrap();
    let b = u8(&mut r).unwrap();
    let c = u32(&mut r).unwrap();
    let mut r2 = Reader { b: vec![0x88,0x77,0x66,0x55,0x44,0x33,0x22,0x11], i: 0 };
    let d = u64(&mut r2).unwrap();
    println!("{:08x} {:02x} {:08x} {} {:016x}", a, b, c, r.i, d);
}
--java
    static final class Refused extends RuntimeException {
        Refused(String m) { super(m); }
    }
    public static void main(String[] x) {
        Reader r = new Reader();
        r.b = new byte[]{ 0x04,0x03,0x02,0x01, (byte)0xff, 0x11,0x22,0x33,0x44 };
        r.i = 0;
        int a = u32(r), b = u8(r), c = u32(r);
        Reader r2 = new Reader();
        r2.b = new byte[]{ (byte)0x88,0x77,0x66,0x55,0x44,0x33,0x22,0x11 };
        r2.i = 0;
        long d = u64(r2);
        System.out.println(String.format("%08x %02x %08x %d %016x", a, b, c, r.i, d));
    }
--csharp
    sealed class Refused : System.Exception {
        internal Refused(string m) : base(m) {}
    }
    static void Main() {
        var r = new Reader();
        r.b = new byte[]{ 0x04,0x03,0x02,0x01, 0xff, 0x11,0x22,0x33,0x44 };
        r.i = 0;
        int a = U32(r), b = U8(r), c = U32(r);
        var r2 = new Reader();
        r2.b = new byte[]{ 0x88,0x77,0x66,0x55,0x44,0x33,0x22,0x11 };
        r2.i = 0;
        long d = U64(r2);
        Console.WriteLine($"{a:x8} {b:x2} {c:x8} {r.i} {d:x16}");
    }
