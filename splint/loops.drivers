--rust
fn main() {
    let mut o = String::new();
    o.push_str(&format!("{} ", sum_to(10)));
    o.push_str(&format!("{} ", first_multiple(50, 7)));
    o.push_str(&format!("{} ", first_multiple(5, 7)));
    o.push_str(&format!("{} ", skip_odds(100)));
    o.push_str(&format!("{} ", countdown(9)));
    for n in [5u32, 55, 555, 5555] { o.push_str(&format!("{}", bucket(n))); }
    println!("{}", o);
}
--java
    public static void main(String[] args) {
        StringBuilder o = new StringBuilder();
        o.append(sumTo(10)).append(' ');
        o.append(firstMultiple(50, 7)).append(' ');
        o.append(firstMultiple(5, 7)).append(' ');
        o.append(skipOdds(100)).append(' ');
        o.append(countdown(9)).append(' ');
        for (int n : new int[]{5, 55, 555, 5555}) o.append(bucket(n));
        System.out.println(o);
    }
--csharp
    static void Main() {
        var o = new StringBuilder();
        o.Append(SumTo(10)).Append(' ');
        o.Append(FirstMultiple(50, 7)).Append(' ');
        o.Append(FirstMultiple(5, 7)).Append(' ');
        o.Append(SkipOdds(100)).Append(' ');
        o.Append(Countdown(9)).Append(' ');
        foreach (int n in new int[]{5, 55, 555, 5555}) o.Append(Bucket(n));
        Console.WriteLine(o.ToString());
    }
