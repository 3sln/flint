(ns runtime.spread
  "The sequence spread inside `apply`, written once.

  What is in scope is what this file ASKED FOR -- so two sources can be written
  in different vocabularies, and a form nobody imported is not silently
  available."
  (:require [flint.impl.vm :as vm
             :refer [let set if while do break invoke not +
                     Usize Val
                     r set-r vpush pop-to seq first next charge]]))

(let [^Usize spread 0]
  (vm/set-r si (seq (r si)))
  (while (not (invoke ^Val (r si) nil?))
    (if (not (charge spread 1 "apply"))
      (do (pop-to si) (break)))
    (vpush (first (r si)))
    (set spread (+ spread 1))
    (set-r si (next (r si)))))
