;; How splint renders for the Rust runtime.
;;
;; Every entry is DATA. The translator knows control flow and nothing else; what
;; a call means on a given target is here, which is the whole bet -- if the
;; per-target knowledge fits in a file like this, the shared parts of three
;; runtimes can be written once.
{:name "rust"
 :ext "rs"

 ;; A method on the VM itself. `(vpush x)` -> `self.vpush(x)`.
 :self "self."
 ;; Statement terminator, and how a block opens/closes.
 :end ";"
 :true "true" :false "false" :nil "NIL"

 ;; `(let [x e] ...)` -- the type comes from the binding's tag.
 :let {:fmt "let {name}: {type} = {init};"
       :mut "let mut {name}: {type} = {init};"}

 ;; A HOISTED TEMPORARY, which is not a declared binding: its type is whatever
 ;; the call returned, and inference knows that where the translator does not.
 ;; Typing them `Value` produced `let t4__: Value = t3__.is_nil();` -- a bool
 ;; declared as a value, which no target accepts.
 :tmp "let {name} = {init};"

 :set {:fmt "{place} = {value};"}
 :if {:open "if {test} {" :else "} else {" :close "}"}
 :while {:open "while {test} {" :close "}"}
 :return {:fmt "return {value};"}
 :continue "continue;"
 :break "break;"

 ;; Types, by the tag written in the DSL.
 :types {:u32 "u32" :usize "usize" :val "Value" :bool "bool" :i64 "i64"}

 ;; Field paths. `(field :stack-top)` -> the target's spelling.
 :fields {:stack-top "self.roots.stack_top"
          :stack     "self.roots.stack"
          :ip        "ip"
          :frame-ip  "self.frames.last_mut().unwrap().ip"}

 ;; Calls. `{0}`, `{1}` are the arguments.
 :calls {:vpush     "self.vpush({0})"
         :vpop      "self.vpop()"
         :vat       "self.vat({0})"
         :push      "self.push({0})"
         :pop-to    "self.pop_to({0})"
         :r         "self.r({0})"
         :set-r     "self.set_r({0}, {1})"
         :seq       "self.seq({0})"
         :first     "self.first({0})"
         :next      "self.next({0})"
         :nil?      "{0}.is_nil()"
         :closure?  "{0}.is_heap() && ty(&self.gc.sp, {0}.as_heap()) == TY_CLOSURE"
         :enter     "self.enter({0}, {1}, {2})"
         :call-value "self.call_value({0})"
         :failed    "self.failed()"
         :parked    "self.thrown.bits() == crate::value::PARK.bits()"
         :charge    "self.charge_tick({0} as u64, {1}, {2})"
         :u8-at     "self.u8_at({0}) as usize"}

 ;; Operators are shared by every C-like target, so they live here rather than
 ;; being repeated: the translator asks for `:ops` and gets infix.

 ;; RUST ONLY. `self.set_r(si, self.seq(self.r(si)))` is two mutable borrows
 ;; and the borrow checker refuses it; Java and C# accept the same shape. So
 ;; call arguments that are themselves calls get lifted into locals -- which is
 ;; what the hand-written Rust already does by hand.
 :hoist-call-args true

 :ops {:+ "+" :- "-" :* "*" :< "<" :> ">" :== "==" :!= "!=" :and "&&" :or "||" :not "!"}}
